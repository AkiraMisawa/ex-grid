+<Project Sdk="Microsoft.NET.Sdk">
+
+  <!-- What a paint costs under ADR-0142's kept paints: the base (V0, row instances kept) against
+       proposal (A) (V1, painted text kept). Built once against each source state; the harness is
+       the same file set in both. Private steps are reached by reflection. CoreCLR Release, run with
+       DOTNET_TieredCompilation=0, the least of the runs read. Disposable: never committed. -->
+  <PropertyGroup>
+    <OutputType>Exe</OutputType>
+    <TargetFramework>net10.0</TargetFramework>
+    <Nullable>enable</Nullable>
+    <ImplicitUsings>enable</ImplicitUsings>
+    <ServerGarbageCollection>false</ServerGarbageCollection>
+    <NoWarn>$(NoWarn);BL0005;BL0006</NoWarn>
+  </PropertyGroup>
+
+  <ItemGroup>
+    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="9.0.0" />
+  </ItemGroup>
+
+  <ItemGroup>
+    <ProjectReference Include="..\..\..\src\ExGrid\ExGrid.csproj" />
+    <ProjectReference Include="..\..\..\src\ExPivot\ExPivot.csproj" />
+  </ItemGroup>
+
+</Project>
diff --git a/spikes/paint-text/PaintCosts/PivotGc.cs b/spikes/paint-text/PaintCosts/PivotGc.cs
