@@ -0,0 +1,317 @@
+@page "/pivot-live-costs"
+@implements IAsyncDisposable
+@implements IHandleEvent
+@using System.Diagnostics
+@using System.Globalization
+@using System.Reflection
+@using global::ExPivot.Components
+@using global::ExPivot.Engine
+
+@* Harness (ticket 01 of docs/specs/live-data), never committed: ExPivot's live redraw over D10's
+   report — two row fields, A00000… × B0000…, with A's subtotals — in the browser, at the sizes the
+   ticket asks for (?a=1000&b=9, 100 or 400), k changes a batch (?batch=). Each batch amends the
+   first record and k − 1 others picked uniformly, so a painted cell always changes and the redraw
+   shows in the DOM. ?probe=1 times, before each batch, the steps that can be run from outside on
+   the report on screen: the cube made again from the held answer, the report laid out again from
+   the cube, and the grid's two checks of its rows. *@
+
+<DemoChromeAssets Name="builtin" Paper="true">
+    <Head>
+        <link href="_content/ExPivot/ex-pivot.min.css" rel="stylesheet" />
+    </Head>
+</DemoChromeAssets>
+
+<h1>Harness: ExPivot's live redraw over a large report</h1>
+
+<div class="demo-toolbar">
+    <button id="pivot-live-costs-toggle" disabled="@(_source is null)" @onclick="Toggle">@(_on ? "Pause the page's changes" : "Resume the page's changes")</button>
+    @if (StepAsked == 1)
+    {
+        <button id="pivot-live-costs-step" disabled="@(_source is null)" @onclick="StepAsync">Apply one batch</button>
+    }
+    <button id="pivot-live-costs-gc" @onclick="Collect">[DEBUG-oom] collect</button>
+    <span id="pivot-live-costs-mem">@_mem</span>
+    <button id="pivot-live-costs-gen" @onclick="MeasureGenerationAsync">[DEBUG-oom] generation</button>
+    <span id="pivot-live-costs-genout">@_gen</span>
+</div>
+
+<p class="demo-status">
+    <DemoStatusLine @ref="_madeLine" Id="pivot-live-costs-made" Initial="Waiting for the page to be interactive…" />
+    <DemoStatusLine @ref="_batchLine" Id="pivot-live-costs-status" Initial="No batch applied yet." />
+    @* The first record's value as the batch sets it, written before the batch is applied: the
+       report shows it in its second row once the redraw lands. *@
+    <DemoStatusLine @ref="_expectLine" Id="pivot-live-costs-expect" Initial="" />
+</p>
+
+<section id="pivot-live-costs">
+    @if (_source is not null)
+    {
+        <ExPivot @ref="_pivot" Source="_source" Layout="Layout" Caps="Caps" Culture="Culture"
+                 ChangeHighlightDuration="Highlight" ViewportHeight="300" ViewportWidth="900" />
+    }
+</section>
+
+@code {
+    private static readonly CultureInfo Culture = CultureInfo.GetCultureInfo("en-US");
+    private TimeSpan Highlight => TimeSpan.FromMilliseconds(HighlightAsked ?? 1000);
+    [SupplyParameterFromQuery(Name = "highlight")]
+    public int? HighlightAsked { get; set; }
+    // [DEBUG-oom] the managed heap after a full, compacting collection, in MB
+    private string _mem = "";
+    private readonly List<(string Kind, WeakReference Ref)> _watched = [];
+    private void Watch(string kind, object? o)
+    {
+        if (o is not null && !_watched.Exists(w => ReferenceEquals(w.Ref.Target, o)))
+            _watched.Add((kind, new WeakReference(o)));
+    }
+    private string _gen = "";
+    private static long Settled()
+    {
+        for (var i = 0; i < 2; i++)
+        {
+            GC.Collect(2, GCCollectionMode.Forced, blocking: true, compacting: true);
+            GC.WaitForPendingFinalizers();
+        }
+        return GC.GetTotalMemory(false);
+    }
+    // [DEBUG-oom] what one generation is made of: a fresh answer, cube, report, every row's labels
+    // and value cells read, each measured as the managed heap it adds after a full collection
+    private async Task MeasureGenerationAsync()
+    {
+        if (_source is not { } source)
+            return;
+        // another cap than the page's, so the source answers afresh rather than from what it holds
+        var query = PivotQuery.For(Layout, Caps.MaxLeaves - 1);
+        var m0 = Settled();
+        var answer = await source.AggregateAsync(query);
+        var m1 = Settled();
+        var cube = PivotEngine.Cube(query, answer, source.Fields);
+        var m2 = Settled();
+        var report = PivotEngine.Report(cube, Layout, new PivotOptions { Culture = Culture });
+        var m3 = Settled();
+        var n = report.Rows.Count;
+        foreach (var row in report.Rows)
+            for (var c = 0; c < report.ValueColumns.Count; c++)
+                row.ValueAt(c);
+        var m4 = Settled();
+        var keys = new object[n];
+        for (var i = 0; i < n; i++) keys[i] = report.Rows[i].Key;
+        var m5 = Settled();
+        double Per(long bytes) => (double)bytes / n;
+        _gen = string.Create(CultureInfo.InvariantCulture,
+            $"rows={n} leaves={answer.LeafCount} answer={Per(m1 - m0):F0}B/row cube={Per(m2 - m1):F0}B/row report={Per(m3 - m2):F0}B/row cells={Per(m4 - m3):F0}B/row keysArray={Per(m5 - m4):F0}B/row total={(m4 - m0) / 1048576.0:F1}MB");
+        GC.KeepAlive(answer); GC.KeepAlive(cube); GC.KeepAlive(report); GC.KeepAlive(keys);
+        StateHasChanged();
+    }
+    private void Collect()
+    {
+        // [DEBUG-oom] every generation seen so far, held weakly
+        Watch("report", _pivot?.Report);
+        Watch("cube", _pivot?.Report?.Cube);
+        Watch("snapshot", _source?.Snapshot);
+        GC.Collect(2, GCCollectionMode.Forced, blocking: true, compacting: true);
+        GC.WaitForPendingFinalizers();
+        GC.Collect(2, GCCollectionMode.Forced, blocking: true, compacting: true);
+        _mem = (GC.GetTotalMemory(false) / 1048576.0).ToString("F1", CultureInfo.InvariantCulture)
+            + " alive " + string.Join(",", _watched.GroupBy(w => w.Kind).Select(g => g.Key + "=" + g.Count(w => w.Ref.IsAlive) + "/" + g.Count()));
+        StateHasChanged();
+    }
+    private static readonly TimeSpan BatchEvery = TimeSpan.FromMilliseconds(250);
+    private static readonly global::ExPivot.PivotCaps Caps = new() { MaxLeaves = 2_000_000 };
+
+    private static readonly PivotFields<CostCell> Fields = PivotFields.Of<CostCell>()
+        .Key("Id", c => c.Id)
+        .Text("A", c => c.A)
+        .Text("B", c => c.B)
+        .Number("Value", c => c.Value, format: "#,##0.00");
+
+    private static readonly PivotLayout Layout = new()
+    {
+        Rows = [new PivotFieldPlacement("A"), new PivotFieldPlacement("B")],
+        Values = [new PivotValueField("Value", PivotAggregation.Sum) { NumberFormat = "#,##0.00" }],
+    };
+
+    private static readonly Action<IReadOnlyList<PivotReportRow>, int, Func<PivotReportRow, object>> RequireKeys =
+        typeof(global::ExGrid.Components.ExGrid<PivotReportRow>).GetMethod("RequireDistinctKeys", BindingFlags.NonPublic | BindingFlags.Static)!
+            .CreateDelegate<Action<IReadOnlyList<PivotReportRow>, int, Func<PivotReportRow, object>>>();
+
+    private static readonly Action<IReadOnlyList<PivotReportRow>> RequireRows =
+        typeof(global::ExGrid.Components.ExGrid<PivotReportRow>).GetMethod("RequireDistinctRows", BindingFlags.NonPublic | BindingFlags.Static)!
+            .CreateDelegate<Action<IReadOnlyList<PivotReportRow>>>();
+
+    private static readonly Func<PivotReportRow, object> ReportKey = row => row.Key;
+
+    public sealed record CostCell(string Id, string A, string B, decimal Value);
+
+    private readonly CancellationTokenSource _leaving = new();
+    private readonly Random _random = new(20261006);
+    private DemoStatusLine? _madeLine;
+    private DemoStatusLine? _batchLine;
+    private DemoStatusLine? _expectLine;
+    private global::ExPivot.Components.ExPivot? _pivot;
+    private CostCell[] _cells = [];
+    private SnapshotPivotSource? _source;
+    private bool _on = true;
+    private int _batches;
+    private PeriodicTimer? _ticks;
+
+    [SupplyParameterFromQuery(Name = "a")]
+    public int? AAsked { get; set; }
+
+    [SupplyParameterFromQuery(Name = "b")]
+    public int? BAsked { get; set; }
+
+    [SupplyParameterFromQuery(Name = "batch")]
+    public int? BatchAsked { get; set; }
+
+    [SupplyParameterFromQuery(Name = "probe")]
+    public int? ProbeAsked { get; set; }
+
+    // ?step=1: a batch per press of the step button, the timer's batches off and the page not
+    // rendering after the press, so exactly one batch is out when a redraw is timed.
+    [SupplyParameterFromQuery(Name = "step")]
+    public int? StepAsked { get; set; }
+
+    private int PerBatch => Math.Min(BatchAsked is > 0 and var count ? count : 1, _cells.Length);
+
+    protected override async Task OnAfterRenderAsync(bool firstRender)
+    {
+        if (!firstRender)
+            return;
+        var aCount = AAsked is > 0 and var a ? a : 1000;
+        var bCount = BAsked is > 0 and var b ? b : 9;
+        var clock = Stopwatch.StartNew();
+        var random = new Random(20261006);
+        var cells = new CostCell[aCount * bCount];
+        for (var i = 0; i < aCount; i++)
+        {
+            for (var j = 0; j < bCount; j++)
+            {
+                var at = (i * bCount) + j;
+                cells[at] = new CostCell("R" + at.ToString(CultureInfo.InvariantCulture), "A" + i.ToString("00000", CultureInfo.InvariantCulture),
+                    "B" + j.ToString("0000", CultureInfo.InvariantCulture), Math.Round((decimal)((random.NextDouble() - 0.45) * 100_000), 2));
+            }
+            if (i % 100 == 99)
+                await Task.Delay(1, _leaving.Token);
+        }
+        _cells = cells;
+        var making = clock.Elapsed;
+        clock.Restart();
+        _source = PivotSource.From(cells, Fields);
+        _madeLine?.Show($"{cells.Length.ToString("N0", Culture)} records made in {making.TotalMilliseconds.ToString("N0", Culture)} ms; "
+            + $"PivotSource.From took {clock.Elapsed.TotalMilliseconds.ToString("N0", Culture)} ms.");
+        if (StepAsked == 1)
+            _on = false;
+        StateHasChanged();
+        _ticks = new PeriodicTimer(BatchEvery);
+        _ = Reported(AmendAsync(_ticks));
+    }
+
+    private async Task AmendAsync(PeriodicTimer ticks)
+    {
+        while (await ticks.WaitForNextTickAsync())
+        {
+            if (!_on || _source is not { } source)
+                continue;
+            await OneBatchAsync(source);
+        }
+    }
+
+    private async Task OneBatchAsync(SnapshotPivotSource source)
+    {
+        var amended = Amend(PerBatch);
+        var probe = await ProbeAsync(source);
+        _expectLine?.Show(amended.First(c => c.Id == "R0").Value.ToString("#,##0.00", Culture));
+        var clock = Stopwatch.StartNew();
+        source.Apply(Fields.Batch(changed: amended));
+        var applied = clock.Elapsed;
+        _batches++;
+        _batchLine?.Show($"Batch {_batches.ToString("N0", Culture)}: {amended.Length.ToString("N0", Culture)} records amended, "
+            + $"applied in {applied.TotalMilliseconds.ToString("N0", Culture)} ms (exact {applied.TotalMilliseconds.ToString("F3", CultureInfo.InvariantCulture)}).{probe}");
+    }
+
+    private Task StepAsync() => _source is { } source ? OneBatchAsync(source) : Task.CompletedTask;
+
+    // In step mode a press renders nothing of the page's own; otherwise as ComponentBase does.
+    Task IHandleEvent.HandleEventAsync(EventCallbackWorkItem item, object? arg)
+    {
+        var task = item.InvokeAsync(arg);
+        if (StepAsked == 1)
+            return task;
+        var pending = task.Status != TaskStatus.RanToCompletion && task.Status != TaskStatus.Canceled;
+        StateHasChanged();
+        return pending ? RenderedAfter(task) : Task.CompletedTask;
+    }
+
+    private async Task RenderedAfter(Task task)
+    {
+        try
+        {
+            await task;
+        }
+        catch when (task.IsCanceled)
+        {
+            return;
+        }
+        StateHasChanged();
+    }
+
+    // The first record and k − 1 others, each picked once, their value moved.
+    private CostCell[] Amend(int count)
+    {
+        var picked = new HashSet<int> { 0 };
+        while (picked.Count < count)
+            picked.Add(_random.Next(_cells.Length));
+        var amended = new CostCell[picked.Count];
+        var i = 0;
+        foreach (var at in picked)
+        {
+            var cell = _cells[at];
+            amended[i++] = _cells[at] = cell with { Value = cell.Value + Math.Round((decimal)((_random.NextDouble() - 0.5) * 200), 2) + 0.01m };
+        }
+        return amended;
+    }
+
+    private async Task<string> ProbeAsync(SnapshotPivotSource source)
+    {
+        if (ProbeAsked != 1 || _pivot?.Report is not { } report)
+            return "";
+        var query = PivotQuery.For(Layout, Caps.MaxLeaves);
+        var answer = await source.AggregateAsync(query);
+        var clock = Stopwatch.StartNew();
+        var cube = PivotEngine.Cube(query, answer, source.Fields);
+        var cubeMs = clock.Elapsed.TotalMilliseconds;
+        clock.Restart();
+        var laidOut = PivotEngine.Report(cube, Layout, new PivotOptions { Culture = Culture });
+        var reportMs = clock.Elapsed.TotalMilliseconds;
+        clock.Restart();
+        RequireKeys(report.Rows, 0, ReportKey);
+        var keysMs = clock.Elapsed.TotalMilliseconds;
+        clock.Restart();
+        RequireRows(report.Rows);
+        var rowsMs = clock.Elapsed.TotalMilliseconds;
+        return string.Create(CultureInfo.InvariantCulture,
+            $" [probe cube={cubeMs:F3} report={reportMs:F3} keys={keysMs:F3} rows={rowsMs:F3} reportRows={laidOut.Rows.Count}]");
+    }
+
+    private void Toggle() => _on = !_on;
+
+    private async Task Reported(Task loop)
+    {
+        try
+        {
+            await loop;
+        }
+        catch (Exception error)
+        {
+            await DispatchExceptionAsync(error);
+        }
+    }
+
+    public ValueTask DisposeAsync()
+    {
+        _leaving.Cancel();
+        _ticks?.Dispose();
+        return ValueTask.CompletedTask;
+    }
+}
diff --git a/spikes/paint-text/PaintCosts/CountingRenderer.cs b/spikes/paint-text/PaintCosts/CountingRenderer.cs
new file mode 100644
index 00000000..b2afe845
--- /dev/null
+++ b/spikes/paint-text/PaintCosts/CountingRenderer.cs
@@ -0,0 +1,229 @@
+using System.Diagnostics;
+using System.Text;
+using Microsoft.AspNetCore.Components;
+using Microsoft.AspNetCore.Components.RenderTree;
+using Microsoft.Extensions.Logging.Abstractions;
+using Microsoft.JSInterop;
+
+namespace Costs;
+
+/// <summary>What the render batches of one update carried, and what they rendered.</summary>
+public sealed class BatchCounts
+{
+    public int Batches;
+    public int Diffs;
+    public int Edits;
+    public int Frames;
+    public int DisposedComponents;
+    public int StringBytes;
+    /// <summary>The batches' size under Blazor's RenderBatchWriter format, transcribed (M2's
+    /// estimate, spikes/render-bench/Bench.BatchCount/CountingRenderer.cs): not the writer's own
+    /// output.</summary>
+    public int EstimatedBytes;
+    /// <summary>Diffs of components whose type the renderer was asked to watch (a row).</summary>
+    public int WatchedRendered;
+    /// <summary>Of those, components the renderer had not seen render before.</summary>
+    public int WatchedMounted;
+}
+
+/// <summary>
+/// A Renderer with no DOM, M2's (spikes/render-bench/Bench.BatchCount), with two additions: the
+/// time spent in <see cref="ProcessPendingRender"/> — every component's render and diff, and the
+/// parameters a parent sets on its children on the way — and the components of one watched type
+/// that render, so the rows a live update renders and mounts can be counted.
+/// </summary>
+public sealed class CountingRenderer : Renderer
+{
+    private readonly HashSet<int> _seen = [];
+    private readonly Dictionary<int, IComponent> _live = [];
+
+    public CountingRenderer(IServiceProvider services) : base(services, NullLoggerFactory.Instance)
+    {
+    }
+
+    public override Dispatcher Dispatcher { get; } = Dispatcher.CreateDefault();
+
+    /// <summary>Interactive, as on a circuit: ExGrid reads it.</summary>
+    protected override RendererInfo RendererInfo { get; } = new("Server", isInteractive: true);
+
+    public bool Counting { get; set; }
+
+    /// <summary>The component type whose renders are counted (an open generic is matched by its
+    /// definition).</summary>
+    public Type? Watched { get; set; }
+
+    public BatchCounts Counts { get; private set; } = new();
+
+    /// <summary>Ticks spent in <see cref="ProcessPendingRender"/> since the last <see cref="Take"/>.</summary>
+    public long RenderTicks { get; private set; }
+
+    public (BatchCounts Counts, double RenderMs) Take()
+    {
+        var taken = (Counts, RenderTicks * 1000.0 / Stopwatch.Frequency);
+        Counts = new BatchCounts();
+        RenderTicks = 0;
+        return taken;
+    }
+
+    /// <summary>The watched components alive now: those rendered and not disposed since.</summary>
+    public IEnumerable<IComponent> LiveWatched => _live.Values;
+
+    public int Attach(IComponent component) => AssignRootComponentId(component);
+
+    /// <summary>A component made by the renderer's own factory, so that its [Inject] properties
+    /// are filled.</summary>
+    public TComponent Create<TComponent>() where TComponent : IComponent => (TComponent)InstantiateComponent(typeof(TComponent));
+
+    public Task RenderRootAsync(int componentId, ParameterView parameters) => RenderRootComponentAsync(componentId, parameters);
+
+    public void RemoveRoot(int componentId) => RemoveRootComponent(componentId);
+
+    protected override void HandleException(Exception exception) => throw exception;
+
+    protected override void ProcessPendingRender()
+    {
+        var t0 = Stopwatch.GetTimestamp();
+        base.ProcessPendingRender();
+        RenderTicks += Stopwatch.GetTimestamp() - t0;
+    }
+
+    private bool IsWatched(IComponent component)
+    {
+        if (Watched is null)
+            return false;
+        var type = component.GetType();
+        return type == Watched || (Watched.IsGenericTypeDefinition && type.IsGenericType && type.GetGenericTypeDefinition() == Watched);
+    }
+
+    protected override Task UpdateDisplayAsync(in RenderBatch renderBatch)
+    {
+        var diffs = renderBatch.UpdatedComponents;
+        if (Watched is not null)
+        {
+            for (var i = 0; i < diffs.Count; i++)
+            {
+                var id = diffs.Array[i].ComponentId;
+                var component = GetComponentState(id).Component;
+                if (!IsWatched(component))
+                    continue;
+                Counts.WatchedRendered++;
+                if (_seen.Add(id))
+                    Counts.WatchedMounted++;
+                _live[id] = component;
+            }
+            for (var i = 0; i < renderBatch.DisposedComponentIDs.Count; i++)
+                _live.Remove(renderBatch.DisposedComponentIDs.Array[i]);
+        }
+        if (!Counting)
+            return Task.CompletedTask;
+
+        var c = Counts;
+        c.Batches++;
+        var strings = new HashSet<string>(StringComparer.Ordinal);
+        var bytes = 0;
+
+        void WriteString(string? value, bool deduplicate)
+        {
+            if (value is null)
+                return;
+            if (deduplicate && !strings.Add(value))
+                return;
+            var length = Encoding.UTF8.GetByteCount(value);
+            c.StringBytes += length;
+            bytes += SevenBitLength(length) + length + 4;
+        }
+
+        bytes += 4;
+        for (var i = 0; i < diffs.Count; i++)
+        {
+            var diff = diffs.Array[i];
+            c.Diffs++;
+            bytes += 4 + 8;
+            var edits = diff.Edits;
+            for (var e = 0; e < edits.Count; e++)
+            {
+                var edit = edits.Array[edits.Offset + e];
+                c.Edits++;
+                bytes += 16;
+                WriteString(edit.RemovedAttributeName, deduplicate: true);
+            }
+        }
+
+        var frames = renderBatch.ReferenceFrames;
+        bytes += 4;
+        for (var i = 0; i < frames.Count; i++)
+        {
+            var frame = frames.Array[i];
+            c.Frames++;
+            bytes += 20;
+            switch (frame.FrameType)
+            {
+                case RenderTreeFrameType.Attribute:
+                    WriteString(frame.AttributeName, deduplicate: true);
+                    if (frame.AttributeValue is bool flag)
+                        WriteString(flag ? string.Empty : null, deduplicate: true);
+                    else
+                    {
+                        var text = frame.AttributeValue as string;
+                        WriteString(text, deduplicate: string.IsNullOrEmpty(text));
+                    }
+                    break;
+                case RenderTreeFrameType.Element:
+                    WriteString(frame.ElementName, deduplicate: true);
+                    break;
+                case RenderTreeFrameType.Text:
+                    WriteString(frame.TextContent, deduplicate: string.IsNullOrWhiteSpace(frame.TextContent));
+                    break;
+                case RenderTreeFrameType.Markup:
+                    WriteString(frame.MarkupContent, deduplicate: false);
+                    break;
+                case RenderTreeFrameType.ElementReferenceCapture:
+                    WriteString(frame.ElementReferenceCaptureId, deduplicate: false);
+                    break;
+            }
+        }
+
+        c.DisposedComponents += renderBatch.DisposedComponentIDs.Count;
+        bytes += 4 + 4 * renderBatch.DisposedComponentIDs.Count;
+        bytes += 4 + 8 * renderBatch.DisposedEventHandlerIDs.Count;
+        bytes += 4; // named event changes: none here
+        bytes += 24; // the trailer of section offsets
+        c.EstimatedBytes += bytes;
+        return Task.CompletedTask;
+    }
+
+    private static int SevenBitLength(int value)
+    {
+        var length = 1;
+        while (value >= 0x80)
+        {
+            value >>= 7;
+            length++;
+        }
+        return length;
+    }
+}
+
+/// <summary>The services ExGrid and ExPivot ask for: a JavaScript runtime that answers every call
+/// with a default (every module or handle is itself again), and a clock.</summary>
+public sealed class Services(TimeProvider clock) : IServiceProvider
+{
+    private readonly FakeJS _js = new();
+
+    public object? GetService(Type serviceType)
+        => serviceType == typeof(IJSRuntime) ? _js
+         : serviceType == typeof(TimeProvider) ? clock
+         : serviceType == typeof(IServiceProvider) ? this
+         : null;
+
+    private sealed class FakeJS : IJSRuntime, IJSObjectReference
+    {
+        public ValueTask<TValue> InvokeAsync<TValue>(string identifier, object?[]? args) => ValueTask.FromResult(Make<TValue>());
+
+        public ValueTask<TValue> InvokeAsync<TValue>(string identifier, CancellationToken cancellationToken, object?[]? args) => ValueTask.FromResult(Make<TValue>());
+
+        public ValueTask DisposeAsync() => ValueTask.CompletedTask;
+
+        private TValue Make<TValue>() => typeof(TValue) == typeof(IJSObjectReference) ? (TValue)(object)this : default!;
+    }
+}
diff --git a/spikes/paint-text/PaintCosts/GcRecorder.cs b/spikes/paint-text/PaintCosts/GcRecorder.cs
new file mode 100644
index 00000000..dc428d59
--- /dev/null
+++ b/spikes/paint-text/PaintCosts/GcRecorder.cs
@@ -0,0 +1,199 @@
+using System.Diagnostics.Tracing;
+
+namespace Costs;
+
+/// <summary>One collection as the runtime's own GC events describe it.</summary>
+public sealed class GcRecord
+{
+    public long Index { get; set; }
+    public int Generation { get; set; }
+    /// <summary>0 blocking (non-concurrent), 1 background, 2 foreground (during a background GC).</summary>
+    public int Type { get; set; }
+    public int Reason { get; set; }
+    public DateTime Start { get; set; }
+    public DateTime End { get; set; }
+    /// <summary>GCStart to GCEnd, ms.</summary>
+    public double DurationMs { get; set; }
+    /// <summary>The suspension that holds this GC: SuspendEEBegin before it to RestartEEEnd after it,
+    /// ms; for a background GC, only the suspensions inside its span, summed.</summary>
+    public double PauseMs { get; set; }
+    /// <summary>GCGlobalHeapHistory's GlobalMechanisms: 0x1 concurrent, 0x2 compaction, 0x4
+    /// promotion, 0x8 demotion, 0x10 card bundles, 0x20 elevation.</summary>
+    public long GlobalMechanisms { get; set; } = -1;
+    public bool? Compacting => GlobalMechanisms < 0 ? null : (GlobalMechanisms & 0x2) != 0;
+    public long? FreeListAllocated { get; set; }
+    public long? FreeListRejected { get; set; }
+    public long? EndOfSegAllocated { get; set; }
+    public long? CondemnedAllocated { get; set; }
+    public long? PinnedAllocated { get; set; }
+    public long? CompactMechanisms { get; set; }
+    public long? ExpandMechanisms { get; set; }
+    public long[] PromotedBytes { get; set; } = [];
+    public long[] GenerationSizes { get; set; } = [];
+}
+
+/// <summary>
+/// Listens to the runtime's GC events in-process (Microsoft-Windows-DotNETRuntime, keyword GC,
+/// Informational): every collection's generation, type, reason, duration, pause, mechanisms
+/// (compacting or sweeping), how its survivors were placed (free list or end of segment) and what
+/// it promoted. Events arrive on the listener's own thread, a little after the fact; they are
+/// paired with a redraw by GC index afterwards.
+/// </summary>
+public sealed class GcRecorder : EventListener
+{
+    private readonly object _lock = new();
+    private readonly Dictionary<long, GcRecord> _gcs = [];
+    private readonly List<(DateTime At, bool Begin)> _suspensions = [];
+    private long _current = -1;
+
+    /// <summary>How many of each event arrived (a check that the listener sees what it reads).</summary>
+    public Dictionary<string, int> EventCounts { get; } = [];
+
+    /// <summary>The first GCPerHeapHistory's payload, as it arrived.</summary>
+    public string? FirstPerHeap { get; private set; }
+
+    /// <summary>The level the runtime's GC events are enabled at: Verbose carries GCPerHeapHistory
+    /// (how survivors were placed), Informational does not. Static, because OnEventSourceCreated
+    /// runs from the base constructor, before a field of this one is set.</summary>
+    public static EventLevel Level { get; set; } = EventLevel.Verbose;
+
+    protected override void OnEventSourceCreated(EventSource source)
+    {
+        if (source.Name == "Microsoft-Windows-DotNETRuntime")
+            EnableEvents(source, Level, (EventKeywords)0x1);
+    }
+
+    private static long Long(EventWrittenEventArgs e, string name)
+    {
+        var at = e.PayloadNames?.IndexOf(name) ?? -1;
+        // Pointer-sized fields (FreeListAllocated and its kin) arrive as IntPtr/UIntPtr, which
+        // Convert does not take; an exception here would be swallowed by EventListener.
+        return at < 0 ? -1 : e.Payload![at] switch
+        {
+            null => -1,
+            IntPtr p => (long)p,
+            UIntPtr u => (long)(ulong)u,
+            var v => Convert.ToInt64(v, System.Globalization.CultureInfo.InvariantCulture),
+        };
+    }
+
+    protected override void OnEventWritten(EventWrittenEventArgs e)
+    {
+        var name = e.EventName ?? "";
+        lock (_lock)
+        {
+            EventCounts[name] = EventCounts.GetValueOrDefault(name) + 1;
+            if (name.StartsWith("GCPerHeapHistory", StringComparison.Ordinal) && FirstPerHeap is null)
+                FirstPerHeap = string.Join(",", (e.PayloadNames ?? []).Zip(e.Payload ?? [], (n, v) => $"{n}={v}"));
+            if (name.StartsWith("GCStart", StringComparison.Ordinal))
+            {
+                var index = Long(e, "Count");
+                _current = index;
+                _gcs[index] = new GcRecord
+                {
+                    Index = index,
+                    Generation = (int)Long(e, "Depth"),
+                    Type = (int)Long(e, "Type"),
+                    Reason = (int)Long(e, "Reason"),
+                    Start = e.TimeStamp,
+                };
+            }
+            else if (name.StartsWith("GCEnd", StringComparison.Ordinal))
+            {
+                if (_gcs.TryGetValue(Long(e, "Count"), out var gc))
+                {
+                    gc.End = e.TimeStamp;
+                    gc.DurationMs = (gc.End - gc.Start).TotalMilliseconds;
+                }
+            }
+            else if (name.StartsWith("GCSuspendEEBegin", StringComparison.Ordinal))
+            {
+                _suspensions.Add((e.TimeStamp, true));
+            }
+            else if (name.StartsWith("GCRestartEEEnd", StringComparison.Ordinal))
+            {
+                _suspensions.Add((e.TimeStamp, false));
+            }
+            else if (name.StartsWith("GCGlobalHeapHistory", StringComparison.Ordinal))
+            {
+                if (_gcs.TryGetValue(_current, out var gc))
+                    gc.GlobalMechanisms = Long(e, "GlobalMechanisms");
+            }
+            else if (name.StartsWith("GCPerHeapHistory", StringComparison.Ordinal))
+            {
+                if (_gcs.TryGetValue(_current, out var gc))
+                {
+                    gc.FreeListAllocated = Long(e, "FreeListAllocated");
+                    gc.FreeListRejected = Long(e, "FreeListRejected");
+                    gc.EndOfSegAllocated = Long(e, "EndOfSegAllocated");
+                    gc.CondemnedAllocated = Long(e, "CondemnedAllocated");
+                    gc.PinnedAllocated = Long(e, "PinnedAllocated");
+                    gc.CompactMechanisms = Long(e, "CompactMechanisms");
+                    gc.ExpandMechanisms = Long(e, "ExpandMechanisms");
+                }
+            }
+            else if (name.StartsWith("GCHeapStats", StringComparison.Ordinal))
+            {
+                if (_gcs.TryGetValue(_current, out var gc))
+                {
+                    gc.PromotedBytes = [Long(e, "TotalPromotedSize0"), Long(e, "TotalPromotedSize1"), Long(e, "TotalPromotedSize2"), Long(e, "TotalPromotedSize3"), Long(e, "TotalPromotedSize4")];
+                    gc.GenerationSizes = [Long(e, "GenerationSize0"), Long(e, "GenerationSize1"), Long(e, "GenerationSize2"), Long(e, "GenerationSize3"), Long(e, "GenerationSize4")];
+                }
+            }
+        }
+    }
+
+    /// <summary>Waits until the events of collection <paramref name="index"/> have arrived (or a
+    /// second has passed).</summary>
+    public async Task WaitForAsync(long index)
+    {
+        for (var i = 0; i < 100; i++)
+        {
+            lock (_lock)
+            {
+                if (_gcs.TryGetValue(index, out var gc) && gc.End != default && gc.PromotedBytes.Length > 0)
+                    return;
+            }
+            await Task.Delay(10);
+        }
+    }
+
+    /// <summary>The collections with index in (<paramref name="after"/>, <paramref name="upTo"/>],
+    /// their pauses computed from the suspensions around them.</summary>
+    public List<GcRecord> Between(long after, long upTo)
+    {
+        lock (_lock)
+        {
+            var list = _gcs.Values.Where(g => g.Index > after && g.Index <= upTo).OrderBy(g => g.Index).ToList();
+            foreach (var gc in list)
+            {
+                if (gc.End == default)
+                    continue;
+                if (gc.Type == 1)
+                {
+                    // A background GC: the suspensions inside its span.
+                    double pause = 0;
+                    DateTime? begun = null;
+                    foreach (var (at, begin) in _suspensions.Where(s => s.At >= gc.Start.AddMilliseconds(-50) && s.At <= gc.End.AddMilliseconds(50)))
+                    {
+                        if (begin)
+                            begun = at;
+                        else if (begun is { } b)
+                        {
+                            pause += (at - b).TotalMilliseconds;
+                            begun = null;
+                        }
+                    }
+                    gc.PauseMs = pause;
+                }
+                else
+                {
+                    var begin = _suspensions.Where(s => s.Begin && s.At <= gc.Start).Select(s => s.At).DefaultIfEmpty(gc.Start).Max();
+                    var end = _suspensions.Where(s => !s.Begin && s.At >= gc.End).Select(s => s.At).DefaultIfEmpty(gc.End).Min();
+                    gc.PauseMs = (end - begin).TotalMilliseconds;
+                }
+            }
+            return list;
+        }
+    }
+}
diff --git a/spikes/paint-text/PaintCosts/GridPaint.cs b/spikes/paint-text/PaintCosts/GridPaint.cs
new file mode 100644
index 00000000..d4bdbeb1
--- /dev/null
+++ b/spikes/paint-text/PaintCosts/GridPaint.cs
@@ -0,0 +1,199 @@
+using System.Diagnostics;
+using System.Globalization;
+using ExGrid;
+using ExGrid.Columns;
+using ExGrid.Components;
+using Microsoft.AspNetCore.Components;
+using Microsoft.Extensions.Time.Testing;
+
+namespace Costs;
+
+/// <summary>A render-bench-like typed row: text keys, dates and many numbers, and one number too
+/// wide for its column.</summary>
+public sealed record PRow(string Id, string[] Texts, DateTime[] Dates, decimal Big, decimal[] Numbers);
+
+/// <summary>
+/// ExGrid with about 40 painted rows × 20 painted columns (40 columns in all, one pinned; a pushed
+/// Window of 20,000 rows under a Row Key). Scenarios (the brief's a–e): a vertical scroll by one
+/// row and by a page, a fling frame (Placeholders, ADR-0004) and the settle after it, a horizontal
+/// scroll to a new column slice, and a pushed Window with 0, 3 or every painted row a new instance.
+/// </summary>
+public static class GridPaint
+{
+    private const int TextColumns = 4;
+    private const int DateColumns = 3;
+    private const int NumberColumns = 31;
+    private const double RowHeight = 24;
+    private const int Rows = 20_000;
+    private const int StartRow = 1_000;
+
+    private static readonly CultureInfo Invariant = CultureInfo.InvariantCulture;
+
+    public static PRow[] Make(int count)
+    {
+        var random = new Random(20261006);
+        string[] books = ["NY-RATES-01", "LDN-FX-02", "TKY-RATES-01", "HKG-EQ-01", "ZRH-EQ-01"];
+        string[] desks = ["Rates", "Credit", "FX", "Equities"];
+        string[] products = ["Swap", "Bond", "Option", "Future", "Spot"];
+        var start = new DateTime(2026, 1, 2, 0, 0, 0, DateTimeKind.Unspecified);
+        var rows = new PRow[count];
+        for (var i = 0; i < count; i++)
+        {
+            var numbers = new decimal[NumberColumns];
+            for (var n = 0; n < NumberColumns; n++)
+                numbers[n] = Math.Round((decimal)((random.NextDouble() - 0.45) * 2_000_000), 2);
+            rows[i] = new PRow(
+                "T" + (100000 + i).ToString(Invariant),
+                [books[random.Next(books.Length)], desks[random.Next(desks.Length)], products[random.Next(products.Length)], "Note " + random.Next(1000).ToString(Invariant)],
+                [start.AddDays(random.Next(270)), start.AddDays(270 + random.Next(3000)), start.AddDays(random.Next(272))],
+                Math.Round((decimal)(random.NextDouble() * 9_000_000_000), 2),
+                numbers);
+        }
+        return rows;
+    }
+
+    /// <summary>A new instance of <paramref name="row"/> whose first number moved: a live change.</summary>
+    public static PRow Amended(PRow row)
+    {
+        var numbers = (decimal[])row.Numbers.Clone();
+        numbers[0] += 1.25m;
+        return row with { Numbers = numbers };
+    }
+
+    public static readonly GridColumn<PRow>[] Columns = BuildColumns();
+
+    private static GridColumn<PRow>[] BuildColumns()
+    {
+        var columns = new List<GridColumn<PRow>>
+        {
+            new("Id", ColumnType.Text, r => r.Id, header: "Trade ID", width: Fixed(110)),
+        };
+        for (var t = 0; t < TextColumns; t++)
+        {
+            var at = t;
+            columns.Add(new($"T{t}", ColumnType.Text, r => r.Texts[at], width: Fixed(90)));
+        }
+        for (var d = 0; d < DateColumns; d++)
+        {
+            var at = d;
+            columns.Add(new($"D{d}", ColumnType.Date, r => r.Dates[at], width: Fixed(100), align: CellAlign.Left,
+                format: value => ((DateTime)value).ToString("yyyy-MM-dd", Invariant)));
+        }
+        // Too narrow for its numbers: paints ####.
+        columns.Add(new("Big", ColumnType.Number, r => r.Big, width: Fixed(40), format: Money));
+        for (var n = 0; n < NumberColumns; n++)
+        {
+            var at = n;
+            columns.Add(n % 2 == 0
+                ? new($"N{n}", ColumnType.Number, r => r.Numbers[at], width: Fixed(90), format: Money)
+                : new($"N{n}", ColumnType.Number, r => r.Numbers[at], width: Fixed(90)));
+        }
+        return [.. columns];
+    }
+
+    private static ColumnWidthSpec Fixed(double width) => new(ColumnWidth.Fixed(width));
+
+    private static string Money(object value) => ((decimal)value).ToString("#,##0.00", Invariant);
+
+    public static async Task<object> RunAsync(int warmup, int runs, double viewportHeight, double viewportWidth)
+    {
+        var rows = Make(Rows);
+        var clock = new FakeTimeProvider(DateTimeOffset.UnixEpoch.AddYears(56));
+        var renderer = new CountingRenderer(new Services(clock)) { Watched = typeof(ExGridRow<>) };
+        var grid = renderer.Create<ExGrid<PRow>>();
+        var id = renderer.Attach(grid);
+        Func<PRow, object> key = r => r.Id;
+        Dictionary<string, object?> Parameters(IReadOnlyList<PRow> window) => new()
+        {
+            [nameof(ExGrid<PRow>.Window)] = window,
+            [nameof(ExGrid<PRow>.TotalCount)] = Rows,
+            [nameof(ExGrid<PRow>.Columns)] = Columns,
+            [nameof(ExGrid<PRow>.PinnedColumnCount)] = 1,
+            [nameof(ExGrid<PRow>.RowKey)] = key,
+            [nameof(ExGrid<PRow>.RowHeight)] = RowHeight,
+            [nameof(ExGrid<PRow>.ViewportHeight)] = (ViewportSize)viewportHeight,
+            [nameof(ExGrid<PRow>.ViewportWidth)] = (ViewportSize)viewportWidth,
+        };
+        await renderer.Dispatcher.InvokeAsync(() => renderer.RenderRootAsync(id, ParameterView.FromDictionary(Parameters(rows))));
+        var rig = new Rig<PRow>(renderer, grid);
+        await rig.SettleAsync();
+
+        var top = StartRow * RowHeight;
+        Task To(double y, double x) => renderer.Dispatcher.InvokeAsync(() => { rig.Scroll(y, x); rig.Settle(); });
+        await To(top, 0);
+        await rig.SettleAsync();
+        var painted = rig.PaintedCount;
+        var page = rig.RowsPerViewport;
+        var sliceAtLeft = rig.Slice;
+        // A new column slice that is not a fling: less than a Viewport sideways.
+        var sideways = viewportWidth - 250;
+        await To(top, sideways);
+        var sliceAfter = rig.Slice;
+        await To(top, 0);
+        var pinnedTexts = 1;
+        Console.WriteLine($"== ExGrid: {Rows:N0} rows, {Columns.Length} columns ({pinnedTexts} pinned); painted rows {painted} from {rig.FirstPainted}; a page is {page} rows; slice {sliceAtLeft} -> {sliceAfter} at {sideways}px ==");
+
+        var scenarios = new List<(string Name, Func<Task> SetA, Func<Task> StepB)>
+        {
+            ("a: scroll by 1 row", () => To(top, 0), () => { rig.Scroll(top + RowHeight, 0); return Task.CompletedTask; }),
+            ("b: scroll by a page", () => To(top, 0), () => { rig.Scroll(top + (page * RowHeight), 0); return Task.CompletedTask; }),
+            ("c: fling frame (Placeholders)", async () =>
+                {
+                    await To(top, 0);
+                    await renderer.Dispatcher.InvokeAsync(() => rig.Scroll(top + (3 * page * RowHeight), 0));
+                },
+                () => { rig.Scroll(top + (6 * page * RowHeight), 0); return Task.CompletedTask; }),
+            ("c2: fling settles (full slice painted)", async () =>
+                {
+                    await To(top, 0);
+                    await renderer.Dispatcher.InvokeAsync(() => rig.Scroll(top + (3 * page * RowHeight), 0));
+                },
+                () => { rig.Settle(); return Task.CompletedTask; }),
+            ("d: horizontal scroll to a new slice", () => To(top, 0), () => { rig.Scroll(top, sideways); return Task.CompletedTask; }),
+        };
+        foreach (var replaced in new[] { 0, 3, -1 })
+        {
+            var name = replaced < 0 ? "e: live, every painted row new" : $"e: live, {replaced} painted rows new";
+            scenarios.Add((name,
+                async () =>
+                {
+                    await To(top, 0);
+                    await renderer.Dispatcher.InvokeAsync(() => renderer.RenderRootAsync(id, ParameterView.FromDictionary(Parameters(rows))));
+                },
+                () =>
+                {
+                    var window = (PRow[])rows.Clone();
+                    var first = StartRow;
+                    var count = painted;
+                    int[] which = replaced switch
+                    {
+                        0 => [],
+                        3 => [first, first + (count / 2), first + count - 1],
+                        _ => [.. Enumerable.Range(first, count)],
+                    };
+                    foreach (var at in which)
+                        window[at] = Amended(window[at]);
+                    return renderer.RenderRootAsync(id, ParameterView.FromDictionary(Parameters(window)));
+                }));
+        }
+
+        var results = new List<object>();
+        foreach (var (name, setA, stepB) in scenarios)
+        {
+            var machineBefore = Machine.Snapshot();
+            var series = await rig.MeasureAsync(setA, stepB, warmup, runs);
+            var summary = series.Summary();
+            results.Add(new { scenario = name, measured = summary, machineBefore, machineAfter = Machine.Snapshot() });
+            Console.WriteLine($"-- {name}");
+            Print("step (scroll/params + render)", Stat.Of(series.StepMs));
+            Print("render (ProcessPendingRender)", Stat.Of(series.RenderMs));
+            Print("NotePaint alone", Stat.Of(series.PaintMs));
+            Console.WriteLine($"   NotePaint bytes {Stat.Of(series.PaintBytes).Median:F0}; step bytes {Stat.Of(series.StepBytes).Median:F0}; rows rendered {Stat.Of(series.RowsRendered).Median} (+{Stat.Of(series.RowsRenderedAfter).Median} after); new paints {Stat.Of(series.NewPaints).Median}");
+        }
+        var kept = rig.PaintsKept;
+        await renderer.DisposeAsync();
+        return new { rows = Rows, columns = Columns.Length, paintedRows = painted, rowsPerViewport = page, sliceAtLeft, sliceAfter, sideways, viewportHeight, viewportWidth, paintsKeptAtEnd = kept, results };
+    }
+
+    internal static void Print(string name, Stat stat) => Console.WriteLine($"   {name,-34} {stat}");
+}
