index 00000000..dccdbd65
--- /dev/null
+++ b/samples/ExGrid.DemoPages/Pages/PaintCostPage.razor
@@ -0,0 +1,270 @@
+@page "/paint-cost"
+@using System.Collections
+@using System.Diagnostics
+@using System.Globalization
+@using System.Reflection
+@using System.Text.Json
+
+@* Harness (never committed): what a paint costs in this runtime under ADR-0142's kept paints, on
+   spikes/paint-text's grid — about 40 painted rows × 20 painted columns, 40 columns in all, a pushed
+   Window of 20,000 rows under a Row Key. Each scenario step (a scroll offset applied as OnScrollAsync
+   applies it, a fling settled as the settle timer does, or a new Window pushed) is timed with the
+   render it causes, which runs inline here; and NotePaint alone, on the same state, with the kept
+   paints put back as they were before the step each time. Private members by reflection. *@
+
+<h1>Paint cost harness</h1>
+<button id="paint-cost-run" @onclick="Run">Run</button>
+<span id="paint-cost-status">@_status</span>
+<pre id="paint-cost-out" style="max-height: 120px; overflow: auto">@_out</pre>
+
+<ExGrid TRow="PaintCostRow" @ref="_grid"
+        Window="_window"
+        TotalCount="Rows"
+        Columns="Columns"
+        PinnedColumnCount="1"
+        RowKey="Key"
+        RowHeight="24"
+        ViewportHeight="990"
+        ViewportWidth="1650" />
+
+@code {
+    [SupplyParameterFromQuery(Name = "runs")]
+    public int? RunsAsked { get; set; }
+
+    [SupplyParameterFromQuery(Name = "warmup")]
+    public int? WarmupAsked { get; set; }
+
+    public sealed record PaintCostRow(string Id, string[] Texts, DateTime[] Dates, decimal Big, decimal[] Numbers);
+
+    private const int Rows = 20_000;
+    private const int StartRow = 1_000;
+    private const double RowHeight = 24;
+    private const int NumberColumns = 31;
+    private static readonly CultureInfo Invariant = CultureInfo.InvariantCulture;
+    private static readonly Func<PaintCostRow, object> Key = r => r.Id;
+    private static readonly GridColumn<PaintCostRow>[] Columns = BuildColumns();
+    private static readonly PaintCostRow[] Base = Make(Rows);
+
+    private ExGrid<PaintCostRow>? _grid;
+    private IReadOnlyList<PaintCostRow> _window = Base;
+    private string _status = "Not run.";
+    private string _out = "";
+
+    private static PaintCostRow[] Make(int count)
+    {
+        var random = new Random(20261006);
+        string[] books = ["NY-RATES-01", "LDN-FX-02", "TKY-RATES-01", "HKG-EQ-01", "ZRH-EQ-01"];
+        string[] desks = ["Rates", "Credit", "FX", "Equities"];
+        string[] products = ["Swap", "Bond", "Option", "Future", "Spot"];
+        var start = new DateTime(2026, 1, 2, 0, 0, 0, DateTimeKind.Unspecified);
+        var rows = new PaintCostRow[count];
+        for (var i = 0; i < count; i++)
+        {
+            var numbers = new decimal[NumberColumns];
+            for (var n = 0; n < NumberColumns; n++)
+                numbers[n] = Math.Round((decimal)((random.NextDouble() - 0.45) * 2_000_000), 2);
+            rows[i] = new PaintCostRow(
+                "T" + (100000 + i).ToString(Invariant),
+                [books[random.Next(books.Length)], desks[random.Next(desks.Length)], products[random.Next(products.Length)], "Note " + random.Next(1000).ToString(Invariant)],
+                [start.AddDays(random.Next(270)), start.AddDays(270 + random.Next(3000)), start.AddDays(random.Next(272))],
+                Math.Round((decimal)(random.NextDouble() * 9_000_000_000), 2),
+                numbers);
+        }
+        return rows;
+    }
+
+    private static PaintCostRow Amended(PaintCostRow row)
+    {
+        var numbers = (decimal[])row.Numbers.Clone();
+        numbers[0] += 1.25m;
+        return row with { Numbers = numbers };
+    }
+
+    private static GridColumn<PaintCostRow>[] BuildColumns()
+    {
+        var columns = new List<GridColumn<PaintCostRow>> { new("Id", ColumnType.Text, r => r.Id, header: "Trade ID", width: Fixed(110)) };
+        for (var t = 0; t < 4; t++)
+        {
+            var at = t;
+            columns.Add(new($"T{t}", ColumnType.Text, r => r.Texts[at], width: Fixed(90)));
+        }
+        for (var d = 0; d < 3; d++)
+        {
+            var at = d;
+            columns.Add(new($"D{d}", ColumnType.Date, r => r.Dates[at], width: Fixed(100), align: CellAlign.Left,
+                format: value => ((DateTime)value).ToString("yyyy-MM-dd", Invariant)));
+        }
+        columns.Add(new("Big", ColumnType.Number, r => r.Big, width: Fixed(40), format: Money));
+        for (var n = 0; n < NumberColumns; n++)
+        {
+            var at = n;
+            columns.Add(n % 2 == 0
+                ? new($"N{n}", ColumnType.Number, r => r.Numbers[at], width: Fixed(90), format: Money)
+                : new($"N{n}", ColumnType.Number, r => r.Numbers[at], width: Fixed(90)));
+        }
+        return [.. columns];
+    }
+
+    private static ColumnWidthSpec Fixed(double width) => new(ColumnWidth.Fixed(width));
+
+    private static string Money(object value) => ((decimal)value).ToString("#,##0.00", Invariant);
+
+    private void Run()
+    {
+        _status = "Running…";
+        _ = RunAsync();
+    }
+
+    private sealed class Series
+    {
+        public List<double> StepMs { get; } = [];
+        public List<double> PaintMs { get; } = [];
+        public List<double> PaintBytes { get; } = [];
+        public List<double> NewPaints { get; } = [];
+    }
+
+    private static object Stat(List<double> values)
+    {
+        var sorted = values.OrderBy(v => v).ToArray();
+        return new { min = sorted[0], median = sorted[sorted.Length / 2], max = sorted[^1], n = sorted.Length };
+    }
+
+    private async Task RunAsync()
+    {
+        // Off the event's dispatch, so that a render runs inline and is timed with its step.
+        await Task.Yield();
+        try
+        {
+            var runs = RunsAsked is > 0 and var r ? r : 15;
+            var warmup = WarmupAsked is >= 0 and var w ? w : 3;
+            var grid = _grid!;
+            var type = typeof(ExGrid<PaintCostRow>);
+            const BindingFlags any = BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.Instance;
+            var applyScroll = type.GetMethod("ApplyScrollOffset", any)!;
+            var onSettled = type.GetMethod("OnSettled", any)!;
+            var notePaint = (Func<int>)type.GetMethod("NotePaint", any)!.CreateDelegate(typeof(Func<int>), grid);
+            var paintsField = type.GetField("_paints", any)!;
+            var paintIdField = type.GetField("_paintId", any)!;
+            var geometry = type.GetField("_geometry", any)!.GetValue(grid)!;
+            var page = (int)geometry.GetType().GetProperty("RowsPerViewport")!.GetValue(geometry)!;
+            var visible = type.GetField("_visible", any)!.GetValue(grid)!;
+            var painted = (int)visible.GetType().GetProperty("Count")!.GetValue(visible)!;
+            var top = StartRow * RowHeight;
+            var sideways = 1650 - 250.0;
+            void Scroll(double y, double x) => applyScroll.Invoke(grid, [new ScrollOffset(y, x)]);
+            void Settle() => onSettled.Invoke(grid, [null]);
+            void To(double y, double x) { Scroll(y, x); Settle(); }
+            void Push(IReadOnlyList<PaintCostRow> window) { _window = window; StateHasChanged(); }
+            int PaintId() => (int)paintIdField.GetValue(grid)!;
+
+            (object[] Paints, (PropertyInfo P, object? V)[] Newest) Snapshot()
+            {
+                var paints = ((IList)paintsField.GetValue(grid)!).Cast<object>().ToArray();
+                var newest = paints[^1];
+                return (paints, newest.GetType().GetProperties(BindingFlags.Public | BindingFlags.Instance).Where(p => p.CanWrite).Select(p => (p, p.GetValue(newest))).ToArray());
+            }
+            void Restore((object[] Paints, (PropertyInfo P, object? V)[] Newest) s)
+            {
+                var list = (IList)paintsField.GetValue(grid)!;
+                list.Clear();
+                foreach (var p in s.Paints)
+                    list.Add(p);
+                foreach (var (p, v) in s.Newest)
+                    p.SetValue(s.Paints[^1], v);
+            }
+
+            var scenarios = new List<(string Name, Action SetA, Action StepB)>
+            {
+                ("a: scroll by 1 row", () => To(top, 0), () => Scroll(top + RowHeight, 0)),
+                ("b: scroll by a page", () => To(top, 0), () => Scroll(top + (page * RowHeight), 0)),
+                ("c: fling frame (Placeholders)", () => { To(top, 0); Scroll(top + (3 * page * RowHeight), 0); }, () => Scroll(top + (6 * page * RowHeight), 0)),
+                ("c2: fling settles (full slice painted)", () => { To(top, 0); Scroll(top + (3 * page * RowHeight), 0); }, Settle),
+                ("d: horizontal scroll to a new slice", () => To(top, 0), () => Scroll(top, sideways)),
+            };
+            foreach (var replaced in new[] { 0, 3, -1 })
+            {
+                var name = replaced < 0 ? "e: live, every painted row new" : $"e: live, {replaced} painted rows new";
+                scenarios.Add((name, () => { To(top, 0); Push(Base); }, () =>
+                {
+                    var window = (PaintCostRow[])Base.Clone();
+                    int[] which = replaced switch
+                    {
+                        0 => [],
+                        3 => [StartRow, StartRow + (painted / 2), StartRow + painted - 1],
+                        _ => [.. Enumerable.Range(StartRow, painted)],
+                    };
+                    foreach (var at in which)
+                        window[at] = Amended(window[at]);
+                    Push(window);
+                }));
+            }
+
+            const int Batch = 20;
+            var results = new List<object>();
+            foreach (var (name, setA, stepB) in scenarios)
+            {
+                _status = $"Running {name}…";
+                var series = new Series();
+                for (var run = 0; run < warmup + runs; run++)
+                {
+                    setA();
+                    await Task.Yield();
+                    GC.Collect();
+                    var before = PaintId();
+                    var t0 = Stopwatch.GetTimestamp();
+                    stepB();
+                    var ms = Stopwatch.GetElapsedTime(t0).TotalMilliseconds;
+                    var newPaints = PaintId() - before;
+                    await Task.Yield();
+                    if (run >= warmup)
+                    {
+                        series.StepMs.Add(ms);
+                        series.NewPaints.Add(newPaints);
+                    }
+                }
+                // The paint alone, in batches of 20 so a timer's resolution does not hide it: 20
+                // restores and notes, less 20 restores alone.
+                setA();
+                await Task.Yield();
+                var snapshot = Snapshot();
+                stepB();
+                await Task.Yield();
+                for (var run = 0; run < warmup + runs; run++)
+                {
+                    GC.Collect();
+                    var a0 = GC.GetAllocatedBytesForCurrentThread();
+                    var t0 = Stopwatch.GetTimestamp();
+                    for (var i = 0; i < Batch; i++)
+                    {
+                        Restore(snapshot);
+                        notePaint();
+                    }
+                    var both = Stopwatch.GetElapsedTime(t0).TotalMilliseconds;
+                    var bothBytes = GC.GetAllocatedBytesForCurrentThread() - a0;
+                    GC.Collect();
+                    a0 = GC.GetAllocatedBytesForCurrentThread();
+                    t0 = Stopwatch.GetTimestamp();
+                    for (var i = 0; i < Batch; i++)
+                        Restore(snapshot);
+                    var restores = Stopwatch.GetElapsedTime(t0).TotalMilliseconds;
+                    var restoreBytes = GC.GetAllocatedBytesForCurrentThread() - a0;
+                    // Leave the state as after the step: the last paint noted.
+                    notePaint();
+                    if (run >= warmup)
+                    {
+                        series.PaintMs.Add((both - restores) / Batch);
+                        series.PaintBytes.Add((double)(bothBytes - restoreBytes) / Batch);
+                    }
+                }
+                results.Add(new { scenario = name, step = Stat(series.StepMs), notePaintAlone = Stat(series.PaintMs), notePaintBytes = Stat(series.PaintBytes), newPaints = Stat(series.NewPaints), stepRuns = series.StepMs, paintRuns = series.PaintMs });
+            }
+            _out = JsonSerializer.Serialize(new { runs, warmup, paintedRows = painted, rowsPerViewport = page, frequency = Stopwatch.Frequency, results });
+            _status = "Done.";
+        }
+        catch (Exception error)
+        {
+            _status = "Failed: " + error;
+        }
+        StateHasChanged();
+    }
+}
