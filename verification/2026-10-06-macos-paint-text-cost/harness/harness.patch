@@ -0,0 +1,212 @@
+using System.Diagnostics;
+using System.Runtime;
+using ExGrid;
+using ExGrid.Components;
+using ExPivot.Engine;
+
+namespace Costs;
+
+/// <summary>
+/// Why ExPivot's live redraw has a slower median in V1 than in V0 on CoreCLR (follow-up to the
+/// paint-text measurement). Two modes:
+/// <list type="bullet">
+/// <item><c>pivot-gc</c>: scenario e of <see cref="PivotPaint"/> alone — a collection before each
+/// timed redraw, as the rig makes it (<c>full</c>), compacting (<c>compact</c>), or none — with every
+/// collection inside the redraw read from the runtime's GC events, and the GC's own memory info
+/// (committed, fragmented, promoted) before and after.</item>
+/// <item><c>pivot-steady</c>: consecutive live redraws with no forced collection at all, each
+/// timed, with every collection inside it and the heap after it.</item>
+/// </list>
+/// </summary>
+public static class PivotGc
+{
+    private static void PreCollect(string how)
+    {
+        switch (how)
+        {
+            case "full":
+                Clock.Collect();
+                break;
+            case "compact":
+                GCSettings.LargeObjectHeapCompactionMode = GCLargeObjectHeapCompactionMode.CompactOnce;
+                GC.Collect(2, GCCollectionMode.Forced, blocking: true, compacting: true);
+                GC.WaitForPendingFinalizers();
+                GCSettings.LargeObjectHeapCompactionMode = GCLargeObjectHeapCompactionMode.CompactOnce;
+                GC.Collect(2, GCCollectionMode.Forced, blocking: true, compacting: true);
+                break;
+            case "none":
+                break;
+            default:
+                throw new ArgumentException($"no pre-collection {how}");
+        }
+    }
+
+    private static object Info(GCMemoryInfo info) => new
+    {
+        index = info.Index,
+        generation = info.Generation,
+        compacted = info.Compacted,
+        concurrent = info.Concurrent,
+        heapSizeMB = Math.Round(info.HeapSizeBytes / 1048576.0, 1),
+        committedMB = Math.Round(info.TotalCommittedBytes / 1048576.0, 1),
+        fragmentedMB = Math.Round(info.FragmentedBytes / 1048576.0, 1),
+        promotedMB = Math.Round(info.PromotedBytes / 1048576.0, 1),
+        pauseMs = info.PauseDurations.ToArray().Select(p => Math.Round(p.TotalMilliseconds, 3)).ToArray(),
+        generations = info.GenerationInfo.ToArray().Select(g => new
+        {
+            sizeBeforeMB = Math.Round(g.SizeBeforeBytes / 1048576.0, 1),
+            fragmentationBeforeMB = Math.Round(g.FragmentationBeforeBytes / 1048576.0, 1),
+            sizeAfterMB = Math.Round(g.SizeAfterBytes / 1048576.0, 1),
+            fragmentationAfterMB = Math.Round(g.FragmentationAfterBytes / 1048576.0, 1),
+        }).ToArray(),
+    };
+
+    private static object Gc(GcRecord g) => new
+    {
+        g.Index, g.Generation, type = g.Type switch { 0 => "blocking", 1 => "background", 2 => "foreground", _ => g.Type.ToString() },
+        g.Reason, durationMs = Math.Round(g.DurationMs, 3), pauseMs = Math.Round(g.PauseMs, 3), g.Compacting, g.GlobalMechanisms,
+        freeListAllocatedMB = g.FreeListAllocated is { } f && f >= 0 ? Math.Round(f / 1048576.0, 2) : (double?)null,
+        endOfSegAllocatedMB = g.EndOfSegAllocated is { } e && e >= 0 ? Math.Round(e / 1048576.0, 2) : (double?)null,
+        condemnedAllocatedMB = g.CondemnedAllocated is { } c && c >= 0 ? Math.Round(c / 1048576.0, 2) : (double?)null,
+        g.FreeListRejected, g.PinnedAllocated, g.CompactMechanisms, g.ExpandMechanisms,
+        promotedMB = g.PromotedBytes.Select(p => Math.Round(p / 1048576.0, 2)).ToArray(),
+        generationSizesMB = g.GenerationSizes.Select(p => Math.Round(p / 1048576.0, 1)).ToArray(),
+    };
+
+    private static async Task<(Costs.CountingRenderer Renderer, ExPivot.Components.ExPivot Pivot, PivotPaint.IGridPivotSource Source, Cell[] Newest, Microsoft.Extensions.Time.Testing.FakeTimeProvider Clock)> StartAsync(int a, int b)
+    {
+        var started = await PivotPaint.StartAsync(a, b);
+        var grid = Reflect.Get<ExGrid<PivotReportRow>>(started.Pivot, "_grid");
+        var rig = new Rig<PivotReportRow>(started.Renderer, grid);
+        var geometry = Reflect.Get(grid, "_geometry")!;
+        var height = Convert.ToDouble(geometry.GetType().GetProperty("RowHeightPx")!.GetValue(geometry), System.Globalization.CultureInfo.InvariantCulture);
+        await started.Renderer.Dispatcher.InvokeAsync(() => { rig.Scroll(1_000 * height, 0); rig.Settle(); });
+        await rig.SettleAsync();
+        return started;
+    }
+
+    public static async Task<object> RunAsync(int a, int b, int warmup, int runs, string precollect, string listen)
+    {
+        GcRecorder.Level = listen == "info" ? System.Diagnostics.Tracing.EventLevel.Informational : System.Diagnostics.Tracing.EventLevel.Verbose;
+        using var recorder = listen == "off" ? null : new GcRecorder();
+        var (renderer, pivot, source, newest, clock) = await StartAsync(a, b);
+        var random = new Random(7);
+        var rows = new List<Dictionary<string, object?>>();
+        Console.WriteLine($"== pivot-gc {a:N0} x {b:N0}, pre-collection {precollect}, GC events {listen}, GCRetainVM={Environment.GetEnvironmentVariable("DOTNET_GCRetainVM") ?? "(default)"} ==");
+        for (var r = 0; r < warmup + runs; r++)
+        {
+            var amended = PivotPaint.Amend(newest, 1, random);
+            await renderer.Dispatcher.InvokeAsync(() => clock.Advance(TimeSpan.FromMilliseconds(400)));
+            var preIndex = GC.GetGCMemoryInfo(GCKind.Any).Index;
+            PreCollect(precollect);
+            var before = GC.GetGCMemoryInfo(GCKind.Any);
+            var index0 = before.Index;
+            var workingSet0 = Environment.WorkingSet;
+            double ms = 0, pause = 0;
+            await renderer.Dispatcher.InvokeAsync(() =>
+            {
+                var p0 = GC.GetTotalPauseDuration();
+                var t0 = Stopwatch.GetTimestamp();
+                var report = pivot.Report;
+                source.Apply(amended);
+                ms = Clock.Ms(t0);
+                pause = (GC.GetTotalPauseDuration() - p0).TotalMilliseconds;
+                if (ReferenceEquals(report, pivot.Report))
+                    throw new InvalidOperationException("The redraw did not run inline.");
+            });
+            var after = GC.GetGCMemoryInfo(GCKind.Any);
+            var ephemeral = GC.GetGCMemoryInfo(GCKind.Ephemeral);
+            if (r < warmup)
+                continue;
+            rows.Add(new()
+            {
+                ["run"] = r - warmup + 1,
+                ["redrawMs"] = Math.Round(ms, 3),
+                ["gcPauseMs"] = Math.Round(pause, 3),
+                ["preIndex"] = preIndex,
+                ["index0"] = index0,
+                ["index1"] = after.Index,
+                ["workingSetBeforeMB"] = Math.Round(workingSet0 / 1048576.0, 1),
+                ["workingSetAfterMB"] = Math.Round(Environment.WorkingSet / 1048576.0, 1),
+                ["afterPreCollection"] = Info(before),
+                ["lastEphemeralInRedraw"] = ephemeral.Index > index0 ? Info(ephemeral) : null,
+                ["lastInRedraw"] = after.Index > index0 ? Info(after) : null,
+            });
+            Console.WriteLine($"   run {r - warmup + 1,2}: {ms,8:F2} ms, GC pause {pause,7:F2} ms, GCs {after.Index - index0}, committed {before.TotalCommittedBytes / 1048576.0:F0} -> {after.TotalCommittedBytes / 1048576.0:F0} MB, fragmented after {ephemeral.FragmentedBytes / 1048576.0:F1} MB");
+        }
+        if (recorder is not null)
+        {
+            await recorder.WaitForAsync(GC.GetGCMemoryInfo(GCKind.Any).Index);
+            foreach (var row in rows)
+            {
+                row["collections"] = recorder.Between((long)row["index0"]!, (long)row["index1"]!).Select(Gc).ToArray();
+                row["preCollections"] = recorder.Between((long)row["preIndex"]!, (long)row["index0"]!).Select(Gc).ToArray();
+            }
+        }
+        var times = rows.Select(r => (double)r["redrawMs"]!).ToArray();
+        var pauses = rows.Select(r => (double)r["gcPauseMs"]!).ToArray();
+        Console.WriteLine($"   redraw {Stat.Of(times)}   GC pause {Stat.Of(pauses)}");
+        await renderer.DisposeAsync();
+        return new
+        {
+            a, b, warmup, runs, precollect, listen,
+            events = recorder?.EventCounts, firstPerHeapHistory = recorder?.FirstPerHeap,
+            gcRetainVM = Environment.GetEnvironmentVariable("DOTNET_GCRetainVM"),
+            gcSettings = new { GCSettings.IsServerGC, latency = GCSettings.LatencyMode.ToString() },
+            redrawMs = Stat.Of(times), gcPauseMs = Stat.Of(pauses), rows,
+        };
+    }
+
+    public static async Task<object> SteadyAsync(int a, int b, int redraws)
+    {
+        GcRecorder.Level = System.Diagnostics.Tracing.EventLevel.Verbose;
+        using var recorder = new GcRecorder();
+        var (renderer, pivot, source, newest, clock) = await StartAsync(a, b);
+        var random = new Random(7);
+        var rows = new List<Dictionary<string, object?>>();
+        Console.WriteLine($"== pivot-steady {a:N0} x {b:N0}, {redraws} redraws, no forced collection ==");
+        for (var r = 0; r < redraws; r++)
+        {
+            var amended = PivotPaint.Amend(newest, 1, random);
+            await renderer.Dispatcher.InvokeAsync(() => clock.Advance(TimeSpan.FromMilliseconds(400)));
+            var index0 = GC.GetGCMemoryInfo(GCKind.Any).Index;
+            double ms = 0, pause = 0;
+            await renderer.Dispatcher.InvokeAsync(() =>
+            {
+                var p0 = GC.GetTotalPauseDuration();
+                var t0 = Stopwatch.GetTimestamp();
+                var report = pivot.Report;
+                source.Apply(amended);
+                ms = Clock.Ms(t0);
+                pause = (GC.GetTotalPauseDuration() - p0).TotalMilliseconds;
+                if (ReferenceEquals(report, pivot.Report))
+                    throw new InvalidOperationException("The redraw did not run inline.");
+            });
+            var after = GC.GetGCMemoryInfo(GCKind.Any);
+            rows.Add(new()
+            {
+                ["redraw"] = r + 1,
+                ["redrawMs"] = Math.Round(ms, 3),
+                ["gcPauseMs"] = Math.Round(pause, 3),
+                ["index0"] = index0,
+                ["index1"] = after.Index,
+                ["allocatedNowMB"] = Math.Round(GC.GetTotalMemory(false) / 1048576.0, 1),
+                ["workingSetMB"] = Math.Round(Environment.WorkingSet / 1048576.0, 1),
+                ["lastGc"] = Info(after),
+            });
+            Console.WriteLine($"   redraw {r + 1,3}: {ms,8:F2} ms, GC pause {pause,7:F2} ms, GCs {after.Index - index0}, heap after last GC {after.HeapSizeBytes / 1048576.0:F0} MB, committed {after.TotalCommittedBytes / 1048576.0:F0} MB");
+        }
+        await recorder.WaitForAsync(GC.GetGCMemoryInfo(GCKind.Any).Index);
+        foreach (var row in rows)
+            row["collections"] = recorder.Between((long)row["index0"]!, (long)row["index1"]!).Select(Gc).ToArray();
+        var times = rows.Select(r => (double)r["redrawMs"]!).ToArray();
+        await renderer.DisposeAsync();
+        return new
+        {
+            a, b, redraws,
+            events = recorder.EventCounts, firstPerHeapHistory = recorder.FirstPerHeap,
+            gcSettings = new { GCSettings.IsServerGC, latency = GCSettings.LatencyMode.ToString() },
+            redrawMs = Stat.Of(times), rows,
+        };
+    }
+}
diff --git a/spikes/paint-text/PaintCosts/PivotPaint.cs b/spikes/paint-text/PaintCosts/PivotPaint.cs
new file mode 100644
index 00000000..95c1769b
--- /dev/null
+++ b/spikes/paint-text/PaintCosts/PivotPaint.cs
@@ -0,0 +1,222 @@
+using System.Diagnostics;
+using System.Globalization;
+using ExGrid;
+using ExGrid.Components;
+using ExPivot;
+using ExPivot.Engine;
+using Microsoft.AspNetCore.Components;
+using Microsoft.Extensions.Time.Testing;
+using PivotComponent = ExPivot.Components.ExPivot;
+
+namespace Costs;
+
+/// <summary>A record of D10's report: two text fields, A00000… × B0000…, and a number.</summary>
+public sealed record Cell(string Id, string A, string B, decimal Value);
+
+/// <summary>
+/// ExPivot over D10's report (ticket 01's PivotCosts: A × B with A's subtotals, Viewport 300 × 900,
+/// 11 painted rows), its report grid driven as the browser would: a scroll by one row and by a page,
+/// a fling frame and its settle, and a live redraw (a batch applied past the redraw interval, slicing
+/// off, so the redraw runs inline), whose new report makes every painted row a new instance.
+/// </summary>
+public static class PivotPaint
+{
+    private static readonly PivotSlicing Never = new() { Budget = TimeSpan.FromDays(1) };
+
+    public static readonly PivotFields<Cell> Fields = PivotFields.Of<Cell>()
+        .Key("Id", c => c.Id)
+        .Text("A", c => c.A)
+        .Text("B", c => c.B)
+        .Number("Value", c => c.Value, format: "#,##0.00");
+
+    private static readonly PivotLayout Layout = new()
+    {
+        Rows = [new PivotFieldPlacement("A"), new PivotFieldPlacement("B")],
+        Values = [new PivotValueField("Value", PivotAggregation.Sum) { NumberFormat = "#,##0.00" }],
+    };
+
+    public static Cell[] Make(int aCount, int bCount)
+    {
+        var random = new Random(20261006);
+        var cells = new Cell[aCount * bCount];
+        for (var a = 0; a < aCount; a++)
+        {
+            for (var b = 0; b < bCount; b++)
+            {
+                var i = (a * bCount) + b;
+                cells[i] = new Cell(
+                    "R" + i.ToString(CultureInfo.InvariantCulture),
+                    "A" + a.ToString("00000", CultureInfo.InvariantCulture),
+                    "B" + b.ToString("0000", CultureInfo.InvariantCulture),
+                    Math.Round((decimal)((random.NextDouble() - 0.45) * 100_000), 2));
+            }
+        }
+        return cells;
+    }
+
+    /// <summary>k records, each picked once, uniformly, their value moved (as /pivot-live amends).</summary>
+    public static Cell[] Amend(Cell[] cells, int count, Random random)
+    {
+        var picked = new HashSet<int>();
+        while (picked.Count < count)
+            picked.Add(random.Next(cells.Length));
+        var amended = new Cell[picked.Count];
+        var i = 0;
+        foreach (var at in picked)
+        {
+            var cell = cells[at];
+            amended[i++] = cells[at] = cell with { Value = cell.Value + Math.Round((decimal)((random.NextDouble() - 0.5) * 200), 2) };
+        }
+        return amended;
+    }
+
+    internal static async Task<(CountingRenderer Renderer, PivotComponent Pivot, IGridPivotSource Source, Cell[] Newest, FakeTimeProvider Clock)> StartAsync(int aCount, int bCount)
+    {
+        var cells = Make(aCount, bCount);
+        var caps = new PivotCaps { MaxLeaves = 2_000_000 };
+        var source = PivotSource.From(cells, Fields, Never);
+        var clock = new FakeTimeProvider(DateTimeOffset.UnixEpoch.AddYears(56));
+        var renderer = new CountingRenderer(new Services(clock)) { Watched = typeof(ExGridRow<>) };
+        var pivot = renderer.Create<PivotComponent>();
+        var pivotId = renderer.Attach(pivot);
+        await renderer.Dispatcher.InvokeAsync(() => renderer.RenderRootAsync(pivotId, ParameterView.FromDictionary(new Dictionary<string, object?>
+        {
+            [nameof(PivotComponent.Source)] = source,
+            [nameof(PivotComponent.Layout)] = Layout,
+            [nameof(PivotComponent.RedrawInterval)] = TimeSpan.FromMilliseconds(250),
+            [nameof(PivotComponent.ChangeHighlightDuration)] = TimeSpan.FromSeconds(1),
+            [nameof(PivotComponent.Culture)] = CultureInfo.GetCultureInfo("en-US"),
+            [nameof(PivotComponent.ViewportHeight)] = (ViewportSize)300,
+            [nameof(PivotComponent.ViewportWidth)] = (ViewportSize)900,
+            [nameof(PivotComponent.Slicing)] = Never,
+            [nameof(PivotComponent.Caps)] = caps,
+        })));
+        for (var wait = 0; pivot.Report is null; wait++)
+        {
+            if (wait > 6000)
+                throw new TimeoutException("ExPivot showed no report.");
+            await Task.Delay(10);
+            for (var s = 0; s < 5; s++)
+                await renderer.Dispatcher.InvokeAsync(() => Task.Yield());
+        }
+        for (var s = 0; s < 5; s++)
+            await renderer.Dispatcher.InvokeAsync(() => Task.Yield());
+        return (renderer, pivot, new PivotSourceHandle(source), (Cell[])cells.Clone(), clock);
+    }
+
+    /// <summary>The bundled source, applied to by the harness.</summary>
+    internal interface IGridPivotSource
+    {
+        void Apply(Cell[] amended);
+    }
+
+    private sealed class PivotSourceHandle(SnapshotPivotSource source) : IGridPivotSource
+    {
+        public void Apply(Cell[] amended) => source.Apply(Fields.Batch(changed: amended));
+    }
+
+    public static async Task<object> RunAsync(int aCount, int bCount, int warmup, int runs)
+    {
+        var t0 = Stopwatch.GetTimestamp();
+        var (renderer, pivot, source, newest, clock) = await StartAsync(aCount, bCount);
+        var grid = Reflect.Get<ExGrid<PivotReportRow>>(pivot, "_grid");
+        var rig = new Rig<PivotReportRow>(renderer, grid);
+        var rowHeight = Reflect.Get(grid, "_geometry")!.GetType().GetProperty("RowHeightPx")!.GetValue(Reflect.Get(grid, "_geometry"));
+        var height = Convert.ToDouble(rowHeight, CultureInfo.InvariantCulture);
+        var reportRows = pivot.Report!.Rows.Count;
+        var top = 1_000 * height;
+        Task To(double y) => renderer.Dispatcher.InvokeAsync(() => { rig.Scroll(y, 0); rig.Settle(); });
+        await To(top);
+        await rig.SettleAsync();
+        var painted = rig.PaintedCount;
+        var page = rig.RowsPerViewport;
+        Console.WriteLine($"== ExPivot: {aCount:N0} x {bCount:N0}, {reportRows:N0} report rows, {grid.Columns.Count} columns, made in {Clock.Ms(t0):F0} ms; painted rows {painted} from {rig.FirstPainted}; a page is {page} rows (row {height}px) ==");
+
+        var random = new Random(7);
+        var scenarios = new List<(string Name, Func<Task> SetA, Func<Task> StepB)>
+        {
+            ("a: scroll by 1 row", () => To(top), () => { rig.Scroll(top + height, 0); return Task.CompletedTask; }),
+            ("b: scroll by a page", () => To(top), () => { rig.Scroll(top + (page * height), 0); return Task.CompletedTask; }),
+            ("c: fling frame (Placeholders)", async () =>
+                {
+                    await To(top);
+                    await renderer.Dispatcher.InvokeAsync(() => rig.Scroll(top + (3 * page * height), 0));
+                },
+                () => { rig.Scroll(top + (6 * page * height), 0); return Task.CompletedTask; }),
+            ("c2: fling settles", async () =>
+                {
+                    await To(top);
+                    await renderer.Dispatcher.InvokeAsync(() => rig.Scroll(top + (3 * page * height), 0));
+                },
+                () => { rig.Settle(); return Task.CompletedTask; }),
+            // A live redraw: past the redraw interval, one record amended; slicing off, so the
+            // redraw — answer, cube, report, Show and the grid's render — runs inside the Apply.
+            ("e: live redraw (every painted row new)", async () =>
+                {
+                    await To(top);
+                    await renderer.Dispatcher.InvokeAsync(() => clock.Advance(TimeSpan.FromMilliseconds(400)));
+                },
+                () =>
+                {
+                    var before = pivot.Report;
+                    source.Apply(Amend(newest, 1, random));
+                    if (ReferenceEquals(pivot.Report, before))
+                        throw new InvalidOperationException("The redraw did not run inline.");
+                    return Task.CompletedTask;
+                }),
+        };
+        var results = new List<object>();
+        foreach (var (name, setA, stepB) in scenarios)
+        {
+            var machineBefore = Machine.Snapshot();
+            var series = await rig.MeasureAsync(setA, stepB, warmup, runs);
+            results.Add(new { scenario = name, measured = series.Summary(), machineBefore, machineAfter = Machine.Snapshot() });
+            Console.WriteLine($"-- {name}");
+            GridPaint.Print("step (scroll/redraw + render)", Stat.Of(series.StepMs));
+            GridPaint.Print("render (ProcessPendingRender)", Stat.Of(series.RenderMs));
+            GridPaint.Print("NotePaint alone", Stat.Of(series.PaintMs));
+            Console.WriteLine($"   NotePaint bytes {Stat.Of(series.PaintBytes).Median:F0}; step bytes {Stat.Of(series.StepBytes).Median:F0}; rows rendered {Stat.Of(series.RowsRendered).Median} (+{Stat.Of(series.RowsRenderedAfter).Median} after); new paints {Stat.Of(series.NewPaints).Median}");
+        }
+        await renderer.DisposeAsync();
+        return new { aCount, bCount, reportRows, columns = grid.Columns.Count, paintedRows = painted, rowsPerViewport = page, results };
+    }
+
+    /// <summary>
+    /// The memory a run of live redraws keeps (ticket 01's pivot-memory): after each redraw a full
+    /// collection, the managed heap, and how many earlier reports and cubes are still alive.
+    /// </summary>
+    public static async Task<object> MemoryAsync(int aCount, int bCount, int k, int redraws)
+    {
+        var (renderer, pivot, source, newest, clock) = await StartAsync(aCount, bCount);
+        var random = new Random(7);
+        var reports = new List<WeakReference>();
+        var cubes = new List<WeakReference>();
+        var samples = new List<object>();
+        Clock.Collect();
+        var baseline = GC.GetTotalMemory(forceFullCollection: true);
+        Console.WriteLine($"== ExPivot memory, {aCount:N0} x {bCount:N0}, k {k}: after the first report {baseline / 1048576.0:F1} MB ==");
+        for (var r = 0; r < redraws; r++)
+        {
+            reports.Add(new WeakReference(pivot.Report));
+            cubes.Add(new WeakReference(pivot.Report!.Cube));
+            var before = pivot.Report;
+            var amended = Amend(newest, k, random);
+            await renderer.Dispatcher.InvokeAsync(() => clock.Advance(TimeSpan.FromMilliseconds(400)));
+            await renderer.Dispatcher.InvokeAsync(() => source.Apply(amended));
+            while (ReferenceEquals(pivot.Report, before))
+                await Task.Delay(5);
+            for (var s = 0; s < 5; s++)
+                await renderer.Dispatcher.InvokeAsync(() => Task.Yield());
+            Clock.Collect();
+            var heap = GC.GetTotalMemory(forceFullCollection: true);
+            var aliveReports = reports.Count(w => w.IsAlive);
+            var aliveCubes = cubes.Count(w => w.IsAlive);
+            samples.Add(new { redraw = r + 1, heapMB = Math.Round(heap / 1048576.0, 1), aliveEarlierReports = aliveReports, aliveEarlierCubes = aliveCubes });
+            Console.WriteLine($"   redraw {r + 1,3}: heap {heap / 1048576.0,8:F1} MB; earlier reports alive {aliveReports,3} of {reports.Count}, cubes {aliveCubes,3}");
+        }
+        var grid = Reflect.Get<ExGrid<PivotReportRow>>(pivot, "_grid");
+        var paintsKept = ((System.Collections.IList)Reflect.Get(grid, "_paints")!).Count;
+        await renderer.DisposeAsync();
+        return new { aCount, bCount, k, redraws, baselineMB = Math.Round(baseline / 1048576.0, 1), samples, paintsKept };
+    }
+}
diff --git a/spikes/paint-text/PaintCosts/Program.cs b/spikes/paint-text/PaintCosts/Program.cs
