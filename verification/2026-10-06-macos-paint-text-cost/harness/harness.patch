@@ -0,0 +1,80 @@
+using System.Globalization;
+using Costs;
+
+// What a paint costs under ADR-0142's kept paints, V0 (rows kept) against V1 (painted text kept).
+// Run in Release with DOTNET_TieredCompilation=0; write the output where it lasts, never under the
+// temp directory:
+//
+//   dotnet PaintCosts.dll grid  <out.json> [warmup] [runs] [viewportHeight] [viewportWidth]
+//   dotnet PaintCosts.dll pivot <out.json> <A> <B> [warmup] [runs]
+//   dotnet PaintCosts.dll pivot-memory <out.json> <A> <B> <k> <redraws>
+//   dotnet PaintCosts.dll pivot-gc <out.json> <A> <B> [warmup] [runs] [full|compact|none] [verbose|info|off]
+//   dotnet PaintCosts.dll pivot-steady <out.json> <A> <B> [redraws]
+
+if (args.Length < 2)
+{
+    Console.Error.WriteLine("grid <out.json> [warmup] [runs] [h] [w] | pivot <out.json> <A> <B> [warmup] [runs] | pivot-memory <out.json> <A> <B> <k> <redraws>");
+    return 2;
+}
+
+static int Arg(string[] args, int at, int otherwise) => args.Length > at ? int.Parse(args[at], CultureInfo.InvariantCulture) : otherwise;
+
+var output = args[1];
+var machine = Machine.Snapshot();
+var variant = Environment.GetEnvironmentVariable("PAINT_VARIANT") ?? "(unnamed)";
+Console.WriteLine($"variant {variant}; load {((dynamic)machine).loadavg}; TieredCompilation={Environment.GetEnvironmentVariable("DOTNET_TieredCompilation") ?? "(default)"}");
+object result;
+switch (args[0])
+{
+    case "grid":
+    {
+        var warmup = Arg(args, 2, 3);
+        var runs = Arg(args, 3, 15);
+        var height = Arg(args, 4, 990);
+        var width = Arg(args, 5, 1650);
+        result = new { mode = "grid", variant, warmup, runs, machine, measured = await GridPaint.RunAsync(warmup, runs, height, width) };
+        break;
+    }
+    case "pivot":
+    {
+        var a = int.Parse(args[2], CultureInfo.InvariantCulture);
+        var b = int.Parse(args[3], CultureInfo.InvariantCulture);
+        var warmup = Arg(args, 4, 3);
+        var runs = Arg(args, 5, 15);
+        result = new { mode = "pivot", variant, warmup, runs, machine, measured = await PivotPaint.RunAsync(a, b, warmup, runs) };
+        break;
+    }
+    case "pivot-memory":
+    {
+        var a = int.Parse(args[2], CultureInfo.InvariantCulture);
+        var b = int.Parse(args[3], CultureInfo.InvariantCulture);
+        var k = int.Parse(args[4], CultureInfo.InvariantCulture);
+        var redraws = int.Parse(args[5], CultureInfo.InvariantCulture);
+        result = new { mode = "pivot-memory", variant, machine, measured = await PivotPaint.MemoryAsync(a, b, k, redraws) };
+        break;
+    }
+    case "pivot-gc":
+    {
+        var a = int.Parse(args[2], CultureInfo.InvariantCulture);
+        var b = int.Parse(args[3], CultureInfo.InvariantCulture);
+        var warmup = Arg(args, 4, 3);
+        var runs = Arg(args, 5, 15);
+        var precollect = args.Length > 6 ? args[6] : "full";
+        var listen = args.Length > 7 ? args[7] : "verbose";
+        result = new { mode = "pivot-gc", variant, machine, measured = await PivotGc.RunAsync(a, b, warmup, runs, precollect, listen) };
+        break;
+    }
+    case "pivot-steady":
+    {
+        var a = int.Parse(args[2], CultureInfo.InvariantCulture);
+        var b = int.Parse(args[3], CultureInfo.InvariantCulture);
+        var redraws = Arg(args, 4, 60);
+        result = new { mode = "pivot-steady", variant, machine, measured = await PivotGc.SteadyAsync(a, b, redraws) };
+        break;
+    }
+    default:
+        Console.Error.WriteLine($"no mode {args[0]}");
+        return 2;
+}
+Machine.Write(output, result);
+return 0;
diff --git a/spikes/paint-text/PaintCosts/Rig.cs b/spikes/paint-text/PaintCosts/Rig.cs
new file mode 100644
index 00000000..6e40b73d
--- /dev/null
+++ b/spikes/paint-text/PaintCosts/Rig.cs
@@ -0,0 +1,199 @@
+using System.Collections;
+using System.Diagnostics;
+using System.Reflection;
+using ExGrid.Components;
+using Microsoft.AspNetCore.Components;
+
+namespace Costs;
+
+/// <summary>One step's timings and counts, every run kept.</summary>
+public sealed class StepSeries
+{
+    public List<double> StepMs { get; } = [];
+    public List<double> RenderMs { get; } = [];
+    public List<double> StepBytes { get; } = [];
+    public List<double> RowsRendered { get; } = [];
+    public List<double> RowsMounted { get; } = [];
+    public List<double> RowsRenderedAfter { get; } = [];
+    public List<double> NewPaints { get; } = [];
+    public List<double> PaintMs { get; } = [];
+    public List<double> PaintBytes { get; } = [];
+    public List<double> StepGcPauseMs { get; } = [];
+    public List<double> StepGen0 { get; } = [];
+    public List<double> StepGen1 { get; } = [];
+    public List<double> StepGen2 { get; } = [];
+
+    public object Summary() => new
+    {
+        step = Stat.Of(StepMs),
+        render = Stat.Of(RenderMs),
+        stepBytes = Stat.Of(StepBytes),
+        notePaintAlone = Stat.Of(PaintMs),
+        notePaintAloneBytes = Stat.Of(PaintBytes),
+        paintShareOfRenderAtLeast = Math.Round(PaintMs.Min() / RenderMs.Min(), 4),
+        paintShareOfRenderAtMedian = Math.Round(Stat.Of(PaintMs).Median / Stat.Of(RenderMs).Median, 4),
+        rowsRendered = Stat.Of(RowsRendered),
+        rowsMounted = Stat.Of(RowsMounted),
+        rowsRenderedAfter = Stat.Of(RowsRenderedAfter),
+        newPaints = Stat.Of(NewPaints),
+        stepGcPauseMs = Stat.Of(StepGcPauseMs),
+        stepGen0Collections = Stat.Of(StepGen0),
+        stepGen1Collections = Stat.Of(StepGen1),
+        stepGen2Collections = Stat.Of(StepGen2),
+    };
+}
+
+/// <summary>
+/// One ExGrid on the counting renderer, driven as the browser would drive it: a scroll offset
+/// applied (ApplyScrollOffset, what OnScrollAsync does with the offset it reads), a fling settled
+/// (OnSettled, what the settle timer runs), or new parameters. Each step is timed with the render it
+/// causes; and NotePaint — the paint alone — is timed again on the same state, with the kept paints
+/// put back as they were before the step each time, so it notes the same paint against the same
+/// previous one.
+/// </summary>
+public sealed class Rig<TRow>(CountingRenderer renderer, ExGrid<TRow> grid) where TRow : class
+{
+    private readonly MethodInfo _applyScroll = Reflect.Method(typeof(ExGrid<TRow>), "ApplyScrollOffset");
+    private readonly MethodInfo _onSettled = Reflect.Method(typeof(ExGrid<TRow>), "OnSettled");
+    private readonly Func<int> _notePaint = (Func<int>)Reflect.Method(typeof(ExGrid<TRow>), "NotePaint").CreateDelegate(typeof(Func<int>), grid);
+    private readonly FieldInfo _paints = Reflect.Field(typeof(ExGrid<TRow>), "_paints");
+    private readonly FieldInfo _paintId = Reflect.Field(typeof(ExGrid<TRow>), "_paintId");
+
+    public CountingRenderer Renderer => renderer;
+
+    public ExGrid<TRow> Grid => grid;
+
+    public int PaintId => (int)_paintId.GetValue(grid)!;
+
+    public int PaintsKept => ((IList)_paints.GetValue(grid)!).Count;
+
+    public void Scroll(double top, double left) => _applyScroll.Invoke(grid, [new ScrollOffset(top, left)]);
+
+    public void Settle() => _onSettled.Invoke(grid, [null]);
+
+    public bool Placeholder => Reflect.Get<bool>(grid, "_placeholderMode");
+
+    public int FirstPainted => Reflect.Get(grid, "_visible") is { } v ? (int)v.GetType().GetProperty("Start")!.GetValue(v)! : -1;
+
+    public int PaintedCount => Reflect.Get(grid, "_visible") is { } v ? (int)v.GetType().GetProperty("Count")!.GetValue(v)! : -1;
+
+    public int RowsPerViewport
+    {
+        get
+        {
+            var geometry = Reflect.Get(grid, "_geometry")!;
+            return (int)geometry.GetType().GetProperty("RowsPerViewport")!.GetValue(geometry)!;
+        }
+    }
+
+    public string Slice => Reflect.Get(grid, "_scrollable")?.ToString() ?? "null";
+
+    /// <summary>The kept paints as they are, and the newest one's settable state.</summary>
+    private (object[] Paints, (PropertyInfo Property, object? Value)[] Newest) Snapshot()
+    {
+        var list = (IList)_paints.GetValue(grid)!;
+        var paints = list.Cast<object>().ToArray();
+        var newest = paints[^1];
+        var state = newest.GetType().GetProperties(BindingFlags.Public | BindingFlags.Instance)
+            .Where(p => p.CanWrite).Select(p => (p, p.GetValue(newest))).ToArray();
+        return (paints, state);
+    }
+
+    private void Restore((object[] Paints, (PropertyInfo Property, object? Value)[] Newest) snapshot)
+    {
+        var list = (IList)_paints.GetValue(grid)!;
+        list.Clear();
+        foreach (var paint in snapshot.Paints)
+            list.Add(paint);
+        var newest = snapshot.Paints[^1];
+        foreach (var (property, value) in snapshot.Newest)
+            property.SetValue(newest, value);
+    }
+
+    /// <summary>
+    /// Runs <paramref name="setA"/> then times <paramref name="stepB"/>, <paramref name="warmup"/>
+    /// + <paramref name="runs"/> times, a full collection before each timed step; then times
+    /// NotePaint alone on the last B state the same number of times.
+    /// </summary>
+    public async Task<StepSeries> MeasureAsync(Func<Task> setA, Func<Task> stepB, int warmup, int runs)
+    {
+        var series = new StepSeries();
+        for (var r = 0; r < warmup + runs; r++)
+        {
+            await setA();
+            await SettleAsync();
+            Clock.Collect();
+            renderer.Take();
+            var before = PaintId;
+            double ms = 0;
+            long bytes = 0;
+            double pause = 0;
+            int g0 = 0, g1 = 0, g2 = 0;
+            await renderer.Dispatcher.InvokeAsync(async () =>
+            {
+                var p0 = GC.GetTotalPauseDuration();
+                var (c0, c1, c2) = (GC.CollectionCount(0), GC.CollectionCount(1), GC.CollectionCount(2));
+                var a0 = GC.GetAllocatedBytesForCurrentThread();
+                var t0 = Stopwatch.GetTimestamp();
+                await stepB();
+                ms = Clock.Ms(t0);
+                bytes = GC.GetAllocatedBytesForCurrentThread() - a0;
+                pause = (GC.GetTotalPauseDuration() - p0).TotalMilliseconds;
+                (g0, g1, g2) = (GC.CollectionCount(0) - c0, GC.CollectionCount(1) - c1, GC.CollectionCount(2) - c2);
+            });
+            var (counts, renderMs) = renderer.Take();
+            var newPaints = PaintId - before;
+            await SettleAsync();
+            var (after, _) = renderer.Take();
+            if (r >= warmup)
+            {
+                series.StepMs.Add(ms);
+                series.RenderMs.Add(renderMs);
+                series.StepBytes.Add(bytes);
+                series.RowsRendered.Add(counts.WatchedRendered);
+                series.RowsMounted.Add(counts.WatchedMounted);
+                series.RowsRenderedAfter.Add(after.WatchedRendered);
+                series.NewPaints.Add(newPaints);
+                series.StepGcPauseMs.Add(pause);
+                series.StepGen0.Add(g0);
+                series.StepGen1.Add(g1);
+                series.StepGen2.Add(g2);
+            }
+        }
+
+        // The paint alone: the kept paints as they were before the step, and the state after it.
+        await setA();
+        await SettleAsync();
+        var snapshot = await renderer.Dispatcher.InvokeAsync(Snapshot);
+        await renderer.Dispatcher.InvokeAsync(stepB);
+        await SettleAsync();
+        for (var r = 0; r < warmup + runs; r++)
+        {
+            await renderer.Dispatcher.InvokeAsync(() => Restore(snapshot));
+            Clock.Collect();
+            double ms = 0;
+            long bytes = 0;
+            await renderer.Dispatcher.InvokeAsync(() =>
+            {
+                var a0 = GC.GetAllocatedBytesForCurrentThread();
+                var t0 = Stopwatch.GetTimestamp();
+                _notePaint();
+                ms = Clock.Ms(t0);
+                bytes = GC.GetAllocatedBytesForCurrentThread() - a0;
+            });
+            if (r >= warmup)
+            {
+                series.PaintMs.Add(ms);
+                series.PaintBytes.Add(bytes);
+            }
+        }
+        return series;
+    }
+
+    /// <summary>Whatever the grid renders again after a step, on its own continuations.</summary>
+    public async Task SettleAsync()
+    {
+        for (var settle = 0; settle < 5; settle++)
+            await renderer.Dispatcher.InvokeAsync(() => Task.Yield());
+    }
+}
