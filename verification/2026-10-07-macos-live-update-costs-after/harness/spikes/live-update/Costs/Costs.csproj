<Project Sdk="Microsoft.NET.Sdk">

  <!-- Ticket 01 of docs/specs/live-data: where the time of one live update goes, step by step, in
       ExGrid (GridSource.From keyed, as /grid-live-local) and in ExPivot (a live redraw over two row
       fields). Each step is timed in isolation on the same inputs, CoreCLR Release, run with
       DOTNET_TieredCompilation=0, the least of the runs read. Private steps are reached by
       reflection; nothing under src/ changes. Disposable: recreated, never committed. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <!-- RenderTree types are public but "for framework use": reading a RenderBatch is the point. -->
    <NoWarn>$(NoWarn);BL0005;BL0006</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\ExGrid\ExGrid.csproj" />
    <ProjectReference Include="..\..\..\src\ExPivot\ExPivot.csproj" />
  </ItemGroup>

</Project>
