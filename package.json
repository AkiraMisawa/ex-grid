{
  "name": "ex-grid",
  "private": true,
  "version": "0.0.0",
  "description": "The npm workspace at the repository's root (ADR-0350 section 13, ADR-0370 section 9): the packages npm publishes and the Blazor adapters' browser halves under packages/, the React hosts under samples/, layer 3 under tests/browser and the tools that run on Node.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/data",
    "packages/data-xlsx",
    "packages/core",
    "packages/chart",
    "packages/pivot-engine",
    "packages/pivot",
    "packages/board",
    "packages/react",
    "packages/chart-react",
    "packages/mantine",
    "packages/chart-mantine",
    "packages/mui",
    "packages/chart-mui",
    "packages/blazor",
    "packages/pivot-react",
    "packages/pivot-mantine",
    "packages/pivot-mui",
    "packages/pivot-blazor",
    "packages/chart-blazor",
    "packages/board-react",
    "packages/board-blazor",
    "packages/sheet-engine",
    "packages/sheet-xlsx",
    "packages/sheet",
    "packages/sheet-react",
    "packages/sheet-blazor",
    "packages/sheet-mantine",
    "packages/sheet-mui",
    "samples/ExGrid.DemoHost.React",
    "samples/ExGrid.Docs.React",
    "tests/browser",
    "tools/assets",
    "tools/readme-media"
  ],
  "scripts": {
    "build": "npm run build -w packages",
    "api": "npm run api -w packages",
    "lint": "node tools/lint/check.mjs",
    "test": "npm run test -w packages",
    "typecheck": "npm run typecheck -w packages"
  },
  "devDependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mantine/core": "9.7.4",
    "@mantine/hooks": "9.7.4",
    "@microsoft/api-extractor": "7.59.4",
    "@mui/material": "9.5.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.28.2",
    "happy-dom": "21.0.4",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "temporal-polyfill": "1.0.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.23.4 <23 || >=24.22.1 <25 || >=26.12.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.10": true
  }
}
