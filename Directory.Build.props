<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- LangVersion is deliberately not set: net10.0 defaults to C# 14 and the
         compiler ties the language to the target regardless of SDK version (ADR-0022). -->
  </PropertyGroup>
</Project>
