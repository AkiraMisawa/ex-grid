@page "/cells"

<nav class="demo-nav">
    <a href="">Row identity</a>
    <a href="virtual">Virtualised</a>
    <a href="wide">Wide</a>
    <span>Cells and rows</span>
    <a href="server">Server</a>
</nav>

<h1>Cells and rows — state, role, actions and a template</h1>

<p>
    Everything on this page is something the value alone cannot say. <b>Cell State</b>
    (ADR-0006) is asked for by (row, column) and answered as one of five: normal, stale,
    missing, error, modified. <b>Row Kind</b> (ADR-0024) says whether a row is a detail,
    a group header or a total — the Consumer computed the subtotals; the grid was only
    told the roles. The last columns are two <b>Template Columns</b> and two
    <b>Action Columns</b> (ADR-0020).
</p>

<p>
    Everything here is reachable from the keyboard (ADR-0037). <b>Space</b> on an
    <i>Open</i> cell fires it. Space on a <i>Review</i> cell enters it: <b>←</b> and
    <b>→</b> choose, Space fires the chosen action, <b>Esc</b> leaves, and Enter or Tab
    leave without firing anything. Space on a <i>Note</i> cell puts the caret in the
    field; Esc brings the keyboard back to the grid.
</p>

<div class="demo-toolbar">
    @* The two buttons are the same edit to the same set. One hands over a new lookup and
       one does not, which is the whole rule made visible (ADR-0006). *@
    <button id="refresh-batch" @onclick="RefreshBatch">
        New batch — hand over a new lookup (@_batch is current)
    </button>
    <button id="rewrite-in-place" @onclick="RewriteInPlace">
        Rewrite the same lookup's data — nothing should change until the next new lookup
    </button>
</div>

<p class="demo-status">
    <span id="action-status">@_lastAction</span>
</p>

<ExGrid TRow="DemoPosition"
        Window="DemoData.Positions"
        Columns="Columns"
        CellState="_cellState"
        RowKind="RowKindOf"
        OnAction="OnAction"
        RowHeight="28"
        ViewportHeight="420"
        ViewportWidth="1100"
        PinnedColumnCount="1" />

@code {
    // Held in fields, never rebuilt per render: a new columns array or a new delegate
    // would hand every row a changed parameter and defeat memoisation (ADR-0003).
    private static readonly RenderFragment<TemplateCellContext<DemoPosition>> LimitBar = cell => @<div class="demo-bar">
        <div class="demo-bar-fill" style="width: @(((int)(cell.Row.LimitUsed * 100)).ToString())%"></div>
    </div>;

    /// <summary>
    /// The other half of ADR-0020's seam: a control the Consumer owns. `ex-interactive`
    /// turns pointer events back on for it, and the grid stops the mouse at the cell, so
    /// clicking it does not move the selection — and because it then holds the keyboard,
    /// the grid's own keys stay out of its way. Typing, arrows and Ctrl+A all belong to
    /// the field while it has focus. It is a component rather than bare markup because
    /// Space enters it (ADR-0037): the grid asks, and only a component can answer by
    /// focusing its own input.
    /// </summary>
    private static readonly RenderFragment<TemplateCellContext<DemoPosition>> NoteTemplate =
        cell => @<NoteInput Cell="cell" />;

    private static readonly GridColumn<DemoPosition>[] Columns =
    [
        new("Book", ColumnType.Text, r => r.Book, width: new ColumnWidthSpec(ColumnWidth.Fixed(180))),
        new("CloseOfBusiness", ColumnType.Number, r => r.CloseOfBusiness, header: "Close of business"),
        new("Intraday", ColumnType.Number, r => r.Intraday),
        // The value accessor is still required, and it is what sorting and copy read —
        // never the template (ADR-0020).
        GridColumn<DemoPosition>.TemplateColumn("LimitUsed", ColumnType.Number, r => r.LimitUsed, LimitBar,
            header: "Limit used", width: new ColumnWidthSpec(ColumnWidth.Fixed(160))),
        GridColumn<DemoPosition>.TemplateColumn("Note", ColumnType.Text, r => r.Book, NoteTemplate,
            header: "Note", width: new ColumnWidthSpec(ColumnWidth.Fixed(140))),
        GridColumn<DemoPosition>.ActionColumn("Actions", [new GridAction("open", "Open")]),
        // Several actions in one cell: Space enters it and the arrows choose — the
        // Interactive mode (ADR-0020/0037). Declared, never counted from the markup.
        GridColumn<DemoPosition>.ActionColumn("Review",
            [new GridAction("approve", "Approve"), new GridAction("query", "Query"), new GridAction("escalate", "Escalate")],
            header: "Review"),
    ];

    private static readonly Func<DemoPosition, RowKind> RowKindOf = row => row.Kind;

    // What the Consumer's own vocabulary looks like before it is mapped onto the grid's
    // five: which books this batch could not refresh, and which were overridden by hand.
    private readonly HashSet<string> _staleBooks = ["EMEA · Credit", "EMEA · FX"];
    private readonly HashSet<string> _overriddenBooks = ["Americas · Rates"];

    private CellStateOf<DemoPosition> _cellState = default!;
    private int _batch = 1;
    private string _lastAction = "No action pressed yet.";
    private int _presses;

    protected override void OnInitialized() => _cellState = BuildLookup();

    /// <summary>
    /// One dictionary probe's worth of work, called once per painted cell on every
    /// render (ADR-0006). The Consumer's vocabulary — "this batch did not reach that
    /// book" — is mapped onto the grid's five here, on the way in.
    /// </summary>
    /// <b>It reads the live sets, it does not snapshot them.</b> Snapshotting would make
    /// the page's second button prove nothing: the screen would stay put because the
    /// lookup never saw the change, not because the grid was never told of one.
    private CellStateOf<DemoPosition> BuildLookup()
    {
        return (row, column) => column.Name switch
        {
            "Intraday" when _staleBooks.Contains(row.Book) => CellState.Stale,
            "Intraday" when _overriddenBooks.Contains(row.Book) => CellState.Modified,
            "CloseOfBusiness" when row.Book == "Americas · Commodity" => CellState.Error,
            "CloseOfBusiness" when row.Book == "Americas · Equity" => CellState.Missing,
            _ => CellState.Normal,
        };
    }

    /// <summary>The supported way to change metadata: a new lookup is the change
    /// signal, exactly as a new row instance is (ADR-0006 / ADR-0003).</summary>
    private void RefreshBatch()
    {
        _batch++;
        _staleBooks.Remove("EMEA · FX");
        _staleBooks.Add("Americas · Equity");
        _cellState = BuildLookup();
    }

    /// <summary>The documented cost of that rule, made visible: the set the live lookup
    /// reads changes and the screen does not, because nothing told the grid anything
    /// changed. The edit is not lost — it appears the moment a new lookup is handed
    /// over, which is the other half of what the rule means.</summary>
    private void RewriteInPlace()
    {
        _staleBooks.Add("Americas · Credit");
        _staleBooks.Remove("EMEA · Credit");
    }

    // The count makes "fired exactly once" observable: a held Space must not fire again
    // per auto-repeat, and Enter must never fire at all (ADR-0020/0037).
    private void OnAction(GridActionEventArgs<DemoPosition> args)
        => _lastAction = $"Pressed '{args.ActionName}' in column '{args.ColumnName}' on {args.Row.Book}. Presses so far: {++_presses}.";
}
