<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <!-- net10.0: this host is not shipped and targets what the SDK provides, which is
         also the shipped packages' target (ADR-0022). -->
    <TargetFramework>net10.0</TargetFramework>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.7" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.7" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- The standalone WebAssembly host, the first Consumer's shape (ADR-0017). It holds
         no pages of its own: they are ExGrid.DemoPages', which the Server host serves
         too, and nothing references either host (ADR-0019). -->
    <ProjectReference Include="..\ExGrid.DemoPages\ExGrid.DemoPages.csproj" />
  </ItemGroup>

</Project>
