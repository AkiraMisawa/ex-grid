{
  // The workspace's settings, so the packages' sources it builds from type as they do there.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "declaration": false,
    "emitDeclarationOnly": false,
    "noEmit": true,
    "types": ["vite/client", "node"],
    // The Examples and the packages' sources sit outside this folder; their React is the workspace's one copy at the root.
    "paths": {
      "react": ["../../node_modules/@types/react/index.d.ts"],
      "react/*": ["../../node_modules/@types/react/*"],
      "react-dom": ["../../node_modules/@types/react-dom/index.d.ts"],
      "react-dom/*": ["../../node_modules/@types/react-dom/*"],
      "@ex-grid/core": ["../../packages/core/src/index.ts"],
      "@ex-grid/react": ["../../packages/react/src/index.ts"],
      "@ex-grid/data": ["../../packages/data/src/index.ts"],
      "@ex-grid/sheet-engine": ["../../packages/sheet-engine/src/index.ts"],
      "@ex-grid/sheet": ["../../packages/sheet/src/index.ts"],
      "@ex-grid/sheet-react": ["../../packages/sheet-react/src/index.ts"],
      "@ex-grid/data-xlsx": ["../../packages/data-xlsx/src/index.ts"],
      "@ex-grid/sheet-xlsx": ["../../packages/sheet-xlsx/src/index.ts"],
      "@ex-grid/mantine": ["../../packages/mantine/src/index.ts"],
      "@ex-grid/sheet-mantine": ["../../packages/sheet-mantine/src/index.ts"],
      "@ex-grid/sheet-mui": ["../../packages/sheet-mui/src/index.ts"],
      "@ex-grid/pivot-engine": ["../../packages/pivot-engine/src/index.ts"],
      "@ex-grid/pivot": ["../../packages/pivot/src/index.ts"],
      "@ex-grid/pivot-react": ["../../packages/pivot-react/src/index.ts"],
      "@ex-grid/pivot-mantine": ["../../packages/pivot-mantine/src/index.ts"],
      "@ex-grid/pivot-mui": ["../../packages/pivot-mui/src/index.ts"],
      "@mantine/core": ["../../node_modules/@mantine/core/lib/index.d.mts"],
      "@mantine/hooks": ["../../node_modules/@mantine/hooks/lib/index.d.mts"],
      "@ex-grid/mui": ["../../packages/mui/src/index.ts"],
      "@mui/material": ["../../node_modules/@mui/material/index.d.ts"],
      "@mui/material/*": ["../../node_modules/@mui/material/*"],
      "@ex-grid/chart": ["../../packages/chart/src/index.ts"],
      "@ex-grid/chart-react": ["../../packages/chart-react/src/index.ts"],
      "@ex-grid/chart-mantine": ["../../packages/chart-mantine/src/index.ts"],
      "@ex-grid/chart-mui": ["../../packages/chart-mui/src/index.ts"],
      "@ex-grid/board": ["../../packages/board/src/index.ts"],
      "@ex-grid/board-react": ["../../packages/board-react/src/index.ts"],
      "temporal-polyfill": ["../../node_modules/temporal-polyfill/index.d.ts"]
    }
  },
  "include": ["src", "vite.config.ts", "../../dotnet/samples/ExGrid.Docs/Examples/**/*.ts", "../../dotnet/samples/ExGrid.Docs/Examples/**/*.tsx"]
}
