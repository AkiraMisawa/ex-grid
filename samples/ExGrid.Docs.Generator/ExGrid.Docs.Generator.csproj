<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The Docs Site's build step (ADR-0110): a source generator that turns each Example's
         source into highlighted markup, the shipped assemblies' XML documentation into the API
         tables' text, and the routed pages into the site map, checked against the navigation,
         while the site compiles. A generator runs inside the compiler, which loads
         netstandard2.0. Not shipped. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <!-- Release tracking (AnalyzerReleases.*.md) records the rules an analyzer ships to its
         users. This one ships to nobody: its errors stop the Docs Site's own build. -->
    <NoWarn>$(NoWarn);RS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
