@inject NavigationManager Navigation

@* The search (ADR-0110): C# over the site map the build made — pages, sections, Examples, the
   types the API tables list, the lines of the Release Notes and the items of the Roadmap. No index service, and no key to open it: every page holds live grids
   that take keys. Picking a place goes there, and the box empties for the next search. *@
<MudAutocomplete @ref="_box" T="SiteSearchEntry" Value="_picked" ValueChanged="Go"
                 SearchFunc="Search" ToStringFunc="@(e => e?.Title)" MaxItems="12"
                 Placeholder="Search the docs" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined"
                 Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Small"
                 ResetValueOnEmptyText="true" CoerceText="false" SelectValueOnTab="false" DebounceInterval="150"
                 RelativeWidth="DropdownWidth.Adaptive" MaxHeight="480"
                 Class="@Class" PopoverClass="docs-search-popover"
                 aria-label="Search the docs">
    <ItemTemplate Context="entry">
        <div class="docs-search-item">
            <MudIcon Icon="@IconOf(entry.Kind)" Size="Size.Small" Class="docs-search-icon" />
            <div class="docs-search-text">
                <div class="docs-search-title">@ReleaseNotes.Shorten(entry.Title)</div>
                <div class="docs-search-context">@entry.Context</div>
            </div>
        </div>
    </ItemTemplate>
    <NoItemsTemplate>
        <MudText Typo="Typo.body2" Class="docs-muted px-4 py-2">Nothing on this site matches.</MudText>
    </NoItemsTemplate>
</MudAutocomplete>

@code {
    /// <summary>Classes for the box.</summary>
    [Parameter] public string? Class { get; set; }

    private MudAutocomplete<SiteSearchEntry>? _box;
    private SiteSearchEntry? _picked;

    private static Task<IEnumerable<SiteSearchEntry>> Search(string? text, CancellationToken cancel) =>
        Task.FromResult(SiteMap.Search(text));

    private async Task Go(SiteSearchEntry? entry)
    {
        if (entry is null)
            return;
        _picked = null;
        if (_box is { } box)
            await box.ClearAsync();
        Navigation.NavigateTo(entry.Href);
    }

    private static string IconOf(SiteSearchKind kind) => kind switch
    {
        SiteSearchKind.Page => Icons.Material.Outlined.Article,
        SiteSearchKind.Section => Icons.Material.Filled.Tag,
        SiteSearchKind.Example => Icons.Material.Outlined.PlayCircle,
        SiteSearchKind.ReleaseNote => Icons.Material.Outlined.NewReleases,
        SiteSearchKind.Roadmap => Icons.Material.Outlined.Map,
        _ => Icons.Material.Outlined.DataObject,
    };
}
