@implements IDisposable
@inject DocsState State

@* The site's one Chrome choice (ADR-0110): every Example runs under it, and its code follows. The
   design system is MudBlazor under Blazor and MUI under React (ADR-0350 §12). No Example runs under
   React yet, so there it is shown and cannot be changed: a choice made there would change nothing on
   the page, and would surface later as a Chrome the reader never saw chosen. *@
<MudToggleGroup T="bool" Value="State.Mud" ValueChanged="State.SetMud" Size="Size.Small" Outlined="true"
                Delimiters="true" Color="Color.Primary" Class="@Class" aria-label="Chrome"
                Disabled="@(State.Framework == DocsFramework.React)">
    <MudToggleItem Value="false" Text="Built-in" />
    <MudToggleItem Value="true" Text="@State.WrapperName" />
</MudToggleGroup>

@code {
    /// <summary>Classes for the group.</summary>
    [Parameter] public string? Class { get; set; }

    protected override void OnInitialized() => State.Changed += OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => State.Changed -= OnChanged;
}
