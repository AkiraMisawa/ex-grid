@inherits LayoutComponentBase
@implements IDisposable
@inject DocsState State

@* The built-in grid paints with system colours that follow the document's colour scheme
   (ADR-0027), so the dark choice is declared for the whole document, as a host page in dark
   mode does. *@
@if (State.Dark)
{
    <HeadContent><style>:root { color-scheme: dark; }</style></HeadContent>
}

<MudThemeProvider Theme="DocsTheme.Theme" IsDarkMode="State.Dark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Dense="true" Class="docs-appbar">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="@(() => _drawer = !_drawer)" aria-label="Toggle navigation" />
        <a href="" class="docs-brand">
            <span class="docs-brand-mark">Ex</span><span>Grid</span>
        </a>
        @* The version the site states (ADR-0110): a tag's version, leading to its Release Notes; or,
           in the warning colour, the branch and commit of a site that is not on nuget.org. *@
        <MudTooltip Text="@DocsBuild.ChipTitle">
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                     Color="@(DocsBuild.Kind is DocsBuildKind.Branch or DocsBuildKind.Experiment ? Color.Warning : Color.Inherit)"
                     Href="@DocsBuild.ReleaseNotesHref" Class="docs-version">@DocsBuild.Chip</MudChip>
        </MudTooltip>
        <MudSpacer />
        <ChromeSwitch Class="docs-appbar-switch" />
        <MudTooltip Text="@(State.Dark ? "Light mode" : "Dark mode")">
            <MudIconButton Icon="@(State.Dark ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                           Color="Color.Inherit" OnClick="@(() => State.SetDark(!State.Dark))"
                           aria-label="Toggle dark mode" />
        </MudTooltip>
        <MudTooltip Text="GitHub">
            <MudIconButton Icon="@Icons.Custom.Brands.GitHub" Color="Color.Inherit"
                           Href="@DocsBuild.Repository" Target="_blank" aria-label="GitHub" />
        </MudTooltip>
    </MudAppBar>
    <MudDrawer @bind-Open="_drawer" ClipMode="DrawerClipMode.Always" Elevation="0"
               Variant="DrawerVariant.Responsive" Class="docs-drawer">
        <NavMenu />
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="docs-content">
            @if (DocsBuild.Unreleased)
            {
                <UnreleasedBanner />
            }
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawer = true;

    protected override void OnInitialized() => State.Changed += OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => State.Changed -= OnChanged;
}
