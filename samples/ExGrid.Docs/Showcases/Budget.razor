@page "/showcase/budget"
@layout BareLayout
@implements IDisposable
@inject DocsState State
@using ExGrid.Docs.Examples.Sheet
@using ExSheet.Components
@using ExSheet.Engine
@using ExSheet.MudBlazor

<ShowcaseFrame Title="Budget sheet">
    <style>
        .budget-app { height: 100vh; display: flex; flex-direction: column; overflow: hidden; }
        .budget-body { flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column; padding: 12px 16px 16px; gap: 10px; }
        .budget-sheet { flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column; }
        .budget-sheet > .mud-ex-grid { flex: 1 1 auto; min-height: 0; height: 100%; display: flex; flex-direction: column; }
        .budget-figures { display: flex; gap: 28px; align-items: baseline; flex-wrap: wrap; }
        .budget-figure-label { font-size: 12px; letter-spacing: .02em; text-transform: uppercase; opacity: .7; }
        .budget-figure-value { font-size: 20px; font-weight: 500; font-variant-numeric: tabular-nums; }
        .budget-figure-value.budget-bad { color: #c62828; }
        .budget-figure-value.budget-good { color: #2e7d32; }

        .budget-bar { display: flex; align-items: center; gap: 16px; height: 52px; padding: 0 16px; flex: 0 0 auto;
                      background: #1f3864; color: #fff; font: 14px/1.4 Roboto, "Helvetica Neue", Arial, sans-serif; }
        .budget-brand { font-weight: 600; font-size: 16px; letter-spacing: .01em; display: flex; align-items: center; gap: 10px; }
        .budget-logo { width: 26px; height: 26px; border-radius: 6px; background: #8faadc; color: #1f3864;
                       display: grid; place-items: center; font-weight: 700; font-size: 13px; }
        .budget-crumb { opacity: .8; }
        .budget-spacer { flex: 1; }
        .budget-bar select, .budget-bar button { font: inherit; font-size: 13px; color: #fff; background: rgba(255,255,255,.12);
                      border: 1px solid rgba(255,255,255,.28); border-radius: 4px; padding: 5px 10px; cursor: pointer; }
        .budget-bar select option { color: #1f2329; }
        .budget-bar button:disabled { opacity: .45; cursor: default; }
        .budget-bar button.budget-primary { background: #fff; color: #1f3864; border-color: #fff; font-weight: 500; }
        .budget-saved { font-size: 12px; opacity: .75; min-width: 110px; text-align: right; }
        .docs-showcase-builtin .budget-body { font-family: Roboto, "Helvetica Neue", Arial, sans-serif; }
    </style>

    <div class="budget-app">
        @if (State.Mud)
        {
            <MudAppBar Fixed="false" Dense="true" Elevation="1" Color="@(State.Dark ? Color.Surface : Color.Primary)">
                <MudIcon Icon="@Icons.Material.Filled.TableChart" Class="mr-3" />
                <MudText Typo="Typo.h6" Class="mr-6">Ledgerline Planning</MudText>
                <MudText Typo="Typo.body2" Class="mr-4" Style="opacity: .85">Operations · FY2025 actual vs budget</MudText>
                <MudSpacer />
                <MudIconButton Icon="@Icons.Material.Filled.Undo" Color="Color.Inherit" aria-label="Undo"
                               Disabled="@(_editing || _sheet?.CanUndo != true)" OnClick="UndoAsync" />
                <MudIconButton Icon="@Icons.Material.Filled.Redo" Color="Color.Inherit" aria-label="Redo"
                               Disabled="@(_editing || _sheet?.CanRedo != true)" OnClick="RedoAsync" />
                <MudButton Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.FormatPaint"
                           Disabled="_editing" OnClick="FormatCellsAsync" Class="ml-2">Format Cells</MudButton>
                <MudText Typo="Typo.caption" Class="mx-4" Style="opacity: .8">@_saved</MudText>
                <MudButton Variant="Variant.Outlined" Color="Color.Inherit" Disabled="_editing" OnClick="Submit">Submit for review</MudButton>
            </MudAppBar>
            <div class="budget-body">
                <MudStack Row="true" Spacing="8" AlignItems="AlignItems.Center">
                    @foreach (var (label, value, tone) in Figures())
                    {
                        <div>
                            <MudText Typo="Typo.overline" Style="line-height: 1.6">@label</MudText>
                            <MudText Typo="Typo.h6" Color="@(tone switch { > 0 => Color.Success, < 0 => Color.Error, _ => Color.Default })">@value</MudText>
                        </div>
                    }
                </MudStack>
                <div class="budget-sheet">
                    <MudExGridPaper Elevation="1">
                        @SheetView(MudSheetChrome.Default)
                    </MudExGridPaper>
                </div>
            </div>
        }
        else
        {
            <header class="budget-bar">
                <span class="budget-brand"><span class="budget-logo">L</span>Ledgerline Planning</span>
                <span class="budget-crumb">Operations · FY2025 actual vs budget</span>
                <span class="budget-spacer"></span>
                <select aria-label="Department">
                    <option>Operations</option>
                    <option>Technology</option>
                    <option>Marketing</option>
                </select>
                <button type="button" disabled="@(_editing || _sheet?.CanUndo != true)" @onclick="UndoAsync">Undo</button>
                <button type="button" disabled="@(_editing || _sheet?.CanRedo != true)" @onclick="RedoAsync">Redo</button>
                <button type="button" disabled="@_editing" @onclick="FormatCellsAsync">Format Cells…</button>
                <span class="budget-saved">@_saved</span>
                <button type="button" class="budget-primary" disabled="@_editing" @onclick="Submit">Submit for review</button>
            </header>
            <div class="budget-body">
                <div class="budget-figures">
                    @foreach (var (label, value, tone) in Figures())
                    {
                        <div>
                            <div class="budget-figure-label">@label</div>
                            <div class="@($"budget-figure-value {(tone > 0 ? "budget-good" : tone < 0 ? "budget-bad" : "")}")">@value</div>
                        </div>
                    }
                </div>
                <div class="budget-sheet">
                    @SheetView(null)
                </div>
            </div>
        }
    </div>
</ShowcaseFrame>

@code {
    private ExSheet? _sheet;
    private SheetDocument _document = OperationsBudget.Document();
    private Sheet _computed = default!;
    private bool _editing;
    private bool _toolbar = true;
    private string _saved = "All changes saved";
    private EventCallback<bool> _editingChanged;

    private RenderFragment SheetView(global::ExGrid.Chrome.IGridChrome? chrome) =>
        @<ExSheet @ref="_sheet" @bind-Document="_document" @bind-Document:after="OnChanged" Chrome="chrome"
                  @bind-ShowToolbar="_toolbar" EditingChanged="_editingChanged" PinnedColumnCount="1" RowHeight="24"
                  ViewportHeight="ViewportSize.Stretch" ViewportWidth="ViewportSize.Stretch" />;

    protected override void OnInitialized()
    {
        _editingChanged = EventCallback.Factory.Create<bool>(this, open => _editing = open);
        _computed = Sheet.Open(_document);
        State.Changed += OnStateChanged;
    }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    private void OnChanged()
    {
        _computed = Sheet.Open(_document);
        _saved = $"Saved {DateTime.Now:HH:mm}";
    }

    // The headline figures, read from the document's own Values: revenue, operating profit and margin.
    private IEnumerable<(string Label, string Value, int Tone)> Figures()
    {
        yield return ("Revenue, FY actual", Shown("B6"), 0);
        yield return ("Revenue vs budget", Shown("D6"), Sign("D6"));
        yield return ("Operating profit", Shown("B25"), 0);
        yield return ("Operating profit vs budget", Shown("D25"), Sign("D25"));
        yield return ("Operating margin", Shown("B26"), 0);
    }

    private string Shown(string address) => _computed.GetDisplay(CellAddress.Parse(address)).Text;

    private int Sign(string address) =>
        _computed.GetValue(CellAddress.Parse(address)) is { Kind: ValueKind.Number } value ? Math.Sign(value.Number) : 0;

    private async Task UndoAsync() => await _sheet!.UndoAsync();

    private async Task RedoAsync() => await _sheet!.RedoAsync();

    private async Task FormatCellsAsync() => await _sheet!.OpenFormatCellsAsync();

    private void Submit() => _saved = $"Submitted {DateTime.Now:HH:mm}";

    public void Dispose() => State.Changed -= OnStateChanged;
}
