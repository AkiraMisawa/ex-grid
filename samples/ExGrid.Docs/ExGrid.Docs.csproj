<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <!-- The Docs Site (ADR-0110): a standalone WebAssembly application, published to GitHub
         Pages. It is a Consumer like any other — it references the shipped packages, nothing
         references it, and it is not shipped. Targets what the SDK provides (ADR-0022). -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ExGrid.Docs</RootNamespace>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- What the site states it was built from (ADR-0110), read together by the generator, which
         refuses inputs that disagree:
         - DocsVersion: the version a release published (docs.yml, called by release.yml), or "dev";
         - DocsRef: the tag it was published from (v0.1.0-beta.3), or the branch and its commit on
           demand (main@<commit>, lab/<name>@<commit>), or nothing for a local build;
         - DocsPublishedOn: the UTC day the release pushed the version to nuget.org (ADR-0190). -->
    <DocsVersion Condition=" '$(DocsVersion)' == '' ">dev</DocsVersion>
  </PropertyGroup>

  <PropertyGroup>
    <!-- The API tables read the shipped types by reflection, nullability included: keep what
         they read when the publish trims the application. -->
    <NullabilityInfoContextSupport>true</NullabilityInfoContextSupport>
    <!-- Keep the runtime's own exception messages: an Example that shows one would otherwise read
         "Arg_ParamName_Name" where the sentence belongs. -->
    <UseSystemResourceKeys>false</UseSystemResourceKeys>
  </PropertyGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="ExGrid;ExGrid.MudBlazor;ExSheet;ExSheet.Engine;ExSheet.MudBlazor;ExPivot;ExPivot.Engine;ExPivot.MudBlazor;ExChart;ExChart.Engine;ExChart.MudBlazor;ExBoard;ExGrid.Data;ExGrid.Data.Arrow" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.7" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.7" PrivateAssets="all" />
    <!-- The site's own frame is MudBlazor's (ADR-0110). Only this project references it
         directly; the core packages never do (ADR-0019). -->
    <PackageReference Include="MudBlazor" Version="9.9.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ExGrid\ExGrid.csproj" />
    <ProjectReference Include="..\..\src\ExGrid.MudBlazor\ExGrid.MudBlazor.csproj" />
    <ProjectReference Include="..\..\src\ExSheet\ExSheet.csproj" />
    <ProjectReference Include="..\..\src\ExSheet.MudBlazor\ExSheet.MudBlazor.csproj" />
    <ProjectReference Include="..\..\src\ExPivot\ExPivot.csproj" />
    <ProjectReference Include="..\..\src\ExPivot.MudBlazor\ExPivot.MudBlazor.csproj" />
    <ProjectReference Include="..\..\src\ExChart\ExChart.csproj" />
    <ProjectReference Include="..\..\src\ExChart.MudBlazor\ExChart.MudBlazor.csproj" />
    <ProjectReference Include="..\..\src\ExBoard\ExBoard.csproj" />
    <ProjectReference Include="..\..\src\ExGrid.Data\ExGrid.Data.csproj" />
    <ProjectReference Include="..\..\src\ExGrid.Data.Arrow\ExGrid.Data.Arrow.csproj" />
    <!-- ExChart's Showcases (ADR-0280), shared with the demo pages so layer 3 drives them on both hosts. -->
    <ProjectReference Include="..\ExChart.Showcases\ExChart.Showcases.csproj" />
    <!-- The build step that highlights the Examples, reads the API documentation, maps the site,
         reads the Release Notes and the Roadmap, and reads what the reference pages list. -->
    <ProjectReference Include="..\ExGrid.Docs.Generator\ExGrid.Docs.Generator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Every .razor reaches the generator already, as the Razor compiler's input: an Example's,
         whose code a page shows, and every routed page's, which the site map reads. An Example's .cs
         files, and the snippets a page quotes (.html, .sh, .css), are handed over here. The code a
         page shows is the file it runs. -->
    <AdditionalFiles Include="Examples\**\*.cs;Examples\**\*.html;Examples\**\*.sh;Examples\**\*.css" />
    <!-- The decision records: an API summary's "ADR-0016" links to its file, and the Roadmap reads the
         scope tables of ADR-0046 and ADR-0059. -->
    <AdditionalFiles Include="..\..\docs\adr\*.md" />
    <!-- The Release Notes (ADR-0190): each version's file, the prerelease note and the Change Notes,
         read and checked by the generator for the Release notes page. -->
    <AdditionalFiles Include="..\..\docs\releases\**\*.md" />
    <!-- The Roadmap (ADR-0191): the tickets, by their Status: and Roadmap: lines; and the Definition of
         Done and what it still owes, which the Roadmap's hand-written rows cite. The scope tables it reads
         are ADR-0046's and ADR-0059's, among the decision records above. -->
    <AdditionalFiles Include="..\..\docs\specs\*\issues\*.md" />
    <AdditionalFiles Include="..\..\docs\definition-of-done.md;..\..\docs\implementation-status.md" />
    <!-- The reference pages (ADR-0110): the Packages page reads ADR-0042's table of the family (among the
         decision records above), the ids release.yml publishes and each shipped project's references; the
         Functions page reads the categories of ExSheet's function catalogue. -->
    <AdditionalFiles Include="..\..\.github\workflows\release.yml" />
    <AdditionalFiles Include="..\..\src\*\*.csproj" />
    <AdditionalFiles Include="..\..\docs\specs\exsheet-functions\spec.md" />
    <CompilerVisibleProperty Include="MSBuildProjectDirectory" />
    <CompilerVisibleProperty Include="DocsVersion" />
    <CompilerVisibleProperty Include="DocsRef" />
    <CompilerVisibleProperty Include="DocsPublishedOn" />
    <!-- Setup snippets are an application's own files (its Program.cs), quoted, never compiled
         into the site. -->
    <Compile Remove="Examples\Setup\**\*.cs" />
    <!-- A heading's anchor, one source compiled into the site and into the generator, so that the
         site map's anchors are the ones the pages render (ADR-0110). -->
    <Compile Include="..\ExGrid.Docs.Generator\DocsAnchor.cs" Link="Shared\DocsAnchor.cs" />
  </ItemGroup>

  <!-- The shipped assemblies' XML documentation, for the API tables: the file beside each
       referenced src/ project's assembly. -->
  <Target Name="AddApiDocumentation" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <_DocsProjectAssembly Include="@(ReferencePath)" Condition=" '%(ReferencePath.ReferenceSourceTarget)' == 'ProjectReference' " />
      <AdditionalFiles Include="@(_DocsProjectAssembly->'%(RootDir)%(Directory)%(Filename).xml')"
                       Condition="Exists('%(RootDir)%(Directory)%(Filename).xml')" />
    </ItemGroup>
  </Target>

</Project>
