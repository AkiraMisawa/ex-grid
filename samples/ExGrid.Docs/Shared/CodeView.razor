@inject IJSRuntime JS
@inject ISnackbar Snackbar
@implements IAsyncDisposable

@* Source files, highlighted at build time (ADR-0110): a tab per file, and a copy button that
   copies the file verbatim. *@
<div class="docs-code-view">
    @if (Sources.Count > 1)
    {
        <div class="docs-code-tabs" role="tablist">
            @for (var i = 0; i < Sources.Count; i++)
            {
                var index = i;
                <button type="button" role="tab" class="@($"docs-code-tab {(index == _selected ? "docs-code-tab-selected" : "")}")"
                        aria-selected="@(index == _selected ? "true" : "false")" @onclick="@(() => _selected = index)">
                    @Sources[index].FileName
                </button>
            }
        </div>
    }
    else
    {
        <div class="docs-code-tabs"><span class="docs-code-tab docs-code-tab-selected">@Sources[0].FileName</span></div>
    }
    <div class="docs-code-body">
        <MudTooltip Text="Copy" Class="docs-code-copy">
            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" OnClick="CopyAsync" aria-label="Copy code" />
        </MudTooltip>
        <pre class="docs-code"><code class="@($"language-{Current.Language}")">@((MarkupString)Current.Html)</code></pre>
    </div>
</div>

@code {
    /// <summary>The files, in tab order.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<ExampleSource> Sources { get; set; } = [];

    private int _selected;
    private IJSObjectReference? _module;

    private ExampleSource Current => Sources[Math.Min(_selected, Sources.Count - 1)];

    protected override void OnParametersSet()
    {
        if (_selected >= Sources.Count)
            _selected = 0;
    }

    // The site's one JavaScript use (ADR-0110): C# has no clipboard.
    private async Task CopyAsync()
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/docs.js");
        await _module.InvokeVoidAsync("copyText", Current.Text);
        Snackbar.Add($"Copied {Current.FileName}", Severity.Success);
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
    }
}
