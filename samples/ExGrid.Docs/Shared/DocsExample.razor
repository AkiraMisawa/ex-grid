@implements IDisposable
@inject DocsState State

@* An Example (ADR-0110): a live component, and beneath it the code it runs, read from its own
   source. Where the Example has a MudBlazor counterpart, the site's Chrome choice picks which one
   runs, and the code follows. *@
<div class="docs-example">
    @if (Title is not null)
    {
        <MudText Typo="Typo.h6" HtmlTag="h3" Class="docs-example-title">@Title</MudText>
    }
    @if (ChildContent is not null)
    {
        <div class="docs-example-text">@ChildContent</div>
    }
    <MudPaper Outlined="true" Class="docs-example-frame">
        <div class="@($"docs-example-live {(_mud ? "docs-example-mud" : "docs-example-builtin")}")">
            @* Keyed by the type, so switching the Chrome mounts the other Example fresh. *@
            <DynamicComponent @key="Current" Type="Current" />
        </div>
        <MudToolBar Dense="true" Class="docs-example-toolbar">
            @if (Mud is not null)
            {
                <ChromeSwitch />
            }
            else
            {
                <MudText Typo="Typo.caption" Class="docs-muted">Built-in Chrome only</MudText>
            }
            <MudSpacer />
            <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Code"
                       OnClick="@(() => _showCode = !_showCode)" aria-expanded="@(_showCode ? "true" : "false")">
                @(_showCode ? "Hide code" : "Show code")
            </MudButton>
        </MudToolBar>
        @if (_showCode)
        {
            <CodeView Sources="Sources" />
        }
    </MudPaper>
</div>

@code {
    /// <summary>The Example's heading.</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>What the Example shows, in a sentence or two.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>The Example under the built-in Chrome: a component under <c>Examples/</c>.</summary>
    [Parameter, EditorRequired] public Type Builtin { get; set; } = default!;

    /// <summary>The same Example under MudBlazor's Chrome, when it has one.</summary>
    [Parameter] public Type? Mud { get; set; }

    /// <summary>Further files the Example's code reads, shown as tabs after its own:
    /// <c>Examples/Data/Trade.cs</c>.</summary>
    [Parameter] public string[] Files { get; set; } = [];

    /// <summary>Whether the code is shown before the reader asks.</summary>
    [Parameter] public bool CodeOpen { get; set; }

    private bool _showCode;
    private bool _mud;

    private Type Current => _mud ? Mud! : Builtin;

    private IReadOnlyList<ExampleSource> Sources =>
        [ExampleSources.For(Current), .. Files.Select(ExampleSources.Get)];

    protected override void OnInitialized()
    {
        _showCode = CodeOpen;
        _mud = State.Mud && Mud is not null;
        State.Changed += OnChanged;
    }

    private void OnChanged()
    {
        _mud = State.Mud && Mud is not null;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose() => State.Changed -= OnChanged;
}
