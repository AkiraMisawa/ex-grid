@implements IDisposable
@inject DocsState State

@* An Example (ADR-0110): a live component, and beneath it the code it runs, read from its own
   source. Where the Example has a MudBlazor counterpart, the site's Chrome choice picks which one
   runs, and the code follows. Read for React (ADR-0350 §12), an Example with a React counterpart, the
   .tsx file beside its .razor, runs it in a frame of its own, built ahead of time into the site's
   static files, and shows its code; one without says so where it would run, and neither the Blazor
   component nor its code is shown. A React Example written for the Wrappers too, Mantine's and MUI's
   beside it (ADR-0390 section 8), runs the one the site's Chrome choice names. *@
<div class="docs-example">
    @if (Title is not null)
    {
        <MudText Typo="Typo.h6" HtmlTag="h3" Class="docs-example-title">@Title</MudText>
    }
    @if (ChildContent is not null)
    {
        <div class="docs-example-text">@ChildContent</div>
    }
    <MudPaper Outlined="true" Class="docs-example-frame">
        @if (State.Framework == DocsFramework.React && CurrentReact is { } react)
        {
            @* The frame sets its own height to the Example's, from inside (the frame's page, main.tsx): the site
               renders no height of its own, so a render never takes it back. *@
            <iframe class="docs-example-react" src="@FrameAddress(react)" title="@($"{Title ?? react.Name}, running under React")"></iframe>
            <MudToolBar Dense="true" Class="docs-example-toolbar">
                @if (_reactWrappers)
                {
                    <ChromeSwitch />
                }
                else
                {
                    <MudText Typo="Typo.caption" Class="docs-muted">Built-in Chrome only</MudText>
                }
                <MudSpacer />
                <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Code"
                           OnClick="@(() => _showCode = !_showCode)" aria-expanded="@(_showCode ? "true" : "false")">
                    @(_showCode ? "Hide code" : "Show code")
                </MudButton>
            </MudToolBar>
            @if (_showCode)
            {
                <CodeView Sources="react.Sources" />
            }
        }
        else if (State.Framework == DocsFramework.React)
        {
            <NotInReact Product="@_product" Example="true" />
        }
        else
        {
            <div class="@($"docs-example-live {(_mud ? "docs-example-mud" : "docs-example-builtin")}")">
                @* Keyed by the type, so switching the Chrome mounts the other Example fresh. *@
                <DynamicComponent @key="Current" Type="Current" />
            </div>
            <MudToolBar Dense="true" Class="docs-example-toolbar">
                @if (Mud is not null)
                {
                    <ChromeSwitch />
                }
                else
                {
                    <MudText Typo="Typo.caption" Class="docs-muted">Built-in Chrome only</MudText>
                }
                <MudSpacer />
                <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Code"
                           OnClick="@(() => _showCode = !_showCode)" aria-expanded="@(_showCode ? "true" : "false")">
                    @(_showCode ? "Hide code" : "Show code")
                </MudButton>
            </MudToolBar>
            @if (_showCode)
            {
                <CodeView Sources="Sources" />
            }
        }
    </MudPaper>
</div>

@code {
    /// <summary>The Example's heading.</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>What the Example shows, in a sentence or two.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>The Example under the built-in Chrome: a component under <c>Examples/</c>.</summary>
    [Parameter, EditorRequired] public Type Builtin { get; set; } = default!;

    /// <summary>The same Example under MudBlazor's Chrome, when it has one.</summary>
    [Parameter] public Type? Mud { get; set; }

    /// <summary>Further files the Example's code reads, shown as tabs after its own:
    /// <c>Examples/Data/Trade.cs</c>.</summary>
    [Parameter] public string[] Files { get; set; } = [];

    /// <summary>Whether the code is shown before the reader asks.</summary>
    [Parameter] public bool CodeOpen { get; set; }

    private bool _showCode;
    private bool _mud;
    private string _product = "";
    private ReactExample? _react;
    private bool _reactWrappers;

    private Type Current => _mud ? Mud! : Builtin;

    // The Chrome the site's choice names, or the built-in one where the Example has no Wrapper's, and its file.
    private ReactChrome ReactRunsUnder => _reactWrappers ? State.ReactChrome : ReactChrome.Builtin;

    private ReactExample? CurrentReact => ExampleSources.ReactFor(Builtin, ReactRunsUnder);

    private IReadOnlyList<ExampleSource> Sources =>
        [ExampleSources.For(Current), .. Files.Select(ExampleSources.Get)];

    protected override void OnInitialized()
    {
        _showCode = CodeOpen;
        _mud = State.Mud && Mud is not null;
        State.Changed += OnChanged;
    }

    private void OnChanged()
    {
        _mud = State.Mud && Mud is not null;
        InvokeAsync(StateHasChanged);
    }

    // Read whatever the framework, so that an Example in no product's folder fails the page under
    // Blazor too, where the site is built and read first, not only for a reader on React.
    protected override void OnParametersSet()
    {
        _product = DocsProducts.OfExample(Builtin);
        _react = ExampleSources.ReactFor(Builtin);
        // Written for the built-in Chrome and both Wrappers, or for the built-in Chrome alone: an Example that ran the
        // built-in Chrome under a Wrapper's name would show the reader a Chrome they did not choose.
        ReactChrome[] wrappers = [ReactChrome.Mantine, ReactChrome.Mui];
        var written = wrappers.Where(chrome => ExampleSources.ReactFor(Builtin, chrome) is not null).ToArray();
        if (written.Length > 0 && (_react is null || written.Length < wrappers.Length))
            throw new InvalidOperationException($"{Builtin.Name}'s React Example is written for {(_react is null ? "" : "the built-in Chrome and ")}{string.Join(" and ", written)} alone: write {string.Join(", ", ((ReactChrome[])[ReactChrome.Builtin, .. wrappers]).Select(chrome => $"{Builtin.Name}{chrome.FileSuffix()}.tsx"))} together.");
        _reactWrappers = written.Length > 0;
    }

    // The frame's page, relative to the site's base, with the Example, the site's scheme and the Chrome in its
    // address. A change of scheme or Chrome is a new address, so the frame runs the Example again.
    private string FrameAddress(ReactExample react) =>
        $"react/index.html?example={Uri.EscapeDataString(react.Name)}&scheme={(State.Dark ? "dark" : "light")}&chrome={ReactRunsUnder.AddressName()}";

    public void Dispose() => State.Changed -= OnChanged;
}
