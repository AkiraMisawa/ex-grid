@page "/showcases"

@* The Showcases (ADR-0110): one use case per product, each a page of its own that fills the window.
   Each opens in a tab of its own, under either Chrome; the address carries the choice. No recordings
   here: the page a card opens is the thing itself. *@
<DocsPage Title="Showcases"
          Lead="One use case per product, as an application would build it, with no prose. Each fills the window and opens in a tab of its own, under the built-in Chrome or MudBlazor's.">
    <div class="docs-cards">
        @foreach (var showcase in Cards)
        {
            <MudPaper Outlined="true" Class="docs-card docs-showcase-card">
                <MudText Typo="Typo.overline" Color="Color.Primary">@showcase.Product</MudText>
                <MudText Typo="Typo.h6" HtmlTag="h2">@showcase.Title</MudText>
                <MudText Typo="Typo.body2" Class="docs-muted mt-1 mb-4">@showcase.Text</MudText>
                <div class="docs-showcase-buttons">
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" Href="@showcase.Href" Target="_blank"
                               EndIcon="@Icons.Material.Filled.OpenInNew" aria-label="@($"{showcase.Title}, built-in Chrome, in a new tab")">Built-in</MudButton>
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" Href="@($"{showcase.Href}?chrome=mud")" Target="_blank"
                               EndIcon="@Icons.Material.Filled.OpenInNew" aria-label="@($"{showcase.Title}, MudBlazor's Chrome, in a new tab")">MudBlazor</MudButton>
                </div>
                <MudLink Href="@showcase.Docs" Typo="Typo.body2" Class="docs-showcase-docs">@showcase.DocsText</MudLink>
            </MudPaper>
        }
    </div>
</DocsPage>

@code {
    private sealed record Card(string Product, string Title, string Text, string Href, string Docs, string DocsText);

    private static readonly Card[] Cards =
    [
        new("ExGrid", "Trade blotter",
            "Live prices that flash as they change, pinned columns, a desk filter, and a rectangle of P&L selected and copied.",
            "showcase/blotter", "exgrid", "Read the ExGrid docs →"),
        new("ExSheet", "Budget sheet",
            "A departmental budget: Formulas typed and completed, References outlined, the fill handle, and Format Cells.",
            "showcase/budget", "exsheet", "Read the ExSheet docs →"),
        new("ExPivot", "Sales analysis",
            "60,000 sales: fields dragged in the Fields pane, each value as a share of its column, and regions collapsed and opened.",
            "showcase/sales", "expivot", "Read the ExPivot docs →"),
        new("ExChart", "Exposure profile",
            "A netting set's exposure before and after a trade: a selection made into a chart, CVA drawn per year over its buckets, and a recalculation the open charts follow.",
            "showcase/exposure", "exchart", "Read the ExChart docs →"),
        new("ExChart", "Curves",
            "Credit and rate curves three ways: a CDS term structure with its hazard rates as steps, curves charted from rows across tenors, and a rate curve with its interpolation named.",
            "showcase/curves", "exchart", "Read the ExChart docs →"),
        new("ExChart", "FX volatility",
            "An EURUSD volatility surface beside its quotes: turned, sliced into a smile or a term structure by a click, its missing quotes filled and said so, and saved as SVG or PNG.",
            "showcase/fx-volatility", "exchart", "Read the ExChart docs →"),
        new("ExChart", "CDS spread vs leverage",
            "Two hundred names beside their scatter: a least-squares and a Theil–Sen line that one distressed name tells apart, a logarithmic spread, and a click to the row.",
            "showcase/cds-spread", "exchart/scatter", "Read about scatter and fitted lines →"),
        new("ExChart", "Equity index daily bars",
            "Ten years of an index as candles with volume and a moving average, merged into months to fit, packed or on calendar time, and the intervals beside it.",
            "showcase/equity-index", "exchart/candles", "Read about candles and intervals →"),
    ];
}
