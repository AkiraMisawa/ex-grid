        <ApiTable Type="typeof(global::ExBoard.BoardSpec)" />
        <ApiTable Type="typeof(global::ExBoard.BoundBoard)" />
        <ApiTable Type="typeof(global::ExBoard.Components.ExBoard)" />
    </DocsSection>
</DocsPage>
