@page "/features"

@* The Feature matrix (ADR-0110), a reference page. It stands where ag-grid's "Community vs. Enterprise"
   stands; the family has no paid edition, so its axes are where it runs and which Chrome draws what.
   Every fact is read from a named source when the site was built: the hand-written rows of
   FeatureMatrixByHand, each citing its record; the Wrappers' Chrome, read from their assemblies; the site
   map; and the scope tables of ADR-0046 and ADR-0059, which the Roadmap reads too. *@
<DocsPage Title="Feature matrix"
          Lead="Where the family runs, what each MudBlazor Wrapper draws, what each product's pages cover and under which Chrome, and what each product's first version holds. Every package is MIT; there is no paid edition.">
    <ReferenceAsOf>Every row cites the record that decides it, and the tables below the first are read from the products and from this site.</ReferenceAsOf>

    <DocsSection Title="Where it runs">
        <MudSimpleTable Dense="true" Outlined="true" Class="docs-api-table docs-reference-table">
            <thead><tr><th style="width: 18%"></th><th>What holds</th><th style="width: 26%">Decided in</th></tr></thead>
            <tbody>
                @foreach (var fact in FeatureMatrixByHand.WhereItRuns)
                {
                    <tr>
                        <td><b>@fact.Topic</b></td>
                        <td>@fact.Text</td>
                        <td class="docs-reference-cites"><CiteLinks Of="@FeatureMatrix.CitesOf(fact.Cites)" /></td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    </DocsSection>

    <DocsSection Title="What each Wrapper draws">
        <p>
            A Wrapper draws a product's surfaces with its design system's controls, and the product decides what each
            one means, so switching the Chrome changes how they look and nothing else: try the switch at the top on
            any Example. Each table is read from the Wrapper's assembly: a surface its Chrome leaves alone is drawn by
            the product's built-in Chrome.
        </p>
        @foreach (var wrapper in FeatureMatrixByHand.Wrappers)
        {
            var seams = FeatureMatrix.Seams.Where(s => s.Package == wrapper.Package).ToList();
            <MudText Typo="Typo.h6" HtmlTag="h3" Class="docs-reference-heading">
                <code>@wrapper.Package</code>
                <span class="docs-reference-heading-cites"><CiteLinks Of="@FeatureMatrix.CitesOf(wrapper.Cites)" /></span>
            </MudText>
            @if (wrapper.Package == "ExSheet.MudBlazor")
            {
                <p class="docs-muted">Every surface of the Sheet's grid is drawn as <code>ExGrid.MudBlazor</code> draws it above. ExSheet's own:</p>
            }
            <MudSimpleTable Dense="true" Outlined="true" Class="docs-api-table docs-reference-table">
                <thead><tr><th>Surface</th><th style="width: 24%">Drawn by</th><th style="width: 26%">Decided in</th></tr></thead>
                <tbody>
                    @foreach (var seam in seams)
                    {
                        var surface = FeatureMatrix.SurfaceOf(seam.Seam);
                        <tr>
                            <td>@surface.Title</td>
                            <td>
                                @if (seam.Filled)
                                {
                                    <span class="docs-matrix-yes">✓</span> <text>MudBlazor's controls</text>
                                }
                                else
                                {
                                    <span class="docs-muted">The built-in Chrome</span>
                                }
                            </td>
                            <td class="docs-reference-cites"><CiteLinks Of="@FeatureMatrix.CitesOf(surface.Cites)" /></td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
    </DocsSection>

    <DocsSection Title="What each product's pages hold">
        <p>
            Every section of each product's pages, read from this site when it was built, with its Examples and how
            many of them also run under MudBlazor's Chrome. <b>Built-in only</b> means the section's Examples run under
            the built-in Chrome alone.
        </p>
        @foreach (var product in Products)
        {
            var rows = FeatureMatrix.SectionsOf(product);
            <MudText Typo="Typo.h6" HtmlTag="h3" Class="docs-reference-heading">@product</MudText>
            <MudSimpleTable Dense="true" Outlined="true" Class="docs-api-table docs-reference-table">
                <thead>
                    <tr><th>Section</th><th style="width: 20%">Page</th><th style="width: 10%">Examples</th><th style="width: 14%">MudBlazor</th><th style="width: 18%">Release notes</th></tr>
                </thead>
                <tbody>
                    @foreach (var row in rows)
                    {
                        <tr>
                            <td><a href="@row.Href">@row.Section</a></td>
                            <td>@row.Page</td>
                            <td>@(row.Examples == 0 ? "—" : row.Examples.ToString(System.Globalization.CultureInfo.InvariantCulture))</td>
                            <td>
                                @if (row.Examples == 0)
                                {
                                    <span class="docs-muted">—</span>
                                }
                                else if (row.WithMud == row.Examples)
                                {
                                    <span class="docs-matrix-yes">✓</span>
                                }
                                else if (row.WithMud == 0)
                                {
                                    <span class="docs-muted">Built-in only</span>
                                }
                                else
                                {
                                    <text>@row.WithMud of @row.Examples</text>
                                }
                            </td>
                            <td><ReleaseChips Chips="@ReleaseNotes.ChipsFor(row.Route, row.Anchor)" /></td>
                        </tr>
                    }
                    @if (product == "ExSheet")
                    {
                        <tr>
                            <td><a href="@FunctionCatalogue.Route">Functions: @DeclaredCount supported</a></td>
                            <td>Functions</td>
                            <td colspan="3" class="docs-muted">A reference page: each function the engine supports, by category.</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
    </DocsSection>

    <DocsSection Title="First version, later, not planned">
        <p>
            What ExSheet's and ExPivot's first versions hold, what each left for later and why, and what each refuses,
            from the scope tables of the decisions that defined them. ExGrid and the data packages have no such table:
            their pages are listed above, and what the family will not do is on the
            <a href="@($"{Roadmap.Route}#{DocsAnchor.Of(Roadmap.NotPlanned)}")">Roadmap</a>.
        </p>
        @foreach (var group in Roadmap.Scope.GroupBy(r => r.Product))
        {
            var first = group.First();
            <MudText Typo="Typo.h6" HtmlTag="h3" Class="docs-reference-heading">
                @group.Key <a href="@first.AdrUrl" target="_blank" rel="noopener" class="docs-reference-heading-cites">ADR-@first.Adr</a>
            </MudText>
            <MudSimpleTable Dense="true" Outlined="true" Class="docs-api-table docs-reference-table">
                <thead><tr><th></th><th style="width: 16%">In</th><th style="width: 34%">Why later</th></tr></thead>
                <tbody>
                    @foreach (var row in group)
                    {
                        <tr>
                            <td>@((MarkupString)row.LabelHtml)</td>
                            <td>
                                @switch (row.Scope)
                                {
                                    case RoadmapScope.FirstVersion:
                                        <span class="docs-matrix-yes">✓</span> <text>First version</text>
                                        break;
                                    case RoadmapScope.Later:
                                        <text>Later</text>
                                        break;
                                    default:
                                        <span class="docs-matrix-no">✗</span> <text>Not planned</text>
                                        break;
                                }
                            </td>
                            <td>@((MarkupString)row.WhyHtml)</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
    </DocsSection>
</DocsPage>

@code {
    private static readonly string[] Products = ["ExGrid", "ExSheet", "ExPivot", "Data"];

    private static readonly int DeclaredCount = global::ExSheet.Engine.DeclaredFunction.All.Count;
}
