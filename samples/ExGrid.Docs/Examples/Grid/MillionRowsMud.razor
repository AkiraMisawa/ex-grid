@using ExGrid.Docs.Examples.Data
@implements IDisposable

<MudExGridPaper Class="docs-stretch-paper" Elevation="0" Outlined="true">
    <ToolBarContent>
        <MudText Typo="Typo.subtitle2">@MillionTrades.Holding(_source)</MudText>
    </ToolBarContent>
    <ChildContent>
        <ExGrid TRow="Trade" Source="_source" Columns="MillionTrades.Columns" HideColumnMenu="true" Chrome="_chrome"
                ViewportHeight="320" ViewportWidth="ViewportSize.Stretch" />
    </ChildContent>
</MudExGridPaper>

@code {
    private static readonly MudGridChrome _chrome = new();

    private readonly FetchingGridSource<Trade> _source = MillionTrades.Source();

    // The line in the toolbar follows the source as it fetches.
    protected override void OnInitialized() => _source.StateChanged += OnSourceChanged;

    private void OnSourceChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        _source.StateChanged -= OnSourceChanged;
        _source.Dispose();
    }
}
