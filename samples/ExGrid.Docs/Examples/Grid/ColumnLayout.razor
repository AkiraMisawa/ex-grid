@using System.Globalization
@using ExGrid.Columns

<ExGrid TRow="Position" Source="_source" Columns="_columns" HeaderGroups="_groups" PinnedColumnCount="_pinned"
        OnColumnWidthChanged="OnWidthChanged" OnColumnOrderChanged="OnOrderChanged" OnColumnHidden="OnHidden"
        ViewportHeight="320" ViewportWidth="880" />

<div style="display: flex; gap: 12px; align-items: center; margin-top: 12px; font-size: 14px">
    <span>@_hidden.Count hidden</span>
    <button type="button" disabled="@(_hidden.Count == 0)" @onclick="ShowAll">Show every column</button>
</div>

@code {
    private static readonly CultureInfo Invariant = CultureInfo.InvariantCulture;

    private static readonly GridColumn<Position>[] All =
    [
        new("Id", ColumnType.Number, p => p.Id, width: Fixed(70), align: CellAlign.Left),
        new("Instrument", ColumnType.Text, p => p.Instrument, width: Fixed(120)),
        new("Desk", ColumnType.Text, p => p.Desk, width: Fixed(100)),
        new("Trader", ColumnType.Text, p => p.Trader, width: Fixed(110)),
        new("Currency", ColumnType.Text, p => p.Currency, header: "Ccy", width: Fixed(72)),
        new("Quantity", ColumnType.Number, p => p.Quantity, width: Fixed(110), format: v => ((int)v).ToString("N0", Invariant)),
        new("Cost", ColumnType.Number, p => p.Cost, width: Fixed(90), format: v => ((decimal)v).ToString("N2", Invariant)),
        new("Price", ColumnType.Number, p => p.Price, width: Fixed(90), format: v => ((decimal)v).ToString("N2", Invariant)),
        new("Pnl", ColumnType.Number, p => p.Pnl, header: "P&L", width: Fixed(132), format: v => ((decimal)v).ToString("N2", Invariant)),
        new("LimitUsed", ColumnType.Number, p => p.LimitUsed, header: "Limit used", width: Fixed(100), format: v => ((double)v).ToString("0%", Invariant)),
        new("TradeDate", ColumnType.Date, p => p.TradeDate, header: "Trade date", width: Fixed(110), dateType: DateType.DateOnly),
        new("Hedged", ColumnType.Boolean, p => p.Hedged, width: Fixed(80)),
    ];

    // Every group names its member columns. A tier-2 group sits above the tier-1 groups.
    private static readonly HeaderGroup[] AllGroups =
    [
        new("Position", ["Id", "Instrument"]),
        new("Owner", ["Desk", "Trader"]),
        new("Economics", ["Currency", "Quantity", "Cost", "Price"]),
        new("Risk", ["Pnl", "LimitUsed"]),
        new("Booking", ["TradeDate", "Hedged"]),
        new("Valuation", ["Currency", "Quantity", "Cost", "Price", "Pnl", "LimitUsed"], tier: 2),
    ];

    private readonly InMemoryGridSource<Position> _source = GridSource.From(Position.Sample());

    // The order, the widths and what is hidden are yours to hold; the grid only reports the gestures.
    private List<string> _order = [.. All.Select(c => c.Name)];
    private readonly Dictionary<string, double> _widths = [];
    private readonly HashSet<string> _hidden = [];

    private IReadOnlyList<GridColumn<Position>> _columns = All;
    private IReadOnlyList<HeaderGroup> _groups = AllGroups;
    private int _pinned = 2;

    private void OnWidthChanged(ColumnWidthChange change)
    {
        _widths[change.Column] = change.WidthPx;
        Rebuild();
    }

    private void OnOrderChanged(IReadOnlyList<string> order)
    {
        _order = [.. order, .. _order.Where(name => !order.Contains(name))];
        Rebuild();
    }

    private void OnHidden(string column)
    {
        _hidden.Add(column);
        Rebuild();
    }

    private void ShowAll()
    {
        _hidden.Clear();
        Rebuild();
    }

    // A new list each time something changed: the list instance is what tells the grid.
    private void Rebuild()
    {
        _columns = _order.Where(name => !_hidden.Contains(name))
            .Select(name => Sized(All.First(c => c.Name == name)))
            .ToArray();
        _pinned = _columns.Count(c => c.Name is "Id" or "Instrument");
        // A group may only name columns that are shown.
        _groups = AllGroups
            .Select(g => g.Columns.Where(name => !_hidden.Contains(name)).ToArray() is { Length: > 0 } shown
                ? new HeaderGroup(g.Label, shown, g.Tier, g.TierSpan)
                : null)
            .OfType<HeaderGroup>()
            .ToArray();
    }

    private GridColumn<Position> Sized(GridColumn<Position> column) => _widths.TryGetValue(column.Name, out var px)
        ? new(column.Name, column.Type, column.Value, column.Header,
            new ColumnWidthSpec(ColumnWidth.Fixed(px), column.Width.MinWidthPx, column.Width.MaxWidthPx),
            align: column.Align, format: column.Format,
            dateType: column.Type == ColumnType.Date ? column.DateType : null)
        : column;

    private static ColumnWidthSpec Fixed(double px) => new(ColumnWidth.Fixed(px));
}
