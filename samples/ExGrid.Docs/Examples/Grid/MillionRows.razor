@using ExGrid.Docs.Examples.Data
@implements IDisposable

@* The DOM does not grow with the row count: a million rows paint the same few dozen elements as a hundred. *@
<ExGrid TRow="Trade" Source="_source" Columns="MillionTrades.Columns"
        ViewportHeight="320" ViewportWidth="ViewportSize.Stretch" />

<p style="margin: 12px 0 0; font-size: 14px">@MillionTrades.Holding(_source)</p>

@code {
    private readonly FetchingGridSource<Trade> _source = MillionTrades.Source();

    // The line under the grid follows the source as it fetches.
    protected override void OnInitialized() => _source.StateChanged += OnSourceChanged;

    private void OnSourceChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        _source.StateChanged -= OnSourceChanged;
        _source.Dispose();
    }
}
