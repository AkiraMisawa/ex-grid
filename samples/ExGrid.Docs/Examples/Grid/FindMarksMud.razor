@using ExGrid.Docs.Examples.Data
@implements IDisposable

<MudExGridPaper Class="docs-stretch-paper" Elevation="0" Outlined="true">
    <ToolBarContent>
        <MudSwitch T="bool" @bind-Value="_marked" Color="Color.Primary" Label="Pass the match function" />
        <MudSpacer />
        <MudText Typo="Typo.body2">Press Ctrl+F in the grid and type "novak"</MudText>
    </ToolBarContent>
    <ChildContent>
        <ExGrid TRow="Trade" Source="_source" Columns="FindingTrades.Columns" Chrome="_chrome"
                FindMatch="@(_marked ? FindingTrades.Match : null)"
                ViewportHeight="320" ViewportWidth="ViewportSize.Stretch" />
    </ChildContent>
</MudExGridPaper>

@code {
    private static readonly MudGridChrome _chrome = new();

    // Your own answer to a step: here the reference step over your rows, by the columns' displayed text.
    private readonly FetchingGridSource<Trade> _source = FindingTrades.Source();

    private bool _marked = true;

    public void Dispose() => _source.Dispose();
}
