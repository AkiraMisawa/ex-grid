@using ExGrid.Docs.Examples.Data
@implements IDisposable

<MudExGridPaper Class="docs-stretch-paper" Elevation="0" Outlined="true">
    <ToolBarContent>
        <MudSwitch T="bool" @bind-Value="_early" @bind-Value:after="_trades.ResetCounts" Color="Color.Primary"
                   Label="@($"Ask {ReadAheadTrades.Margin} rows before the Window runs out")" />
        <MudSpacer />
        <MudText Typo="Typo.body2">
            Asked @(_trades.Early + _trades.Late) times: @_trades.Early with every row on screen held,
            @_trades.Late with rows on screen waiting
        </MudText>
    </ToolBarContent>
    <ChildContent>
        <ExGrid TRow="Trade" Source="_trades" Columns="MillionTrades.Columns" HideColumnMenu="true" Chrome="_chrome"
                RangeRequestMargin="@(_early ? ReadAheadTrades.Margin : 0)"
                ViewportHeight="320" ViewportWidth="ViewportSize.Stretch" />
    </ChildContent>
</MudExGridPaper>

@code {
    private static readonly MudGridChrome _chrome = new();

    // The server's side: a round trip of 150 ms, 50 rows read either side, a covering question kept.
    private readonly ReadAheadTrades _trades = new();

    // Off at first: the grid asks once the rows on screen are not all held, as by default.
    private bool _early;

    // The counts in the toolbar follow the source as it is asked.
    protected override void OnInitialized() => _trades.StateChanged += OnSourceChanged;

    private void OnSourceChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => _trades.StateChanged -= OnSourceChanged;
}
