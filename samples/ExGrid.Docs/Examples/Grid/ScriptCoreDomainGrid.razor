@using ExGrid.Docs.Examples.Data
@using ExGrid.Cells
@using ExGrid.Clipboard
@using ExGrid.Selection

@* Notional is judged by the trade's domain, which answers later, as a server would. Type 1500 and Enter: no trade of
   that size can be booked, and the editor holds. Type 60000000: it is booked, painted as an error, and its reason
   opens when the Focus stands on it. Escape while the answer is out cancels the commit. *@
<ExGrid.Script.ExGrid TRow="Trade" Source="_source" Columns="_columns" ViewportHeight="280" ViewportWidth="ViewportSize.Stretch"
                      OnEdit="Edit" OnPaste="Fill" CellState="_cellState" CellMessageOf="MessageOf" />

@code {
    private readonly InMemoryGridSource<Trade> _source = GridSource.From(Trade.Sample());
    private readonly Dictionary<int, string> _flags = [];
    private CellStateOf<Trade>? _cellState;

    private readonly GridColumn<Trade>[] _columns =
    [
        new("Id", ColumnType.Number, t => t.Id),
        new("Book", ColumnType.Text, t => t.Book),
        new("Instrument", ColumnType.Text, t => t.Instrument),
        // The verdict composes the trade the edit would make and asks the domain whether it can exist.
        new("Notional", ColumnType.Number, t => t.Notional, editable: true) { ValidateAsync = JudgeAsync },
        new("Price", ColumnType.Number, t => t.Price),
    ];

    private static async ValueTask<EditVerdict> JudgeAsync(Trade trade, string text, CancellationToken cancelled)
    {
        if (!decimal.TryParse(text, out var notional))
            return EditVerdict.Reject($"'{text}' is not a notional.");
        // Standing in for a round trip to the booking service; Escape cancels it.
        await Task.Delay(300, cancelled);
        return Booking.Check(trade with { Notional = notional });
    }

    private void Edit(GridEditIntent<Trade> intent) => Book(intent.Row, decimal.Parse(intent.Value));

    // A fill asks the verdict once, for the editor's row: every row it reaches is judged here, and a fill that would
    // make a trade that cannot exist is refused whole.
    private void Fill(GridPasteIntent intent)
    {
        var booked = new List<(Trade Trade, decimal Notional)>();
        foreach (var target in intent.Plan.Targets)
        {
            for (var row = target.TopRow; row <= target.BottomRow; row++)
            {
                for (var column = target.LeftColumn; column <= target.RightColumn; column++)
                {
                    var trade = _source.Window[row - _source.WindowStart];
                    if (_columns[column].Name != "Notional" || !decimal.TryParse(intent.ValueFor(new CellPosition(row, column)), out var notional)
                        || Booking.Check(trade with { Notional = notional }).Kind == EditVerdictKind.Reject)
                    {
                        intent.Refuse();
                        return;
                    }
                    booked.Add((trade, notional));
                }
            }
        }
        foreach (var (trade, notional) in booked)
            Book(trade, notional);
    }

    // Applied, and flagged where the domain flags it: the flag is painted through CellState and said through
    // CellMessageOf, and a new CellState delegate is how the grid hears that the flags changed.
    private void Book(Trade trade, decimal notional)
    {
        var booked = trade with { Notional = notional };
        _source.ReplaceRow(trade, booked);
        if (Booking.Check(booked) is { Kind: EditVerdictKind.Flag, Message: { } why })
            _flags[trade.Id] = why;
        else
            _flags.Remove(trade.Id);
        var flagged = _flags.Keys.ToHashSet();
        _cellState = (t, column) => column.Name == "Notional" && flagged.Contains(t.Id) ? CellState.Error : CellState.Normal;
    }

    private string? MessageOf(Trade trade, GridColumn<Trade> column)
        => column.Name == "Notional" ? _flags.GetValueOrDefault(trade.Id) : null;

    // The domain: a trade of less than a million cannot be booked, and one above fifty million needs a second signature.
    private static class Booking
    {
        public static EditVerdict Check(Trade trade) => trade.Notional switch
        {
            < 1_000_000m => EditVerdict.Reject($"A trade of {trade.Notional:N0} cannot be booked: the minimum is 1,000,000."),
            > 50_000_000m => EditVerdict.Flag($"{trade.Notional:N0} is above the desk's limit of 50,000,000: a second signature is needed."),
            _ => EditVerdict.Accept,
        };
    }
}
