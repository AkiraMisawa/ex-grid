@using ExGrid.Columns
@using ExGrid.Docs.Examples.Data

<label style="display: inline-flex; gap: 6px; align-items: center; margin-bottom: 12px; font-size: 14px">
    <input type="checkbox" @bind="_findsHeaders" />
    Search the headers (press Ctrl+F in the grid and type "price", then "economics")
</label>

<ExGrid TRow="Trade" Source="_source" Columns="_columns" HeaderGroups="_groups" FindsHeaders="_findsHeaders"
        ViewportHeight="320" ViewportWidth="ViewportSize.Stretch" />

@code {
    private readonly InMemoryGridSource<Trade> _source = GridSource.From(Trade.Sample(2_000));

    // No cell says "price" or "economics": a step finds the column header or the Header Group label, marks
    // it as the current match and says so in the panel, and the Focus stays on the cell it was on.
    private readonly GridColumn<Trade>[] _columns =
    [
        new("Id", ColumnType.Number, t => t.Id),
        new("Book", ColumnType.Text, t => t.Book),
        new("Trader", ColumnType.Text, t => t.Trader),
        new("Instrument", ColumnType.Text, t => t.Instrument),
        new("Notional", ColumnType.Number, t => t.Notional, format: v => ((decimal)v).ToString("N0")),
        new("Price", ColumnType.Number, t => t.Price),
        new("TradeDate", ColumnType.Date, t => t.TradeDate, header: "Trade date", dateType: DateType.DateOnly),
    ];

    private readonly HeaderGroup[] _groups =
    [
        new("Who", ["Book", "Trader"]),
        new("Economics", ["Notional", "Price"]),
    ];

    private bool _findsHeaders = true;
}
