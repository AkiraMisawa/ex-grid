@using System.Globalization
@using ExGrid.Cells
@using ExGrid.Finding
@using ExGrid.Docs.Examples.Data

<MudExGridPaper Class="docs-stretch-paper" Elevation="0" Outlined="true">
    <ToolBarContent>
        <MudIconButton Icon="@Icons.Material.Filled.Undo" Size="Size.Small" Disabled="@(_undo.Count == 0)" OnClick="Undo" aria-label="Undo" />
        <MudText Typo="Typo.body2" Class="ml-2">@_message</MudText>
    </ToolBarContent>
    <ChildContent>
        <ExGrid TRow="Trade" Source="_source" Columns="_columns" Chrome="_chrome"
                OnEdit="OnEdit" OnReplace="OnReplace" OnUndo="Undo"
                ViewportHeight="320" ViewportWidth="ViewportSize.Stretch" />
    </ChildContent>
</MudExGridPaper>

@code {
    private static readonly MudGridChrome _chrome = new();
    private static readonly CultureInfo Invariant = CultureInfo.InvariantCulture;

    private readonly InMemoryGridSource<Trade> _source = GridSource.From(Trade.Sample(2_000));

    // Trader and Price are Editable: Replace writes there, and a match anywhere else refuses Replace All.
    private readonly GridColumn<Trade>[] _columns =
    [
        new("Id", ColumnType.Number, t => t.Id),
        new("Book", ColumnType.Text, t => t.Book),
        new("Trader", ColumnType.Text, t => t.Trader, editable: true),
        new("Instrument", ColumnType.Text, t => t.Instrument),
        new("Price", ColumnType.Number, t => t.Price, editable: true),
    ];

    // One step per gesture — an edit, or a whole Replace All — so one Ctrl+Z undoes it.
    private readonly Stack<IReadOnlyList<GridReplacedRow<Trade>>> _undo = new();
    private string _message = "Press Ctrl+H in the grid: replace Novak with Rossi, one at a time or all at once.";

    // Replace (one) is an ordinary edit of the current match.
    private void OnEdit(GridEditIntent<Trade> edit)
    {
        if (Write(edit.Row, edit.Column, edit.Value) is { Row: { } replacement })
        {
            _source.ReplaceRow(edit.Row, replacement);
            _undo.Push([new(edit.Row, replacement)]);
        }
        else
        {
            edit.Refuse($"'{edit.Value}' is not a price");
        }
    }

    // Replace All: GridSource.From finds every match and writes them all, or none, through your write.
    private Task<GridReplaceResult> OnReplace(GridReplaceRequest request)
    {
        var answer = _source.Replace(request, Write);
        if (answer.Changes.Count > 0)
            _undo.Push(answer.Changes);
        _message = answer.Result.RowSequenceVersion != request.RowSequenceVersion
            ? "Nothing replaced: the rows moved while it was asked."
            : answer.Result.IsReplaced
            ? $"Replaced {answer.Result.Count} cells in one step."
            : $"Nothing replaced: {answer.Result.RefusedCells.Count} cells could not be written.";
        StateHasChanged();
        return Task.FromResult(answer.Result);
    }

    // A new instance with one value changed, or a refusal in your words.
    private static GridReplaceWrite<Trade> Write(Trade row, string column, string text) => column switch
    {
        "Trader" => GridReplaceWrite<Trade>.To(row with { Trader = text }),
        "Price" when decimal.TryParse(text, NumberStyles.Number, Invariant, out var price) => GridReplaceWrite<Trade>.To(row with { Price = price }),
        _ => GridReplaceWrite<Trade>.Refuse($"'{text}' is not a price"),
    };

    private void Undo()
    {
        if (!_undo.TryPop(out var step))
            return;
        for (var i = step.Count - 1; i >= 0; i--)
            _source.ReplaceRow(step[i].After, step[i].Before);
        _message = $"Undone: {step.Count} rows.";
    }
}
