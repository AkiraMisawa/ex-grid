@implements IDisposable
@using ExPivot.Components
@using ExPivot.Engine

<ExPivot Source="_source" @bind-Layout="_layout" ViewportHeight="340" />

@code {
    // Stands for the server across the network: each call below would be an HTTP request.
    private readonly SalesServer _server = new();
    private FetchingPivotSource _source = default!;

    private PivotLayout _layout = new()
    {
        Rows = [new PivotFieldPlacement("Region")],
        Columns = [new PivotFieldPlacement("Year")],
        Values = [new PivotValueField("Revenue", PivotAggregation.Sum) { NumberFormat = "#,##0" }],
    };

    protected override void OnInitialized()
    {
        // ExPivot asks; each delegate writes the question as JSON, sends it, and reads the
        // answer back. The transport, its authentication and its retries are yours.
        _source = PivotSource.Fetch(_server.Fields, PivotSourceFeatures.All,
            async (query, token) => PivotJson.ReadAnswer(await _server.AggregateAsync(PivotJson.Write(query), token)),
            async (query, token) => PivotJson.ReadItemPage(await _server.ItemsAsync(PivotJson.Write(query), token)),
            async (query, token) => PivotJson.ReadDetailPage(await _server.DetailsAsync(PivotJson.Write(query), token)));
    }

    public void Dispose() => _server.Dispose();
}
