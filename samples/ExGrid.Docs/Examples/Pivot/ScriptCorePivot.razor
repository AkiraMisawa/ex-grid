@using ExGrid.Selection
@using ExPivot
@using ExPivot.Engine

<p>
    <label>
        <input type="checkbox" @bind="_japanese" />
        Excel's Japanese words
    </label>
    <label>
        <input type="checkbox" @bind="_takeRecords" />
        Take the records of a double-clicked cell here
    </label>
    <label>
        <input type="checkbox" @bind="_byMarket" />
        Order the regions by market size
    </label>
</p>

<ExPivot.Script.ExPivot Source="@(_byMarket ? _byMarketSize : _source)" @bind-Layout="_layout" ViewportHeight="360"
                        Label="@(_japanese ? PivotWords.Japanese : null)"
                        OnShowDetails="@(_takeRecords ? _showDetails : default)"
                        SelectionChanged="ShowSelection" />

@* Never empty, so the line is there before the first report and the pivot does not move under a double click. *@
<p role="status">@_selection</p>

@if (_records is not null)
{
    <p role="status">@_records</p>
}

@code {
    private static readonly Sale[] Records = Sales.Sample();

    // The source answers in .NET, and the report is built in the browser.
    private readonly PivotSource _source = PivotSource.From(Records, Sales.Fields);

    // The regions ordered by the size of their market, largest first, by an Order Key in C#: .NET answers each
    // region's key with the regions, and the browser orders them by it.
    private readonly PivotSource _byMarketSize = PivotSource.From(Records, Sales.FieldsOf(regionOrder: region => region switch
    {
        "North America" => 0,
        "Europe" => 1,
        "Asia Pacific" => 2,
        _ => 3,
    }));

    private PivotLayout _layout = new()
    {
        Rows = [new PivotFieldPlacement("Region")],
        Columns = [new PivotFieldPlacement("Year")],
        Values = [new PivotValueField("Revenue", PivotAggregation.Sum) { NumberFormat = "#,##0" }],
    };

    private bool _japanese;
    private bool _takeRecords;
    private bool _byMarket;
    private string? _records;
    private string _selection = "Nothing selected";
    private EventCallback<PivotDetails> _showDetails;

    // The report grid's Selection, read in .NET as the pivot drawn in .NET reports it.
    private void ShowSelection(GridSelection selection) => _selection = selection.IsEmpty
        ? "Nothing selected"
        : $"Focus: row {selection.Focus.Row}, column {selection.Focus.Column}; {selection.CellCount} cell(s) selected";

    protected override void OnInitialized() => _showDetails = EventCallback.Factory.Create<PivotDetails>(this, TakeAsync);

    // The records behind the cell, asked of the source in .NET under the report's Source Version.
    private async Task TakeAsync(PivotDetails details)
    {
        var page = await details.DetailsAsync(0, 100);
        _records = page.IsRefused ? $"{details.Title}: the data has changed." : $"{details.Title}: {page.Total} records";
    }
}
