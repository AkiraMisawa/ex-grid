@using ExPivot.Components
@using ExPivot.Engine
@using ExPivot.MudBlazor

<MudStack Row="true" Class="mb-3">
    <MudButton Variant="Variant.Outlined" OnClick="Save">Save the layout</MudButton>
    <MudButton Variant="Variant.Outlined" OnClick="Restore" Disabled="@(_saved is null)">Restore the saved layout</MudButton>
</MudStack>

<MudExGridPaper Class="docs-stretch-paper" Elevation="0" Outlined="true">
    <ExPivot DataSource="_source" @bind-Layout="_layout" PivotChrome="MudPivotChrome.Default" ViewportHeight="320" />
</MudExGridPaper>

@if (_saved is not null)
{
    <MudText Typo="Typo.body2" Class="mt-3" Style="font-family: monospace; white-space: pre-wrap; overflow-wrap: anywhere">@_saved</MudText>
}

@code {
    private readonly PivotSource _source = PivotSource.From(Sales.Sample(), Sales.Fields);

    private PivotLayout _layout = new()
    {
        Rows = [new PivotFieldPlacement("Category")],
        Columns = [new PivotFieldPlacement("Channel")],
        Values = [new PivotValueField("Units", PivotAggregation.Sum) { NumberFormat = "#,##0" }],
    };

    // What you would store as the user's setting: versioned JSON, holding no value.
    private string? _saved;

    private void Save() => _saved = PivotLayoutJson.Write(_layout);

    private void Restore() => _layout = PivotLayoutJson.Read(_saved!);
}
