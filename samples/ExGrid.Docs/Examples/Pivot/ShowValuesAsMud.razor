@using ExPivot.Components
@using ExPivot.Engine
@using ExPivot.MudBlazor

<MudSelect T="PivotShowValuesAs" Label="Show the second Revenue as" Dense="true" Variant="Variant.Outlined"
           Style="max-width: 280px" Class="mb-3" Value="Shown" ValueChanged="ShowAs">
    <MudSelectItem Value="PivotShowValuesAs.PercentOfGrandTotal">% of Grand Total</MudSelectItem>
    <MudSelectItem Value="PivotShowValuesAs.PercentOfColumnTotal">% of Column Total</MudSelectItem>
    <MudSelectItem Value="PivotShowValuesAs.PercentOfRowTotal">% of Row Total</MudSelectItem>
    <MudSelectItem Value="PivotShowValuesAs.NoCalculation">No Calculation</MudSelectItem>
</MudSelect>

<MudExGridPaper Class="docs-stretch-paper" Elevation="0" Outlined="true">
    <ExPivot Source="_source" @bind-Layout="_layout" PivotChrome="MudPivotChrome.Default" ViewportWidth="740" ViewportHeight="340" />
</MudExGridPaper>

@code {
    private readonly PivotSource _source = PivotSource.From(Sales.Sample(), Sales.Fields);

    private PivotLayout _layout = new()
    {
        Rows = [new PivotFieldPlacement("Region")],
        Columns = [new PivotFieldPlacement("Year")],
        Values =
        [
            new PivotValueField("Revenue", PivotAggregation.Sum) { NumberFormat = "#,##0" },
            new PivotValueField("Revenue", PivotAggregation.Sum)
            {
                Caption = "Share",
                ShowValuesAs = PivotShowValuesAs.PercentOfColumnTotal,
                NumberFormat = "0.0%",
            },
        ],
    };

    // The second Value Field, while the user has left it in Values.
    private PivotShowValuesAs Shown => _layout.Values.ElementAtOrDefault(1)?.ShowValuesAs ?? PivotShowValuesAs.NoCalculation;

    // The layout is immutable: the Value Field changed is a new one, in a new layout.
    private void ShowAs(PivotShowValuesAs showAs)
    {
        if (_layout.Values.Count > 1)
            _layout = _layout with { Values = [.. _layout.Values.Select((v, i) => i == 1 ? v with { ShowValuesAs = showAs } : v)] };
    }
}
