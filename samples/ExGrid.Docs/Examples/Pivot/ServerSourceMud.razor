@implements IAsyncDisposable
@using ExPivot.Script
@using ExPivot.Engine
@using ExPivot.MudBlazor

<MudExGridPaper Class="docs-stretch-paper" Elevation="0" Outlined="true">
    <ExPivot Source="_source" @bind-Layout="_layout" Chrome="MudPivotChrome.Default" ViewportHeight="340" />
</MudExGridPaper>

@code {
    // Stands for the server across the network: each call below would be an HTTP request.
    private readonly SalesServer _server = new();
    private FetchingPivotSource _source = default!;

    private PivotLayout _layout = new()
    {
        Rows = [new PivotFieldPlacement("Region")],
        Columns = [new PivotFieldPlacement("Year")],
        Values = [new PivotValueField("Revenue", PivotAggregation.Sum) { NumberFormat = "#,##0" }],
    };

    protected override void OnInitialized()
    {
        // ExPivot asks for the Leaf Aggregates, and builds the report, its totals and its order in the
        // browser (ADR-0370 section 3); each fetcher writes the question as JSON, sends it, and reads
        // the answer back. The transport, its authentication and its retries are yours.
        _source = _server.Source();
    }

    public ValueTask DisposeAsync() => _server.DisposeAsync();
}
