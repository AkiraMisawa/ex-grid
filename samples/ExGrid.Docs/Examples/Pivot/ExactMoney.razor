@using ExPivot.Components
@using ExPivot.Engine

<ExPivot Source="_source" @bind-Layout="_layout" ViewportHeight="260" />

@code {
    private readonly PivotSource _source = PivotSource.From(Holdings.Sample(), Holdings.Fields);

    // The same market values summed twice: as decimal, exactly, and as double, as binary
    // floating point does. Compare the cents.
    private PivotLayout _layout = new()
    {
        Rows = [new PivotFieldPlacement("Custodian")],
        Values =
        [
            new PivotValueField("MarketValue", PivotAggregation.Sum) { NumberFormat = "#,##0.00" },
            new PivotValueField("MarketValueDouble", PivotAggregation.Sum) { NumberFormat = "#,##0.00" },
        ],
    };
}
