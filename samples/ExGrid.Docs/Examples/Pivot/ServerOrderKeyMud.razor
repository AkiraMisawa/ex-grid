@implements IAsyncDisposable
@using ExPivot.Components
@using ExPivot.Engine
@using ExPivot.MudBlazor

<MudExGridPaper Class="docs-stretch-paper" Elevation="0" Outlined="true">
    <ExPivot Source="_source" @bind-Layout="_layout" Chrome="MudPivotChrome.Default" ViewportHeight="300" />
</MudExGridPaper>

@code {
    private readonly SalesServer _server = new();

    // The regions by the size of their market, largest first, rather than by their names. A region
    // the table does not rank is refused by name, never ordered last as if it were the smallest.
    private static readonly Dictionary<string, int> MarketSize = new()
    {
        ["North America"] = 0,
        ["Europe"] = 1,
        ["Asia Pacific"] = 2,
        ["Latin America"] = 3,
    };

    private static IComparable? SizeOf(string region) => MarketSize.TryGetValue(region, out var size)
        ? size
        : throw new InvalidOperationException($"No market size is known for the region '{region}'.");

    private FetchingPivotSource _source = default!;

    private PivotLayout _layout = new()
    {
        Rows = [new PivotFieldPlacement("Region")],
        Columns = [new PivotFieldPlacement("Year")],
        Values = [new PivotValueField("Revenue", PivotAggregation.Sum) { NumberFormat = "#,##0" }],
    };

    protected override void OnInitialized()
    {
        // The report is ordered where it is built, so a field's Order Key is yours: the same fields
        // as the server's, with Region given one. Nothing about the order crosses the wire.
        _source = _server.Source(Sales.FieldsOf(regionOrder: SizeOf).Fields);
    }

    public ValueTask DisposeAsync() => _server.DisposeAsync();
}
