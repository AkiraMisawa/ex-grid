@using ExPivot.Chrome

@* Data only, and no handler: each button is marked with the press it makes and the name the pivot gives the keyboard
   to, and each box with the name of what opens in it. ExPivot's script wires them in the browser. *@
<div style="display: flex; gap: 8px; align-items: center; padding-bottom: 6px">
    <div @attributes="@(View.ReportFilters ? Marks(PivotScriptSlotAttributes.Anchor, "report-filters") : None)"></div>
    <span style="position: relative; margin-left: auto">
        <button type="button" aria-haspopup="menu" aria-expanded="@(View.LayoutMenuOpen ? "true" : "false")"
                @attributes="@Marks(PivotScriptSlotAttributes.Press, "layout", PivotScriptSlotAttributes.Control, "layout")">@View.LayoutLabel ▾</button>
        <span @attributes="@Marks(PivotScriptSlotAttributes.Anchor, "layout")"></span>
    </span>
    <button type="button" aria-pressed="@(View.FieldListShown ? "true" : "false")"
            @attributes="@Marks(PivotScriptSlotAttributes.Press, "field-list", PivotScriptSlotAttributes.Control, "field-list")">@View.FieldListLabel</button>
</div>
@if (View.Refusal is { } refusal)
{
    <div role="alert">@refusal</div>
}

@code {
    [Parameter, EditorRequired] public PivotToolbarView View { get; set; } = default!;

    private static readonly IReadOnlyDictionary<string, object> None = new Dictionary<string, object>();

    private static Dictionary<string, object> Marks(params string[] pairs)
    {
        var marks = new Dictionary<string, object>();
        for (var i = 0; i < pairs.Length; i += 2)
            marks[pairs[i]] = pairs[i + 1];
        return marks;
    }
}
