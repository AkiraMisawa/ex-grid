@using global::ExGrid.Chrome
@using ExPivot.Chrome

@* Each button claims its click (data-ex-claims) and hands its work to the context's InOrder, so the
   click is handled in its place among the report's keys and presses. *@
<div style="display: flex; gap: 8px; align-items: center; padding-bottom: 6px">
    @Context.ReportFilters
    <span style="position: relative; margin-left: auto">
        <button @ref="_layoutButton" type="button" data-ex-claims="click" aria-haspopup="menu"
                aria-expanded="@(Context.LayoutMenu.IsOpen ? "true" : "false")"
                @onclick="() => Context.InOrder(GridInputKind.Click, OpenLayoutMenu)">@Context.LayoutMenu.Label ▾</button>
        @Context.LayoutMenu.Popup
    </span>
    <button type="button" data-ex-claims="click" aria-pressed="@(Context.FieldList.Checked == true ? "true" : "false")"
            @onclick="() => Context.InOrder(GridInputKind.Click, Context.FieldList.Invoke)">@Context.FieldList.Label</button>
</div>

@code {
    private ElementReference _layoutButton;
    private int _acted;

    [Parameter, EditorRequired] public PivotToolbarContext Context { get; set; } = default!;

    private Task OpenLayoutMenu()
    {
        Context.LayoutMenu.Open();
        return Task.CompletedTask;
    }

    // Layout ▾ takes the keyboard back when its menu closes: through the context's TakeKeyboard, once
    // for each request.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var request = Context.LayoutMenu.FocusRequest;
        if (request != 0 && request != _acted)
        {
            _acted = request;
            await Context.TakeKeyboard(_layoutButton);
        }
    }
}
