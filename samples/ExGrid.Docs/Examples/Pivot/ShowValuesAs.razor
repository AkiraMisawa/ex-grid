@using ExPivot.Script
@using ExPivot.Engine

<p>
    @* The choice is offered while the user has left a second value in Values. *@
    @if (_layout.Values.Count > 1)
    {
        <label>
            Show the second Revenue as
            <select @bind:get="_layout.Values[1].ShowValuesAs" @bind:set="ShowAs">
                <option value="@PivotShowValuesAs.PercentOfGrandTotal">% of Grand Total</option>
                <option value="@PivotShowValuesAs.PercentOfColumnTotal">% of Column Total</option>
                <option value="@PivotShowValuesAs.PercentOfRowTotal">% of Row Total</option>
                <option value="@PivotShowValuesAs.NoCalculation">No Calculation</option>
            </select>
        </label>
    }
    else
    {
        <span>Put a second value in Values to choose how it is shown.</span>
    }
</p>

<ExPivot Source="_source" @bind-Layout="_layout" ViewportHeight="340" />

@code {
    private readonly PivotSource _source = PivotSource.From(Sales.Sample(), Sales.Fields);

    private PivotLayout _layout = new()
    {
        Rows = [new PivotFieldPlacement("Region")],
        Columns = [new PivotFieldPlacement("Year")],
        Values =
        [
            new PivotValueField("Revenue", PivotAggregation.Sum) { NumberFormat = "#,##0" },
            new PivotValueField("Revenue", PivotAggregation.Sum)
            {
                Caption = "Share",
                ShowValuesAs = PivotShowValuesAs.PercentOfColumnTotal,
                NumberFormat = "0.0%",
            },
        ],
    };

    // The layout is immutable: the Value Field changed is a new one, in a new layout. A choice that arrives as the
    // user removes the field goes with the select it was made in.
    private void ShowAs(PivotShowValuesAs showAs)
    {
        if (_layout.Values.Count > 1)
            _layout = _layout with { Values = [.. _layout.Values.Select((v, i) => i == 1 ? v with { ShowValuesAs = showAs } : v)] };
    }
}
