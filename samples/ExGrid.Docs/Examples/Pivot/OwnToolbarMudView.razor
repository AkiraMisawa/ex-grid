@using ExPivot.Chrome

@* Data only, and no handler: each MudButton carries, through UserAttributes, the press it makes and the name the
   pivot gives the keyboard to, and each box the name of what opens in it. ExPivot's script wires them in the
   browser. *@
<div style="display: flex; gap: 8px; align-items: center; padding-bottom: 6px">
    <div @attributes="@(View.ReportFilters ? Marks(PivotScriptSlotAttributes.Anchor, "report-filters") : None)"></div>
    <span style="position: relative; margin-left: auto">
        <MudButton Variant="Variant.Text" Size="Size.Small" EndIcon="@Icons.Material.Filled.ArrowDropDown"
                   UserAttributes="@(With(Marks(PivotScriptSlotAttributes.Press, "layout", PivotScriptSlotAttributes.Control, "layout"),
                       "aria-haspopup", "menu", "aria-expanded", View.LayoutMenuOpen ? "true" : "false"))">@View.LayoutLabel</MudButton>
        <span @attributes="@Marks(PivotScriptSlotAttributes.Anchor, "layout")"></span>
    </span>
    <MudButton Variant="Variant.Text" Size="Size.Small" Color="@(View.FieldListShown ? Color.Primary : Color.Default)"
               UserAttributes="@(With(Marks(PivotScriptSlotAttributes.Press, "field-list", PivotScriptSlotAttributes.Control, "field-list"),
                   "aria-pressed", View.FieldListShown ? "true" : "false"))">@View.FieldListLabel</MudButton>
</div>
@if (View.Refusal is { } refusal)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" role="alert">@refusal</MudAlert>
}

@code {
    [Parameter, EditorRequired] public PivotToolbarView View { get; set; } = default!;

    private static readonly IReadOnlyDictionary<string, object> None = new Dictionary<string, object>();

    private static Dictionary<string, object> Marks(params string[] pairs) => With([], pairs);

    private static Dictionary<string, object> With(Dictionary<string, object> marks, params string[] pairs)
    {
        for (var i = 0; i < pairs.Length; i += 2)
            marks[pairs[i]] = pairs[i + 1];
        return marks;
    }
}
