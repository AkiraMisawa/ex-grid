@implements IAsyncDisposable
@using ExPivot.Components
@using ExPivot.Engine
@using ExPivot.MudBlazor

<MudExGridPaper Class="docs-stretch-paper" Elevation="0" Outlined="true">
    <ExPivot Source="_source" @bind-Layout="_layout" PivotChrome="MudPivotChrome.Default" ViewportHeight="300" />
</MudExGridPaper>

@code {
    private readonly SalesServer _server = new();
    private FetchingPivotReportSource _source = default!;

    private PivotLayout _layout = new()
    {
        Rows = [new PivotFieldPlacement("Category")],
        Columns = [new PivotFieldPlacement("Region")],
        Values = [new PivotValueField("Units", PivotAggregation.Sum) { NumberFormat = "#,##0" }],
    };

    protected override void OnInitialized()
    {
        _source = PivotReportSource.Fetch(_server.Fields, PivotSourceFeatures.All, PivotReportUpdateMode.Incremental,
            async (query, token) => PivotReportJson.Read<PivotReportUpdate>(await _server.WindowAsync(PivotReportJson.Write(query), token)),
            copy: async (query, token) => PivotReportJson.Read<PivotReportCopyResult>(await _server.CopyAsync(PivotReportJson.Write(query), token)),
            summary: async (query, token) => PivotReportJson.Read<PivotReportSummaryResult>(await _server.SummaryAsync(PivotReportJson.Write(query), token)),
            details: async (query, token) => PivotReportJson.Read<PivotDetailPage>(await _server.DetailsAsync(PivotReportJson.Write(query), token)),
            reportItems: async (query, token) => PivotReportJson.Read<PivotReportItemsResult>(await _server.ItemsAsync(PivotReportJson.Write(query), token)));
        // However the news arrives — SignalR, polling, a message bus — pass it on: ExPivot asks
        // the current report Window again.
        _server.VersionChanged += _source.NotifyChanged;
        _server.StartTrading(TimeSpan.FromSeconds(1));
    }

    public async ValueTask DisposeAsync()
    {
        _server.VersionChanged -= _source.NotifyChanged;
        await _server.DisposeAsync();
    }
}
