@implements IAsyncDisposable
@using ExPivot.Components
@using ExPivot.Engine
@using ExPivot.MudBlazor

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
    <MudButton Variant="Variant.Outlined" OnClick="() => _cutOff = !_cutOff">@(_cutOff ? "Reconnect the server" : "Cut the server off")</MudButton>
</MudStack>

<MudExGridPaper Class="docs-stretch-paper" Elevation="0" Outlined="true">
    <ExPivot Source="_source" @bind-Layout="_layout" Chrome="MudPivotChrome.Default" ViewportHeight="300" />
</MudExGridPaper>

@code {
    private readonly SalesServer _server = new();
    private FetchingPivotSource _source = default!;
    private bool _cutOff;

    private PivotLayout _layout = new()
    {
        Rows = [new PivotFieldPlacement("Category")],
        Columns = [new PivotFieldPlacement("Region")],
        Values = [new PivotValueField("Units", PivotAggregation.Sum) { NumberFormat = "#,##0" }],
    };

    protected override void OnInitialized()
    {
        // Cut off, the next question fails, as an unreachable server's does: ExPivot keeps the
        // report it has as a Stale Report, says so, and mutes its numbers until Retry (ADR-0067).
        _source = _server.Source(reachable: () => !_cutOff);
        // However the news arrives — SignalR, polling, a message bus — pass it on: ExPivot asks
        // the report on screen again.
        _server.VersionChanged += _source.NotifyChanged;
        _server.StartTrading(TimeSpan.FromSeconds(1));
    }

    public async ValueTask DisposeAsync()
    {
        _server.VersionChanged -= _source.NotifyChanged;
        await _server.DisposeAsync();
    }
}
