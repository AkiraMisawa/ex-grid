@using ExPivot.Engine
@using ExPivot.MudBlazor

@* MudPivotChrome draws the Pivot Toolbar, the report filter band, the menus, Filter…, Field Settings…, Value Field
   Settings… and the Stale Report's notice with MudBlazor's components inside the pivot the browser draws, and its
   Grid Chrome dresses the report grid. The PivotTable Fields pane and Show Details are still the pivot's own for
   now. *@
<MudExGridPaper Class="docs-stretch-paper" Elevation="0" Outlined="true">
    <ExPivot.Script.ExPivot Source="_source" @bind-Layout="_layout" ViewportHeight="360" Chrome="MudPivotChrome.Default" />
</MudExGridPaper>

@code {
    // The same source as ExPivot.Components.ExPivot's: it answers in .NET, and the report is built in the browser.
    private readonly PivotSource _source = PivotSource.From(Sales.Sample(), Sales.Fields);

    private PivotLayout _layout = new()
    {
        Rows = [new PivotFieldPlacement("Region")],
        Columns = [new PivotFieldPlacement("Year")],
        Values = [new PivotValueField("Revenue", PivotAggregation.Sum) { NumberFormat = "#,##0" }],
    };
}
