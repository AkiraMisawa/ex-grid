@using ExPivot
@using ExPivot.Engine
@using ExPivot.MudBlazor

@* MudPivotChrome draws every part of the pivot with MudBlazor's components inside the pivot the browser draws: the
   Pivot Toolbar, the report filter band, the menus, Filter…, Field Settings…, Value Field Settings…, the Stale
   Report's notice, the PivotTable Fields pane, and Show Details' sheet tabs or its dialog. Its Grid Chrome dresses
   the report grid. Double click a value to see the records. *@
<MudRadioGroup T="PivotDetailsView" @bind-Value="_detailsView" Class="mb-2">
    <MudRadio Value="PivotDetailsView.Tab">Show Details in a tab at the report's foot</MudRadio>
    <MudRadio Value="PivotDetailsView.Dialog">Show Details in a dialog</MudRadio>
</MudRadioGroup>

<MudExGridPaper Class="docs-stretch-paper" Elevation="0" Outlined="true">
    <ExPivot.Script.ExPivot Source="_source" @bind-Layout="_layout" DetailsView="_detailsView" ViewportHeight="360"
                            Chrome="MudPivotChrome.Default" />
</MudExGridPaper>

@code {
    // The same source as ExPivot.Components.ExPivot's: it answers in .NET, and the report is built in the browser.
    private readonly PivotSource _source = PivotSource.From(Sales.Sample(), Sales.Fields);

    private PivotDetailsView _detailsView = PivotDetailsView.Tab;

    private PivotLayout _layout = new()
    {
        Rows = [new PivotFieldPlacement("Region")],
        Columns = [new PivotFieldPlacement("Year")],
        Values = [new PivotValueField("Revenue", PivotAggregation.Sum) { NumberFormat = "#,##0" }],
    };
}
