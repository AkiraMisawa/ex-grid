@using ExSheet.Engine

<p>
    <button class="btn btn-sm btn-outline-secondary" @onclick="UndoAsync">Undo</button>
    <button class="btn btn-sm btn-outline-secondary" @onclick="() => _document = Expenses.Document()">Start again</button>
</p>

<ExSheet.Script.ExSheet @ref="_sheet" @bind-Document="_document" ViewportHeight="300" ViewportWidth="ViewportSize.Stretch" />

@* Never empty, so the line is there before the first answer and the Sheet does not move under the pointer. *@
<p class="mt-3" role="status">The document holds @_document.Cells.Count cells. @_undone</p>

@code {
    // The same document as ExSheet.Components.ExSheet's: it crosses to the browser as JSON, and every change comes back.
    private SheetDocument _document = Expenses.Document();
    private ExSheet.Script.ExSheet? _sheet;
    private string _undone = "";

    // A command asked from .NET of the Sheet in the browser; its refusal comes back as the Razor component's does.
    private async Task UndoAsync()
    {
        var sheet = _sheet ?? throw new InvalidOperationException("The Sheet is rendered with the Example.");
        try
        {
            _undone = await sheet.UndoAsync() ? "Undone." : "Nothing to undo.";
        }
        catch (SheetRefusedException refused)
        {
            _undone = refused.Refusal.Message;
        }
    }
}
