@using ExSheet
@using ExSheet.Engine
@using ExGrid.Data
@using ExGrid.Summarizing

<p>
    <button class="btn btn-sm btn-outline-secondary" @onclick="UndoAsync">Undo</button>
    <button class="btn btn-sm btn-outline-secondary" @onclick="ThreeMoreTaxisAsync">Three more taxis</button>
    <button class="btn btn-sm btn-outline-secondary" @onclick="KeepACopyAsync">Keep a copy</button>
    <button class="btn btn-sm btn-outline-secondary" disabled="@(_copy is null)" @onclick="BackToTheCopyAsync">Back to the copy</button>
    <button class="btn btn-sm btn-outline-secondary" @onclick="() => _document = Expenses.Document()">Start again</button>
</p>

<ExSheet.Components.ExSheet @ref="_sheet" @bind-Document="_document" OnSelectionSummaryChanged="Summarised"
                        ViewportHeight="330" ViewportWidth="ViewportSize.Stretch" ShowToolbar="true">
    @* Declared as components: the Script Core draws the rows, and a press on the button runs its
       OnClick here, in .NET, before the Sheet takes the next key. *@
    <ToolbarContent>
        <DefaultToolbarRow />
        <ToolbarRow Label="Review" KeyTip="R">
            <ToolbarButton Text="Mark reviewed" KeyTip="M" OnClick="MarkReviewedAsync" />
        </ToolbarRow>
    </ToolbarContent>
</ExSheet.Components.ExSheet>

@* Never empty, so the line is there before the first answer and the Sheet does not move under the pointer. *@
<p class="mt-3" role="status">The document holds @_document.Cells.Count cells.@_selected @_undone</p>

@code {
    // The page keeps the document: it crosses to the browser as JSON, and every change comes back.
    private SheetDocument _document = Expenses.Document();
    private ExSheet.Components.ExSheet? _sheet;

    // The page's own command on the Selection, run through the Sheet's public command:
    // a toggle, made from the Focus cell as it shows when the press runs, so a reviewed cell is unmarked.
    private Task MarkReviewedAsync() =>
        Sheet().SetCellFormatFromFocusAsync(focus => new CellFormatChange { Fill = focus.Fill == Reviewed ? CellFill.None : Reviewed });
    private static readonly CellFill Reviewed = CellFill.Solid(CellColour.FromRgb(0xE2EFDA));
    private string _undone = "";
    private string _selected = "";

    // The Selection Summary the Sheet in the browser answered: here its Sum, shown
    // outside the Sheet as an application's own status bar would, in the Sheet's words when it has them, and an error
    // said as one rather than left out.
    private void Summarised(SelectionSummary summary)
        => _selected = summary is { Status: SelectionSummaryStatus.Answered, Result: { } result } && result[SummaryFigures.Sum] is { IsEmpty: false } sum
            ? sum.Error != AggregateError.None
                ? " The selection's sum is an error."
                : $" The selection sums to {result.TextOf(SummaryFigures.Sum) ?? sum.Number.ToString("#,##0.##")}."
            : "";

    // An edit made in .NET, done by the Sheet in the browser.
    private Task ThreeMoreTaxisAsync() => Sheet().DoAsync(SheetEdit.Enter(CellAddress.Parse("B5"), "12"));

    // A save and an opening, each in its turn among the Sheet's inputs: the write is handed .NET's copy of the
    // browser's Workbook, its Values computed again in .NET, and the read runs in .NET. A file's writer and reader,
    // such as ExSheet.Xlsx's, go where these keep the document in memory.
    private WorkbookDocument? _copy;

    private Task KeepACopyAsync() => Sheet().SaveAsync(workbook =>
    {
        _copy = workbook.ToDocument();
        _undone = $"Copy kept, totalling {workbook.Sheets[0].GetValue(CellAddress.Parse("D7"))?.Number:#,##0.00}.";
        return Task.CompletedTask;
    });

    private async Task BackToTheCopyAsync()
    {
        var copy = _copy ?? throw new InvalidOperationException("The button is offered once a copy is kept.");
        _undone = await Sheet().OpenAsync(_ => Task.FromResult(copy)) ? "Back to the copy." : "Nothing opened.";
    }

    private ExSheet.Components.ExSheet Sheet() => _sheet ?? throw new InvalidOperationException("The Sheet is rendered with the Example.");

    // A command asked from .NET of the Sheet in the browser; its refusal comes back to .NET.
    private async Task UndoAsync()
    {
        try
        {
            _undone = await Sheet().UndoAsync() ? "Undone." : "Nothing to undo.";
        }
        catch (SheetRefusedException refused)
        {
            _undone = refused.Refusal.Message;
        }
    }
}
