@using ExSheet.Script
@using ExSheet.Engine
@using ExSheet.MudBlazor

<MudExGridPaper Class="docs-stretch-paper" Elevation="0" Outlined="true">
    <ExSheet @bind-Document="_document" Chrome="MudSheetChrome.Default" PinnedColumnCount="1"
             ViewportHeight="300" ViewportWidth="ViewportSize.Stretch" />
</MudExGridPaper>

@code {
    // Column A stays in place as the rest scrolls, as a frozen pane does in Excel.
    private SheetDocument _document = QuarterlyPnl.Document();
}
