@using ExGrid.Selection
@using ExSheet.Components
@using ExSheet.Engine

<div class="d-flex flex-wrap gap-2 mb-3">
    <button type="button" disabled="@_editing" @onclick="() => Set(new() { Bold = true })">Bold</button>
    <button type="button" disabled="@_editing" @onclick="() => Set(new() { NumberFormat = NumberFormat.Parse(Thousands) })">Thousands</button>
    <button type="button" disabled="@_editing" @onclick="() => Set(new() { NumberFormat = NumberFormat.Parse(Percent) })">Percent</button>
    <button type="button" disabled="@_editing" @onclick="() => Set(new() { Fill = CellFill.Solid(CellColour.FromRgb(0xFFF2CC)) })">Highlight</button>
    <button type="button" disabled="@_editing" @onclick="() => Set(new() { Borders = BorderChange.Outline(new BorderLine(BorderLineStyle.Medium)) })">Outline</button>
    <button type="button" disabled="@_editing" @onclick="() => _sheet!.OpenFormatCellsAsync()">Format Cells…</button>
</div>

<ExSheet @ref="_sheet" @bind-Document="_document" @bind-Document:after="ReadFocus" EditingChanged="open => _editing = open"
         SelectionChanged="OnSelectionChanged" ViewportHeight="260" ViewportWidth="ViewportSize.Stretch" />

<p class="mt-3">Focus cell: @_focus</p>

@code {
    private const string Thousands = "#,##0;(#,##0)";
    private const string Percent = "0.0%";

    private ExSheet? _sheet;
    private SheetDocument _document = QuarterlyPnl.Document();
    private bool _editing;
    private GridSelection _selection = GridSelection.Empty;
    private string _focus = "";

    // Each press sets only the parts it names, on every range of the Selection, as one undo step.
    private async Task Set(CellFormatChange change) => await _sheet!.SetCellFormatAsync(change);

    private void OnSelectionChanged(GridSelection selection)
    {
        _selection = selection;
        ReadFocus();
    }

    // What the Focus cell shows: from the cell, its row or its column.
    private void ReadFocus()
    {
        if (_selection.IsEmpty) return;
        var format = _sheet!.CellFormatAt(new CellAddress(_selection.Focus.Row, _selection.Focus.Column));
        _focus = $"{format.NumberFormat.Code}{(format.Font.Bold ? ", bold" : "")}{(format.Fill.IsNone ? "" : ", filled")}";
    }
}
