@using ExGrid.Cells
@using ExSheet
@using ExSheet.Engine

<ExGrid.Script.ExGrid TRow="CostCentre" Source="_ledger" Columns="_columns" PointedAt="_pointedAt"
                      ViewportHeight="200" ViewportWidth="ViewportSize.Stretch" />

<div class="mt-4">
    <ExSheet.Script.ExSheet @ref="_sheet" @bind-Document="_document" PointingScope="_scope" OnPointingRefused="Refused"
                            ViewportHeight="280" ViewportWidth="ViewportSize.Stretch" />
</div>

@* Never empty, so the line is there before the first refusal and the Sheet does not move under the pointer. *@
<p class="mt-3" role="status">@_said</p>

@code {
    private ExSheet.Script.ExSheet? _sheet;
    private SheetDocument _document = CostReport.Document();
    // Never changed here, so the grid and the Sheet read the same rows.
    private static readonly CostCentre[] Centres = CostCentre.Sample();
    private readonly InMemoryGridSource<CostCentre> _ledger = GridSource.From(Centres);
    private string _said = "Type = in an empty cell, then click a figure in the grid.";

    private readonly GridColumn<CostCentre>[] _columns =
    [
        new("Code", ColumnType.Text, c => c.Code),
        new("Department", ColumnType.Text, c => c.Department),
        new("Budget", ColumnType.Number, c => c.Budget, format: v => ((double)v).ToString("N0")),
        new("Actual", ColumnType.Number, c => c.Actual, format: v => ((double)v).ToString("N0")),
    ];

    // The same Scope as the Razor components': the browser holds it, and this object names it. The grid is registered
    // once, as the page is made, and takes its declaration as it is made.
    private readonly PointingScope _scope = new();
    private GridPointedAt<CostCentre>? _pointedAt;

    protected override void OnInitialized()
    {
        // Asked in .NET as each row crosses to the browser, where a press reads the row's key from what it wrote.
        _pointedAt = _scope.RegisterGrid<CostCentre>(CostCentre.Table, c => c.ToRow());
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var sheet = _sheet ?? throw new InvalidOperationException("The Sheet is rendered with the Example.");
        await sheet.PushLinkedTableAsync(CostCentre.Table, Centres.Select(c => c.ToRow()));
    }

    private void Refused(PointingRefusal refusal) => _said = refusal.Message;
}
