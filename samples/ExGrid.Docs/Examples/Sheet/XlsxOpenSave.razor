@using ExSheet.Script
@using ExSheet.Engine
@using ExSheet.Xlsx
@using Microsoft.AspNetCore.Components.Forms

<div class="d-flex gap-2 mb-3 align-center flex-wrap">
    <label>Open an .xlsx <InputFile accept=".xlsx" OnChange="OpenAsync" /></label>
    <button type="button" @onclick="SaveAsync">Save as .xlsx</button>
    @if (_saved is not null)
    {
        <a href="@_saved" download="workbook.xlsx">Download workbook.xlsx</a>
    }
    <span>@_said</span>
</div>
@if (_report.Count > 0)
{
    <p>Not carried from the file, and lost if it is saved again:</p>
    <ul>
        @foreach (var line in _report)
        {
            <li>@line</li>
        }
    </ul>
}

<ExSheet @ref="_sheet" @bind-Workbook="_workbook" ViewportHeight="280" ViewportWidth="ViewportSize.Stretch" />

@code {
    // The culture typing is read in from here on, and Values are shown in: yours to declare, never the file's.
    private static readonly CultureInfo Culture = CultureInfo.GetCultureInfo("en-US");
    private const string Xlsx = "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet";

    // The longest address Chromium takes, which a data: link is.
    private const int MaxLink = 2 * 1024 * 1024;

    private ExSheet _sheet = default!;
    private WorkbookDocument? _workbook = Expenses.Workbook();
    private string _said = "";
    private List<string> _report = [];
    private string? _saved;

    // The read is handed over still to do, and takes its place in the Sheet's order now: what is typed while
    // the file is read waits, and lands on the Workbook it opens. Escape cancels it while the Sheet says so.
    private async Task OpenAsync(InputFileChangeEventArgs e)
    {
        XlsxOpenResult? read = null;
        try
        {
            var opened = await _sheet.OpenAsync(async token =>
            {
                read = await XlsxWorkbookReader.ReadAsync(e.File.OpenReadStream(10_000_000, token), Culture, null, token);
                return read.Document;
            });
            _said = opened ? $"Opened {e.File.Name}." : "The opening was cancelled; the Workbook is as it was.";
            _report = opened ? ReportLines(read!.Report) : [];
        }
        catch (Exception refused) when (refused is XlsxOpenException or IOException or SheetDocumentException or SheetRefusedException)
        {
            // Nothing opened: a refusal names the Sheet, the cell and what it held; an IOException is a file over the
            // 10,000,000 bytes OpenReadStream allows here; a SheetRefusedException is a cell being edited.
            _said = refused.Message;
            _report = [];
        }
    }

    // What the file held that was not carried, and the cells naming functions ExSheet does not support.
    private static List<string> ReportLines(OpenReport report) =>
    [
        .. report.NotCarried.Select(item => item.Description),
        .. report.UnsupportedFunctions.Select(cell => $"{cell.Sheet}!{cell.Cell} names {string.Join(", ", cell.Functions)}, and shows #NAME?."),
    ];

    // Written from the Workbook as the inputs before the save left it, each Formula with its Value. A browser
    // application hands the bytes to a link; a server would write them to a response or a store.
    private async Task SaveAsync()
    {
        using var file = new MemoryStream();
        try
        {
            await _sheet.SaveAsync(workbook => XlsxWorkbookWriter.WriteAsync(workbook, file).AsTask());
            var link = $"data:{Xlsx};base64,{Convert.ToBase64String(file.ToArray())}";
            // The link carries the file in its address, which Chromium caps at 2 MB: refused by name, not cut short.
            _saved = link.Length <= MaxLink ? link : null;
            _said = _saved is not null
                ? $"Saved {file.Length:N0} bytes."
                : $"Saved {file.Length:N0} bytes, too many for this page's download link, which carries the file in its address: a browser takes at most {MaxLink:N0} characters there, about 1.5 MB of file.";
        }
        catch (Exception refused) when (refused is SheetRefusedException or XlsxSaveException)
        {
            // A cell being edited, or something a file cannot hold, named.
            _saved = null;
            _said = refused.Message;
        }
    }
}
