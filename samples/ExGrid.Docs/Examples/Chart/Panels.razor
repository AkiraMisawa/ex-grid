@using ExChart.Script
@using ExChart.Engine

<ExChart Definition="Definition" Title="Exposure profile" Width="720" Height="420" Legend="Legend" />

@code {
    // EPE and ENE stand in panels of their own, one above the other, sharing the dates. "Before" and
    // "After" are colour keys: the same key is the same colour in both panels.
    private static readonly ChartDefinition Definition = new(ChartAxis.Dates("Date"),
        [.. ChartData.Exposure().Select(s => s.Panel == "" ? s with { Panel = "EPE" } : s)]);

    // The legend sits where the page puts it.
    private static readonly LegendPlacement Legend = new(LegendPosition.Right, LegendAlign.Centre);
}
