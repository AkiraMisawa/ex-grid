@using ExChart
@using ExChart.Script
@using ExChart.Engine

<ExChart @ref="_chart" Definition="Definition" Title="Exposure profile" FileName="exposure-2026-10-30"
         Description="Expected exposure before and after the new trade, monthly over ten years."
         Width="720" Height="360" />
<p><button type="button" @onclick="SavePng">Save as PNG from the page</button></p>

@code {
    private static readonly ChartDefinition Definition = new(ChartAxis.Dates("Date"), ChartData.Exposure().Take(2).ToList());

    private global::ExChart.Script.ExChart? _chart;

    // The toolbar's buttons save CSV, SVG and PNG on one click; a page may call the same method.
    private async Task SavePng()
    {
        if (_chart is not null)
            await _chart.DownloadAsync(ChartFileFormat.Png);
    }
}
