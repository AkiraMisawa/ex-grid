@using ExChart
@using ExChart.Components
@using ExChart.Engine
@using ExChart.MudBlazor

<MudExGridPaper Class="docs-stretch-paper mb-3" Elevation="0" Outlined="true">
    <ExChart Definition="Curve" Title="Yield curve" Width="620" Height="260" Chrome="MudChartChrome.Default" />
</MudExGridPaper>
<MudExGridPaper Class="docs-stretch-paper" Elevation="0" Outlined="true">
    <ExChart Definition="Estimates" Title="Strategies' risk and return" Width="620" Height="300" Chrome="MudChartChrome.Default" />
</MudExGridPaper>

@code {
    private static string Percent(object v) => Convert.ToDecimal(v).ToString("0.00") + "%";

    private static readonly (double Years, decimal Bid, decimal Ask)[] Quotes =
        [(0.25, 3.71m, 3.75m), (0.5, 3.62m, 3.65m), (1, 3.48m, 3.51m), (2, 3.30m, 3.34m), (3, 3.27m, 3.30m),
         (5, 3.31m, 3.35m), (7, 3.42m, 3.47m), (10, 3.55m, 3.61m), (20, 3.81m, 3.90m), (30, 3.86m, 3.98m)];

    // An interval belongs to its series and says what it means. On a Level it is a band or whiskers,
    // an appearance choice: the bounds are the same either way.
    private static readonly ChartDefinition Curve = new(ChartAxis.Numbers("Tenor (years)"),
    [
        ChartSeries.Of("mid", "Mid", SeriesKind.Level, Quotes.Select(q => new ChartPoint(q.Years, (q.Bid + q.Ask) / 2))) with
        {
            FromZero = false,
            Format = Percent,
            Interval = new SeriesInterval("Bid–Ask", [.. Quotes.Select(q => new IntervalBound(q.Years, q.Bid, q.Ask))], IntervalStyle.Band),
        },
    ]);

    // Each strategy's estimated volatility and return, with a bootstrap 95% CI on each: an Observation's
    // bounds are one a row, in its points' order, across and up.
    private static readonly (string Name, decimal Vol, decimal VolLo, decimal VolHi, decimal Ret, decimal RetLo, decimal RetHi)[] Strategies =
    [
        ("Carry", 6.1m, 5.4m, 6.9m, 4.2m, 1.1m, 7.3m), ("Momentum", 11.8m, 10.5m, 13.4m, 6.0m, 0.2m, 11.9m),
        ("Value", 9.4m, 8.3m, 10.6m, 2.9m, -2.0m, 7.8m), ("Low vol", 5.2m, 4.7m, 5.8m, 3.8m, 1.3m, 6.4m),
        ("Trend", 14.6m, 12.9m, 16.5m, 7.1m, -0.1m, 14.3m), ("Short vol", 8.7m, 6.2m, 12.9m, 5.5m, 0.9m, 10.0m),
    ];

    private static readonly ChartDefinition Estimates = new(ChartAxis.Numbers("Volatility (% a year)"),
    [
        ChartSeries.Of("strategies", "Strategies", SeriesKind.Observation, Strategies.Select(s => new ChartPoint((double)s.Vol, s.Ret) { Name = s.Name })) with
        {
            Format = Percent,
            Interval = new SeriesInterval("95% CI", [.. Strategies.Select(s => new IntervalBound((double)s.Vol, s.RetLo, s.RetHi))]),
            XInterval = new SeriesInterval("95% CI", [.. Strategies.Select(s => new IntervalBound((double)s.Vol, s.VolLo, s.VolHi))]),
        },
    ]);
}
