@using ExChart
@using ExChart.Script
@using ExGrid.Chrome

<ExGrid @ref="_bridge.ScriptGrid" TRow="CurveHistory.Row" Rows="CurveHistory.Rows"
        Columns="CurveHistory.Columns" ContextCommands="_commands" ContextCommandLabel="Label"
        PinnedColumnCount="1" ViewportHeight="240" />

<p class="docs-muted">@_refusal</p>
@foreach (var (name, chart) in _charts)
{
    <ExChart Definition="_bridge.Draw(chart)" Title="@name" Width="720" Height="280" OnPointClick="ClickOf(name)" />
}

@code {
    // Held in fields, never rebuilt per render: a new delegate is a changed parameter.
    private static readonly Func<string, string?> Label = GridChartCommands.Label;
    private readonly GridChartBridge<CurveHistory.Row> _bridge = new(CurveHistory.Declarations());
    private Func<ContextMenuContext<CurveHistory.Row>, IEnumerable<GridCommand>> _commands = null!;
    private readonly List<(string Name, GridChart Chart)> _charts = [];
    private readonly Dictionary<string, EventCallback<ChartPointClick>> _clicks = [];
    private string _refusal = "Select some rates and open the context menu.";

    protected override void OnInitialized()
    {
        // The bridge's commands join the grid's context menu in one line; the page shows each chart it is
        // handed, and offers every open chart to "Add to chart".
        _commands = _bridge.Commands;
        _bridge.OnChart = chart => Show($"Chart {_charts.Count + 1}", chart);
        _bridge.OnAdded = (target, chart) => Show(target.Name, chart);
        _bridge.OnRefused = why => { _refusal = why; StateHasChanged(); return Task.CompletedTask; };
    }

    private Task Show(string name, GridChart chart)
    {
        var at = _charts.FindIndex(c => c.Name == name);
        if (at >= 0) _charts[at] = (name, chart);
        else _charts.Add((name, chart));
        _bridge.Targets = _charts.Select(c => new ChartTarget(c.Name, c.Chart)).ToList();
        _refusal = "";
        StateHasChanged();
        return Task.CompletedTask;
    }

    // A click on a point moves the grid's Focus to the cell it was drawn from.
    private EventCallback<ChartPointClick> ClickOf(string name)
    {
        if (!_clicks.TryGetValue(name, out var click))
            _clicks[name] = click = EventCallback.Factory.Create<ChartPointClick>(this,
                c => _bridge.ShowInGridAsync(_charts.First(x => x.Name == name).Chart, c));
        return click;
    }
}
