@page "/figure/pivot-anatomy"
@layout BareLayout
@using System.Globalization
@using SalesData = ExGrid.Docs.Examples.Pivot.Sales
@using global::ExPivot.Components
@using global::ExPivot.Engine

@* The report the ExPivot Overview's figure names the parts of. tools/readme-media/figures.mjs opens
   this page, numbers each part and takes the picture, so the figure is never drawn by hand
   (ADR-0110). Every part the figure names is on screen at once: a report filter, a group row with
   its subtotal at the bottom, a Header Group over two Value Fields, and the grand total. *@
<ShowcaseFrame Title="The parts of a pivot">
    <style>
        .anatomy-page {
            min-height: 100vh;
            padding: 24px;
            box-sizing: border-box;
            background: light-dark(#ffffff, #121418);
        }
        .anatomy-pivot { width: @(Width)px; }
    </style>
    <div class="anatomy-page">
        <div class="anatomy-pivot">
            <ExPivot Source="_source" @bind-Layout="_layout" Culture="Culture" ShowSelectionSummary="false"
                     FieldListWidth="FieldListWidth" ViewportWidth="ViewportSize.Stretch" ViewportHeight="ReportHeight" />
        </div>
    </div>
</ShowcaseFrame>

@code {
    private static readonly CultureInfo Culture = CultureInfo.GetCultureInfo("en-US");

    // The whole pivot, Fields pane included: as wide as the report's columns and the pane, and as
    // tall as the pane, so no scrollbar takes a strip out of the picture. figures.mjs refuses a
    // picture in which either would scroll.
    private const double Width = 722;
    private const double FieldListWidth = 220;
    private static readonly ViewportSize ReportHeight = 604;

    // 2025's sales only: one year's two value columns beside the pane fit a README's width, where
    // the figure is read at the size it was taken.
    private readonly PivotSource _source = PivotSource.From(
        SalesData.Sample().Where(sale => sale.Date.Year == 2025).ToArray(), SalesData.Fields);

    // Europe is open and the other regions are collapsed, so a group row, its Items and its
    // subtotal stand together. With one year, a grand total column would repeat it, so it is
    // left out.
    private PivotLayout _layout = new()
    {
        Filters = [new PivotFieldPlacement("Channel")],
        Rows =
        [
            new PivotFieldPlacement("Region") { Collapsed = true, ToggledItems = [PivotItemKey.Text("Europe")] },
            new PivotFieldPlacement("Country"),
        ],
        Columns = [new PivotFieldPlacement("Year")],
        Values =
        [
            new PivotValueField("Revenue", PivotAggregation.Sum) { NumberFormat = "#,##0" },
            new PivotValueField("Units", PivotAggregation.Sum) { NumberFormat = "#,##0" },
        ],
        SubtotalsAtTop = false,
        GrandTotalColumn = false,
    };
}
