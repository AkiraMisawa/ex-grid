@page "/figure/chart-dock-anatomy"
@layout BareLayout
@using ExChart
@using ExChart.MudBlazor
@using ExGrid.Chrome
@using ExGrid.Docs.Examples.Chart

@* The grid and Chart Dock the ExChart Overview's second figure names the parts of. tools/readme-media/
   figures.mjs opens this page, selects a range and charts it from the grid's context menu as a user
   would, opens the menu again over the Selection, numbers each part and takes the picture, so the figure
   is never drawn by hand (ADR-0110). The Chart Dock stands to the grid's right, never over it (ADR-0258). *@
<ShowcaseFrame Title="The Chart Dock">
    <style>
        .anatomy-page {
            min-height: calc(100vh - var(--docs-banner-height, 0px));
            padding: 24px;
            box-sizing: border-box;
            background: light-dark(#ffffff, #121418);
        }
        .anatomy-dock { display: inline-block; }
    </style>
    <div class="anatomy-page">
        <div class="anatomy-dock">
            <MudChartDock TRow="CurveHistory.Row" Bridge="_bridge" ChartWidth="560" ChartHeight="300">
                <MudExGridPaper Elevation="0" Outlined="true">
                    <ExGrid.Components.ExGrid @ref="_bridge.Grid" TRow="CurveHistory.Row" Window="CurveHistory.Rows" RowKey="CurveHistory.KeyOf"
                            Columns="CurveHistory.Columns" ContextCommands="_commands" CommandLabel="Label"
                            PinnedColumnCount="1" ViewportHeight="GridHeight" ViewportWidth="GridWidth" Chrome="MudChartChrome.GridChrome" />
                </MudExGridPaper>
            </MudChartDock>
        </div>
    </div>
</ShowcaseFrame>

@code {
    // Every row and column of the curve history shows whole: the figure numbers the Selection over all of them.
    private static readonly ViewportSize GridHeight = 372, GridWidth = 392;

    // Held in fields, never rebuilt per render: a new delegate is a changed parameter.
    private static readonly Func<string, string?> Label = GridChartCommands.Label;
    private readonly GridChartBridge<CurveHistory.Row> _bridge = new(CurveHistory.Declarations());
    private Func<ContextMenuContext<CurveHistory.Row>, IEnumerable<GridCommand>> _commands = null!;

    protected override void OnInitialized() => _commands = _bridge.Commands;
}
