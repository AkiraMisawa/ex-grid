@page "/figure/sheet-anatomy"
@layout BareLayout
@using System.Globalization
@using global::ExSheet
@using global::ExSheet.Components
@using global::ExSheet.Engine

@* The Sheet the ExSheet Overview's figure names the parts of. tools/readme-media/figures.mjs opens
   this page, opens the total's Formula with F2 as a user would, numbers each part and takes the
   picture, so the figure is never drawn by hand (ADR-0110). *@
<ShowcaseFrame Title="The parts of a sheet">
    <style>
        .anatomy-page {
            min-height: 100vh;
            padding: 24px;
            box-sizing: border-box;
            background: light-dark(#ffffff, #121418);
        }
        .anatomy-sheet { width: @(Width)px; }
    </style>
    <div class="anatomy-page">
        <div class="anatomy-sheet">
            <ExSheet @bind-Document="_document" ShowToolbar="true" ViewportHeight="ViewportHeight" ViewportWidth="ViewportSize.Stretch">
                <ToolbarContent>
                    <DefaultToolbarRow />
                </ToolbarContent>
            </ExSheet>
        </div>
    </div>
</ShowcaseFrame>

@code {
    private const double Width = 824;
    private static readonly ViewportSize ViewportHeight = 420;

    private SheetDocument _document = Claim();

    // The Examples' expenses claim beside last quarter's. The conference pass is new this quarter, so
    // its change divides by nothing, and shows #DIV/0! as Excel would.
    private static SheetDocument Claim()
    {
        var sheet = new Sheet(CultureInfo.GetCultureInfo("en-US"));
        string[][] rows =
        [
            ["Item", "Qty", "Unit cost", "Amount", "Last quarter", "Change"],
            ["Flights LHR-JFK", "2", "1240", "=B2*C2", "2310", "=D2/E2-1"],
            ["Hotel, nights", "6", "289.5", "=B3*C3", "1447.5", "=D3/E3-1"],
            ["Client dinner", "1", "412.8", "=B4*C4", "530", "=D4/E4-1"],
            ["Taxis", "9", "38.25", "=B5*C5", "298.4", "=D5/E5-1"],
            ["Conference pass", "1", "1650", "=B6*C6", "", "=D6/E6-1"],
            ["Total", "", "", "=SUM(D2:D6)", "=SUM(E2:E6)", "=D7/E7-1"],
        ];
        for (var r = 0; r < rows.Length; r++)
            for (var c = 0; c < rows[r].Length; c++)
                if (rows[r][c].Length > 0)
                    sheet.Enter(new CellAddress(r, c), rows[r][c]);

        // The total's Formula fits its column, so the Cell Editor shows it whole.
        sheet.Do(SheetEdit.SetColumnWidth(CellRange.Parse("A:A"), 16));
        sheet.Do(SheetEdit.SetColumnWidth(CellRange.Parse("D:E"), 12));
        sheet.Do(SheetEdit.SetNumberFormat(CellRange.Parse("C2:E7"), NumberFormat.Parse("#,##0.00")));
        sheet.Do(SheetEdit.SetNumberFormat(CellRange.Parse("F2:F7"), NumberFormat.Parse("0.0%")));
        sheet.Do(SheetEdit.SetCellFormat([CellRange.Parse("A1:F1"), CellRange.Parse("A7:F7")], new CellFormatChange { Bold = true }));
        return sheet.ToDocument();
    }
}
