@using System.Globalization
@implements IDisposable
@inject InspectorTradeStore Store

@* The inspector of /inspector-edits (docs/specs/row-inspectors, page B). It holds a base —
   the trade it shows, at the version it shows — and never changes that under the reader's
   eyes. A change made elsewhere raises a banner and disables the actions until the reader
   reloads; a deletion says so. Every action carries the base's version, and the store
   refuses one decided on a version that is no longer current: the banner informs, the
   store's check guarantees. *@
<div class="demo-inspector-body" data-inspector-key="@_base.Id">
    @if (_pending is { } pending)
    {
        <div class="demo-inspector-banner" role="alert">
            @if (pending.Deleted)
            {
                <span>Deleted elsewhere. Nothing here can act on it.</span>
            }
            else
            {
                <span>Changed elsewhere — notional now @Money(pending.Row!.Notional), status @pending.Row.Status.</span>
                <button class="demo-inspector-reload" @onclick="Reload">Reload</button>
            }
        </div>
    }

    <dl class="demo-inspector-fields">
        <dt>Book</dt><dd>@_base.Book</dd>
        <dt>Trader</dt><dd>@_base.Trader</dd>
        <dt>Notional</dt><dd class="demo-inspector-number demo-inspector-notional">@Money(_base.Notional)</dd>
        <dt>Status</dt><dd class="demo-inspector-status">@_base.Status</dd>
        <dt>Version</dt><dd class="demo-inspector-version">@_base.Version</dd>
    </dl>

    <div class="demo-inspector-actions">
        <button class="demo-inspector-approve" @onclick="Approve"
                disabled="@(_pending is not null || _base.Status == "Approved")">Approve</button>
        <input class="demo-inspector-note-text" placeholder="Note" @bind="_note" disabled="@(_pending is not null)" />
        <button class="demo-inspector-add-note" @onclick="AddNote"
                disabled="@(_pending is not null)">Add note</button>
    </div>

    @if (_refusal is not null)
    {
        <p class="demo-inspector-refusal" role="alert">@_refusal</p>
    }

    @if (_base.Notes.Count > 0)
    {
        <ol class="demo-inspector-history">
            @foreach (var note in _base.Notes)
            {
                <li class="demo-inspector-note">
                    @note.Text
                    @if (note.WrittenAgainstVersion < _base.Version)
                    {
                        <span class="demo-inspector-note-stale">written against version @note.WrittenAgainstVersion</span>
                    }
                </li>
            }
        </ol>
    }
</div>

@code {
    // Who this inspector is, to the store: its own changes come back announced with this
    // origin, and are not someone else's news.
    private readonly Guid _origin = Guid.NewGuid();
    private EditableTrade _base = default!;
    private (bool Deleted, EditableTrade? Row)? _pending;
    private string? _refusal;
    private string _note = "";
    private Action<StoreChange>? _onChanged;
    private Action? _onReset;

    /// <summary>The trade as the grid had it when the inspector opened.</summary>
    [Parameter, EditorRequired] public EditableTrade Row { get; set; } = default!;

    protected override void OnInitialized()
    {
        _base = Row;
        _onChanged = change => _ = InvokeAsync(() => OnChanged(change));
        _onReset = () => { };
        Store.Subscribe(_onChanged, _onReset);
        // Opened from a grid that may already be behind the store: say so at once.
        Compare(Store.Find(_base.Id));
    }

    public void Dispose()
    {
        if (_onChanged is not null && _onReset is not null)
            Store.Unsubscribe(_onChanged, _onReset);
    }

    private void OnChanged(StoreChange change)
    {
        if (change.Old.Id != _base.Id || change.Origin == _origin)
            return;
        Compare(change.Replacement);
        StateHasChanged();
    }

    // News about this trade from anyone else. A value change (a newer version) is held as
    // pending behind the banner; a note appended elsewhere changes no value, and is taken in.
    private void Compare(EditableTrade? current)
    {
        if (current is null)
        {
            _pending = (true, null);
            return;
        }
        if (current.Version > _base.Version)
            _pending = (false, current);
        else if (current.Version == _base.Version && _pending is null)
            _base = current;
    }

    private void Reload()
    {
        if (_pending is { Deleted: false, Row: { } row })
            _base = row;
        _pending = null;
        _refusal = null;
    }

    private void Approve() => Apply(Store.Approve(_base.Id, _base.Version, _origin));

    private void AddNote()
    {
        if (string.IsNullOrWhiteSpace(_note))
            return;
        if (Apply(Store.AddNote(_base.Id, _base.Version, _note.Trim(), _origin)))
            _note = "";
    }

    private bool Apply(StoreAnswer answer)
    {
        if (answer.Applied)
        {
            // Our own change: the answer is the new base, and no banner.
            _base = answer.Row!;
            _refusal = null;
            return true;
        }
        _refusal = answer.Refusal;
        // The refusal carries the news the announcement has not brought yet.
        Compare(answer.Row);
        if (answer.Row is null)
            _pending = (true, null);
        return false;
    }

    private static string Money(decimal value) => value.ToString("N2", CultureInfo.InvariantCulture);
}
