@page "/script-pivot"
@* global::, because this project's namespace nests inside ExGrid (the CS0426 trap in AGENTS.md). *@
@using global::ExGrid.Selection
@using global::ExGrid.Summarizing
@using global::ExPivot
@using global::ExPivot.Chrome
@using global::ExPivot.Components
@using global::ExPivot.Engine
@using global::ExPivot.MudBlazor

@* ?chrome=mud hands the pivot MudPivotChrome (ADR-0410): its menus, its Pivot Toolbar and its Stale Report's notice,
   and the report grid's menus, panels and loading bar, are MudBlazor's, drawn in .NET and moved into the Script
   Core's slots. *@
<DemoChromeAssets Name="@(DemoChrome.IsMud(ChromeName) ? "mud" : "builtin")">
    <Head>
        <ExPivotStylesheet />
        @if (DemoChrome.IsMud(ChromeName))
        {
            <MudExPivotStylesheet />
        }
    </Head>
</DemoChromeAssets>

<DemoNav />

<h1>ExPivot over the Script Core</h1>

<p>
    The pivot below is <code>ExPivot.Components.ExPivot</code>: Blazor's Framework Adapter over
    <code>@@ex-grid/pivot</code> (ADR-0370 section 1). The report, the PivotTable Fields pane and the
    Pivot Toolbar are the Script Core's, in the browser, on both hosting models. The 2,000 trades stay in
    .NET behind <code>PivotSource.From</code>, which answers each question the report asks with its Leaf
    Aggregates, as PivotJson; the engine in the browser builds the report and its totals from them.
</p>

<div class="demo-toolbar">
    <button id="script-pivot-reset" @onclick="Reset">Reset the layout</button>
    <button id="script-pivot-revalue" @onclick="Revalue">Revalue the trades by +1%</button>
    <button id="script-pivot-japanese" @onclick="ToggleJapanese">@(_japanese ? "English words" : "Japanese words")</button>
    <label><input id="script-pivot-take-details" type="checkbox" @bind="_takeDetails" /> Take Show Details in .NET</label>
</div>

<p class="demo-status">
    <span id="script-pivot-layout" role="status">Rows: @string.Join(", ", _layout.Rows.Select(row => row.Field))</span><br />
    <span id="script-pivot-field-list" role="status">Field List shown: @_showFieldList</span><br />
    <span id="script-pivot-details" role="status">@_details</span><br />
    <span id="script-pivot-selection" role="status">@_selection</span><br />
    <span id="script-pivot-summary" role="status">@_summary</span>
</p>

<ExPivot.Components.ExPivot Source="_source"
                        @bind-Layout="_layout"
                        @bind-ShowFieldList="_showFieldList"
                        Label="@(_japanese ? PivotWords.Japanese : null)"
                        DetailsView="@(DetailsQuery == "dialog" ? PivotDetailsView.Dialog : null)"
                        OnShowDetails="@(_takeDetails ? _showDetails : default)"
                        SelectionChanged="ShowSelection"
                        OnSelectionSummaryChanged="ShowSummary"
                        Chrome="@(DemoChrome.IsMud(ChromeName) ? MudPivotChrome.Default : null)"
                        ViewportHeight="420" />

@code {
    private PivotSource _source = PivotSource.From(DemoPivotData.Trades(), DemoPivotData.Fields);
    // Held, and handed in again by Reset: the same layout the pivot started from replaces the user's changes.
    private static readonly PivotLayout First = DemoPivotData.FirstLayout();
    private PivotLayout _layout = First;
    private bool _showFieldList = true;
    private decimal _revaluation = 1m;
    private bool _japanese;
    private bool _takeDetails;
    // `?details=dotnet` opens the page with the records taken in .NET, so a double click is never taken against a
    // handler on its way to the browser; `?details=dialog` shows them in the pivot's dialog in place of a tab.
    [SupplyParameterFromQuery(Name = "details")] public string? DetailsQuery { get; set; }
    // `?chrome=mud` dresses the pivot in MudPivotChrome; read as the pivot attaches.
    [SupplyParameterFromQuery(Name = "chrome")] public string? ChromeName { get; set; }
    private string _details = "";
    private EventCallback<PivotDetails> _showDetails;

    protected override void OnInitialized()
    {
        _showDetails = EventCallback.Factory.Create<PivotDetails>(this, ShowDetailsAsync);
        _takeDetails = DetailsQuery == "dotnet";
    }

    // The words of Excel's Japanese edition, asked of PivotWords.Japanese in .NET for each id the pivot paints.
    private void ToggleJapanese() => _japanese = !_japanese;

    // The records behind the cell, taken here: the pivot opens no tab, and the page says what it was handed.
    private async Task ShowDetailsAsync(PivotDetails details)
    {
        var page = await details.DetailsAsync(0, 1);
        _details = page.IsRefused ? $"{details.Title}: refused" : $"{details.Title}: {page.Total} records";
    }

    // The report's Selection as .NET heard it, in the report grid's rows and columns. Never empty: a line that
    // appeared with the first report would move the pivot down between the two clicks of a double click.
    private string _selection = "Nothing selected";

    private void ShowSelection(GridSelection selection) => _selection = selection.IsEmpty
        ? "Nothing selected"
        : $"Focus: row {selection.Focus.Row}, column {selection.Focus.Column}; {selection.Ranges.Count} range(s)";

    // The Selection Summary as .NET heard it (ADR-0130): the sum the strip shows, in the text the pivot wrote it in
    // the Focus value's number format. Never empty, for the reason the Selection's line is not.
    private string _summary = "No summary";

    private void ShowSummary(SelectionSummary summary) => _summary = summary switch
    {
        { Status: SelectionSummaryStatus.Answered, Result: { } result } => result.TextOf(SummaryFigures.Sum) is { } text
            ? $"Sum: {text}"
            : "Sum: no text, as the Focus value has no number format",
        _ => $"No summary ({summary.Status})",
    };

    // A layout of the page's own making replaces the one on screen.
    private void Reset() => _layout = First;

    // A new source is a refresh: the report asks it again, and the values it changed are marked.
    private void Revalue()
    {
        _revaluation *= 1.01m;
        _source = PivotSource.From(DemoPivotData.Trades(_revaluation), DemoPivotData.Fields);
    }
}
