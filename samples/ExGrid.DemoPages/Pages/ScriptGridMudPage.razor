@page "/script-grid-mud"
@using global::ExGrid.MudBlazor
@using global::MudBlazor

@* The Wrapper's stylesheets and font, loaded by this page alone, as /mud loads them. *@
<HeadContent>
    <link href="_content/ExGrid.DemoPages/fonts/roboto/roboto.css" rel="stylesheet" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <MudExGridStylesheet />
</HeadContent>

<MudThemeProvider />

<DemoNav />

<h1>ExGrid.MudBlazor over the Script Core</h1>

<p>
    The grid below is <code>ExGrid.Script.ExGrid</code> handed <code>MudGridChrome</code> (ADR-0410): its
    column menu, its filter panel, its Context Menu and its loading bar are MudBlazor's components, rendered in
    .NET beside the grid and moved into the Script Core's slots by the adapter's script, which wires each control
    in the browser. A key on a menu item, a value ticked or a condition typed never waits on the circuit. Book
    filters by its values, Notional by conditions. The other parts are still the Script Core's own.
</p>

<ExGrid.Script.ExGrid TRow="DemoTrade"
                     Rows="_rows"
                     Columns="Columns"
                     ViewportHeight="280"
                     ViewportWidth="640"
                     Chrome="MudGridChrome.Default"
                     OnColumnHidden="OnColumnHidden" />

<p><span id="script-mud-hidden" role="status">Hidden: @_hidden</span></p>

@code {
    private static readonly GridColumn<DemoTrade>[] Columns =
    [
        new("Book", ColumnType.Text, r => r.Book, filterUi: global::ExGrid.Chrome.FilterUiMode.ValueList),
        new("Trader", ColumnType.Text, r => r.Trader),
        new("Notional", ColumnType.Number, r => r.Notional),
    ];

    private readonly IReadOnlyList<DemoTrade> _rows = DemoData.Window(200, 11);
    private string _hidden = "none";

    private void OnColumnHidden(string column) => _hidden = column;
}
