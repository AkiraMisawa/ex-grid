@page "/script-grid-mud"
@using global::ExGrid.MudBlazor
@using global::MudBlazor

@* The Wrapper's stylesheets and font, loaded by this page alone, as /mud loads them. *@
<HeadContent>
    <link href="_content/ExGrid.DemoPages/fonts/roboto/roboto.css" rel="stylesheet" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <MudExGridStylesheet />
</HeadContent>

<MudThemeProvider />

<DemoNav />

<h1>ExGrid.MudBlazor over the Script Core</h1>

<p>
    The grid below is <code>ExGrid.Script.ExGrid</code> handed <code>MudGridChrome</code> (ADR-0410): its
    column menu, its filter panel, its find panel, its Context Menu, its loading bar, its Cell Editor and the Formula
    Bar's two fields are MudBlazor's,
    rendered in .NET beside the grid and moved into the Script Core's slots by the adapter's script, which wires
    each control in the browser. A key on a menu item, a value ticked, a condition, a search or a Trader typed never
    waits on the circuit. Book filters by its values, Notional by conditions, Ctrl+F asks the rows' source in .NET,
    and Trader is editable, offering the desk's traders whose names begin with what is typed in a MudBlazor list. Note
    is a Template Column whose field is drawn in .NET from each trade, and Space enters it. The
    other parts are still the Script Core's own. It stands in a striped <code>MudExGridPaper</code>, whose Roboto
    widths, Density and Row Stripes the grid takes as the C# core's does (ADR-0030).
</p>

@* The Note template's control takes the keyboard through this grid (ADR-0204): held once, so the cascade never
   changes. *@
<CascadingValue Name="TakeKeyboard" Value="TakeKeyboard" IsFixed="true">
<MudExGridPaper Striped="true">
    <ExGrid.Script.ExGrid TRow="DemoTrade" @ref="_grid"
                         Rows="_rows"
                         Columns="Columns"
                         ViewportHeight="310"
                         ShowFormulaBar="true"
                         ViewportWidth="640"
                         Chrome="MudGridChrome.Default"
                         OnColumnHidden="OnColumnHidden"
                         OnEdit="OnEdit"
                         OnNameBoxEntered="OnNameBoxEntered"
                         CompleteEditorText="CompleteTrader" />
</MudExGridPaper>
</CascadingValue>

<p><span id="script-mud-hidden" role="status">Hidden: @_hidden</span></p>
<p><span id="script-mud-edited" role="status">Edited: @_edited</span></p>
<p><span id="script-mud-named" role="status">Named: @_named</span></p>

@code {
    // Held before the columns that use it: a static field is set in the order it is written.
    private static readonly RenderFragment<TemplateCellContext<DemoTrade>> NoteTemplate = cell => @<TradeNoteInput Cell="cell" />;

    private static readonly GridColumn<DemoTrade>[] Columns =
    [
        new("Book", ColumnType.Text, r => r.Book, filterUi: global::ExGrid.Chrome.FilterUiMode.ValueList),
        new("Trader", ColumnType.Text, r => r.Trader, editable: true),
        new("Notional", ColumnType.Number, r => r.Notional),
        // Each cell drawn in .NET from the trade and moved into the cell by the script (ADR-0410 section 6); the value
        // beside it is still what sorts, filters and copies (ADR-0020).
        GridColumn<DemoTrade>.TemplateColumn("Note", ColumnType.Text, r => r.Book, NoteTemplate,
            width: new ColumnWidthSpec(ColumnWidth.Fixed(140))),
    ];

    private global::ExGrid.Script.ExGrid<DemoTrade>? _grid;
    private Func<ElementReference, Task>? _takeKeyboard;

    // A template's control takes the keyboard through the grid, which grants it only while the keyboard is still the
    // grid's (ADR-0204); before the grid is there, the control's own focus.
    private Func<ElementReference, Task> TakeKeyboard => _takeKeyboard ??=
        control => _grid is { } grid ? grid.HandKeyboardToAsync(control) : control.FocusAsync().AsTask();

    private readonly IReadOnlyList<DemoTrade> _rows = DemoData.Window(200, 11);
    private string _hidden = "none";

    private string _edited = "none";

    private string _named = "none";

    private void OnColumnHidden(string column) => _hidden = column;

    // What the editor committed, as the core read it from MudBlazor's field in the browser.
    private void OnEdit(GridEditIntent<DemoTrade> intent) => _edited = $"{intent.Column} = {intent.Value}";

    private static readonly string[] Desk = ["Ito", "Marsh", "Martens", "Mira Holt", "Okafor", "Petrov", "Silva"];

    // The desk's traders whose names begin with the text, each replacing it whole. The grid knows no trader: what is
    // offered and what accepting it writes are the page's (ADR-0051).
    private static ValueTask<EditorCompletion?> CompleteTrader(string text, int caret)
    {
        if (text.Length == 0)
            return ValueTask.FromResult<EditorCompletion?>(null);
        var candidates = Desk.Where(name => name.StartsWith(text, StringComparison.OrdinalIgnoreCase))
            .Select(name => new CompletionCandidate(name, 0, text.Length, name)).ToList();
        return ValueTask.FromResult<EditorCompletion?>(candidates.Count == 0 ? null : new EditorCompletion(candidates));
    }

    // What was typed in MudBlazor's Name Box as Enter was pressed there; resolving it is the Consumer's (ADR-0051).
    private void OnNameBoxEntered(string typed) => _named = typed;
}
