@page "/wide"
@implements IDisposable
@using System.Globalization

<DemoNav />

<h1>Wide — @_total.ToString("N0", CultureInfo.InvariantCulture) rows × 100 columns</h1>

<p>
    Both axes are virtualised (ADR-0004): only the rows and the columns the Viewport
    reaches are in the DOM, and the first two columns are pinned, so they stay against
    the left edge while the rest pans under them. Unvirtualised this page is the
    2,000-cell case ADR-0004 measured as unpaintable at 60fps — the button turns
    horizontal virtualisation off so the two can be compared on the same data.
</p>

<div class="demo-toolbar">
    <button id="toggle-virtualise" @onclick="ToggleVirtualise">
        Horizontal virtualisation: @(_virtualiseColumns ? "on" : "off") — turn it @(_virtualiseColumns ? "off" : "on")
    </button>
    <button id="toggle-pinned" @onclick="TogglePinned">
        Pinned columns: @_pinnedColumnCount — @(_pinnedColumnCount == 0 ? "pin two" : "unpin")
    </button>
</div>

<p class="demo-status">
    Window: rows @_source.WindowStart–@(_source.WindowStart + _source.Window.Count - 1) of @_total,
    @DemoData.WideColumns.Length columns.
    <span id="selection-status">
        @* The count is the sum of the rectangles' areas, so it costs nothing to show for
           a selection of any size — no data is needed to compute it (ADR-0014). *@
        Selected: @_selection.CellCount @(_selection.Ranges.Count > 1 ? $"in {_selection.Ranges.Count} ranges" : "")
    </span>
</p>

<ExGrid TRow="DemoWideRow"
        Source="_source"
        Columns="DemoData.WideColumns"
        RowHeight="28"
        ViewportHeight="600"
        ViewportWidth="900"
        PinnedColumnCount="_pinnedColumnCount"
        VirtualiseColumns="_virtualiseColumns"
        HideColumnMenu="true"
        SelectionChanged="OnSelectionChanged" />

@code {
    /// <summary>The Definition of Done's large-data scenario (§12): a million rows. At
    /// 28px that is 28,000,000px of scroll height, inside the scale-1 Layout Ceiling of 33,554,428px (BIG-4, ADR-0053).</summary>
    private const int DefaultTotal = 1_000_000;

    /// <summary>The same page at another row count, for the criteria that compare one
    /// Viewport across several (VZ-1 at 10³, 10⁵ and 10⁶; BIG-2). Passed through as
    /// written: a count the grid cannot take is refused by the grid, by name.</summary>
    [SupplyParameterFromQuery(Name = "rows")]
    public int? Rows { get; set; }

    private int _total = -1;

    /// <summary>Rows either side of the Viewport to answer with, so ordinary scrolling
    /// does not ask again immediately (ADR-0001: read-ahead belongs to the Consumer).</summary>
    private const int ReadAhead = 60;

    /// <summary>Made the first time a range asks for them, and kept: a row answered twice
    /// is the same instance both times, so the rows that survive a scroll keep their
    /// identity and skip their render (ADR-0003). Nothing is made for rows nobody
    /// scrolled to — a million up front would be most of what this page costs to open.</summary>
    private DemoWideRow?[] _rows = [];

    private FetchingGridSource<DemoWideRow> _source = default!;

    private bool _virtualiseColumns = true;
    private int _pinnedColumnCount = 2;
    private GridSelection _selection = GridSelection.Empty;

    protected override void OnParametersSet()
    {
        var total = Rows ?? DefaultTotal;
        if (total == _total)
            return;

        _total = total;
        _rows = new DemoWideRow?[Math.Max(0, total)];
        if (_source is not null)
        {
            _source.StateChanged -= OnSourceChanged;
            _source.Dispose();
        }
        _source = GridSource.Fetch<DemoWideRow>(AnswerAsync, readAheadRows: ReadAhead, rowKey: Key);
        _source.StateChanged += OnSourceChanged;
    }

    private static readonly Func<DemoWideRow, object> Key = row => row.Index;

    // Answered on the spot rather than after a delay: this page is here to compare frame
    // times across the two settings, and a fake latency would be the thing being timed.
    // The Virtualised page shows the waiting case.
    private ValueTask<GridPage<DemoWideRow>> AnswerAsync(GridQuery query, CancellationToken cancellationToken)
    {
        if (query.Sorts.Count > 0 || query.Filter is not null)
            throw new NotSupportedException("The Wide page neither sorts nor filters: none of its columns is queryable.");
        var rows = _rows;
        var start = Math.Min(query.Range.Start, rows.Length);
        var end = Math.Min(rows.Length, query.Range.Start + query.Range.Count);
        var window = new DemoWideRow[end - start];
        for (var i = 0; i < window.Length; i++)
            window[i] = rows[start + i] ??= new DemoWideRow { Index = start + i };
        return ValueTask.FromResult(new GridPage<DemoWideRow>(window, start, rows.Length));
    }

    private void OnSourceChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        _source.StateChanged -= OnSourceChanged;
        _source.Dispose();
    }

    private void OnSelectionChanged(GridSelection selection) => _selection = selection;

    private void ToggleVirtualise() => _virtualiseColumns = !_virtualiseColumns;

    private void TogglePinned() => _pinnedColumnCount = _pinnedColumnCount == 0 ? 2 : 0;
}
