@page "/pivot-csv"
@implements IDisposable
@using System.Diagnostics
@using System.Globalization
@using Microsoft.AspNetCore.Components.Forms
@* global::, because this project's namespace nests inside ExGrid (the CS0426 trap in AGENTS.md). *@
@using global::ExGrid.Chrome
@using global::ExGrid.Data
@using global::ExGrid.MudBlazor
@using global::ExPivot
@using global::ExPivot.Chrome
@using global::ExPivot.Components
@using global::ExPivot.Engine
@using global::ExPivot.MudBlazor

@* ?chrome=mud stands the pivot on ExGrid.MudBlazor's paper, dressed by ExPivot.MudBlazor's Chrome,
   as /pivot does (ADR-0061). The page's own controls are plain HTML under either. *@
<DemoChromeAssets Name="@ChromeName" Paper="true">
    <Head>
        <link href="_content/ExPivot/ex-pivot.css" rel="stylesheet" />
        @if (DemoChrome.IsMud(ChromeName))
        {
            <link href="_content/ExPivot.MudBlazor/mud-ex-pivot.css" rel="stylesheet" />
        }
    </Head>
</DemoChromeAssets>

<DemoNav />

<h1>Pivot over a CSV — a file read under a Schema</h1>

<p>
    <strong>The use case:</strong> a file the user brings, pivoted in the page. A CSV is read
    straight into a Snapshot's columns under a Schema, which says what each column is and how to
    read it; nothing is guessed, because a guess reads the account number <code>004417</code> as
    the number 4,417 (ADR-0063). A file the application knows is read under the Schema it declares.
    A file nobody has described gets a Schema suggested from its first rows, with every column
    whose reading is not clear marked, and is read under it only once the user confirms it.
</p>
<p>
    The file is read in slices that yield between them, so the page paints its progress and
    Cancel stops it. A value its column cannot read refuses the whole file, naming the row and the
    column: a report over the rows that could be read would be quietly short. Only a file read
    whole is pivoted.
</p>

<h2>A file this application knows: the trade export, under its declared Schema</h2>
<div class="demo-toolbar">
    @* #region The code: input *@
    <label>Choose a trade export <InputFile id="csv-file" accept=".csv,.txt" OnChange="ChooseExportAsync" disabled="@Busy" /></label>
    @* #endregion *@
</div>
<div class="demo-toolbar">
    <span>Or a sample, written in memory from /pivot's trades:</span>
    <button id="csv-sample" disabled="@Busy" @onclick="() => ReadSampleAsync(DemoPivotData.Count, malformed: false)">2,000 trades</button>
    <button id="csv-sample-large" disabled="@Busy" @onclick="() => ReadSampleAsync(LargeSample, malformed: false)">100,000 trades</button>
    <button id="csv-sample-malformed" disabled="@Busy" @onclick="() => ReadSampleAsync(DemoPivotData.Count, malformed: true)">2,000 trades, row @DemoCsv.MalformedRow.ToString("N0", Culture) malformed</button>
</div>

<h2>A file nobody has described: a suggested Schema, read under once you confirm it</h2>
<div class="demo-toolbar">
    <label>Choose any CSV <InputFile id="csv-unknown-file" accept=".csv,.txt,.tsv" OnChange="ChooseUnknownAsync" disabled="@Busy" /></label>
</div>
<div class="demo-toolbar">
    <span>Or a sample:</span>
    <button id="csv-unknown-sample" disabled="@Busy" @onclick="SuggestSampleAsync">the trades as a spreadsheet set to German saves them</button>
</div>

@if (_pending is { } pending)
{
    var suggestion = pending.Suggestion;
    <section id="csv-suggestion" aria-labelledby="csv-suggestion-title">
        <h3 id="csv-suggestion-title">The Schema suggested for @pending.Name</h3>
        <p id="csv-suggestion-file">
            From its first @suggestion.SampledRows.ToString("N0", Culture) rows:
            @SeparatorName(suggestion.Schema.Separator) between fields,
            @(suggestion.Schema.HasHeader ? "a header row first" : "no header row"),
            @suggestion.Schema.Encoding.Name.
            @foreach (var mark in suggestion.Marks)
            {
                <span class="demo-mark">@mark.Note</span>
            }
        </p>
        <table class="demo-table">
            <thead>
                <tr><th>Column</th><th>Kind</th><th>Read as</th><th>Examples</th><th>Not clear</th></tr>
            </thead>
            <tbody>
                @for (var i = 0; i < suggestion.Columns.Count; i++)
                {
                    var index = i;
                    var column = suggestion.Columns[i];
                    <tr data-column="@column.Column.Name">
                        <td>@column.Column.Name</td>
                        <td>
                            <select aria-label="@($"Kind of {column.Column.Name}")" value="@_kinds[index]"
                                    @onchange="e => _kinds[index] = Enum.Parse<SnapshotKind>((string)e.Value!)">
                                @foreach (var kind in Enum.GetValues<SnapshotKind>())
                                {
                                    <option value="@kind">@kind</option>
                                }
                            </select>
                        </td>
                        <td>@ReadAs(column.Column)</td>
                        <td>@string.Join("  ", column.Examples)</td>
                        <td>@string.Join(" ", column.Marks.Select(m => m.Note))</td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="demo-toolbar">
            <button id="csv-confirm" disabled="@Busy" @onclick="ConfirmAsync">Read the file under this Schema</button>
            <button id="csv-discard" @onclick="Discard">Discard</button>
        </div>
    </section>
}

<h2>Reading</h2>
<div class="demo-toolbar">
    <progress id="csv-progress" max="@ProgressMax" value="@ProgressValue"></progress>
    <span id="csv-read" class="demo-status">@ReadText</span>
    <button id="csv-cancel" disabled="@(_reading is null)" @onclick="Cancel">Cancel</button>
</div>
<p class="demo-status"><span id="csv-status" role="status">@_status</span></p>
<p id="csv-refusal" class="demo-refusal" role="alert">@_refusal</p>

@if (_source is { } source)
{
    <p id="csv-shown">The report shows @_shown</p>
    @if (DemoChrome.IsMud(ChromeName))
    {
        <MudExGridPaper Elevation="1" Class="demo-stretch-paper">@Pivot(source)</MudExGridPaper>
    }
    else
    {
        @Pivot(source)
    }
}

