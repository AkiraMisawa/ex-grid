@code {
    /// <summary>A file waiting for the user to confirm the Schema suggested for it.</summary>
    private sealed record PendingFile(string Name, long Size, Func<CancellationToken, Stream> Open, CsvSuggestion Suggestion);

    private const int LargeSample = 100_000;

    private PivotLayout _layout = new();
    private string _shown = "";
    private CancellationTokenSource? _reading;
    private long _size;
    private long _rows;
    private long _bytes;
    private string _status = "Choose a file, or a sample.";
    private string? _refusal;
    private PendingFile? _pending;
    private SnapshotKind[] _kinds = [];
    private IGridChrome? _gridChrome;
    private IPivotChrome? _pivotChrome;

    [SupplyParameterFromQuery(Name = "chrome")]
    public string? ChromeName { get; set; }

    private static CultureInfo Culture => CultureInfo.GetCultureInfo("en-US");

    protected override void OnParametersSet()
    {
        // The report grid takes ExPivot.MudBlazor's grid Chrome through the pivot Chrome
        // (DemoChrome refuses any other name).
        _gridChrome = DemoChrome.IsMud(ChromeName) ? null : DemoChrome.From(ChromeName);
        _pivotChrome = DemoChrome.IsMud(ChromeName) ? MudPivotChrome.Default : null;
    }

    #region The code: choose
    // Blazor's InputFile refuses a stream past 512,000 bytes unless it is told otherwise. A million
    // trades make a file of about 90 MB, and on the Server host every byte of it reaches the
    // circuit over its WebSocket, so the cap is raised here deliberately: to what this page means
    // to read, and no further.
    private const long MaxFileSize = 256L * 1024 * 1024;

    private Task ChooseExportAsync(InputFileChangeEventArgs e)
        => ReadAsync(e.File.Name, e.File.Size, token => e.File.OpenReadStream(MaxFileSize, token),
            DemoCsv.TradeExport, DemoCsv.TradeFields, DemoPivotData.FirstLayout(), "under the declared Schema");

    private Task ChooseUnknownAsync(InputFileChangeEventArgs e)
        => SuggestAsync(e.File.Name, e.File.Size, token => e.File.OpenReadStream(MaxFileSize, token));
    #endregion

    #region The code: read
    private PivotSource? _source;

    // Read in slices that yield between them: the page paints the progress, and Cancel stops the
    // read at the next slice. A value a column cannot read refuses the whole file, by name. While
    // a file is read, nothing else can be chosen (Busy).
    private async Task ReadAsync(string name, long size, Func<CancellationToken, Stream> open,
        CsvSchema schema, IReadOnlyList<PivotField>? fields, PivotLayout layout, string how)
    {
        using var reading = new CancellationTokenSource();
        _reading = reading;
        _source = null;
        _refusal = null;
        (_size, _rows, _bytes) = (size, 0, 0);
        _status = $"Reading {name} {how}…";
        // Told after every slice. The bytes are counted while the file is read; the last report,
        // made once the columns are finished, counts the rows alone.
        var progress = new Progress<SnapshotProgress>(p =>
        {
            _rows = p.Rows;
            _bytes = p.Bytes ?? _bytes;
            StateHasChanged();
        });
        var clock = Stopwatch.StartNew();
        try
        {
            await using var stream = open(reading.Token);
            var snapshot = await schema.ReadAsync(stream, new SnapshotLoadOptions { Progress = progress }, reading.Token);
            // The fields over its columns; with none declared, one field per column.
            _source = PivotSource.From(snapshot, fields);
            _layout = layout;
            _shown = $"{name}: {snapshot.RowCount.ToString("N0", Culture)} rows, read {how}.";
            _status = $"{name}: {snapshot.RowCount.ToString("N0", Culture)} rows read in {clock.Elapsed.TotalSeconds.ToString("N1", Culture)} s.";
        }
        catch (SnapshotException refused)
        {
            // "Row 1,234, column 'Notional': '1,250,00O.00' is not a number (line 1,235)."
            _refusal = refused.Message;
            _status = $"{name} was refused: nothing was read.";
        }
        catch (OperationCanceledException) when (reading.IsCancellationRequested)
        {
            _status = $"Cancelled after {_rows.ToString("N0", Culture)} rows: nothing was read.";
        }
        catch (IOException failed)
        {
            // The browser could not hand the file over, or it is larger than MaxFileSize.
            _refusal = failed.Message;
            _status = $"{name} could not be read: nothing was read.";
        }
        finally
        {
            _reading = null;
        }
    }

    private bool Busy => _reading is not null;

    private void Cancel() => _reading?.Cancel();

    // Keyed by its source: another file is another report, which opens with the layout read with it.
    private RenderFragment Pivot(PivotSource source) => @<ExPivot @key="source" Source="source" @bind-Layout="_layout"
                                                                   PivotChrome="_pivotChrome" Chrome="_gridChrome"
                                                                   Culture="Culture" ViewportHeight="420" />;
    #endregion

    #region The code: suggest
    // A file nobody has described: a Schema is suggested from its first rows, with every column
    // whose reading is not clear marked. It is a proposal: the file is read under it, or under the
    // kinds the user changed, only once they confirm.
    private async Task SuggestAsync(string name, long size, Func<CancellationToken, Stream> open)
    {
        Discard();
        try
        {
            await using var stream = open(CancellationToken.None);
            var suggestion = await CsvSchema.SuggestAsync(stream, new CsvSuggestionOptions { Culture = Culture });
            _pending = new PendingFile(name, size, open, suggestion);
            _kinds = [.. suggestion.Schema.Columns.Select(column => column.Kind)];
            _status = $"A Schema is suggested for {name}: confirm it to read the file.";
        }
        catch (SnapshotException refused)
        {
            _refusal = refused.Message;
            _status = $"No Schema can be suggested for {name}.";
        }
    }

    private Task ConfirmAsync()
    {
        if (_pending is not { } pending)
            return Task.CompletedTask;
        _pending = null;
        var suggested = pending.Suggestion.Schema;
        var confirmed = suggested with { Columns = [.. suggested.Columns.Select((column, i) => column with { Kind = _kinds[i] })] };
        return ReadAsync(pending.Name, pending.Size, pending.Open, confirmed, fields: null, new PivotLayout(), "under the confirmed Schema");
    }
    #endregion

    private void Discard()
    {
        _pending = null;
        _refusal = null;
    }

    private async Task ReadSampleAsync(int trades, bool malformed)
    {
        var name = malformed ? "trades-malformed.csv" : $"trades-{trades}.csv";
        _status = $"Writing {name}…";
        // Lets the page paint the line above before the sample is written.
        await Task.Delay(1);
        var bytes = DemoCsv.TradeExportFile(trades, malformed);
        await ReadAsync(name, bytes.Length, _ => new MemoryStream(bytes, writable: false),
            DemoCsv.TradeExport, DemoCsv.TradeFields, DemoPivotData.FirstLayout(), "under the declared Schema");
    }

    private Task SuggestSampleAsync()
    {
        var bytes = DemoCsv.SpreadsheetFile(DemoPivotData.Count);
        return SuggestAsync("trades-de.csv", bytes.Length, _ => new MemoryStream(bytes, writable: false));
    }

    private long ProgressMax => Math.Max(1, _size);

    private long ProgressValue => Math.Min(ProgressMax, _bytes);

    private string ReadText => _size == 0
        ? ""
        : $"{_rows.ToString("N0", Culture)} rows, {Megabytes(_bytes)} of {Megabytes(_size)} MB";

    private static string Megabytes(long bytes) => (bytes / 1_048_576d).ToString("N1", Culture);

    private static string SeparatorName(CsvSeparator separator) => separator switch
    {
        CsvSeparator.Tab => "a tab",
        CsvSeparator.Semicolon => "a semicolon",
        _ => "a comma",
    };

    // How the column's text is read, in words: what the table shows beside its kind.
    private static string ReadAs(CsvColumn column)
    {
        var how = column.Kind switch
        {
            SnapshotKind.Decimal or SnapshotKind.Double =>
                $"decimal point '{column.DecimalPoint ?? "."}'"
                + (string.IsNullOrEmpty(column.ThousandsSeparator) ? "" : $", thousands '{column.ThousandsSeparator}'"),
            SnapshotKind.Integer => "whole numbers",
            SnapshotKind.Date => "dates: " + string.Join(", ", column.DateFormats ?? CsvColumn.IsoDateFormats),
            SnapshotKind.Boolean => string.Join("/", column.TrueText ?? CsvColumn.ExcelTrue) + " or " + string.Join("/", column.FalseText ?? CsvColumn.ExcelFalse),
            _ => "as written",
        };
        return column.BlankText is { Count: > 0 } blanks ? $"{how}; blank: {string.Join(", ", blanks)}" : how;
    }

    public void Dispose() => _reading?.Cancel();
}
