@page "/pivot"
@using System.Diagnostics
@using System.Globalization
@* global::, because this project's namespace nests inside ExGrid (the CS0426 trap in AGENTS.md). *@
@using global::ExPivot
@using global::ExPivot.Chrome
@using global::ExPivot.Components
@using global::ExPivot.Engine
@using global::ExPivot.MudBlazor
@using global::ExGrid.Chrome
@using global::ExGrid.MudBlazor

@* ?chrome=mud stands the pivot on ExGrid.MudBlazor's paper, dressed by ExPivot.MudBlazor's Chrome
   with both Wrappers' stylesheets (ADR-0062); absent or builtin is ExPivot's own markup. The
   browser tests run the page under both, because swapping the Chrome must change no behaviour
   (ADR-0061). ?details=dialog opens Show Details in a dialog, and ?details=page hands the records to
   this page, which lists them under the pivot; absent, they open in a tab at the report's foot
   (ADR-0059). ?words=ja speaks Excel's Japanese edition's words (ADR-0060). *@
<DemoChromeAssets Name="@ChromeName" Paper="true" Dark="_dark">
    <Head>
        <link href="_content/ExPivot/ex-pivot.css" rel="stylesheet" />
        @if (DemoChrome.IsMud(ChromeName))
        {
            <link href="_content/ExPivot.MudBlazor/mud-ex-pivot.css" rel="stylesheet" />
        }
    </Head>
</DemoChromeAssets>

<DemoNav />

<h1>Pivot — ExPivot drawn by ExGrid</h1>

<p>
    <strong>The use case:</strong> records the application already holds in memory, pivoted as
    Excel's PivotTable pivots them (ADR-0059). Here, 2,000 invented trades. Each field is declared
    once with <code>PivotFields.Of&lt;DemoPivotTrade&gt;()</code>, a typed accessor that boxes no
    value, and Month is not a property of the trade: it is declared as the month of the trade date,
    labelled Jan to Dec and ordered by the calendar (ADR-0060). <code>PivotSource.From</code> reads
    the trades once into a Snapshot and answers every question from it (ADR-0064, ADR-0066).
</p>

<p><code>?trades=1000000</code> pivots a million of the trades instead of 2,000, or any other count.</p>

<p>
    Tick fields in the PivotTable Fields pane, or drag them between Filters, Columns, Rows and
    Values; each placed field has Excel's menu, with Filter…, Field Settings… and Value Field
    Settings…, and Defer Layout Update holds the pane's changes until Update (ADR-0061). The Pivot
    Toolbar above the report holds the report filter band, Excel's Layout menu and the pane's
    toggle. The report is one ExGrid: select, copy, and press the <code>−</code> and <code>+</code>
    buttons to collapse and expand. Double-click a value, or use the Context Menu's Show Details, to
    see the trades behind it (ADR-0063).
</p>

<div class="demo-toolbar">
    <button id="pivot-reset" @onclick="Reset">Reset the layout</button>
    <button id="pivot-save" @onclick="Save">Save the layout</button>
    <button id="pivot-restore" disabled="@(_saved is null)" @onclick="Restore">Restore the saved layout</button>
    <button id="pivot-revalue" @onclick="Revalue">Revalue the trades by +1%</button>
    <button id="pivot-words" @onclick="ToggleWords">@(_japanese ? "English words" : "日本語 (Excel's Japanese words)")</button>
    @if (DemoChrome.IsMud(ChromeName))
    {
        <button id="toggle-dark" @onclick="() => _dark = !_dark">Toggle dark mode</button>
        <span id="dark-status">Dark: @_dark</span>
    }
</div>

<p class="demo-status">
    <span id="pivot-read">@_read</span>
    <span id="pivot-status">@_status</span>
    <span id="pivot-field-list-status">Field List shown: @_showFieldList</span>
</p>

@if (DemoChrome.IsMud(ChromeName))
{
    <MudExGridPaper Elevation="1" Class="demo-stretch-paper">@Pivot</MudExGridPaper>
}
else
{
    @Pivot
}

@if (DetailsOnPage)
{
    <h2>Details</h2>
    <p id="pivot-details-caption">@_detailsCaption</p>
    <div id="pivot-details">
        <ExGrid TRow="DemoPivotTrade" Window="_details" Columns="DetailColumns" RowHeight="28"
                ViewportHeight="240" ViewportWidth="900" Chrome="_gridChrome" />
    </div>
}

