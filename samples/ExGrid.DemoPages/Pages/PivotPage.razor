@code {
    private static readonly GridColumn<DemoPivotTrade>[] DetailColumns =
    [
        new("Id", ColumnType.Text, t => t.Id),
        new("Region", ColumnType.Text, t => t.Region),
        new("Desk", ColumnType.Text, t => t.Desk),
        new("Book", ColumnType.Text, t => t.Book),
        new("Product", ColumnType.Text, t => t.Product),
        new("Currency", ColumnType.Text, t => t.Currency),
        new("TradeDate", ColumnType.Date, t => t.TradeDate, header: "Trade date"),
        new("Notional", ColumnType.Number, t => t.Notional),
        new("Pnl", ColumnType.Number, t => t.Pnl, header: "P&L"),
    ];

    private decimal _revaluation = 1m;
    private string? _saved;
    private IReadOnlyList<DemoPivotTrade> _details = [];
    private string _detailsCaption = "Double-click a value in the report.";
    private string _status = "";
    private string _read = "";
    private int _changes;
    private bool _dark;
    private bool _japanese;
    private bool _showFieldList = true;
    private IGridChrome? _gridChrome;
    private IPivotChrome? _pivotChrome;
    // Held in a field: a delegate made per render would reach the pivot as a change (ADR-0003).
    private EventCallback<PivotDetails> _showDetails;

    [SupplyParameterFromQuery(Name = "chrome")]
    public string? ChromeName { get; set; }

    [SupplyParameterFromQuery(Name = "details")]
    public string? DetailsName { get; set; }

    [SupplyParameterFromQuery(Name = "words")]
    public string? WordsName { get; set; }

    [SupplyParameterFromQuery(Name = "trades")]
    public int? TradesAsked { get; set; }

    // How many trades the page pivots: ?trades=, or the 2,000 it opens with.
    private int TradeCount => TradesAsked is > 0 and var count ? count : DemoPivotData.Count;

    private bool DetailsOnPage => DetailsName == "page";

    private PivotDetailsView DetailsView => DetailsName == "dialog" ? PivotDetailsView.Dialog : PivotDetailsView.Tab;

    private static CultureInfo Culture => CultureInfo.GetCultureInfo("en-US");

    #region The code: pivot
    // The bundled Pivot Source over the trades: the reference, answered in this process (ADR-0066).
    // The trades are read into its Snapshot once, as the page starts, on the page's own thread.
    private PivotSource _source = default!;
    private PivotLayout _layout = DemoPivotData.FirstLayout();

    protected override void OnInitialized()
    {
        var trades = DemoPivotData.Trades(count: TradeCount);
        var clock = Stopwatch.StartNew();
        _source = PivotSource.From(trades, DemoPivotData.Fields);
        _read = $"{trades.Length.ToString("N0", Culture)} trades read into a Snapshot in {clock.ElapsedMilliseconds.ToString("N0", Culture)} ms.";
        Describe();
    }

    private RenderFragment Pivot => @<ExPivot Source="_source" @bind-Layout="_layout" @bind-Layout:after="Changed"
                                               @bind-ShowFieldList="_showFieldList"
                                               PivotChrome="_pivotChrome" Chrome="_gridChrome"
                                               OnShowDetails="_showDetails" DetailsView="DetailsView" Label="Words"
                                               Culture="Culture" ViewportHeight="460" />;

    // Excel's Japanese edition's words, chosen in one line; null keeps the English (ADR-0060).
    private Func<string, string?>? Words => _japanese ? PivotWords.Japanese : null;
    #endregion

    protected override void OnParametersSet()
    {
        // The report grid takes ExPivot.MudBlazor's grid Chrome through the pivot Chrome; the
        // details grid takes ExGrid.MudBlazor's directly (DemoChrome refuses any other name).
        _gridChrome = DemoChrome.IsMud(ChromeName) ? null : DemoChrome.From(ChromeName);
        _pivotChrome = DemoChrome.IsMud(ChromeName) ? MudPivotChrome.Default : null;
        // Listening to OnShowDetails is what takes the records from the tab and the dialog.
        _showDetails = DetailsOnPage ? EventCallback.Factory.Create<PivotDetails>(this, ShowDetailsAsync) : default;
        if (WordsName == "ja")
            _japanese = true;
    }

    private void Changed()
    {
        _changes++;
        Describe();
    }

    private void Reset()
    {
        _layout = DemoPivotData.FirstLayout();
        Describe();
    }

    private void Revalue()
    {
        // New data is a new source: ExPivot asks it again (ADR-0059/0066).
        _revaluation *= 1.01m;
        _source = PivotSource.From(DemoPivotData.Trades(_revaluation, TradeCount), DemoPivotData.Fields);
        Describe();
    }

    private void ToggleWords() => _japanese = !_japanese;

    #region The code: save
    private void Save()
    {
        _saved = PivotLayoutJson.Write(_layout);    // versioned JSON, to keep as a user's setting
        Describe();
    }

    private void Restore()
    {
        if (_saved is null)
            return;
        _layout = PivotLayoutJson.Read(_saved);
        Describe();
    }

    private async Task ShowDetailsAsync(PivotDetails details)
    {
        // The page takes every record behind the cell, under the report's Source Version, and its
        // own trade objects with them: the source is in the process.
        var page = await details.DetailsAsync(0, int.MaxValue);
        if (page.IsRefused)
        {
            _details = [];
            _detailsCaption = page.Refusal!.Message;
            return;
        }
        _details = page.Records.Select(r => (DemoPivotTrade)r.Record!).ToArray();
        var items = details.RowItems.Concat(details.ColumnItems).Select(i => $"{i.Field} = {i.Item}");
        var where = string.Join(", ", items);
        _detailsCaption = $"{page.Total.ToString("N0", Culture)} trades behind {details.ValueField ?? "the cell"}"
            + (where.Length > 0 ? $" where {where}." : ".");
    }
    #endregion

    private void Describe()
        => _status = $"{_changes.ToString(Culture)} changes made in the pane; "
            + (_saved is null ? "no layout saved." : $"the saved layout is {_saved.Length.ToString("N0", Culture)} characters of JSON.");
}
