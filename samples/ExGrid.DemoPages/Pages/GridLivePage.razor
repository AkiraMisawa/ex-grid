@page "/grid-live"
@implements IAsyncDisposable
@inject DemoApiClient Api
@using System.Globalization
@using System.Net.Http.Json
@using System.Runtime.CompilerServices
@using System.Text.Json
@using Microsoft.AspNetCore.SignalR.Client
@* global::, because this project's namespace nests inside ExGrid (the CS0426 trap in AGENTS.md). *@
@using global::ExGrid.Chrome
@using global::ExGrid.MudBlazor

@* ?chrome=mud stands the grid on ExGrid.MudBlazor's paper under its Chrome and its stylesheet,
   as /mud does; absent or builtin is the core's own. The Change Highlight is checked under both
   (DC-66: the core's stylesheet and a Wrapper's). *@
<DemoChromeAssets Name="@ChromeName" Paper="true" />

<DemoNav />

<h1>Live grid — a Window over a server's trades, and the cells that changed</h1>

<p>
    <strong>The use case:</strong> a blotter over trades that a server keeps changing — ExGrid
    alone, with no pivot. The grid reads the demo API server's trades through
    <code>GridSource.Fetch</code>, a page at a time (<code>GET /api/trades</code>) as it asks for
    rows (ADR-0025), each trade named by its <code>TradeId</code>, its Row Key (ADR-0140). The
    server's live updates change trades several times a second, and its SignalR hub says so: "trades
    T10000123 and T10000456 changed". The page tells the source the data moved on
    (<code>NotifyChanged</code>), and the source does the rest (ADR-0141): it reads its Window again,
    at most four times a second, pairs the new trades with the painted ones by key, and answers the
    grid's <code>CellChangedAt</code> for the cells whose text changed. The grid marks those cells for
    <code>ChangeHighlightDuration</code> and takes the marks away itself: keyed by row and column,
    never by the element, so a mark stays on its trade as you scroll; one colour, without animating,
    and never announced (ADR-0068).
</p>
<p>
    A trade cancelled moves every row after it up one. The server sends an order token with every
    page, which moves whenever a trade anywhere is cancelled or booked; the source moves the Row
    Sequence Version on it, which drops a selection rather than leave it on other rows (ADR-0011) —
    a trade cancelled far past the rows on screen included. The live updates go off when you leave
    the page. The server gives every other change to its first 500 trades, the busy ones this blotter
    opens on, so the rows in view change several times a second whatever the trade count; further
    down, a change lands only now and then. The server orders its trades by <code>TradeId</code> and
    nothing else, so the header selects its column rather than sort, and there is no column menu.
</p>

<div class="demo-toolbar">
    <button id="grid-live-toggle" disabled="@(!_connected)" @onclick="ToggleLiveAsync">@(_liveOn ? "Turn the server's live updates off" : "Turn the server's live updates on")</button>
    <label>
        Trades changed every 250 ms
        <select id="grid-live-rate" @bind="_rate" @bind:after="RateChangedAsync">
            <option value="20">20</option>
            <option value="200">200</option>
            <option value="1000">1,000</option>
        </select>
    </label>
    <label>
        A mark lasts
        <select id="grid-live-highlight" @bind="_highlightMs">
            <option value="1000">1 second (the default)</option>
            <option value="5000">5 seconds</option>
            <option value="60000">1 minute</option>
        </select>
    </label>
</div>

<p class="demo-status">
    <DemoStatusLine @ref="_windowLine" Id="grid-live-window" Initial="Reading the first trades from the demo API server…" />
    <DemoStatusLine @ref="_noticesLine" Id="grid-live-notices" Initial="@_noticesInitial" />
</p>

@if (_source is null)
{
    @* Interactive only: on the Server host the page is prerendered first, and a prerender that read
       the trades would do it for nothing. The source is made, and the grid bound to it, once the page
       is interactive. *@
    <p class="demo-status">Waiting for the page to be interactive…</p>
}
else if (DemoChrome.IsMud(ChromeName))
{
    <MudExGridPaper Elevation="1">@Grid</MudExGridPaper>
}
else
{
    @Grid
}

<h2>The code</h2>
<p>
    What this page runs, read from its source. <code>Api.Http</code> is an <code>HttpClient</code>
    whose base address is the demo API server, at the page's own port plus 3000
    (<code>DemoApiClient</code>).
</p>
<DemoCodeBlock File="GridLivePage.razor" Region="window" />
<DemoCodeBlock File="GridLivePage.razor" Region="notices" />
<DemoCodeBlock File="GridLivePage.razor" Region="grid" />
<DemoCodeBlock File="GridLivePage.razor" Region="leaving" />

@code {
    private static readonly CultureInfo Culture = CultureInfo.GetCultureInfo("en-US");
    private static readonly JsonSerializerOptions Json = new(JsonSerializerDefaults.Web);

    private readonly CancellationTokenSource _leaving = new();
    private IGridChrome? _chrome;
    private DemoStatusLine? _windowLine;
    private DemoStatusLine? _noticesLine;
    private string _noticesInitial = "Connecting to the demo API server's hub…";
    private bool _connected;
    private bool _liveOn;
    private int _rate = 1_000;
    private int _highlightMs = 1_000;
    private long _notices;
    private long _named;
    private bool _unavailable;

    [SupplyParameterFromQuery(Name = "chrome")]
    public string? ChromeName { get; set; }

    protected override void OnParametersSet() => _chrome = DemoChrome.From(ChromeName);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;
        var token = _leaving.Token;
        try
        {
            Open();
            StateHasChanged();
            await ListenAsync(token);
            _connected = true;
            _liveOn = true;
            Describe();
            StateHasChanged();
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        {
            // The page went first.
        }
        catch (HttpRequestException error)
        {
            Unavailable(error);
        }
    }

    #region The code: window
    // A trade as GET /api/trades answers it.
    public sealed record LiveTrade(string TradeId, string Region, string Desk, string Book, string Product,
        string? Currency, DateTime TradeDate, decimal Notional, decimal Pnl, int Quantity, bool Confirmed);

    // A page of trades, with the server's order token: it moves whenever a trade anywhere was
    // cancelled or booked (ADR-0141).
    private sealed record TradePage(string Version, int Total, int Start, LiveTrade[] Trades, string? OrderToken);

    // The most GET /api/trades answers at once.
    private const int MaxPage = 1_000;

    // The Grid Source holds the Window, reads a range as the grid asks for it with 40 rows either
    // side (ADR-0025), and names each trade by its TradeId: the Row Key (ADR-0140/0141).
    private FetchingGridSource<LiveTrade>? _source;

    // The Source Version each Window was read at, for the status line.
    private readonly ConditionalWeakTable<IReadOnlyList<LiveTrade>, string> _readAt = new();

    private void Open()
    {
        _source = GridSource.Fetch<LiveTrade>(FetchAsync, readAheadRows: 40, rowKey: trade => trade.TradeId);
        // Subscribed, so a failure is said in the status line rather than rethrown (ADR-0025).
        _source.FetchFailed += Failed;
        _source.StateChanged += Describe;
        // One delegate for the source's life, held in a field: the grid asks it as it paints a value
        // cell, and only a row whose trade changed is a new instance that asks again (ADR-0068).
        _cellChangedAt = _source.CellChangedAt;
    }

    // GET /api/trades: the range the source asks for, in TradeId order, with how many there are.
    private async ValueTask<GridPage<LiveTrade>> FetchAsync(GridQuery query, CancellationToken token)
    {
        // The server orders its trades by TradeId and filters nothing, so a question that sorts or
        // filters is refused rather than answered in another order (ADR-0023).
        if (query.Sorts.Count > 0 || query.Filter is not null)
            throw new NotSupportedException("The demo API server pages its trades in TradeId order, unfiltered.");
        var count = Math.Min(MaxPage, query.Range.Count);
        var page = await Api.Http.GetFromJsonAsync<TradePage>($"api/trades?start={query.Range.Start}&count={count}", Json, token)
            ?? throw new InvalidOperationException("The server answered no page of trades.");
        _readAt.AddOrUpdate(page.Trades, page.Version);
        return new GridPage<LiveTrade>(page.Trades, page.Start, page.Total) { OrderToken = page.OrderToken };
    }
    #endregion

    #region The code: notices
    // The Change Highlight, answered by the source: when each cell's painted text last changed.
    private CellChangeOf<LiveTrade>? _cellChangedAt;   // _source.CellChangedAt, in Open

    private HubConnection? _hub;
    private Task? _hubStarting;
    private bool _liveAsked;
    private string? _heardVersion;

    private async Task ListenAsync(CancellationToken token)
    {
        var hub = _hub = new HubConnectionBuilder().WithUrl(Api.Hub).WithAutomaticReconnect().Build();
        // "These trades changed": heard on a thread of SignalR's. The source gathers the notices and
        // reads its Window again at most every 250 ms; it may be told on any thread (ADR-0141).
        hub.On<string, string[]>("TradesChanged", (version, tradeIds) =>
        {
            _source?.NotifyChanged();
            return InvokeAsync(() => Heard(version, tradeIds));
        });
        // Not cancelled by the page's going: a connection cut off while it opens is an error in the
        // browser's console. DisposeAsync waits for it instead.
        await (_hubStarting = hub.StartAsync());
        // Live updates are off until a page turns them on (ADR-0069), and this one turns them off
        // as it goes.
        await SetLiveAsync(true, token);
    }

    private void Heard(string version, string[] tradeIds)
    {
        _heardVersion = version;
        _notices++;
        _named += tradeIds.Length;
        Describe();
    }
    #endregion

    #region The code: grid
    // The source, and the Change Highlight it answers: when each cell changed, and how long a mark
    // lasts. The server orders by TradeId alone, so a header click selects its column (ADR-0050) and
    // there is no menu to sort or filter by.
    private RenderFragment Grid => @<ExGrid TRow="LiveTrade" Source="_source" Columns="Columns" PinnedColumnCount="1"
                                            CellChangedAt="_cellChangedAt" ChangeHighlightDuration="Highlight"
                                            HeaderClickSelects="true" HideColumnMenu="true"
                                            ViewportHeight="480" ViewportWidth="1270" Chrome="_chrome" />;

    private TimeSpan Highlight => TimeSpan.FromMilliseconds(_highlightMs);

    // One reference-stable array: a list rebuilt per render would repaint every row (ADR-0003).
    private static readonly GridColumn<LiveTrade>[] Columns =
    [
        new("TradeId", ColumnType.Text, t => t.TradeId, header: "Trade ID", width: Fixed(110)),
        new("Region", ColumnType.Text, t => t.Region, width: Fixed(100)),
        new("Desk", ColumnType.Text, t => t.Desk, width: Fixed(90)),
        new("Book", ColumnType.Text, t => t.Book, width: Fixed(170)),
        new("Product", ColumnType.Text, t => t.Product, width: Fixed(90)),
        new("Currency", ColumnType.Text, t => t.Currency, width: Fixed(90)),
        // A number or a date that does not fit is #### rather than cut short (ADR-0016): the widths
        // leave room for every digit the live updates can bring.
        new("TradeDate", ColumnType.Date, t => t.TradeDate, header: "Trade date", width: Fixed(120), align: CellAlign.Left,
            format: value => ((DateTime)value).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)),
        new("Notional", ColumnType.Number, t => t.Notional, width: Fixed(150), format: Money),
        new("Pnl", ColumnType.Number, t => t.Pnl, header: "P&L", width: Fixed(140), format: Money),
        new("Quantity", ColumnType.Number, t => t.Quantity, width: Fixed(90)),
        new("Confirmed", ColumnType.Boolean, t => t.Confirmed, width: Fixed(100)),
    ];

    private static ColumnWidthSpec Fixed(double width) => new(ColumnWidth.Fixed(width));

    private static string Money(object value) => ((decimal)value).ToString("#,##0.00", CultureInfo.InvariantCulture);
    #endregion

    // POST /api/live: the server changes `_rate` trades every 250 ms while on.
    private async Task SetLiveAsync(bool on, CancellationToken token)
    {
        _liveAsked |= on;
        using var response = await Api.Http.PostAsJsonAsync("api/live", new { on, intervalMs = 250, tradesPerTick = _rate }, Json, token);
        response.EnsureSuccessStatusCode();
    }

    private async Task ToggleLiveAsync()
    {
        var token = _leaving.Token;
        try
        {
            await SetLiveAsync(!_liveOn, token);
            _liveOn = !_liveOn;
            Describe();
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        {
        }
        catch (HttpRequestException error)
        {
            Unavailable(error);
        }
    }

    // A rate chosen while the live updates are on reaches the server at once.
    private async Task RateChangedAsync()
    {
        if (!_liveOn)
            return;
        var token = _leaving.Token;
        try
        {
            await SetLiveAsync(true, token);
            Describe();
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        {
        }
        catch (HttpRequestException error)
        {
            Unavailable(error);
        }
    }

    // The status lines, from the source's Window and the notices heard. Raised by the source on the
    // page's context; each line renders on its own, so the page and its grid do not render with it.
    private void Describe()
    {
        if (_source is not { } source)
            return;
        var window = source.Window;
        string? readAt = window.Count > 0 && _readAt.TryGetValue(window, out var version) ? version : null;
        if (readAt is not null)
        {
            _windowLine?.Show($"Window: rows {source.WindowStart.ToString("N0", Culture)}–{(source.WindowStart + window.Count - 1).ToString("N0", Culture)} "
                + $"of {(source.TotalCount ?? 0).ToString("N0", Culture)}, at version {readAt}.");
        }
        if (_unavailable)
            return;
        // A read that failed is said until a later one lands, rather than left on screen as a
        // Window that is current (ADR-0025).
        if (source.LastError is { } error)
        {
            _noticesLine?.Show(error is HttpRequestException http ? Api.NotAnswering(http) : $"The trades could not be read: {error.Message}");
            return;
        }
        if (!_connected)
            return;
        var live = _liveOn ? $"on, {_rate.ToString("N0", Culture)} trades every 250 ms" : "off";
        var heard = _heardVersion is null || readAt is null ? "" : $" Read again up to version {readAt}.";
        _noticesLine?.Show($"Live updates {live}. Heard {_notices.ToString("N0", Culture)} notices naming "
            + $"{_named.ToString("N0", Culture)} trades.{heard}");
    }

    // A failed read is held in the source's LastError, which the status line says.
    private void Failed(Exception error) => Describe();

    private void Unavailable(HttpRequestException error)
    {
        _unavailable = true;
        _noticesInitial = Api.NotAnswering(error);
        _noticesLine?.Show(_noticesInitial);
        _ = InvokeAsync(StateHasChanged);
    }

    #region The code: leaving
    // The server's live updates go off when the page goes: the data then holds still for whoever
    // reads it next (ADR-0069). The source is the page's, so the page disposes it (ADR-0025).
    public async ValueTask DisposeAsync()
    {
        _leaving.Cancel();
        if (_source is { } source)
        {
            source.Dispose();
            source.FetchFailed -= Failed;
            source.StateChanged -= Describe;
        }
        try
        {
            if (_hubStarting is not null)
                await _hubStarting;
        }
        catch (Exception)
        {
            // A connection that never opened has nothing to close.
        }
        try
        {
            if (_liveAsked)
                await SetLiveAsync(false, CancellationToken.None);
        }
        catch (HttpRequestException)
        {
            // A server that has gone is changing nothing.
        }
        if (_hub is not null)
            await _hub.DisposeAsync();
    }
    #endregion
}
