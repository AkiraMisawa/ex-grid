@page "/features"
@implements IDisposable
@using ExGrid.Chrome
@using ExGrid.Clipboard
@using ExGrid.Finding
@using ExGrid.Keys
@using ExGrid.Summarizing
@* global::, for the reason MudApp.razor gives (AGENTS.md, the name collisions). *@
@using global::MudBlazor

@* ?chrome=mud runs this page's grids with ExGrid.MudBlazor's Chrome instead of the
   built-in one, so the same browser tests can be run under both (FN-17, WR-5): the
   Chrome is the only thing that changes — no paper, no presentation defaults (DemoChrome). *@
<DemoChromeAssets Name="@ChromeName" />

<DemoNav />

<h1>Features — editing, clipboard, sorting, filtering, Header Groups</h1>

<p>
    The interaction surface on one page, for the browser layer to drive: an editable
    source-bound grid with tiered headers, the clipboard, the pager-free selection
    status, and every gesture notification written to the status lines below.
</p>

<p class="demo-status">
    <span id="edit-status">Edited: @_editStatus</span>
    <span id="paste-status">Pasted: @_pasteStatus</span>
    @* What the last paste's source block held, field by field, with where each field came from
       (ADR-0005, ADR-0050 item 10): Excel's x:num is the raw value, read under the invariant
       culture, where the text flavour is the display, already rounded (CP-14). *@
    <span id="paste-fields">Fields: @_pasteFields</span>
    <span id="clear-status">Cleared: @_clearStatus</span>
    <span id="history-status">History: @_historyStatus</span>
    <span id="copy-status">Copy refused: @_copyStatus</span>
    @* A refusal is the grid telling the user their write did not happen. The built-in Chrome words
       it and the grid's live region announces it (ADR-0203), so this line only shows the reason by
       name, and is not a live region: one would say the refusal a second time. *@
    <span id="paste-refused-status">Paste refused: @_pasteRefusedStatus</span>
    <span id="edit-discarded-status" role="status">Edit discarded: @_editDiscardedStatus</span>
    @* A write refused because its row is gone or its order moved (ADR-0142): announced as every
       refusal is (A11Y-16). *@
    <span id="commit-refused-status" role="status">Commit refused: @_commitRefusedStatus</span>
    @* A commit that landed over a cell that changed while the editor covered it (ADR-0142, LV-21):
       the Overwrite Notice, announced as a refusal is, with both texts, because the user never saw
       the change. Nothing was refused. *@
    <span id="overwrite-notice-status" role="status">Overwritten: @_overwriteStatus</span>
    <span id="action-refused-status" role="status">Action refused: @_actionRefusedStatus</span>
    <span id="find-refused-status" role="status">Find: @_findStatus</span>
    <span id="replace-status">Replace All: @_replaceStatus</span>
    <span id="context-status">Context: @_contextStatus</span>
    <span id="order-status">Order: @string.Join(",", _columns.Select(c => c.Name))</span>
    <span id="width-status">Width: @_widthStatus</span>
    @if (UpstreamOn)
    {
        <span id="upstream-status">Upstream: @_upstreamStatus</span>
        <span id="action-status">Action: @_actionStatus</span>
        <span id="fill-status">Filled: @_fillStatus</span>
    }
</p>

<ExGrid TRow="DemoTrade"
        Source="_source"
        Columns="_columns"
        RowHeight="24"
        HeaderHeight="28"
        ViewportHeight="320"
        ViewportWidth="720"
        PinnedColumnCount="_pinned"
        PageSize="PagedSize"
        HeaderGroups="_groups"
        HighlightFocusRow="true"
        OnEdit="OnEdit"
        OnPaste="OnPaste"
        OnClear="OnClear"
        OnUndo="OnUndo"
        OnRedo="OnRedo"
        OnCopyRefused="OnCopyRefused"
        OnPasteRefused="OnPasteRefused"
        OnEditDiscarded="OnEditDiscarded"
        OnCommitRefused="OnCommitRefused"
        OnOverwriteNotice="OnOverwriteNotice"
        OnAction="OnAction"
        OnActionRefused="OnActionRefused"
        ShowFillHandle="UpstreamOn"
        OnFill="OnFill"
        DeclaredKeys="@(RowKeyOn ? UpstreamAndResortKeys : UpstreamOn ? UpstreamKeys : null)"
        OnDeclaredKey="OnUpstreamKey"
        OnFindRefused="OnFindRefused"
        OnReplace="OnReplace"
        OnColumnWidthChanged="OnWidthChanged"
        OnColumnOrderChanged="OnOrderChanged"
        OnColumnHidden="OnHidden"
        OnPinnedCountChanged="OnPinned"
        ContextCommands="ContextCommands"
        CopyAnswer="@(CopyThrowsOn ? CopyThatThrows : null)"
        CellState="_rules.State"
        CellMessageOf="_rules.Message"
        Chrome="_chrome" />

@* How many Edit Intents and paste intents the grid has raised: a gesture that raised none, or two,
   shows here where a status line would read the same (ED-19). Below the grid, so a count that
   changes never moves the rows a pointer is pressing on. *@
<p class="demo-status"><span id="intent-count">Intents: @_editCount edits, @_pasteCount pastes</span></p>

@* The Header Groups as this page declared them, written out after every render: a drag never
   changes them (ADR-0032, HG-15). Only under ?groups=1, so the page's default layout is unchanged. *@
@if (ShowGroups)
{
    <p class="demo-status"><span id="groups-status">Groups: @string.Join("; ", _groups.Select(g => $"{g.Label} [{string.Join(",", g.Columns)}] tier {g.Tier} span {g.TierSpan}"))</span></p>
}

<h2>A second, independent instance</h2>
<p>Two grids on one page hold independent DOM, tokens and handles (ADR-0018).</p>

<ExGrid TRow="DemoTrade"
        Source="_second"
        Columns="_secondColumns"
        RowHeight="20"
        ViewportHeight="140"
        ViewportWidth="480"
        Chrome="_chrome" />

@if (HeldSummaryOn)
{
    <h2>A Selection Summary the page answers when asked to</h2>
    <p>
        A grid the page pushes rows to answers its Selection Summary through <code>OnSummarize</code>
        (ADR-0130). This one holds each answer until the button is pressed, so the pending mark
        stands meanwhile, and declines a selection of more than @HeldSummaryMostCells cells with a
        reason, which the line shows in place of the figures.
    </p>
    <p class="demo-status">
        <button id="summary-answer" @onclick="AnswerHeldSummary">Answer the summary</button>
        <span id="summary-asked">Asked: @_heldAsked; cancelled: @_heldCancelled; answered: @_heldAnswered</span>
        @if (HeldIgnoresCancellation)
        {
            <button id="summary-answer-late" @onclick="AnswerReplacedHeldSummary">Answer the replaced question</button>
            <span id="summary-late">Answered late: @_heldLateAnswered</span>
        }
    </p>
    <div id="held-summary">
        <ExGrid TRow="DemoTrade"
                Window="_heldRows"
                Columns="_heldColumns"
                RowHeight="20"
                ViewportHeight="140"
                ViewportWidth="480"
                OnSummarize="_heldSummarize"
                Chrome="_chrome" />
    </div>
}

@code {
    /// <summary>Which Chrome the grids run with (<see cref="DemoChrome"/>).</summary>
    [SupplyParameterFromQuery(Name = "chrome")]
    public string? ChromeName { get; set; }

    /// <summary>
    /// <c>?modal=1</c> turns on MudBlazor's <c>ModalOverlay</c> — a Consumer's app-wide
    /// setting, under which a press outside an open popup is swallowed by MudBlazor's
    /// overlay and only the popup closes (ADR-0039, FN-21). Set on the options object the
    /// app registered, and set back when the page goes, so no other page inherits it.
    /// </summary>
    [SupplyParameterFromQuery(Name = "modal")]
    public string? ModalOverlay { get; set; }

    /// <summary>
    /// <c>?upstream=1</c> lets the browser layer change values under a gesture, as a live feed
    /// would (ADR-0142, LV-11 to LV-14): F9, declared to the grid, moves the Notional of the first
    /// five rows up by one — with an edit open too, where the grid raises a declared key and
    /// changes nothing in the editor (ADR-0050, item 14). It also adds an Action Column and the
    /// fill handle, so that a press, a paste, a fill and a commit can each be raced against it.
    /// Off, the page is what the other browser tests drive.
    /// </summary>
    [SupplyParameterFromQuery(Name = "upstream")]
    public string? Upstream { get; set; }

    private bool UpstreamOn => Upstream == "1";

    /// <summary>
    /// <c>?rowkey=1</c>, beside <c>?upstream=1</c>, binds the source with the trade's own number as
    /// its Row Key (ADR-0140), and declares F8 as well: the top row's Notional jumps past every
    /// other, as a live amendment can, so under a sort by Notional the row moves to the end — with
    /// an edit open too, which follows its row there without a scroll (ADR-0011's note of
    /// 2026-10-07).
    /// </summary>
    [SupplyParameterFromQuery(Name = "rowkey")]
    public string? RowKeyParameter { get; set; }

    private bool RowKeyOn => UpstreamOn && RowKeyParameter == "1";

    /// <summary>
    /// <c>?copythrows=1</c> gives the first grid a <c>CopyAnswer</c> that throws, as a Consumer's
    /// delegate with a defect would: a genuine .NET failure on either copy route, which the grid
    /// must report rather than make a silent no-op (ADR-0005, CON-8).
    /// </summary>
    [SupplyParameterFromQuery(Name = "copythrows")]
    public string? CopyThrows { get; set; }

    private bool CopyThrowsOn => CopyThrows == "1";

    private static GridCopyAnswer CopyThatThrows(GridCopyRequest request)
        => throw new InvalidOperationException("The demo's CopyAnswer fails on purpose (?copythrows=1).");

    private static readonly string[] UpstreamKeys = ["F9"];
    private static readonly string[] UpstreamAndResortKeys = ["F9", "F8"];

    /// <summary>
    /// <c>?groups=1</c> writes the Header Groups the page declared under the main grid after every
    /// render, so the browser layer can read that a drag never changes them (ADR-0032, HG-15).
    /// </summary>
    [SupplyParameterFromQuery(Name = "groups")]
    public string? GroupsParameter { get; set; }

    private bool ShowGroups => GroupsParameter == "1";

    /// <summary>
    /// <c>?paged=1</c> gives the main grid a pager of 50 rows a page (ADR-0015), so the browser layer
    /// can drag against a page's boundary and read that the page does not turn (SL-11).
    /// </summary>
    [SupplyParameterFromQuery(Name = "paged")]
    public string? PagedParameter { get; set; }

    private int? PagedSize => PagedParameter == "1" ? 50 : null;

    /// <summary>
    /// <c>?summary=held</c> adds a third grid whose Selection Summary the page answers itself
    /// (ADR-0130, SM-11): each question waits for the page's button, and one over more than
    /// <see cref="HeldSummaryMostCells"/> cells is declined at once, with a reason. The browser layer
    /// reads the pending mark and the reason under each Chrome.
    /// </summary>
    [SupplyParameterFromQuery(Name = "summary")]
    public string? SummaryName { get; set; }

    private bool HeldSummaryOn => SummaryName == "held";

    /// <summary>
    /// <c>?late=1</c> beside <c>?summary=held</c>: the page ignores the token, as a careless Consumer
    /// may, and keeps the question a new selection replaced, so that it can be answered after the
    /// grid has cancelled it. The grid shows nothing of that answer (ADR-0130, SM-2 through SM-11).
    /// </summary>
    [SupplyParameterFromQuery(Name = "late")]
    public string? LateParameter { get; set; }

    private bool HeldIgnoresCancellation => HeldSummaryOn && LateParameter == "1";

    private TaskCompletionSource<GridSummaryResult>? _heldReplacedAnswer;
    private GridSummaryRequest? _heldReplacedRequest;
    private int _heldLateAnswered;

    private const int HeldSummaryMostCells = 4;

    private DemoTrade[] _heldRows = [];
    private IReadOnlyList<GridColumn<DemoTrade>> _heldColumns = default!;
    // Held in a field: a delegate made per render would reach the grid as a change (ADR-0003).
    private Func<GridSummaryRequest, CancellationToken, Task<GridSummaryResult>>? _heldSummarize;
    private TaskCompletionSource<GridSummaryResult>? _heldAnswer;
    private GridSummaryRequest? _heldRequest;
    private int _heldAsked;
    private int _heldCancelled;
    private int _heldAnswered;

    private Task<GridSummaryResult> SummarizeHeldAsync(GridSummaryRequest request, CancellationToken cancellation)
    {
        _heldAsked++;
        _ = ShowHeldCountsAsync();
        if (GridSummary.Cells(request, _heldRows.Length).Count() > HeldSummaryMostCells)
            return Task.FromResult(GridSummaryResult.Declined($"Not summed: this page sums {HeldSummaryMostCells} cells at most."));
        var answer = new TaskCompletionSource<GridSummaryResult>(TaskCreationOptions.RunContinuationsAsynchronously);
        cancellation.Register(() =>
        {
            if (HeldIgnoresCancellation ? !answer.Task.IsCompleted : answer.TrySetCanceled(cancellation))
            {
                _heldCancelled++;
                _ = ShowHeldCountsAsync();
            }
        });
        if (HeldIgnoresCancellation && _heldAnswer is { Task.IsCompleted: false })
        {
            _heldReplacedAnswer = _heldAnswer;
            _heldReplacedRequest = _heldRequest;
        }
        _heldAnswer = answer;
        _heldRequest = request;
        return answer.Task;
    }

    /// <summary>Answers the question waiting, the latest asked: a cancelled one can no longer be.</summary>
    private void AnswerHeldSummary()
    {
        if (_heldAnswer is not { } answer || _heldRequest is not { } request)
            return;
        _heldAnswer = null;
        _heldRequest = null;
        if (answer.TrySetResult(GridSummary.Of(_heldRows, request, HeldValueOf)))
            _heldAnswered++;
    }

    /// <summary>Answers the question a new selection replaced, with its own figures, after the grid
    /// cancelled it (<c>?late=1</c>).</summary>
    private void AnswerReplacedHeldSummary()
    {
        if (_heldReplacedAnswer is not { } answer || _heldReplacedRequest is not { } request)
            return;
        _heldReplacedAnswer = null;
        _heldReplacedRequest = null;
        if (answer.TrySetResult(GridSummary.Of(_heldRows, request, HeldValueOf)))
            _heldLateAnswered++;
    }

    private Func<DemoTrade, object?>? HeldValueOf(string column)
        => _heldColumns.FirstOrDefault(c => c.Name == column)?.Value;

    // The counts are shown after the grid's own render, which is where it asks and cancels.
    private async Task ShowHeldCountsAsync()
    {
        await Task.Yield();
        await InvokeAsync(StateHasChanged);
    }

    [Inject] private Microsoft.Extensions.Options.IOptions<PopoverOptions> MudPopovers { get; set; } = default!;

    private IGridChrome? _chrome;

    public void Dispose() => MudPopovers.Value.ModalOverlay = false;

    protected override void OnParametersSet()
    {
        MudPopovers.Value.ModalOverlay = ModalOverlay == "1";
        _chrome = DemoChrome.From(ChromeName);
    }

    private InMemoryGridSource<DemoTrade> _source = default!;
    private InMemoryGridSource<DemoTrade> _second = default!;
    /// <summary>The bundled ruleset (ADR-0034): owned and driven here, shipped with the
    /// library. It answers both display channels, so a value that arrived by paste wears
    /// the same mark as one that was typed.</summary>
    private readonly GridRuleset<DemoTrade> _rules = new();

    private IReadOnlyList<GridColumn<DemoTrade>> _columns = default!;
    private IReadOnlyList<GridColumn<DemoTrade>> _secondColumns = default!;
    private IReadOnlyList<HeaderGroup> _groups = default!;

    protected override void OnInitialized()
    {
        var rows = new DemoTrade[400];
        string[] books = ["Alpha", "Beta", "Gamma", "Delta"];
        // The last name is Arabic on purpose: RTL content renders correctly inside
        // the LTR island (ADR-0031), and the browser layer asserts exactly that.
        string[] traders = ["Ishikawa", "Novak", "Osei", "\u0639\u0645\u0631"];
        for (var i = 0; i < rows.Length; i++)
        {
            rows[i] = new DemoTrade
            {
                Id = i,
                Book = books[i % books.Length],
                Trader = traders[(i / 3) % traders.Length],
                Notional = 1_000_000m + (i * 12_345.67m),
                TradeDate = new DateTime(2026, 1, 1).AddDays(i % 200),
                Confirmed = i % 3 != 0,
            };
        }

        _source = RowKeyOn ? GridSource.From(rows, static t => t.Id) : GridSource.From(rows);
        _second = GridSource.From(rows.Take(20).ToArray());
        _heldRows = rows.Take(20).ToArray();
        _heldColumns =
        [
            new GridColumn<DemoTrade>("Book", ColumnType.Text, t => t.Book),
            new GridColumn<DemoTrade>("Notional", ColumnType.Number, t => t.Notional),
        ];
        _heldSummarize = SummarizeHeldAsync;
        _rules
            .Column("Notional", (_, text) => !decimal.TryParse(text, out var value)
                ? EditVerdict.Reject($"'{text}' is not a number")
                : value < 0
                    ? EditVerdict.Flag("a negative notional needs approval")
                    : EditVerdict.Accept);
        _columns = BuildColumns();
        _rules.Evaluate(rows, _columns);
        _secondColumns =
        [
            new GridColumn<DemoTrade>("Book", ColumnType.Text, t => t.Book),
            new GridColumn<DemoTrade>("Trader", ColumnType.Text, t => t.Trader),
        ];
        _groups =
        [
            new HeaderGroup("Who", ["Book", "Trader"]),
            // With ?upstream=1 the Act column stands between Notional and Narrow, so it joins the
            // group: a Header Group's members are adjacent, or the grid refuses it (ADR-0032).
            new HeaderGroup("What", UpstreamOn
                ? ["Notional", "Act", "Narrow", "TradeDate", "Confirmed"]
                : ["Notional", "Narrow", "TradeDate", "Confirmed"]),
        ];
    }

    private GridColumn<DemoTrade>[] BuildColumns() => UpstreamOn
        ? [.. BaseColumns().Take(3), ApproveColumn, .. BaseColumns().Skip(3)]
        : BaseColumns();

    /// <summary>An action that would write — approving a trade at the notional shown — so a press
    /// on a row whose notional moved under it must be refused (ADR-0142, LV-12).</summary>
    private static readonly GridColumn<DemoTrade> ApproveColumn = GridColumn<DemoTrade>.ActionColumn(
        "Act", [new GridAction("approve", "Approve")], width: new ColumnWidthSpec(ColumnWidth.Fixed(90)));

    private GridColumn<DemoTrade>[] BaseColumns() =>
    [
        new("Book", ColumnType.Text, t => t.Book,
            width: new ColumnWidthSpec(ColumnWidth.Fixed(110)), filterUi: FilterUiMode.Both),
        new("Trader", ColumnType.Text, t => t.Trader,
            width: new ColumnWidthSpec(ColumnWidth.Fixed(120)), editable: true, filterUi: FilterUiMode.Both),
        // The verdict seam (ADR-0034), wired to the bundled ruleset: an unparseable text
        // Rejects and the editor holds, a negative notional Flags and is applied wearing
        // its mark. Which is which is this side's convention, not the grid's.
        new("Notional", ColumnType.Number, t => t.Notional,
            width: new ColumnWidthSpec(ColumnWidth.Fixed(140)), editable: true,
            validate: _rules.ValidatorFor("Notional")),
        // Deliberately too narrow for its values: what #### looks like, and what the
        // clipboard must never receive (ADR-0016 / CP-5). The label is the full word,
        // so the header's own ellipsis is the real thing and widening the column
        // restores it along with the values.
        new("Narrow", ColumnType.Number, t => t.Notional,
            width: new ColumnWidthSpec(ColumnWidth.Fixed(48))),
        // ISO, and the widths sum under the Viewport minus its scrollbar gutter: a
        // horizontal bar here would sit exactly where the browser suite drags into the
        // bottom edge band (SL-14/15), the CLAUDE.md gutter trap in its purest form.
        new("TradeDate", ColumnType.Date, t => t.TradeDate,
            width: new ColumnWidthSpec(ColumnWidth.Fixed(120)), format: IsoDate),
        new("Confirmed", ColumnType.Boolean, t => t.Confirmed,
            width: new ColumnWidthSpec(ColumnWidth.Fixed(120))),
    ];

    private static string IsoDate(object value)
        => ((DateTime)value).ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);

    private string _editStatus = "—";
    private int _editCount;
    private int _pasteCount;
    private string _clearStatus = "—";
    private string _findStatus = "—";
    private string _replaceStatus = "—";
    private string _historyStatus = "—";
    private string _pasteStatus = "—";
    private string _pasteFields = "—";
    private string _copyStatus = "—";
    private string _pasteRefusedStatus = "—";
    private string _editDiscardedStatus = "—";
    private string _contextStatus = "—";
    private string _widthStatus = "—";
    private string _commitRefusedStatus = "—";
    private string _overwriteStatus = "—";
    private string _actionRefusedStatus = "—";
    private string _upstreamStatus = "—";
    private string _actionStatus = "—";
    private string _fillStatus = "—";
    private int _upstreamTicks;


    /// <summary>Find's refusals (ADR-0055). This page's grid is bound to GridSource.From, which
    /// searches, so Unavailable never arrives here; the panel words NotFound itself too.</summary>
    private void OnFindRefused(FindRefusalReason reason)
        => Status(reason, reason.ToString(), s => _findStatus = s);

    /// <summary>Replace All (ADR-0332 §3): GridSource.From plans every match through this page's own
    /// write of one cell — the one its edits use — and applies them all, or none; the rows it rewrote are
    /// one history step, so one Ctrl+Z undoes the whole Replace All.</summary>
    private Task<GridReplaceResult> OnReplace(GridReplaceRequest request)
    {
        var answer = _source.Replace(request, (row, column, text) => Edited(row, column, text) is { } replacement
            ? GridReplaceWrite<DemoTrade>.To(replacement)
            : GridReplaceWrite<DemoTrade>.Refuse($"'{text}' is not a number"));
        if (answer.Changes.Count > 0)
        {
            _undo.Push(new HistoryStep([.. answer.Changes.Select(change => (change.Before, change.After))]));
            _redo.Clear();
        }
        _rules.Evaluate(_source.Window, _columns);
        _replaceStatus = answer.Result.IsReplaced
            ? $"{answer.Result.Count} cells in {answer.Changes.Count} rows"
            : $"refused, {answer.Result.RefusedCells.Count} cells";
        StateHasChanged();
        return Task.FromResult(answer.Result);
    }

    /// <summary>One history step: the row instances one intent replaced and the ones it put in
    /// their place, in the order it replaced them.</summary>
    private sealed record HistoryStep(IReadOnlyList<(DemoTrade Before, DemoTrade After)> Changes);

    // The undo stack ADR-0007 says the Consumer owns: one step per intent — a typed edit, a
    // paste, a fill or a clear. The grid only forwards the keys.
    private readonly Stack<HistoryStep> _undo = new();
    private readonly Stack<HistoryStep> _redo = new();

    /// <summary>Applies one intent's replacements as one history step.</summary>
    private int Apply(IEnumerable<(DemoTrade Row, DemoTrade Replacement)> changes)
    {
        var step = new List<(DemoTrade, DemoTrade)>();
        foreach (var (row, replacement) in changes)
        {
            try
            {
                _source.ReplaceRow(row, replacement);
                step.Add((row, replacement));
            }
            catch (ArgumentException)
            {
                // The row left the result mid-apply (a filter the intent itself
                // falsified); skipping it is the honest outcome for a demo.
            }
        }
        if (step.Count > 0)
        {
            _undo.Push(new HistoryStep(step));
            _redo.Clear();
        }
        _rules.Evaluate(_source.Window, _columns);
        return step.Count;
    }

    private void OnUndo() => Replay(_undo, _redo, "undone");

    private void OnRedo() => Replay(_redo, _undo, "redone");

    /// <summary>Undoes or redoes one step: its changes reversed, last first, and the reverse
    /// step — in the order it was just applied — pushed onto the other stack, so replaying that
    /// one last-first puts the changes back in their original order.</summary>
    private void Replay(Stack<HistoryStep> from, Stack<HistoryStep> to, string verb)
    {
        if (!from.TryPop(out var step))
        {
            _historyStatus = $"nothing to be {verb}";
            return;
        }
        var reversed = new List<(DemoTrade, DemoTrade)>();
        for (var i = step.Changes.Count - 1; i >= 0; i--)
        {
            var (before, after) = step.Changes[i];
            _source.ReplaceRow(after, before);
            reversed.Add((after, before));
        }
        to.Push(new HistoryStep(reversed));
        _rules.Evaluate(_source.Window, _columns);
        _historyStatus = $"{step.Changes.Count} changes {verb}";
    }

    /// <summary>Delete's Clear Intent (ADR-0054): no value at all, mapped per column onto
    /// this Consumer's own Blank. Trader has one — the empty name; Notional does not, so a
    /// clear there applies nothing, and says so, rather than writing a zero.</summary>
    private void OnClear(GridClearIntent intent)
    {
        var window = _source.Window;
        var changes = new List<(DemoTrade, DemoTrade)>();
        var skipped = 0;
        foreach (var target in intent.Targets)
        {
            for (var row = target.TopRow; row <= Math.Min(target.BottomRow, window.Count - 1); row++)
            {
                for (var column = target.LeftColumn; column <= target.RightColumn; column++)
                {
                    if (_columns[column].Name == "Trader")
                        changes.Add((window[row], Edited(window[row], "Trader", "")!));
                    else
                        skipped++;
                }
            }
        }
        var applied = Apply(changes);
        _clearStatus = $"{intent.CellCount} cells, {applied} applied, {skipped} have no blank";
    }

    private void OnEdit(GridEditIntent<DemoTrade> intent)
    {
        _editCount++;
        _editStatus = $"{intent.Column}={intent.Value} on {intent.Row.Book}/{intent.Row.Trader}" + (RowKeyOn ? $" #{intent.Row.Id}" : "");
        // The Consumer's half of ADR-0007: a NEW instance carrying the change goes
        // back through the source, and the screen follows the identity change. An
        // unparseable value applies nothing — validation is the Consumer's.
        if (Edited(intent.Row, intent.Column, intent.Value) is { } replacement)
        {
            // Re-judged after applying, inside Apply, which is the only moment a row rule
            // can be judged at all (ADR-0034). One call for the rows now held.
            Apply([(intent.Row, replacement)]);
        }
        else
        {
            _editStatus += " (not applied: unparseable)";
        }
    }

    private const int ShownFields = 20, ShownFieldLength = 40;

    private static string Shown(string value)
        => value.Length <= ShownFieldLength ? value : $"{value[..ShownFieldLength]}… ({value.Length} characters)";

    private void OnPaste(GridPasteIntent intent)
    {
        _pasteCount++;
        _pasteStatus = $"{intent.CellCount} cells from {intent.Plan.Source.Rows}x{intent.Plan.Source.Columns}";
        // Shown in part: the page is read by people and by tests, and a ten-megabyte paste written whole
        // into one text node cost the browser seconds of text shaping after every render (widened-run
        // ticket 05), which was this page's cost and not the grid's.
        var fields = intent.Values.SelectMany((row, r) =>
            row.Select((value, c) => $"{Shown(value)}:{intent.Origins[r][c]}")).ToList();
        _pasteFields = string.Join(" | ", fields.Take(ShownFields))
            + (fields.Count > ShownFields ? $" | … {fields.Count - ShownFields} more" : "");
        // Positions are the current order's, so every (row, column, value) is resolved
        // against the Window FIRST — applying as we go could reorder mid-loop under a
        // sort on the edited column (ADR-0011/0014).
        var window = _source.Window;
        var resolved = new List<(DemoTrade Row, string Column, string Value)>();
        foreach (var target in intent.Plan.Targets)
        {
            for (var row = target.TopRow; row <= target.BottomRow; row++)
            {
                if (row >= window.Count)
                    continue;
                for (var column = target.LeftColumn; column <= target.RightColumn; column++)
                {
                    if (column >= _columns.Count)
                        continue;
                    resolved.Add((window[row], _columns[column].Name,
                        intent.ValueFor(new ExGrid.Selection.CellPosition(row, column))));
                }
            }
        }
        // One history step for the whole paste, so one Ctrl+Z (ADR-0007). Two targets on
        // one row replace it twice: each change is built on the instance the previous one
        // left, followed through the latest replacement.
        var latest = new Dictionary<DemoTrade, DemoTrade>(ReferenceEqualityComparer.Instance);
        var changes = new List<(DemoTrade, DemoTrade)>();
        foreach (var (row, column, value) in resolved)
        {
            var current = latest.TryGetValue(row, out var replaced) ? replaced : row;
            if (Edited(current, column, value) is { } replacement)
            {
                changes.Add((current, replacement));
                latest[row] = replacement;
            }
        }
        var applied = Apply(changes);
        _pasteStatus += $", {applied} applied";
        // Re-judged inside Apply, as a typed edit is. Without it the ruleset's own promise
        // — that one implementation runs whether a change arrived by an edit, a paste or
        // program code — would be false in the reference Consumer (ADR-0034).
    }

    /// <summary>A new instance with one field changed — identity is the change signal
    /// (ADR-0003). Null where the value does not parse or the column is not editable
    /// by this Consumer.</summary>
    private static DemoTrade? Edited(DemoTrade row, string column, string value) => column switch
    {
        "Trader" => new DemoTrade
        {
            Id = row.Id, Book = row.Book, Trader = value, Notional = row.Notional,
            TradeDate = row.TradeDate, Confirmed = row.Confirmed,
        },
        "Notional" => decimal.TryParse(value, out var notional)
            ? new DemoTrade
            {
                Id = row.Id, Book = row.Book, Trader = row.Trader, Notional = notional,
                TradeDate = row.TradeDate, Confirmed = row.Confirmed,
            }
            : null,
        _ => null,
    };

    private void OnCopyRefused(CopyRefusalReason reason)
        => Status(reason, reason.ToString(), s => _copyStatus = s);

    /// <summary>Where a Consumer puts its snackbar (ADR-0010/0035): the grid names the
    /// rule, the wording is ours. TargetNotEditable arrives here for a paste and for a
    /// Ctrl+Enter fill alike, and is the one refusal reselecting cannot fix.</summary>
    private void OnPasteRefused(PasteRefusalReason reason)
        => Status(reason, reason switch
        {
            PasteRefusalReason.EmptySelection =>
                "EmptySelection — nothing was written: select the cells to write into",
            PasteRefusalReason.SingleCellTarget =>
                "SingleCellTarget — reselect a target of the same shape",
            PasteRefusalReason.ShapeMismatch =>
                "ShapeMismatch — the selection is not a whole multiple of the copied block",
            PasteRefusalReason.DisjointTarget =>
                "DisjointTarget — a block of several cells goes into one range only",
            PasteRefusalReason.TargetNotEditable =>
                "TargetNotEditable — the selection covers a column that is not editable",
            PasteRefusalReason.TooLarge =>
                "TooLarge — more than a paste or a fill reads at once",
            PasteRefusalReason.Unreadable =>
                "Unreadable — the clipboard could not be read; nothing was written",
            PasteRefusalReason.Cancelled =>
                "Cancelled — Escape cancelled the paste while it was read; nothing was written",
            PasteRefusalReason.SpillPastExtent =>
                "SpillPastExtent — the block would run past the last row or column",
            PasteRefusalReason.NothingToFillFrom =>
                "NothingToFillFrom — there is no row above, or column to the left, to fill from",
            PasteRefusalReason.MultipleRanges =>
                "MultipleRanges — a fill works on one range",
            PasteRefusalReason.SourceUnavailable =>
                "SourceUnavailable — the cells to fill from could not be read whole",
            // ADR-0142/0011: aimed with a Selection the rows moving took away.
            PasteRefusalReason.OrderMoved =>
                "OrderMoved — nothing was written: the rows moved after you aimed it; select the cells again",
            // ADR-0142: aimed at what a Source since replaced painted.
            PasteRefusalReason.SourceChanged =>
                "SourceChanged — nothing was written: the data the grid shows was replaced before it landed; select the cells again",
            // Every reason is worded above; one the page does not know is a defect to see, not a
            // sentence to guess (principle 1).
            _ => throw new ArgumentOutOfRangeException(nameof(reason), reason, "A paste refusal this page does not word."),
        }, s => _pasteRefusedStatus = s);

    /// <summary>A commit whose row the grid could not find in the rows it holds now (ADR-0142,
    /// LV-20). The editor still stands with the typing; Escape leaves it.</summary>
    private void OnCommitRefused(GridCommitRefusal refusal)
        => Status(refusal, refusal.Reason switch
        {
            CommitRefusalReason.OrderMoved =>
                $"OrderMoved — {refusal.Column} was not written: the rows moved while you were typing; press Escape to leave it",
            CommitRefusalReason.RowLeftTheWindow =>
                $"RowLeftTheWindow — {refusal.Column} was not written: the row is not in the rows the grid holds now; bring it back into view and commit again, or press Escape",
            // Every reason is worded above; one the page does not know is a defect to see, not a
            // sentence to guess (principle 1).
            _ => throw new ArgumentOutOfRangeException(nameof(refusal), refusal.Reason, "A commit refusal this page does not word."),
        }, s => _commitRefusedStatus = s);

    /// <summary>A commit that landed over a cell whose value moved while the user typed (ADR-0142,
    /// LV-11, LV-21): the editor covered the cell, so the sentence says what it showed and what was
    /// written over.</summary>
    private void OnOverwriteNotice(GridOverwriteNotice notice)
        => Status(notice, $"{notice.Column} written over {notice.ReplacedText}; it showed {notice.SeenText} when you started typing",
            s => _overwriteStatus = s);

    /// <summary>An action whose row the grid could not find in the rows it holds when the press
    /// landed (ADR-0142, LV-12, LV-20): out of the Window, or named by a place the rows moving gave
    /// to another row. Nothing was done; the row's values changing never refuses one.</summary>
    private void OnActionRefused(GridActionRefusal<DemoTrade> refusal)
        => Status(refusal.Reason, refusal.Reason switch
        {
            ActionRefusalReason.RowLeftTheWindow =>
                $"RowLeftTheWindow — {refusal.ActionName} was not done: the row is not in the rows the grid holds now; bring it back into view and press it again",
            ActionRefusalReason.OrderMoved =>
                $"OrderMoved — {refusal.ActionName} was not done: the rows moved before the press landed; press it on the row again",
            ActionRefusalReason.SourceChanged =>
                $"SourceChanged — {refusal.ActionName} was not done: the data the grid shows was replaced before the press landed",
            _ => throw new ArgumentOutOfRangeException(nameof(refusal), refusal.Reason, "An action refusal this page does not word."),
        }, s => _actionRefusedStatus = s);

    private void OnAction(GridActionEventArgs<DemoTrade> press)
        => _actionStatus = $"{press.ActionName} {press.Row.Book}/{press.Row.Trader} at {press.Row.Notional:0.00}";

    /// <summary>F9 under <c>?upstream=1</c>: the data moves on under the user, as a live feed moves
    /// it — new instances of the first five rows, each Notional up by one (ADR-0003, ADR-0142).</summary>
    private void OnUpstreamKey(GridDeclaredKeyPress press)
    {
        var window = _source.Window;
        if (press.Key == "F8")
        {
            // Under ?rowkey=1: the top row amended past every other Notional.
            if (window.Count == 0)
                return;
            var top = window[0];
            _source.ReplaceRow(top, new DemoTrade
            {
                Id = top.Id, Book = top.Book, Trader = top.Trader, Notional = window.Max(t => t.Notional) + 1_000_000m,
                TradeDate = top.TradeDate, Confirmed = top.Confirmed,
            });
            _rules.Evaluate(_source.Window, _columns);
            _upstreamStatus = $"trade #{top.Id} amended past every other (×{++_upstreamTicks})";
            return;
        }
        var count = Math.Min(5, window.Count);
        for (var row = 0; row < count; row++)
        {
            var old = window[row];
            _source.ReplaceRow(old, new DemoTrade
            {
                Id = old.Id, Book = old.Book, Trader = old.Trader, Notional = old.Notional + 1m,
                TradeDate = old.TradeDate, Confirmed = old.Confirmed,
            });
        }
        _rules.Evaluate(_source.Window, _columns);
        _upstreamStatus = $"rows 1-{count} moved (×{++_upstreamTicks})";
    }

    /// <summary>A fill-handle drag under <c>?upstream=1</c> (ADR-0050, item 5): each target cell
    /// takes the source cell above or below it in its column, cycling through the source, as one
    /// history step. Down and up only — this page has no use for a sideways fill.</summary>
    private void OnFill(GridFillIntent intent)
    {
        if (intent.Direction is not (ExGrid.Selection.GridDirection.Down or ExGrid.Selection.GridDirection.Up))
        {
            _fillStatus = "only down or up";
            return;
        }
        var window = _source.Window;
        var source = intent.Source;
        var target = intent.Target;
        var sourceRows = source.BottomRow - source.TopRow + 1;
        var changes = new List<(DemoTrade, DemoTrade)>();
        for (var row = target.TopRow; row <= Math.Min(target.BottomRow, window.Count - 1); row++)
        {
            var from = window[source.TopRow + (((row - source.TopRow) % sourceRows) + sourceRows) % sourceRows];
            var into = window[row];
            for (var column = target.LeftColumn; column <= target.RightColumn; column++)
            {
                var name = _columns[column].Name;
                var text = name switch
                {
                    "Trader" => from.Trader,
                    "Notional" => from.Notional.ToString(System.Globalization.CultureInfo.CurrentCulture),
                    _ => null,
                };
                if (text is not null && Edited(into, name, text) is { } replacement)
                {
                    changes.Add((into, replacement));
                    into = replacement;
                }
            }
        }
        _fillStatus = $"{changes.Count} cells";
        Apply(changes);
    }

    /// <summary>The typing is already gone when this arrives; what a Consumer owes the
    /// user is the reason (ADR-0011). Announced, not merely painted — nobody asked for
    /// this to happen, so nobody is watching for it.</summary>
    private void OnEditDiscarded(EditDiscardReason reason)
        => Status(reason, reason switch
        {
            EditDiscardReason.RowLeftTheWindow =>
                "RowLeftTheWindow — that row is no longer loaded, so the entry could not be placed",
            EditDiscardReason.SourceChanged =>
                "SourceChanged — the data the grid shows was replaced while you were typing; the entry was not written",
            // Decided 2026-10-08: typing that reached the grid after the rows moved opens nothing.
            EditDiscardReason.OrderMoved =>
                "OrderMoved — the rows moved before your typing reached the grid; nothing was written",
            _ => reason.ToString(),
        }, s => _editDiscardedStatus = s);

    /// <summary>What a Consumer adds to the context menu (ADR-0036). It is handed the
    /// clicked row and the selection as rectangles plus the version they are written in;
    /// resolving the rest of the selection into rows is this side's question, because
    /// this side owns the data. The demo does the one-row case, which is the one the
    /// design was argued from — open what this row is about.</summary>
    private IEnumerable<GridCommand> ContextCommands(ContextMenuContext<DemoTrade> context)
    {
        var row = context.Row;
        var cells = context.Selection.Sum(r => r.CellCount);
        return
        [
            new GridCommand("open-trade", true, () =>
            {
                _contextStatus = $"open {row.Book}/{row.Trader} ({cells} cells selected, v{context.RowSequenceVersion})";
                // A command's Invoke is a plain delegate, not an EventCallback: Blazor
                // re-renders the grid that handled the click, and nothing tells this page
                // that its own field moved. The Consumer says so — the same obligation as
                // for any callback it hands to a component (ADR-0010).
                StateHasChanged();
                return Task.CompletedTask;
            }),
        ];
    }

    private void OnWidthChanged(ColumnWidthChange change)
    {
        _widthStatus = $"{change.Column}={change.WidthPx:0}";
        _columns = _columns
            .Select(c => c.Name == change.Column
                ? new GridColumn<DemoTrade>(c.Name, c.Type, c.Value, c.Header,
                    // As it came, with the column's own bounds: MaxWidth bounds only what
                    // the grid computes, so a drag past it is recorded as it is (ADR-0016).
                    new ColumnWidthSpec(ColumnWidth.Fixed(change.WidthPx), c.Width.MinWidthPx, c.Width.MaxWidthPx),
                    editable: c.Editable, filterUi: c.FilterUi, align: c.Align, headerAlign: c.HeaderAlign,
                    validate: c.Validate, format: c.Format, tone: c.Tone)
                : c)
            .ToArray();
    }

    private void OnOrderChanged(IReadOnlyList<string> order)
        => _columns = order.Select(name => _columns.First(c => c.Name == name)).ToArray();

    private void OnHidden(string column)
        => _columns = _columns.Where(c => c.Name != column).ToArray();

    private int _pinned;

    private void OnPinned(int count) => _pinned = count;

    private readonly Dictionary<string, int> _statusRepeats = [];

    /// <summary>A live region announces on mutation, so writing the same sentence twice
    /// says nothing the second time — and the second refusal is exactly the one a user
    /// needs to hear, having just tried again. The grid promises a refused write is
    /// always reported (ADR-0035, A11Y-16), and it is Chrome that would break that
    /// promise here. The count makes the repeat a change, and says it happened again
    /// rather than pretending it did not.</summary>
    private void Status<T>(T reason, string text, Action<string> set)
    {
        var key = $"{typeof(T).Name}:{reason}";
        var seen = _statusRepeats.TryGetValue(key, out var n) ? n + 1 : 1;
        _statusRepeats[key] = seen;
        set(seen > 1 ? $"{text} (×{seen})" : text);
    }
}
