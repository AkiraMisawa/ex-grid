@page "/sheets"
@using System.Globalization
@* global::, for the reasons SheetPage.razor gives. *@
@using global::ExSheet.Components
@using global::ExSheet.Engine
@using global::ExGrid.Chrome
@using global::ExGrid.MudBlazor
@using global::MudBlazor

@* ?chrome=mud runs both Sheets with ExGrid.MudBlazor's Chrome, each on the Wrapper's paper, whose
   stylesheet maps the grid's Visual Tokens onto MudBlazor's palette (ADR-0030) — so the browser
   tests that look at a Sheet's paint run under both Chromes (ED-27). Without the parameter
   nothing here renders, and each Sheet stands on the page as it always did. *@
@if (_mudChrome)
{
    <HeadContent>
        <link href="_content/ExGrid.DemoPages/fonts/roboto/roboto.css" rel="stylesheet" />
        <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
        <link href="_content/ExGrid.MudBlazor/mud-ex-grid.css" rel="stylesheet" />
    </HeadContent>
    <MudThemeProvider />
    <MudPopoverProvider />
}

<DemoNav />

<h1>Two sheets — independent instances</h1>

<p>
    Two ExSheets on one page, each with its own Sheet, its own undo stack and its own Formula Bar
    (ADR-0018, ADR-0048). Keys typed into one never reach the other, a completion list opens in
    the one being typed in, and Ctrl+Z undoes only the Sheet that has the keyboard.
</p>

<div class="demo-side-by-side">
    <div id="sheet-left">
        @OnPaper(@<ExSheet @bind-Document="_left" @bind-Document:after="Count" Culture="Culture" Chrome="_chrome" ViewportHeight="360" ViewportWidth="520" />)
    </div>
    <div id="sheet-right">
        @OnPaper(@<ExSheet @bind-Document="_right" @bind-Document:after="Count" Culture="Culture" Chrome="_chrome" ViewportHeight="360" ViewportWidth="520" />)
    </div>
</div>

<p class="demo-status">
    <span id="sheets-status">@_status</span>
</p>

@code {
    /// <summary>Which Chrome the Sheets run with: absent or <c>builtin</c> is the core's own,
    /// <c>mud</c> is <see cref="MudGridChrome.Default"/> on a <see cref="MudExGridPaper"/>.
    /// Anything else is refused, as on /sheet, so a test "under both Chromes" cannot pass twice
    /// against the same one.</summary>
    [SupplyParameterFromQuery(Name = "chrome")]
    public string? ChromeName { get; set; }

    private IGridChrome? _chrome;
    private bool _mudChrome;

    protected override void OnParametersSet()
    {
        _mudChrome = ChromeName == "mud";
        _chrome = ChromeName switch
        {
            null or "builtin" => null,
            "mud" => MudGridChrome.Default,
            _ => throw new ArgumentException(
                $"Unknown chrome '{ChromeName}': this page runs with ?chrome=builtin (the default) or ?chrome=mud.",
                nameof(ChromeName)),
        };
    }

    // A Sheet under the Wrapper's Chrome stands on its paper; under the core's, on the page.
    private RenderFragment OnPaper(RenderFragment sheet)
        => _mudChrome ? @<MudExGridPaper>@sheet</MudExGridPaper> : sheet;

    private static readonly CultureInfo Culture = CultureInfo.GetCultureInfo("en-US");

    private SheetDocument? _left = Opening("Left", 10);
    private SheetDocument? _right = Opening("Right", 20);
    private string _status = "";

    // Each Sheet names itself in A1 and holds a number and a Formula over it, so a key that
    // crossed from one to the other would show in the other's cells.
    private static SheetDocument Opening(string name, int value)
    {
        var sheet = new Sheet(Culture);
        sheet.Enter(CellAddress.Parse("A1"), name);
        sheet.Enter(CellAddress.Parse("B1"), value.ToString(CultureInfo.InvariantCulture));
        sheet.Enter(CellAddress.Parse("C1"), "=B1*2");
        return sheet.ToDocument();
    }

    protected override void OnInitialized() => Count();

    private void Count() =>
        _status = $"Left: {_left?.Cells.Count ?? 0} cells; right: {_right?.Cells.Count ?? 0} cells.";
}
