<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- The demo pages, shared by both hosts (ADR-0019): the WebAssembly DemoHost and the
         Blazor Server host serve exactly these, so layer 3 drives one set of pages under
         either. Not shipped; targets what the SDK provides (ADR-0022). -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ExGrid.DemoPages</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <!-- The latest MudBlazor, above the Wrapper's 9.0.0 floor on purpose: a Consumer's
         application resolves the dependency upward (ADR-0022), and these pages are where
         that is seen to work. -->
    <PackageReference Include="MudBlazor" Version="9.9.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- A Consumer's pages: they reference the core and the Wrapper, and only the hosts
         reference them (ADR-0019). The /mud page is the browser layer's fixture for the
         Wrapper contract (ADR-0030). -->
    <ProjectReference Include="..\..\src\ExGrid\ExGrid.csproj" />
    <ProjectReference Include="..\..\src\ExGrid.MudBlazor\ExGrid.MudBlazor.csproj" />
    <!-- ExSheet's page (/sheet): the demo pages are one of the two things that reference
         ExSheet, its tests being the other (ADR-0046, SH-1). -->
    <ProjectReference Include="..\..\src\ExSheet\ExSheet.csproj" />
    <!-- The Sheet pages under ?chrome=mud draw Format Cells as a MudDialog (ADR-0071); like ExSheet,
         only these pages and the package's tests reference it (ADR-0019's note of 2026-09-30). -->
    <ProjectReference Include="..\..\src\ExSheet.MudBlazor\ExSheet.MudBlazor.csproj" />
  </ItemGroup>

</Project>
