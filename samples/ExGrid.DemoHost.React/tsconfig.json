{
  // The workspace's settings, so the Script Core's sources it builds from type as they do there.
  "extends": "../../src/npm/tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "declaration": false,
    "emitDeclarationOnly": false,
    "noEmit": true,
    "types": ["vite/client", "node"],
    // The adapter's source sits outside this folder; its React is this host's, as Vite's dedupe makes it.
    "paths": {
      "react": ["./node_modules/@types/react/index.d.ts"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom/index.d.ts"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"],
      "@ex-grid/core": ["../../src/npm/core/src/index.ts"],
      "@ex-grid/react": ["../../src/npm/react/src/index.ts"],
      "@ex-grid/chart": ["../../src/npm/chart/src/index.ts"],
      "@ex-grid/chart-react": ["../../src/npm/chart-react/src/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
