# nix-direnv cache (built dev-shell profile)
.direnv/

# .NET build output
bin/
obj/
*.user
*.suo

# spikes/render-bench/results/*.json is kept — it is the measurement evidence for ADR-0003 / 0008

# Agent run instructions — operational, deliberately not committed. They direct one
# autonomous run; the repository's own rules live in AGENTS.md, the decisions in
# docs/adr/, and the exit criteria in docs/definition-of-done.md. Keeping them out
# also keeps the English-only rule about repository content, not about scratch input.
docs/agent-runs/

# Agent worktrees. A checkout per background agent, so one can build and run the
# suites without touching the working tree you are editing. Disposable: the branch
# it sits on carries nothing the main tip does not.
.claude/worktrees/

# The package smoke check (dotnet/tests/ExGrid.PackageSmoke/check.sh)
.feed/
.nuget-packages/
.publish/

# The npm workspace at the repository's root (ADR-0350, ADR-0370 section 9): every member's dependencies, and what
# a build writes. A package's report of its public surface, etc/<name>.api.md, is kept; dist/ is built when the
# package is published.
node_modules/
packages/*/dist/
packages/*/temp/

# The React DemoHost (ADR-0350 section 13): what `vite build` writes for layer 3
samples/ExGrid.DemoHost.React/dist/

# The Script Core's module for Blazor ExGrid, bundled from packages/ as ExGrid builds (ADR-0350 section 7)
dotnet/src/ExGrid/wwwroot/ex-grid-core.min.js
dotnet/src/ExGrid/wwwroot/ex-grid-core.min.js.map
dotnet/src/ExGrid/wwwroot/ex-grid-script.min.js
dotnet/src/ExGrid/wwwroot/ex-grid-script.min.js.map
# ExPivot's, bundled from packages/ as ExPivot builds (ADR-0370 section 1)
dotnet/src/ExPivot/wwwroot/ex-pivot.min.js
dotnet/src/ExPivot/wwwroot/ex-pivot.min.js.map
# ExSheet's, bundled from packages/ as ExSheet builds (ADR-0370 section 1)
dotnet/src/ExSheet/wwwroot/ex-sheet.min.js
dotnet/src/ExSheet/wwwroot/ex-sheet.min.js.map
dotnet/src/ExChart/wwwroot/ex-chart-core.min.js
dotnet/src/ExChart/wwwroot/ex-chart-core.min.js.map
# ExBoard's, bundled from packages/ as ExBoard builds (ADR-0370 section 1)
dotnet/src/ExBoard/wwwroot/ex-board.min.js
dotnet/src/ExBoard/wwwroot/ex-board.min.js.map

# The Docs Site's React Examples (ADR-0350 section 12): the frame the Docs project's build writes into the site's
# static files
dotnet/samples/ExGrid.Docs/wwwroot/react/
