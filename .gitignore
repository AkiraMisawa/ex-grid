# nix-direnv cache (built dev-shell profile)
.direnv/

# .NET build output
bin/
obj/
*.user
*.suo

# spikes/render-bench/results/*.json is kept — it is the measurement evidence for ADR-0003 / 0008

# Agent run instructions — operational, deliberately not committed. They direct one
# autonomous run; the repository's own rules live in AGENTS.md, the decisions in
# docs/adr/, and the exit criteria in docs/definition-of-done.md. Keeping them out
# also keeps the English-only rule about repository content, not about scratch input.
docs/agent-runs/

# Agent worktrees. A checkout per background agent, so one can build and run the
# suites without touching the working tree you are editing. Disposable: the branch
# it sits on carries nothing the main tip does not.
.claude/worktrees/

# The package smoke check (tests/ExGrid.PackageSmoke/check.sh)
.feed/
.nuget-packages/
.publish/

# The asset minifier's own dependencies (ADR-0123)
tools/assets/node_modules/

# The npm workspace (ADR-0350): its dependencies, and what a build writes. A package's report of its
# public surface, etc/<name>.api.md, is kept; dist/ is built when the package is published.
src/npm/node_modules/
src/npm/*/node_modules/
src/npm/*/dist/
src/npm/*/temp/

# The React DemoHost (ADR-0350 section 13): its dependencies, and what `vite build` writes for layer 3
samples/ExGrid.DemoHost.React/node_modules/
samples/ExGrid.DemoHost.React/dist/

# A test runner started from the repository root writes its cache here; the workspace is src/npm
/node_modules/

# The Script Core's module for Blazor ExGrid, bundled from src/npm as ExGrid builds (ADR-0350 section 7)
src/ExGrid/wwwroot/ex-grid-core.min.js
src/ExGrid/wwwroot/ex-grid-core.min.js.map

# The Docs Site's React Examples (ADR-0350 section 12): their dependencies, and the frame the Docs project's build
# writes into the site's static files
samples/ExGrid.Docs.React/node_modules/
samples/ExGrid.Docs/wwwroot/react/
