{
  "area": "eomonth",
  "about": "EOMONTH (docs/specs/exsheet-functions).",
  "cases": [
    {
      "id": "EOMONTH-001",
      "source": "observed",
      "description": "Microsoft's example: the last day of the month after 1 January 2011",
      "cells": {"A1": "1/1/2011", "ZZ1000": "=EOMONTH(A1,1)"},
      "check": "ZZ1000",
      "expect": {"value2": 40602}
    },
    {
      "id": "EOMONTH-002",
      "source": "observed",
      "description": "Microsoft's example: the last day of the month three months before",
      "cells": {"A1": "1/1/2011", "ZZ1000": "=EOMONTH(A1,-3)"},
      "check": "ZZ1000",
      "expect": {"value2": 40482}
    },
    {
      "id": "EOMONTH-003",
      "source": "observed",
      "description": "Months that are not whole are truncated",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=EOMONTH(DATE(2011,1,1),1.9)"},
      "check": "ZZ1000",
      "expect": {"value2": 40602}
    },
    {
      "id": "EOMONTH-004",
      "source": "observed",
      "description": "A start date that is not a valid date is #NUM!",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=EOMONTH(-1,0)"},
      "check": "ZZ1000",
      "expect": {"value2": "#NUM!"}
    },
    {
      "id": "EOMONTH-005",
      "source": "observed",
      "description": "A result that is not a valid date is #NUM!",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=EOMONTH(DATE(9999,12,1),1)"},
      "check": "ZZ1000",
      "expect": {"value2": "#NUM!"}
    },
    {
      "id": "EOMONTH-006",
      "source": "observed",
      "description": "Engine's answer, Excel to be asked: February of a leap year",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=EOMONTH(DATE(2024,1,31),1)"},
      "check": "ZZ1000",
      "expect": {"value2": 45351}
    },
    {
      "id": "EOMONTH-007",
      "source": "observed",
      "description": "Engine's answer, Excel to be asked: the start date's time of day is ignored",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=EOMONTH(45000.75,0)"},
      "check": "ZZ1000",
      "expect": {"value2": 45016}
    },
    {
      "id": "EOMONTH-008",
      "source": "observed",
      "description": "A start before 1 March 1900 counts on the real calendar: February 1900 ends on the 28th, serial 59",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=EOMONTH(31,1)"},
      "check": "ZZ1000",
      "expect": {"value2": 59}
    },
    {
      "id": "EOMONTH-009",
      "source": "observed",
      "description": "A boolean typed as an argument is #VALUE!",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=EOMONTH(45000,TRUE)"},
      "check": "ZZ1000",
      "expect": {"value2": "#VALUE!"}
    },
    {
      "id": "EOMONTH-010",
      "source": "observed",
      "description": "A start on serial 0 is read as MONTH reads it, in January 1900 (MONTH-004), and the end of the month after is 28 February, 59",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=EOMONTH(0,1)"},
      "check": "ZZ1000",
      "expect": {"value2": 59}
    },
    {
      "id": "EOMONTH-011",
      "source": "observed",
      "description": "Engine's answer, Excel to be asked: from 1 March 1900, the month before ends on 28 February, 59, not on the day that never existed",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=EOMONTH(DATE(1900,3,1),-1)"},
      "check": "ZZ1000",
      "expect": {"value2": 59}
    },
    {
      "id": "EOMONTH-012",
      "source": "uncertain",
      "description": "Engine's answer, Excel to be asked: a start on serial 60 is in February 1900, as MONTH reads it, and February ends on the 28th, 59, not on the day that never existed",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=EOMONTH(60,0)"},
      "check": "ZZ1000",
      "expect": {"value2": 59}
    },
    {
      "id": "EOMONTH-013",
      "source": "uncertain",
      "description": "Engine's answer, Excel to be asked: from serial 60, the end of the month after is 31 March 1900, 91",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=EOMONTH(60,1)"},
      "check": "ZZ1000",
      "expect": {"value2": 91}
    },
    {
      "id": "EOMONTH-014",
      "source": "uncertain",
      "description": "Engine's answer, Excel to be asked: a start on serial 0 is in January 1900, which ends on the 31st, 31",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=EOMONTH(0,0)"},
      "check": "ZZ1000",
      "expect": {"value2": 31}
    },
    {
      "id": "EOMONTH-015",
      "source": "uncertain",
      "description": "Engine's answer, Excel to be asked: from serial 0, the month before is December 1899, before any serial, #NUM! as EOMONTH-005's result after 9999",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=EOMONTH(0,-1)"},
      "check": "ZZ1000",
      "expect": {"value2": "#NUM!"}
    },
    {
      "id": "EOMONTH-016",
      "source": "uncertain",
      "description": "Engine's answer, Excel to be asked: a start between -1 and 0 is cut down to its day as YEAR, MONTH and DAY cut it, to -1, below 0, #NUM! as EOMONTH-004's -1 is, not truncated to serial 0's January 1900, 31",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=EOMONTH(-0.5,0)"},
      "check": "ZZ1000",
      "expect": {"value2": "#NUM!"}
    },
    {
      "id": "EOMONTH-017",
      "source": "uncertain",
      "description": "Engine's answer, Excel to be asked: a start between -1 and 0 is below 0 a month on too, #NUM!, not the end of February 1900, 59",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=EOMONTH(-0.5,1)"},
      "check": "ZZ1000",
      "expect": {"value2": "#NUM!"}
    }
  ]
}
