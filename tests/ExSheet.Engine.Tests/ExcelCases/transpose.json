{
  "area": "transpose",
  "about": "TRANSPOSE (ADR-0125): an array's rows as columns; it spills.",
  "cases": [
    {
      "id": "TRANSPOSE-001",
      "source": "observed",
      "description": "The first row becomes the first column",
      "fixture": "lookupData",
      "cells": {"ZZ1000": "=TRANSPOSE(G1:H2)"},
      "check": "ZZ1001",
      "expect": {"value2": 10}
    },
    {
      "id": "TRANSPOSE-002",
      "source": "observed",
      "description": "The first column becomes the first row",
      "fixture": "lookupData",
      "cells": {"ZZ1000": "=TRANSPOSE(G1:H2)"},
      "check": "AAA1000",
      "expect": {"value2": "Banana", "kind": "text"}
    },
    {
      "id": "TRANSPOSE-003",
      "source": "observed",
      "description": "A row becomes a column",
      "fixture": "lookupData",
      "cells": {"ZZ1000": "=TRANSPOSE(M1:O1)"},
      "check": "ZZ1002",
      "expect": {"value2": "z", "kind": "text"}
    },
    {
      "id": "TRANSPOSE-004",
      "source": "observed",
      "description": "A blank spills as 0",
      "fixture": "lookupData",
      "cells": {"ZZ1000": "=TRANSPOSE(Q1:Q2)"},
      "check": "AAA1000",
      "expect": {"value2": 0}
    },
    {
      "id": "TRANSPOSE-005",
      "source": "observed",
      "description": "Engine's answer, Excel to be asked: COUNTA counts a blank TRANSPOSE keeps, as Excel counted SORT's and UNIQUE's (SORT-021, UNIQUE-017); 1 if it passes over it as over a blank cell",
      "fixture": "lookupData",
      "cells": {"ZZ1000": "=COUNTA(TRANSPOSE(Q1:Q2))"},
      "check": "ZZ1000",
      "expect": {"value2": 2}
    },
    {
      "id": "TRANSPOSE-006",
      "source": "observed",
      "description": "Engine's answer, Excel to be asked: the blank TRANSPOSE keeps, taken out by INDEX, is blank to ISBLANK, as Excel read SORT's (SORT-022); FALSE if TRANSPOSE turned it into the 0 it spills as",
      "fixture": "lookupData",
      "cells": {"ZZ1000": "=ISBLANK(INDEX(TRANSPOSE(Q1:Q2),1,2))"},
      "check": "ZZ1000",
      "expect": {"value2": true}
    },
    {
      "id": "TRANSPOSE-007",
      "source": "uncertain",
      "description": "Refused until Excel is asked: MIN over a blank TRANSPOSE keeps is #VALUE!; 7 if it passes over it, 0 if it reads it as 0",
      "fixture": "lookupData",
      "cells": {"ZZ1000": "=MIN(TRANSPOSE(Q1:Q2))"},
      "check": "ZZ1000",
      "expect": {"value2": "#VALUE!"}
    }
  ]
}
