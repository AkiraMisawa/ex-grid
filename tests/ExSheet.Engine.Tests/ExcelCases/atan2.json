{
  "area": "atan2",
  "about": "ATAN2 (ticket 07).",
  "cases": [
    {
      "id": "ATAN2-001",
      "source": "documented",
      "description": "Microsoft's example: x first, then y",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=ATAN2(1,1)"},
      "check": "ZZ1000",
      "expect": {"value2": 0.785398163, "digits": 9}
    },
    {
      "id": "ATAN2-002",
      "source": "documented",
      "description": "Microsoft's example: -3pi/4",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=ATAN2(-1,-1)"},
      "check": "ZZ1000",
      "expect": {"value2": -2.35619449, "digits": 8}
    },
    {
      "id": "ATAN2-003",
      "source": "documented",
      "description": "Microsoft's example: in degrees",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=ATAN2(-1,-1)*180/PI()"},
      "check": "ZZ1000",
      "expect": {"value2": -135, "digits": 9}
    },
    {
      "id": "ATAN2-004",
      "source": "documented",
      "description": "Microsoft's example: DEGREES",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=DEGREES(ATAN2(-1,-1))"},
      "check": "ZZ1000",
      "expect": {"value2": -135, "digits": 9}
    },
    {
      "id": "ATAN2-005",
      "source": "documented",
      "description": "Documented: both 0 is #DIV/0!",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=ATAN2(0,0)"},
      "check": "ZZ1000",
      "expect": {"value2": "#DIV/0!"}
    },
    {
      "id": "ATAN2-006",
      "source": "documented",
      "description": "The x argument comes first: the point (0, 1) is pi/2",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=ATAN2(0,1)"},
      "check": "ZZ1000",
      "expect": {"value2": 1.5707963267948966, "digits": 12}
    },
    {
      "id": "ATAN2-007",
      "source": "uncertain",
      "description": "Engine's answer, Excel to be asked: the negative x axis is pi, never -pi",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=ATAN2(-1,0)"},
      "check": "ZZ1000",
      "expect": {"value2": 3.141592653589793, "digits": 12}
    }
  ]
}
