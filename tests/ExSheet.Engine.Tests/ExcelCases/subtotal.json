    {
      "id": "SUBTOTAL-016",
      "source": "documented",
      "description": "A nested subtotal in the range is passed over, to avoid counting it twice",
      "cells": {"A2": "120", "A3": "10", "A4": "150", "A5": "23", "A6": "=SUBTOTAL(9,A2:A5)", "ZZ1000": "=SUBTOTAL(9,A2:A6)"},
      "check": "ZZ1000",
      "expect": {"value2": 303}
    },
    {
      "id": "SUBTOTAL-017",
      "source": "documented",
      "description": "A nested 109 is passed over as a 9 is",
      "cells": {"A2": "120", "A3": "10", "A4": "150", "A5": "23", "A6": "=SUBTOTAL(109,A2:A5)", "ZZ1000": "=SUBTOTAL(9,A2:A6)"},
      "check": "ZZ1000",
      "expect": {"value2": 303}
    },
    {
      "id": "SUBTOTAL-018",
