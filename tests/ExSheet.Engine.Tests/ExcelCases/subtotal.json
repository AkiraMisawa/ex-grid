      "cells": {"A2": "120", "A3": "10", "A4": "150", "A5": "23", "A6": "=SUBTOTAL(9,A2:A5)", "ZZ1000": "=SUBTOTAL(9,A:A)"},
      "check": "ZZ1000",
      "expect": {"value2": 303}
    },
    {
      "id": "SUBTOTAL-020",
      "source": "uncertain",
      "description": "Refused until Excel is asked: a SUBTOTAL inside a larger Formula in the range is #VALUE!",
      "cells": {"A2": "120", "A3": "10", "A4": "150", "A5": "23", "A6": "=SUBTOTAL(9,A2:A5)*1", "ZZ1000": "=SUBTOTAL(9,A2:A6)"},
      "check": "ZZ1000",
      "expect": {"value2": "#VALUE!"}
    },
    {
      "id": "SUBTOTAL-021",
      "source": "uncertain",
      "description": "Refused until Excel is asked: an AGGREGATE in SUBTOTAL's range is #VALUE!",
      "cells": {"A2": "120", "A3": "10", "A4": "150", "A5": "23", "A6": "=AGGREGATE(9,0,A2:A5)", "ZZ1000": "=SUBTOTAL(9,A2:A6)"},
      "check": "ZZ1000",
      "expect": {"value2": "#VALUE!"}
    },
    {
      "id": "SUBTOTAL-022",
      "source": "uncertain",
      "description": "Engine's answer, Excel to be asked: an Error Value in the range is SUM's result",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=SUBTOTAL(9,C1:C3)"},
