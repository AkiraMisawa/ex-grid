{
  "area": "subtotal",
  "about": "SUBTOTAL (docs/specs/exsheet-functions ticket 16; ADR-0047, 2026-10-10): admitted while a Sheet cannot hide a row, so 101-111 give what 1-11 give. Only a cell whose whole Formula is a SUBTOTAL is passed over as nested; any other call of SUBTOTAL or AGGREGATE in the range is #VALUE! until a Windows run asks Excel what it counts as nested.",
  "cases": [
    {
      "id": "SUBTOTAL-001",
      "source": "documented",
      "description": "Microsoft's example: SUBTOTAL(9) is the SUM of A2:A5",
      "cells": {"A2": "120", "A3": "10", "A4": "150", "A5": "23", "ZZ1000": "=SUBTOTAL(9,A2:A5)"},
      "check": "ZZ1000",
      "expect": {"value2": 303}
    },
    {
      "id": "SUBTOTAL-002",
      "source": "documented",
      "description": "Microsoft's example: SUBTOTAL(1) is the AVERAGE of A2:A5",
      "cells": {"A2": "120", "A3": "10", "A4": "150", "A5": "23", "ZZ1000": "=SUBTOTAL(1,A2:A5)"},
      "check": "ZZ1000",
      "expect": {"value2": 75.75}
    },
    {
      "id": "SUBTOTAL-003",
      "source": "documented",
      "description": "With no row hidden, 109 gives what 9 gives",
      "cells": {"A2": "120", "A3": "10", "A4": "150", "A5": "23", "ZZ1000": "=SUBTOTAL(109,A2:A5)"},
      "check": "ZZ1000",
      "expect": {"value2": 303}
    },
    {
      "id": "SUBTOTAL-004",
      "source": "documented",
      "description": "With no row hidden, 101 gives what 1 gives",
      "cells": {"A2": "120", "A3": "10", "A4": "150", "A5": "23", "ZZ1000": "=SUBTOTAL(101,A2:A5)"},
      "check": "ZZ1000",
      "expect": {"value2": 75.75}
    },
    {
      "id": "SUBTOTAL-005",
      "source": "documented",
      "description": "Worked from Microsoft's definitions: 1 is AVERAGE: a range's numbers only, text, booleans and blanks passed over",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=SUBTOTAL(1,A1:A7)"},
      "check": "ZZ1000",
      "expect": {"value2": 2.3333333333333335, "digits": 12}
    },
    {
      "id": "SUBTOTAL-006",
      "source": "documented",
      "description": "Worked from Microsoft's definitions: 2 is COUNT: a range's numbers only",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=SUBTOTAL(2,A1:A7)"},
      "check": "ZZ1000",
      "expect": {"value2": 3}
    },
    {
      "id": "SUBTOTAL-007",
      "source": "documented",
      "description": "Worked from Microsoft's definitions: 3 is COUNTA: every cell that is not blank",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=SUBTOTAL(3,A1:A7)"},
      "check": "ZZ1000",
      "expect": {"value2": 6}
    },
    {
      "id": "SUBTOTAL-008",
      "source": "documented",
      "description": "Worked from Microsoft's definitions: 4 is MAX",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=SUBTOTAL(4,A1:A7)"},
      "check": "ZZ1000",
      "expect": {"value2": 4}
    },
    {
      "id": "SUBTOTAL-009",
      "source": "documented",
      "description": "Worked from Microsoft's definitions: 5 is MIN",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=SUBTOTAL(5,A1:A7)"},
      "check": "ZZ1000",
      "expect": {"value2": 1}
    },
    {
      "id": "SUBTOTAL-010",
      "source": "documented",
      "description": "Worked from Microsoft's definitions: 6 is PRODUCT",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=SUBTOTAL(6,A1:A7)"},
      "check": "ZZ1000",
      "expect": {"value2": 8}
    },
    {
      "id": "SUBTOTAL-011",
      "source": "documented",
      "description": "Worked from Microsoft's definitions: 7 is STDEV, the sample's",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=SUBTOTAL(7,A1:A7)"},
      "check": "ZZ1000",
      "expect": {"value2": 1.5275252316519468, "digits": 12}
    },
    {
      "id": "SUBTOTAL-012",
      "source": "documented",
