    {
      "id": "ISNA-005",
      "source": "uncertain",
      "description": "ISNA over a range where one Value is wanted is refused",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=ISNA(A1:A2)"},
      "check": "ZZ1000",
      "expect": {"value2": "#VALUE!"},
      "engineDiffersByDecision": "ADR-0125: functions are not lifted over arrays yet; an array where the function wants one Value is #VALUE!, where Excel 365 lifts it and spills",
      "excelExpect": {"value2": false}
    }
