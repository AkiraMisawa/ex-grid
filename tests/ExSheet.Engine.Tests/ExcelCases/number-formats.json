{
  "area": "number-formats",
  "about": "Number format codes as Excel renders them, read back as Range.Text (ADR-0016, ADR-0046, ADR-0047). A Value its format cannot show is ####.",
  "cases": [
    {
      "id": "FMT-001",
      "source": "observed",
      "description": "Number, percent and thousands codes render as Excel's",
      "cells": {"A1": "1234.567"},
      "formats": {"A1": "0.00"},
      "check": "A1",
      "expect": {"text": "1234.57"}
    },
    {
      "id": "FMT-002",
      "source": "observed",
      "description": "Number, percent and thousands codes render as Excel's",
      "cells": {"A1": "1234.567"},
      "formats": {"A1": "#,##0.00"},
      "check": "A1",
      "expect": {"text": "1,234.57"}
    },
