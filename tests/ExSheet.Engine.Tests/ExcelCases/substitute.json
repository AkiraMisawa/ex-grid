      "description": "Microsoft's example: every occurrence",
      "cells": {"A1": "Sales Data", "ZZ1000": "=SUBSTITUTE(A1,\"Sales\",\"Cost\")"},
      "check": "ZZ1000",
      "expect": {"value2": "Cost Data"}
    },
    {
      "id": "SUBSTITUTE-002",
      "source": "documented",
      "description": "Microsoft's example: the first occurrence only",
      "cells": {"A1": "Quarter 1, 2008", "ZZ1000": "=SUBSTITUTE(A1,\"1\",\"2\",1)"},
      "check": "ZZ1000",
      "expect": {"value2": "Quarter 2, 2008"}
    },
    {
      "id": "SUBSTITUTE-003",
      "source": "documented",
      "description": "Microsoft's example: the third occurrence only",
