{
  "area": "date",
  "about": "DATE (docs/specs/exsheet-functions): serials in Excel's 1900 date system.",
  "cases": [
    {
      "id": "DATEFN-001",
      "source": "documented",
      "description": "Microsoft's example: 1 January 2011",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=DATE(2011,1,1)"},
      "check": "ZZ1000",
      "expect": {"value2": 40544}
    },
    {
      "id": "DATEFN-002",
      "source": "documented",
      "description": "A year from 0 to 1899 has 1900 added: 108 is 2008",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=DATE(108,1,2)"},
      "check": "ZZ1000",
      "expect": {"value2": 39449}
    },
    {
      "id": "DATEFN-003",
      "source": "documented",
      "description": "A month past 12 rolls into the next year",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=DATE(2008,14,2)"},
      "check": "ZZ1000",
      "expect": {"value2": 39846}
    },
    {
      "id": "DATEFN-004",
      "source": "documented",
      "description": "A month below 1 rolls into the year before",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=DATE(2008,-3,2)"},
      "check": "ZZ1000",
      "expect": {"value2": 39327}
    },
    {
      "id": "DATEFN-005",
      "source": "documented",
      "description": "A day past the month rolls into the next month",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=DATE(2008,1,35)"},
      "check": "ZZ1000",
      "expect": {"value2": 39482}
    },
    {
      "id": "DATEFN-006",
      "source": "documented",
      "description": "A day below 1 rolls into the month before",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=DATE(2008,1,-15)"},
      "check": "ZZ1000",
      "expect": {"value2": 39432}
    },
    {
      "id": "DATEFN-007",
      "source": "documented",
      "description": "A year of 10000 is #NUM!",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=DATE(10000,1,1)"},
      "check": "ZZ1000",
      "expect": {"value2": "#NUM!"}
    },
    {
      "id": "DATEFN-008",
      "source": "documented",
      "description": "A year below 0 is #NUM!",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=DATE(-1,1,1)"},
      "check": "ZZ1000",
      "expect": {"value2": "#NUM!"}
    },
    {
      "id": "DATEFN-009",
      "source": "documented",
      "description": "A year of 1899 has 1900 added: 3799",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=DATE(1899,1,1)"},
      "check": "ZZ1000",
      "expect": {"value2": 693598}
    },
    {
      "id": "DATEFN-010",
      "source": "uncertain",
      "description": "Engine's answer, Excel to be asked: 29 February 1900 is serial 60",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=DATE(1900,2,29)"},
      "check": "ZZ1000",
      "expect": {"value2": 60}
    },
    {
      "id": "DATEFN-011",
      "source": "uncertain",
      "description": "Engine's answer, Excel to be asked: 1 March 1900 is serial 61",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=DATE(1900,3,1)"},
      "check": "ZZ1000",
      "expect": {"value2": 61}
    },
    {
      "id": "DATEFN-012",
      "source": "uncertain",
      "description": "Engine's answer, Excel to be asked: 30 February 1900 rolls to 1 March on Excel's calendar",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=DATE(1900,2,30)"},
      "check": "ZZ1000",
      "expect": {"value2": 61}
    },
    {
      "id": "DATEFN-013",
      "source": "uncertain",
      "description": "Engine's answer, Excel to be asked: 0 January 1900 is serial 0",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=DATE(1900,1,0)"},
      "check": "ZZ1000",
      "expect": {"value2": 0}
    },
    {
      "id": "DATEFN-014",
      "source": "uncertain",
      "description": "Engine's answer, Excel to be asked: a day before serial 0 is #NUM!",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=DATE(1900,1,-1)"},
      "check": "ZZ1000",
      "expect": {"value2": "#NUM!"}
    },
    {
      "id": "DATEFN-015",
      "source": "uncertain",
      "description": "Engine's answer, Excel to be asked: 31 December 9999 is the last serial",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=DATE(9999,12,31)"},
      "check": "ZZ1000",
      "expect": {"value2": 2958465}
    },
    {
      "id": "DATEFN-016",
      "source": "uncertain",
      "description": "Engine's answer, Excel to be asked: past 31 December 9999 is #NUM!",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=DATE(9999,12,32)"},
      "check": "ZZ1000",
      "expect": {"value2": "#NUM!"}
    },
    {
      "id": "DATEFN-017",
      "source": "uncertain",
      "description": "Engine's answer, Excel to be asked: a fractional year is truncated",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=DATE(2026.9,1,1)"},
      "check": "ZZ1000",
      "expect": {"value2": 46023}
    }
  ]
}
