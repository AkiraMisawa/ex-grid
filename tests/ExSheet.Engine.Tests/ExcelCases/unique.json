{
  "area": "unique",
  "about": "UNIQUE (ADR-0125): the distinct rows or columns of an array; it spills.",
  "cases": [
    {
      "id": "UNIQUE-001",
      "source": "observed",
      "description": "The distinct values, in the order they first appear",
      "fixture": "lookupData",
      "cells": {"ZZ1000": "=UNIQUE(G1:G5)"},
      "check": "ZZ1003",
      "expect": {"value2": "Date", "kind": "text"}
    },
    {
      "id": "UNIQUE-002",
      "source": "observed",
      "description": "Four distinct values of five",
      "fixture": "lookupData",
      "cells": {"ZZ1000": "=ROWS(UNIQUE(G1:G5))"},
      "check": "ZZ1000",
      "expect": {"value2": 4}
    },
    {
      "id": "UNIQUE-003",
      "source": "observed",
      "description": "exactly_once keeps only the values that appear once",
      "fixture": "lookupData",
      "cells": {"ZZ1000": "=UNIQUE(G1:G5,,TRUE)"},
      "check": "ZZ1001",
      "expect": {"value2": "Cherry", "kind": "text"}
    },
    {
      "id": "UNIQUE-004",
      "source": "observed",
      "description": "by_col compares columns",
      "fixture": "lookupData",
      "cells": {"Z1": "1", "AA1": "2", "AB1": "1", "ZZ1000": "=COLUMNS(UNIQUE(Z1:AB1,TRUE))"},
      "check": "ZZ1000",
      "expect": {"value2": 2}
    },
    {
      "id": "UNIQUE-005",
      "source": "observed",
      "description": "Rows of two columns are compared whole",
      "fixture": "lookupData",
      "cells": {"Z1": "a", "AA1": "1", "Z2": "a", "AA2": "2", "Z3": "a", "AA3": "1", "ZZ1000": "=ROWS(UNIQUE(Z1:AA3))"},
      "check": "ZZ1000",
      "expect": {"value2": 2}
    },
    {
      "id": "UNIQUE-006",
      "source": "observed",
      "description": "Nothing that appears once is #CALC!",
      "fixture": "lookupData",
      "cells": {"Z1": "1", "Z2": "1", "ZZ1000": "=UNIQUE(Z1:Z2,,TRUE)"},
      "check": "ZZ1000",
      "expect": {"value2": "#CALC!"}
    },
    {
      "id": "UNIQUE-007",
      "source": "observed",
      "description": "Engine's answer, Excel to be asked: text is compared without regard to case",
      "fixture": "lookupData",
      "cells": {"Z1": "a", "Z2": "A", "ZZ1000": "=ROWS(UNIQUE(Z1:Z2))"},
      "check": "ZZ1000",
      "expect": {"value2": 1}
    },
    {
      "id": "UNIQUE-008",
      "source": "observed",
      "description": "Engine's answer, Excel to be asked: a number and text that reads as it are different",
      "fixture": "lookupData",
      "cells": {"Z1": "1", "Z2": "'1", "ZZ1000": "=ROWS(UNIQUE(Z1:Z2))"},
      "check": "ZZ1000",
      "expect": {"value2": 2}
    },
    {
      "id": "UNIQUE-009",
      "source": "observed",
      "description": "A blank in the array: the Anchor shows the 7 that comes first",
      "fixture": "lookupData",
      "cells": {"ZZ1000": "=UNIQUE(Q1:Q2)"},
      "check": "ZZ1000",
      "expect": {"value2": 7}
    },
    {
      "id": "UNIQUE-010",
      "source": "observed",
      "description": "A blank's spilled cell, below the 7 of UNIQUE-009, shows 0",
      "fixture": "lookupData",
      "cells": {"ZZ1000": "=UNIQUE(Q1:Q2)"},
      "check": "ZZ1001",
      "expect": {"value2": 0}
    },
    {
      "id": "UNIQUE-011",
      "source": "observed",
      "description": "A blank is not one of a kind with 0: two rows",
      "cells": {"A1": "0", "ZZ1000": "=ROWS(UNIQUE(A1:A2))"},
      "check": "ZZ1000",
      "expect": {"value2": 2}
    },
    {
      "id": "UNIQUE-012",
      "source": "uncertain",
      "description": "Engine's answer, Excel to be asked: two blanks are one of a kind, so two rows of three",
      "cells": {"A3": "1", "ZZ1000": "=ROWS(UNIQUE(A1:A3))"},
      "check": "ZZ1000",
      "expect": {"value2": 2}
    },
    {
      "id": "UNIQUE-013",
      "source": "uncertain",
      "description": "Engine's answer, Excel to be asked: a blank is not one of a kind with empty text (1 if it is)",
      "cells": {"A2": "=\"\"", "ZZ1000": "=ROWS(UNIQUE(A1:A2))"},
      "check": "ZZ1000",
      "expect": {"value2": 2}
    },
    {
      "id": "UNIQUE-014",
      "source": "uncertain",
      "description": "Engine's answer, Excel to be asked: exactly_once leaves out two blanks, so only the 1 is left",
      "cells": {"A3": "1", "ZZ1000": "=UNIQUE(A1:A3,,TRUE)"},
      "check": "ZZ1000",
      "expect": {"value2": 1}
    },
    {
      "id": "UNIQUE-015",
      "source": "uncertain",
      "description": "Engine's answer, Excel to be asked: rows compared whole, a row with a blank differs from the same row with 0",
      "cells": {"A1": "a", "A2": "a", "B2": "0", "ZZ1000": "=ROWS(UNIQUE(A1:B2))"},
      "check": "ZZ1000",
      "expect": {"value2": 2}
    },
    {
      "id": "UNIQUE-016",
      "source": "uncertain",
      "description": "Engine's answer, Excel to be asked: one blank cell spills as 0",
      "fixture": "lookupData",
      "cells": {"ZZ1000": "=UNIQUE(Q2)"},
      "check": "ZZ1000",
      "expect": {"value2": 0}
    },
    {
      "id": "UNIQUE-017",
      "source": "uncertain",
      "description": "Refused until Excel is asked: a blank in UNIQUE's array read inside the Formula is #VALUE!; COUNTA would be 2 if it counts as the 0 it spills as, 1 if as a blank",
      "fixture": "lookupData",
      "cells": {"ZZ1000": "=COUNTA(UNIQUE(Q1:Q2))"},
      "check": "ZZ1000",
      "expect": {"value2": "#VALUE!"}
    },
    {
      "id": "UNIQUE-018",
      "source": "uncertain",
      "description": "Refused until Excel is asked: a blank in UNIQUE's array read inside the Formula is #VALUE!; compared with empty text it would be TRUE if it is still a blank, FALSE if it is the 0 it spills as",
      "fixture": "lookupData",
      "cells": {"ZZ1000": "=INDEX(UNIQUE(Q1:Q2),2)=\"\""},
      "check": "ZZ1000",
      "expect": {"value2": "#VALUE!"}
    },
    {
      "id": "UNIQUE-019",
      "source": "uncertain",
      "description": "Refused until Excel is asked: a blank in UNIQUE's array read inside the Formula is #VALUE!; over a, a blank and b the count would be 2 if LEN reads the blank as empty, 3 if as the 0 it spills as",
      "cells": {"A1": "a", "A3": "b", "ZZ1000": "=SUM(--(LEN(UNIQUE(A1:A3))>0))"},
      "check": "ZZ1000",
      "expect": {"value2": "#VALUE!"}
    }
  ]
}
