{
  "area": "index",
  "about": "INDEX, its array form (docs/specs/exsheet-functions).",
  "cases": [
    {
      "id": "INDEX-001",
      "source": "observed",
      "description": "Microsoft's example: the second row and second column",
      "cells": {"A1": "Apples", "B1": "Lemons", "A2": "Bananas", "B2": "Pears", "ZZ1000": "=INDEX(A1:B2,2,2)"},
      "check": "ZZ1000",
      "expect": {"value2": "Pears"}
    },
    {
      "id": "INDEX-002",
      "source": "observed",
      "description": "Microsoft's example: the second row and first column",
      "cells": {"A1": "Apples", "B1": "Lemons", "A2": "Bananas", "B2": "Pears", "ZZ1000": "=INDEX(A1:B2,2,1)"},
      "check": "ZZ1000",
      "expect": {"value2": "Bananas"}
    },
    {
      "id": "INDEX-003",
      "source": "observed",
      "description": "A row and a column inside the range",
      "fixture": "lookupData",
      "cells": {"ZZ1000": "=INDEX(G1:H5,3,2)"},
      "check": "ZZ1000",
      "expect": {"value2": 30}
    },
    {
      "id": "INDEX-004",
      "source": "observed",
      "description": "Over one column, column_num may be left out",
      "fixture": "lookupData",
      "cells": {"ZZ1000": "=INDEX(G1:G5,4)"},
      "check": "ZZ1000",
      "expect": {"value2": "Banana"}
    },
    {
      "id": "INDEX-005",
      "source": "observed",
      "description": "A row past the range is #REF!",
      "fixture": "lookupData",
      "cells": {"ZZ1000": "=INDEX(G1:H5,6,1)"},
      "check": "ZZ1000",
      "expect": {"value2": "#REF!"}
    },
    {
      "id": "INDEX-006",
      "source": "observed",
      "description": "A column past the range is #REF!",
      "fixture": "lookupData",
      "cells": {"ZZ1000": "=INDEX(G1:H5,1,3)"},
      "check": "ZZ1000",
      "expect": {"value2": "#REF!"}
    },
    {
      "id": "INDEX-007",
      "source": "observed",
      "description": "Engine's answer, Excel to be asked: over one row, row_num alone runs along it",
      "fixture": "lookupData",
      "cells": {"ZZ1000": "=INDEX(M1:O1,2)"},
      "check": "ZZ1000",
      "expect": {"value2": "y"}
    },
    {
      "id": "INDEX-008",
      "source": "observed",
      "description": "Engine's answer, Excel to be asked: a negative row is #VALUE!",
      "fixture": "lookupData",
      "cells": {"ZZ1000": "=INDEX(G1:H5,-1,1)"},
      "check": "ZZ1000",
      "expect": {"value2": "#VALUE!"}
    },
    {
      "id": "INDEX-009",
      "source": "observed",
      "description": "Engine's answer, Excel to be asked: column 0 of one column is that column",
      "fixture": "lookupData",
      "cells": {"ZZ1000": "=INDEX(G1:G5,3,0)"},
      "check": "ZZ1000",
      "expect": {"value2": "Cherry"}
    },
    {
      "id": "INDEX-010",
      "source": "observed",
      "description": "Engine's answer, Excel to be asked: a blank cell reads as 0 in a Formula's result",
      "fixture": "lookupData",
      "cells": {"ZZ1000": "=INDEX(Q1:Q2,2)"},
      "check": "ZZ1000",
      "expect": {"value2": 0}
    },
    {
      "id": "INDEX-011",
      "source": "observed",
      "description": "Engine's answer, Excel to be asked: row_num is truncated",
      "fixture": "lookupData",
      "cells": {"ZZ1000": "=INDEX(H1:H5,2.9)"},
      "check": "ZZ1000",
      "expect": {"value2": 20}
    },
    {
      "id": "INDEX-012",
      "source": "observed",
      "description": "Over a Reference of several rows and several columns, column_num cannot be left out: #REF!, as the seventeenth Windows run observed",
      "fixture": "lookupData",
      "cells": {"ZZ1000": "=INDEX(G1:H5,2)"},
      "check": "ZZ1000",
      "expect": {"value2": "#REF!"}
    },
    {
      "id": "INDEX-013",
      "source": "observed",
      "description": "A whole column of several cells spills; the anchor shows its first",
      "fixture": "lookupData",
      "cells": {"ZZ1000": "=INDEX(G1:H5,0,2)"},
      "check": "ZZ1000",
      "expect": {"value2": 10}
    },
    {
      "id": "INDEX-014",
      "source": "observed",
      "description": "Microsoft's documentation: over an array of several rows and several columns, row_num alone is the whole row, which spills; the anchor shows its first",
      "cells": {"ZZ1000": "=INDEX(SEQUENCE(2,2),2)"},
      "check": "ZZ1000",
      "expect": {"value2": 3}
    },
    {
      "id": "INDEX-015",
      "source": "observed",
      "description": "Engine's answer, Excel to be asked: column_num given but left empty is 0, the whole row, which spills; the anchor shows its first",
      "fixture": "lookupData",
      "cells": {"ZZ1000": "=INDEX(G1:H5,2,)"},
      "check": "ZZ1000",
      "expect": {"value2": "Banana"}
    },
    {
      "id": "INDEX-016",
      "source": "observed",
      "description": "Engine's answer, Excel to be asked: column_num left out over a Reference of several rows and several columns is #REF! for a row of 0 too",
      "fixture": "lookupData",
      "cells": {"ZZ1000": "=INDEX(G1:H5,0)"},
      "check": "ZZ1000",
      "expect": {"value2": "#REF!"}
    },
    {
      "id": "INDEX-017",
      "source": "observed",
      "description": "Engine's answer, Excel to be asked: a Spill Range of several rows and several columns is a Reference, as G1:H5 is, so column_num left out is #REF!, the rule INDEX-012 observed for a typed range",
      "cells": {"J1": "=SEQUENCE(2,2)", "ZZ1000": "=INDEX(J1#,2)"},
      "check": "ZZ1000",
      "expect": {"value2": "#REF!"}
    },
    {
      "id": "INDEX-018",
      "source": "observed",
      "description": "Engine's answer, Excel to be asked: the Spill Range INDIRECT's text names is the Reference J1# typed is, so column_num left out is #REF!, the rule INDEX-012 observed for a typed range",
      "cells": {"J1": "=SEQUENCE(2,2)", "ZZ1000": "=INDEX(INDIRECT(\"J1#\"),2)"},
      "check": "ZZ1000",
      "expect": {"value2": "#REF!"}
    }
  ]
}
