{
  "area": "sort",
  "about": "SORT (ADR-0125): an array ordered by one of its columns or rows; it spills.",
  "cases": [
    {
      "id": "SORT-001",
      "source": "observed",
      "description": "Descending: the largest first",
      "fixture": "lookupData",
      "cells": {"ZZ1000": "=SORT(H1:H5,1,-1)"},
      "check": "ZZ1000",
      "expect": {"value2": 50}
    },
    {
      "id": "SORT-002",
      "source": "observed",
      "description": "Descending: the smallest last",
      "fixture": "lookupData",
      "cells": {"ZZ1000": "=SORT(H1:H5,1,-1)"},
      "check": "ZZ1004",
      "expect": {"value2": 10}
    },
    {
      "id": "SORT-003",
      "source": "observed",
      "description": "By the first column, ascending, when nothing more is given",
      "fixture": "lookupData",
      "cells": {"ZZ1000": "=SORT(G1:H5)"},
      "check": "ZZ1001",
      "expect": {"value2": "Banana", "kind": "text"}
    },
    {
      "id": "SORT-004",
      "source": "observed",
      "description": "Equal keys keep their order",
      "fixture": "lookupData",
      "cells": {"ZZ1000": "=SORT(G1:H5)"},
      "check": "AAA1002",
      "expect": {"value2": 40}
    },
    {
      "id": "SORT-005",
      "source": "observed",
      "description": "By the second column, descending",
      "fixture": "lookupData",
      "cells": {"ZZ1000": "=SORT(G1:H5,2,-1)"},
      "check": "ZZ1000",
      "expect": {"value2": "Date", "kind": "text"}
    },
    {
      "id": "SORT-006",
      "source": "observed",
      "description": "by_col sorts the columns by a row",
      "fixture": "lookupData",
      "cells": {"ZZ1000": "=SORT(M1:O2,2,-1,TRUE)"},
      "check": "ZZ1000",
      "expect": {"value2": "z", "kind": "text"}
    },
    {
      "id": "SORT-007",
      "source": "observed",
      "description": "An index past the array is #VALUE!",
      "fixture": "lookupData",
      "cells": {"ZZ1000": "=SORT(G1:H5,3)"},
      "check": "ZZ1000",
      "expect": {"value2": "#VALUE!"}
    },
    {
      "id": "SORT-008",
      "source": "observed",
      "description": "An order other than 1 and -1 is #VALUE!",
      "fixture": "lookupData",
      "cells": {"ZZ1000": "=SORT(H1:H5,1,0)"},
      "check": "ZZ1000",
      "expect": {"value2": "#VALUE!"}
    },
    {
      "id": "SORT-009",
      "source": "observed",
      "description": "Engine's answer, Excel to be asked: text sorts without regard to case",
      "fixture": "binaryData",
      "cells": {"ZZ1000": "=SORT(D1:D5,1,-1)"},
      "check": "ZZ1000",
      "expect": {"value2": "fig", "kind": "text"}
    },
    {
      "id": "SORT-010",
      "source": "observed",
      "description": "Engine's answer, Excel to be asked: numbers sort before text, and text before booleans",
      "fixture": "lookupData",
      "cells": {"Z1": "b", "Z2": "1", "Z3": "TRUE", "ZZ1000": "=SORT(Z1:Z3)"},
      "check": "ZZ1001",
      "expect": {"value2": "b", "kind": "text"}
    },
    {
      "id": "SORT-011",
      "source": "observed",
      "description": "A blank key sorts after the 7, so the Anchor shows 7",
      "fixture": "lookupData",
      "cells": {"ZZ1000": "=SORT(Q1:Q2)"},
      "check": "ZZ1000",
      "expect": {"value2": 7}
    },
    {
      "id": "SORT-012",
      "source": "observed",
      "description": "A blank key's spilled cell, below the 7 of SORT-011, shows 0",
      "fixture": "lookupData",
      "cells": {"ZZ1000": "=SORT(Q1:Q2)"},
      "check": "ZZ1001",
      "expect": {"value2": 0}
    },
    {
      "id": "SORT-013",
      "source": "observed",
      "description": "In a descending sort a blank key is still last, so the 7 comes first",
      "fixture": "lookupData",
      "cells": {"ZZ1000": "=SORT(Q1:Q2,1,-1)"},
      "check": "ZZ1000",
      "expect": {"value2": 7}
    },
    {
      "id": "SORT-014",
      "source": "observed",
      "description": "A blank key among text sorts last, neither as empty text nor as 0, either of which would come first",
      "cells": {"A1": "b", "A3": "a", "ZZ1000": "=SORT(A1:A3)"},
      "check": "ZZ1000",
      "expect": {"value2": "a", "kind": "text"}
    },
    {
      "id": "SORT-015",
      "source": "uncertain",
      "description": "Refused until Excel is asked: an Error Value among the keys is #VALUE! (where Excel sorts it, or whether it is the result)",
      "cells": {"A1": "7", "A2": "=NA()", "ZZ1000": "=SORT(A1:A2)"},
      "check": "ZZ1000",
      "expect": {"value2": "#VALUE!"}
    },
    {
      "id": "SORT-016",
      "source": "observed",
      "description": "Engine's answer, Excel to be asked: in a descending sort of text a blank key is still last, so b comes first",
      "cells": {"A1": "b", "A3": "a", "ZZ1000": "=SORT(A1:A3,1,-1)"},
      "check": "ZZ1000",
      "expect": {"value2": "b", "kind": "text"}
    },
    {
      "id": "SORT-017",
      "source": "observed",
      "description": "Engine's answer, Excel to be asked: in a descending sort of text the blank key's cell is the last and shows 0",
      "cells": {"A1": "b", "A3": "a", "ZZ1000": "=SORT(A1:A3,1,-1)"},
      "check": "ZZ1002",
      "expect": {"value2": 0}
    },
    {
      "id": "SORT-018",
      "source": "observed",
      "description": "Engine's answer, Excel to be asked: a blank key sorts after a boolean too, so TRUE is second",
      "cells": {"A1": "1", "A3": "TRUE", "ZZ1000": "=SORT(A1:A3)"},
      "check": "ZZ1001",
      "expect": {"value2": true}
    },
    {
      "id": "SORT-019",
      "source": "observed",
      "description": "Engine's answer, Excel to be asked: after a number and a boolean the blank key is last and shows 0",
      "cells": {"A1": "1", "A3": "TRUE", "ZZ1000": "=SORT(A1:A3)"},
      "check": "ZZ1002",
      "expect": {"value2": 0}
    },
    {
      "id": "SORT-020",
      "source": "observed",
      "description": "Engine's answer, Excel to be asked: by_col, a blank key in the row sorts its column last, which shows 0",
      "cells": {"A1": "2", "C1": "1", "ZZ1000": "=SORT(A1:C1,1,1,TRUE)"},
      "check": "AAB1000",
      "expect": {"value2": 0}
    },
    {
      "id": "SORT-021",
      "source": "uncertain",
      "description": "Refused until Excel is asked: a blank in SORT's array read inside the Formula is #VALUE!; COUNTA would be 2 if it counts as the 0 it spills as, 1 if as a blank",
      "fixture": "lookupData",
      "cells": {"ZZ1000": "=COUNTA(SORT(Q1:Q2))"},
      "check": "ZZ1000",
      "expect": {"value2": "#VALUE!"}
    },
    {
      "id": "SORT-022",
      "source": "uncertain",
      "description": "Refused until Excel is asked: a blank in SORT's array read inside the Formula is #VALUE!; ISBLANK of the sorted blank would be TRUE if it is still a blank, FALSE if it is the 0 it spills as",
      "fixture": "lookupData",
      "cells": {"ZZ1000": "=ISBLANK(INDEX(SORT(Q1:Q2),2))"},
      "check": "ZZ1000",
      "expect": {"value2": "#VALUE!"}
    },
    {
      "id": "SORT-023",
      "source": "observed",
      "description": "Engine's answer, Excel to be asked: in a descending sort two blank keys keep their order, so x is second, after the 1's z",
      "cells": {"B1": "x", "B2": "y", "A3": "1", "B3": "z", "ZZ1000": "=SORT(A1:B3,1,-1)"},
      "check": "AAA1001",
      "expect": {"value2": "x", "kind": "text"}
    },
    {
      "id": "SORT-024",
      "source": "observed",
      "description": "Engine's answer, Excel to be asked: over b, a blank and a, b is second, after the a of SORT-014",
      "cells": {"A1": "b", "A3": "a", "ZZ1000": "=SORT(A1:A3)"},
      "check": "ZZ1001",
      "expect": {"value2": "b", "kind": "text"}
    },
    {
      "id": "SORT-025",
      "source": "observed",
      "description": "Engine's answer, Excel to be asked: over b, a blank and a, the blank key is last and its cell shows 0",
      "cells": {"A1": "b", "A3": "a", "ZZ1000": "=SORT(A1:A3)"},
      "check": "ZZ1002",
      "expect": {"value2": 0}
    }
  ]
}
