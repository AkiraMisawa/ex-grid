      "cells": {"ZZ1000": "=WEEKDAY(1)"},
      "check": "ZZ1000",
      "expect": {"value2": 1}
    },
    {
      "id": "WEEKDAY-006",
      "source": "uncertain",
      "description": "Engine's answer, Excel to be asked: serial 0 is a Saturday",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=WEEKDAY(0)"},
      "check": "ZZ1000",
      "expect": {"value2": 7}
    },
    {
      "id": "WEEKDAY-007",
      "source": "uncertain",
