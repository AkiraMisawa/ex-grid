  "cases": [
    {
      "id": "WEEKDAY-001",
      "source": "documented",
      "description": "Microsoft's example: 14 February 2008 is a Thursday, 5 from Sunday",
      "cells": {"A1": "2/14/2008", "ZZ1000": "=WEEKDAY(A1)"},
      "check": "ZZ1000",
      "expect": {"value2": 5}
    },
    {
      "id": "WEEKDAY-002",
      "source": "documented",
      "description": "Microsoft's example: 4 from Monday",
      "cells": {"A1": "2/14/2008", "ZZ1000": "=WEEKDAY(A1,2)"},
      "check": "ZZ1000",
      "expect": {"value2": 4}
    },
    {
      "id": "WEEKDAY-003",
      "source": "documented",
      "description": "Microsoft's example: 3 from Monday at 0",
      "cells": {"A1": "2/14/2008", "ZZ1000": "=WEEKDAY(A1,3)"},
      "check": "ZZ1000",
      "expect": {"value2": 3}
    },
    {
