{
  "area": "formula-formats",
  "about": "The format a Formula gives a General cell when it is entered (ADR-0047, second round). Excel is widely observed to give a Formula in simple arithmetic the format of the first formatted cell it reads, so that a date plus a number shows as a date; Microsoft does not document the rule for any function ExSheet declares (it does for DATE, TODAY and NOW, which ExSheet does not have). Every case is therefore uncertain until the oracle asks Excel. The engine applies the rule only to Formulas made of single-cell References, constants, + and - and parentheses, only when the cell's format is General, and only when the Formula is entered; the cases where it gives no format (multiplication, functions, &) record the engine's answer, and Excel may give one there.",
  "cases": [
    {
      "id": "FF-001",
      "source": "observed",
      "description": "A date plus a number shows as a date",
      "cells": {"A1": "9/26/2026"},
      "action": {"do": "enter", "cells": {"B1": "=A1+7"}},
      "check": "B1",
      "expect": {"value2": 46298, "text": "10/3/2026", "numberFormat": "m/d/yyyy"}
    },
    {
      "id": "FF-002",
      "source": "observed",
      "description": "A number plus a date shows as a date: the first formatted Reference, not the first operand",
      "cells": {"A1": "9/26/2026"},
      "action": {"do": "enter", "cells": {"B1": "=7+A1"}},
      "check": "B1",
      "expect": {"text": "10/3/2026", "numberFormat": "m/d/yyyy"}
    },
    {
      "id": "FF-003",
      "source": "uncertain",
      "description": "A date minus a date shows as a date, the number of days read as a serial",
      "cells": {"A1": "9/26/2026", "A2": "9/20/2026"},
      "action": {"do": "enter", "cells": {"B1": "=A1-A2"}},
      "check": "B1",
      "expect": {"value2": 6, "text": "1/6/1900", "numberFormat": "m/d/yyyy"}
    },
    {
      "id": "FF-004",
      "source": "observed",
      "description": "A Formula that is one Reference takes that cell's format",
      "cells": {"A1": "9/26/2026"},
      "action": {"do": "enter", "cells": {"B1": "=A1"}},
      "check": "B1",
      "expect": {"text": "9/26/2026", "numberFormat": "m/d/yyyy"}
    },
    {
      "id": "FF-005",
      "source": "observed",
      "description": "A negated Reference in parentheses takes that cell's format",
      "cells": {"A1": "12.5%"},
      "action": {"do": "enter", "cells": {"B1": "=-(A1)+1"}},
      "check": "B1",
      "expect": {"text": "87.50%", "numberFormat": "0.00%"}
    },
    {
      "id": "FF-006",
      "source": "observed",
      "description": "The first Reference whose cell is formatted gives the format, an unformatted one before it passed over",
      "cells": {"A1": "5", "A2": "10%"},
      "action": {"do": "enter", "cells": {"B1": "=A1+A2"}},
      "check": "B1",
      "expect": {"text": "510%", "numberFormat": "0%"}
    },
    {
      "id": "FF-007",
      "source": "observed",
      "description": "A cell formatted before the Formula is entered keeps its format",
      "cells": {"A1": "9/26/2026"},
      "action": [
        {"do": "format", "range": "B1", "format": "0.00"},
        {"do": "enter", "cells": {"B1": "=A1+1"}}
      ],
      "check": "B1",
      "expect": {"text": "46292.00", "numberFormat": "0.00"}
    },
    {
      "id": "FF-008",
      "source": "observed",
      "description": "The format is taken once, at entry: formatting the cell read afterwards does not change it",
      "cells": {"A1": "5"},
      "action": [
        {"do": "enter", "cells": {"B1": "=A1+1"}},
        {"do": "format", "range": "A1", "format": "0.00"}
      ],
      "check": "B1",
      "expect": {"text": "6", "numberFormat": "General"}
    },
    {
      "id": "FF-009",
      "source": "observed",
      "description": "A cell read in a formatted column gives the column's format",
      "cells": {"A5": "3"},
      "action": [
        {"do": "format", "range": "A:A", "format": "0.00"},
        {"do": "enter", "cells": {"C5": "=A5+1"}}
      ],
      "check": "C5",
      "expect": {"text": "4.00", "numberFormat": "0.00"}
    },
    {
      "id": "FF-010",
      "source": "observed",
      "description": "A Formula pasted as text takes a format as a typed one does",
      "cells": {"A1": "9/26/2026"},
      "action": {"do": "pasteText", "rows": [["=A1+1"]], "at": "B1"},
      "check": "B1",
      "expect": {"text": "9/27/2026", "numberFormat": "m/d/yyyy"}
    },
    {
      "id": "FF-011",
      "source": "observed",
      "description": "Engine's answer, Excel to be asked: multiplication gives no format",
      "cells": {"A1": "9/26/2026"},
      "action": {"do": "enter", "cells": {"B1": "=A1*1"}},
      "check": "B1",
      "expect": {"text": "46291", "numberFormat": "General"}
    },
    {
      "id": "FF-012",
      "source": "uncertain",
      "description": "Engine's answer, Excel to be asked: a function gives no format",
      "cells": {"A1": "9/26/2026", "A2": "9/27/2026"},
      "action": {"do": "enter", "cells": {"B1": "=MAX(A1:A2)"}},
      "check": "B1",
      "expect": {"text": "46292", "numberFormat": "General"}
    },
    {
      "id": "FF-013",
      "source": "observed",
      "description": "Engine's answer, Excel to be asked: a mixed expression is not simple arithmetic and gives no format",
      "cells": {"A1": "9/26/2026"},
      "action": {"do": "enter", "cells": {"B1": "=A1+2*3"}},
      "check": "B1",
      "expect": {"text": "46297", "numberFormat": "General"}
    },
    {
      "id": "FF-014",
      "source": "observed",
      "description": "Text joined with & gives no format",
      "cells": {"A1": "9/26/2026"},
      "action": {"do": "enter", "cells": {"B1": "=A1&\"\""}},
      "check": "B1",
      "expect": {"value2": "46291", "kind": "text", "numberFormat": "General"}
    },
    {
      "id": "FF-015",
      "source": "observed",
      "description": "Arithmetic on General cells alone gives no format",
      "cells": {"A1": "5", "A2": "6"},
      "action": {"do": "enter", "cells": {"B1": "=A1+A2"}},
      "check": "B1",
      "expect": {"text": "11", "numberFormat": "General"}
    }
  ]
}
