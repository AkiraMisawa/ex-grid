{
  "area": "indirect",
  "about": "INDIRECT (docs/specs/exsheet-functions ticket 18; ADR-0124's note of 2026-10-10): A1-style text naming a cell or a range of the same Sheet, with or without its own qualifier, read as it stands after the recalculation (volatile). Its text is not rewritten by an insertion or a deletion. R1C1 text, a structured reference (a declared Linked Table's bare name included) and A1# are #VALUE!; text that names no place, another Sheet's name included, is #REF!.",
  "cases": [
    {
      "id": "INDIRECT-001",
      "source": "documented",
      "description": "Microsoft's example: the Value of the cell A2's text names (B2)",
      "cells": {"A2": "B2", "A3": "B3", "A4": "George", "A5": "5", "B2": "1.333", "B3": "45", "B4": "10", "B5": "62", "ZZ1000": "=INDIRECT(A2)"},
      "check": "ZZ1000",
      "expect": {"value2": 1.333}
    },
    {
      "id": "INDIRECT-002",
      "source": "documented",
      "description": "Microsoft's example: the Value of the cell A3's text names (B3)",
      "cells": {"A2": "B2", "A3": "B3", "A4": "George", "A5": "5", "B2": "1.333", "B3": "45", "B4": "10", "B5": "62", "ZZ1000": "=INDIRECT(A3)"},
      "check": "ZZ1000",
      "expect": {"value2": 45}
    },
    {
      "id": "INDIRECT-003",
      "source": "documented",
      "description": "Microsoft's example without its defined name: George names no place in this Sheet, so #REF!",
      "cells": {"A2": "B2", "A3": "B3", "A4": "George", "A5": "5", "B2": "1.333", "B3": "45", "B4": "10", "B5": "62", "ZZ1000": "=INDIRECT(A4)"},
      "check": "ZZ1000",
      "expect": {"value2": "#REF!"}
    },
    {
      "id": "INDIRECT-004",
      "source": "documented",
      "description": "Microsoft's example: a reference built from text and A5's value (B5)",
      "cells": {"A2": "B2", "A3": "B3", "A4": "George", "A5": "5", "B2": "1.333", "B3": "45", "B4": "10", "B5": "62", "ZZ1000": "=INDIRECT(\"B\"&A5)"},
      "check": "ZZ1000",
      "expect": {"value2": 62}
    },
    {
      "id": "INDIRECT-005",
      "source": "documented",
      "description": "a1 TRUE is A1 style, as when it is left out",
      "cells": {"A2": "B2", "A3": "B3", "A4": "George", "A5": "5", "B2": "1.333", "B3": "45", "B4": "10", "B5": "62", "ZZ1000": "=INDIRECT(\"B3\",TRUE)"},
      "check": "ZZ1000",
      "expect": {"value2": 45}
    },
    {
      "id": "INDIRECT-006",
      "source": "documented",
      "description": "A range's text gives a range, which SUM reads",
      "cells": {"A2": "B2", "A3": "B3", "A4": "George", "A5": "5", "B2": "1.333", "B3": "45", "B4": "10", "B5": "62", "ZZ1000": "=SUM(INDIRECT(\"B2:B5\"))"},
      "check": "ZZ1000",
      "expect": {"value2": 118.333, "digits": 9}
    },
    {
      "id": "INDIRECT-007",
      "source": "documented",
      "description": "Text that is not a reference is #REF!",
      "cells": {"A2": "B2", "A3": "B3", "A4": "George", "A5": "5", "B2": "1.333", "B3": "45", "B4": "10", "B5": "62", "ZZ1000": "=INDIRECT(\"no place\")"},
      "check": "ZZ1000",
      "expect": {"value2": "#REF!"}
    },
    {
      "id": "INDIRECT-008",
      "source": "documented",
      "description": "A reference into a Sheet that does not exist names no place: #REF!",
      "cells": {"A2": "B2", "A3": "B3", "A4": "George", "A5": "5", "B2": "1.333", "B3": "45", "B4": "10", "B5": "62", "ZZ1000": "=INDIRECT(\"Sheet2!B2\")"},
      "check": "ZZ1000",
      "expect": {"value2": "#REF!"}
    },
    {
      "id": "INDIRECT-009",
      "source": "uncertain",
      "description": "Engine's answer, Excel to be asked: the text qualified with the Sheet's own name reads its cell",
      "cells": {"A2": "B2", "A3": "B3", "A4": "George", "A5": "5", "B2": "1.333", "B3": "45", "B4": "10", "B5": "62", "ZZ1000": "=INDIRECT(\"Sheet1!B3\")"},
      "check": "ZZ1000",
      "expect": {"value2": 45}
    },
    {
      "id": "INDIRECT-010",
      "source": "uncertain",
      "description": "Engine's answer, Excel to be asked: the Sheet's name quoted reads its cell",
      "cells": {"A2": "B2", "A3": "B3", "A4": "George", "A5": "5", "B2": "1.333", "B3": "45", "B4": "10", "B5": "62", "ZZ1000": "=INDIRECT(\"'Sheet1'!B3\")"},
      "check": "ZZ1000",
      "expect": {"value2": 45}
    },
    {
      "id": "INDIRECT-011",
      "source": "uncertain",
      "description": "Engine's answer, Excel to be asked: the text in lower case reads its cell",
      "cells": {"A2": "B2", "A3": "B3", "A4": "George", "A5": "5", "B2": "1.333", "B3": "45", "B4": "10", "B5": "62", "ZZ1000": "=INDIRECT(\"b3\")"},
      "check": "ZZ1000",
      "expect": {"value2": 45}
    },
