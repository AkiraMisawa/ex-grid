      "id": "INDIRECT-012",
      "source": "uncertain",
      "description": "Engine's answer, Excel to be asked: $ in the text reads its cell",
      "cells": {"A2": "B2", "A3": "B3", "A4": "George", "A5": "5", "B2": "1.333", "B3": "45", "B4": "10", "B5": "62", "ZZ1000": "=INDIRECT(\"$B$3\")"},
      "check": "ZZ1000",
      "expect": {"value2": 45}
    },
    {
      "id": "INDIRECT-013",
      "source": "uncertain",
      "description": "Engine's answer, Excel to be asked: whole columns are a range",
      "cells": {"A2": "B2", "A3": "B3", "A4": "George", "A5": "5", "B2": "1.333", "B3": "45", "B4": "10", "B5": "62", "ZZ1000": "=SUM(INDIRECT(\"B:B\"))"},
      "check": "ZZ1000",
      "expect": {"value2": 118.333, "digits": 9}
    },
    {
      "id": "INDIRECT-014",
      "source": "uncertain",
      "description": "Engine's answer, Excel to be asked: a range as the result spills (ADR-0125), the Anchor showing its first Value",
      "cells": {"A2": "B2", "A3": "B3", "A4": "George", "A5": "5", "B2": "1.333", "B3": "45", "B4": "10", "B5": "62", "C1": "=INDIRECT(\"B2:B3\")"},
      "check": "C1",
      "expect": {"value2": 1.333}
    },
    {
      "id": "INDIRECT-015",
      "source": "uncertain",
      "description": "Engine's answer, Excel to be asked: a blank cell named by text reads as 0",
      "cells": {"A2": "B2", "A3": "B3", "A4": "George", "A5": "5", "B2": "1.333", "B3": "45", "B4": "10", "B5": "62", "ZZ1000": "=INDIRECT(\"B9\")"},
      "check": "ZZ1000",
      "expect": {"value2": 0}
    },
    {
      "id": "INDIRECT-016",
      "source": "uncertain",
      "description": "Engine's answer, Excel to be asked: empty text names no place",
      "cells": {"A2": "B2", "A3": "B3", "A4": "George", "A5": "5", "B2": "1.333", "B3": "45", "B4": "10", "B5": "62", "ZZ1000": "=INDIRECT(\"\")"},
      "check": "ZZ1000",
      "expect": {"value2": "#REF!"}
    },
