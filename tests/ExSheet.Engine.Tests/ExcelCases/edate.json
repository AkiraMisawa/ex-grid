{
  "area": "edate",
  "about": "EDATE (docs/specs/exsheet-functions).",
  "cases": [
    {
      "id": "EDATE-001",
      "source": "observed",
      "description": "Microsoft's example: one month after 15 January 2011",
      "cells": {"A1": "1/15/2011", "ZZ1000": "=EDATE(A1,1)"},
      "check": "ZZ1000",
      "expect": {"value2": 40589}
    },
    {
      "id": "EDATE-002",
      "source": "observed",
      "description": "Microsoft's example: one month before",
      "cells": {"A1": "1/15/2011", "ZZ1000": "=EDATE(A1,-1)"},
      "check": "ZZ1000",
      "expect": {"value2": 40527}
    },
    {
      "id": "EDATE-003",
      "source": "observed",
      "description": "Microsoft's example: two months after",
      "cells": {"A1": "1/15/2011", "ZZ1000": "=EDATE(A1,2)"},
      "check": "ZZ1000",
      "expect": {"value2": 40617}
    },
    {
      "id": "EDATE-004",
      "source": "observed",
      "description": "Engine's answer, Excel to be asked: a day the month does not have is its last day",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=EDATE(DATE(2011,1,31),1)"},
      "check": "ZZ1000",
      "expect": {"value2": 40602}
    },
    {
      "id": "EDATE-005",
      "source": "observed",
      "description": "Engine's answer, Excel to be asked: into February of a leap year",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=EDATE(DATE(2024,1,31),1)"},
      "check": "ZZ1000",
      "expect": {"value2": 45351}
    },
    {
      "id": "EDATE-006",
      "source": "observed",
      "description": "Engine's answer, Excel to be asked: months that are not whole are truncated",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=EDATE(DATE(2011,1,15),-1.9)"},
      "check": "ZZ1000",
      "expect": {"value2": 40527}
    },
    {
      "id": "EDATE-007",
      "source": "observed",
      "description": "Engine's answer, Excel to be asked: a start date below 0 is #NUM!",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=EDATE(-1,1)"},
      "check": "ZZ1000",
      "expect": {"value2": "#NUM!"}
    },
    {
      "id": "EDATE-008",
      "source": "observed",
      "description": "A result before 1 March 1900 is its own serial: 15 February 1900 is 46",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=EDATE(DATE(1900,3,15),-1)"},
      "check": "ZZ1000",
      "expect": {"value2": 46}
    },
    {
      "id": "EDATE-009",
      "source": "observed",
      "description": "A boolean typed as an argument is #VALUE!",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=EDATE(TRUE,1)"},
      "check": "ZZ1000",
      "expect": {"value2": "#VALUE!"}
    },
    {
      "id": "EDATE-010",
      "source": "observed",
      "description": "A start on serial 60 is read as DAY reads it, the 29th of February 1900 (DAY-002), and a month on keeps the 29th: 29 March, 89",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=EDATE(60,1)"},
      "check": "ZZ1000",
      "expect": {"value2": 89}
    },
    {
      "id": "EDATE-011",
      "source": "observed",
      "description": "Engine's answer, Excel to be asked: from 31 January 1900, a month on is 28 February, 59, as February 1900 has 28 days",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=EDATE(31,1)"},
      "check": "ZZ1000",
      "expect": {"value2": 59}
    },
    {
      "id": "EDATE-012",
      "source": "observed",
      "description": "Engine's answer, Excel to be asked: a result before 1900, a month before 15 January 1900, is #NUM!, as EOMONTH's is (EOMONTH-005, and Microsoft documents #NUM! for EOMONTH's invalid result); EDATE's follows by analogy, where it was #VALUE! before the seventeenth run's corrections",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=EDATE(15,-1)"},
      "check": "ZZ1000",
      "expect": {"value2": "#NUM!"}
    },
    {
      "id": "EDATE-013",
      "source": "uncertain",
      "description": "Engine's answer, Excel to be asked: from serial 60, the 29th of February 1900, no months on is the month's last day on the real calendar, 28 February, 59, as EDATE-010 keeps the 29th where the month has one",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=EDATE(60,0)"},
      "check": "ZZ1000",
      "expect": {"value2": 59}
    },
    {
      "id": "EDATE-014",
      "source": "uncertain",
      "description": "Engine's answer, Excel to be asked: from serial 60, twelve months on is 28 February 1901, 425, as February 1901 has 28 days",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=EDATE(60,12)"},
      "check": "ZZ1000",
      "expect": {"value2": 425}
    },
    {
      "id": "EDATE-015",
      "source": "uncertain",
      "description": "Engine's answer, Excel to be asked: from serial 60, a month before is 29 January 1900, 29",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=EDATE(60,-1)"},
      "check": "ZZ1000",
      "expect": {"value2": 29}
    },
    {
      "id": "EDATE-016",
      "source": "uncertain",
      "description": "Refused until Excel is asked: a start on serial 0, 0 January 1900, whose day is 0, as DAY reads it (DAY-004); what day 0 of another month becomes is not observed",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=EDATE(0,1)"},
      "check": "ZZ1000",
      "expect": {"value2": "#VALUE!"}
    }
  ]
}
