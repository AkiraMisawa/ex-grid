{
  "area": "sortby",
  "about": "SORTBY (ADR-0125): an array ordered by other arrays; it spills.",
  "cases": [
    {
      "id": "SORTBY-001",
      "source": "documented",
      "description": "By another column, descending",
      "fixture": "lookupData",
      "cells": {"ZZ1000": "=SORTBY(G1:G5,H1:H5,-1)"},
      "check": "ZZ1000",
      "expect": {"value2": "Date", "kind": "text"}
    },
    {
      "id": "SORTBY-002",
      "source": "documented",
      "description": "By two keys, the first deciding first",
      "fixture": "lookupData",
      "cells": {"ZZ1000": "=SORTBY(H1:H5,G1:G5,1,H1:H5,-1)"},
      "check": "ZZ1001",
      "expect": {"value2": 40}
    },
    {
      "id": "SORTBY-003",
      "source": "documented",
      "description": "By two keys: the second orders the equal first keys",
      "fixture": "lookupData",
      "cells": {"ZZ1000": "=SORTBY(H1:H5,G1:G5,1,H1:H5,-1)"},
      "check": "ZZ1002",
      "expect": {"value2": 20}
    },
    {
      "id": "SORTBY-004",
      "source": "documented",
      "description": "A by_array of another size is #VALUE!",
      "fixture": "lookupData",
      "cells": {"ZZ1000": "=SORTBY(G1:G5,H1:H3)"},
      "check": "ZZ1000",
      "expect": {"value2": "#VALUE!"}
    },
    {
      "id": "SORTBY-005",
      "source": "documented",
      "description": "An order other than 1 and -1 is #VALUE!",
      "fixture": "lookupData",
      "cells": {"ZZ1000": "=SORTBY(G1:G5,H1:H5,2)"},
      "check": "ZZ1000",
      "expect": {"value2": "#VALUE!"}
    },
    {
      "id": "SORTBY-006",
      "source": "uncertain",
      "description": "Engine's answer, Excel to be asked: a row as by_array for a column is #VALUE!",
      "fixture": "lookupData",
      "cells": {"ZZ1000": "=SORTBY(G1:G5,M2:O2)"},
      "check": "ZZ1000",
      "expect": {"value2": "#VALUE!"}
    }
  ]
}
