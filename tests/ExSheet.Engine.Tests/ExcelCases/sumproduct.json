{
  "area": "sumproduct",
  "about": "SUMPRODUCT (ADR-0125): the sum of the products of its arrays.",
  "cases": [
    {
      "id": "SUMPRODUCT-001",
      "source": "documented",
      "description": "Two ranges multiplied and summed",
      "fixture": "lookupData",
      "cells": {"ZZ1000": "=SUMPRODUCT(H1:H5,J1:J5)"},
      "check": "ZZ1000",
      "expect": {"value2": 4750}
    },
    {
      "id": "SUMPRODUCT-002",
      "source": "documented",
      "description": "An operator on ranges is evaluated as an array",
      "fixture": "lookupData",
      "cells": {"ZZ1000": "=SUMPRODUCT((G1:G5=\"Banana\")*H1:H5)"},
      "check": "ZZ1000",
      "expect": {"value2": 60}
    },
    {
      "id": "SUMPRODUCT-003",
      "source": "documented",
      "description": "Microsoft's documentation: arrays of different sizes are #VALUE!",
      "fixture": "lookupData",
      "cells": {"ZZ1000": "=SUMPRODUCT(H1:H5,J1:J4)"},
      "check": "ZZ1000",
      "expect": {"value2": "#VALUE!"}
    },
    {
      "id": "SUMPRODUCT-004",
      "source": "documented",
      "description": "Microsoft's documentation: anything but a number counts as 0",
      "fixture": "lookupData",
      "cells": {"ZZ1000": "=SUMPRODUCT(G1:G5,H1:H5)"},
      "check": "ZZ1000",
      "expect": {"value2": 0}
    },
    {
      "id": "SUMPRODUCT-005",
      "source": "documented",
      "description": "One range is summed",
      "fixture": "lookupData",
      "cells": {"ZZ1000": "=SUMPRODUCT(H1:H5)"},
      "check": "ZZ1000",
      "expect": {"value2": 150}
    },
    {
      "id": "SUMPRODUCT-006",
      "source": "documented",
      "description": "Double negation turns the comparisons into numbers",
      "fixture": "lookupData",
      "cells": {"ZZ1000": "=SUMPRODUCT(--(G1:G5=\"Banana\"))"},
      "check": "ZZ1000",
      "expect": {"value2": 2}
    },
    {
      "id": "SUMPRODUCT-007",
      "source": "uncertain",
      "description": "Engine's answer, Excel to be asked: an Error Value inside is the result",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=SUMPRODUCT(C1:C3)"},
      "check": "ZZ1000",
      "expect": {"value2": "#DIV/0!"}
    }
  ]
}
