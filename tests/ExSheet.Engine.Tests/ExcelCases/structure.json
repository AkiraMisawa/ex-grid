{
  "area": "structure",
  "about": "Inserting and deleting rows and columns, as the stored Formulas and Values after it (ADR-0046, ADR-0047). Row numbers are 1-based, as Excel's Rows(n).",
  "cases": [
    {
      "id": "STRUCT-001",
      "source": "observed",
      "description": "Inserting above a referenced cell rewrites the Reference to it",
      "cells": {"A5": "21", "B1": "=A5*2"},
      "action": {"do": "insertRows", "row": 3, "count": 1},
      "check": "B1",
      "expect": {"value2": 42, "formula": "=A6*2"}
    },
    {
      "id": "STRUCT-002",
      "source": "observed",
      "description": "The referenced cell moves down",
      "cells": {"A5": "21", "B1": "=A5*2"},
      "action": {"do": "insertRows", "row": 3, "count": 1},
      "check": "A6",
      "expect": {"value2": 21}
    },
    {
      "id": "STRUCT-003",
      "source": "observed",
      "description": "The inserted row is blank",
      "cells": {"A5": "21", "B1": "=A5*2"},
      "action": {"do": "insertRows", "row": 3, "count": 1},
      "check": "A5",
      "expect": {"value2": null}
    },
    {
      "id": "STRUCT-004",
      "source": "observed",
      "description": "Absolute and mixed References are rewritten alike",
      "cells": {"A5": "1", "C5": "2", "B1": "=$A$5+A$5+$C5"},
      "action": {"do": "insertRows", "row": 1, "count": 2},
      "check": "B3",
      "expect": {"value2": 4, "formula": "=$A$7+A$7+$C7"}
    },
    {
      "id": "STRUCT-005",
      "source": "observed",
      "description": "A range grows when a row goes inside it, moves when one goes at or above its top, and stays when one goes below it",
      "cells": {"C1": "=SUM(A2:A5)"},
      "action": {"do": "insertRows", "row": 3, "count": 1},
      "check": "C1",
      "expect": {"formula": "=SUM(A2:A6)"}
    },
    {
      "id": "STRUCT-006",
      "source": "observed",
      "description": "A range grows when a row goes inside it, moves when one goes at or above its top, and stays when one goes below it",
      "cells": {"C1": "=SUM(A2:A5)"},
      "action": {"do": "insertRows", "row": 2, "count": 1},
      "check": "C1",
      "expect": {"formula": "=SUM(A3:A6)"}
    },
    {
      "id": "STRUCT-007",
      "source": "observed",
      "description": "A range grows when a row goes inside it, moves when one goes at or above its top, and stays when one goes below it",
      "cells": {"C1": "=SUM(A2:A5)"},
      "action": {"do": "insertRows", "row": 1, "count": 1},
      "check": "C2",
      "expect": {"formula": "=SUM(A3:A6)"}
    },
    {
      "id": "STRUCT-008",
      "source": "observed",
      "description": "A range grows when a row goes inside it, moves when one goes at or above its top, and stays when one goes below it",
      "cells": {"C1": "=SUM(A2:A5)"},
      "action": {"do": "insertRows", "row": 5, "count": 1},
      "check": "C1",
      "expect": {"formula": "=SUM(A2:A6)"}
    },
    {
      "id": "STRUCT-009",
      "source": "observed",
      "description": "A range grows when a row goes inside it, moves when one goes at or above its top, and stays when one goes below it",
      "cells": {"C1": "=SUM(A2:A5)"},
      "action": {"do": "insertRows", "row": 6, "count": 1},
      "check": "C1",
      "expect": {"formula": "=SUM(A2:A5)"}
    },
    {
      "id": "STRUCT-010",
      "source": "observed",
      "description": "A range shrinks when some of its rows are deleted, and is #REF! when all are",
      "cells": {"A2": "2", "A3": "3", "A4": "4", "A5": "5", "C10": "=SUM(A2:A5)"},
      "action": {"do": "deleteRows", "row": 3, "count": 1},
      "check": "C9",
      "expect": {"value2": 11, "formula": "=SUM(A2:A4)"}
    },
    {
      "id": "STRUCT-011",
      "source": "observed",
      "description": "A range shrinks when some of its rows are deleted, and is #REF! when all are",
      "cells": {"A2": "2", "A3": "3", "A4": "4", "A5": "5", "C10": "=SUM(A2:A5)"},
      "action": {"do": "deleteRows", "row": 1, "count": 2},
      "check": "C8",
      "expect": {"value2": 12, "formula": "=SUM(A1:A3)"}
    },
    {
      "id": "STRUCT-012",
      "source": "observed",
      "description": "A range shrinks when some of its rows are deleted, and is #REF! when all are",
      "cells": {"A2": "2", "A3": "3", "A4": "4", "A5": "5", "C10": "=SUM(A2:A5)"},
      "action": {"do": "deleteRows", "row": 4, "count": 5},
      "check": "C5",
      "expect": {"value2": 5, "formula": "=SUM(A2:A3)"}
    },
    {
      "id": "STRUCT-013",
      "source": "observed",
      "description": "A range shrinks when some of its rows are deleted, and is #REF! when all are",
      "cells": {"A2": "2", "A3": "3", "A4": "4", "A5": "5", "C10": "=SUM(A2:A5)"},
      "action": {"do": "deleteRows", "row": 2, "count": 4},
      "check": "C6",
      "expect": {"value2": "#REF!", "formula": "=SUM(#REF!)"}
    },
    {
      "id": "STRUCT-014",
      "source": "observed",
      "description": "A range shrinks when some of its rows are deleted, and is #REF! when all are",
      "cells": {"A2": "2", "A3": "3", "A4": "4", "A5": "5", "C10": "=SUM(A2:A5)"},
      "action": {"do": "deleteRows", "row": 7, "count": 3},
      "check": "C7",
      "expect": {"value2": 14, "formula": "=SUM(A2:A5)"}
    },
    {
      "id": "STRUCT-015",
      "source": "observed",
      "description": "Columns are rewritten as rows are, whole columns included",
      "cells": {"B1": "3", "B2": "4", "D1": "=B1+SUM(B:B)+SUM(A1:C1)"},
      "action": {"do": "insertColumns", "column": "B", "count": 1},
      "check": "E1",
      "expect": {"value2": 13, "formula": "=C1+SUM(C:C)+SUM(A1:D1)"}
    },
    {
      "id": "STRUCT-016",
      "source": "observed",
      "description": "Deleting a column rewrites References past it",
      "cells": {"A1": "1", "B1": "2", "C1": "3", "E1": "=A1+C1", "E2": "=B1", "E3": "=SUM(A1:C1)"},
      "action": {"do": "deleteColumns", "column": "B", "count": 1},
      "check": "D1",
      "expect": {"value2": 4, "formula": "=A1+B1"}
    },
    {
      "id": "STRUCT-017",
      "source": "observed",
      "description": "Deleting a referenced column makes the Reference #REF!",
      "cells": {"A1": "1", "B1": "2", "C1": "3", "E1": "=A1+C1", "E2": "=B1", "E3": "=SUM(A1:C1)"},
      "action": {"do": "deleteColumns", "column": "B", "count": 1},
      "check": "D2",
      "expect": {"value2": "#REF!", "formula": "=#REF!"}
    },
    {
      "id": "STRUCT-018",
      "source": "observed",
      "description": "Deleting a column inside a range shrinks it",
      "cells": {"A1": "1", "B1": "2", "C1": "3", "E1": "=A1+C1", "E2": "=B1", "E3": "=SUM(A1:C1)"},
      "action": {"do": "deleteColumns", "column": "B", "count": 1},
      "check": "D3",
      "expect": {"value2": 4, "formula": "=SUM(A1:B1)"}
    },
    {
      "id": "STRUCT-019",
      "source": "observed",
      "description": "A1:A1048576 is written A:A from entry on, and an insertion leaves it alone",
      "cells": {"B1": "=SUM(A1:A1048576)"},
      "action": {"do": "insertRows", "row": 4, "count": 1},
      "check": "B1",
      "expect": {"formula": "=SUM(A:A)"}
    },
    {
      "id": "STRUCT-020",
      "source": "observed",
      "description": "A Reference qualified with another Sheet's name is not this Sheet's, and is not rewritten",
      "otherSheets": ["Sheet2"],
      "cells": {"B1": "=Sheet2!A5"},
      "action": {"do": "insertRows", "row": 1, "count": 1},
      "check": "B2",
      "expect": {"formula": "=Sheet2!A5"}
    },
    {
      "id": "STRUCT-021",
      "source": "documented",
      "description": "A Formula reading a cycle is #CIRC!",
      "cells": {"A1": "=B1+1", "B1": "=A1+1", "C2": "=A1"},
      "check": "C2",
      "expect": {"value2": "#CIRC!"},
      "engineDiffersByDecision": "ADR-0047: a circular reference is #CIRC! in every member and dependent, where Excel shows 0"
    },
    {
      "id": "STRUCT-022",
      "source": "observed",
      "description": "Deleting a cell of a cycle breaks it: the Reference becomes #REF!",
      "cells": {"A1": "=B1+1", "B1": "=A1+1", "C2": "=A1"},
      "action": {"do": "deleteColumns", "column": "B", "count": 1},
      "check": "A1",
      "expect": {"value2": "#REF!", "formula": "=#REF!+1"}
    },
    {
      "id": "STRUCT-023",
      "source": "observed",
      "description": "Deleting a cell of a cycle breaks it: what read the cycle follows",
      "cells": {"A1": "=B1+1", "B1": "=A1+1", "C2": "=A1"},
      "action": {"do": "deleteColumns", "column": "B", "count": 1},
      "check": "B2",
      "expect": {"value2": "#REF!"}
    },
    {
      "id": "STRUCT-024",
      "source": "observed",
      "description": "A Formula inside the deleted rows goes with them",
      "cells": {"A2": "=1+1", "A4": "=A2*2"},
      "action": {"do": "deleteRows", "row": 2, "count": 1},
      "check": "A2",
      "expect": {"value2": null, "formula": ""}
    },
    {
      "id": "STRUCT-025",
      "source": "observed",
      "description": "What read a deleted Formula is #REF!",
      "cells": {"A2": "=1+1", "A4": "=A2*2"},
      "action": {"do": "deleteRows", "row": 2, "count": 1},
      "check": "A3",
      "expect": {"value2": "#REF!", "formula": "=#REF!*2"}
    },
    {
      "id": "STRUCT-026",
      "source": "observed",
      "description": "An insertion that would push an Entry off the Sheet is refused, and nothing changes",
      "cells": {"A1048576": "1", "B1": "2"},
      "action": {"do": "insertRows", "row": 1, "count": 1},
      "check": "B1",
      "expect": {"refused": "EntriesWouldLeaveSheet", "value2": 2}
    },
    {
      "id": "STRUCT-027",
      "source": "observed",
      "description": "An insertion that would push an Entry off the Sheet is refused, and the Entry at the edge stays",
      "cells": {"A1048576": "1", "B1": "2"},
      "action": {"do": "insertRows", "row": 1, "count": 1},
      "check": "A1048576",
      "expect": {"refused": "EntriesWouldLeaveSheet", "value2": 1}
    },
    {
      "id": "STRUCT-028",
      "source": "observed",
      "description": "An insertion that pushes part of a range off the Sheet is done, and the range is cut at the edge (the Formula moved to B2)",
      "cells": {"B1": "=SUM(A2:A1048576)"},
      "action": {"do": "insertRows", "row": 1, "count": 1},
      "check": "B2",
      "expect": {"formula": "=SUM(A3:A1048576)"}
    },
    {
      "id": "STRUCT-029",
      "source": "observed",
      "description": "A cell holding only formatting at the edge is dropped, not a reason to refuse",
      "cells": {},
      "formats": {"XFD1": "0.00"},
      "action": {"do": "insertColumns", "column": "A", "count": 1},
      "check": "XFD1",
      "expect": {"numberFormat": "General"}
    },
    {
      "id": "STRUCT-030",
      "source": "observed",
      "description": "Rows inserted at the top have no row above, and take no formatting",
      "cells": {},
      "formats": {"A1": "0.00"},
      "action": {"do": "insertRows", "row": 1, "count": 1},
      "check": "A1",
      "expect": {"numberFormat": "General"}
    },
    {
      "id": "STRUCT-031",
      "source": "observed",
      "description": "The row pushed down keeps its formatting",
      "cells": {},
      "formats": {"A1": "0.00"},
      "action": {"do": "insertRows", "row": 1, "count": 1},
      "check": "A2",
      "expect": {"numberFormat": "0.00"}
    },
    {
      "id": "STRUCT-032",
      "source": "observed",
      "description": "An insertion rewrites only the Reference tokens, keeping the whitespace around them (the trailing space was dropped on entry)",
      "cells": {"A5": "1", "B1": "= A5 +  SUM( A1:A5 )\n* 2 "},
      "action": {"do": "insertRows", "row": 3, "count": 1},
      "check": "B1",
      "expect": {"formula": "= A6 +  SUM( A1:A6 )\n* 2"}
    },
    {
      "id": "STRUCT-033",
      "source": "observed",
      "description": "A deletion writes #REF! in place of the Reference token, and the whitespace before it goes with it",
      "cells": {"A5": "1", "B1": "=  A5  *  C1 "},
      "action": {"do": "deleteRows", "row": 5, "count": 1},
      "check": "B1",
      "expect": {"formula": "=#REF!  *  C1"}
    },
    {
      "id": "STRUCT-034",
      "source": "observed",
      "description": "The whitespace before a Reference a deletion makes #REF! goes with it after an operator too (inferred from the observed whitespace rules (verification/2026-09-27-windows-excel), not yet asked of Excel)",
      "cells": {"A5": "1", "B1": "=C1 *  A5 + 1"},
      "action": {"do": "deleteRows", "row": 5, "count": 1},
      "check": "B1",
      "expect": {"formula": "=C1 *#REF! + 1"}
    },
    {
      "id": "STRUCT-035",
      "source": "observed",
      "description": "An insertion that grows a range to every row writes it as whole columns (inferred from Excel's observed A:XFD and A1:A1048576 (verification/2026-09-27-windows-excel), not yet asked of Excel)",
      "cells": {"B1": "=SUM(A1:A1048575)"},
      "action": {"do": "insertRows", "row": 5, "count": 1},
      "check": "B1",
      "expect": {"formula": "=SUM(A:A)"}
    },
    {
      "id": "STRUCT-036",
      "source": "observed",
      "description": "An insertion that pushes the one cell a Reference names off the Sheet is done, and the Reference is #REF! (observed through probes.ps1, verification/2026-09-27-windows-excel item 3)",
      "cells": {"B1": "=A1048576"},
      "action": {"do": "insertRows", "row": 1, "count": 1},
      "check": "B2",
      "expect": {"formula": "=#REF!", "value2": "#REF!"}
    },
    {
      "id": "STRUCT-037",
      "source": "observed",
      "description": "An Entry pushed off the Sheet still refuses the insertion, whatever References read it (observed through probes.ps1, verification/2026-09-27-windows-excel item 3)",
      "cells": {"A1048576": "1", "B1": "=A1048576"},
      "action": {"do": "insertRows", "row": 1, "count": 1},
      "check": "B1",
      "expect": {"refused": "EntriesWouldLeaveSheet", "formula": "=A1048576"}
    },
    {
      "id": "STRUCT-038",
      "source": "observed",
      "description": "A range an insertion moves to end at the edge is moved, not cut (observed through probes.ps1, verification/2026-09-27-windows-excel item 3)",
      "cells": {"B1": "=SUM(A5:A1048575)"},
      "action": {"do": "insertRows", "row": 1, "count": 1},
      "check": "B2",
      "expect": {"formula": "=SUM(A6:A1048576)"}
    },
    {
      "id": "STRUCT-039",
      "source": "observed",
      "description": "A range cut at the edge down to one cell stays a range (inferred from Excel's observed rows (verification/2026-09-27-windows-excel item 3), not yet asked of Excel)",
      "cells": {"B1": "=SUM(A1048575:A1048576)"},
      "action": {"do": "insertRows", "row": 1, "count": 1},
      "check": "B2",
      "expect": {"formula": "=SUM(A1048576:A1048576)"}
    },
    {
      "id": "STRUCT-040",
      "source": "observed",
      "description": "A column inserted pushes a Reference off the right edge: it is #REF!, and the insertion done (inferred from Excel's observed rows (verification/2026-09-27-windows-excel item 3), not yet asked of Excel)",
      "cells": {"A1": "=XFD1*2"},
      "action": {"do": "insertColumns", "column": "A", "count": 1},
      "check": "B1",
      "expect": {"formula": "=#REF!*2"}
    },
    {
      "id": "STRUCT-041",
      "source": "observed",
      "description": "Whole rows an insertion pushes partly off the Sheet are cut at the edge (inferred from Excel's observed rows (verification/2026-09-27-windows-excel item 3), not yet asked of Excel)",
      "cells": {"B1": "=SUM(2:1048576)"},
      "action": {"do": "insertRows", "row": 1, "count": 1},
      "check": "B2",
      "expect": {"formula": "=SUM(3:1048576)"}
    }
  ]
}
