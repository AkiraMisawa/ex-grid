<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Mirrors tests/ExGrid.Data.Tests: net10.0 (ADR-0022), xunit v3 on Microsoft.Testing.Platform,
         and no native apphost (tests/Directory.Build.targets has the account). -->
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="2.0.3" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="17.14.2" />
    <!-- The codecs a Consumer hands in to read another producer's compressed stream (ADR-0065):
         the tests write compressed streams with them, and read them back with and without. -->
    <PackageReference Include="Apache.Arrow.Compression" Version="23.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ExGrid.Data.Arrow\ExGrid.Data.Arrow.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Streams other producers wrote, made by Producers/make_streams.py and kept as they came. -->
    <EmbeddedResource Include="Producers\*.arrows;Producers\*.arrow" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
