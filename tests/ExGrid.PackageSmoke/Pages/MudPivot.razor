@page "/mud-pivot"
@* The pivot on a paper in src/ExPivot.MudBlazor/README.md, as written there, taken from the
   packed ExPivot.MudBlazor. The source and the layout are the first pivot's. *@
@using ExGrid.MudBlazor
@using ExPivot.Components
@using ExPivot.Engine
@using ExPivot.MudBlazor

<MudExGridPaper Elevation="1" Hover="true">
    <ExPivot DataSource="_source" @bind-Layout="_layout"
             PivotChrome="MudPivotChrome.Default" ViewportHeight="420" />
</MudExGridPaper>

@code {
    private static readonly PivotField<Sale>[] Fields =
    [
        new("Region", PivotFieldType.Text, s => s.Region),
        new("Product", PivotFieldType.Text, s => s.Product),
        new("Date", PivotFieldType.Date, s => s.Date, format: "yyyy-MM"),
        new("Amount", PivotFieldType.Number, s => s.Amount),
    ];

    private PivotSource _source = PivotSource.From(Sale.Sample(), Fields);
    private PivotLayout _layout = new()
    {
        Rows = [new PivotFieldPlacement("Region")],
        Values = [new PivotValueField("Amount", PivotAggregation.Sum)],
    };
}
