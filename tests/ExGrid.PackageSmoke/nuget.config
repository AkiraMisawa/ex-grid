<?xml version="1.0" encoding="utf-8"?>
<!-- ExGrid's packages come from the ones check.sh just packed, and from nowhere else: once a
     version is on nuget.org, this is what keeps the check from testing that one instead. -->
<configuration>
  <packageSources>
    <clear />
    <add key="packed" value=".feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="packed">
      <package pattern="ExGrid" />
      <package pattern="ExGrid.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
