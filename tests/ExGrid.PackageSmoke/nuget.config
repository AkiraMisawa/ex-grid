<?xml version="1.0" encoding="utf-8"?>
<!-- The family's packages come from the ones check.sh just packed, and from nowhere else: once a
     version is on nuget.org, this is what keeps the check from testing that one instead. -->
<configuration>
  <packageSources>
    <clear />
    <add key="packed" value=".feed" />
    <!-- A package packed and checked here that the release does not publish yet: ExGrid.Data.Xlsx (ADR-0330),
         until ADR-0042 names it. The more specific pattern below takes it from here alone. -->
    <add key="unreleased" value=".feed-unreleased" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="packed">
      <package pattern="ExGrid" />
      <package pattern="ExGrid.*" />
      <package pattern="ExSheet" />
      <package pattern="ExSheet.*" />
      <package pattern="ExPivot" />
      <package pattern="ExPivot.*" />
      <package pattern="ExChart" />
      <package pattern="ExChart.*" />
    </packageSource>
    <packageSource key="unreleased">
      <package pattern="ExGrid.Data.Xlsx" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
