{
  "about": "The reference Selection Summary (ADR-0130, SM-1/SM-4/SM-6), and its exact arithmetic (ADR-0350 §16): what each figure is over which cells, and the text it is shown with where no format applies. From dotnet/tests/ExGrid.Tests/GridSummaryTests.cs.",
  "kind": "summary",
  "columns": ["Book", "Notional", "Rate", "Date", "Live"],
  "rows": [
    ["Alpha", 1000, 0.5, {"dateTime": "2026-01-01T00:00:00"}, true],
    ["Beta", 2500.25, 1.5, {"dateTime": "2026-01-02T00:00:00"}, false],
    ["Gamma", null, 2.0, {"dateTime": "2026-01-03T00:00:00"}, true],
    ["Delta", 30, 4.0, {"dateTime": "2026-01-04T00:00:00"}, false]
  ],
  "cases": [
    {
      "name": "ADR-0130 / SM-6: money is summed exactly, and a blank is in no figure",
      "ask": {"ranges": [[0, 1, 4, 1]], "figures": ["average", "count", "numericalCount", "min", "max", "sum"]},
      "is": {"average": {"exact": "1176.75"}, "count": {"exact": "3"}, "numericalCount": {"exact": "3"}, "min": {"exact": "30"}, "max": {"exact": "2500.25"}, "sum": {"exact": "3530.25"}},
      "texts": {"average": "1176.75", "count": "3", "sum": "3530.25"}
    },
    {
      "name": "ADR-0130 / SM-6: text, booleans and dates are counted and never a number, so only the counts are shown",
      "ask": {"ranges": [[0, 0, 2, 1], [0, 3, 2, 2]], "figures": ["average", "count", "numericalCount", "min", "max", "sum"]},
      "is": {"average": "empty", "count": {"exact": "6"}, "numericalCount": {"exact": "0"}, "min": "empty", "max": "empty", "sum": "empty"}
    },
    {
      "name": "ADR-0130 / SM-6: a cell covered by two ranges counts once",
      "ask": {"ranges": [[0, 1, 2, 1], [1, 1, 3, 1]], "figures": ["count", "sum"]},
      "is": {"count": {"exact": "3"}, "sum": {"exact": "3530.25"}}
    },
    {
      "name": "ADR-0130 / SM-6: rows and columns past the result are not cells",
      "ask": {"ranges": [[2, 1, 10, 3], [0, 4, 1, 3]], "figures": ["count", "sum"]},
      "is": {"count": {"exact": "6"}, "sum": {"exact": "36"}}
    },
    {
      "name": "ADR-0130 / SM-6: a column with no value, an Action Column, is blank",
      "ask": {"ranges": [[0, 0, 4, 2]], "columns": ["Actions", "Notional"], "figures": ["count"]},
      "is": {"count": {"exact": "3"}}
    },
    {
      "name": "ADR-0130 / SM-1: only the figures asked are answered, in Excel's order",
      "ask": {"ranges": [[0, 1, 4, 1]], "figures": ["sum", "min"]},
      "is": {"min": {"exact": "30"}, "sum": {"exact": "3530.25"}}
    },
    {
      "name": "ADR-0130 / SM-4: a whole column of a million rows is summed, never declined",
      "rows": [[0.01]],
      "repeat": 1000000,
      "columns": ["V"],
      "ask": {"ranges": [[0, 0, 1000000, 1]], "figures": ["sum"]},
      "is": {"sum": {"exact": "10000"}}
    },
    {
      "name": "ADR-0350 §16: a number is read as C# reads a double into a decimal, so 0.1 and 0.2 sum to 0.3",
      "rows": [[0.1], [0.2]],
      "columns": ["V"],
      "ask": {"ranges": [[0, 0, 2, 1]], "figures": ["average", "sum"]},
      "is": {"average": {"exact": "0.15"}, "sum": {"exact": "0.3"}},
      "texts": {"average": "0.15", "sum": "0.3"}
    },
    {
      "name": "ADR-0130: an Average keeps every place a decimal holds, the last rounded half to even, and is shown to ten",
      "rows": [[2], [0], [0]],
      "columns": ["V"],
      "ask": {"ranges": [[0, 0, 3, 1]], "figures": ["average"]},
      "is": {"average": {"exact": "0.6666666666666666666666666667"}},
      "texts": {"average": "0.6666666667"}
    },
    {
      "name": "ADR-0350 §16: a bigint is summed exactly, past the integers a double holds",
      "rows": [[{"bigint": "9007199254740993"}], [{"bigint": "1"}]],
      "columns": ["V"],
      "ask": {"ranges": [[0, 0, 2, 1]], "figures": ["max", "sum"]},
      "is": {"max": {"exact": "9007199254740993"}, "sum": {"exact": "9007199254740994"}},
      "texts": {"max": "9007199254740993", "sum": "9007199254740994"}
    },
    {
      "name": "ADR-0130: a sum a decimal cannot hold leaves exactness for Excel's arithmetic, and the extremes stay exact",
      "rows": [[{"bigint": "79228162514264337593543950335"}], [{"bigint": "79228162514264337593543950335"}]],
      "columns": ["V"],
      "ask": {"ranges": [[0, 0, 2, 1]], "figures": ["average", "max", "sum"]},
      "is": {"average": {"double": "7.922816251426434E+28"}, "max": {"exact": "79228162514264337593543950335"}, "sum": {"double": "1.5845632502852868E+29"}},
      "texts": {"average": "7.922816251E+28", "sum": "1.58456325E+29"}
    },
    {
      "name": "ADR-0130: a value no decimal holds is summed in Excel's arithmetic, and shown to ten significant digits",
      "rows": [[{"double": "1E-30"}], [2], [1.25]],
      "columns": ["V"],
      "ask": {"ranges": [[0, 0, 3, 1]], "figures": ["average", "min", "sum"]},
      "is": {"average": {"double": "1.0833333333333333"}, "min": {"double": "1E-30"}, "sum": {"double": "3.25"}},
      "texts": {"average": "1.083333333", "min": "1E-30", "sum": "3.25"}
    },
    {
      "name": "ADR-0130: an integer past a double's range is not finite in Excel's arithmetic, so Min is #NUM! too",
      "rows": [[1], [{"bigint": ""}]],
      "columns": ["V"],
      "ask": {"ranges": [[0, 0, 2, 1]], "figures": ["count", "min", "max", "sum"]},
      "is": {"count": {"exact": "2"}, "min": {"error": "notANumber"}, "max": {"error": "notANumber"}, "sum": {"error": "notANumber"}}
    },
    {
      "name": "ADR-0130: a value that is not finite makes every figure that reads numbers #NUM!, and the counts stand",
      "rows": [[1], [{"double": "NaN"}], ["x"]],
      "columns": ["V"],
      "ask": {"ranges": [[0, 0, 3, 1]], "figures": ["average", "count", "numericalCount", "min", "max", "sum"]},
      "is": {"average": {"error": "notANumber"}, "count": {"exact": "3"}, "numericalCount": {"exact": "2"}, "min": {"error": "notANumber"}, "max": {"error": "notANumber"}, "sum": {"error": "notANumber"}}
    }
  ]
}
