{
  "about": "A report row's key (ADR-0140; PV-42, PV-43): its role, its Value Field and its Items, distinct within a report and equal across the reports of one layout. Transcribed from the C# engine's RowKeyTests.",
  "kind": "pivotReport",
  "data": "sales",
  "locale": "en-US",
  "words": "english",
  "cases": [
    {
      "name": "ADR-0140 / PV-42: no two rows of one report stand for the same thing, and a key names the Items outermost first",
      "layout": {
        "rows": [{"field": "Region"}, {"field": "Product"}],
        "values": [{"field": "Amount", "aggregation": "sum"}]
      },
      "also": ["keys"],
      "expect": {
        "headers": ["Row Labels", "Sum of Amount"],
        "lines": [
          "g [-]East || 180",
          "i   Apples || 130",
          "i   Pears || 50",
          "g [-]North || 10",
          "i   Pears || 10",
          "g [-]West || 90",
          "i   Apples || 70",
          "i   Plums || 20",
          "g [-](blank) || 5",
          "i   Plums || 5",
          "t Grand Total || 285"
        ],
        "spans": [],
        "keys": [
          {"role": "group", "valueField": -1, "items": [{"kind": "text", "value": "East"}]},
          {
            "role": "item",
            "valueField": -1,
            "items": [{"kind": "text", "value": "East"}, {"kind": "text", "value": "Apples"}]
          },
          {
            "role": "item",
            "valueField": -1,
            "items": [{"kind": "text", "value": "East"}, {"kind": "text", "value": "Pears"}]
          },
          {"role": "group", "valueField": -1, "items": [{"kind": "text", "value": "North"}]},
          {
            "role": "item",
            "valueField": -1,
            "items": [{"kind": "text", "value": "North"}, {"kind": "text", "value": "Pears"}]
          },
          {"role": "group", "valueField": -1, "items": [{"kind": "text", "value": "West"}]},
          {
            "role": "item",
            "valueField": -1,
            "items": [{"kind": "text", "value": "West"}, {"kind": "text", "value": "Apples"}]
          },
          {
            "role": "item",
            "valueField": -1,
            "items": [{"kind": "text", "value": "West"}, {"kind": "text", "value": "Plums"}]
          },
          {"role": "group", "valueField": -1, "items": [{"kind": "blank"}]},
