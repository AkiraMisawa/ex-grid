{
  "about": "The Layout menu on the report's toolbar (ADR-0061): Excel's Design tab choices, what each sets, which is current, and which would change nothing. Transcribed from the C# engine's LayoutMenuTests.",
  "kind": "pivotLayoutEdits",
  "data": "sales",
  "locale": "en-US",
  "words": "english",
  "cases": [
    {
      "name": "ADR-0061/0060: Do Not Show Subtotals turns every row and column field's subtotal off, and nothing else",
      "layout": {
        "filters": [{"field": "Date"}],
        "rows": [{"field": "Region"}, {"field": "Product"}],
        "columns": [{"field": "Online"}],
        "values": [{"field": "Amount", "aggregation": "sum"}]
      },
      "edits": [{"choose": "doNotShowSubtotals", "menu": true, "report": true}],
      "expect": [
        {
          "layout": {
            "form": "compact",
            "valuesAxis": "columns",
            "subtotalsAtTop": true,
            "grandTotalRow": true,
            "grandTotalColumn": true,
            "repeatItemLabels": false,
            "filters": [{"field": "Date"}],
            "rows": [{"field": "Region", "subtotals": false}, {"field": "Product", "subtotals": false}],
            "columns": [{"field": "Online", "subtotals": false}],
            "values": [{"field": "Amount", "aggregation": "sum"}]
          },
          "chosen": ["doNotShowSubtotals", "grandTotalsOn", "compactForm"],
          "enabled": [
            "showSubtotalsAtBottom",
            "showSubtotalsAtTop",
            "grandTotalsOff",
            "grandTotalsOnRowsOnly",
            "grandTotalsOnColumnsOnly",
            "outlineForm",
            "tabularForm"
          ],
          "report": {
            "headers": ["Row Labels", "FALSE", "TRUE", "Grand Total"],
            "lines": [
              "g [-]East ||  |  |",
              "i   Apples ||  | 130 | 130",
              "i   Pears || 50 |  | 50",
              "g [-]North ||  |  |",
              "i   Pears || 10 |  | 10",
              "g [-]West ||  |  |",
              "i   Apples || 70 |  | 70",
              "i   Plums ||  | 20 | 20",
              "g [-](blank) ||  |  |",
              "i   Plums ||  | 5 | 5",
              "t Grand Total || 130 | 155 | 285"
            ],
            "spans": [],
            "captions": ["Sum of Amount"]
          }
        }
      ]
    },
