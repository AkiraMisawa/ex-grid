          "v:g#Sum%20of%20Amount",
          "v:g#Sum%20of%20Quantity"
        ]
      }
    },
    {
      "name": "ADR-0060: the label columns and the value columns never share a name",
      "layout": {
        "form": "tabular",
        "rows": [{"field": "Region"}, {"field": "Product"}],
        "columns": [{"field": "Online"}],
        "values": [{"field": "Amount", "aggregation": "sum"}]
      },
