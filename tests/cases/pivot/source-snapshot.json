{
  "about": "The bundled source over a Snapshot (ADR-0064/0066): its fields from the columns or declared by column name, Items from each column's kind (ADR-0060, PV-3), and every Aggregation read from typed columns (PV-4). Transcribed from ExPivot.Engine.Tests' SnapshotSourceTests.",
  "kind": "pivotSource",
  "data": "rows",
  "locale": "en-US",
  "words": "english",
  "cases": [
    {
      "name": "ADR-0066: with no fields declared, one field per column, captioned as the column is and typed by its kind",
      "asks": [{"fields": true}],
      "expect": [
        [
          {"name": "Text", "caption": "Label", "type": "text"},
          {"name": "Money", "caption": "Money", "type": "number"},
          {"name": "Measure", "caption": "Measure", "type": "number"},
          {"name": "Count", "caption": "Count", "type": "number"},
          {"name": "When", "caption": "When", "type": "date"},
          {"name": "Flag", "caption": "Flag", "type": "boolean"}
        ]
      ]
    },
    {
      "name": "ADR-0066: declared fields name their columns, by their own name or another's, and keep settings of their own",
      "declare": [
        {"name": "Desk", "type": "text", "caption": "Trading desk", "column": "Text"},
        {"name": "Money", "type": "number", "format": "#,##0.00"}
      ],
      "rows": [["A", {"decimal": "1.5"}, null, null, null, null], ["a", {"decimal": "2"}, null, null, null, null]],
      "asks": [
        {"fields": true},
        {"report": {"rows": [{"field": "Desk"}], "values": [{"field": "Money", "aggregation": "sum"}]}}
      ],
      "expect": [
        [
          {"name": "Desk", "caption": "Trading desk", "type": "text", "column": "Text"},
          {"name": "Money", "caption": "Money", "type": "number", "format": "#,##0.00"}
        ],
        {
          "headers": ["Row Labels", "Sum of Money"],
          "lines": ["i A || 3.5", "t Grand Total || 3.5"],
          "spans": []
        }
      ]
    },
    {
      "name": "ADR-0066: a field naming a column the Snapshot does not have is refused by name",
      "declare": [{"name": "Region", "type": "text"}],
      "asks": [{"fields": true}],
      "expect": {
        "refusal": "argument",
        "saying": "The Snapshot has no column named 'Region' for the Pivot Field 'Region'."
      }
    },
    {
      "name": "ADR-0066: a field reading another column the Snapshot does not have is refused by both names",
      "declare": [{"name": "Desk", "type": "text", "column": "Desks"}],
      "asks": [{"fields": true}],
      "expect": {
        "refusal": "argument",
        "saying": "The Pivot Field 'Desk' reads the column 'Desks', and the Snapshot has no column of that name."
      }
    },
    {
      "name": "ADR-0066: a date part of a column that is not a Date column is refused by name",
      "declare": [{"name": "Month", "type": "date", "column": "Money", "datePart": "month"}],
      "asks": [{"fields": true}],
      "expect": {
        "refusal": "argument",
        "saying": "The Pivot Field 'Month' is the Month of 'Money', which is a Decimal column, not a Date column."
      }
    },
    {
      "name": "ADR-0066: a field declared twice is refused by name",
      "declare": [{"name": "Money", "type": "number"}, {"name": "Money", "type": "number"}],
      "asks": [{"fields": true}],
      "expect": {
        "refusal": "argument",
        "saying": "Two Pivot Fields are named 'Money'; a layout could not say which it means."
      }
    },
    {
      "name": "ADR-0060/0064 (PV-3): text Items ignore case and are labelled by the first spelling; a Blank in every kind is (blank)",
      "rows": [
        ["east", {"decimal": "1"}, 1, 1, {"date": "2026-01-01"}, true],
        ["East", {"decimal": "2"}, 2, 2, {"date": "2026-01-01"}, true],
        [null, null, null, null, null, null],
        ["", {"decimal": "4"}, 4, 4, {"date": "2026-01-02"}, false]
      ],
      "asks": [
        {"report": {"rows": [{"field": "Text"}], "values": [{"field": "Text", "aggregation": "count"}]}},
        {"report": {"rows": [{"field": "Money"}], "values": [{"field": "Text", "aggregation": "count"}]}},
        {"report": {"rows": [{"field": "Measure"}], "values": [{"field": "Text", "aggregation": "count"}]}},
        {"report": {"rows": [{"field": "Count"}], "values": [{"field": "Text", "aggregation": "count"}]}},
        {"report": {"rows": [{"field": "When"}], "values": [{"field": "Text", "aggregation": "count"}]}},
        {"report": {"rows": [{"field": "Flag"}], "values": [{"field": "Text", "aggregation": "count"}]}},
        {"report": {"rows": [{"field": "Text"}], "values": [{"field": "Money", "aggregation": "sum"}]}}
      ],
      "expect": [
        {
          "headers": ["Row Labels", "Count of Label"],
          "lines": ["i  || 1", "i east || 2", "i (blank) ||", "t Grand Total || 3"],
          "spans": []
        },
        {
          "headers": ["Row Labels", "Count of Label"],
          "lines": ["i 1 || 1", "i 2 || 1", "i 4 || 1", "i (blank) ||", "t Grand Total || 3"],
          "spans": []
        },
        {
          "headers": ["Row Labels", "Count of Label"],
          "lines": ["i 1 || 1", "i 2 || 1", "i 4 || 1", "i (blank) ||", "t Grand Total || 3"],
          "spans": []
        },
        {
          "headers": ["Row Labels", "Count of Label"],
          "lines": ["i 1 || 1", "i 2 || 1", "i 4 || 1", "i (blank) ||", "t Grand Total || 3"],
          "spans": []
        },
        {
          "headers": ["Row Labels", "Count of Label"],
          "lines": ["i 1/1/2026 || 2", "i 1/2/2026 || 1", "i (blank) ||", "t Grand Total || 3"],
          "spans": []
        },
        {
          "headers": ["Row Labels", "Count of Label"],
          "lines": ["i FALSE || 1", "i TRUE || 2", "i (blank) ||", "t Grand Total || 3"],
          "spans": []
        },
        {
          "headers": ["Row Labels", "Sum of Money"],
          "lines": ["i  || 4", "i east || 3", "i (blank) ||", "t Grand Total || 7"],
          "spans": []
        }
      ]
    },
    {
      "name": "ADR-0060/0064 (PV-3): a non-finite Double is #NUM!, after the Booleans and before (blank)",
      "rows": [
        ["a", {"decimal": "1"}, {"double": "NaN"}, null, null, null],
        ["b", {"decimal": "1"}, {"double": "Infinity"}, null, null, null],
        ["c", {"decimal": "1"}, {"double": "-Infinity"}, null, null, null],
        ["d", {"decimal": "1"}, {"double": "-0"}, null, null, null],
        ["e", {"decimal": "1"}, null, null, null, null]
      ],
      "asks": [
        {"report": {"rows": [{"field": "Measure"}], "values": [{"field": "Money", "aggregation": "sum"}]}},
        {"report": {"values": [{"field": "Measure", "aggregation": "sum"}]}}
      ],
      "expect": [
        {
          "headers": ["Row Labels", "Sum of Money"],
          "lines": ["i 0 || 1", "i #NUM! || 3", "i (blank) || 1", "t Grand Total || 5"],
          "spans": []
        },
        {"headers": ["Sum of Measure"], "lines": ["t  || #NUM!"], "spans": []}
      ]
    },
    {
      "name": "ADR-0060/0064 (PV-3): a date is its clock value, and a time of day is another Item",
      "rows": [
        ["a", {"decimal": "1"}, null, null, {"date": "2026-01-02"}, null],
        ["b", {"decimal": "2"}, null, null, {"date": "2026-01-02"}, null],
        ["c", {"decimal": "4"}, null, null, {"date": "2026-01-02T13:45:00"}, null]
      ],
      "asks": [{"report": {"rows": [{"field": "When"}], "values": [{"field": "Money", "aggregation": "sum"}]}}],
      "expect": [
        {
          "headers": ["Row Labels", "Sum of Money"],
          "lines": ["i 1/2/2026 || 3", "i 1/2/2026 1:45:00 PM || 4", "t Grand Total || 7"],
          "spans": []
        }
      ]
    },
    {
      "name": "ADR-0060/0064 (PV-3): an Integer 1, a Decimal 1.0 and a Double 1 are one Item, the same key in every kind",
      "rows": [["a", {"decimal": "1.0"}, 1, 1, null, null], ["b", {"decimal": "1.50"}, 1.5, 2, null, null]],
      "asks": [
        {"aggregate": {"rows": ["Count"]}},
        {"aggregate": {"rows": ["Money"]}},
        {"aggregate": {"rows": ["Measure"]}}
      ],
      "expect": [
        {
          "leaves": 2,
          "rows": [{"field": "Count", "items": [{"kind": "number", "value": "1"}, {"kind": "number", "value": "2"}]}],
          "columns": [],
          "leaf": [{"at": [0], "records": 1}, {"at": [1], "records": 1}],
          "values": []
        },
        {
          "leaves": 2,
          "rows": [
            {
              "field": "Money",
              "items": [{"kind": "number", "value": "1"}, {"kind": "number", "value": "1.5"}]
            }
          ],
          "columns": [],
          "leaf": [{"at": [0], "records": 1}, {"at": [1], "records": 1}],
          "values": []
        },
        {
          "leaves": 2,
          "rows": [
            {
              "field": "Measure",
              "items": [{"kind": "number", "value": "1"}, {"kind": "number", "value": "1.5"}]
            }
          ],
          "columns": [],
          "leaf": [{"at": [0], "records": 1}, {"at": [1], "records": 1}],
          "values": []
        }
      ]
    },
    {
