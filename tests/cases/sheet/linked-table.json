        {"declareTable": {"name": "Positions", "columns": ["Id", "@PV"]}},
        {"pushTable": {"name": "Positions", "rows": [["R-1", 2], ["R-2", 40]]}},
        {"enter": {"A1": "=SUM(Positions[['@PV]])"}, "expect": {"formulas": {"A1": "=SUM(Positions['@PV])"}, "values": {"A1": 42}}},
        {"retype": ["A1"], "expect": {"formulas": {"A1": "=SUM(Positions['@PV])"}, "values": {"A1": 42}}},
        {"reopen": "json", "expect": {"formulas": {"A1": "=SUM(Positions['@PV])"}}},
        {"pushTable": {"name": "Positions", "rows": [["R-1", 5], ["R-2", 37]]}, "expect": {"values": {"A1": 42}}}
