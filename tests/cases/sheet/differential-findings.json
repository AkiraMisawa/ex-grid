{
  "about": "What the differential run against the C# engine found (ADR-0370, section 2, src/npm/sheet-engine/differential/README.md), each written down once fixed, cut to the Formula that shows it.",
  "kind": "sheet",
  "culture": "en-US",
  "cases": [
    {
      "name": "ADR-0047: a SUMPRODUCT that overflows is an Error Value, as SUM's is: =SUMPRODUCT(9E+307,10)",
      "steps": [
        {
          "enter": {
            "ZZ1000": "=SUMPRODUCT(9E+307,10)"
          },
          "expect": {
            "values": {
              "ZZ1000": {
                "error": "#NUM!"
              }
            }
          }
        }
      ]
    },
    {
      "name": "ADR-0047: a SUMPRODUCT whose products sum past the largest double is an Error Value: =SUMPRODUCT(A1:A2,B1:B2)",
      "steps": [
        {
          "enter": {
            "A1": "9E+307",
            "A2": "9E+307",
            "B1": "1",
            "B2": "1",
            "ZZ1000": "=SUMPRODUCT(A1:A2,B1:B2)"
          },
          "expect": {
            "values": {
              "ZZ1000": {
                "error": "#NUM!"
              }
            }
          }
        }
      ]
    },
    {
      "name": "ADR-0047: General rounds a number to 15 significant digits half away from zero on its exact decimal value, an exact midpoint too: =1+2^-15",
      "steps": [
        {
          "enter": {
            "ZZ1000": "=1+2^-15"
          },
          "expect": {
            "texts": {
              "ZZ1000": "1.00003051757813"
            }
          }
        }
      ]
    },
    {
      "name": "ADR-0047: General rounds an exact midpoint away from zero where the digit before it is even: =1234567890123440+5",
      "steps": [
        {
          "enter": {
            "ZZ1000": "=1234567890123440+5"
          },
          "expect": {
            "texts": {
              "ZZ1000": "1.23456789012345E+15"
            }
          }
        }
      ]
    },
    {
      "name": "ADR-0047: General rounds an exact midpoint at the first decimal away from zero: =(1E+15+1)/2",
      "steps": [
        {
          "enter": {
            "ZZ1000": "=(1E+15+1)/2"
          },
          "expect": {
            "texts": {
              "ZZ1000": "500000000000001"
            }
          }
        }
      ]
    },
    {
      "name": "ADR-0047: a number written into text reads at 15 significant digits as General does, an exact midpoint away from zero: =(1+2^-15)&\"\"",
      "steps": [
        {
          "enter": {
            "ZZ1000": "=(1+2^-15)&\"\""
          },
          "expect": {
            "values": {
              "ZZ1000": "1.00003051757813"
            }
          }
        }
      ]
    },
    {
      "name": "ADR-0047: two numbers compare as they read at 15 significant digits, an exact midpoint away from zero: =1+2^-15=1.00003051757813",
      "steps": [
        {
          "enter": {
            "ZZ1000": "=1+2^-15=1.00003051757813",
            "ZZ1001": "=1+2^-15=1.00003051757812"
          },
          "expect": {
            "values": {
              "ZZ1000": true,
              "ZZ1001": false
            }
          }
        }
      ]
    },
    {
      "name": "ADR-0047: a number its percent sign scales past the largest double cannot be shown, and TEXT of it is #VALUE!, rather than an engine that throws: =9E+307 in 0.00%",
      "steps": [
        {
          "enter": {
            "A1": "9E+307",
            "B1": "=TEXT(A1,\"0.00%\")"
          }
        },
        {
          "setNumberFormat": {
            "A1": "0.00%"
          },
          "expect": {
            "displays": {
              "A1": {
                "width": null,
                "text": "",
                "cannotShow": true,
                "alignment": "right",
                "colour": null,
                "isNumber": true
              }
            },
            "values": {
              "B1": {
                "error": "#VALUE!"
              }
            }
          }
        }
      ]
    },
    {
