    {
      "name": "ADR-0048 (SH-13): steps undo in reverse order and redo in order, back to each state",
      "setup": "populated",
      "steps": [
        {
          "remember": "state 0"
        },
        {
          "do": {
            "deleteRows": [
              4
            ]
          }
        },
        {
          "remember": "state 1"
        },
        {
          "do": {
            "enter": {
              "A4": "=B2/2"
            }
          }
        },
        {
          "remember": "state 2"
        },
        {
          "do": {
            "insertColumns": [
              1,
              3
            ]
          }
        },
        {
          "remember": "state 3"
        },
        {
          "do": {
            "enter": {
              "A1": "10",
              "F1": "12%",
              "A2": "=C1",
              "G7": "9/28/2026"
            }
          }
        },
        {
          "remember": "state 4"
        },
        {
          "do": {
            "deleteRows": [
              1,
              2
            ]
          }
        },
        {
          "remember": "state 5"
        },
        {
          "do": {
            "setNumberFormat": {
              "at": [
                "A1",
                "A2",
                "Z1"
              ],
              "format": "#,##0"
            }
          }
        },
        {
          "remember": "state 6"
        },
        {
          "undo": 5,
          "expect": {
            "picture": "state 5"
          }
        },
        {
          "undo": 4,
          "expect": {
            "picture": "state 4"
          }
        },
        {
          "undo": 3,
          "expect": {
            "picture": "state 3"
          }
        },
        {
          "undo": 2,
          "expect": {
            "picture": "state 2"
          }
        },
        {
          "undo": 1,
          "expect": {
            "picture": "state 1"
          }
        },
        {
          "undo": 0,
          "expect": {
            "picture": "state 0"
          }
        },
        {
          "redo": 0,
          "expect": {
            "picture": "state 1"
          }
        },
        {
          "redo": 1,
          "expect": {
            "picture": "state 2"
          }
        },
        {
          "redo": 2,
          "expect": {
            "picture": "state 3"
          }
        },
        {
          "redo": 3,
          "expect": {
            "picture": "state 4"
          }
        },
        {
          "redo": 4,
          "expect": {
            "picture": "state 5"
          }
        },
        {
          "redo": 5,
          "expect": {
            "picture": "state 6"
          }
        }
      ]
    },
    {
      "name": "ADR-0047/0048 (SH-5): one undo restores a Formula a deletion made #REF!, and the range it shrank",
      "steps": [
        {
          "enter": {
            "A2": "2",
            "A3": "3",
            "A4": "4",
            "C1": "=A3*2",
            "D1": "=SUM(A2:A4)",
            "E1": "=SUM(A3:A4)"
          }
        },
        {
          "do": {
            "deleteRows": [
              2
            ]
          },
          "expect": {
            "formulas": {
              "C1": "=#REF!*2",
              "D1": "=SUM(A2:A3)",
              "E1": "=SUM(A3:A3)"
            }
          }
        },
        {
          "undo": "last",
          "expect": {
            "formulas": {
              "C1": "=A3*2",
              "D1": "=SUM(A2:A4)",
              "E1": "=SUM(A3:A4)"
            },
            "values": {
              "C1": 6,
              "D1": 9,
              "E1": 7
            },
            "change": {
              "rows": [
                0,
                2,
                3
              ]
            }
          }
        }
      ]
    },
    {
      "name": "ADR-0048: the change an undo reports names the rows it repainted",
      "setup": "populated",
      "steps": [
        {
          "do": {
            "enter": {
              "A3": "30"
            }
          },
          "expect": {
            "change": {
              "valueChanges": [
                "B1",
                "C1",
                "B2",
                "C2",
                "A3"
              ]
            }
          }
        },
        {
          "undo": "last",
          "expect": {
            "change": {
              "valueChanges": [
                "B1",
