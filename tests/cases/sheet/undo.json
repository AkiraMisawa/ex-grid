{
  "about": "Each user operation is one reversible step (ADR-0048, ticket 12, SH-13): undo is the identity, redo is the same as doing, a stack walks back and forth, and a refused operation is no step. Transcribed from ExSheet.Engine.Tests' UndoStepTests.",
  "kind": "sheet",
  "culture": "en-US",
  "setups": {
    "populated": [
      {
        "enter": {
          "A1": "1",
          "A2": "2",
          "A3": "3",
          "A5": "5",
          "B1": "=SUM(A1:A5)",
          "B2": "=A3*10",
          "B3": "=$A$5+A2",
          "C1": "=SUM(A:A)",
          "C2": "=B2+B3",
          "D4": "2026-09-27"
        }
      },
      {
        "setNumberFormat": {
          "A2": "0.00"
        }
      },
      {
        "setAlignment": {
          "B3": "center"
        }
      },
      {
        "setNumberFormat": {
          "E1048576": "0%",
          "XFD9": "0%"
        }
      }
    ]
  },
  "cases": [
