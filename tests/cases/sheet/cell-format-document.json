{
  "about": "The Sheet Document records Font, Fill and Borders for cells, rows and columns since version 8; an older version reads with none of them and refuses a document holding them; a colour of any other kind than Automatic or RGB is refused by name (ADR-0071, ADR-0048, SH-38). A document's JSON is read as text. Transcribed from ExSheet.Engine.Tests' CellFormatDocumentTests; how d-mmm-yy is read as a local code under en-GB is in the surface tests.",
  "kind": "sheet",
  "culture": "en-US",
  "cases": [
    {
      "name": "ADR-0071, ADR-0048 (SH-38): Font, Fill and Borders are recorded for cells, rows and columns, and round-trip",
      "steps": [
        {"setCellFormat": {"ranges": ["B:B"], "change": {"italic": true, "fill": "#FFFF00"}}},
        {"setCellFormat": {"ranges": ["3:3"], "change": {"bold": true, "fontColour": "#FF0000"}}},
        {"setCellFormat": {"ranges": ["B5"], "change": {"underline": true, "strikethrough": true, "fill": "none", "borders": {"top": {"style": "thin"}, "bottom": {"style": "double", "colour": "#0000FF"}}}}},
        {"read": true, "expect": {"documentJson": "{\"version\":9,\"culture\":\"en-US\",\"name\":\"Sheet1\",\"columns\":[{\"at\":\"B:B\",\"font\":{\"italic\":true},\"fill\":\"#FFFF00\"}],\"rows\":[{\"at\":\"3:3\",\"font\":{\"color\":\"#FF0000\",\"bold\":true}}],\"cells\":[{\"at\":\"B3\",\"font\":{\"color\":\"#FF0000\",\"bold\":true,\"italic\":true}},{\"at\":\"B5\",\"font\":{\"italic\":true,\"underline\":true,\"strikethrough\":true},\"fill\":\"none\",\"borders\":{\"top\":{\"style\":\"thin\"},\"bottom\":{\"style\":\"double\",\"color\":\"#0000FF\"}}}]}"}},
        {"remember": "saved"},
        {"reopen": {"sheet": "Sheet1"}, "expect": {"picture": "saved", "cellFormats": {"B3": [{"numberFormat": "General", "alignment": "general", "font": {"colour": "#FF0000", "bold": true, "italic": true, "underline": false, "strikethrough": false}, "fill": "#FFFF00", "borders": {"top": "none", "bottom": "none", "left": "none", "right": "none"}}], "B4": [{"numberFormat": "General", "alignment": "general", "font": {"colour": "Automatic", "bold": false, "italic": true, "underline": false, "strikethrough": false}, "fill": "#FFFF00", "borders": {"top": "none", "bottom": "none", "left": "none", "right": "none"}}], "B5": [{"numberFormat": "General", "alignment": "general", "font": {"colour": "Automatic", "bold": false, "italic": true, "underline": true, "strikethrough": true}, "fill": "none", "borders": {"top": {"style": "thin", "colour": "Automatic"}, "bottom": {"style": "double", "colour": "#0000FF"}, "left": "none", "right": "none"}}], "B6": [{"numberFormat": "General", "alignment": "general", "font": {"colour": "Automatic", "bold": false, "italic": true, "underline": false, "strikethrough": false}, "fill": "#FFFF00", "borders": {"top": "none", "bottom": "none", "left": "none", "right": "none"}}], "B9": [{"numberFormat": "General", "alignment": "general", "font": {"colour": "Automatic", "bold": false, "italic": true, "underline": false, "strikethrough": false}, "fill": "#FFFF00", "borders": {"top": "none", "bottom": "none", "left": "none", "right": "none"}}], "C3": [{"numberFormat": "General", "alignment": "general", "font": {"colour": "#FF0000", "bold": true, "italic": false, "underline": false, "strikethrough": false}, "fill": "none", "borders": {"top": "none", "bottom": "none", "left": "none", "right": "none"}}], "C5": [{"numberFormat": "General", "alignment": "general", "font": {"colour": "Automatic", "bold": false, "italic": false, "underline": false, "strikethrough": false}, "fill": "none", "borders": {"top": "none", "bottom": "none", "left": "none", "right": "none"}}]}}}
      ]
    },
