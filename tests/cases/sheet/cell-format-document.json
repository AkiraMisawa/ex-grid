        {"reopen": {"sheet": "Sheet1"}, "note": "The cell below each shows the same line on its top, which it shares (case 11-7).", "expect": {"borders": {"B2": {"bottom": {"style": "hair", "colour": "#000000"}}, "B3": {"bottom": {"style": "thin", "colour": "#000001"}}, "B4": {"bottom": {"style": "medium", "colour": "#000002"}}, "B5": {"bottom": {"style": "thick", "colour": "#000003"}}, "B6": {"bottom": {"style": "double", "colour": "#000004"}}, "B7": {"bottom": {"style": "dotted", "colour": "#000005"}}, "B8": {"bottom": {"style": "dashed", "colour": "#000006"}}, "B9": {"bottom": {"style": "dashDot", "colour": "#000007"}}, "B10": {"bottom": {"style": "dashDotDot", "colour": "#000008"}}, "B11": {"bottom": {"style": "mediumDashed", "colour": "#000009"}}, "B12": {"bottom": {"style": "mediumDashDot", "colour": "#00000A"}}, "B13": {"bottom": {"style": "mediumDashDotDot", "colour": "#00000B"}}, "B14": {"bottom": {"style": "slantedDashDot", "colour": "#00000C"}}}}},
        {"read": true, "expect": {"borders": {"B3": {"top": {"style": "hair", "colour": "#000000"}}, "B4": {"top": {"style": "thin", "colour": "#000001"}}, "B5": {"top": {"style": "medium", "colour": "#000002"}}, "B6": {"top": {"style": "thick", "colour": "#000003"}}, "B7": {"top": {"style": "double", "colour": "#000004"}}, "B8": {"top": {"style": "dotted", "colour": "#000005"}}, "B9": {"top": {"style": "dashed", "colour": "#000006"}}, "B10": {"top": {"style": "dashDot", "colour": "#000007"}}, "B11": {"top": {"style": "dashDotDot", "colour": "#000008"}}, "B12": {"top": {"style": "mediumDashed", "colour": "#000009"}}, "B13": {"top": {"style": "mediumDashDot", "colour": "#00000A"}}, "B14": {"top": {"style": "mediumDashDotDot", "colour": "#00000B"}}, "B15": {"top": {"style": "slantedDashDot", "colour": "#00000C"}}}}}
