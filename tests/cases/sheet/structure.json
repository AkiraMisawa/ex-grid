{
  "about": "Inserting and deleting rows and columns (ticket 13, SH-5's engine half): References are rewritten, formatting is lent by the row above or the column to the left, and the change names what moved. Transcribed from ExSheet.Engine.Tests' StructureTests.",
  "kind": "sheet",
  "culture": "en-US",
  "cases": [
    {
      "name": "ADR-0047 (SH-5): deleting a referenced cell makes the stored Formula #REF!",
      "steps": [
        { "enter": { "A5": "1", "B1": "=A5+1" } },
        {
          "do": { "deleteRows": [4] },
          "expect": {
            "formulas": { "B1": "=#REF!+1" },
            "values": { "B1": { "error": "#REF!" } },
            "change": { "valueChanges": ["B1", "A5"] }
          }
        }
      ]
    },
    {
      "name": "ADR-0047: whole columns do not change on a row edit, whole rows move with one",
      "steps": [
        { "enter": { "A3": "5", "A4": "7", "B1": "=SUM(A:A)+SUM(3:3)" } },
        { "do": { "insertRows": [1] }, "expect": { "formulas": { "B1": "=SUM(A:A)+SUM(4:4)" }, "values": { "B1": 17 } } },
        {
          "do": { "deleteRows": [4] },
          "note": "The text stays, but a deleted cell leaves what A:A covers: the Value follows.",
          "expect": {
            "formulas": { "B1": "=SUM(A:A)+SUM(4:4)" },
            "values": { "B1": 10 },
            "change": { "valueChanges": ["B1", "A5"] }
          }
        }
      ]
    },
    {
      "name": "ADR-0046: inserted rows take the number format and alignment of the row above, never its Entries",
      "steps": [
        { "enter": { "A2": "1.5" } },
        { "setNumberFormat": { "A2": "0.00", "C3": "0%" } },
        { "setAlignment": { "B2": "center" } },
        {
          "do": { "insertRows": [2, 2] },
          "note": "The row that was below keeps its own formatting, moved down; it lends nothing upwards.",
          "expect": {
            "numberFormats": { "A3": "0.00", "A4": "0.00", "C3": "General", "C5": "0%" },
            "alignments": { "A3": "general", "A4": "general", "B3": "center", "B4": "center" },
            "entries": { "A3": null, "A4": null },
            "values": { "A2": 1.5, "A3": null, "A4": null },
            "change": { "rows": [2, 3, 4] }
          }
        },
        { "enter": { "A3": "2" }, "expect": { "texts": { "A3": "2.00" } } }
      ]
    },
    {
      "name": "ADR-0046: inserted columns take the number format and alignment of the column to the left",
      "steps": [
        { "enter": { "B1": "x" } },
        { "setAlignment": { "B1": "right" } },
        { "setNumberFormat": { "B7": "#,##0" } },
        {
          "do": { "insertColumns": [2, 3] },
          "expect": {
            "alignments": { "C1": "right", "D1": "right", "E1": "right" },
            "entries": { "C1": null, "D1": null, "E1": null },
            "numberFormats": { "C7": "#,##0", "D7": "#,##0", "E7": "#,##0" },
            "values": { "B1": "x" }
          }
        }
      ]
    },
    {
      "name": "ADR-0046/0048: undoing an insertion removes the formatting it copied, exactly",
      "steps": [
        { "enter": { "A2": "1" } },
        { "setNumberFormat": { "A2": "0.00" } },
        { "remember": "before" },
        { "do": { "insertRows": [2, 3] }, "expect": { "numberFormats": { "A5": "0.00" } } },
        { "undo": "last", "expect": { "picture": "before" } }
      ]
    },
    {
      "name": "ADR-0046 (SH-5): Entries move with their formats and alignment",
      "steps": [
        { "enter": { "A5": "1.5" } },
        { "setNumberFormat": { "A5": "0.00" } },
        { "setAlignment": { "B5": "center" } },
        {
          "do": { "insertRows": [1, 3] },
          "expect": {
            "texts": { "A8": "1.50" },
            "alignments": { "B8": "center", "B5": "general" },
            "numberFormats": { "A5": "General" }
          }
        }
      ]
    },
    {
      "name": "ADR-0046 (SH-5): the change names every row whose content moved or changed, and no other",
      "steps": [
        { "enter": { "A1": "1", "A3": "3", "A5": "5", "C1": "=A1" } },
        {
          "do": { "insertRows": [2] },
          "note": "Row 3 (index 2) is now blank, row 4 holds 3, row 5 is blank, row 6 holds 5.",
          "expect": { "change": { "rows": [2, 3, 4, 5], "valueChanges": ["A3", "A4", "A5", "A6"], "recalculated": [] } }
        }
      ]
    },
    {
      "name": "ADR-0047: a Formula that moved but reads nothing that moved keeps its Value without recomputing",
      "steps": [
        { "enter": { "A1": "2", "A10": "=A1*3", "A20": "7", "B1": "=A20" } },
        { "do": { "insertRows": [4] }, "expect": { "change": { "recalculated": ["B1"] }, "values": { "A11": 6 } } }
      ]
    },
    {
      "name": "ADR-0047: the dependency graph follows the moved cells",
      "steps": [
        { "enter": { "A5": "1", "B5": "=A5*10", "C1": "=SUM(B1:B9)" } },
        { "do": { "insertRows": [0] } },
        { "enter": { "A6": "2" }, "expect": { "change": { "recalculated": ["C2", "B6"] }, "values": { "C2": 20 } } }
      ]
    },
    {
      "name": "ADR-0046: an edit outside the Sheet's extent is refused as an argument (insert past the last row)",
      "steps": [{ "do": { "insertRows": [1048576] }, "expect": { "throws": { "refusal": "argument" } } }]
    },
    {
      "name": "ADR-0046: an edit outside the Sheet's extent is refused as an argument (delete past the last row)",
      "steps": [{ "do": { "deleteRows": [1048575, 2] }, "expect": { "throws": { "refusal": "argument" } } }]
    },
    {
      "name": "ADR-0046: an edit outside the Sheet's extent is refused as an argument (delete no columns)",
      "steps": [{ "do": { "deleteColumns": [0, 0] }, "expect": { "throws": { "refusal": "argument" } } }]
    },
    {
      "name": "ADR-0046/0047 (observed in Excel): an insertion that pushes a Reference off the Sheet is done; undo puts the Formula back",
      "steps": [
        { "enter": { "A1048575": "4", "B1": "=SUM(A2:A1048576)+A1048576" } },
        { "do": { "insertRows": [0] }, "expect": { "formulas": { "B2": "=SUM(A3:A1048576)+#REF!" }, "values": { "B2": { "error": "#REF!" } } } },
        { "undo": "last", "expect": { "formulas": { "B1": "=SUM(A2:A1048576)+A1048576" }, "values": { "B1": 4 } } }
      ]
    },
    {
      "name": "ADR-0048: the rewritten Formulas are what the Sheet Document records",
      "steps": [
        { "enter": { "A5": "1", "B1": "=A5" } },
        { "do": { "insertRows": [0] } },
        { "reopen": "json", "expect": { "formulas": { "B2": "=A6" }, "values": { "B2": 1 } } }
      ]
    }
  ]
}
