        {"call": "offsetPxOf", "args": [0], "is": 0},
        {"call": "offsetPxOf", "args": [1], "is": 100},
        {"call": "offsetPxOf", "args": [2], "is": 200},
        {"call": "offsetPxOf", "args": [3], "is": 300},
        {"call": "offsetPxOf", "args": [4], "is": 400},
        {"call": "offsetPxOf", "args": [5], "is": 500},
        {"get": "pinnedWidthPx", "is": 200},
        {"call": "isInLead", "args": [10, 0], "is": false}
      ]
    },
    {
      "name": "ADR-0050: a pixel in the band is in the lead at any scroll offset",
      "create": {"pinnedCount": 0, "viewportWidthPx": 350, "leadWidthPx": 40},
      "expect": [
        {"call": "isInLead", "args": [10, 0], "is": true},
        {"call": "isInLead", "args": [110, 100], "is": true},
        {"call": "isInLead", "args": [45, 0], "is": false},
        {"call": "isInLead", "args": [145, 100], "is": false},
        {"call": "isInLead", "args": ["NaN", 0], "is": false}
      ]
    },
    {
      "name": "ADR-0050/0004: a pixel in the band names the first column clear of it, not what has scrolled underneath",
      "create": {"pinnedCount": 0, "viewportWidthPx": 350, "leadWidthPx": 40},
      "expect": [
        {"call": "columnAt", "args": [160, 150], "is": 1},
        {"call": "columnAt", "args": [10, 0], "is": 0},
        {"call": "columnAt", "args": [60, 0], "is": 0}
      ]
    },
    {
      "name": "ADR-0050/0004: a column is revealed clear of the band, as it is clear of a pinned block",
      "create": {"pinnedCount": 0, "viewportWidthPx": 350, "leadWidthPx": 40},
      "expect": [
        {"call": "scrollLeftToReveal", "args": [1, 190], "is": 100},
        {"call": "scrollableSliceAt", "args": [100, true], "is": {"start": 1, "count": 4}}
      ]
    },
    {
      "name": "ADR-0090: what a column declares is kept beside what it is painted at",
      "create": {"widthsPx": [99, 99], "pinnedCount": 0, "viewportWidthPx": 350, "leadWidthPx": 0, "devicePixelRatio": 1.5},
      "expect": [
        {"call": "declaredWidthPxOf", "args": [0], "is": 99},
        {"call": "declaredWidthPxOf", "args": [1], "is": 99},
        {"call": "widthPxOf", "args": [0], "is": 99.33333333333333},
        {"call": "widthPxOf", "args": [1], "is": 98.66666666666667},
        {"get": "devicePixelRatio", "is": 1.5}
      ]
    },
    {
      "name": "ADR-0090 / VZ-17: 99px is 148.5 Device Pixels at 150%, so the columns alternate 149 and 148, never all one",
      "create": {"widthsPx": [99, 99, 99, 99], "pinnedCount": 0, "viewportWidthPx": 350, "leadWidthPx": 0, "devicePixelRatio": 1.5},
      "expect": [
        {"call": "widthPxOf", "args": [0], "is": 99.33333333333333},
        {"call": "widthPxOf", "args": [1], "is": 98.66666666666667},
        {"call": "widthPxOf", "args": [2], "is": 99.33333333333333},
        {"call": "offsetPxOf", "args": [4], "is": 396.0}
      ]
    },
    {
