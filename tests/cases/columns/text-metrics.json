        {"get": "bold", "then": [{"call": "textWidthPx", "args": ["M"], "is": 14}, {"call": "textWidthPx", "args": ["m"], "is": 14}, {"call": "textWidthPx", "args": ["W"], "is": 14}, {"call": "textWidthPx", "args": ["A"], "is": 14}, {"call": "textWidthPx", "args": ["ж"], "is": 14}, {"call": "textWidthPx", "args": ["מ"], "is": 14}, {"call": "textWidthPx", "args": ["พ"], "is": 14}, {"call": "textWidthPx", "args": ["₩"], "is": 14}, {"call": "textWidthPx", "args": ["₪"], "is": 14}, {"call": "textWidthPx", "args": ["₦"], "is": 14}, {"call": "textWidthPx", "args": ["₱"], "is": 14}, {"call": "textWidthPx", "args": ["₽"], "is": 14}, {"call": "textWidthPx", "args": ["₼"], "is": 14}, {"call": "textWidthPx", "args": ["₴"], "is": 14}, {"call": "textWidthPx", "args": ["¤"], "is": 14}, {"call": "textWidthPx", "args": ["฿"], "is": 14}, {"call": "textWidthPx", "args": ["‰"], "is": 14}, {"call": "textWidthPx", "args": ["𝐀"], "is": 14}]}
