{
  "about": "The per-character-class estimate (ADR-0016), its bold widths (ADR-0050 item 15) and the other class and glyph table (ticket 83). From dotnet/tests/ExGrid.Tests/CellTextMetricsClassTests.cs, BoldWidthTests.cs, OtherClassTests.cs and GlyphWidthTableTests.cs; what needs the resolved Grid Metrics stays there until they are shared.",
  "kind": "calls",
  "subject": "CellTextMetrics",
  "cases": [
    {
      "name": "ADR-0016: % and € charge wide, the separators narrow, and the digit class a digit",
      "create": {"wideWidthPx": 14, "digitWidthPx": 9, "narrowWidthPx": 5, "cellHorizontalPaddingPx": 8},
      "expect": [
        {"call": "textWidthPx", "args": ["%"], "is": 14},
        {"call": "textWidthPx", "args": ["€"], "is": 14},
        {"call": "textWidthPx", "args": ["."], "is": 5},
        {"call": "textWidthPx", "args": [","], "is": 5},
        {"call": "textWidthPx", "args": ["7"], "is": 9},
        {"call": "textWidthPx", "args": ["$"], "is": 9},
        {"call": "textWidthPx", "args": ["-"], "is": 9}
      ]
    },
    {
      "name": "ADR-0016: the estimate is the text charged per class, plus padding both sides",
      "create": {"wideWidthPx": 14, "digitWidthPx": 9, "narrowWidthPx": 5, "cellHorizontalPaddingPx": 8},
      "expect": [
        {"call": "textWidthPx", "args": ["12.5%"], "is": 46},
        {"call": "estimatePx", "args": ["12.5%"], "is": 62}
      ]
    },
    {
      "name": "ADR-0016: the two-number form charges everything at the digit, the uniform contract",
      "create": {"digitWidthPx": 9, "cellHorizontalPaddingPx": 8},
      "expect": [
        {"call": "textWidthPx", "args": ["%"], "is": 9},
        {"call": "textWidthPx", "args": ["."], "is": 9},
        {"call": "textWidthPx", "args": ["評"], "is": 9},
        {"call": "estimatePx", "args": ["12.5%"], "is": 61}
      ]
    },
    {
      "name": "The class widths keep their ordering: a wide width under the digit is refused",
      "create": {"wideWidthPx": 8, "digitWidthPx": 9, "narrowWidthPx": 5, "cellHorizontalPaddingPx": 8},
      "throws": "outOfRange"
    },
    {
      "name": "The class widths keep their ordering: a narrow width over the digit is refused",
      "create": {"wideWidthPx": 14, "digitWidthPx": 9, "narrowWidthPx": 10, "cellHorizontalPaddingPx": 8},
      "throws": "outOfRange"
    },
    {
      "name": "ADR-0016: a full-width width under the digit is refused",
      "create": {"wideWidthPx": 14, "digitWidthPx": 9, "narrowWidthPx": 5, "cellHorizontalPaddingPx": 8, "fullWidthPx": 8.5},
      "throws": "outOfRange"
    },
    {
      "name": "ADR-0016: a full-width width that is not a number is refused",
      "create": {"wideWidthPx": 14, "digitWidthPx": 9, "narrowWidthPx": 5, "cellHorizontalPaddingPx": 8, "fullWidthPx": "NaN"},
      "throws": "outOfRange"
    },
    {
      "name": "ADR-0016: a zero digit width is refused by name",
      "create": {"digitWidthPx": 0, "cellHorizontalPaddingPx": 4},
      "throws": "outOfRange"
    },
    {
      "name": "ADR-0016: a digit width that is not a number is refused by name",
      "create": {"digitWidthPx": "NaN", "cellHorizontalPaddingPx": 4},
      "throws": "outOfRange"
    },
    {
      "name": "ADR-0016: a negative padding is refused by name",
      "create": {"digitWidthPx": 7, "cellHorizontalPaddingPx": -1},
      "throws": "outOfRange"
    },
    {
      "name": "ADR-0016 (2026-09-25): − + # measured 11.731px on DejaVu Sans, so they charge wide; the hyphen-minus stays a digit",
      "create": {"wideWidthPx": 14, "digitWidthPx": 9, "narrowWidthPx": 5, "cellHorizontalPaddingPx": 8},
      "expect": [
        {"call": "textWidthPx", "args": ["−"], "is": 14},
        {"call": "textWidthPx", "args": ["+"], "is": 14},
        {"call": "textWidthPx", "args": ["#"], "is": 14},
        {"call": "textWidthPx", "args": ["-"], "is": 9}
      ]
    },
    {
      "name": "ADR-0016 (2026-09-25): East Asian Width W or F is a fourth class, charged at 1em",
      "create": {"wideWidthPx": 14, "digitWidthPx": 9, "narrowWidthPx": 5, "cellHorizontalPaddingPx": 8, "fullWidthPx": 16},
      "expect": [
        {"call": "textWidthPx", "args": ["評"], "is": 16},
        {"call": "textWidthPx", "args": ["あ"], "is": 16},
        {"call": "textWidthPx", "args": ["ア"], "is": 16},
        {"call": "textWidthPx", "args": ["한"], "is": 16},
        {"call": "textWidthPx", "args": ["\u3000"], "is": 16},
        {"call": "textWidthPx", "args": ["１"], "is": 16},
        {"call": "textWidthPx", "args": ["（"], "is": 16},
        {"call": "textWidthPx", "args": ["。"], "is": 16}
      ]
    },
    {
      "name": "ADR-0016 / ticket 83: what is not full-width keeps its class, and a letter or halfwidth katakana is the other class",
      "create": {"wideWidthPx": 14, "digitWidthPx": 9, "narrowWidthPx": 5, "cellHorizontalPaddingPx": 8, "fullWidthPx": 16},
      "expect": [
        {"call": "textWidthPx", "args": ["A"], "is": 18},
        {"call": "textWidthPx", "args": ["ｱ"], "is": 18},
        {"call": "textWidthPx", "args": ["7"], "is": 9},
        {"call": "textWidthPx", "args": ["%"], "is": 14},
        {"call": "textWidthPx", "args": ["."], "is": 5}
      ]
    },
    {
      "name": "ADR-0016: a supplementary ideograph is one glyph, charged once, not once per surrogate",
      "create": {"wideWidthPx": 14, "digitWidthPx": 9, "narrowWidthPx": 5, "cellHorizontalPaddingPx": 8, "fullWidthPx": 16},
      "expect": [
        {"call": "textWidthPx", "args": ["𠮷"], "is": 16},
        {"call": "textWidthPx", "args": ["𠮷1"], "is": 25}
      ]
    },
    {
      "name": "ADR-0016: \"評価額\" is 42px at 14px in every family measured; charged as digits it was 27",
      "create": {"wideWidthPx": 14.028, "digitWidthPx": 9.742, "narrowWidthPx": 6.398, "cellHorizontalPaddingPx": 0, "fullWidthPx": 14},
      "expect": [
        {"call": "textWidthPx", "args": ["評価額"], "is": 42}
      ]
    },
    {
      "name": "ADR-0016: the three-class form charges full-width at twice the digit, at least an em",
      "create": {"wideWidthPx": 14, "digitWidthPx": 9, "narrowWidthPx": 5, "cellHorizontalPaddingPx": 8},
      "expect": [
        {"get": "fullWidthPx", "is": 18},
        {"call": "textWidthPx", "args": ["評"], "is": 18}
      ]
    },
    {
      "name": "ADR-0050 item 15: the bold metrics put the bold widths in the regular ones' place, and are bold however often asked",
      "create": {"wideWidthPx": 14, "digitWidthPx": 9, "narrowWidthPx": 5, "fullWidthPx": 14, "cellHorizontalPaddingPx": 4, "boldWideWidthPx": 15, "boldDigitWidthPx": 10, "boldNarrowWidthPx": 6},
      "expect": [
        {"get": "bold", "then": [{"call": "textWidthPx", "args": ["%"], "is": 15}, {"call": "textWidthPx", "args": ["7"], "is": 10}, {"call": "textWidthPx", "args": ["."], "is": 6}, {"call": "textWidthPx", "args": ["評"], "is": 14}, {"get": "wideWidthPx", "is": 15}, {"get": "digitWidthPx", "is": 10}, {"get": "narrowWidthPx", "is": 6}, {"get": "fullWidthPx", "is": 14}, {"get": "cellHorizontalPaddingPx", "is": 4}, {"get": "boldWideWidthPx", "is": 15}, {"get": "boldDigitWidthPx", "is": 10}, {"get": "boldNarrowWidthPx", "is": 6}, {"get": "otherWidthPx", "is": 20}, {"get": "boldOtherWidthPx", "is": 20}, {"get": "bold", "then": [{"get": "wideWidthPx", "is": 15}, {"get": "digitWidthPx", "is": 10}, {"get": "narrowWidthPx", "is": 6}, {"get": "fullWidthPx", "is": 14}, {"get": "cellHorizontalPaddingPx", "is": 4}, {"get": "boldWideWidthPx", "is": 15}, {"get": "boldDigitWidthPx", "is": 10}, {"get": "boldNarrowWidthPx", "is": 6}, {"get": "otherWidthPx", "is": 20}, {"get": "boldOtherWidthPx", "is": 20}]}]}
      ]
    },
    {
      "name": "ADR-0050 item 15: metrics built without bold widths derive them by the allowance, erring early",
      "create": {"wideWidthPx": 14, "digitWidthPx": 9, "narrowWidthPx": 5, "cellHorizontalPaddingPx": 4, "fullWidthPx": 14},
      "expect": [
        {"static": "boldWidthAllowance", "is": 1.04},
        {"get": "boldWideWidthPx", "is": 14.56, "near": 1e-09},
        {"get": "boldDigitWidthPx", "is": 9.36, "near": 1e-09},
        {"get": "boldNarrowWidthPx", "is": 5.2, "near": 1e-09}
      ]
    },
    {
      "name": "ADR-0050 item 15: the uniform form's bold metrics stay valid although its em is the digit",
      "create": {"digitWidthPx": 9, "cellHorizontalPaddingPx": 4},
      "expect": [
        {"get": "bold", "then": [{"get": "digitWidthPx", "is": 9.36, "near": 1e-09}, {"get": "fullWidthPx", "is": 9.36, "near": 1e-09}]}
      ]
    },
    {
      "name": "ADR-0050 item 15: a bold wide width under the bold digit is refused",
