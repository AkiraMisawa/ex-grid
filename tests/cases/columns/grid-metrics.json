      "expect": [
        {"static": "resolve", "args": {"density": "excel"}, "then": [{"get": "rowHeightPx", "is": 20}, {"get": "headerHeightPx", "is": 20}, {"get": "fontSizePx", "is": 12}, {"get": "digitWidthPx", "is": 8.36}, {"get": "cellPaddingXPx", "is": 4}]}
