    {
      "name": "ADR-0028: Compact resolves whole: a complete, self-consistent set",
      "expect": [
        {"static": "resolve", "args": {"density": "compact"}, "then": [{"get": "rowHeightPx", "is": 28}, {"get": "headerHeightPx", "is": 28}, {"get": "fontSizePx", "is": 14}, {"get": "digitWidthPx", "is": 9.75}, {"get": "cellPaddingXPx", "is": 8}]}
