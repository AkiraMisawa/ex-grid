{
  "about": "A Board Diff (ADR-0340, Q7): read back from its JSON, written again byte for byte, and laid against a Board, what no longer fits dropped by name. Transcribed from ExBoard.Tests' BoardDiffTests; the changes a user makes in a running Board stay there and in @ex-grid/board's own tests.",
  "kind": "boardDiff",
  "boards": {
    "written": "{\"version\": 1, \"inputs\": {\"trades\": {\"columns\": [{\"name\": \"id\", \"type\": \"text\"}, {\"name\": \"desk\", \"type\": \"text\"}, {\"name\": \"pnl\", \"type\": \"decimal\"}, {\"name\": \"day\", \"type\": \"date\"}]}}, \"views\": [{\"id\": \"blotter\", \"grid\": {\"data\": \"trades\", \"columns\": [{\"column\": \"id\", \"pinned\": true}, {\"column\": \"desk\"}, {\"column\": \"pnl\", \"format\": \"#,##0\", \"width\": 90}]}}, {\"id\": \"byDesk\", \"pivot\": {\"data\": \"trades\", \"layout\": {\"version\": 1, \"rows\": [{\"field\": \"desk\"}], \"values\": [{\"field\": \"pnl\", \"aggregation\": \"sum\"}]}}}, {\"id\": \"curve\", \"chart\": {\"version\": 1, \"axis\": {\"values\": \"dates\"}, \"series\": [{\"id\": \"pnl\", \"name\": \"P&L\", \"kind\": \"level\", \"data\": \"trades\", \"x\": \"day\", \"y\": \"pnl\"}]}}], \"layout\": [{\"views\": [\"blotter\", \"byDesk\"]}, {\"views\": [\"curve\"]}]}",
    "changed": "{\"version\": 1, \"inputs\": {\"trades\": {\"columns\": [{\"name\": \"id\", \"type\": \"text\"}, {\"name\": \"desk\", \"type\": \"text\"}, {\"name\": \"pnl\", \"type\": \"decimal\"}, {\"name\": \"day\", \"type\": \"date\"}]}}, \"views\": [{\"id\": \"blotter\", \"grid\": {\"data\": \"trades\", \"columns\": [{\"column\": \"id\"}, {\"column\": \"desk\"}, {\"column\": \"day\"}]}}, {\"id\": \"byDay\", \"pivot\": {\"data\": \"trades\", \"layout\": {\"version\": 1, \"rows\": [{\"field\": \"day\"}]}}}, {\"id\": \"curve\", \"grid\": {\"data\": \"trades\", \"columns\": [{\"column\": \"day\"}]}}], \"layout\": [{\"views\": [\"blotter\", \"byDay\"]}, {\"views\": [\"curve\"]}]}",
    "deskInteger": "{\"version\": 1, \"inputs\": {\"trades\": {\"columns\": [{\"name\": \"id\", \"type\": \"text\"}, {\"name\": \"desk\", \"type\": \"integer\"}, {\"name\": \"pnl\", \"type\": \"decimal\"}, {\"name\": \"day\", \"type\": \"date\"}]}}, \"views\": [{\"id\": \"blotter\", \"grid\": {\"data\": \"trades\", \"columns\": [{\"column\": \"id\", \"pinned\": true}, {\"column\": \"desk\"}, {\"column\": \"pnl\", \"format\": \"#,##0\", \"width\": 90}]}}, {\"id\": \"byDesk\", \"pivot\": {\"data\": \"trades\", \"layout\": {\"version\": 1, \"rows\": [{\"field\": \"desk\"}], \"values\": [{\"field\": \"pnl\", \"aggregation\": \"sum\"}]}}}, {\"id\": \"curve\", \"chart\": {\"version\": 1, \"axis\": {\"values\": \"dates\"}, \"series\": [{\"id\": \"pnl\", \"name\": \"P&L\", \"kind\": \"level\", \"data\": \"trades\", \"x\": \"day\", \"y\": \"pnl\"}]}}], \"layout\": [{\"views\": [\"blotter\", \"byDesk\"]}, {\"views\": [\"curve\"]}]}",
    "deskGone": "{\"version\": 1, \"inputs\": {\"trades\": {\"columns\": [{\"name\": \"id\", \"type\": \"text\"}, {\"name\": \"desk\", \"type\": \"text\"}, {\"name\": \"pnl\", \"type\": \"decimal\"}, {\"name\": \"day\", \"type\": \"date\"}]}}, \"views\": [{\"id\": \"blotter\", \"grid\": {\"data\": \"trades\", \"columns\": [{\"column\": \"id\", \"pinned\": true}, {\"column\": \"pnl\", \"format\": \"#,##0\", \"width\": 90}]}}, {\"id\": \"byDesk\", \"pivot\": {\"data\": \"trades\", \"layout\": {\"version\": 1, \"rows\": [{\"field\": \"desk\"}], \"values\": [{\"field\": \"pnl\", \"aggregation\": \"sum\"}]}}}, {\"id\": \"curve\", \"chart\": {\"version\": 1, \"axis\": {\"values\": \"dates\"}, \"series\": [{\"id\": \"pnl\", \"name\": \"P&L\", \"kind\": \"level\", \"data\": \"trades\", \"x\": \"day\", \"y\": \"pnl\"}]}}], \"layout\": [{\"views\": [\"blotter\", \"byDesk\"]}, {\"views\": [\"curve\"]}]}"
