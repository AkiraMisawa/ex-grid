{
  "about": "The Headings' selections (ADR-0050, item 1): a declared header click selects the whole column, a Row Heading the whole row. From dotnet/tests/ExGrid.Tests/HeadingsSelectionTests.cs; its geometry cases move with the column geometry.",
  "kind": "selection",
  "extent": [100, 26],
  "cases": [
    {
      "name": "ADR-0050/0052: a declared header click selects the whole column, the Focus on the row the holder names",
      "steps": [
        { "click": [3, 3] },
        { "selectColumn": 5, "focusRow": 12 },
        { "expect": { "ranges": [[0, 5, 100, 1]], "focus": [12, 5] } }
      ]
    },
    {
      "name": "ADR-0050: a Row Heading click selects the whole row, every column",
      "steps": [
        { "selectRow": 7, "focusColumn": 4 },
        { "expect": { "ranges": [[7, 0, 1, 26]], "focus": [7, 4] } }
      ]
    },
    {
      "name": "ADR-0050/0052: Shift+click on a Row Heading extends whole rows from the Focus's row, and the Focus stays",
      "steps": [
        { "click": [10, 3] },
        { "extendToRow": 4, "focusColumnIfEmpty": 0 },
        { "expect": { "ranges": [[4, 0, 7, 26]], "focus": [10, 3] } }
      ]
    },
    {
      "name": "ADR-0052 (Excel item 4): row 5's heading, then Shift+click on row 2's, gives 2:5 with the Focus still in row 5",
      "steps": [
        { "selectRow": 4, "focusColumn": 0 },
        { "extendToRow": 1, "focusColumnIfEmpty": 0 },
        { "expect": { "ranges": [[1, 0, 4, 26]], "focus": [4, 0] } }
      ]
    },
    {
      "name": "ADR-0050: from nothing selected, Shift+click on a Row Heading selects that row alone",
      "steps": [
        { "extendToRow": 9, "focusColumnIfEmpty": 2 },
        { "expect": { "ranges": [[9, 0, 1, 26]], "focus": [9, 2] } }
      ]
    },
    {
      "name": "ADR-0050/0012: whole rows stay whole under Shift+Down, as whole columns do under Shift+Right",
      "steps": [
        { "selectRow": 5, "focusColumn": 0 },
        { "extend": "down" },
        { "expect": { "ranges": [[5, 0, 2, 26]] } }
      ]
    },
    {
      "name": "ADR-0050/0012 (DC-4): a row selected by its heading cycles only through real columns",
      "extent": [10, 3],
      "steps": [
        { "selectRow": 2, "focusColumn": 0 },
        { "cycle": "tab", "focuses": [[2, 1], [2, 2], [2, 0], [2, 1]] }
      ]
    },
    {
      "name": "ADR-0050: a header or Heading outside the grid is refused",
      "steps": [
        { "selectColumn": 26, "focusRow": 0, "throws": "outOfRange" },
        { "selectRow": 100, "focusColumn": 0, "throws": "outOfRange" },
        { "extendToColumn": -1, "focusRowIfEmpty": 0, "throws": "outOfRange" },
        { "expect": { "empty": true } }
      ]
    },
    {
      "name": "ADR-0050 item 4: a Consumer's placement becomes the one range with its Focus",
      "steps": [
        { "click": [1, 1] },
        { "toggleRange": [8, 8] },
        { "place": [2, 3, 4, 5], "focus": [5, 7] },
        { "expect": { "ranges": [[2, 3, 4, 5]], "focus": [5, 7], "extent": [2, 3] } }
      ]
    },
    {
      "name": "ADR-0050 item 4: a placement reaching outside the grid, or with its Focus outside its range, is refused rather than clamped",
      "steps": [
        { "click": [1, 1] },
        { "place": [98, 0, 3, 1], "focus": [98, 0], "throws": "outOfRange" },
        { "place": [2, 3, 4, 5], "focus": [1, 3], "throws": "outOfRange" },
        { "expect": { "ranges": [[1, 1, 1, 1]] } }
      ]
    },
    {
      "name": "ADR-0055: a Find step moves the Focus onto a cell inside the selection and the ranges stay; outside it, it is refused",
      "steps": [
        { "click": "A1" },
        { "extendTo": "C3" },
        { "toggleRange": "D4" },
        { "extendTo": "B2" },
        { "focusOn": "B2" },
        { "expect": { "ranges": "A1:C3,B2:D4", "focus": "B2", "focusRange": "B2:D4" } },
        { "focusOn": "A1" },
        { "expect": { "focus": "A1", "focusRange": "A1:C3" } },
        { "focusOn": "F6", "throws": "outOfRange" }
      ]
    },
    {
      "name": "ADR-0050 item 2: Ctrl+arrow follows the Consumer's edge answer, and Ctrl+Shift+arrow runs the Extent to it",
      "steps": [
        { "click": [5, 3] },
        { "moveToEdge": "down", "answer": [40, 3] },
        { "expect": { "ranges": [[40, 3, 1, 1]] } },
        { "click": [5, 3] },
        { "extendToEdge": "down", "answer": [40, 3] },
        { "expect": { "ranges": [[5, 3, 36, 1]], "focus": [5, 3], "extent": [40, 3] } }
      ]
    },
    {
      "name": "ADR-0050 item 2: an edge answer off the Focus's line, behind it, or outside the grid is refused by name",
      "steps": [
        { "click": [5, 3] },
        { "moveToEdge": "down", "answer": [40, 4], "throws": "invalidOperation" },
        { "moveToEdge": "down", "answer": [2, 3], "throws": "invalidOperation" },
        { "moveToEdge": "down", "answer": [100, 3], "throws": "invalidOperation" },
        { "expect": { "ranges": [[5, 3, 1, 1]] } }
      ]
    }
  ]
}
