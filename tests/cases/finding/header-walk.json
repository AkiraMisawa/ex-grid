{
  "about": "The order a Find step walks once the headers are searched (ADR-0333 §3): the header rows first, then the data rows by rows, wrapping; backward the reverse. Headers 1 and 3 of five match, and the Focus is row 5, column 1. A cell is written {row, column}. From tests/ExGrid.Tests/HeaderFindWalkTests.cs.",
  "kind": "calls",
  "subject": "HeaderFindWalk",
  "cases": [
    {
      "name": "ADR-0333 §3: with no header matching, the Consumer is always asked, and its answer always stands",
      "expect": [
        {"static": "beforeAsking", "args": [[], null, false, false], "is": null},
        {"static": "beforeAsking", "args": [[], 2, false, false], "is": null},
        {"static": "afterAnswer", "args": [[], {"row": 5, "column": 1}, null, false], "is": null},
        {"static": "afterAnswer", "args": [[], {"row": 5, "column": 1}, {"row": 0, "column": 0}, false], "is": null}
      ]
    },
    {
      "name": "ADR-0333 §3: from a header, the next matching header after it (before it, backward) comes before any row",
      "expect": [
        {"static": "beforeAsking", "args": [[1, 3], 0, false, false], "is": 1},
        {"static": "beforeAsking", "args": [[1, 3], 1, false, false], "is": 3},
        {"static": "beforeAsking", "args": [[1, 3], 2, false, false], "is": 3},
        {"static": "beforeAsking", "args": [[1, 3], 4, false, true], "is": 3},
        {"static": "beforeAsking", "args": [[1, 3], 3, false, true], "is": 1},
        {"static": "beforeAsking", "args": [[1, 3], 2, false, true], "is": 1}
      ]
    },
    {
      "name": "ADR-0333 §3: from the last matching header (the first, backward) the rows are next, so the Consumer is asked",
      "expect": [
        {"static": "beforeAsking", "args": [[1, 3], 3, false, false], "is": null},
        {"static": "beforeAsking", "args": [[1, 3], 4, false, false], "is": null},
        {"static": "beforeAsking", "args": [[1, 3], 1, false, true], "is": null},
        {"static": "beforeAsking", "args": [[1, 3], 0, false, true], "is": null}
      ]
    },
    {
      "name": "ADR-0333 §3: from nothing, forward starts at the top, where the header rows are; backward starts at the end of the rows",
      "expect": [
        {"static": "beforeAsking", "args": [[1, 3], null, false, false], "is": 1},
        {"static": "beforeAsking", "args": [[1, 3], null, false, true], "is": null}
      ]
    },
    {
      "name": "ADR-0333 §3: from a cell the Consumer is asked first, whichever way",
      "expect": [
        {"static": "beforeAsking", "args": [[1, 3], null, true, false], "is": null},
        {"static": "beforeAsking", "args": [[1, 3], null, true, true], "is": null}
      ]
    },
    {
      "name": "ADR-0333 §3: forward from a cell, an answer after it stands; one at or before it wrapped past the headers, so the first matching header is reached first",
      "expect": [
        {"static": "afterAnswer", "args": [[1, 3], {"row": 5, "column": 1}, {"row": 5, "column": 2}, false], "is": null},
        {"static": "afterAnswer", "args": [[1, 3], {"row": 5, "column": 1}, {"row": 6, "column": 0}, false], "is": null},
        {"static": "afterAnswer", "args": [[1, 3], {"row": 5, "column": 1}, {"row": 5, "column": 1}, false], "is": 1},
        {"static": "afterAnswer", "args": [[1, 3], {"row": 5, "column": 1}, {"row": 5, "column": 0}, false], "is": 1},
        {"static": "afterAnswer", "args": [[1, 3], {"row": 5, "column": 1}, {"row": 0, "column": 0}, false], "is": 1}
      ]
    },
    {
      "name": "ADR-0333 §3: backward from a cell, an answer before it stands; one at or after it wrapped past the headers, so the last matching header is reached first",
      "expect": [
        {"static": "afterAnswer", "args": [[1, 3], {"row": 5, "column": 1}, {"row": 5, "column": 0}, true], "is": null},
        {"static": "afterAnswer", "args": [[1, 3], {"row": 5, "column": 1}, {"row": 4, "column": 9}, true], "is": null},
        {"static": "afterAnswer", "args": [[1, 3], {"row": 5, "column": 1}, {"row": 5, "column": 1}, true], "is": 3},
        {"static": "afterAnswer", "args": [[1, 3], {"row": 5, "column": 1}, {"row": 5, "column": 2}, true], "is": 3},
        {"static": "afterAnswer", "args": [[1, 3], {"row": 5, "column": 1}, {"row": 99, "column": 0}, true], "is": 3}
      ]
    },
    {
      "name": "ADR-0333 §3: no match among the rows, the walk reaches a header, and a lone header match finds itself",
      "expect": [
        {"static": "afterAnswer", "args": [[1, 3], {"row": 5, "column": 1}, null, false], "is": 1},
        {"static": "afterAnswer", "args": [[1, 3], null, null, false], "is": 1},
        {"static": "afterAnswer", "args": [[1, 3], {"row": 5, "column": 1}, null, true], "is": 3},
        {"static": "afterAnswer", "args": [[1, 3], null, null, true], "is": 3},
        {"static": "afterAnswer", "args": [[2], null, null, false], "is": 2},
        {"static": "afterAnswer", "args": [[2], null, null, true], "is": 2}
      ]
    },
    {
      "name": "ADR-0333 §3: asked from the start of the rows (the end, backward), a found answer wraps past nothing and stands",
      "expect": [
        {"static": "afterAnswer", "args": [[1, 3], null, {"row": 0, "column": 0}, false], "is": null},
        {"static": "afterAnswer", "args": [[1, 3], null, {"row": 0, "column": 0}, true], "is": null}
      ]
    }
  ]
}
