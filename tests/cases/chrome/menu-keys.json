{
  "about": "The keys inside a menu, the column menu or the Context Menu, and what each one means (ADR-0039, ADR-0044). The menu's commands are written {id, enabled}, what the keys read of a command. From tests/ExGrid.Tests/MenuKeysTests.cs. The C# core's MenuKeys is a static class; the Script Core's chrome/menu-keys.ts is its functions under these names. A key that means nothing is checked by its kind alone: its item means nothing, and C#'s MenuKey.Nothing, the default value, holds 0 there.",
  "kind": "calls",
  "subject": "MenuKeys",
  "cases": [
    {
      "name": "ADR-0039 / KB-30: ↓ moves to the next enabled item, stepping over a disabled one",
      "expect": [
        {"static": "resolve", "args": ["ArrowDown", false, false, [{"id": "copy", "enabled": true}, {"id": "paste", "enabled": false}, {"id": "sort", "enabled": true}, {"id": "filter", "enabled": false}, {"id": "clear", "enabled": true}], 0], "is": {"kind": "move", "item": 2}},
        {"static": "resolve", "args": ["ArrowDown", false, false, [{"id": "copy", "enabled": true}, {"id": "paste", "enabled": false}, {"id": "sort", "enabled": true}, {"id": "filter", "enabled": false}, {"id": "clear", "enabled": true}], 2], "is": {"kind": "move", "item": 4}}
      ]
    },
    {
      "name": "ADR-0039 / KB-30: ↓ on the last enabled item wraps to the first",
      "expect": [
        {"static": "resolve", "args": ["ArrowDown", false, false, [{"id": "copy", "enabled": true}, {"id": "paste", "enabled": false}, {"id": "sort", "enabled": true}, {"id": "filter", "enabled": false}, {"id": "clear", "enabled": true}], 4], "is": {"kind": "move", "item": 0}}
      ]
    },
    {
      "name": "ADR-0039 / KB-30: ↑ moves back over disabled items and wraps at the top",
      "expect": [
        {"static": "resolve", "args": ["ArrowUp", false, false, [{"id": "copy", "enabled": true}, {"id": "paste", "enabled": false}, {"id": "sort", "enabled": true}, {"id": "filter", "enabled": false}, {"id": "clear", "enabled": true}], 4], "is": {"kind": "move", "item": 2}},
        {"static": "resolve", "args": ["ArrowUp", false, false, [{"id": "copy", "enabled": true}, {"id": "paste", "enabled": false}, {"id": "sort", "enabled": true}, {"id": "filter", "enabled": false}, {"id": "clear", "enabled": true}], 0], "is": {"kind": "move", "item": 4}}
      ]
    },
    {
      "name": "ADR-0039 / KB-30: Home and End go to the first and last enabled items",
      "expect": [
        {"static": "resolve", "args": ["Home", false, false, [{"id": "a", "enabled": false}, {"id": "b", "enabled": true}, {"id": "c", "enabled": true}, {"id": "d", "enabled": false}], 2], "is": {"kind": "move", "item": 1}},
        {"static": "resolve", "args": ["End", false, false, [{"id": "a", "enabled": false}, {"id": "b", "enabled": true}, {"id": "c", "enabled": true}, {"id": "d", "enabled": false}], 1], "is": {"kind": "move", "item": 2}},
        {"static": "first", "args": [[{"id": "a", "enabled": false}, {"id": "b", "enabled": true}, {"id": "c", "enabled": true}, {"id": "d", "enabled": false}]], "is": 1},
        {"static": "last", "args": [[{"id": "a", "enabled": false}, {"id": "b", "enabled": true}, {"id": "c", "enabled": true}, {"id": "d", "enabled": false}]], "is": 2}
      ]
