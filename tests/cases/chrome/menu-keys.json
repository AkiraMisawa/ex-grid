        {"static": "resolve", "args": [" ", false, false, [{"id": "copy", "enabled": true}, {"id": "paste", "enabled": false}, {"id": "sort", "enabled": true}, {"id": "filter", "enabled": false}, {"id": "clear", "enabled": true}], 4], "is": {"kind": "run", "item": 4}}
