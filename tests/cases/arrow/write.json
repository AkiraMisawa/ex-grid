    {
      "name": "ADR-0065: a date no unit holds exactly, one that needs nanoseconds and lies outside their reach, is refused by row and column, and nothing is written",
      "snapshot": {
        "version": 0,
        "recordKey": null,
        "columns": [
          {
            "name": "When",
            "caption": "When",
            "kind": "date",
            "values": [
              "2026-01-01T00:00:00.0000001",
              null,
              "2300-01-01"
            ]
          }
        ]
      },
      "refused": {
        "message": "Row 3, column 'When': the date 2300-01-01T00:00:00.0000000 cannot be written: the column holds a time finer than a microsecond, so it is written in nanoseconds, which reach only from 1677-09-21 to 2262-04-11.",
        "row": 3,
        "column": "When"
      }
    },
    {
      "name": "ADR-0065: Decimal is decimal128(38, scale) at the largest scale, and a value that would pass 38 digits there is refused by row and column, and nothing is written",
