            "values": [
              "79228162514264337593543950335",
              "1",
              "0.0000000001"
            ]
          }
        ]
      },
      "refused": {
        "message": "Row 1, column 'Value': the value 79228162514264337593543950335 cannot be written exactly as decimal128(38, 10): at the column's 10 places it passes 38 digits.",
        "row": 1,
        "column": "Value"
      }
    },
