      "stream": "producers/polars-oldest.arrows",
      "expect": {
        "version": 0,
        "recordKey": null,
        "columns": [
          { "name": "region", "caption": "region", "kind": "text", "values": ["amer", "AMER", null, "emea"], "dictionary": ["amer", "AMER", "emea"] },
          { "name": "category", "caption": "category", "kind": "text", "values": ["b", "a", "b", null], "dictionary": ["b", "a"] },
          { "name": "amount", "caption": "amount", "kind": "double", "values": [1.5, -2.0, null, "Infinity"] },
          { "name": "quantity", "caption": "quantity", "kind": "integer", "values": [1, null, 3, -4] },
          { "name": "when", "caption": "when", "kind": "date", "values": ["2026-01-01T12:30:00", null, "2026-01-02", "2026-01-03T00:00:00.123456"] },
          { "name": "day", "caption": "day", "kind": "date", "values": ["2026-01-01", null, "2026-01-02", "1969-12-31"] },
          { "name": "pnl", "caption": "pnl", "kind": "decimal", "values": ["1.5", null, "-2.25", "0"] },
          { "name": "live", "caption": "live", "kind": "boolean", "values": [true, false, null, true] },
          { "name": "utc", "caption": "utc", "kind": "date", "values": ["2026-01-01T12:00:00", "2026-01-01T12:00:00", "2026-01-01T12:00:00", "2026-01-01T12:00:00"] }
        ]
      }
    }
  ]
}
