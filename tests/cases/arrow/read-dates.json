          { "name": "Etc/Universal", "caption": "Etc/Universal", "kind": "date", "values": ["2026-09-30T21:15:00", null] },
          { "name": "Zulu", "caption": "Zulu", "kind": "date", "values": ["2026-09-30T21:15:00", null] },
          { "name": "Etc/Zulu", "caption": "Etc/Zulu", "kind": "date", "values": ["2026-09-30T21:15:00", null] },
          { "name": "Greenwich", "caption": "Greenwich", "kind": "date", "values": ["2026-09-30T21:15:00", null] },
          { "name": "Etc/Greenwich", "caption": "Etc/Greenwich", "kind": "date", "values": ["2026-09-30T21:15:00", null] },
          { "name": "GMT0", "caption": "GMT0", "kind": "date", "values": ["2026-09-30T21:15:00", null] },
          { "name": "Etc/GMT0", "caption": "Etc/GMT0", "kind": "date", "values": ["2026-09-30T21:15:00", null] },
          { "name": "GMT+0", "caption": "GMT+0", "kind": "date", "values": ["2026-09-30T21:15:00", null] },
          { "name": "Etc/GMT+0", "caption": "Etc/GMT+0", "kind": "date", "values": ["2026-09-30T21:15:00", null] },
          { "name": "GMT-0", "caption": "GMT-0", "kind": "date", "values": ["2026-09-30T21:15:00", null] },
          { "name": "Etc/GMT-0", "caption": "Etc/GMT-0", "kind": "date", "values": ["2026-09-30T21:15:00", null] },
          { "name": "+00:00", "caption": "+00:00", "kind": "date", "values": ["2026-09-30T21:15:00", null] },
          { "name": "-00:00", "caption": "-00:00", "kind": "date", "values": ["2026-09-30T21:15:00", null] },
          { "name": "Z", "caption": "Z", "kind": "date", "values": ["2026-09-30T21:15:00", null] },
          { "name": "utc", "caption": "utc", "kind": "date", "values": ["2026-09-30T21:15:00", null] },
          { "name": "gmt", "caption": "gmt", "kind": "date", "values": ["2026-09-30T21:15:00", null] },
          { "name": "etc/zulu", "caption": "etc/zulu", "kind": "date", "values": ["2026-09-30T21:15:00", null] },
          { "name": "UNIVERSAL", "caption": "UNIVERSAL", "kind": "date", "values": ["2026-09-30T21:15:00", null] }
        ]
      }
    },
    {
      "name": "ADR-0065: bool is Boolean, across a byte and with a null",
      "stream": "streams/bool.arrows",
      "expect": {
        "version": 0,
        "recordKey": null,
