      "expect": [
        {"static": "resolve", "args": {"key": "a", "ctrl": false, "shift": false, "alt": false, "meta": true, "metaIsPrimary": false}, "then": [{"get": "kind", "is": "none"}]},
        {"static": "resolve", "args": {"key": "ArrowUp", "ctrl": false, "shift": false, "alt": false, "meta": true, "metaIsPrimary": false}, "then": [{"get": "kind", "is": "none"}]},
        {"static": "canonical", "args": {"key": "ArrowUp", "ctrl": false, "shift": false, "alt": false, "meta": true, "metaIsPrimary": false}, "is": "Meta+ArrowUp"},
        {"static": "resolve", "args": {"key": "Enter", "ctrl": false, "shift": false, "alt": false, "meta": true, "metaIsPrimary": false}, "then": [{"get": "kind", "is": "none"}]},
        {"static": "resolve", "args": {"key": " ", "ctrl": false, "shift": false, "alt": false, "meta": true, "metaIsPrimary": false}, "then": [{"get": "kind", "is": "none"}]}
      ]
    },
