{
  "about": "The key table (ADR-0010: the core arbitrates the keys; ADR-0012's keyboard; ADR-0050 item 14's declared keys). From tests/ExGrid.Tests/GridKeyTests.cs and DeclaredKeyTests.cs. The C# core's GridKeys is a static class; the Script Core's keys/grid-keys.ts is its functions under these names.",
  "kind": "calls",
  "subject": "GridKeys",
  "cases": [
    {
      "name": "ADR-0012: the four forms of an arrow key",
      "expect": [
        {"static": "resolve", "args": {"key": "ArrowDown", "ctrl": false, "shift": false, "alt": false, "meta": false, "metaIsPrimary": true}, "is": {"kind": "move", "direction": "down", "order": "columnMajor", "backward": false}},
        {"static": "resolve", "args": {"key": "ArrowDown", "ctrl": false, "shift": true, "alt": false, "meta": false, "metaIsPrimary": true}, "is": {"kind": "extend", "direction": "down", "order": "columnMajor", "backward": false}},
        {"static": "resolve", "args": {"key": "ArrowDown", "ctrl": true, "shift": false, "alt": false, "meta": false, "metaIsPrimary": true}, "is": {"kind": "moveToEdge", "direction": "down", "order": "columnMajor", "backward": false}},
        {"static": "resolve", "args": {"key": "ArrowDown", "ctrl": true, "shift": true, "alt": false, "meta": false, "metaIsPrimary": true}, "is": {"kind": "extendToEdge", "direction": "down", "order": "columnMajor", "backward": false}}
      ]
    },
    {
      "name": "ADR-0012: where Meta is Command, it is the modifier a user reaches for",
      "expect": [
        {"static": "resolve", "args": {"key": "a", "ctrl": false, "shift": false, "alt": false, "meta": true, "metaIsPrimary": true}, "then": [{"get": "kind", "is": "selectAll"}]},
