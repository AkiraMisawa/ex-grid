  "cases": [
    {
      "name": "Ticket 07: the long form is invariant with every digit, a byte-order mark first, a missing value empty and never zero",
      "definition": {
        "axis": {
          "values": "dates"
        },
        "series": [
          {
            "id": "e",
            "name": "EPE, Before",
            "kind": "level",
            "points": [
              [
                {
                  "date": "2026-10-19"
                },
                1234567.89
              ],
              [
                {
                  "date": "2026-10-20"
                },
                null
              ]
            ]
          }
        ]
      },
      "csv": {
        "form": "long",
        "metrics": {
          "width": 800,
          "height": 400
        },
        "view": {}
      },
      "expect": [
        {
          "at": "$",
          "is": "\ufeffSeries,Date,Value,Kind,Method\r\n\"EPE, Before\",2026-10-19,1234567.89,quoted,\r\n\"EPE, Before\",2026-10-20,,quoted,\r\n"
        }
      ]
    },
    {
      "name": "Ticket 07: the files follow the Chart Filters — hidden series and positions outside the range are left out",
      "definition": {
        "axis": {
          "values": "numbers",
          "title": "Years"
        },
        "series": [
          {
            "id": "a",
            "name": "A",
            "kind": "level",
            "points": [
              [
                0,
                1
              ],
              [
                5,
                2
              ],
              [
                10,
                3
              ]
            ]
          },
          {
            "id": "b",
            "name": "B",
            "kind": "level",
            "points": [
              [
                0,
                4
              ]
            ]
          }
        ]
      },
      "csv": {
        "form": "wide",
        "metrics": {
          "width": 800,
          "height": 400
        },
        "view": {
          "hidden": [
            "b"
          ],
          "to": 5
        }
      },
      "expect": [
        {
          "at": "$",
          "is": "\ufeffYears,A\r\n0,1\r\n5,2\r\n"
        }
      ]
    },
    {
      "name": "ADR-0254: the files carry every point, never the thinned ones",
      "definition": {
        "axis": {
          "values": "numbers"
        },
        "series": [
          {
            "id": "a",
            "name": "A",
            "kind": "level",
            "points": [
              {
                "generate": {
                  "count": 5000,
                  "x": {
                    "from": 0,
                    "step": 1
                  },
                  "y": {
                    "line": [
                      0,
                      1
                    ]
                  }
                }
              }
            ]
          }
        ]
      },
      "csv": {
        "form": "table",
        "metrics": {
          "width": 200,
          "height": 400
        },
        "view": {}
      },
      "expect": [
        {
          "at": "rows.length",
          "is": 5000
        },
        {
          "at": "rows.4999",
          "is": [
            "4999",
            "4999"
          ]
        }
      ]
    },
    {
      "name": "ADR-0257 (Q5): the long form says quoted, interpolated or extrapolated, and the method; the wide form a column for each",
      "build": {
        "long": {
          "definition": "curve",
          "csv": {
            "form": "long",
            "metrics": {
              "width": 120,
              "height": 400
            },
            "view": {}
          }
        },
        "wide": {
          "definition": "curve",
          "csv": {
            "form": "wide",
            "metrics": {
              "width": 120,
              "height": 400
            },
            "view": {}
          }
        },
        "table": {
          "definition": "curve",
          "csv": {
            "form": "table",
            "metrics": {
              "width": 120,
              "height": 400
            },
            "view": {}
          }
        }
      },
      "expect": [
        {
          "at": "long",
          "has": "\r\nUSD,1,3.1,quoted,\r\n"
        },
        {
          "at": "long",
          "has": ",interpolated,Log-linear\r\n"
        },
        {
          "at": "long",
          "has": ",extrapolated,Flat\r\n"
        },
        {
          "at": "wide",
          "startsWith": "\ufeffX,USD,USD (interpolated),USD (extrapolated)\r\n"
        },
        {
          "at": "table.header",
          "is": [
            "X",
            "USD",
            "USD (interpolated)",
            "USD (extrapolated)"
          ]
        },
        {
          "at": "table.rows.0",
          "is": [
            "1",
            "3.1",
            "3.01",
            ""
          ]
        },
        {
          "at": "table.rows.-1",
          "is": [
            "40",
            "",
            "",
            "3.4"
          ]
        }
      ]
    },
    {
