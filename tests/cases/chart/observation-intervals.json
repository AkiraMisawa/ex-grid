{
  "about": "An Observation's intervals, one a row on both axes (ADR-0304), from tests/ExChart.Engine.Tests/ObservationIntervalTests.cs.",
  "kind": "chart",
  "cases": [
    {
      "name": "ADR-0304: an Observation's bounds are one a row, so two points at one position keep their own",
      "definition": {
        "axis": {
          "values": "numbers",
          "title": "Leverage"
        },
        "series": [
          {
            "id": "names",
            "name": "Names",
            "kind": "observation",
            "points": [
              [
                1,
                150,
                "A"
              ],
              [
                3,
                200,
                "C"
              ],
              [
                3,
                260,
                "D"
              ]
            ],
            "interval": {
              "meaning": "95% CI",
              "bounds": [
                [
                  1,
                  140,
                  160
                ],
                [
                  3,
                  190,
                  215
                ],
                [
                  3,
                  240,
                  290
                ]
              ]
            }
          }
        ]
      },
      "scene": {
        "metrics": {
          "width": 800,
          "height": 400
        }
      },
      "expect": [
        {
          "at": "panels.0.series.0.markers",
          "count": true,
          "is": 3
        },
        {
          "at": "panels.0.series.0.markers.[point=1].yBounds",
          "isNot": null
        },
        {
          "at": "panels.0.series.0.markers.[point=1].yBounds",
          "differsFrom": "panels.0.series.0.markers.[point=2].yBounds"
        },
        {
          "at": "panels.0.series.0.markers.[point=2].yBounds.0",
          "below": {
            "at": "panels.0.series.0.markers.[point=2].y"
          }
        },
        {
          "at": "panels.0.series.0.markers.[point=2].yBounds.1",
          "above": {
            "at": "panels.0.series.0.markers.[point=2].y"
          }
        }
      ]
    },
