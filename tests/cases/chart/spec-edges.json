            ],
            "edges": {
              "data": "links",
              "from": "from",
              "to": "to"
            }
          }
        ]
      },
      "expect": [
        {
          "at": "definition.series.0.details",
          "is": [
            {
              "title": "probability",
              "values": [
                "1",
                "0.5",
                null
              ]
