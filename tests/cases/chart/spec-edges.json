  "cases": [
    {
      "name": "ADR-0321: the nodes and the edges are two tables; keys meet as text",
      "spec": {
        "version": 1,
        "axis": {
          "values": "numbers",
          "title": "Step"
        },
        "series": [
          {
            "id": "t",
            "name": "Tree",
            "kind": "observation",
            "data": "nodes",
            "x": "step",
            "y": "price",
            "key": "id",
            "edges": {
              "data": "links",
              "from": "from",
              "to": "to"
            }
          }
        ]
      },
      "expect": [
        {
          "at": "definition.series.0.edges",
          "is": [
            {
              "from": "0",
              "to": "1"
            },
            {
              "from": "0",
              "to": "2"
            }
          ]
        },
        {
          "at": "definition.series.0.points",
          "is": [
            {
              "x": 0,
              "y": 100,
              "row": "0"
            },
            {
              "x": 1,
              "y": 90,
              "row": "1"
            },
            {
              "x": 1,
              "y": 110,
              "row": "2"
            }
          ]
        },
        {
          "at": "definition.axis.title",
          "is": "Step"
        }
      ]
    },
    {
      "name": "ADR-0321: a node's tooltip says the columns the spec names, and no other",
