    {
      "name": "ADR-0257: each position needs one value",
      "interpolate": {
        "method": "linear",
        "x": [
          1,
          2,
          3
        ],
        "y": [
          1,
          2
        ]
      },
      "throws": "argument",
      "saying": "Each position needs one value"
    },
    {
      "name": "ADR-0257: a line needs two points",
      "interpolate": {
        "method": "linear",
        "x": [
          1
        ],
        "y": [
          1
        ]
      },
      "throws": "argument",
      "saying": "2 points"
    },
