{
  "about": "The interpolations a Consumer calls (ADR-0257): linear and a natural cubic spline through points, bilinear on a grid and linear on a Consumer's triangles, each naming its method and having no value outside its points, the Interpolated Level series a curve hands in and the sampled surface a surface does (ADR-0274), and what they refuse, from tests/ExChart.Engine.Tests/InterpolationTests.cs. Every value is compared exactly: both engines do the same arithmetic in the same order.",
  "kind": "chart",
  "cases": [
    {
      "name": "ADR-0257: a linear interpolant names its method, and has no value outside its points",
      "build": {
        "curve": {
          "interpolate": {
            "method": "linear",
            "x": [
              1,
              2,
              4
            ],
            "y": [
              10,
              20,
              0
            ]
          }
        },
        "values": {
          "interpolate": {
            "method": "linear",
            "x": [
              1,
              2,
              4
            ],
            "y": [
              10,
              20,
              0
            ],
            "at": [
              1.5,
              3,
              2.2,
              1,
              4,
              0.999,
              4.001
            ]
          }
        }
      },
      "expect": [
        {
          "at": "curve",
          "is": {
            "method": "linear",
            "from": 1,
            "to": 4
          }
        },
        {
          "at": "values",
          "is": [
            15,
            10,
            18,
            10,
            0,
            null,
            null
          ]
        }
      ]
    },
    {
      "name": "ADR-0257: a natural cubic spline passes through its points, and stops at the ends",
      "build": {
        "curve": {
          "interpolate": {
            "method": "naturalCubicSpline",
            "x": [
              0,
              1,
              2,
              3
            ],
            "y": [
              0,
              1,
              8,
              27
            ]
          }
        },
        "values": {
          "interpolate": {
            "method": "naturalCubicSpline",
            "x": [
              0,
              1,
              2,
              3
            ],
            "y": [
              0,
              1,
              8,
              27
            ],
            "at": [
              0,
              1,
              2,
              3,
              -0.5,
              3.5
            ]
          }
        },
        "between": {
          "interpolate": {
            "method": "naturalCubicSpline",
            "x": [
              0,
              1,
              2,
              3
            ],
            "y": [
              0,
              1,
              8,
              27
            ],
            "at": [
              0.5,
              1.5,
              2.5,
              2.9
            ]
          }
        }
      },
      "expect": [
        {
          "at": "curve",
          "is": {
            "method": "natural cubic spline",
            "from": 0,
            "to": 3
          }
        },
        {
          "at": "values",
          "is": [
            0,
            1,
            8,
            27,
            null,
            null
          ]
        },
        {
          "at": "between",
          "is": [
            0.2,
            3.1499999999999995,
            16.45,
            24.822799999999997
          ]
        }
      ]
    },
    {
      "name": "ADR-0257: on points of a straight line, the natural spline is that line",
      "interpolate": {
        "method": "naturalCubicSpline",
        "x": [
          0,
          1,
          2,
          3
        ],
        "y": [
          1,
          2,
          3,
          4
        ],
        "at": [
          1.5
        ]
      },
      "expect": [
        {
          "at": "",
          "is": [
            2.5
          ]
        }
      ]
    },
    {
      "name": "ADR-0257: the curve as a series is declared Interpolated, sampled over its range, with a Segment named by its method",
      "definition": {
        "axis": {
          "values": "numbers"
        },
        "series": [
          {
            "id": "zero",
            "name": "Zero rate",
            "interpolant": {
              "method": "linear",
              "x": [
                0,
                1
              ],
              "y": [
                1,
                2
              ]
            }
          }
        ]
      },
      "expect": [
        {
          "at": "series.0.id",
          "is": "zero"
        },
        {
          "at": "series.0.name",
          "is": "Zero rate"
        },
        {
          "at": "series.0.kind",
          "is": "level"
        },
        {
          "at": "series.0.interpolated",
          "is": true
        },
        {
          "at": "series.0.segments",
          "is": [
            {
              "from": 0,
              "to": 1,
              "method": "linear",
              "extrapolated": false
            }
          ]
        },
        {
          "at": "series.0.sampler",
          "is": {
            "from": 0,
            "to": 1
          }
        },
        {
          "at": "series.0.points",
          "empty": true
        }
      ]
    },
    {
