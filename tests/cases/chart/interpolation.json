        "method": "linear",
        "x": [
          0,
          0,
          1
        ],
        "y": [
          1,
          2,
          3
        ]
      },
      "throws": "argument",
      "saying": "strictly increasing"
    },
    {
      "name": "ADR-0257: a position that is no number breaks the order",
      "interpolate": {
        "method": "naturalCubicSpline",
        "x": [
          0,
