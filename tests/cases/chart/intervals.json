{
  "about": "A Level's Interval: what it must say, its whiskers and bands, and where its meaning is said (ADR-0303), from tests/ExChart.Engine.Tests/IntervalTests.cs.",
  "kind": "chart",
  "cases": [
    {
      "name": "ADR-0303: an interval says what it means, or it is refused",
      "definition": {
        "axis": {
          "values": "numbers"
        },
        "series": [
          {
            "id": "2y",
            "name": "2Y",
            "kind": "level",
            "points": [
              {
                "generate": {
                  "count": 5,
                  "x": {
                    "from": 0,
                    "step": 1
                  },
                  "y": {
                    "line": [
                      3,
                      0.01
                    ]
                  }
                }
              }
            ],
            "fromZero": false,
            "interval": {
              "meaning": " ",
              "bounds": {
                "generate": {
                  "count": 5,
                  "x": {
                    "from": 0,
                    "step": 1
                  },
                  "lower": {
                    "line": [
                      2.9,
                      0.01
                    ]
                  },
                  "upper": {
                    "line": [
                      3.1,
                      0.01
                    ]
                  }
                }
              }
            }
          }
        ]
      },
      "throws": "chartRefused"
    },
