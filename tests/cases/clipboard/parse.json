{
  "about": "What the paste event's flavours parse into (ADR-0005, ADR-0014, ADR-0050 items 9 and 10): Excel's HTML table preferred for precision, TSV as the fallback, nothing when nothing tabular is there, and where each field came from. The Excel samples are the shape Excel for Windows puts on the clipboard as CF_HTML, as the browser's paste event hands it over. From dotnet/tests/ExGrid.Tests/ClipboardParseTests.cs, PasteOriginTests.cs and PasteMarkTests.cs.",
  "kind": "scriptCalls",
  "subject": "ClipboardParse",
  "cases": [
    {
      "name": "ADR-0005: plain TSV, tabs are cells and lines are rows",
      "expect": [
        {"static": "parse", "args": [null, "a\tb\r\nc\td\r\n"], "is": [["a", "b"], ["c", "d"]]}
      ]
    },
    {
      "name": "ADR-0005 / CP-20: a thousands separator is not a cell boundary, in either notation",
      "expect": [
        {"static": "parse", "args": [null, "1,234"], "is": [["1,234"]]},
        {"static": "parse", "args": [null, "1.234,56"], "is": [["1.234,56"]]},
        {"static": "parse", "args": [null, "USD 1,234.00"], "is": [["USD 1,234.00"]]}
      ]
    },
    {
      "name": "ADR-0005 / CP-20: the shape a CSV heuristic would read as two columns is one column of money",
      "expect": [
        {"static": "parse", "args": [null, "1,234\r\n5,678\r\n"], "is": [["1,234"], ["5,678"]]}
      ]
    },
    {
      "name": "ADR-0005 / CP-20: the tab still splits, and splits only where it is",
      "expect": [
        {"static": "parse", "args": [null, "a,b\tc"], "is": [["a,b", "c"]]}
      ]
    },
    {
      "name": "ADR-0005: the trailing break Excel always appends is not a row, and a bare line feed breaks a line",
      "expect": [
        {"static": "parse", "args": [null, "a\r\nb\r\n"], "is": [["a"], ["b"]]},
        {"static": "parse", "args": [null, "a\nb"], "is": [["a"], ["b"]]}
      ]
    },
    {
      "name": "ADR-0005: a cell Excel quoted because it holds a tab or a break reads back as one cell",
      "expect": [
        {"static": "parse", "args": [null, "\"a\tb\"\"c\nd\"\te\r\n"], "is": [["a\tb\"c\nd", "e"]]}
      ]
    },
    {
      "name": "ADR-0005: past a cell's first character a quote is only text",
      "expect": [
        {"static": "parse", "args": [null, "a\"b\t\"c\"\"\"\r\n"], "is": [["a\"b", "c\""]]}
      ]
    },
    {
      "name": "ADR-0005: a short line pads with empty cells, as Excel pads, so the block is rectangular",
      "expect": [
        {"static": "parse", "args": [null, "a\tb\tc\r\nd\r\n"], "is": [["a", "b", "c"], ["d", "", ""]]}
      ]
    },
    {
      "name": "ADR-0014: nothing tabular is no block, and consults no rule",
      "expect": [
        {"static": "parse", "args": [null, null], "is": null},
        {"static": "parse", "args": ["", ""], "is": null},
        {"static": "parse", "args": ["<div>no table here</div>", ""], "is": null},
        {"static": "parseBlock", "args": [null, null], "is": null}
      ]
    },
    {
      "name": "ADR-0005: the HTML flavour is preferred when it holds a table",
      "expect": [
        {"static": "parse", "args": ["<table><tr><td>h1</td><td>h2</td></tr></table>", "t1\tt2\r\n"], "is": [["h1", "h2"]]}
      ]
    },
    {
      "name": "ADR-0005: Excel's x:num carries the raw number at full precision",
      "expect": [
        {"static": "parse", "args": ["<table><tr><td x:num=\"1234.56789\">1,234.57</td><td>text</td></tr></table>", null], "is": [["1234.56789", "text"]]}
      ]
    },
    {
      "name": "ADR-0005: wrapping markup and entities decode, and a <br> inside a cell is a break in its value",
      "expect": [
        {"static": "parse", "args": ["<table><tbody><tr><td><b>a&amp;b</b></td><td>x<br/>y</td></tr></tbody></table>", null], "is": [["a&b", "x\ny"]]}
      ]
    },
    {
      "name": "ADR-0005: an unknown entity, or an ampersand that starts none, is text",
      "expect": [
        {"static": "parse", "args": ["<table><tr><td>&lt;&gt;&quot;&apos;&#39;</td><td>&copy; R&D;</td><td>a & b</td></tr></table>", null], "is": [["<>\"''", "&copy; R&D;", "a & b"]]}
      ]
    },
    {
      "name": "ADR-0005: the table's tags are read in any case, and a heading row is a row",
      "expect": [
        {"static": "parse", "args": ["<TABLE><THEAD><TR><TH>A</TH><TH>B</TH></TR></THEAD><TR><TD>a</TD><TD X:NUM=\"2\">2.0</TD></TR></TABLE>", null], "is": [["A", "B"], ["a", "2"]]}
      ]
    },
    {
      "name": "ADR-0005: a row of heading and data cells keeps them in their order, so a web table's row headings do not shift its values left",
      "expect": [
        {"static": "parse", "args": ["<table><tr><th>Name</th><td>1</td></tr><tr><th>Other</th><td>2</td></tr></table>", null], "is": [["Name", "1"], ["Other", "2"]]},
        {"static": "parse", "args": ["<table><tr><td>a</td><th>b</th><td>c</td></tr></table>", null], "is": [["a", "b", "c"]]},
        {"static": "parse", "args": ["<table><tr><tbody-ish><td>a</td><thead-ish>x</thead-ish><td>b</td></tr></table>", null], "is": [["a", "b"]]}
      ]
    },
    {
      "name": "ADR-0005: a plain table of raw values reads back as written",
      "expect": [
        {"static": "parse", "args": ["<table><tr><td>100.5</td><td>2026-01-05T00:00:00</td></tr><tr><td>-7</td><td>2026-01-06T00:00:00</td></tr></table>", null], "is": [["100.5", "2026-01-05T00:00:00"], ["-7", "2026-01-06T00:00:00"]]}
      ]
    },
    {
      "name": "ADR-0005: &nbsp; is value, not markup: the markup's pretty-printing is trimmed and the value's own spaces are not",
      "expect": [
        {"static": "parse", "args": ["<table><tr><td>\n  a&nbsp;&nbsp;\n</td><td>&nbsp;b</td></tr></table>", null], "is": [["a  ", " b"]]}
      ]
    },
    {
      "name": "ADR-0050 item 10 / DC-33: Excel's x:num is an invariant number; its text content is shown text",
      "expect": [
        {"static": "parseBlock", "args": ["<html xmlns:v=\"urn:schemas-microsoft-com:vml\"\nxmlns:o=\"urn:schemas-microsoft-com:office:office\"\nxmlns:x=\"urn:schemas-microsoft-com:office:excel\"\nxmlns=\"http://www.w3.org/TR/REC-html40\">\n\n<head>\n<meta http-equiv=Content-Type content=\"text/html; charset=utf-8\">\n<meta name=ProgId content=Excel.Sheet>\n<meta name=Generator content=\"Microsoft Excel 15\">\n<link id=Main-File rel=Main-File\nhref=\"file:///C:/Users/user/AppData/Local/Temp/msohtmlclip1/01/clip.htm\">\n<link rel=File-List\nhref=\"file:///C:/Users/user/AppData/Local/Temp/msohtmlclip1/01/clip_filelist.xml\">\n<style>\n<!--table\n\t{mso-displayed-decimal-separator:\"\\.\";\n\tmso-displayed-thousand-separator:\"\\,\";}\n@page\n\t{margin:.75in .7in .75in .7in;\n\tmso-header-margin:.3in;\n\tmso-footer-margin:.3in;}\ntd\n\t{padding-top:1px;\n\tmso-number-format:General;\n\twhite-space:nowrap;}\n.xl65\n\t{mso-number-format:\"\\#\\,\\#\\#0\\.00\";}\n.xl66\n\t{mso-number-format:\"Short Date\";}\n.xl67\n\t{mso-number-format:\"0\\.00%\";}\n-->\n</style>\n</head>\n\n<body link=\"#0563C1\" vlink=\"#954F72\">\n\n<table border=0 cellpadding=0 cellspacing=0 width=192 style='border-collapse:\n collapse;width:144pt'>\n<!--StartFragment-->\n <col width=64 span=3 style='width:48pt'>\n <tr height=20 style='height:15.0pt'>\n  <td height=20 class=xl65 align=right width=64 style='height:15.0pt;width:48pt'\n  x:num=\"1234.5\">1,234.50</td>\n  <td align=right width=64 style='width:48pt' x:num>42</td>\n  <td width=64 style='width:48pt'>Alpha</td>\n </tr>\n <tr height=20 style='height:15.0pt'>\n  <td height=20 class=xl66 align=right style='height:15.0pt' x:num=\"45292\">1/1/2024</td>\n  <td class=xl67 align=right x:num=\"0.125\">12.50%</td>\n  <td align=right x:num=\"0.33333333333333331\" x:fmla=\"=1/3\">0.333333</td>\n </tr>\n<!--EndFragment-->\n</table>\n\n</body>\n\n</html>", "1,234.50\t42\tAlpha\r\n1/1/2024\t12.50%\t0.333333\r\n"], "is": {"isFromTable": true, "values": [["1234.5", "42", "Alpha"], ["45292", "0.125", "0.33333333333333331"]], "origins": [["invariant", "shownText", "shownText"], ["invariant", "invariant", "invariant"]], "marks": null}}
      ]
    },
    {
      "name": "ADR-0050 item 10 / DC-33: under de-DE x:num still carries 1234.5, and the bare x:num is shown text, or 1,5 would read as fifteen",
      "expect": [
        {"static": "parseBlock", "args": ["<html xmlns:v=\"urn:schemas-microsoft-com:vml\"\nxmlns:o=\"urn:schemas-microsoft-com:office:office\"\nxmlns:x=\"urn:schemas-microsoft-com:office:excel\"\nxmlns=\"http://www.w3.org/TR/REC-html40\">\n\n<head>\n<meta http-equiv=Content-Type content=\"text/html; charset=utf-8\">\n<meta name=ProgId content=Excel.Sheet>\n<meta name=Generator content=\"Microsoft Excel 15\">\n<style>\n<!--table\n\t{mso-displayed-decimal-separator:\"\\,\";\n\tmso-displayed-thousand-separator:\"\\.\";}\n.xl65\n\t{mso-number-format:\"\\#\\,\\#\\#0\\.00\";}\n-->\n</style>\n</head>\n\n<body link=\"#0563C1\" vlink=\"#954F72\">\n\n<table border=0 cellpadding=0 cellspacing=0 width=128 style='border-collapse:\n collapse;width:96pt'>\n<!--StartFragment-->\n <col width=64 span=2 style='width:48pt'>\n <tr height=20 style='height:15.0pt'>\n  <td height=20 class=xl65 align=right width=64 style='height:15.0pt;width:48pt'\n  x:num=\"1234.5\">1.234,50</td>\n  <td align=right width=64 style='width:48pt' x:num>1,5</td>\n </tr>\n<!--EndFragment-->\n</table>\n\n</body>\n\n</html>", "1.234,50\t1,5\r\n"], "is": {"isFromTable": true, "values": [["1234.5", "1,5"]], "origins": [["invariant", "shownText"]], "marks": null}}
      ]
    },
    {
      "name": "ADR-0050 item 10 / DC-33: ExGrid's own unformatted HTML is invariant, every field of it",
      "expect": [
        {"static": "parseBlock", "args": ["<table data-ex-grid=\"invariant\"><tr><td>1234.5</td><td>2026-01-05T00:00:00</td><td>TRUE</td></tr><tr><td>-7</td><td>Alpha</td><td></td></tr></table>", "shown\tshown\tshown\r\nshown\tshown\tshown\r\n"], "is": {"isFromTable": true, "values": [["1234.5", "2026-01-05T00:00:00", "TRUE"], ["-7", "Alpha", ""]], "origins": [["invariant", "invariant", "invariant"], ["invariant", "invariant", "invariant"]], "marks": null}}
      ]
    },
    {
      "name": "ADR-0050 item 10 / DC-33: a table without the grid's mark is some page's shown text, whatever it looks like",
      "expect": [
        {"static": "parseBlock", "args": ["<table><tr><td>1.234</td><td>x</td></tr></table>", null], "is": {"isFromTable": true, "values": [["1.234", "x"]], "origins": [["shownText", "shownText"]], "marks": null}}
      ]
    },
    {
      "name": "ADR-0050 item 10 / DC-33: the text flavour is shown text, and so is its padding",
      "expect": [
        {"static": "parseBlock", "args": [null, "1234.5\t2\r\n3\r\n"], "is": {"isFromTable": false, "values": [["1234.5", "2"], ["3", ""]], "origins": [["shownText", "shownText"], ["shownText", "shownText"]], "marks": null}}
      ]
    },
    {
      "name": "ADR-0014 (amended 2026-09-29): a block read from a table in text/html, Excel's, the grid's or any page's, is from a table",
      "expect": [
        {"static": "parseBlock", "args": ["<html xmlns:v=\"urn:schemas-microsoft-com:vml\"\nxmlns:o=\"urn:schemas-microsoft-com:office:office\"\nxmlns:x=\"urn:schemas-microsoft-com:office:excel\"\nxmlns=\"http://www.w3.org/TR/REC-html40\">\n\n<head>\n<meta http-equiv=Content-Type content=\"text/html; charset=utf-8\">\n<meta name=ProgId content=Excel.Sheet>\n<meta name=Generator content=\"Microsoft Excel 15\">\n<link id=Main-File rel=Main-File\nhref=\"file:///C:/Users/user/AppData/Local/Temp/msohtmlclip1/01/clip.htm\">\n<link rel=File-List\nhref=\"file:///C:/Users/user/AppData/Local/Temp/msohtmlclip1/01/clip_filelist.xml\">\n<style>\n<!--table\n\t{mso-displayed-decimal-separator:\"\\.\";\n\tmso-displayed-thousand-separator:\"\\,\";}\n@page\n\t{margin:.75in .7in .75in .7in;\n\tmso-header-margin:.3in;\n\tmso-footer-margin:.3in;}\ntd\n\t{padding-top:1px;\n\tmso-number-format:General;\n\twhite-space:nowrap;}\n.xl65\n\t{mso-number-format:\"\\#\\,\\#\\#0\\.00\";}\n.xl66\n\t{mso-number-format:\"Short Date\";}\n.xl67\n\t{mso-number-format:\"0\\.00%\";}\n-->\n</style>\n</head>\n\n<body link=\"#0563C1\" vlink=\"#954F72\">\n\n<table border=0 cellpadding=0 cellspacing=0 width=192 style='border-collapse:\n collapse;width:144pt'>\n<!--StartFragment-->\n <col width=64 span=3 style='width:48pt'>\n <tr height=20 style='height:15.0pt'>\n  <td height=20 class=xl65 align=right width=64 style='height:15.0pt;width:48pt'\n  x:num=\"1234.5\">1,234.50</td>\n  <td align=right width=64 style='width:48pt' x:num>42</td>\n  <td width=64 style='width:48pt'>Alpha</td>\n </tr>\n <tr height=20 style='height:15.0pt'>\n  <td height=20 class=xl66 align=right style='height:15.0pt' x:num=\"45292\">1/1/2024</td>\n  <td class=xl67 align=right x:num=\"0.125\">12.50%</td>\n  <td align=right x:num=\"0.33333333333333331\" x:fmla=\"=1/3\">0.333333</td>\n </tr>\n<!--EndFragment-->\n</table>\n\n</body>\n\n</html>", "1,234.50\r\n"], "then": [{"get": "isFromTable", "is": true}]},
        {"static": "parseBlock", "args": ["<table data-ex-grid=\"invariant\"><tr><td>7</td></tr></table>", "7\r\n"], "then": [{"get": "isFromTable", "is": true}]},
        {"static": "parseBlock", "args": ["<table><tr><td>7</td></tr></table>", null], "then": [{"get": "isFromTable", "is": true}]}
      ]
    },
    {
      "name": "ADR-0014 (amended 2026-09-29): plain text alone, or HTML that holds no table, is not from a table",
      "expect": [
        {"static": "parseBlock", "args": [null, "=A1"], "then": [{"get": "isFromTable", "is": false}]},
        {"static": "parseBlock", "args": ["", "=A1"], "then": [{"get": "isFromTable", "is": false}]},
        {"static": "parseBlock", "args": ["<p>=A1</p>", "=A1"], "then": [{"get": "isFromTable", "is": false}]}
      ]
    },
    {
      "name": "ADR-0050 item 9: a mark in the family's own table is read beside its field, the field unchanged",
      "expect": [
        {"static": "parseBlock", "args": ["<table data-ex-grid=\"invariant\"><tr><td>1</td><td data-ex-mark=\"exsheet-refused:C1\">#VALUE!</td></tr></table>", null], "is": {"isFromTable": true, "values": [["1", "#VALUE!"]], "origins": [["invariant", "invariant"]], "marks": [[null, "exsheet-refused:C1"]]}}
      ]
    },
    {
      "name": "ADR-0050 item 9: another program's table is not the family's, and no mark is read from it",
      "expect": [
        {"static": "parseBlock", "args": ["<table><tr><td data-ex-mark=\"exsheet-refused:C1\">#VALUE!</td></tr></table>", null], "is": {"isFromTable": true, "values": [["#VALUE!"]], "origins": [["shownText"]], "marks": null}}
      ]
    }
  ]
}
