{
  "kind": "sheetXlsx",
  "note": "Column widths cross both ways in Excel's own unit (ADR-0330 §4, ADR-0046, ADR-0047): the engine's characters of the default font's digit, the file's with the cell's padding, truncated to 1/256 as Excel stores them.",
  "culture": "en-US",
  "cases": [
    {
      "name": "ADR-0330 §4, ADR-0046: widths are read into runs, one a typed entry fitted (bestFit) as widened by entry, any other as the user's",
      "steps": [
        {
          "open": {
            "pages": [
              {
                "name": "Trades",
                "cells": [
                  {
                    "at": "A1",
                    "type": "number",
                    "value": "1"
                  }
                ],
                "columns": [
                  {
                    "first": 0,
                    "last": 0,
                    "width": 12.7109375,
                    "bestFit": true
                  },
                  {
                    "first": 1,
                    "last": 1,
                    "width": 20.7109375
                  },
                  {
                    "first": 2,
                    "last": 3,
                    "width": 20.7109375
                  },
                  {
                    "first": 5,
                    "last": 5,
                    "width": 9.140625
                  },
                  {
                    "first": 6,
                    "last": 6,
                    "width": 0,
                    "hidden": true
                  },
                  {
                    "first": 7,
                    "last": 7,
                    "width": 300
                  },
                  {
                    "first": 8,
                    "last": 8
                  }
                ]
              }
            ]
          },
          "expect": {
            "document": {
              "workbookVersion": 1,
              "culture": "en-US",
              "shown": "Trades",
              "sheets": [
                {
                  "name": "Trades",
                  "columnWidths": [
                    {
                      "at": "A:A",
                      "width": 12,
                      "kind": "widenedByEntry"
                    },
                    {
                      "at": "B:D",
                      "width": 20,
                      "kind": "setByUser"
                    },
                    {
                      "at": "H:H",
                      "width": 255,
                      "kind": "setByUser"
                    }
                  ],
                  "cells": [
                    {
                      "at": "A1",
                      "number": 1
                    }
                  ]
                }
              ]
            },
            "report": {
              "isEmpty": false,
              "notCarried": [
                {
                  "kind": "hiddenColumns",
                  "sheet": "Trades",
                  "detail": null,
                  "description": "Columns of 'Trades' are hidden in the file, and open shown."
                }
              ],
              "unsupportedFunctions": []
            }
          }
        },
        {
          "read": true,
          "expect": {
            "columnWidths": {
              "A": {
                "width": 12,
                "kind": "widenedByEntry"
              },
              "F": null
            }
          },
          "note": "The default width records nothing; a hidden column of no width opens shown at the default, and is listed."
        }
      ]
    },
