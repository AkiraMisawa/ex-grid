    {
      "name": "ADR-0330 §4: a Sheet's own default width is not carried, and is listed; Excel's own base of 8 is not: a default width of its own",
      "steps": [
        {
          "open": {
            "pages": [
              {
                "name": "Trades",
                "cells": [
                  {
                    "at": "A1",
                    "type": "number",
                    "value": "1"
                  }
                ]
              }
            ],
            "edits": [
              {
                "part": "xl/worksheets/sheet1.xml",
                "regex": [
                  [
                    "<sheetFormatPr[^>]*/>",
                    "<sheetFormatPr defaultColWidth=\"12.5\" defaultRowHeight=\"15\"/>"
                  ]
                ]
              }
            ]
          },
          "expect": {
            "document": {
              "workbookVersion": 1,
