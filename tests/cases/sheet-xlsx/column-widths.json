            "report": {
              "isEmpty": false,
              "notCarried": [
                {
                  "kind": "defaultColumnWidth",
                  "sheet": "Trades",
                  "detail": null,
                  "description": "'Trades' has a default column width of its own, which is not carried; its columns without a width of their own open at the default width."
