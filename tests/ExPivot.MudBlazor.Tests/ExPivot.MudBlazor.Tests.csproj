<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The same shape as tests/ExGrid.MudBlazor.Tests: net10.0 on xunit.v3 and
         Microsoft.Testing.Platform, no apphost (tests/Directory.Build.targets says why). -->
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <UseAppHost>false</UseAppHost>
    <RootNamespace>ExPivot.MudBlazor.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="2.0.3" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="17.14.2" />
    <PackageReference Include="bunit" Version="2.9.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ExPivot.MudBlazor\ExPivot.MudBlazor.csproj" />
  </ItemGroup>

</Project>
