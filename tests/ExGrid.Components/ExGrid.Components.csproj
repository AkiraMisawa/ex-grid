<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net10.0 so the gating tests execute on the shipped target's runtime (ADR-0022). -->
    <TargetFramework>net10.0</TargetFramework>
    <!-- Same xunit.v3 / Microsoft.Testing.Platform shape as ExGrid.Tests: VSTest's
         testhost misses the nix-combined runtime. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <!-- No native apphost, for the reason set out in tests/Directory.Build.targets:
         the SDK's net8 apphost started under the host loader and then dlopened the nix
         runtime's libcoreclr.so, putting two glibcs in one process. Going through the
         muxer keeps one. -->
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="2.0.3" />
    <!-- Coverage for CI (ADR-0041), on the same Microsoft.Testing.Platform 1.6 line
         xunit.v3 2.0 runs on; the 18.x extensions move to platform 2. Inert unless
         the coverage switch is passed. -->
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="17.14.2" />
    <!-- bunit 2.x carries no test-framework dependency of its own, so it composes
         with xunit.v3 on Microsoft.Testing.Platform. -->
    <PackageReference Include="bunit" Version="2.9.0" />
    <!-- FakeTimeProvider drives the settle delay (ADR-0004) deterministically. The
         abstraction it fakes, TimeProvider, is in the BCL, so the core stays
         dependency-free (ADR-0019) and only the tests take this package. -->
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ExGrid\ExGrid.csproj" />
  </ItemGroup>

</Project>
