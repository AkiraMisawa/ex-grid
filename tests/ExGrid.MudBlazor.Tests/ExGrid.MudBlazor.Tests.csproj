<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net10.0 so the Wrapper's tests execute on the shipped target's runtime
         (ADR-0022), in the same xunit.v3 / bunit shape as ExGrid.Components. -->
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <!-- A failed test's name and message in `dotnet test`'s output, where CI's log shows them;
         the summary alone names only the assembly. -->
    <TestingPlatformShowTestsFailure>true</TestingPlatformShowTestsFailure>
    <!-- No native apphost, for the reason in tests/Directory.Build.targets. -->
    <UseAppHost>false</UseAppHost>
    <RootNamespace>ExGrid.MudBlazor.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="2.0.3" />
    <!-- Coverage for CI (ADR-0041), on the same Microsoft.Testing.Platform 1.6 line
         xunit.v3 2.0 runs on; the 18.x extensions move to platform 2. Inert unless
         the coverage switch is passed. -->
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="17.14.2" />
    <PackageReference Include="bunit" Version="2.9.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ExGrid.MudBlazor\ExGrid.MudBlazor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The glyph-width corpus and the painted widths of each face (ADR-0016, ticket 83);
         Roboto's estimate is held to them. tests/GlyphWidths/README.md says how they are made. -->
    <Compile Include="..\GlyphWidths\GlyphWidthRecord.cs" Link="GlyphWidths\GlyphWidthRecord.cs" />
    <None Include="..\GlyphWidths\*.json" Link="GlyphWidths\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- What a coloured-text layer colours, read off what the core writes on it (ADR-0057, note of
         2026-10-01): its text is one run, coloured by highlights. -->
    <Compile Include="..\ReferenceText\ColouredText.cs" Link="ReferenceText\ColouredText.cs" />
  </ItemGroup>

</Project>
