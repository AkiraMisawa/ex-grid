<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The Docs Site's build step (ADR-0110), pinned: what it reads from the build and from the
         repository, and what it refuses. Mirrors tests/ExGrid.Data.Tests: net10.0 (ADR-0022),
         xunit v3 on Microsoft.Testing.Platform, and no native apphost (tests/Directory.Build.targets
         has the account). -->
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <!-- A failed test's name and message in `dotnet test`'s output, where CI's log shows them;
         the summary alone names only the assembly. -->
    <TestingPlatformShowTestsFailure>true</TestingPlatformShowTestsFailure>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="2.0.3" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="17.14.2" />
    <!-- The generator runs inside the compiler; the tests drive it with the compiler's own API,
         at the version the generator is built against. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\samples\ExGrid.Docs.Generator\ExGrid.Docs.Generator.csproj" />
  </ItemGroup>

  <!-- The Keyboard reference held against the keys the products take (ADR-0110): ExGrid's key table, and
       the keys ExSheet and ExPivot declare to their grids, read from the components as bUnit renders them. -->
  <ItemGroup>
    <PackageReference Include="bunit" Version="2.9.0" />
    <ProjectReference Include="..\..\src\ExSheet\ExSheet.csproj" />
    <ProjectReference Include="..\..\src\ExPivot\ExPivot.csproj" />
  </ItemGroup>

</Project>
