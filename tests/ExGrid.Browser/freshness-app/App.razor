@* One grid, and which build of ExGrid is running: the stamp its assembly was built with, read
   where the spec can see it. The page has a HeadContent of its own, as a Consumer's pages do; the
   stylesheet is a root component, so it is not displaced (ADR-0123). *@
<HeadContent><meta name="freshness-page" content="the page's own head" /></HeadContent>
<p id="assembly-stamp">@AssemblyStamp</p>
<ExGrid TRow="Row" Rows="_rows" Columns="_columns" ViewportHeight="200" />

@code {
    private sealed record Row(int Id, string Name);

    private static readonly string AssemblyStamp = (string)typeof(ExGrid<>).Assembly
        .GetType("ExGrid.Components.ScriptCoreAsset", throwOnError: true)!
        .GetField("Stamp", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Static)!
        .GetRawConstantValue()!;

    private readonly Row[] _rows = Enumerable.Range(1, 50).Select(i => new Row(i, "Row " + i)).ToArray();

    private readonly GridColumn<Row>[] _columns =
    [
        new("Id", ColumnType.Number, r => r.Id),
        new("Name", ColumnType.Text, r => r.Name),
    ];
}
