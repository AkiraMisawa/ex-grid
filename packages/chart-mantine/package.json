{
  "name": "@ex-grid/chart-mantine",
  "version": "0.0.0-dev",
  "description": "ExChart for Mantine: the design-system Wrapper that draws ExChart for React's toolbar and context menu with Mantine's components, docks the charts made from a grid's selection beside it in Mantine's tabs, and maps the chart's Visual Tokens onto a Mantine theme.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AkiraMisawa/ex-grid.git",
    "directory": "packages/chart-mantine"
  },
  "homepage": "https://akiramisawa.github.io/ex-grid/",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist/index.js",
    "dist/index.js.map",
    "dist/index.d.ts",
    "styles.css"
  ],
  "scripts": {
    "build": "node ../../tools/scripts/build.mjs",
    "api": "node ../../tools/scripts/build.mjs --local",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ex-grid/chart": "0.0.0-dev",
    "@ex-grid/chart-react": "0.0.0-dev",
    "@ex-grid/core": "0.0.0-dev",
    "@ex-grid/mantine": "0.0.0-dev"
  },
  "peerDependencies": {
    "@mantine/core": "^9.7.0",
    "@mantine/hooks": "^9.7.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
