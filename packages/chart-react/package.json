{
  "name": "@ex-grid/chart-react",
  "version": "0.0.0-dev",
  "description": "ExChart for React: its Script Core's Framework Adapter, which mounts a chart of money and risk numbers, drawn as SVG, in a React tree.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AkiraMisawa/ex-grid.git",
    "directory": "packages/chart-react"
  },
  "homepage": "https://akiramisawa.github.io/ex-grid/",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.js.map",
    "dist/index.d.ts"
  ],
  "scripts": {
    "build": "node ../../tools/scripts/build.mjs",
    "api": "node ../../tools/scripts/build.mjs --local",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ex-grid/chart": "0.0.0-dev",
    "@ex-grid/react": "0.0.0-dev"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
