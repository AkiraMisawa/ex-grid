{
  "name": "@ex-grid/board",
  "version": "0.0.0-dev",
  "description": "ExBoard in TypeScript: a Board, JSON an AI composes once and a workflow runs without AI, read, checked against its inputs' shapes, and laid out as rows of ExGrid, ExPivot and ExChart views, free of any UI framework.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AkiraMisawa/ex-grid.git",
    "directory": "packages/board"
  },
  "homepage": "https://akiramisawa.github.io/ex-grid/",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.js.map",
    "dist/index.d.ts"
  ],
  "scripts": {
    "build": "node ../../tools/scripts/build.mjs",
    "api": "node ../../tools/scripts/build.mjs --local",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ex-grid/chart": "0.0.0-dev",
    "@ex-grid/core": "0.0.0-dev",
    "@ex-grid/data": "0.0.0-dev",
    "@ex-grid/pivot": "0.0.0-dev",
    "@ex-grid/pivot-engine": "0.0.0-dev"
  }
}
