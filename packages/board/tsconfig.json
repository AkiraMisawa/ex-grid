{
  // The sources and the tests, for the editor and for `npm run typecheck`. The packages a Board reads through are
  // read from their sources, so a change to one is checked here before it is built.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "resolveJsonModule": true,
    "paths": {
      "@ex-grid/chart": ["../chart/src/index.ts"],
      "@ex-grid/core": ["../core/src/index.ts"],
      "@ex-grid/data": ["../data/src/index.ts"],
      "@ex-grid/pivot": ["../pivot/src/index.ts"],
      "@ex-grid/pivot-engine": ["../pivot-engine/src/index.ts"]
    }
  },
  "include": ["src", "test", "*.config.ts"]
}
