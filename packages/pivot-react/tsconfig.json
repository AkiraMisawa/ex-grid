{
  // The sources and the tests, for the editor and for `npm run typecheck`. The pivot's Script Core and what
  // it is built on are read from their sources, so a change to any of them is checked here before it is built.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "paths": {
      "@ex-grid/core": ["../core/src/index.ts"],
      "@ex-grid/data": ["../data/src/index.ts"],
      "@ex-grid/pivot-engine": ["../pivot-engine/src/index.ts"],
      "@ex-grid/pivot": ["../pivot/src/index.ts"],
      "@ex-grid/react": ["../react/src/index.ts"]
    }
  },
  "include": ["src", "test", "*.config.ts"]
}
