{
  // The shipped sources alone, whose declarations API Extractor rolls up (scripts/build.mjs). The engine and the file
  // layer are read as they are published, from their builds.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "temp/types"
  },
  "include": ["src"]
}
