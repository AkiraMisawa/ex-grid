{
  "name": "@ex-grid/pivot-engine",
  "version": "0.0.0-dev",
  "description": "ExPivot's engine in TypeScript: Excel's PivotTable over a Snapshot or records in memory, from the Leaf Aggregate pass to the laid-out report, held to the C# engine by shared cases and a differential run.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AkiraMisawa/ex-grid.git",
    "directory": "packages/pivot-engine"
  },
  "homepage": "https://akiramisawa.github.io/ex-grid/",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.js.map",
    "dist/index.d.ts"
  ],
  "scripts": {
    "build": "node ../../tools/scripts/build.mjs",
    "api": "node ../../tools/scripts/build.mjs --local",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "differential": "vitest run --config vitest.differential.config.ts"
  },
  "dependencies": {
    "@ex-grid/data": "0.0.0-dev"
  }
}
