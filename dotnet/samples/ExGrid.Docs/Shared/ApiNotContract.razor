@* What is public and not the contract (ADR-0201), package by package, apart from the contract: the
   types hidden from a Consumer's editor, and the members of contract types that the grid's own script
   calls or that are hidden. Each may change in any version. *@
@foreach (var package in Packages.All)
{
    var types = ApiSurface.TypesOf(package.Id, contract: false).Count();
    var members = ApiSurface.NotContractMembersOf(package.Id).ToList();
    if (types == 0 && members.Count == 0)
        continue;
    <MudText Typo="Typo.h6" HtmlTag="h3" Class="docs-reference-heading"><code>@package.Id</code></MudText>
    @if (types > 0)
    {
        <ApiTypes Package="@package.Id" Contract="false" />
    }
    @if (members.Count > 0)
    {
        <MudText Typo="Typo.subtitle2" Class="docs-api-heading">Members of its contract types</MudText>
        <MudSimpleTable Dense="true" Outlined="true" Class="docs-api-table docs-reference-table">
            <thead>
                <tr><th class="docs-api-name">Member</th><th class="docs-api-kind">Why public</th><th>Description</th></tr>
            </thead>
            <tbody>
                @foreach (var member in members)
                {
                    <tr>
                        <td class="docs-api-name"><code>@($"{member.Type}.{member.Name}")</code></td>
                        <td>@(member.Interop ? "The grid's script calls it" : "Hidden")</td>
                        <td><ApiSummary Html="@member.Summary" /></td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    }
}
