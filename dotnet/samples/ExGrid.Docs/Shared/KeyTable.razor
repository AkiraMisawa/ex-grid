@* One product's keys on the Keyboard reference (ADR-0110): a table for each of its groups, each row with the
   section that explains it and the decision behind it. *@
@foreach (var group in Rows.GroupBy(r => r.Group))
{
    <MudText Typo="Typo.h6" HtmlTag="h3" Class="docs-reference-heading">@group.Key</MudText>
    <MudSimpleTable Dense="true" Outlined="true" Class="docs-api-table docs-reference-table docs-key-table">
        <thead>
            <tr><th style="width: 26%">Keys</th><th>What they do</th><th style="width: 22%">Explained in</th><th style="width: 14%">Decided in</th></tr>
        </thead>
        <tbody>
            @foreach (var row in group)
            {
                <tr>
                    <td><KeyText Text="@row.Keys" /></td>
                    <td><KeyText Text="@row.What" /></td>
                    <td><a href="@row.Explained">@Keyboard.ExplainedTitle(row)</a></td>
                    <td class="docs-reference-cites"><CiteLinks Of="@Keyboard.CitesOf(row)" /></td>
                </tr>
            }
        </tbody>
    </MudSimpleTable>
}

@code {
    /// <summary>The product's rows, in the reference's order.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<KeyRow> Rows { get; set; } = [];
}
