@implements IDisposable
@inject DocsState State

@* The site's one Chrome choice (ADR-0110): every Example runs under it, and its code follows. Under
   Blazor it is the built-in Chrome or MudBlazor's; under React the built-in Chrome, Mantine's or MUI's
   (ADR-0350 §12, ADR-0390 section 8). Each framework keeps its own choice, since neither design system
   of one is a choice of the other's. *@
@if (State.Framework == DocsFramework.React)
{
    <MudToggleGroup T="ReactChrome" Value="State.ReactChrome" ValueChanged="_setReactChrome" Size="Size.Small" Outlined="true"
                    Delimiters="true" Color="Color.Primary" Class="@Class" aria-label="Chrome">
        <MudToggleItem Value="ReactChrome.Builtin" Text="Built-in" />
        <MudToggleItem Value="ReactChrome.Mantine" Text="Mantine" />
        <MudToggleItem Value="ReactChrome.Mui" Text="MUI" />
    </MudToggleGroup>
}
else
{
    <MudToggleGroup T="bool" Value="State.Mud" ValueChanged="_setMud" Size="Size.Small" Outlined="true"
                    Delimiters="true" Color="Color.Primary" Class="@Class" aria-label="Chrome">
        <MudToggleItem Value="false" Text="Built-in" />
        <MudToggleItem Value="true" Text="MudBlazor" />
    </MudToggleGroup>
}

@code {
    /// <summary>Classes for the group.</summary>
    [Parameter] public string? Class { get; set; }

    // Made once: a method group handed as a parameter is a new delegate on every render.
    private EventCallback<ReactChrome> _setReactChrome;
    private EventCallback<bool> _setMud;

    protected override void OnInitialized()
    {
        _setReactChrome = EventCallback.Factory.Create<ReactChrome>(this, State.SetReactChrome);
        _setMud = EventCallback.Factory.Create<bool>(this, State.SetMud);
        State.Changed += OnChanged;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => State.Changed -= OnChanged;
}
