@using global::ExGrid.Chrome
@using ExPivot.Chrome
@using ExPivot.Components
@using ExPivot.Engine
@using ExPivot.MudBlazor

<MudExGridPaper Class="docs-stretch-paper" Elevation="0" Outlined="true">
    <ExPivot Source="_source" @bind-Layout="_layout" Chrome="_chrome" ShowFieldList="false" ViewportHeight="320" />
</MudExGridPaper>

@code {
    private readonly PivotSource _source = PivotSource.From(Sales.Sample(), Sales.Fields);
    private readonly IPivotChrome _chrome = new OwnToolbarChrome(MudPivotChrome.Default);

    private PivotLayout _layout = new()
    {
        Rows = [new PivotFieldPlacement("Region"), new PivotFieldPlacement("Country")],
        Values = [new PivotValueField("Revenue", PivotAggregation.Sum) { NumberFormat = "#,##0" }],
    };

    // Your own Pivot Toolbar drawn with MudBlazor's buttons; every other part is MudPivotChrome's.
    private sealed class OwnToolbarChrome(IPivotChrome mud) : IPivotChrome
    {
        public PivotScriptSlots ScriptSlots => mud.ScriptSlots | PivotScriptSlots.Toolbar;

        public RenderFragment? Toolbar(PivotToolbarView view) => builder =>
        {
            builder.OpenComponent<OwnToolbarMudView>(0);
            builder.AddComponentParameter(1, nameof(OwnToolbarMudView.View), view);
            builder.CloseComponent();
        };

        public IGridChrome? GridChrome(Func<string, string?> commandLabel) => mud.GridChrome(commandLabel);
        public IReadOnlyList<ChromeStylesheet> Stylesheets => mud.Stylesheets;
        public RenderFragment? FieldList(PivotFieldListView view) => mud.FieldList(view);
        public RenderFragment? ReportFilters(PivotReportFiltersView view) => mud.ReportFilters(view);
        public RenderFragment? Menu(PivotMenuView view) => mud.Menu(view);
        public RenderFragment? ItemFilter(PivotItemFilterView view) => mud.ItemFilter(view);
        public RenderFragment? FieldSettings(PivotFieldSettingsView view) => mud.FieldSettings(view);
        public RenderFragment? ValueFieldSettings(PivotValueFieldSettingsView view) => mud.ValueFieldSettings(view);
        public RenderFragment? DetailsTabs(PivotDetailsTabsView view) => mud.DetailsTabs(view);
        public RenderFragment? DetailsDialog(PivotDetailsDialogView view) => mud.DetailsDialog(view);
        public RenderFragment? StaleReport(PivotStaleReportView view) => mud.StaleReport(view);
    }
}
