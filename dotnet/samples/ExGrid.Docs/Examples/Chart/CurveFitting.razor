@using ExChart
@using ExChart.Components
@using ExChart.Engine
@using ExGrid.Data
@using ExChart.Engine.Fitting

<p>
    @foreach (var m in Degrees)
    {
        <button type="button" aria-pressed="@(m == _degree ? "true" : "false")" style="@(m == _degree ? "font-weight: 600" : null)"
                @onclick="() => _degree = m">M = @m</button>
    }
</p>
<ExChart Definition="Curves[_degree]" Title="Polynomial curve fitting" Width="620" Height="340" Range="Frame" />

@code {
    private static readonly int[] Degrees = [0, 1, 3, 9];

    // Ten points evenly across [0, 1]: sin 2πx with noise, as in Bishop's Pattern Recognition and Machine Learning, §1.1.
    private static readonly double[] X = [.. Enumerable.Range(0, 10).Select(i => i / 9.0)];
    private static readonly double[] T = [0.174, 0.688, 0.584, 1.129, 0.255, -0.341, -0.603, -1.240, -0.826, -0.140];

    // The curve the points came from, asked at every pixel in the browser, by the site's js/chart-formats.js.
    private static readonly ScriptFunction Truth = ScriptFunction.Of("./js/chart-formats.js", "sinTwoPi");

    // One definition per degree, made once: the training points, the curve they came from, and the
    // least-squares polynomial, whose Note gives its degree, R² and n.
    private static readonly Dictionary<int, ChartDefinition> Curves = Degrees.ToDictionary(m => m, m => new ChartDefinition(ChartAxis.Numbers("x") with { FormatCode = "0.##" },
    [
        ChartSeries.Of("points", "Training points", SeriesKind.Observation, X.Select((x, i) => new ChartPoint(x, ChartValue.Of(T[i])))),
        ChartSeries.Sampled("truth", "sin 2πx", SeriesKind.Level, 0, 1, Truth) with { FromZero = false },
        Fit.Polynomial(X, T, m).Series("fit", $"M = {m}"),
    ]));

    // The frame is held still as M changes, so M = 9's swings are cut at its edge rather than stretching the axis.
    private static readonly ChartRange Frame = new(0, 1, -1.5, 1.5);

    private int _degree = 3;
}
