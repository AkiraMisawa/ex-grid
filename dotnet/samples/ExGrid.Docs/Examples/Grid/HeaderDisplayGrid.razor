@using System.Globalization
@using ExGrid.Chrome

<div style="display: flex; flex-wrap: wrap; gap: 16px; align-items: center; margin-bottom: 12px; font-size: 14px">
    <label>
        Header display
        <select @bind="_display">
            @foreach (var display in Enum.GetValues<GridHeaderDisplay>())
            {
                <option value="@display">@display</option>
            }
        </select>
    </label>
</div>

@* No width is declared, so every column is Auto and is measured under the display its header has. *@
<ExGrid TRow="Position" Source="_source" Columns="_columns" HeaderDisplay="_display" ViewportHeight="300" ViewportWidth="ViewportSize.Stretch" />

@code {
    private static readonly CultureInfo Invariant = CultureInfo.InvariantCulture;

    private readonly InMemoryGridSource<Position> _source = GridSource.From(Position.Sample());
    private GridHeaderDisplay _display = GridHeaderDisplay.Compact;

    private readonly GridColumn<Position>[] _columns =
    [
        new("Id", ColumnType.Number, p => p.Id, header: "ID"),
        new("Currency", ColumnType.Text, p => p.Currency, header: "Ccy", filterUi: FilterUiMode.Both),
        new("Quantity", ColumnType.Number, p => p.Quantity, header: "Qty", format: v => ((int)v).ToString("N0", Invariant)),
        new("Hedged", ColumnType.Boolean, p => p.Hedged),
        new("Price", ColumnType.Number, p => p.Price, format: v => ((decimal)v).ToString("N2", Invariant)),
        new("Pnl", ColumnType.Number, p => p.Pnl, header: "P&L", format: v => ((decimal)v).ToString("N2", Invariant)),
        new("Desk", ColumnType.Text, p => p.Desk, filterUi: FilterUiMode.Both),
        new("Instrument", ColumnType.Text, p => p.Instrument),
    ];
}
