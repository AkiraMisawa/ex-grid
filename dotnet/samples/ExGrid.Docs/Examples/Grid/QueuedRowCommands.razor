@using global::ExGrid.Chrome
@using global::ExGrid.Keys
@using global::ExGrid.Rows
@using global::ExGrid.Cells
@using global::ExGrid.Columns
@implements IDisposable

<p>Control+B starts a Consumer operation. Release completes it. Replace the rows while commands wait.</p>
<button id="release-row-order" @onclick="Release">Release</button>
<button id="drop-row-order" @onclick="Drop">Remove first two rows</button>
<button id="restore-row-order" @onclick="Restore">Restore rows</button>
<p role="status" id="row-order-trace">@string.Join(" | ", _trace)</p>
<ExGrid TRow="CommandRow" Source="_source" Columns="Columns" RowHeight="24" ViewportWidth="ViewportSize.Stretch" ViewportHeight="220"
        Chrome="Chrome"
        DeclaredKeys="Keys" OnDeclaredKey="HoldAsync" OnAction="Act" OnRefused="Refused" />

@code {
    [Parameter] public IGridChrome? Chrome { get; set; }
    public sealed record CommandRow(int Id);
    private static readonly string[] Keys = ["Control+b"];
    private static readonly Func<CommandRow, object> Key = row => row.Id;
    private static readonly GridColumn<CommandRow>[] Columns =
    [
        new("Id", ColumnType.Number, r => r.Id, width: new(ColumnWidth.Fixed(100))),
        GridColumn<CommandRow>.ActionColumn("Action", [new GridAction("open", "Open")], width: new(ColumnWidth.Fixed(120))),
        GridColumn<CommandRow>.MarkColumn("Mark", width: new(ColumnWidth.Fixed(60))),
    ];
    // Keyed, so a row handed back is the same row, and the order moving drops the selection (ADR-0011).
    private readonly InMemoryGridSource<CommandRow> _source = GridSource.From(Rows(), Key);
    private static CommandRow[] Rows() => Enumerable.Range(0, 80).Select(id => new CommandRow(id)).ToArray();
    private readonly List<string> _trace = [];
    private TaskCompletionSource? _release;
    private string _marked = "";
    // The source keeps the Row Marks, and the trace says which rows are marked whenever that changes.
    protected override void OnInitialized() => _source.Marks.Changed += OnMarksChanged;
    private void OnMarksChanged()
    {
        var marked = string.Join(",", _source.Window.Where(_source.Marks.IsMarked).Select(row => row.Id));
        if (marked == _marked) return;
        _marked = marked;
        Record($"mark:{(marked.Length == 0 ? "none" : marked)}");
    }
    private void Record(string value) { _trace.Add(value); StateHasChanged(); }
    private async Task HoldAsync(GridDeclaredKeyPress _)
    {
        var release = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
        _release = release;
        Record("started");
        await release.Task;
        Record("finished");
    }
    private void Release() => _release?.TrySetResult();
    private void Drop() => _source.ReplaceAll([.. Rows().Where(row => row.Id >= 2)]);
    private void Restore() => _source.ReplaceAll(Rows());
    private void Act(GridActionEventArgs<CommandRow> args) => Record($"action:{args.Row.Id}");
    private void Refused(GridRefusal<CommandRow> refusal) => Record(refusal switch
    {
        GridRefusal<CommandRow>.Action action => $"action:{action.Reason}",
        GridRefusal<CommandRow>.Mark mark => $"mark:{mark.Reason}",
        _ => throw new ArgumentOutOfRangeException(nameof(refusal), refusal, "A refusal this Example does not record."),
    });
    public void Dispose()
    {
        _source.Marks.Changed -= OnMarksChanged;
        Release();
    }
}
