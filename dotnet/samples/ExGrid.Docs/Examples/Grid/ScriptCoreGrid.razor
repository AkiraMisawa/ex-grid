@using ExGrid.Docs.Examples.Data
@using ExGrid.Cells
@using ExGrid.Selection

@* A double click on a cell that does not edit opens that trade's note: the grid hands the keyboard on to the
   field, and Enter there gives it back. *@
<div style="display: flex; gap: 8px; align-items: center; margin-bottom: 8px">
    <label for="trade-note">@(_noteFor is null ? "Double-click a Trader for its note" : $"Note for trade {_noteFor.Id}")</label>
    <input id="trade-note" placeholder="Enter to go back to the grid" style="flex: 1"
           @bind:get="Note" @bind:set="SetNote" @bind:event="oninput" @onkeydown="NoteKeyAsync" @ref="_noteField" />
</div>
<ExGrid.Components.ExGrid TRow="Trade" Source="_source" Columns="_columns" ViewportHeight="320" ViewportWidth="ViewportSize.Stretch"
                      OnEdit="Edit" ShowFillHandle ShowFormulaBar OnFill="Fill" OnCellDoubleClick="OpenNoteAsync" OnNameBoxEntered="GoToTradeAsync" CompleteEditorText="CompleteBook" @ref="_grid" />
@if (_nameBoxRefusal is not null)
{
    <p role="status">@_nameBoxRefusal</p>
}

@code {
    // Kept in fields: a new source is a new grid's worth of rows.
    private readonly InMemoryGridSource<Trade> _source = GridSource.From(Trade.Sample());

    // A Template cell, drawn in .NET from the row and moved into the cell by the grid's script. The value beside it
    // is still what sorts, filters and copies.
    private static readonly RenderFragment<TemplateCellContext<Trade>> Status = cell =>
        @<span style="display: flex; align-items: center; gap: 6px; height: 100%; padding: 0 8px">
            <span style="width: 8px; height: 8px; border-radius: 50%; background: @(cell.Row.Confirmed ? "#1a7f37" : "#bf8700")"></span>
            @(cell.Row.Confirmed ? "Confirmed" : "Pending")
        </span>;

    private readonly GridColumn<Trade>[] _columns =
    [
        new("Id", ColumnType.Number, t => t.Id),
        new("Book", ColumnType.Text, t => t.Book, editable: true),
        new("Trader", ColumnType.Text, t => t.Trader),
        new("Instrument", ColumnType.Text, t => t.Instrument),
        new("Notional", ColumnType.Number, t => t.Notional, format: v => ((decimal)v).ToString("N0")),
        new("Price", ColumnType.Number, t => t.Price),
        new("TradeDate", ColumnType.Date, t => t.TradeDate, header: "Trade date", dateType: DateType.DateOnly),
        GridColumn<Trade>.TemplateColumn("Confirmed", ColumnType.Boolean, t => t.Confirmed, Status),
    ];

    private ExGrid.Components.ExGrid<Trade>? _grid;
    private ElementReference _noteField;
    private Trade? _noteFor;
    private readonly Dictionary<int, string> _notes = [];

    private string Note => _noteFor is null ? "" : _notes.GetValueOrDefault(_noteFor.Id, "");

    private void SetNote(string? text)
    {
        if (_noteFor is null)
            return;
        if (string.IsNullOrEmpty(text))
            _notes.Remove(_noteFor.Id);
        else
            _notes[_noteFor.Id] = text;
    }

    // Handed on by the grid, not by the field's own FocusAsync: a cell the user pressed meanwhile keeps the keyboard.
    private async Task OpenNoteAsync(CellPosition at)
    {
        if (_grid is null || at.Row >= _source.Window.Count)
            return;
        _noteFor = _source.Window[at.Row];
        await _grid.HandKeyboardToAsync(_noteField);
    }

    // Given back from the field, which still holds the keyboard as it asks; an Enter that ends a composition is the IME's.
    private async Task NoteKeyAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.IsComposing && _grid is not null)
            await _grid.ReturnKeyboardAsync(_noteField);
    }

    // The Name Box takes a trade's Id: the grid reads no address, so what a name means is yours. It places the
    // Selection on that trade's Book, or says why it placed nothing.
    private string? _nameBoxRefusal;

    private async Task GoToTradeAsync(string typed)
    {
        var rows = _source.Window;
        var at = -1;
        if (int.TryParse(typed.Trim(), out var id))
            for (var i = 0; i < rows.Count && at < 0; i++)
                if (rows[i].Id == id)
                    at = i;
        _nameBoxRefusal = at < 0 ? $"No trade has the Id '{typed}'." : null;
        if (at >= 0 && _grid is not null)
            await _grid.PlaceSelectionAsync(new SelectionRange(at, 1, 1, 1), new CellPosition(at, 1), _source.RowSequenceVersion);
    }

    // The books whose names begin with what is typed, each replacing it whole. The grid knows no book: what is offered,
    // and what accepting it writes, are yours.
    private static readonly string[] Books = ["Credit", "Equities", "FX", "Rates"];

    private static ValueTask<EditorCompletion?> CompleteBook(string text, int caret)
    {
        var candidates = text.Length == 0 ? [] : Books.Where(book => book.StartsWith(text, StringComparison.OrdinalIgnoreCase))
            .Select(book => new CompletionCandidate(book, 0, text.Length, book)).ToList();
        return ValueTask.FromResult<EditorCompletion?>(candidates.Count == 0 ? null : new EditorCompletion(candidates));
    }

    // The browser committed the edit; your source holds what the cell shows from then on.
    private void Edit(GridEditIntent<Trade> intent) => _source.ReplaceRow(intent.Row, intent.Row with { Book = intent.Value });

    // Each target cell takes the text of the source cell it repeats. Only Book is editable, so every target cell is a
    // Book, whichever way the drag went. A fill raised under an order that has since moved names other rows: it is
    // refused, so the grid neither selects nor counts cells nothing wrote. Every row is resolved before one is written,
    // since a write could reorder them.
    private void Fill(GridFillIntent fill)
    {
        if (fill.RowSequenceVersion != _source.RowSequenceVersion)
        {
            fill.Refuse();
            return;
        }
        var rows = _source.Window;
        var (source, target) = (fill.Source, fill.Target);
        var writes = Enumerable.Range(target.TopRow, target.RowCount).Select(at =>
        {
            var from = rows[source.TopRow + Mod(at - source.TopRow, source.RowCount)];
            var column = _columns[source.LeftColumn + Mod(target.LeftColumn - source.LeftColumn, source.ColumnCount)];
            return (Row: rows[at], Book: column.Info.TextOf(from));
        }).ToList();
        foreach (var (row, book) in writes)
            _source.ReplaceRow(row, row with { Book = book });
    }

    private static int Mod(int value, int by) => ((value % by) + by) % by;
}
