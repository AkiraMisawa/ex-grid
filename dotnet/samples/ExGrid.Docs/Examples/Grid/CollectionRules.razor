@using ExGrid.Cells
@using ExGrid.Clipboard
@using ExGrid.Columns
@using ExGrid.Finding
@using ExGrid.Selection
@using ExGrid.Validation

<div style="display: flex; gap: 8px; align-items: center; margin-bottom: 12px; font-size: 14px">
    <button type="button" @onclick="Save">Save</button>
    <span>@_message</span>
</div>

<ExGrid TRow="CurveTrade" Source="_source" Columns="_columns" PinnedColumnCount="1"
        CellState="_rules.State" CellMessageOf="_rules.Message" OnFindError="_findError" OnCountErrors="_countErrors"
        OnEdit="OnEdit" OnPaste="OnPaste"
        ViewportHeight="300" ViewportWidth="ViewportSize.Stretch" />

@code {
    private readonly List<CurveTrade> _trades = CurveTrade.Sample();
    private readonly InMemoryGridSource<CurveTrade> _source;
    // Keyed by the trade id, the Row Key: a Breach names trades wherever they stand, on screen or not.
    private readonly GridRuleset<CurveTrade> _rules = new GridRuleset<CurveTrade>(t => t.Id).Set(CurveTrade.OneCurvePerCsa);
    private readonly GridColumn<CurveTrade>[] _columns =
    [
        new("Id", ColumnType.Text, t => t.Id, width: new(ColumnWidth.Fixed(80))),
        new("Csa", ColumnType.Text, t => t.Csa, header: "CSA", width: new(ColumnWidth.Fixed(90))),
        new("Counterparty", ColumnType.Text, t => t.Counterparty, width: new(ColumnWidth.Fixed(140))),
        new("Curve", ColumnType.Text, t => t.Curve, header: "Discount curve", width: new(ColumnWidth.Fixed(140)), editable: true),
    ];
    // Held in fields: a method group would be another delegate on every render (ADR-0003).
    private readonly Func<GridErrorStepRequest, CancellationToken, Task<GridFindResult>> _findError;
    private readonly Func<GridErrorCountRequest, CancellationToken, Task<GridErrorCount>> _countErrors;
    private string _message = "CSA ABC discounts on USD-SOFR. Move its trades to USD-FF one by one.";

    public CollectionRules()
    {
        _source = GridSource.From(_trades);
        _rules.Evaluate(_trades, _columns);
        // F8 and Shift+F8 step through the error cells in the order the grid shows, and the status line counts them,
        // those a Filter hides said apart. An in-memory Source holds its whole result, in that order, as its Window.
        _findError = (request, _) => Task.FromResult(_rules.FindError(request, _source.Window));
        _countErrors = (request, _) => Task.FromResult(_rules.CountErrors(request, _source.Window));
    }

    private void OnEdit(GridEditIntent<CurveTrade> edit) => Apply([(edit.Row, edit.Value)]);

    // Ctrl+Enter over a selection fills every cell at once: the one gesture that moves a whole CSA in a step.
    private void OnPaste(GridPasteIntent paste)
        => Apply([.. Cells(paste.Plan.Targets).Where(cell => _columns[cell.Column].Name == "Curve")
            .Select(cell => (_source.Window[cell.Row], paste.ValueFor(cell)))]);

    private void Apply(IReadOnlyList<(CurveTrade Row, string Curve)> writes)
    {
        foreach (var (row, curve) in writes)
        {
            var replacement = row with { Curve = curve.Trim() };
            _source.ReplaceRow(row, replacement);
            _trades[_trades.FindIndex(t => t.Id == row.Id)] = replacement;
        }
        // The rule is judged over the whole collection after every apply, never at the editor: the edit lands.
        _rules.Evaluate(_trades, _columns);
        _message = _rules.Breaches.Count == 0 ? "Every CSA has one curve." : $"{_rules.Breaches.Count} breach(es) stand.";
    }

    // The refusal belongs to the save, as a database's deferred constraint is checked at commit.
    private void Save() => _message = _rules.Breaches.Count == 0
        ? "Saved."
        : $"Not saved: {_rules.Breaches[0].Message}";

    private static IEnumerable<CellPosition> Cells(IEnumerable<SelectionRange> ranges) =>
        from range in ranges
        from row in Enumerable.Range(range.TopRow, range.RowCount)
        from column in Enumerable.Range(range.LeftColumn, range.ColumnCount)
        select new CellPosition(row, column);
}
