@using System.Globalization
@using System.Text
@using System.Text.Json
@using ExGrid.Columns

<ExGrid TRow="Position" Source="_source" Columns="_columns" PinnedColumnCount="_pinned"
        OnColumnWidthChanged="OnWidthChanged" OnColumnOrderChanged="OnOrderChanged" OnPinnedCountChanged="OnPinned"
        ViewportHeight="260" ViewportWidth="ViewportSize.Stretch" />

<div style="display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-top: 12px; font-size: 14px">
    <button type="button" @onclick="Save">Save the view</button>
    <button type="button" @onclick="Reset">Reset</button>
    <button type="button" disabled="@(_saved is null)" @onclick="Restore">Restore the saved view</button>
    <span role="status">@_said</span>
</div>
@if (_saved is not null)
{
    <pre style="margin: 8px 0 0; max-height: 220px; overflow: auto; font-size: 12px">@Indented(_saved)</pre>
}

@code {
    private static readonly CultureInfo Invariant = CultureInfo.InvariantCulture;

    private static readonly GridColumn<Position>[] All =
    [
        new("Id", ColumnType.Number, p => p.Id, width: Fixed(70), align: CellAlign.Left),
        new("Instrument", ColumnType.Text, p => p.Instrument),
        new("Desk", ColumnType.Text, p => p.Desk, width: Fixed(100)),
        new("Trader", ColumnType.Text, p => p.Trader),
        new("Quantity", ColumnType.Number, p => p.Quantity, width: Fixed(100), format: v => ((int)v).ToString("N0", Invariant)),
        new("Pnl", ColumnType.Number, p => p.Pnl, header: "P&L", width: Fixed(120), format: v => ((decimal)v).ToString("N2", Invariant)),
        new("TradeDate", ColumnType.Date, p => p.TradeDate, header: "Trade date", width: Fixed(130), dateType: DateType.DateOnly),
        new("Hedged", ColumnType.Boolean, p => p.Hedged, width: Fixed(96)),
    ];

    private readonly InMemoryGridSource<Position> _source = GridSource.From(Position.Sample());

    // The View State is yours: the order, the widths and the pinned count here, the sort and the
    // filter in the source. The grid only reports the gestures.
    private List<string> _order = [.. All.Select(c => c.Name)];
    private Dictionary<string, ColumnWidth> _widths = [];
    private IReadOnlyList<GridColumn<Position>> _columns = All;
    private int _pinned = 1;

    // What your application keeps for the user: in local storage, or in a settings table.
    private string? _saved;
    private string? _said;

    // The view on screen now.
    private GridViewState Shown() => GridViewState.Of(_columns, _pinned, _source.Sorts, _source.Filter);

    private void Save()
    {
        var shown = Shown();
        // A View State compares by what it holds, so the stored one, read back, equals what it was
        // saved from until the user changes something.
        if (_saved is not null && GridViewStateJson.Read(_saved, All.Select(c => c.Name)) == shown)
        {
            _said = "Nothing has changed since the view was saved.";
            return;
        }
        _saved = GridViewStateJson.Write(shown);
        _said = "Saved.";
    }

    private void Restore()
    {
        GridViewState view;
        try
        {
            // Told every column the grid can show: a stored view that names one it no longer has,
            // or holds anything else it cannot read, is refused by name.
            view = GridViewStateJson.Read(_saved!, All.Select(c => c.Name));
        }
        catch (JsonException refused)
        {
            _said = refused.Message;
            return;
        }
        if (view == Shown())
        {
            _said = "The grid already shows the saved view.";
            return;
        }
        _order = [.. view.Columns.Select(c => c.Column)];
        _widths = view.Columns.ToDictionary(c => c.Column, c => c.Width);
        _pinned = view.PinnedColumnCount;
        Rebuild();
        _source.OnSortChanged(view.Sorts);
        _source.OnFilterChanged(view.Filter);
        _said = "Restored.";
    }

    private void Reset()
    {
        _order = [.. All.Select(c => c.Name)];
        _widths = [];
        _pinned = 1;
        Rebuild();
        _source.OnSortChanged([]);
        _source.OnFilterChanged(null);
        _said = null;
    }

    private void OnWidthChanged(ColumnWidthChange change)
    {
        _widths[change.Column] = ColumnWidth.Fixed(change.WidthPx);
        Rebuild();
    }

    private void OnOrderChanged(IReadOnlyList<string> order)
    {
        _order = [.. order, .. _order.Where(name => !order.Contains(name))];
        Rebuild();
    }

    private void OnPinned(int count) => _pinned = count;

    // A new list each time something changed: the list instance is what tells the grid.
    private void Rebuild() => _columns = [.. _order.Select(name => Sized(All.First(c => c.Name == name)))];

    // A column at the width the user gave it — Fixed after a drag, or as the stored view holds it,
    // where Auto stays Auto and measures itself again.
    private GridColumn<Position> Sized(GridColumn<Position> column)
        => _widths.TryGetValue(column.Name, out var width) && width != column.Width.Width
            ? new(column.Name, column.Type, column.Value, column.Header,
                new ColumnWidthSpec(width, column.Width.MinWidthPx, column.Width.MaxWidthPx),
                align: column.Align, format: column.Format,
                dateType: column.Type == ColumnType.Date ? column.DateType : null)
            : column;

    private static ColumnWidthSpec Fixed(double px) => new(ColumnWidth.Fixed(px));

    // The stored text, laid out to read.
    private static string Indented(string json)
    {
        using var document = JsonDocument.Parse(json);
        using var buffer = new MemoryStream();
        using (var writer = new Utf8JsonWriter(buffer, new JsonWriterOptions { Indented = true }))
            document.WriteTo(writer);
        return Encoding.UTF8.GetString(buffer.ToArray());
    }
}
