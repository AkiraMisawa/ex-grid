@using ExGrid.Docs.Examples.Data

<MudExGridPaper Class="docs-stretch-paper" Elevation="0" Outlined="true">
    <ToolBarContent>
        <MudSwitch T="bool" Value="_labelled" ValueChanged="Label" Color="Color.Primary" Label="Name each row by its trade" />
        <MudSpacer />
        <MudText Typo="Typo.body2">Press Ctrl+F in the grid, type "novak" and press Find All</MudText>
    </ToolBarContent>
    <ChildContent>
        <ExGrid TRow="Trade" Source="_source" Columns="_columns" Chrome="_chrome"
                ViewportHeight="320" ViewportWidth="ViewportSize.Stretch" />
    </ChildContent>
</MudExGridPaper>

@code {
    private static readonly MudGridChrome _chrome = new();

    // GridSource.From answers Find All for you: every match over its rows, a page at a time, with the exact count.
    private readonly InMemoryGridSource<Trade> _source = GridSource.From(Trade.Sample(2_000));

    private readonly GridColumn<Trade>[] _columns =
    [
        new("Id", ColumnType.Number, t => t.Id),
        new("Book", ColumnType.Text, t => t.Book),
        new("Trader", ColumnType.Text, t => t.Trader),
        new("Instrument", ColumnType.Text, t => t.Instrument),
        new("Notional", ColumnType.Number, t => t.Notional, format: v => ((decimal)v).ToString("N0")),
    ];

    private bool _labelled;

    // The list names a row by its position in the order shown, "Row 12, Trader"; or by your own words for it. A Find
    // All pressed after the change names rows the new way.
    private void Label(bool labelled)
    {
        _labelled = labelled;
        _source.FindAllRowLabel = labelled ? t => $"Trade {t.Id}" : null;
    }
}
