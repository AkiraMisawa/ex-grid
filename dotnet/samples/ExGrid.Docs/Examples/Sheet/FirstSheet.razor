@using ExSheet.Components
@using ExSheet.Engine

<ExSheet @bind-Document="_document" ViewportHeight="300" ViewportWidth="ViewportSize.Stretch" />

<p class="mt-3">The document holds @_document.Cells.Count cells. Type into an empty one and the count follows.</p>

