@using System.Globalization
@* FX volatility › Surface: the quotes as the market sends them, one row per expiry and one column per
   delta, beside the surface made from them. A blank cell is a quote that did not come in: the surface
   fills it where it lies between two quotes of its expiry, and says so in its tooltip and Notes, and
   leaves it a hole where it does not. Drag the surface or use the arrow keys to turn it; click a delta or
   a tenor to slice it into a term structure or a smile, drawn beside it where its values are read
   exactly. The surface's toolbar saves it as SVG or PNG. *@
<p class="xs-note">
    Implied volatilities in %, by delta and expiry, as of @Iso(FxVolData.AsOf). A blank cell has no quote. Click a
    delta or a tenor on the surface to slice it; drag or use the arrow keys to turn it.
</p>
<div class="xs-fx-row">
    @* The grid takes the width the surface leaves, and the surface keeps its own. *@
    <div class="xs-panel xs-fx-quotes">
        @if (Mud)
        {
            @* A block-level paper: the Wrapper's own is inline, as wide as its grids, which leaves a stretched grid no width. *@
            <MudExGridPaper Elevation="1" Style="display: flex">
                <ExGrid TRow="FxVolRow" Rows="FxVolData.Quotes" Columns="Columns" HeaderGroups="Groups" PinnedColumnCount="1"
                        ViewportHeight="GridHeight" ViewportWidth="ViewportSize.Stretch" Chrome="MudGridChrome.Default" />
            </MudExGridPaper>
        }
        else
        {
            <ExGrid TRow="FxVolRow" Rows="FxVolData.Quotes" Columns="Columns" HeaderGroups="Groups" PinnedColumnCount="1"
                    ViewportHeight="GridHeight" ViewportWidth="ViewportSize.Stretch" />
        }
    </div>
    <div class="xs-panel">
        @if (Mud)
        {
            <MudExGridPaper Elevation="1">
                <ExSurface Definition="FxVolSurface.Surface" Title="@Title" FileName="@Title" Width="SurfaceWidth" Height="SurfaceHeight" SliceWidth="SliceWidth"
                           View="_surfaceView" OnViewChanged="_viewChanged" Slice="_slice" OnSliceChanged="_sliceChanged" />
            </MudExGridPaper>
        }
        else
        {
            <ExSurface Definition="FxVolSurface.Surface" Title="@Title" FileName="@Title" Width="SurfaceWidth" Height="SurfaceHeight" SliceWidth="SliceWidth"
                       View="_surfaceView" OnViewChanged="_viewChanged" Slice="_slice" OnSliceChanged="_sliceChanged" />
        }
    </div>
</div>

@code {
    /// <summary>Whether the view is drawn with MudBlazor's Chrome.</summary>
    [Parameter] public bool Mud { get; set; }

    private const string Title = $"{FxVolData.Pair} volatility";
    private const double SurfaceWidth = 480, SurfaceHeight = 360, SliceWidth = 320;
    private static readonly ViewportSize GridHeight = 344;
    private static readonly CultureInfo Invariant = CultureInfo.InvariantCulture;

    private static readonly GridColumn<FxVolRow>[] Columns =
    [
        new("Tenor", ColumnType.Text, r => r.Tenor),
        new("Expiry", ColumnType.Date, r => r.Expiry, dateType: DateType.DateOnly),
        .. FxVolData.Deltas.Select((d, i) => new GridColumn<FxVolRow>(d, ColumnType.Number, r => r.Vols[i], format: FxVolSurface.Percent)),
    ];

    private static readonly HeaderGroup[] Groups = [new("Implied volatility (%)", FxVolData.Deltas)];

    // Held in fields, never rebuilt per render (AGENTS.md: a new delegate is a changed parameter).
    private EventCallback<SurfaceView> _viewChanged;
    private EventCallback<SurfaceSlice> _sliceChanged;

    // The surface holds no View State: the angle it was turned to and the slice clicked come back as
    // events, for the page to keep.
    private SurfaceView? _surfaceView;
    private SurfaceSlice? _slice;

    protected override void OnInitialized()
    {
        _viewChanged = EventCallback.Factory.Create<SurfaceView>(this, v => _surfaceView = v);
        _sliceChanged = EventCallback.Factory.Create<SurfaceSlice>(this, s => _slice = s);
    }

    private static string Iso(DateOnly d) => d.ToString("yyyy-MM-dd", Invariant);
}
