@page "/virtual"
@implements IDisposable

<DemoNav />

<h1>Virtualised — 100,000 rows</h1>

<p>
    The grid holds none of these rows. It paints the Window it is given, and when the
    Viewport moves past what that Window covers it raises a Range Request and keeps
    painting Placeholders until an answer arrives (ADR-0001/0004). This page answers
    after 300&nbsp;ms, as a server would, and answers with more rows than were asked
    for — read-ahead is the Consumer's judgement, not the grid's.
</p>

<p class="demo-status">
    @if (_source.TotalCount is null)
    {
        <text>Window: nothing pushed yet, of @Total rows.</text>
    }
    else if (_source.Window.Count == 0)
    {
        <text>Window: no rows, of @_source.TotalCount.</text>
    }
    else
    {
        <text>Window: rows @_source.WindowStart–@(_source.WindowStart + _source.Window.Count - 1) of @_source.TotalCount.</text>
    }
    @if (_source.IsLoading)
    {
        <strong>Loading…</strong>
    }
</p>

<ExGrid TRow="DemoTrade"
        Source="_source"
        Columns="DemoData.Columns"
        RowHeight="24"
        ViewportHeight="480"
        ShowFormulaBar="Bar is not null"
        HideColumnMenu="true" />

@code {
    private const int Total = 100_000;

    /// <summary><c>?bar=1</c> switches the Formula Bar on (ADR-0051), so the focused cell's full
    /// value can be read: an unformatted Trade date shows in its ISO form there too (ADR-0006,
    /// ticket 95).</summary>
    [SupplyParameterFromQuery(Name = "bar")]
    public string? Bar { get; set; }

    /// <summary>Rows either side of the Viewport to answer with, so ordinary scrolling
    /// does not ask again immediately (ADR-0001: read-ahead belongs to the Consumer).</summary>
    private const int ReadAhead = 40;

    private static readonly DemoTrade[] AllRows = DemoData.Window(Total, seed: 7);

    private FetchingGridSource<DemoTrade> _source = default!;

    protected override void OnInitialized()
    {
        _source = GridSource.Fetch<DemoTrade>(AnswerLateAsync, readAheadRows: ReadAhead);
        _source.StateChanged += OnSourceChanged;
    }

    private static readonly ColumnInfo<DemoTrade>[] Infos = [.. DemoData.Columns.Select(column => column.Info)];

    // The last order asked for and its rows, so scrolling through one order sorts once (a header click still sorts).
    private (GridQuery Order, IReadOnlyList<DemoTrade> Rows)? _ordered;

    // Where a server call would go. The wait is what makes the Placeholders visible long enough to watch; a request
    // the grid gave up is cancelled, and its answer is never read. It answers in the order and under the filter asked.
    private async ValueTask<GridPage<DemoTrade>> AnswerLateAsync(GridQuery query, CancellationToken cancellationToken)
    {
        await Task.Delay(300, cancellationToken);
        var rows = Ordered(query);
        var start = Math.Min(query.Range.Start, rows.Count);
        var end = Math.Min(rows.Count, query.Range.Start + query.Range.Count);
        return new GridPage<DemoTrade>([.. rows.Skip(start).Take(end - start)], start, rows.Count);
    }

    private IReadOnlyList<DemoTrade> Ordered(GridQuery query)
    {
        if (query.Sorts.Count == 0 && query.Filter is null)
            return AllRows;
        var order = query with { Range = new RowRange(0, 0) };
        if (_ordered is { } held && held.Order.Equals(order))
            return held.Rows;
        var rows = GridQueryEngine.Apply(AllRows, Infos, query.Filter, query.Sorts);
        _ordered = (order, rows);
        return rows;
    }

    private void OnSourceChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        _source.StateChanged -= OnSourceChanged;
        _source.Dispose();
    }
}
