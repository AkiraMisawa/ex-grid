@page "/"

<nav class="demo-nav">
    <span aria-current="page">All pages</span>
</nav>

<h1>ExGrid demo host</h1>

<p>
    Every page of the demo, by theme. Each is a sample a Consumer can read and copy, and
    most are also what the browser tests drive. The list is <code>DemoPageList</code>; a
    page missing from it fails a test.
</p>

<div id="demo-index">
    @foreach (var group in DemoPageList.All.GroupBy(entry => entry.Group))
    {
        <section class="demo-index-group">
            <h2>@group.Key</h2>
            <ul>
                @foreach (var entry in group)
                {
                    <li>
                        <a href="@entry.Route">@entry.Title</a>
                        <span class="demo-index-description">@entry.Description</span>
                    </li>
                }
            </ul>
        </section>
    }
</div>
