<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net10.0 so the gating tests execute on the shipped target's runtime (ADR-0022). -->
    <TargetFramework>net10.0</TargetFramework>
    <!-- xunit v3 / Microsoft.Testing.Platform: the test project is its own executable.
         Chosen over the VSTest stack because VSTest's testhost re-resolves the runtime
         through the nix store's symlinks and misses the combined runtime. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- Lets `dotnet test` drive the executable instead of VSTest's testhost. -->
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <!-- A failed test's name and message in `dotnet test`'s output, where CI's log shows them;
         the summary alone names only the assembly. -->
    <TestingPlatformShowTestsFailure>true</TestingPlatformShowTestsFailure>
    <!-- No native apphost. The one the SDK emitted for net8.0 came from a NuGet
         template stamped with the host ELF interpreter, so it starts under the host
         loader and then dlopens the nix runtime's libcoreclr.so — two glibcs in one
         process, and on WSL2 Ubuntu the load fails. Without it, `dotnet test` runs
         the dll through the nix muxer instead, the same way on every platform.
         dotnet/tests/Directory.Build.targets has the full account, and relaxes the xunit.v3
         build guard that would otherwise demand an apphost. -->
    <UseAppHost>false</UseAppHost>
    <!-- GridViewStateJsonTests puts a View State into a source-generated context of a Consumer's
         own, to hold that it is refused there too (ADR-0207). What that Consumer's build says —
         the refusing converter is internal, so the generator cannot use it (SYSLIB1220) and
         generates nothing for the type (SYSLIB1030) — is said once here: a generator's diagnostic
         cannot be suppressed by a #pragma. No other context is declared in this project. -->
    <NoWarn>$(NoWarn);SYSLIB1220;SYSLIB1030</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="2.0.3" />
    <!-- A clock a test drives: the live sources gather on one (ADR-0141). -->
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="9.0.0" />
    <!-- Coverage for CI (ADR-0041), on the same Microsoft.Testing.Platform 1.6 line
         xunit.v3 2.0 runs on; the 18.x extensions move to platform 2. Inert unless
         the coverage switch is passed. -->
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="17.14.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ExGrid\ExGrid.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The shared cases (ADR-0350, section 5): written once as data, run here against the C# core and
         by Vitest against the Script Core. tests/cases/README.md says what a file holds. -->
    <None Include="..\..\..\tests\cases\**\*.json" Link="cases\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The glyph-width corpus and the painted widths of each face (ADR-0016, ticket 83);
         the core's estimate is held to them. tests/GlyphWidths/README.md says how they are made. -->
    <Compile Include="..\..\..\tests\GlyphWidths\GlyphWidthRecord.cs" Link="GlyphWidths\GlyphWidthRecord.cs" />
    <None Include="..\..\..\tests\GlyphWidths\*.json" Link="GlyphWidths\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
