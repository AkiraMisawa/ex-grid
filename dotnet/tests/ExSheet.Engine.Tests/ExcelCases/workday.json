{
  "area": "workday",
  "about": "WORKDAY (ticket 04).",
  "cases": [
    {
      "id": "WORKDAY-001",
      "source": "observed",
      "description": "Microsoft's example: 151 workdays after 1 October 2008",
      "cells": {"A1": "10/1/2008", "A2": "151", "A3": "11/26/2008", "A4": "12/4/2008", "A5": "1/21/2009", "ZZ1000": "=WORKDAY(A1,A2)"},
      "check": "ZZ1000",
      "expect": {"value2": 39933}
    },
    {
      "id": "WORKDAY-002",
      "source": "observed",
      "description": "Microsoft's example: with three holidays",
      "cells": {"A1": "10/1/2008", "A2": "151", "A3": "11/26/2008", "A4": "12/4/2008", "A5": "1/21/2009", "ZZ1000": "=WORKDAY(A1,A2,A3:A5)"},
      "check": "ZZ1000",
      "expect": {"value2": 39938}
    },
    {
      "id": "WORKDAY-003",
      "source": "observed",
      "description": "Engine's answer, Excel to be asked: 0 days is the start itself",
      "cells": {"A1": "10/1/2008", "A2": "151", "A3": "11/26/2008", "A4": "12/4/2008", "A5": "1/21/2009", "ZZ1000": "=WORKDAY(A1,0)"},
      "check": "ZZ1000",
      "expect": {"value2": 39722}
    },
    {
      "id": "WORKDAY-004",
      "source": "observed",
      "description": "Engine's answer, Excel to be asked: backwards over a weekend",
      "cells": {"A1": "10/1/2008", "ZZ1000": "=WORKDAY(A1,-1)"},
      "check": "ZZ1000",
      "expect": {"value2": 39721}
    },
    {
      "id": "WORKDAY-005",
      "source": "observed",
      "description": "Text among the holidays is #VALUE!",
      "cells": {"A1": "10/1/2008", "A2": "abc", "ZZ1000": "=WORKDAY(A1,1,A2)"},
      "check": "ZZ1000",
      "expect": {"value2": "#VALUE!"}
    },
    {
      "id": "WORKDAY-006",
      "source": "observed",
      "description": "Engine's answer, Excel to be asked: before 1 March 1900, as NETWORKDAYS-005 counts: ten workdays after serial 30, a Monday",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=WORKDAY(30,10)"},
      "check": "ZZ1000",
      "expect": {"value2": 44}
    },
    {
      "id": "WORKDAY-007",
      "source": "observed",
      "description": "Engine's answer, Excel to be asked: four workdays after serial 30 is serial 34, a Friday by WEEKDAY (on the real calendar a Saturday, which would give 36)",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=WORKDAY(30,4)"},
      "check": "ZZ1000",
      "expect": {"value2": 34}
    },
    {
      "id": "WORKDAY-008",
      "source": "observed",
      "description": "Engine's answer, Excel to be asked: serial 60, the day that never existed, is a Wednesday and counts as a workday",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=WORKDAY(55,5)"},
      "check": "ZZ1000",
      "expect": {"value2": 62}
    },
    {
      "id": "WORKDAY-009",
      "source": "observed",
      "description": "Engine's answer, Excel to be asked: a result before serial 0 is #NUM!",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=WORKDAY(2,-1)"},
      "check": "ZZ1000",
      "expect": {"value2": "#NUM!"}
    },
    {
      "id": "WORKDAY-010",
      "source": "observed",
      "description": "A start between -1 and 0 is cut down to its day, -1, below 0, and #NUM!; it is not truncated to serial 0, a Saturday",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=WORKDAY(-0.5,1)"},
      "check": "ZZ1000",
      "expect": {"value2": "#NUM!"}
    },
    {
      "id": "WORKDAY-011",
      "source": "observed",
      "description": "A boolean typed as a date is #VALUE!, an Error Value a Formula catches, as EDATE's and EOMONTH's are (EDATE-009, EOMONTH-018); it is not read as 1, which would give serial 2 (Windows run 18a)",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=WORKDAY(TRUE,1)"},
      "check": "ZZ1000",
      "expect": {"value2": "#VALUE!"}
    }
  ]
}
