{
  "area": "or",
  "about": "OR (docs/specs/exsheet-functions).",
  "cases": [
    {
      "id": "OR-001",
      "source": "observed",
      "description": "OR with one TRUE is TRUE",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=OR(TRUE,FALSE)"},
      "check": "ZZ1000",
      "expect": {"value2": true}
    },
    {
      "id": "OR-002",
      "source": "observed",
      "description": "OR of two FALSEs is FALSE",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=OR(FALSE,FALSE)"},
      "check": "ZZ1000",
      "expect": {"value2": false}
    },
    {
      "id": "OR-003",
      "source": "observed",
      "description": "Microsoft's example: neither condition holds",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=OR(1+1=1,2+2=5)"},
      "check": "ZZ1000",
      "expect": {"value2": false}
    },
    {
      "id": "OR-004",
      "source": "observed",
      "description": "Text and blanks inside a Reference are ignored",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=OR(A4:A6)"},
      "check": "ZZ1000",
      "expect": {"value2": true}
    },
    {
      "id": "OR-005",
      "source": "observed",
      "description": "A Reference holding no logical value is #VALUE!",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=OR(A6)"},
      "check": "ZZ1000",
      "expect": {"value2": "#VALUE!"}
    },
    {
      "id": "OR-006",
      "source": "observed",
      "description": "Engine's answer, Excel to be asked: a number other than 0 inside a range is TRUE",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=OR(E1:E2)"},
      "check": "ZZ1000",
      "expect": {"value2": true}
    },
    {
      "id": "OR-007",
      "source": "observed",
      "description": "Engine's answer, Excel to be asked: a 0 in a Reference is FALSE",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=OR(E1)"},
      "check": "ZZ1000",
      "expect": {"value2": false}
    },
    {
      "id": "OR-008",
      "source": "observed",
      "description": "Engine's answer, Excel to be asked: an Error Value in a Reference is the result, even beside a TRUE",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=OR(TRUE,C2)"},
      "check": "ZZ1000",
      "expect": {"value2": "#DIV/0!"}
    },
    {
      "id": "OR-009",
      "source": "observed",
      "description": "Engine's answer, Excel to be asked: typed text that spells neither TRUE nor FALSE is passed over, as AND passes it over (AND-011)",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=OR(\"abc\",FALSE)"},
      "check": "ZZ1000",
      "expect": {"value2": false}
    },
    {
      "id": "OR-010",
      "source": "observed",
      "description": "Engine's answer, Excel to be asked: typed text that spells TRUE, in lower case, counts, so the result is TRUE; FALSE if Excel passes over all typed text (AND-011, AND-015)",
      "fixture": "functionData",
      "cells": {"ZZ1000": "=OR(\"true\",FALSE)"},
      "check": "ZZ1000",
      "expect": {"value2": true}
    }
  ]
}
