<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Mirrors dotnet/tests/ExGrid.Tests: net10.0 (ADR-0022), xunit v3 on Microsoft.Testing.Platform,
         and no native apphost (dotnet/tests/Directory.Build.targets has the account). -->
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <!-- A failed test's name and message in `dotnet test`'s output, where CI's log shows them;
         the summary alone names only the assembly. -->
    <TestingPlatformShowTestsFailure>true</TestingPlatformShowTestsFailure>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="2.0.3" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="17.14.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Excel case corpus (ADR-0047): read by ExcelCaseTests here and by ExcelOracle/oracle.ps1 on Windows. -->
    <None Include="ExcelCases\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Excel's answers for 3D References (ADR-0331 §7): read by ThreeDExcelReadingsTests. -->
    <None Include="ThreeDReadings\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The engine's shared cases (ADR-0370 sections 2 and 5): written once as data, run here against the
         C# engine and by Vitest against @ex-grid/sheet-engine. tests/cases/README.md says what a file holds. -->
    <None Include="..\..\..\tests\cases\sheet\**\*.json" Link="cases\sheet\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ExSheet.Engine\ExSheet.Engine.csproj" />
  </ItemGroup>

</Project>
