<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Mirrors dotnet/tests/ExGrid.Data.Xlsx.Tests: net10.0 (ADR-0022), xunit v3 on Microsoft.Testing.Platform,
         and no native apphost (dotnet/tests/Directory.Build.targets has the account). -->
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <!-- A failed test's name and message in `dotnet test`'s output, where CI's log shows them;
         the summary alone names only the assembly. -->
    <TestingPlatformShowTestsFailure>true</TestingPlatformShowTestsFailure>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="2.0.3" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="17.14.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ExSheet.Xlsx\ExSheet.Xlsx.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The shared cases of ExSheet.Xlsx (ADR-0370 section 3): written once as data, run here against ExSheet.Xlsx and by
         Vitest against @ex-grid/sheet-xlsx. A case writes its file as the .xlsx cases write one, and builds its Workbook
         with the engine's case steps, so both runners are compiled in. tests/cases/README.md says what a file holds. -->
    <Compile Include="..\ExSheet.Engine.Tests\Cases\SheetCases.cs" Link="Cases\SheetCases.cs" />
    <Compile Include="..\ExGrid.Data.Xlsx.Tests\Cases\XlsxCaseTests.Shared.cs" Link="Cases\XlsxCaseTests.Shared.cs" />
    <Compile Include="..\ExGrid.Data.Xlsx.Tests\Fixtures.cs" Link="Cases\Fixtures.cs" />
    <None Include="..\..\..\tests\cases\sheet-xlsx\**\*" Link="cases\sheet-xlsx\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
