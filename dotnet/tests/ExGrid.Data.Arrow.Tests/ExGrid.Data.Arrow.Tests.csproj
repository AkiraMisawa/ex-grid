<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Mirrors dotnet/tests/ExGrid.Data.Tests: net10.0 (ADR-0022), xunit v3 on Microsoft.Testing.Platform,
         and no native apphost (dotnet/tests/Directory.Build.targets has the account). -->
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <!-- A failed test's name and message in `dotnet test`'s output, where CI's log shows them;
         the summary alone names only the assembly. -->
    <TestingPlatformShowTestsFailure>true</TestingPlatformShowTestsFailure>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="2.0.3" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="17.14.2" />
    <!-- The codecs a Consumer hands in to read another producer's compressed stream (ADR-0065):
         the tests write compressed streams with them, and read them back with and without. -->
    <PackageReference Include="Apache.Arrow.Compression" Version="23.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ExGrid.Data.Arrow\ExGrid.Data.Arrow.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The shared Arrow cases (ADR-0370 section 3): written once as data with the streams they read,
         run here against ExGrid.Data.Arrow and by Vitest against @ex-grid/data. tests/cases/README.md
         says what a file holds. -->
    <None Include="..\..\..\tests\cases\arrow\**\*" Link="cases\arrow\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
