<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The release workflow's checks of a tag (ADR-0042, ADR-0205, ADR-0208), run by
         .github/workflows/release.yml before CI's twenty minutes, and by anyone locally (Program.cs
         says how). Not shipped and never packed (only src/ packs). Its tests are
         dotnet/tests/ExGrid.Release.Tests, part of layer 1. -->
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>ExGrid.Release</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Run through the dotnet muxer, as the test projects are (dotnet/tests/Directory.Build.targets
         says why a native apphost is left out under nix). -->
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

</Project>
