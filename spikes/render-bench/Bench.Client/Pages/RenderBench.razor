@page "/"
@using System.Diagnostics
@using Bench.Client.Components
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>cell-grid render bench</PageTitle>

<h3>ExGrid — render cost</h3>
<p class="muted">
    Testing the hypothesis that cost is decided by <b>the number of cells touched per render</b>,
    not by the row count. The data is already in memory and <b>only rendering</b> is measured
    (fetching, sorting and filtering are excluded).
</p>

<div class="controls">
    <label>Visible rows <input type="number" @bind="VisibleRows" min="5" max="120" /></label>
    <label>Visible cols <input type="number" @bind="VisibleCols" min="1" max="80" /></label>
    <label>Rows moved per step <input type="number" @bind="Step" min="1" max="200" /></label>
    <label>Iterations <input type="number" @bind="Iterations" min="20" max="2000" /></label>
    <span class="cells">= @(VisibleRows * VisibleCols) cells/render</span>
    <button @onclick="RunAllAsync" disabled="@_running">@(_running ? "measuring…" : "Measure all modes")</button>
    <button @onclick="RunSelectionAsync" disabled="@_running">Measure selection drag (rows fixed)</button>
    <button @onclick="RunFramesAsync" disabled="@_running">@(_running ? "measuring…" : "Measure overflow paint (frame cost)")</button>
</div>

<div class="controls">
    <span>Presets:</span>
    <button @onclick="() => Preset(40, 20, 1)" disabled="@_running">Slow scroll (40×20, 1 row)</button>
    <button @onclick="() => Preset(40, 20, 50)" disabled="@_running">Fling (40×20, 50 rows)</button>
    <button @onclick="() => Preset(40, 50, 1)" disabled="@_running">Wide, no horizontal virtualisation (40×50, 1 row)</button>
    <button @onclick="() => Preset(40, 50, 50)" disabled="@_running">Wide, no horizontal virtualisation (40×50, 50 rows)</button>
</div>

@if (_error is not null)
{
    <pre class="err-box">@_error</pre>
}

@if (_frameRuns.Count > 0)
{
    <h4>Overflow paint — per-frame cost (milliseconds of main thread per frame)</h4>
    <table class="results">
        <thead>
            <tr>
                <th>Overflow</th><th>Scenario</th><th>Frames</th>
                <th>.NET p50</th><th>.NET p95</th><th>Browser p50</th><th>Browser p95</th>
                <th>Total p50</th><th>Total p95</th><th>Total max</th><th>Changed frames p95</th>
                <th>Animations</th><th>Hashed</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in _frameRuns)
            {
                <tr class="@(r.Total.P95 > 16.6 ? "warn" : "ok")">
                    <td><b>@r.Overflow</b></td><td>@r.Scenario</td><td>@r.Frames</td>
                    <td>@r.Net.P50.ToString("F2")</td><td>@r.Net.P95.ToString("F2")</td>
                    <td>@r.Browser.P50.ToString("F2")</td><td>@r.Browser.P95.ToString("F2")</td>
                    <td>@r.Total.P50.ToString("F2")</td><td>@r.Total.P95.ToString("F2")</td><td>@r.Total.Max.ToString("F2")</td>
                    <td>@(r.ChangedFramesTotal?.P95.ToString("F2") ?? "–")</td>
                    <td>@r.Animations</td><td>@r.HashedCells</td>
                </tr>
            }
        </tbody>
    </table>
    <p class="muted">Browser = the frame's style, layout, animation update and paint recording on the main
        thread, from the end of the rAF callback to a message posted from it. Overflow: None paints the value
        and clips it; CSharp decides #### with a glyph-width estimate; Css carries a scroll-timeline switch on
        every numeric cell (docs/research/css-decided-overflow.md).</p>
    @if (_runs.Count == 0)
    {
        <button @onclick="PostResultsAsync" disabled="@_posting">@_postLabel</button>
    }
}

@if (_runs.Count > 0)
{
    <h4>Results (milliseconds per render)</h4>
    <table class="results">
        <thead>
            <tr>
                <th>Mode</th><th>What it adds</th><th>Cells</th>
                <th>Median</th><th>p95</th><th>Max</th><th>Over 16.6ms</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in _runs)
            {
                <tr class="@(r.Render.P50 > 16.6 ? "bad" : r.Render.P95 > 16.6 ? "warn" : "ok")">
                    <td><b>@r.Mode</b></td>
                    <td class="muted">@ModeNote(r.Mode)</td>
                    <td>@r.Cells</td>
                    <td>@r.Render.P50.ToString("F2")</td>
                    <td>@r.Render.P95.ToString("F2")</td>
                    <td>@r.Render.Max.ToString("F2")</td>
                    <td>@r.Render.OverBudgetPct.ToString("F1")%</td>
                </tr>
            }
        </tbody>
    </table>
    <p class="muted">16.6ms is one frame at 60fps. <b>These figures cover Blazor's render-tree diff and the
        DOM update</b>; the browser's layout and paint are excluded (the clock stops at the DOM update).
        For end-to-end frame time, use the manual scrolling measurement below.</p>
    <button @onclick="PostResultsAsync" disabled="@_posting">@_postLabel</button>
}

<h4>Manual scrolling (how it feels)</h4>
<div class="controls">
    <button @onclick="StartFpsAsync">Start frame measurement</button>
    <button @onclick="StopFpsAsync">Stop and summarise</button>
    @if (_manualStats is not null)
    {
        <span>Frame interval median @_manualStats.P50.ToString("F1")ms / p95 @_manualStats.P95.ToString("F1")ms
            (@_manualStats.OverBudgetPct.ToString("F0")% over 16.6ms)</span>
    }
    <span class="muted">Mode:</span>
    @foreach (var m in Enum.GetValues<CellRenderMode>())
    {
        var mm = m;
        <button class="@(_mode == mm ? "sel" : null)" @onclick="() => _mode = mm" disabled="@_running">@mm</button>
    }
</div>

<div class="scroller" @ref="_scrollerEl" @onscroll="OnScrollAsync">
    <div class="spacer" style="height:@(TotalRows * RowHeight)px">
        @* During a programmatic run scrollTop stays at 0, so offsetting the window by
           _startRow would slide the rendered rows far below the visible area: Blazor
           would do all the work while the browser skipped layout and paint, and the
           operator would stare at a blank box. Pin the window to the top while running
           so the rows being measured are actually on screen. *@
        <div class="window" style="transform: translateY(@(_running ? 0 : _startRow * RowHeight)px)">
            @for (var r = 0; r < VisibleRows; r++)
            {
                var row = _rows[(_startRow + r) % TotalRows];

                if (_mode is CellRenderMode.RowComponent or CellRenderMode.RowComponentTone)
                {
                    <BenchRow @key="row.Id" RowData="row" Cols="_cols" VisibleCols="VisibleCols" Meta="_metaFn" Tone="@(_mode == CellRenderMode.RowComponentTone ? _toneFn : null)"
                              SelFrom="@RowSelFrom(_startRow + r)" SelTo="@RowSelTo(_startRow + r)" Overflow="_overflow" />
                }
                else
                {
                <div class="r" @key="row.Id">
                    <div class="c key">@row.Book</div>
                    @switch (_mode)
                    {
                        case CellRenderMode.Direct:
                            @for (var c = 0; c < VisibleCols; c++)
                            {
                                <div class="c num">@row.Values[c].ToString("N2")</div>
                            }
                            break;

                        case CellRenderMode.Accessor:
                            @for (var c = 0; c < VisibleCols; c++)
                            {
                                <div class="c num">@Fmt(_cols[c].Get(row))</div>
                            }
                            break;

                        case CellRenderMode.AccessorMeta:
                            @for (var c = 0; c < VisibleCols; c++)
                            {
                                var ci = c;
                                <div class="@StateClass(Meta(row, ci))">@Fmt(_cols[ci].Get(row))</div>
                            }
                            break;

                        case CellRenderMode.Component:
                            @for (var c = 0; c < VisibleCols; c++)
                            {
                                var ci = c;
                                <BenchCell Value="_cols[ci].Get(row)" State="Meta(row, ci)" />
                            }
                            break;
                    }
                </div>
                }
            }
            @if (_selPaint == SelPaint.Overlay)
            {
                <div class="sel-overlay" style="@OverlayStyle()"></div>
            }
        </div>
    </div>
</div>

@code {
    private const int TotalRows = 5000;
    private const int MaxCols = 80;
    private const int RowHeight = 24;
    private const int CellWidth = 90;
    private const int KeyColWidth = 90;

    private int VisibleRows = 40;
    private int VisibleCols = 20;
    private int Step = 50;
    private int Iterations = 200;

    private Row[] _rows = [];
    private Row[] _rowsPristine = [];
    private Col[] _cols = [];
    private Dictionary<(int Book, int Col), CellState> _meta = new();

    private CellRenderMode _mode = CellRenderMode.Direct;
    private int _startRow;
    private bool _running;
    private string? _error;
    private bool _posting;
    private string _postLabel = "Save results to the server";

    private readonly List<RunResult> _runs = [];
    private Stats? _manualStats;
    private TaskCompletionSource? _renderTcs;
    private ElementReference _scrollerEl;
    private Dictionary<string, object> _env = new();
    // Cached: BenchRow only skips re-rendering if every parameter compares equal,
    // and a method group creates a NEW delegate instance on each render.
    private Func<Row, int, CellState>? _metaFn;
    private Func<object, CellTone>? _toneFn;

    // Selection benchmark: a rectangle that slides down the grid one row per
    // iteration, imitating a drag-select. Scroll position is held fixed so the
    // ONLY thing changing is the selection.
    private SelPaint _selPaint = SelPaint.None;
    private int _selR0, _selR1 = 9;          // 10 rows tall
    private const int SelC0 = 2, SelC1 = 9;  // 8 columns wide

    protected override void OnInitialized()
    {
        _metaFn = Meta;
        _toneFn = Sign;
        var rnd = new Random(42);
        _rows = new Row[TotalRows];
        for (var i = 0; i < TotalRows; i++)
        {
            var values = new decimal[MaxCols];
            for (var c = 0; c < MaxCols; c++)
                values[c] = (decimal)((rnd.NextDouble() - 0.5) * 2_000_000);

            _rows[i] = new Row
            {
                Id = i,
                BookId = i % 120,
                Book = $"BK{i % 120:D3}",
                Typology = Typologies[i % Typologies.Length],
                Values = values,
            };
        }

        _rowsPristine = (Row[])_rows.Clone();

        _cols = new Col[MaxCols];
        for (var c = 0; c < MaxCols; c++)
        {
            var ci = c;
            _cols[c] = new Col { Header = $"M{ci}", Get = row => row.Values[ci] };
        }

        // Realistically shaped metadata: it varies by (group, metric), so ~15% of
        // (book, metric) pairs are stale. Looked up, never stored per cell.
        for (var b = 0; b < 120; b++)
            for (var c = 0; c < MaxCols; c++)
                if (rnd.NextDouble() < 0.15)
                    _meta[(b, c)] = CellState.Stale;
    }

    private static readonly string[] Typologies = ["SWPX", "SWPI", "SWPB", "FEXP", "OISW", "CAPF"];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var tcs = _renderTcs;
        _renderTcs = null;
        tcs?.TrySetResult();

        if (firstRender)
        {
            try { _env = await JS.InvokeAsync<Dictionary<string, object>>("bench.env"); }
            catch { /* spike: environment capture is best-effort */ }
        }
    }

    private static string Fmt(object v) => CellFormat.Value(v);

    private CellState Meta(Row row, int col) =>
        _meta.TryGetValue((row.BookId, col), out var s) ? s : CellState.Normal;

    private static string StateClass(CellState s) => CellFormat.Class(s);

    // The tone rule as a Consumer would write it: one unbox and one comparison.
    private static CellTone Sign(object v) => v is decimal d ? d < 0 ? CellTone.Negative : d > 0 ? CellTone.Positive : CellTone.None : CellTone.None;

    private static string ModeNote(string mode) => mode switch
    {
        nameof(CellRenderMode.Direct) => "the floor, no abstraction",
        nameof(CellRenderMode.Accessor) => "+ per-column accessor (boxes every decimal)",
        nameof(CellRenderMode.AccessorMeta) => "+ per-cell metadata lookup",
        "Sel:PerCellClass" => "selection painted with per-cell CSS classes (defeats row memoisation)",
        "Sel:Overlay" => "selection painted with one absolutely positioned overlay (rows never repaint)",
        nameof(CellRenderMode.RowComponent) => "boundary at the row (row = component, cells = plain markup)",
        nameof(CellRenderMode.RowComponentTone) => "+ a per-cell tone rule on the row boundary (ADR-0006)",
        nameof(CellRenderMode.Component) => "+ every cell a Blazor component",
        _ => "",
    };

    private enum SelPaint { None, PerCellClass, Overlay }

    // Per-cell-class painting: the row must be TOLD which of its cells are selected.
    private int RowSelFrom(int absRow) =>
        _selPaint == SelPaint.PerCellClass && absRow >= _selR0 && absRow <= _selR1 ? SelC0 : -1;

    private int RowSelTo(int absRow) =>
        _selPaint == SelPaint.PerCellClass && absRow >= _selR0 && absRow <= _selR1 ? SelC1 : -1;

    // Overlay painting: pure geometry. The rows are never told anything.
    private string OverlayStyle()
    {
        var top = (_selR0 - _startRow) * RowHeight;
        var height = (_selR1 - _selR0 + 1) * RowHeight;
        var left = KeyColWidth + SelC0 * CellWidth;
        var width = (SelC1 - SelC0 + 1) * CellWidth;
        return $"transform: translate({left}px, {top}px); width:{width}px; height:{height}px;";
    }

    private async Task RunSelectionAsync()
    {
        try
        {
            _running = true;
            _error = null;
            _runs.Clear();
            _mode = CellRenderMode.RowComponent;   // the design we settled on
            StateHasChanged();
            await Task.Delay(100);

            foreach (var paint in new[] { SelPaint.PerCellClass, SelPaint.Overlay })
            {
                _selPaint = paint;
                _startRow = 0;

                for (var w = 0; w < 5; w++) { _selR0 = w; _selR1 = w + 9; await RenderOnceAsync(); }
                await Task.Delay(100);

                var samples = new List<double>(Iterations);
                for (var i = 0; i < Iterations; i++)
                {
                    var t0 = Stopwatch.GetTimestamp();
                    // Scroll is FIXED. Only the selection rectangle moves.
                    _selR0 = i % Math.Max(1, VisibleRows - 10);
                    _selR1 = _selR0 + 9;
                    await RenderOnceAsync();
                    samples.Add((Stopwatch.GetTimestamp() - t0) * 1000.0 / Stopwatch.Frequency);
                    await Task.Delay(1);
                }

                _runs.Add(new RunResult
                {
                    Mode = paint == SelPaint.PerCellClass ? "Sel:PerCellClass" : "Sel:Overlay",
                    VisibleRows = VisibleRows,
                    VisibleCols = VisibleCols,
                    Cells = VisibleRows * VisibleCols,
                    Step = 0,
                    Render = Stats.From(samples),
                });
                StateHasChanged();
                await Task.Delay(150);
            }

            _selPaint = SelPaint.None;
        }
        catch (Exception ex) { _error = ex.ToString(); }
        finally { _running = false; StateHasChanged(); }
    }

    // ---- Overflow paint: per-frame cost (docs/research/css-decided-overflow.md) ----------
    //
    // The render ladder above stops the clock at the DOM update, which is exactly the part
    // a CSS-decided #### does not touch: its cost, if any, is in the browser's style,
    // layout and animation update. So this loop is driven from requestAnimationFrame in JS
    // and calls into .NET synchronously once per frame; JS times the call (.NET) and the
    // rest of the frame (Browser) separately.
    private const int FrameCount = 600;
    private OverflowPaint _overflow = OverflowPaint.None;
    private readonly List<FrameRun> _frameRuns = [];
    private DotNetObjectReference<RenderBench>? _selfRef;
    private Random _churnRnd = new(7);

    private async Task RunFramesAsync()
    {
        try
        {
            _running = true;
            _error = null;
            _frameRuns.Clear();
            _postLabel = "Save results to the server";
            _mode = CellRenderMode.RowComponent;   // the design we settled on
            _selfRef ??= DotNetObjectReference.Create(this);
            StateHasChanged();
            await Task.Delay(100);

            // ?overflow=Css,CSharp and ?scenario=Idle,ScrollSlow narrow the run, so each
            // mode can be measured on a page that has run nothing else.
            var query = new Uri(Nav.Uri).Query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries)
                .Select(kv => kv.Split('=', 2)).Where(kv => kv.Length == 2)
                .ToDictionary(kv => kv[0], kv => Uri.UnescapeDataString(kv[1]).Split(','));
            T[] Pick<T>(string key) where T : struct, Enum =>
                query.TryGetValue(key, out var names) ? names.Select(Enum.Parse<T>).ToArray() : Enum.GetValues<T>();

            foreach (var overflow in Pick<OverflowPaint>("overflow"))
            {
                foreach (var scenario in Pick<FrameScenario>("scenario"))
                {
                    _overflow = overflow;
                    _rows = (Row[])_rowsPristine.Clone();
                    _startRow = 0;
                    _churnRnd = new Random(7);
                    await RenderOnceAsync();
                    // Collect what earlier runs left behind (cells that came and went),
                    // where the browser exposes gc — see the accumulation experiment in
                    // docs/research/css-decided-overflow.md.
                    var gc = await JS.InvokeAsync<bool>("bench.gc");
                    await Task.Delay(200);

                    // Warm-up frames: JIT, first animation and timeline creation.
                    await JS.InvokeAsync<FrameSamples>("bench.frameLoop", _selfRef, (int)scenario, 60);
                    var f = await JS.InvokeAsync<FrameSamples>("bench.frameLoop", _selfRef, (int)scenario, FrameCount);

                    var total = f.Net.Zip(f.Browser, (a, b) => a + b).ToArray();
                    var changedTotals = total.Where((_, i) => f.Changed[i]).ToArray();
                    _frameRuns.Add(new FrameRun
                    {
                        Overflow = overflow.ToString(),
                        Scenario = scenario.ToString(),
                        Frames = total.Length,
                        Cells = VisibleRows * VisibleCols,
                        Net = Stats.From(f.Net),
                        Browser = Stats.From(f.Browser),
                        Total = Stats.From(total),
                        Interval = Stats.From(f.Interval),
                        ChangedFramesTotal = changedTotals.Length > 0 && changedTotals.Length < total.Length ? Stats.From(changedTotals) : null,
                        Animations = f.Animations,
                        HashedCells = f.Hashed,
                        GcBeforeRun = gc,
                    });
                    StateHasChanged();
                    await Task.Delay(150);
                }
            }
            // ?hold leaves the last mode on screen, so what the run left behind can be
            // measured from outside (the GC check in docs/research/css-decided-overflow.md).
            if (!query.ContainsKey("hold"))
            {
                _overflow = OverflowPaint.None;
                _rows = (Row[])_rowsPristine.Clone();
            }
        }
        catch (Exception ex) { _error = ex.ToString(); }
        finally { _running = false; StateHasChanged(); }
    }

    public sealed class FrameSamples
    {
        public double[] Net { get; set; } = [];
        public double[] Browser { get; set; } = [];
        public double[] Interval { get; set; } = [];
        public bool[] Changed { get; set; } = [];
        public int Animations { get; set; }
        public int Hashed { get; set; }
    }

    /// <summary>Called synchronously from the rAF loop, once per frame. Returns whether
    /// anything changed — an unchanged frame renders nothing in .NET, as in the grid.</summary>
    [JSInvokable]
    public bool FrameStep(int scenario, int frame)
    {
        var changed = (FrameScenario)scenario switch
        {
            FrameScenario.Idle => false,
            FrameScenario.ScrollSlow => Scroll(1),
            FrameScenario.ScrollFling => Scroll(50),
            FrameScenario.ChurnBurst => frame % 60 == 0 && Churn(300),
            FrameScenario.ChurnTrickle => Churn(5),
            _ => false,
        };
        if (changed) StateHasChanged();
        return changed;
    }

    private bool Scroll(int rows)
    {
        _startRow = (_startRow + rows) % (TotalRows - VisibleRows);
        return true;
    }

    // A live feed: new values for random visible cells. A changed row is handed over as a
    // NEW instance (identity is the change signal, ADR-0003), so its element is kept and
    // its cells' text rewritten in place — the path a recycled cell takes.
    private bool Churn(int cells)
    {
        var cloned = new Dictionary<int, Row>();
        for (var k = 0; k < cells; k++)
        {
            var abs = (_startRow + _churnRnd.Next(VisibleRows)) % TotalRows;
            var c = _churnRnd.Next(VisibleCols);
            if (!cloned.TryGetValue(abs, out var row))
            {
                var old = _rows[abs];
                row = new Row { Id = old.Id, BookId = old.BookId, Book = old.Book, Typology = old.Typology, Values = (decimal[])old.Values.Clone() };
                cloned[abs] = row;
                _rows[abs] = row;
            }
            row.Values[c] = (decimal)((_churnRnd.NextDouble() - 0.5) * 2_000_000);
        }
        return true;
    }

    private void Preset(int rows, int cols, int step)
    {
        VisibleRows = rows; VisibleCols = cols; Step = step;
    }

    private Task RenderOnceAsync()
    {
        // StateHasChanged() can drive the render — and therefore OnAfterRenderAsync,
        // which nulls _renderTcs — synchronously, before this method returns. Reading
        // the field afterwards then NREs. Hold the TCS in a local.
        var tcs = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
        _renderTcs = tcs;
        StateHasChanged();
        return tcs.Task;
    }

    private async Task RunAllAsync()
    {
        try
        {
            await RunAllCoreAsync();
        }
        catch (Exception ex)
        {
            _error = ex.ToString();
        }
        finally
        {
            _running = false;
            StateHasChanged();
        }
    }

    private async Task RunAllCoreAsync()
    {
        _running = true;
        _error = null;
        _runs.Clear();
        _postLabel = "Save results to the server";
        StateHasChanged();
        await Task.Delay(100);

        foreach (var mode in Enum.GetValues<CellRenderMode>())
        {
            _mode = mode;

            // Warm up: first render of a mode pays JIT and initial DOM construction.
            for (var w = 0; w < 5; w++)
            {
                _startRow = (_startRow + Step) % (TotalRows - VisibleRows);
                await RenderOnceAsync();
            }
            await Task.Delay(100);

            var samples = new List<double>(Iterations);
            for (var i = 0; i < Iterations; i++)
            {
                var t0 = Stopwatch.GetTimestamp();
                _startRow = (_startRow + Step) % (TotalRows - VisibleRows);
                await RenderOnceAsync();
                samples.Add((Stopwatch.GetTimestamp() - t0) * 1000.0 / Stopwatch.Frequency);

                // The render above can complete synchronously, so nothing would ever
                // hand control back to the browser. Yield outside the timed region so
                // each iteration starts from a laid-out page rather than accumulating
                // unflushed DOM mutations.
                await Task.Delay(1);
            }

            _runs.Add(new RunResult
            {
                Mode = mode.ToString(),
                VisibleRows = VisibleRows,
                VisibleCols = VisibleCols,
                Cells = VisibleRows * VisibleCols,
                Step = Step,
                Render = Stats.From(samples),
            });

            StateHasChanged();
            await Task.Delay(150);
        }

        _running = false;
        StateHasChanged();
    }

    private async Task OnScrollAsync()
    {
        try
        {
            var top = await JS.InvokeAsync<double>("bench.scrollTop", _scrollerEl);
            var start = Math.Clamp((int)(top / RowHeight), 0, TotalRows - VisibleRows);
            if (start != _startRow) _startRow = start;
        }
        catch { /* spike */ }
    }

    private async Task StartFpsAsync()
    {
        _manualStats = null;
        await JS.InvokeVoidAsync("bench.startFps");
    }

    private async Task StopFpsAsync()
    {
        var frames = await JS.InvokeAsync<double[]>("bench.stopFps");
        _manualStats = frames is { Length: > 0 } ? Stats.From(frames) : null;
    }

    private async Task PostResultsAsync()
    {
        _posting = true;
        try
        {
            var report = new Report
            {
                TimestampLocal = DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss"),
                Environment = _env,
                Runs = _runs,
                ManualScrollFrames = _manualStats,
                FrameRuns = _frameRuns.Count > 0 ? _frameRuns : null,
                Note = "cell-grid render spike: cost of the API shape, not of row count.",
            };
            var res = await Http.PostAsJsonAsync("api/results", report);
            _postLabel = res.IsSuccessStatusCode ? "saved ✓" : $"failed ({(int)res.StatusCode})";
        }
        catch (Exception ex)
        {
            _postLabel = $"failed: {ex.Message}";
        }
        finally
        {
            _posting = false;
        }
    }
}
