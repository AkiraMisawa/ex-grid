<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- A disposable proof of concept: an exposure profile grid whose selection is drawn as a
       chart and exported as CSV. It answers "what would charting look like" before any ADR is
       written; nothing here is a decision. This is its Blazor Server host; ExposureChart.Wasm is its
       WebAssembly host, and ExposureChart.Pages holds what both serve. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ExposureChart.Server</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ExposureChart.Pages\ExposureChart.Pages.csproj" />
  </ItemGroup>

</Project>
