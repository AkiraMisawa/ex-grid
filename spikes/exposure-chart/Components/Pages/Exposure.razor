@page "/"
@using System.Globalization

<PageTitle>Exposure chart PoC</PageTitle>

<h1>Exposure profile — chart a selection</h1>
<p class="hint">
    Select <b>Date</b> and the figures to plot (drag, Shift+click, or Ctrl+click headers — header clicks select
    whole columns), then right-click → <b>Chart selection</b>, or the button. A single selected cell charts the
    whole table, as Excel does.
</p>

<ExGrid TRow="ExposureRow" Source="_source" Columns="_columns" HeaderGroups="_groups" PinnedColumnCount="1"
        HeaderClickSelects="true" SelectionChanged="OnSelectionChanged"
        ContextCommands="_contextCommands" CommandLabel="_commandLabel"
        ViewportHeight="230" ViewportWidth="ViewportSize.Stretch" />

<div class="toolbar">
    <button type="button" @onclick="ChartCurrentSelection">Chart selection</button>
    <span class="selected">@(_selection.IsEmpty ? "Nothing selected" : $"{_selection.Ranges.Count} range(s), {_selection.CellCount:N0} cells")</span>
    <label><input type="radio" name="layout" checked="@(_layout == ChartLayout.PanelPerGroup)"
                  @onchange="() => SetLayout(ChartLayout.PanelPerGroup)" /> Panel per group</label>
    <label><input type="radio" name="layout" checked="@(_layout == ChartLayout.OneAxis)"
                  @onchange="() => SetLayout(ChartLayout.OneAxis)" /> One axis (Excel's default)</label>
    <span class="sep"></span>
    <button type="button" @onclick="Recalculate">Recalculate: hedge ×@((_hedge + 0.5).ToString("0.0", CultureInfo.InvariantCulture))</button>
</div>

@if (_refusal is not null)
{
    <p class="refusal" role="alert">@_refusal</p>
}

@if (_model is { } model)
{
    <section class="chart">
        <div class="chart-head">
            <span class="definition">
                x: <b>@_definition!.XColumn</b> · @_definition.SeriesColumns.Count series · @_definition.RowKeys.Count dates
                @if (model.Missing > 0)
                {
                    <span class="refusal"> — @model.Missing of them no longer in the data</span>
                }
            </span>
            <button type="button" class="filter-toggle @(_filterOpen ? "open" : "")" aria-expanded="@(_filterOpen ? "true" : "false")"
                    @onclick="() => _filterOpen = !_filterOpen">Filter @(FilterSummary(model)) ▾</button>
            <a class="download" href="@ChartCsv.DataUrl(_csv!, "text/csv")" download="exposure-profile.csv">Download CSV</a>
            <a class="download" href="@ChartCsv.DataUrl(_svg!, "image/svg+xml")" download="exposure-profile.svg">Download SVG</a>
            <button type="button" @onclick="CloseChart">Close</button>
        </div>
        @if (_filterOpen)
        {
            <div class="chart-filter" role="group" aria-label="Chart filter">
                <div class="filter-section">
                    <div class="filter-heading">
                        <span>Series</span>
                        <span class="leaf-toggles">
                            @foreach (var leaf in model.Leaves)
                            {
                                var on = model.AllSeries.Where(s => s.Leaf == leaf).All(s => !_view.HiddenSeries.Contains(s.Column));
                                <button type="button" class="chip @(on ? "on" : "")" aria-pressed="@(on ? "true" : "false")"
                                        @onclick="() => ShowLeaf(leaf, !on)">@leaf</button>
                            }
                        </span>
                    </div>
                    @foreach (var group in model.AllSeries.GroupBy(s => s.Group))
                    {
                        var all = group.All(s => !_view.HiddenSeries.Contains(s.Column));
                        <div class="filter-row">
                            <label class="group-label">
                                <input type="checkbox" checked="@all" @onchange="() => ShowColumns(group.Select(s => s.Column), !all)" />
                                @(group.Key.Length == 0 ? "(no group)" : group.Key)
                            </label>
                            @foreach (var series in group)
                            {
                                var shown = !_view.HiddenSeries.Contains(series.Column);
                                <label class="series-label">
                                    <input type="checkbox" checked="@shown" @onchange="() => ShowColumns([series.Column], !shown)" />
                                    <span class="swatch ex-chart-swatch-@(series.Slot % 5)"></span>@series.Leaf
                                </label>
                            }
                        </div>
                    }
                </div>
                <div class="filter-section">
                    <div class="filter-heading"><span>Dates</span></div>
                    <div class="filter-row">
                        <label>From
                            <select value="@Key(_view.From ?? model.AllDates[0])" @onchange="e => SetRange(Parse(e.Value), _view.To)">
                                @foreach (var d in model.AllDates)
                                {
                                    <option value="@Key(d)">@Key(d)</option>
                                }
                            </select>
                        </label>
                        <label>To
                            <select value="@Key(_view.To ?? model.AllDates[^1])" @onchange="e => SetRange(_view.From, Parse(e.Value))">
                                @foreach (var d in model.AllDates)
                                {
                                    <option value="@Key(d)">@Key(d)</option>
                                }
                            </select>
                        </label>
                        @foreach (var (label, years) in Presets)
                        {
                            <button type="button" class="chip" @onclick="() => SetHorizon(model, years)">@label</button>
                        }
                    </div>
                </div>
                <p class="filter-note">The CSV holds what the chart shows.</p>
            </div>
        }
        <div class="chart-body">@((MarkupString)_svg!)</div>
    </section>
}

@code {
    private const string ChartCommand = "chart-selection";
    private static readonly CultureInfo Invariant = CultureInfo.InvariantCulture;

    private static Func<object, string> Money => v => ((decimal)v).ToString("#,##0.00;-#,##0.00", Invariant);

    private static readonly GridColumn<ExposureRow>[] AllColumns =
    [
        new("Date", ColumnType.Date, r => r.Date, dateType: DateType.DateOnly),
        new("EpeBefore", ColumnType.Number, r => r.EpeBefore, header: "Before", format: Money),
        new("EpeAfter", ColumnType.Number, r => r.EpeAfter, header: "After", format: Money),
        new("EpeDiff", ColumnType.Number, r => r.EpeDiff, header: "Diff", format: Money),
        new("EneBefore", ColumnType.Number, r => r.EneBefore, header: "Before", format: Money),
        new("EneAfter", ColumnType.Number, r => r.EneAfter, header: "After", format: Money),
        new("EneDiff", ColumnType.Number, r => r.EneDiff, header: "Diff", format: Money),
        new("CvaBefore", ColumnType.Number, r => r.CvaBefore, header: "Before", format: Money),
        new("CvaAfter", ColumnType.Number, r => r.CvaAfter, header: "After", format: Money),
        new("CvaDiff", ColumnType.Number, r => r.CvaDiff, header: "Diff", format: Money),
    ];

    private static readonly HeaderGroup[] Groups =
    [
        new("EPE(0)", ["EpeBefore", "EpeAfter", "EpeDiff"]),
        new("ENE(0)", ["EneBefore", "EneAfter", "EneDiff"]),
        new("CVA", ["CvaBefore", "CvaAfter", "CvaDiff"]),
    ];

    // Which columns are a change rather than a level: the Consumer says so, the chart does not
    // read it off the word "Diff".
    private static bool IsChange(string column) => column.EndsWith("Diff", StringComparison.Ordinal);

    private IReadOnlyList<ExposureRow> _rows = ExposureData.Profile();
    private InMemoryGridSource<ExposureRow> _source = null!;
    private readonly IReadOnlyList<GridColumn<ExposureRow>> _columns = AllColumns;
    private readonly IReadOnlyList<HeaderGroup> _groups = Groups;

    // Delegates handed to the grid are created once (CLAUDE.md: a method group is a new
    // instance per render).
    private Func<ContextMenuContext<ExposureRow>, IEnumerable<GridCommand>> _contextCommands = null!;
    private readonly Func<string, string?> _commandLabel = id => id == ChartCommand ? "Chart selection" : null;

    private GridSelection _selection = GridSelection.Empty;
    private int _selectionVersion;
    private double _hedge = 1.0;
    private ChartLayout _layout = ChartLayout.PanelPerGroup;

    private ChartView _view = ChartView.All;
    private bool _filterOpen;
    private static readonly (string Label, int? Years)[] Presets = [("1Y", 1), ("5Y", 5), ("10Y", 10), ("All", null)];

    private ChartDefinition? _definition;
    private ChartModel? _model;
    private string? _svg, _csv, _refusal;

    protected override void OnInitialized()
    {
        _source = GridSource.From(_rows, r => r.Date);
        _contextCommands = context =>
        [
            new GridCommand(ChartCommand, context.Selection.Count > 0, () =>
            {
                Chart(context.Selection, context.RowSequenceVersion);
                InvokeAsync(StateHasChanged);
                return Task.CompletedTask;
            }),
        ];
    }

    private void OnSelectionChanged(GridSelection selection)
    {
        _selection = selection;
        _selectionVersion = _source.RowSequenceVersion;
    }

    private void ChartCurrentSelection() => Chart(_selection.Ranges, _selectionVersion);

    private void Chart(IReadOnlyList<SelectionRange> ranges, int version)
    {
        var outcome = ChartRequest.FromSelection(ranges, version, _source.RowSequenceVersion, _columns, _source.Window);
        _refusal = outcome.Refusal;
        if (outcome.Definition is { } definition)
        {
            _definition = definition;
            _view = ChartView.All;
            Redraw();
        }
    }

    private void SetLayout(ChartLayout layout)
    {
        _layout = layout;
        Redraw();
    }

    // The data changed; the chart is defined in the data's terms, so it is simply drawn again.
    private void Recalculate()
    {
        _hedge += 0.5;
        _rows = ExposureData.Profile(_hedge);
        _source.ReplaceAll(_rows);
        Redraw();
    }

    private void Redraw()
    {
        if (_definition is null) return;
        _model = ChartModelBuilder.Build(_definition, _columns, _groups, _rows, IsChange, _layout, _view);
        _svg = ChartSvg.Write(_model);
        _csv = ChartCsv.Write(_model);
    }

    private void ShowColumns(IEnumerable<string> columns, bool show)
    {
        var hidden = new HashSet<string>(_view.HiddenSeries);
        foreach (var c in columns)
            if (show) hidden.Remove(c); else hidden.Add(c);
        _view = _view with { HiddenSeries = hidden };
        Redraw();
    }

    private void ShowLeaf(string leaf, bool show) =>
        ShowColumns(_model!.AllSeries.Where(s => s.Leaf == leaf).Select(s => s.Column), show);

    private void SetRange(DateOnly? from, DateOnly? to)
    {
        // A range turned inside out is put the right way round rather than drawn empty.
        if (from is { } f && to is { } t && f > t) (from, to) = (t, f);
        _view = _view with { From = from, To = to };
        Redraw();
    }

    private void SetHorizon(ChartModel model, int? years) =>
        SetRange(null, years is { } y ? model.AllDates[0].AddYears(y) : null);

    private static string FilterSummary(ChartModel model)
    {
        var shown = model.Panels.Sum(p => p.Series.Count);
        var dates = model.Dates.Count;
        return shown == model.AllSeries.Count && dates == model.AllDates.Count
            ? ""
            : $"({shown}/{model.AllSeries.Count} series, {dates}/{model.AllDates.Count} dates)";
    }

    private static string Key(DateOnly d) => d.ToString("yyyy-MM-dd", Invariant);
    private static DateOnly? Parse(object? value) =>
        DateOnly.TryParseExact(value as string, "yyyy-MM-dd", Invariant, DateTimeStyles.None, out var d) ? d : null;

    private void CloseChart() => (_definition, _model, _svg, _csv, _filterOpen) = (null, null, null, null, false);

}
