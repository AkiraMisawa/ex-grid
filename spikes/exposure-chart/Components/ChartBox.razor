@typeparam TRow
@using System.Globalization
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

@* A chart of a grid's data: drawn, filtered, styled, extended and exported here, shown by a page
   that owns the grid and asks for it with Show. The same for every page that charts. *@

@if (_refusal is not null)
{
    <p class="refusal" role="alert">@_refusal</p>
}
@if (_notice is not null)
{
    <p class="notice" role="status">@_notice</p>
}

@if (_model is { } model)
{
    <section class="chart">
        <div class="chart-head">
            <span class="definition">
                @_definition!.Describe()
                @if (model.Missing > 0)
                {
                    <span class="refusal"> — @model.Missing of them no longer in the data</span>
                }
            </span>
            <select class="layout" aria-label="Layout" value="@_layout" @onchange="e => SetLayout(Enum.Parse<ChartLayout>((string)e.Value!))">
                <option value="@ChartLayout.PanelPerGroup">Panel per group</option>
                <option value="@ChartLayout.OnePanel">One panel, two axes</option>
                <option value="@ChartLayout.OneAxis">One axis (Excel's default)</option>
            </select>
            <button type="button" class="add-toggle @(_pickerOpen ? "open" : "")" aria-expanded="@(_pickerOpen ? "true" : "false")"
                    @onclick="() => _pickerOpen = !_pickerOpen">+ Add series</button>
            <button type="button" class="filter-toggle @(_filterOpen ? "open" : "")" aria-expanded="@(_filterOpen ? "true" : "false")"
                    @onclick="() => _filterOpen = !_filterOpen">Filter @(FilterSummary(model)) ▾</button>
            <a class="download" href="@ChartCsv.DataUrl(_csv!, "text/csv")" download="@($"{FileName}.csv")">Download CSV</a>
            <a class="download" href="@ChartCsv.DataUrl(_csvLong!, "text/csv")" download="@($"{FileName}-long.csv")" title="One row per point: Series, Date, Value">CSV (long)</a>
            <a class="download" href="@ChartCsv.DataUrl(_svg!, "image/svg+xml")" download="@($"{FileName}.svg")">Download SVG</a>
            <button type="button" @onclick="CloseChart">Close</button>
        </div>
        @if (_pickerOpen)
        {
            // A list of columns adds series in columns; series in rows come from the grid's selection.
            var addable = _definition is ChartDefinition columnChart
                ? Columns.Where(c => c.Type == ColumnType.Number && !columnChart.SeriesColumns.Contains(c.Name)).ToList()
                : [];
            <div class="chart-filter" role="group" aria-label="Add series">
                <div class="filter-section">
                    <div class="filter-heading"><span>Add series</span></div>
                    @if (_definition is RowChartDefinition)
                    {
                        <p class="filter-note">Each curve is a row: select rows in the grid and add them.</p>
                    }
                    else if (addable.Count == 0)
                    {
                        <p class="filter-note">Every number column is in the chart.</p>
                    }
                    @foreach (var group in addable.GroupBy(c => GroupLabelOf(c.Name)))
                    {
                        var all = group.All(c => _picked.Contains(c.Name));
                        <div class="filter-row">
                            <label class="group-label">
                                <input type="checkbox" checked="@all" @onchange="() => Pick(group.Select(c => c.Name), !all)" />
                                @(group.Key.Length == 0 ? "(no group)" : group.Key)
                            </label>
                            @foreach (var column in group)
                            {
                                var on = _picked.Contains(column.Name);
                                <label class="series-label">
                                    <input type="checkbox" checked="@on" @onchange="() => Pick([column.Name], !on)" />
                                    @column.Header
                                </label>
                            }
                        </div>
                    }
                    <div class="filter-row">
                        <button type="button" disabled="@(_picked.Count == 0)" @onclick="AddPicked">Add @(_picked.Count == 0 ? "" : $"{_picked.Count} series")</button>
                        <span class="sep-text">or</span>
                        <button type="button" @onclick="AddSelection">Add the grid's selection</button>
                        <span class="filter-note">@SelectionDescription()</span>
                    </div>
                </div>
            </div>
        }
        @if (_filterOpen)
        {
            <div class="chart-filter" role="group" aria-label="Chart filter">
                <div class="filter-section">
                    <div class="filter-heading">
                        <span>Series</span>
                        <span class="leaf-toggles">
                            @foreach (var leaf in model.Leaves)
                            {
                                var on = model.AllSeries.Where(s => s.Leaf == leaf).All(s => !_view.HiddenSeries.Contains(s.Id));
                                <button type="button" class="chip @(on ? "on" : "")" aria-pressed="@(on ? "true" : "false")"
                                        @onclick="() => ShowLeaf(leaf, !on)">@leaf</button>
                            }
                        </span>
                    </div>
                    @foreach (var group in model.AllSeries.GroupBy(s => s.Group))
                    {
                        var all = group.All(s => !_view.HiddenSeries.Contains(s.Id));
                        <div class="filter-row">
                            <label class="group-label">
                                <input type="checkbox" checked="@all" @onchange="() => ShowColumns(group.Select(s => s.Id), !all)" />
                                @(group.Key.Length == 0 ? "(no group)" : group.Key)
                            </label>
                            @foreach (var series in group)
                            {
                                var shown = !_view.HiddenSeries.Contains(series.Id);
                                <label class="series-label">
                                    <input type="checkbox" checked="@shown" @onchange="() => ShowColumns([series.Id], !shown)" />
                                    <span class="swatch ex-chart-swatch-@(series.Slot % 8)"></span>@series.Leaf
                                </label>
                            }
                        </div>
                    }
                </div>
                <div class="filter-section">
                    <div class="filter-heading"><span>Style</span></div>
                    @foreach (var group in model.AllSeries.Select(s => s.Group).Distinct())
                    {
                        var style = StyleOfGroup(group);
                        <div class="filter-row">
                            <span class="group-label">@(group.Length == 0 ? "(no group)" : group)</span>
                            <label>Draw
                                <select value="@style.Draw" @onchange="e => SetStyle(group, s => s with { Draw = Enum.Parse<SeriesDraw>((string)e.Value!) })">
                                    @foreach (var (draw, label) in DrawLabels)
                                    {
                                        <option value="@draw">@label</option>
                                    }
                                </select>
                            </label>
                            <label>Marker
                                <select value="@style.Marker" @onchange="e => SetStyle(group, s => s with { Marker = Enum.Parse<MarkerShape>((string)e.Value!) })">
                                    @foreach (var (shape, label) in MarkerLabels)
                                    {
                                        <option value="@shape">@label</option>
                                    }
                                </select>
                            </label>
                        </div>
                    }
                </div>
                <div class="filter-section">
                    <div class="filter-heading"><span>Legend</span></div>
                    <div class="filter-row">
                        <label>Position
                            <select value="@_legend.Position" @onchange="e => SetLegend(l => l with { Position = Enum.Parse<LegendPosition>((string)e.Value!) })">
                                <option value="@LegendPosition.Top">Top</option>
                                <option value="@LegendPosition.Right">Right</option>
                                <option value="@LegendPosition.Bottom">Bottom</option>
                                <option value="@LegendPosition.None">None</option>
                            </select>
                        </label>
                        <label>Layout
                            <select value="@_legend.Layout" @onchange="e => SetLegend(l => l with { Layout = Enum.Parse<LegendLayout>((string)e.Value!) })">
                                <option value="@LegendLayout.Auto">Auto</option>
                                <option value="@LegendLayout.List">A list, one entry per series</option>
                                <option value="@LegendLayout.Table">A table: colour by row, drawing by column</option>
                            </select>
                        </label>
                    </div>
                </div>
                <div class="filter-section">
                    <div class="filter-heading"><span>Horizontal axis</span></div>
                    <div class="filter-row">
                        <label>Ticks
                            <select value="@_xAxis.Ticks" @onchange="e => SetAxis(a => a with { Ticks = Enum.Parse<XTicks>((string)e.Value!) })">
                                <option value="@XTicks.Calendar">Calendar</option>
                                <option value="@XTicks.DataDates">Every date in the data</option>
                                <option value="@XTicks.Tenors">Tenors (1M, 3M, 1Y …)</option>
                            </select>
                        </label>
                        <label>Labels
                            <select value="@_xAxis.Label" @onchange="e => SetAxis(a => a with { Label = Enum.Parse<XLabel>((string)e.Value!) })">
                                <option value="@XLabel.Auto">Auto</option>
                                <option value="@XLabel.Year">yyyy</option>
                                <option value="@XLabel.YearMonth">yyyy-MM</option>
                                <option value="@XLabel.IsoDate">yyyy-MM-dd</option>
                                <option value="@XLabel.MonthNameYear">MMM yyyy</option>
                                <option value="@XLabel.Tenor">Tenor (6M, 2Y)</option>
                                @if (XLabelOf is not null)
                                {
                                    <option value="@XLabel.Column">@XLabelName</option>
                                }
                            </select>
                        </label>
                        <label>Angle
                            <select value="@_xAxis.Angle" @onchange="e => SetAxis(a => a with { Angle = int.Parse((string)e.Value!, Invariant) })">
                                <option value="0">0°</option>
                                <option value="45">45°</option>
                                <option value="90">90°</option>
                            </select>
                        </label>
                        @{ var ticks = ChartSvg.TicksOf(model); var labelled = ticks.Count(t => t.Label is not null); }
                        @if (labelled < ticks.Count)
                        {
                            <span class="filter-note">@labelled of @ticks.Count labels fit; every tick is still drawn.</span>
                        }
                    </div>
                </div>
                <div class="filter-section">
                    <div class="filter-heading"><span>Dates</span></div>
                    <div class="filter-row">
                        <label>From
                            <select value="@IndexOf(model, _view.From ?? model.AllXs[0])" @onchange="e => SetRange(At(model, e.Value), _view.To)">
                                @for (var i = 0; i < model.AllXs.Count; i++)
                                {
                                    <option value="@i">@model.Scale.Format(model.AllXs[i])</option>
                                }
                            </select>
                        </label>
                        <label>To
                            <select value="@IndexOf(model, _view.To ?? model.AllXs[^1])" @onchange="e => SetRange(_view.From, At(model, e.Value))">
                                @for (var i = 0; i < model.AllXs.Count; i++)
                                {
                                    <option value="@i">@model.Scale.Format(model.AllXs[i])</option>
                                }
                            </select>
                        </label>
                        @foreach (var (label, years) in Presets)
                        {
                            <button type="button" class="chip" @onclick="() => SetHorizon(model, years)">@label</button>
                        }
                    </div>
                </div>
                <p class="filter-note">The CSV holds what the chart shows.</p>
            </div>
        }
        <div class="chart-area legend-@(_legend.Position.ToString().ToLowerInvariant())">
        @if (_legend.Position != LegendPosition.None)
        {
            <div class="chart-legend" role="group" aria-label="Legend">
                @if (UseTable(model))
                {
                    var leaves = model.AllSeries.Select(s => s.Leaf).Distinct().ToList();
                    var groups = model.AllSeries.Select(s => s.Group).Distinct().ToList();
                    <table class="legend-table">
                        <thead>
                            <tr>
                                <th></th>
                                @foreach (var group in groups)
                                {
                                    var members = model.AllSeries.Where(s => s.Group == group).Select(s => s.Id).ToList();
                                    <th><button type="button" class="legend-head @(AllHidden(members) ? "off" : "")"
                                                title="Show or hide every series of @group" @onclick="() => Toggle(members)">@group</button></th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var leaf in leaves)
                            {
                                var members = model.AllSeries.Where(s => s.Leaf == leaf).Select(s => s.Id).ToList();
                                <tr>
                                    <th><button type="button" class="legend-head @(AllHidden(members) ? "off" : "")"
                                                title="Show or hide every series of @leaf" @onclick="() => Toggle(members)">@leaf</button></th>
                                    @foreach (var group in groups)
                                    {
                                        <td>
                                            @if (model.AllSeries.FirstOrDefault(s => s.Leaf == leaf && s.Group == group) is { } series)
                                            {
                                                var hidden = _view.HiddenSeries.Contains(series.Id);
                                                <button type="button" class="legend-cell @(hidden ? "off" : "")" aria-pressed="@(hidden ? "false" : "true")"
                                                        title="@series.Name" @onclick="() => Toggle([series.Id])">@((MarkupString)ChartSvg.Sample(series))</button>
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    var oneGroup = model.AllSeries.Select(s => s.Group).Distinct().Count() == 1;
                    @foreach (var series in model.AllSeries)
                    {
                        var hidden = _view.HiddenSeries.Contains(series.Id);
                        <button type="button" class="legend-entry @(hidden ? "off" : "")" aria-pressed="@(hidden ? "false" : "true")"
                                title="@(hidden ? "Show" : "Hide") @series.Name" @onclick="() => Toggle([series.Id])">
                            @((MarkupString)ChartSvg.Sample(series))<span>@(oneGroup ? series.Leaf : series.Name)</span>
                        </button>
                    }
                }
                <span class="legend-note">Click to hide or show.</span>
            </div>
        }
        <div class="chart-body" @ref="_chartBody">
            @((MarkupString)_pageSvg!)
            @if (_band is { } band && band < model.Xs.Count)
            {
                var anchor = ChartSvg.Anchor(model, band);
                <div class="chart-tip @(anchor.OnLeft ? "on-left" : "")" role="tooltip"
                     style="left: @Percent(anchor.X); top: @Percent(anchor.Top)">
                    <div class="tip-date">@model.Scale.Format(model.Xs[band])@(XLabelOf?.Invoke(model.Xs[band]) is { } tipLabel && tipLabel != model.Scale.Format(model.Xs[band]) ? $" ({tipLabel})" : "")</div>
                    @foreach (var panel in model.Panels)
                    {
                        @if (panel.Title.Length > 0)
                        {
                            <div class="tip-group">@panel.Title</div>
                        }
                        @foreach (var series in panel.Series)
                        {
                            <div class="tip-row">
                                <span class="swatch ex-chart-swatch-@(series.Slot % 8)"></span>
                                <span class="tip-name">@(panel.Title.Length > 0 ? series.Leaf : series.Name)</span>
                                @{ var point = series.At(model.Xs[band]); }
                                <span class="tip-value @(point is null ? "absent" : "")">@(point is null ? "—" : point.Value.Y is { } v ? series.Text(v) : "(no value)")</span>
                            </div>
                        }
                    }
                </div>
            }
        </div>
        </div>
    </section>
}

@code {
    private static readonly CultureInfo Invariant = CultureInfo.InvariantCulture;

    /// <summary>The grid's columns, in its order: what a series can be.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<GridColumn<TRow>> Columns { get; set; } = [];
    [Parameter] public IReadOnlyList<HeaderGroup> Groups { get; set; } = [];

    /// <summary>The Consumer's data, every row; a new list is new data, and the chart is drawn again.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<TRow> Rows { get; set; } = [];

    /// <summary>The rows as the grid shows them, which a selection's indices name.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<TRow> Window { get; set; } = [];
    [Parameter] public int RowSequenceVersion { get; set; }
    [Parameter] public GridSelection Selection { get; set; } = GridSelection.Empty;

    /// <summary>The Row Sequence Version the selection was taken under.</summary>
    [Parameter] public int SelectionVersion { get; set; }

    /// <summary>Which columns read against the right-hand axis: the Consumer's declaration.</summary>
    [Parameter] public Func<string, bool> OnRight { get; set; } = _ => false;

    /// <summary>A column's unit, for the axis it reads against: "bp", "%".</summary>
    [Parameter] public Func<string, string?>? UnitOf { get; set; }

    /// <summary>A column's colour slot, where the Consumer gives one; otherwise its leaf header's.</summary>
    [Parameter] public Func<string, int?>? SlotOf { get; set; }
    [Parameter] public IReadOnlyDictionary<string, SeriesStyle>? InitialStyles { get; set; }
    [Parameter] public ChartLayout InitialLayout { get; set; } = ChartLayout.PanelPerGroup;
    [Parameter] public XAxisStyle? InitialXAxis { get; set; }

    /// <summary>A label of the Consumer's for a date on the axis — a tenor column's text.</summary>
    [Parameter] public Func<double, string?>? XLabelOf { get; set; }

    /// <summary>The declarations for series in rows; given, a selection is read that way.</summary>
    [Parameter] public RowChartSpec<TRow>? RowSpec { get; set; }
    [Parameter] public string XLabelName { get; set; } = "From a column";
    [Parameter] public string FileName { get; set; } = "chart";

    /// <summary>A chart to show from the start, before anything is selected.</summary>
    [Parameter] public ChartSpec? InitialDefinition { get; set; }

    private ChartLayout _layout;
    private LegendStyle _legend = LegendStyle.Default;

    // The legend changes only what it is about, on the style as it is when the event is handled.
    private void SetLegend(Func<LegendStyle, LegendStyle> change) => _legend = change(_legend);

    /// <summary>
    /// A table when the series form a full grid — every leaf with every group, one series each, as a
    /// row's spreads and hazard rates do — so a colour is read once per row and a drawing once per
    /// column; a list otherwise.
    /// </summary>
    private bool UseTable(ChartModel model)
    {
        if (_legend.Layout != LegendLayout.Auto) return _legend.Layout == LegendLayout.Table;
        var leaves = model.AllSeries.Select(s => s.Leaf).Distinct().Count();
        var groups = model.AllSeries.Select(s => s.Group).Distinct().Count();
        // Every cell filled: a table with holes reads worse than the list it replaces.
        return leaves >= 2 && groups >= 2 && model.AllSeries.Select(s => (s.Leaf, s.Group)).Distinct().Count() == leaves * groups
            && model.AllSeries.Count == leaves * groups;
    }

    private bool AllHidden(IReadOnlyCollection<string> ids) => ids.All(_view.HiddenSeries.Contains);

    // A click hides what it names, or shows it again when all of it is hidden.
    private void Toggle(IReadOnlyCollection<string> ids) => ShowColumns(ids, show: AllHidden(ids));
    private ChartView _view = ChartView.All;

    // Adding series to a chart already drawn: the columns ticked in the picker.
    private bool _pickerOpen;
    private readonly HashSet<string> _picked = [];

    private string GroupLabelOf(string column) => Groups.FirstOrDefault(g => g.Tier == 1 && g.Columns.Contains(column))?.Label ?? "";

    private void Pick(IEnumerable<string> columns, bool on)
    {
        foreach (var c in columns)
            if (on) _picked.Add(c); else _picked.Remove(c);
    }

    private void AddPicked()
    {
        // In the grid's column order, so a group's series keep its Before, After, Diff order;
        // at the chart's dates, since a list of columns names no rows.
        if (_definition is not ChartDefinition columnChart) return;
        var keys = columnChart.AllKeys;
        AddSeries(Columns.Select(c => c.Name).Where(_picked.Contains).Select(n => new SeriesDefinition(n, keys)).ToList());
        _picked.Clear();
        _pickerOpen = false;
    }

    /// <summary>
    /// Excel's "add the range to the chart": the selection's number columns join it, each at the
    /// rows the selection covered in it — its own dates, not the chart's.
    /// </summary>
    private void AddSelection()
    {
        _refusal = null;
        if (Selection.IsEmpty) { _refusal = "Select the columns to add in the grid first."; return; }
        if (SelectionVersion != RowSequenceVersion) { _refusal = "The rows were reordered after the selection was made. Select again."; return; }
        if (_definition is RowChartDefinition rowChart && RowSpec is { } spec)
        {
            var outcome = ChartRequest.FromRowSelection(Selection.Ranges, SelectionVersion, RowSequenceVersion, Columns, Groups, Window, spec, rowChart.Series.ToList());
            if (outcome.Refusal is not null) { _refusal = outcome.Refusal; return; }
            var added = ((RowChartDefinition)outcome.Definition!).Series;
            _definition = rowChart with { Series = [.. rowChart.Series, .. added] };
            _notice = $"Added {added.Count} curves.";
            _pickerOpen = false;
            Redraw();
            return;
        }
        if (_definition is not ChartDefinition definition) return;
        var x = Columns.First(c => c.Name == definition.XColumn);
        var (series, refusal) = ChartRequest.SeriesOf(Selection.Ranges, Columns, Window, x, definition.SeriesColumns);
        if (refusal is not null) { _refusal = refusal; return; }
        if (series.Count == 0) { _refusal = "Every column in the selection is already in the chart."; return; }
        AddSeries(series);
        _pickerOpen = false;
    }

    private void AddSeries(IReadOnlyList<SeriesDefinition> series)
    {
        if (series.Count == 0) return;
        var columnChart = (ChartDefinition)_definition!;
        _definition = columnChart with { Series = [.. columnChart.Series, .. series] };
        _notice = $"Added {string.Join(", ", series.Select(s => $"{s.Column} ({s.RowKeys.Count} dates)"))}.";
        Redraw();
    }

    private string SelectionDescription()
    {
        if (Selection.IsEmpty) return "nothing selected in the grid";
        var count = Selection.Ranges.SelectMany(r => Enumerable.Range(r.LeftColumn, r.ColumnCount)).Distinct()
            .Count(i => i < Columns.Count && Columns[i].Type == ColumnType.Number && _definition is ChartDefinition c && !c.SeriesColumns.Contains(Columns[i].Name));
        if (_definition is RowChartDefinition) return $"{Selection.Ranges.SelectMany(r => Enumerable.Range(r.TopRow, r.RowCount)).Distinct().Count()} rows selected";
        return count == 0 ? "the selection adds nothing new" : $"the selection adds {count} series";
    }
    private XAxisStyle _xAxis = XAxisStyle.Default;

    private void SetAxis(Func<XAxisStyle, XAxisStyle> change)
    {
        _xAxis = change(_xAxis);
        Redraw();
    }

    // A style per Header Group ("" for the columns under none), starting from the page's.
    private readonly Dictionary<string, SeriesStyle> _styles = [];

    private static readonly (SeriesDraw, string)[] DrawLabels =
    [
        (SeriesDraw.Line, "Line"),
        (SeriesDraw.LinePoints, "Line and points"),
        (SeriesDraw.Points, "Points"),
        (SeriesDraw.StepPreceding, "Step, (tᵢ₋₁, tᵢ]"),
        (SeriesDraw.StepFollowing, "Step, [tᵢ, tᵢ₊₁)"),
    ];

    private static readonly (MarkerShape, string)[] MarkerLabels =
        [(MarkerShape.Circle, "● Circle"), (MarkerShape.Square, "■ Square"), (MarkerShape.Diamond, "◆ Diamond"), (MarkerShape.Triangle, "▲ Triangle")];

    private SeriesStyle StyleOfGroup(string group) => _styles.GetValueOrDefault(group, SeriesStyle.Default);

    // A column's own style first (a page may style one column of a group apart), then its group's.
    private SeriesStyle StyleOfColumn(string column) => _styles.TryGetValue(column, out var own) ? own :
        StyleOfGroup(Groups.FirstOrDefault(g => g.Tier == 1 && g.Columns.Contains(column))?.Label ?? "");

    // A gesture changes the one field it is about, applied to the style as it is when the event
    // is handled. Carrying the whole style the control was rendered with would let a second
    // change, made before the first one's render arrived on the circuit, put the first back
    // (the spine's sixth rule; found by driving the page at machine speed).
    private void SetStyle(string group, Func<SeriesStyle, SeriesStyle> change)
    {
        _styles[group] = change(StyleOfGroup(group));
        Redraw();
    }
    private bool _filterOpen;
    private static readonly (string Label, int? Years)[] Presets = [("1Y", 1), ("5Y", 5), ("10Y", 10), ("All", null)];

    private ChartSpec? _definition;
    private ChartModel? _model;
    private string? _svg, _pageSvg, _csv, _csvLong, _refusal, _notice;

    // The tooltip: which date the pointer is over, as the chart's listener reports it.
    private int _drawing;
    private int? _band;
    private ElementReference _chartBody;
    private string? _attachedTo;
    private IJSObjectReference? _module, _listener;
    private DotNetObjectReference<ChartBox<TRow>>? _self;

    /// <summary>Shows a chart of the definition, or the refusal that stands for one.</summary>
    public void Show(ChartOutcome outcome)
    {
        _refusal = outcome.Refusal;
        if (outcome.Definition is { } definition)
        {
            _definition = definition;
            _view = ChartView.All;
            _notice = null;
            Redraw();
        }
        StateHasChanged();
    }

    protected override void OnInitialized()
    {
        _layout = InitialLayout;
        _xAxis = InitialXAxis ?? XAxisStyle.Default;
        if (InitialStyles is not null)
            foreach (var (group, style) in InitialStyles) _styles[group] = style;
        _definition = InitialDefinition;
    }

    // New data: the chart is defined in the data's terms, so it is simply drawn again.
    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_drawnRows, Rows)) return;
        _drawnRows = Rows;
        Redraw();
    }

    private IReadOnlyList<TRow>? _drawnRows;

    private void SetLayout(ChartLayout layout)
    {
        _layout = layout;
        Redraw();
    }


    private void Redraw()
    {
        if (_definition is null) return;
        var look = new ChartLook(_layout, _view, OnRight, StyleOfColumn, UnitOf, SlotOf);
        var model = _definition switch
        {
            RowChartDefinition rows => ChartModelBuilder.BuildRows(rows, RowSpec!, Columns, Groups, Rows, look),
            ChartDefinition columns => ChartModelBuilder.Build(columns, Columns, Groups, Rows, look),
            _ => throw new InvalidOperationException(),
        };
        _model = model with { XAxis = _xAxis with { LabelOf = XLabelOf } };
        _drawing++;
        _band = null;
        _svg = ChartSvg.Write(_model);
        _pageSvg = ChartSvg.Write(_model, _drawing, forFile: false);
        _csv = ChartCsv.Write(_model);
        _csvLong = ChartCsv.WriteLong(_model);
    }

    private void ShowColumns(IEnumerable<string> columns, bool show)
    {
        var hidden = new HashSet<string>(_view.HiddenSeries);
        foreach (var c in columns)
            if (show) hidden.Remove(c); else hidden.Add(c);
        _view = _view with { HiddenSeries = hidden };
        Redraw();
    }

    private void ShowLeaf(string leaf, bool show) =>
        ShowColumns(_model!.AllSeries.Where(s => s.Leaf == leaf).Select(s => s.Id), show);

    private void SetRange(double? from, double? to)
    {
        // A range turned inside out is put the right way round rather than drawn empty.
        if (from is { } f && to is { } t && f > t) (from, to) = (t, f);
        _view = _view with { From = from, To = to };
        Redraw();
    }

    private void SetHorizon(ChartModel model, int? years) =>
        SetRange(null, years is not { } y ? null
            : model.Scale.IsDate ? XScale.Of(XScale.DateOf(model.AllXs[0]).AddYears(y))
            : (model.Scale.Origin ?? model.AllXs[0]) + y);

    private static string FilterSummary(ChartModel model)
    {
        var shown = model.Panels.Sum(p => p.Series.Count);
        var points = model.Xs.Count;
        return shown == model.AllSeries.Count && points == model.AllXs.Count
            ? ""
            : $"({shown}/{model.AllSeries.Count} series, {points}/{model.AllXs.Count} points)";
    }

    // The range's choices are positions of the chart, sent as their index: a value written in
    // one culture and read in another never crosses.
    private static int IndexOf(ChartModel model, double x) => Math.Max(0, model.AllXs.ToList().IndexOf(x));
    private static double? At(ChartModel model, object? value) =>
        int.TryParse(value as string, NumberStyles.None, Invariant, out var i) && i >= 0 && i < model.AllXs.Count ? model.AllXs[i] : null;

    private void CloseChart() => (_definition, _model, _svg, _pageSvg, _csv, _filterOpen, _band, _pickerOpen, _notice) = (null, null, null, null, null, false, null, false, null);

    /// <summary>The listener's report. One taken against an earlier drawing names a date of a
    /// chart no longer shown, and is dropped rather than shown against this one.</summary>
    [JSInvokable]
    public void OnBand(int drawing, int band)
    {
        if (drawing != _drawing) return;
        int? next = band >= 0 ? band : null;
        if (next == _band) return;
        _band = next;
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The chart's element is new each time a chart opens; the listener follows it.
        var id = _model is null ? null : _chartBody.Id;
        if (id == _attachedTo) return;
        _attachedTo = id;
        if (_listener is not null) { await _listener.DisposeAsync(); _listener = null; }
        if (id is null) return;
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./exposure-chart.js");
        _self ??= DotNetObjectReference.Create(this);
        _listener = await _module.InvokeAsync<IJSObjectReference>("attach", _chartBody, _self);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_listener is not null) await _listener.DisposeAsync();
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        _self?.Dispose();
    }

    private static string Percent(double fraction) => (fraction * 100).ToString("0.###", Invariant) + "%";

}
