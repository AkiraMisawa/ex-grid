<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Single-target net10.0; newer runtimes load it as-is (ADR-0022). -->
    <TargetFramework>net10.0</TargetFramework>
    <Description>The formula engine of ExSheet: a Sheet of Entries, Excel's formula syntax and a declared set of functions that answer as Excel does or give #NAME?, incremental recalculation, number formats, and the versioned Sheet Document. No UI and no dependency: a server computes the same Values the screen shows.</Description>
    <PackageTags>excel;spreadsheet;formula;sheet</PackageTags>
  </PropertyGroup>

  <!-- No package and no project references, deliberately (ADR-0047, SH-1): the engine runs
       wherever a saved Sheet Document's Values are needed, a server included. -->

  <ItemGroup>
    <!-- Layer 1 counts the passes of a recalculation, which has no public surface: how often a
         volatile Formula is computed is bounded, and the bound is tested (ADR-0124, ADR-0125). It
         also pins the engine's machinery and the entry points a contract member answers (ADR-0201). -->
    <InternalsVisibleTo Include="ExSheet.Engine.Tests" />
    <!-- ExSheet's layer 2 fills a Sheet a cell at a time, through the engine's own one-cell entry
         point, which SetEntries answers for a Consumer (ADR-0201). Granted to test projects only,
         never to a package. -->
    <InternalsVisibleTo Include="ExSheet.Components.Tests" />
    <!-- So does the Wrapper's layer 2, building the Sheets its tests open. -->
    <InternalsVisibleTo Include="ExSheet.MudBlazor.Tests" />
    <!-- ExSheet.Xlsx's shared cases build their Workbooks with the engine's case steps (tests/cases/sheet-xlsx),
         whose runner reads the same entry points (ADR-0370 section 3). -->
    <InternalsVisibleTo Include="ExSheet.Xlsx.Tests" />
  </ItemGroup>

</Project>
