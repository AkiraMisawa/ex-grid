@* Written in each component, not in an _Imports.razor, whose class Razor makes public (ADR-0201).
   Every product using is written with global::: inside ExBoard.Components a plain "ExBoard.X" would
   be looked up against this component's class first (the CS0426 trap in AGENTS.md). *@
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using global::ExGrid
@using global::ExGrid.Components
@using global::ExPivot.Components
@using global::ExChart.Components

<div class="ex-board" style="@RootStyle">
    @if (!string.IsNullOrEmpty(Board?.Title))
    {
        <h2 class="ex-board-title">@Board.Title</h2>
    }
    @if (_refusal is not null)
    {
        @* Nothing of a Board that does not bind is drawn: a part drawn beside a refusal would look
           like the whole (spine rule 1). *@
        <div class="ex-board-refusal" role="alert">@_refusal</div>
    }
    else if (_bound is null)
    {
        @* Its sources are asked their shapes before anything is drawn (ADR-0341). *@
        <div class="ex-board-binding" role="status">Asking the sources for their shapes.</div>
    }
    else if (_bound is { } bound)
    {
        @if (bound.Dropped.Count > 0)
        {
            @* What of the user's last changes no longer fits is said, never applied to something else
               (ADR-0340, Q7; spine rule 1). *@
            <div class="ex-board-dropped" role="status">
                <span>Not laid over, as the Board has changed:</span>
                <ul>
                    @foreach (var dropped in bound.Dropped)
                    {
                        <li>@dropped</li>
                    }
                </ul>
            </div>
        }
        @foreach (var row in bound.Board.Layout)
        {
            var shares = row.Cells.Sum(c => c.Width);
            <div class="ex-board-row" style="@RowStyle(row)">
                @foreach (var cell in row.Cells)
                {
                    var view = bound[cell.View];
                    <section @key="cell.View" class="ex-board-view" data-ex-view="@cell.View" style="@CellStyle(cell)"
                             aria-label="@(string.IsNullOrEmpty(view.View.Title) ? cell.View : view.View.Title)">
                        @if (!string.IsNullOrEmpty(view.View.Title))
                        {
                            <h3 class="ex-board-view-title" style="@TitleStyle">@view.View.Title</h3>
                        }
                        @switch (view)
                        {
                            case BoundGridView grid:
                                <ExGrid @ref="_grids[cell.View]" TRow="ShapedRow" Source="grid.Source" Columns="grid.Columns" PinnedColumnCount="grid.PinnedColumnCount"
                                        Chrome="Chrome" ViewportHeight="row.Height" ViewportWidth="ViewportSize.Stretch"
                                        SelectionChanged="SelectionChangedOf(cell.View)"
                                        OnColumnWidthChanged="_gridChanges[cell.View].Width" OnColumnOrderChanged="_gridChanges[cell.View].Order"
                                        OnColumnHidden="_gridChanges[cell.View].Hidden" OnPinnedCountChanged="_gridChanges[cell.View].Pinned" />
                                @if (_linkStatus.GetValueOrDefault(cell.View) is { } unread)
                                {
                                    <span role="status" class="ex-board-link-status">@unread</span>
                                }
                                @foreach (var output in bound.Board.Outputs.Where(o => o.From == cell.View))
                                {
                                    @* Never disabled: a press that follows a selection a round trip later is
                                       answered for the selection it follows, not dropped by a button the
                                       browser still holds disabled (spine rule 6). With nothing selected,
                                       it says so. *@
                                    <div class="ex-board-confirm-row" style="@ConfirmStyle">
                                        <button type="button" class="ex-board-confirm" data-ex-output="@output.Name"
                                                @onclick="() => ConfirmAsync(output.Name)">@output.Confirm</button>
                                        <span role="status" class="ex-board-confirm-status">@_confirmStatus.GetValueOrDefault(output.Name)</span>
                                    </div>
                                }
                                break;
                            case BoundPivotView pivot:
                                <ExPivot @ref="_pivots[cell.View]" Source="pivot.Source" ReportSource="pivot.ReportSource" Layout="pivot.Layout" LayoutChanged="_layoutChanged[cell.View]"
                                         Chrome="Chrome" PivotChrome="PivotChrome" ShowFieldList="false"
                                         ViewportHeight="row.Height" ViewportWidth="ViewportSize.Stretch"
                                         SelectionChanged="SelectionChangedOf(cell.View)" />
                                @if (_linkStatus.GetValueOrDefault(cell.View) is { } said)
                                {
                                    <span role="status" class="ex-board-link-status">@said</span>
                                }
                                break;
                            case BoundChartView { Refusal: { } refusal }:
                                @* The rows a link lets through are not a chart its spec draws: said in
                                   its place, never the chart of other rows (spine rule 1). *@
                                <div class="ex-board-refusal" role="alert" style="@RefusalStyle(row)">@refusal</div>
                                break;
                            case BoundChartView chart:
                                <ExChart Definition="chart.Reading.Definition" Title="@chart.Reading.Title" Chrome="ChartChrome"
                                         Width="ChartWidth(row, cell, shares)" Height="row.Height"
                                         HiddenSeries="chart.HiddenSeries" OnSeriesVisibilityChanged="_chartChanges[cell.View].Visibility"
                                         Range="chart.Range" OnRangeChanged="_chartChanges[cell.View].Range"
                                         Scale="chart.Scale" OnScaleChanged="_chartChanges[cell.View].Scale" />
                                break;
                        }
                    </section>
                }
            </div>
        }
    }
</div>
