<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- Single-target net10.0, like every shipped package (ADR-0022). -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ExBoard</RootNamespace>
    <Description>ExBoard: a Board, JSON an AI composes once and a workflow runs without AI, laid out as rows of ExGrid, ExPivot and ExChart views over typed Board Inputs, each checked against its source's shape before anything is drawn.</Description>
    <PackageTags>$(PackageTags);board;ai;workflow</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- The Board references the three products it lays out, and no Engine references it (ADR-0340). -->
    <ProjectReference Include="..\ExGrid\ExGrid.csproj" />
    <ProjectReference Include="..\ExPivot\ExPivot.csproj" />
    <ProjectReference Include="..\ExChart\ExChart.csproj" />
    <!-- Blazor's Script ExBoard sends each input's Snapshot to the browser as its Arrow stream (ADR-0065). -->
    <ProjectReference Include="..\ExGrid.Data.Arrow\ExGrid.Data.Arrow.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- How a Snapshot crosses to a Script adapter's module, compiled into each adapter that sends one, so every one
         crosses them alike (ADR-0065's note of 2026-10-28). -->
    <Compile Include="..\Shared\Components\SnapshotCrossing.cs" Link="Components\SnapshotCrossing.cs" />
    <!-- The browser's calls in their order, a call too large for a circuit's message among them: compiled into each
         Script adapter, beside the Shared Script's half (src/npm/blazor/src/held-messages.ts). -->
    <Compile Include="..\Shared\Components\HeldCalls.cs" Link="Components\HeldCalls.cs" />
    <Compile Include="..\Shared\Components\CrossedText.cs" Link="Components\CrossedText.cs" />
    <!-- A C# Pivot Source asked by the browser's pivot, as ExPivot's adapter asks one: a pivot over a source. -->
    <Compile Include="..\Shared\Components\PivotSourceCrossing.cs" Link="Components\PivotSourceCrossing.cs" />
    <Compile Include="..\Shared\Components\PivotRefreshes.cs" Link="Components\PivotRefreshes.cs" />
    <!-- Chrome slots filled with Razor (ADR-0410): the holders every adapter renders, and the grids' and the pivots'
         and the charts' slots, read and drawn as ExGrid's, ExPivot's and ExChart's own adapters read and draw them. -->
    <Compile Include="..\Shared\Components\RazorSlotHolders.cs" Link="Components\RazorSlotHolders.cs" />
    <Compile Include="..\ExGrid\Components\RazorSlot.cs" Link="Components\RazorSlot.cs" />
    <Compile Include="..\ExGrid\Components\ScriptJson.cs" Link="Components\ScriptJson.cs" />
    <Compile Include="..\ExPivot\Components\PivotRazorSlot.cs" Link="Components\PivotRazorSlot.cs" />
    <Compile Include="..\ExChart\Components\ChartRazorSlot.cs" Link="Components\ChartRazorSlot.cs" />
    <Compile Include="..\ExChart\Components\ChartWire.cs" Link="Components\ChartWire.cs" />
    <Compile Include="..\Shared\Components\ScriptFunctionJson.cs" Link="Components\ScriptFunctionJson.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ExBoard.Tests" />
  </ItemGroup>

  <!-- ExBoard's Script Core's module for ExBoard.Components.ExBoard (ADR-0370 section 1): the bridge, @ex-grid/board and
       the views it lays out, bundled from their sources in src/npm as this project builds, never committed, as
       ExPivot's is. The grid it draws through, and the data it reads, it imports from the Shared Script ExGrid ships,
       built against the same sources (ADR-0411). The module goes to wwwroot, where the package serves it; its version
       and stamp (ADR-0123) are compiled in as ScriptCoreAsset. src/npm's dependencies are ExGrid's build's to install:
       the bundle is built once the project references are, so the two never run npm in the workspace at once. -->
  <PropertyGroup>
    <ScriptCoreWorkspace>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', 'npm'))</ScriptCoreWorkspace>
    <ScriptCoreModule>$(MSBuildThisFileDirectory)wwwroot/ex-board.min.js</ScriptCoreModule>
    <ScriptCoreConstants>$(MSBuildThisFileDirectory)$(BaseIntermediateOutputPath)ScriptCore/ScriptCoreAsset.g.cs</ScriptCoreConstants>
  </PropertyGroup>

  <ItemGroup>
    <ScriptCoreSource Include="$(ScriptCoreWorkspace)core/src/**/*.ts;$(ScriptCoreWorkspace)data/src/**/*.ts;$(ScriptCoreWorkspace)pivot-engine/src/**/*.ts;$(ScriptCoreWorkspace)pivot/src/**/*.ts;$(ScriptCoreWorkspace)chart/src/**/*.ts;$(ScriptCoreWorkspace)board/src/**/*.ts;$(ScriptCoreWorkspace)board-blazor/src/**/*.ts;$(ScriptCoreWorkspace)pivot-blazor/src/dotnet-pivot-source.ts;$(ScriptCoreWorkspace)pivot-blazor/src/razor-pivot-slots.ts;$(ScriptCoreWorkspace)pivot-blazor/src/for-board.ts;$(ScriptCoreWorkspace)chart-blazor/src/razor-slots.ts;$(ScriptCoreWorkspace)blazor/src/shared.ts;$(ScriptCoreWorkspace)blazor/src/snapshots.ts;$(ScriptCoreWorkspace)blazor/src/held-messages.ts;$(ScriptCoreWorkspace)blazor/src/razor-slot-host.ts;$(ScriptCoreWorkspace)blazor/src/grid-razor-slot-kinds.ts;$(ScriptCoreWorkspace)blazor/src/pointing-scopes.ts;$(ScriptCoreWorkspace)blazor/src/wire-metrics.ts" />
    <ScriptCoreSource Include="$(ScriptCoreWorkspace)scripts/build-blazor.mjs;$(ScriptCoreWorkspace)package-lock.json" />
    <!-- The Shared Script it imports, whose stamp it carries: built from more of blazor/src than this module reads, so a
         change there that reaches the Shared Script alone builds this module again. -->
    <ScriptCoreSource Include="$(MSBuildThisFileDirectory)../ExGrid/wwwroot/ex-grid-script.min.js" />
    <Content Remove="wwwroot/ex-board.min.js;wwwroot/ex-board.min.js.map" />
  </ItemGroup>

  <Target Name="BuildScriptCore" DependsOnTargets="ResolveProjectReferences"
          Inputs="@(ScriptCoreSource)" Outputs="$(ScriptCoreModule);$(ScriptCoreConstants)">
    <Exec Command="node ../scripts/build-blazor.mjs --name ex-board --namespace ExBoard.Components --out &quot;$(MSBuildThisFileDirectory)wwwroot&quot; --stamp &quot;$(MSBuildThisFileDirectory)$(BaseIntermediateOutputPath)ScriptCore/ex-board.stamp.json&quot; --cs &quot;$(ScriptCoreConstants)&quot;"
          WorkingDirectory="$(ScriptCoreWorkspace)board-blazor" />
  </Target>

  <!-- Apart from the build, which is skipped while its outputs are newer than every source: the items are
       added on every build, so the static web assets and the compile always hold the module. -->
  <Target Name="IncludeScriptCore" DependsOnTargets="BuildScriptCore"
          BeforeTargets="BeforeBuild;CoreCompile;ResolveProjectStaticWebAssets;ResolveStaticWebAssetsConfiguration">
    <ItemGroup>
      <Content Remove="wwwroot/ex-board.min.js;wwwroot/ex-board.min.js.map" />
      <Content Include="wwwroot/ex-board.min.js;wwwroot/ex-board.min.js.map" />
      <Compile Remove="$(ScriptCoreConstants)" />
      <Compile Include="$(ScriptCoreConstants)" />
    </ItemGroup>
  </Target>

  <!-- ExBoard depends on exactly the versions it was built with, as ExChart does (ADR-0042). -->
  <Target Name="DependOnExactlyTheseVersions" AfterTargets="_GetProjectReferenceVersions">
    <ItemGroup>
      <_ProjectReferencesWithVersions Update="@(_ProjectReferencesWithVersions)" ProjectVersion="[%(ProjectVersion)]" />
    </ItemGroup>
  </Target>

</Project>
