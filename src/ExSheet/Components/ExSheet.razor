    /// here replaces it.</summary>
    [Parameter] public global::ExGrid.Summarizing.SummaryFigures SummaryFigures { get; set; } = global::ExGrid.Summarizing.SummaryFigures.Default;

    /// <summary>Whether the Selection Summary is shown under the Sheet (ADR-0130): on by default.</summary>
    [Parameter] public bool ShowSelectionSummary { get; set; } = true;

    /// <summary>Raised when the figures menu changes the figures shown (ADR-0130).</summary>
    [Parameter] public EventCallback<global::ExGrid.Summarizing.SummaryFigures> SummaryFiguresChanged { get; set; }

    /// <summary>The Selection Summary as it now stands (ADR-0130), for an application that shows the
    /// figures elsewhere.</summary>
    [Parameter] public EventCallback<global::ExGrid.Summarizing.SelectionSummary> OnSelectionSummaryChanged { get; set; }

    /// <summary>
    /// Raised after every change to the Sheet with its Sheet Document — Entries, never Values
    /// (ADR-0048) — while the Workbook holds one Sheet, which a Sheet Document records whole; with
    /// several, only <see cref="WorkbookChanged"/> is raised. The application persists it; ExSheet
    /// never does.
    /// </summary>
    [Parameter] public EventCallback<SheetDocument> DocumentChanged { get; set; }

    /// <summary>
    /// The declared culture of a Sheet started empty: how typed constants are read and how
