@namespace ExSheet
@implements IDisposable
@using Microsoft.AspNetCore.Components

@*
    The Sheet Toolbar's default row (ADR-0100), declared whole: the Script Core draws its own default row, in its words,
    the formatting commands in the order Excel's Home tab has them, under the KeyTip H.
*@

@code {
    /// <summary>The scope the row takes its place from. Internal, as its type is (ADR-0201).</summary>
    [CascadingParameter] internal ToolbarOrder? Order { get; set; }

    /// <summary>The ExSheet's toolbar, where the row declares itself. Internal, as its type is (ADR-0201).</summary>
    [CascadingParameter] internal global::ExSheet.Script.ScriptToolbar? Script { get; set; }

    private ToolbarOrder _place = new();

    /// <inheritdoc />
    protected override void OnInitialized() => _place = Order?.Next() ?? _place;

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        var script = Script
            ?? throw new InvalidOperationException("DefaultToolbarRow is a Toolbar Row: it stands inside an ExSheet's ToolbarContent (ADR-0100).");
        script.JoinDefault(this, _place);
    }

    /// <inheritdoc />
    public void Dispose() => Script?.LeaveDefault(this);
}
