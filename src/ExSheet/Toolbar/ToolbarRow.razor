@namespace ExSheet
@implements IDisposable
@using Microsoft.AspNetCore.Components

@*
    One band of a Sheet Toolbar (ADR-0100), declared to the ExSheet's toolbar, which the Script Core draws: only its
    items stand here, declaring themselves in markup order. Its KeyTip is what a ribbon tab's is: the formatting row's
    is H, Excel's Home.
*@
<CascadingValue Value="this" IsFixed="true">
    <CascadingValue Value="Place" IsFixed="true">@ChildContent</CascadingValue>
</CascadingValue>

@code {
    /// <summary>The row's Toolbar Items, in order.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>The row's accessible name, which every row of the Script Core's names itself with.</summary>
    [Parameter, EditorRequired] public string? Label { get; set; }

    /// <summary>The row's KeyTip letter, as a ribbon tab's (ADR-0100). None unless declared, except on ExSheet's default row, which is H.</summary>
    [Parameter] public string? KeyTip { get; set; }

    /// <summary>The scope the row takes its place from. Internal, as its type is (ADR-0201).</summary>
    [CascadingParameter] internal ToolbarOrder? Order { get; set; }

    /// <summary>The ExSheet's toolbar, where the row declares itself. Internal, as its type is (ADR-0201).</summary>
    [CascadingParameter] internal global::ExSheet.Components.ScriptToolbar? Script { get; set; }

    /// <summary>Where the row stands on the toolbar, and the scope its items take theirs from.</summary>
    internal ToolbarOrder Place { get; private set; } = new();

    /// <inheritdoc />
    protected override void OnInitialized() => Place = Order?.Next() ?? Place;

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        var script = Script
            ?? throw new InvalidOperationException("ToolbarRow is a Toolbar Row: it stands inside an ExSheet's ToolbarContent (ADR-0100).");
        script.JoinRow(this);
    }

    /// <inheritdoc />
    public void Dispose() => Script?.LeaveRow(this);
}
