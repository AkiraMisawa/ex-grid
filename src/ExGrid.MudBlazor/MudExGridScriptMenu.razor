@* Written in each file, not in an _Imports.razor, whose class Razor makes public (ADR-0201); and
   with global::, as this project's root namespace nests inside ExGrid (the CS0426 trap in AGENTS.md). *@
@using Microsoft.AspNetCore.Components
@using global::ExGrid.Chrome
@using global::MudBlazor
@* Not the contract (ADR-0201): MudGridChrome draws this part, and no Consumer places it. It is
   public only because Razor makes every component public, is hidden from a Consumer's editor, and
   may change in any version. *@
@attribute [System.ComponentModel.EditorBrowsable(System.ComponentModel.EditorBrowsableState.Never)]
@* The column menu's and the Context Menu's content when the Script Core draws the grid (ADR-0410):
   MudButtons with a Material icon each, each marked with its command's index, and nothing else.
   What a key, a press or a focus does on an item is wired by the adapter's script in the browser,
   against the place the core keeps for the menu (ADR-0039), so no key waits on the circuit and no
   handler is drawn here. *@
<div class="mud-ex-grid-menu" role="none">
    @for (var i = 0; i < View.Items.Count; i++)
    {
        var item = View.Items[i];
        <MudButton Variant="Variant.Text" FullWidth="true" Class="mud-ex-grid-menu-item" Size="Size.Small"
                   Disabled="!item.Enabled" StartIcon="@Chrome.IconFor(item.Id)"
                   UserAttributes="@(new Dictionary<string, object?> { [ScriptSlotAttributes.MenuItem] = i })">
            @Chrome.LabelFor(item, Localizer)
        </MudButton>
    }
</div>

@code {
    [Inject] private ILocalizationInterceptor Localizer { get; set; } = default!;

    /// <summary>The menu's view, as the Script Core hands it (ADR-0410).</summary>
    [Parameter, EditorRequired] public GridMenuView View { get; set; } = default!;

    /// <summary>Where the wording and the icons come from.</summary>
    [Parameter, EditorRequired] public MudGridChrome Chrome { get; set; } = default!;
}
