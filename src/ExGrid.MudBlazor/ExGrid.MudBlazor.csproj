<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- Single-target net10.0, like every shipped package (ADR-0022). MudBlazor 9
         carries a net10.0 build, so the Wrapper keeps the core's floor. -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ExGrid.MudBlazor</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The lowest 9.x: the application resolves it upward (ADR-0022's rule applied to
         the one dependency this package adds). Where its net10.0 build asks for a
         higher Microsoft.AspNetCore.Components.Web than the core's 10.0.0, that is
         MudBlazor's floor, not a choice made here. -->
    <PackageReference Include="MudBlazor" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The one direction there is (ADR-0019/0030): the Wrapper references the core;
         nothing in the core knows this package exists. -->
    <ProjectReference Include="..\ExGrid\ExGrid.csproj" />
  </ItemGroup>

</Project>
