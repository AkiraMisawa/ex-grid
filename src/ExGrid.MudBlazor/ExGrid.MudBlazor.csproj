<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- Single-target net8.0, like every shipped package (ADR-0022). MudBlazor 9
         targets net8.0 itself, so the Wrapper keeps the core's floor. -->
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>ExGrid.MudBlazor</RootNamespace>
    <Description>MudBlazor for ExGrid: a paper, a Chrome and a stylesheet that put the grid inside a MudBlazor application, with MudBlazor's own controls in the grid's menus, filter panel and editor. Ships at the same version as ExGrid and depends on exactly that version.</Description>
    <PackageTags>$(PackageTags);mudblazor;material</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- The lowest 9.x: the application resolves it upward (ADR-0022's rule applied to
         the one dependency this package adds). Its net8.0 build asks for
         Microsoft.AspNetCore.Components.Web 8.0.12, so this package's effective floor
         is 8.0.12 where the core's is 8.0.0 — MudBlazor's floor, not a choice made
         here. -->
    <PackageReference Include="MudBlazor" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The one direction there is (ADR-0019/0030): the Wrapper references the core;
         nothing in the core knows this package exists. -->
    <ProjectReference Include="..\ExGrid\ExGrid.csproj" />
  </ItemGroup>

  <!-- The Wrapper depends on exactly the core version it was built with (ADR-0042): the two
       ship together, and a Consumer who upgrades one alone is told so at restore (NU1608 or
       NU1107) rather than left with a Wrapper running against a core it never met. NuGet offers no range on a
       ProjectReference, so the version pack computed is made exact here; CI's package job
       reads it back from the .nuspec, so a change in the SDK cannot drop it silently. -->
  <Target Name="DependOnExactlyThisCore" AfterTargets="_GetProjectReferenceVersions">
    <ItemGroup>
      <_ProjectReferencesWithVersions Update="@(_ProjectReferencesWithVersions)" ProjectVersion="[%(ProjectVersion)]" />
    </ItemGroup>
  </Target>

</Project>
