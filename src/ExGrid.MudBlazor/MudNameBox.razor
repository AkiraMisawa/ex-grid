@* The Formula Bar's Name Box seam (ADR-0051/0030): a bare input filling the box the core
   stands in the bar, inside the core's form — Enter is that form's implicit submission, and
   what the text means is the core's and the Consumer's. This only paints the control and
   reports what is typed, as the Cell Editor's content does. *@
<input class="mud-ex-name-box" value="@Context.Text" tabindex="-1" aria-label="@Label"
       @onfocus="OnFocus" @oninput="OnInput" @onblur="OnBlur" />

@code {
    /// <summary>The core's contract for the Name Box (ADR-0051): what it shows, and where
    /// what is typed, a focus and a blur go.</summary>
    [Parameter, EditorRequired] public NameBoxContext Context { get; set; } = default!;

    /// <summary>The control's accessible name, in the Chrome's words (WR-3).</summary>
    [Parameter, EditorRequired] public string Label { get; set; } = "";

    private Task OnFocus() => Context.Focused();

    private void OnInput(ChangeEventArgs e) => Context.TextChanged(e.Value?.ToString() ?? "");

    private void OnBlur() => Context.Blurred();
}
