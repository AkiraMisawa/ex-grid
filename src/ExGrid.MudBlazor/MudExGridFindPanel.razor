@* Written in each file, not in an _Imports.razor, whose class Razor makes public (ADR-0201); and
   with global::, as this project's root namespace nests inside ExGrid (the CS0426 trap in AGENTS.md). *@
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using global::ExGrid
@using global::ExGrid.Chrome
@using global::ExGrid.Components
@using global::ExGrid.Finding
@using global::MudBlazor
@* Not the contract (ADR-0201): MudGridChrome draws this part, and no Consumer places it. It is
   public only because Razor makes every component public, is hidden from a Consumer's editor, and
   may change in any version. *@
@attribute [System.ComponentModel.EditorBrowsable(System.ComponentModel.EditorBrowsableState.Never)]
@* The find panel under MudBlazor (ADR-0055/0030): a MudTextField, the two options as
   MudCheckBoxes and the two steps as MudButtons, inside the core's popover; opened by Ctrl+H where a
   Replace can land, a second MudTextField and Replace and Replace All as well (ADR-0332 §2). The search, the
   Focus it moves and what closes the panel are the core's; this draws and calls back.

   Enter in the field is the browser's implicit submission — which an IME's candidate Enter is
   not — through a hidden default button that is never disabled, as in the filter panel; Shift
   held on that Enter makes it "previous". The field takes DOM focus for each change of the
   context's FocusRequest: each opening, and each Tab off either end, which the core's sentinels
   around the panel turn into a request (ADR-0039) — through the core's focus function, which takes
   the keyboard only while it is still the grid's (ADR-0204). What the last step came to is worded here
   and written into a live region, because the grid holds no sentence (ADR-0033). *@
<form class="mud-ex-grid-find" data-ex-claims="submit" @onsubmit="SubmitAsync" @onsubmit:preventDefault>
    <button type="submit" class="mud-ex-grid-find-default" hidden tabindex="-1" aria-hidden="true"></button>
    <MudTextField @ref="_field" T="string" Value="Context.Text" ValueChanged="Context.TextChanged" Immediate="true"
                  Label="@Own(FindPanelLabelIds.Field)" Variant="Variant.Outlined" Margin="Margin.Dense"
                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                  OnKeyDown="OnFieldKeyDown" Class="mud-ex-grid-find-field" />
    <MudCheckBox T="bool" Value="Context.MatchCase" ValueChanged="Context.MatchCaseChanged"
                 Label="@Own(FindPanelLabelIds.MatchCase)" Dense="true" Size="Size.Small" Class="mud-ex-grid-find-match-case" />
    <MudCheckBox T="bool" Value="Context.WholeCell" ValueChanged="Context.WholeCellChanged"
                 Label="@Own(FindPanelLabelIds.WholeCell)" Dense="true" Size="Size.Small" Class="mud-ex-grid-find-whole-cell" />
    <div class="mud-ex-grid-find-actions">
        <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.KeyboardArrowUp"
                   OnClick="Context.Previous" data-ex-claims="click" Class="mud-ex-grid-find-previous">@Own(FindPanelLabelIds.Previous)</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.KeyboardArrowDown"
                   OnClick="Context.Next" data-ex-claims="click" Class="mud-ex-grid-find-next">@Own(FindPanelLabelIds.Next)</MudButton>
    </div>
    @if (Context.ReplaceShown)
    {
        @* Replace (ADR-0332 §2): the replacement and the two writes, each a click the core takes in
           its place in the Input Order (ADR-0240), as Find's steps are. Enter in this field is still
           "find next", as in Excel's dialog. *@
        <MudTextField T="string" Value="Context.ReplaceText" ValueChanged="Context.ReplaceTextChanged!" Immediate="true"
                      Label="@Own(FindPanelLabelIds.ReplaceField)" Variant="Variant.Outlined" Margin="Margin.Dense"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.FindReplace"
                      OnKeyDown="OnFieldKeyDown" Class="mud-ex-grid-find-replace-field" />
        <div class="mud-ex-grid-find-actions">
            <MudButton Variant="Variant.Text" Size="Size.Small"
                       OnClick="Context.Replace!" data-ex-claims="click" Class="mud-ex-grid-find-replace">@Own(FindPanelLabelIds.Replace)</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                       OnClick="Context.ReplaceAll!" data-ex-claims="click" Class="mud-ex-grid-find-replace-all">@Own(FindPanelLabelIds.ReplaceAll)</MudButton>
        </div>
    }
    <MudText Typo="Typo.caption" Color="@OutcomeColour"
             Class="mud-ex-grid-find-outcome" role="status">@OutcomeText</MudText>
</form>

@code {
    /// <summary>The core's contract for the panel (ADR-0055). The core keys its popover by the
    /// opening, so each opening is a new instance of this component.</summary>
    [Parameter, EditorRequired] public FindContext Context { get; set; } = default!;

    /// <summary>Where the wording comes from.</summary>
    [Parameter, EditorRequired] public MudGridChrome Chrome { get; set; } = default!;

    private MudTextField<string>? _field;
    private int _focusedRequest;
    private bool _focusOwed;
    private bool _backwardOnSubmit;

    private string Own(string id) => MudExGridWords.Own(Chrome, id);

    private string OutcomeText => FindPanelLabelIds.OutcomeText(Context, Own);

    // A count replaced is a success, and a match in a header (ADR-0333) is news, not a fault; every
    // other outcome said is a step that moved nothing.
    private Color OutcomeColour => Context.Outcome switch
    {
        FindOutcome.Replaced => Color.Success,
        FindOutcome.FoundInHeader => Color.Default,
        _ => Color.Error,
    };

    protected override void OnParametersSet()
    {
        if (Context.FocusRequest != _focusedRequest)
        {
            _focusedRequest = Context.FocusRequest;
            _focusOwed = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusOwed || _field is null)
            return;
        _focusOwed = false;
        try
        {
            // The core's focus function, which takes the keyboard only while it is still the grid's: on
            // a circuit the opening focus lands a round trip after Ctrl+F, and a grid pressed in the
            // meantime keeps it (ADR-0204). Without scrolling, as the core's own panel opens. Outside a
            // grid's context, the field's own FocusAsync.
            if (Context.TakeFocus is { } take && _field.InputReference is { } input)
                await take(input.ElementReference, true);
            else
                await _field.FocusAsync();
        }
        catch (Exception ex) when (ex is Microsoft.JSInterop.JSException or Microsoft.JSInterop.JSDisconnectedException or ObjectDisposedException or OperationCanceledException)
        {
        }
    }

    private void OnFieldKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            _backwardOnSubmit = e.ShiftKey;
    }

    private Task SubmitAsync()
    {
        var backward = _backwardOnSubmit;
        _backwardOnSubmit = false;
        return backward ? Context.Previous() : Context.Next();
    }
}
