@using System.Globalization
@using FilterOperator = global::ExGrid.FilterOperator
@using FilterCombinator = global::ExGrid.FilterCombinator
@* The filter panel under MudBlazor (ADR-0009/0030/0039): MudBlazor's own controls under the
   column's commands in the core's one popover (ADR-0044). A value list with a search and a
   Blank entry where the column declares one and the answer arrives; the condition form where
   it declares that, or where the answer is TooMany. It keeps a working state and asks FilterPanelChoices what that
   state means — the rules the built-in panel applies by — so the same choices make the
   same FilterSpec under either Chrome (WR-1).

   Its selects and its date picker open popups of their own, which MudBlazor draws outside
   the grid's root: Inner Popups (ADR-0039). Each is reported through the context's
   InnerPopupChanged as it opens and closes, so that Escape closes it first. MudBlazor keeps
   DOM focus on the control while its popup is open, and without the report the grid would
   take that Escape and close the panel with it. The next Escape reaches the grid and
   closes the panel.

   Enter in a value field is the browser's implicit submission, so Enter submits wherever
   a text field has focus — and the browser does not submit on the Enter that confirms an
   IME's candidate. The default button it clicks is a hidden one that is never disabled,
   and Apply refuses the submit while it is unavailable (WR-2). Gating Enter on Apply's
   disabled button instead dropped it on a Server circuit: the button is enabled a round
   trip after the value is typed, and an Enter typed with the value found it still
   disabled and submitted nothing. The submit reaches the circuit behind the value, so the
   check there sees what was typed.

   The popover opens with the keyboard on the commands above, and this panel takes it only
   when asked: its first control for each change of the context's FocusRequest — Tab from the
   commands — Cancel, its last, for each change of FocusLastRequest, and for SearchRequest —
   E — the field a search is typed into: the search box, or the first condition's value. Tab off
   either end is the core's, whose sentinels around the panel wrap to the commands (KB-31).
   Excel's letters on the value list are handed to the core through ValueListKey; clearing
   the filter is the command above, so the actions are Apply and Cancel (ADR-0044). *@
<form class="mud-ex-grid-filter" @onsubmit="Apply" @onsubmit:preventDefault>
    @* The form's default button: the first submit button, which implicit submission clicks. *@
    <button type="submit" class="mud-ex-grid-filter-default" hidden tabindex="-1" aria-hidden="true"></button>
    @if (_awaiting)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mud-ex-grid-filter-loading" />
    }
    else if (_domain is { IsTooMany: false } domain && _chosen is { } chosen)
    {
        var search = _searchText ?? "";
        var shown = domain.Values.Where(v => FilterPanelChoices.Matches(search, TextOf(v))).ToArray();
        <MudTextField @ref="_search" T="string" @bind-Value="_searchText" Immediate="true"
                      Label="@Own(MudExGridWords.Search)" Variant="Variant.Outlined" Margin="Margin.Dense"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      Class="mud-ex-grid-filter-search" />
        @if (FilterPanelChoices.OffersAddToFilter(Context.Current, search))
        {
            <MudCheckBox T="bool" @bind-Value="_addToCurrent" Label="@Own(MudExGridWords.AddToFilter)"
                         Dense="true" Size="Size.Small" Class="mud-ex-grid-filter-add" />
        }
        <div class="mud-ex-grid-filter-values" @onkeydown="OnValueListKey">
            @* "(Select All)" over the values shown, with Excel's mixed state (ADR-0009). *@
            <MudCheckBox T="bool?" TriState="true" Value="@SelectAllValue(shown, chosen)"
                         ValueChanged="@(_ => FilterPanelChoices.ToggleAll(shown, chosen))"
                         Label="@Own(search.Length > 0 ? MudExGridWords.SelectAllSearchResults : MudExGridWords.SelectAll)"
                         Dense="true" Size="Size.Small" Class="mud-ex-grid-filter-all" />
            @foreach (var value in shown)
            {
                var item = value;
                <MudCheckBox T="bool" Value="@chosen.Contains(item)" ValueChanged="@(on => Choose(item, on))"
                             Label="@TextOf(item)" Dense="true" Size="Size.Small" Class="mud-ex-grid-filter-value" />
            }
        </div>
    }
    else
    {
        <MudSelect @ref="_operatorField" T="FilterOperator" Value="_operator" ValueChanged="OnOperatorChanged"
                   Label="@Mud("MudDataGrid_Operator")" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                   OpenChanged="ReportPopup" Class="mud-ex-grid-filter-operator">
            @foreach (var op in Context.Allowed)
            {
                <MudSelectItem T="FilterOperator" Value="op">@OperatorWord(op)</MudSelectItem>
            }
        </MudSelect>
        @if (FilterPanelChoices.TakesOperand(_operator))
        {
            @OperandField(_first)
        }
        @* A second condition, joined by And or Or, as Excel's Custom AutoFilter (ADR-0009). *@
        <MudRadioGroup T="FilterCombinator" @bind-Value="_combinator" Class="mud-ex-grid-filter-join">
            <MudRadio T="FilterCombinator" Value="FilterCombinator.And" Dense="true" Size="Size.Small">@Own(MudExGridWords.JoinAnd)</MudRadio>
            <MudRadio T="FilterCombinator" Value="FilterCombinator.Or" Dense="true" Size="Size.Small">@Own(MudExGridWords.JoinOr)</MudRadio>
        </MudRadioGroup>
        <MudSelect T="FilterOperator?" @bind-Value="_secondOperator"
                   Label="@Own(MudExGridWords.SecondCondition)" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                   OpenChanged="ReportPopup" Class="mud-ex-grid-filter-second">
            <MudSelectItem T="FilterOperator?" Value="@((FilterOperator?)null)">@Own(MudExGridWords.NoSecondCondition)</MudSelectItem>
            @foreach (var op in Context.Allowed)
            {
                <MudSelectItem T="FilterOperator?" Value="@((FilterOperator?)op)">@OperatorWord(op)</MudSelectItem>
            }
        </MudSelect>
        @if (_secondOperator is { } second && FilterPanelChoices.TakesOperand(second))
        {
            @OperandField(_second)
        }
    }
    <div class="mud-ex-grid-filter-actions">
        <MudButton ButtonType="ButtonType.Submit" Disabled="@(!CanApply)" Color="Color.Primary" Size="Size.Small"
                   Class="mud-ex-grid-filter-apply">@Mud("MudDataGrid_Apply")</MudButton>
        <MudButton @ref="_cancel" OnClick="Context.Close" Size="Size.Small" Class="mud-ex-grid-filter-cancel">@Mud("MudDataGrid_Cancel")</MudButton>
    </div>
</form>

@code {
    /// <summary>One condition's operand, typed as the column's values are (ADR-0023). The
    /// first condition and the second each hold one, and the same field renders either.</summary>
    private sealed class OperandState
    {
        public string? Text;
        public decimal? Number;
        public DateTime? Date;
        public bool? Flag;

        // The field that edits it, whichever the column's type draws: what E focuses where
        // no value list stands (ADR-0044).
        public MudTextField<string>? TextField;
        public MudNumericField<decimal?>? NumberField;
        public MudDatePicker? DateField;
        public MudSelect<bool?>? FlagField;
    }

    private DistinctValues? _domain;
    private HashSet<object?>? _chosen;
    private bool _awaiting;
    private string? _searchText;
    private bool _addToCurrent;
    private FilterOperator _operator;
    private readonly OperandState _first = new();
    private readonly OperandState _second = new();
    private FilterOperator? _secondOperator;
    private FilterCombinator _combinator;
    private MudTextField<string>? _search;
    private MudSelect<FilterOperator>? _operatorField;
    private MudButton? _cancel;
    private DomFocusTarget _domFocusOwed;
    // Zero at each opening: the core's popover is keyed by the opening, so each is a new
    // instance of this component, and zero is a request not made (ADR-0044).
    private int _focusedRequest;
    private int _focusedLastRequest;
    private int _focusedSearchRequest;

    private enum DomFocusTarget
    {
        None,
        FirstControl,
        LastControl,
        SearchField,
    }

    [Inject] private ILocalizationInterceptor Localizer { get; set; } = default!;

    /// <summary>The core's contract for the panel (ADR-0009). The core keys its popover
    /// by the opening, so each opening is a new instance of this component.</summary>
    [Parameter, EditorRequired] public FilterPanelContext Context { get; set; } = default!;

    /// <summary>Where the wording comes from.</summary>
    [Parameter, EditorRequired] public MudGridChrome Chrome { get; set; } = default!;

    private string Mud(string key) => MudExGridWords.Mud(Localizer, key);

    private string Own(string id) => MudExGridWords.Own(Chrome, id);

    private string OperatorWord(FilterOperator op)
        => MudExGridWords.MudKeyForOperator(op, Context.Type) is { } key
            ? Mud(key)
            : Own(MudExGridWords.OwnIdForOperator(op));

    /// <summary>A value as the column's cells show it; Blank in the Chrome's own words.</summary>
    private string TextOf(object? value)
        => value is null
            ? Own(MudExGridWords.BlankValue)
            : Context.Format is { } format ? format(value) : Convert.ToString(value, CultureInfo.CurrentCulture) ?? "";

    /// <summary>A condition's operand, typed as the column's values are (ADR-0023);
    /// null while none is given.</summary>
    private object? OperandOf(OperandState state) => Context.Type switch
    {
        ColumnType.Number => state.Number,
        ColumnType.Date => state.Date,
        ColumnType.Boolean => state.Flag,
        _ => string.IsNullOrEmpty(state.Text) ? null : state.Text,
    };

    private object? Operand => OperandOf(_first);

    private static bool? SelectAllValue(IEnumerable<object?> shown, IReadOnlySet<object?> chosen)
        => FilterPanelChoices.StateOfAll(shown, chosen) switch
        {
            SelectAllState.Checked => true,
            SelectAllState.Unchecked => false,
            _ => null,
        };

    /// <summary>A condition's value field, of the column's type, over the state it edits.</summary>
    private RenderFragment OperandField(OperandState state) => Context.Type switch
    {
        ColumnType.Number => @<MudNumericField @ref="state.NumberField" T="decimal?" Value="state.Number" ValueChanged="@(v => state.Number = v)" Immediate="true" HideSpinButtons="true"
                                               Label="@Mud("MudDataGrid_Value")" Variant="Variant.Outlined" Margin="Margin.Dense"
                                               Culture="CultureInfo.InvariantCulture" Class="mud-ex-grid-filter-operand" />,
        ColumnType.Date => @<MudDatePicker @ref="state.DateField" Date="state.Date" DateChanged="@(v => state.Date = v)" Editable="true"
                                           PickerOpened="() => ReportPopup(true)" PickerClosed="() => ReportPopup(false)"
                                           Label="@Mud("MudDataGrid_Value")" Variant="Variant.Outlined" Margin="Margin.Dense"
                                           Class="mud-ex-grid-filter-operand" />,
        // Nothing chosen at first: a true or false the user did not pick would apply a
        // filter they never asked for (WR-2).
        ColumnType.Boolean => @<MudSelect @ref="state.FlagField" T="bool?" Value="state.Flag" ValueChanged="@(v => state.Flag = v)" Label="@Mud("MudDataGrid_Value")"
                                          Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                                          OpenChanged="ReportPopup" Class="mud-ex-grid-filter-operand">
                                   <MudSelectItem T="bool?" Value="true">@Mud("MudDataGrid_True")</MudSelectItem>
                                   <MudSelectItem T="bool?" Value="false">@Mud("MudDataGrid_False")</MudSelectItem>
                               </MudSelect>,
        _ => @<MudTextField @ref="state.TextField" T="string" Value="state.Text" ValueChanged="@(v => state.Text = v)" Immediate="true"
                            Label="@Mud("MudDataGrid_Value")" Variant="Variant.Outlined" Margin="Margin.Dense"
                            Class="mud-ex-grid-filter-operand" />,
    };

    /// <summary>Apply is unavailable until the operator's value is given (WR-2); a value
    /// list can always be applied.</summary>
    private bool CanApply
        => !_awaiting
           && (_chosen is not null || !FilterPanelChoices.TakesOperand(_operator) || Operand is not null);

    protected override void OnParametersSet()
    {
        // Each request asks once (ADR-0039/0044): the first control, or the last for
        // Shift+Tab's wrap from the commands.
        if (Context.FocusRequest != _focusedRequest)
        {
            _focusedRequest = Context.FocusRequest;
            _domFocusOwed = DomFocusTarget.FirstControl;
        }
        if (Context.FocusLastRequest != _focusedLastRequest)
        {
            _focusedLastRequest = Context.FocusLastRequest;
            _domFocusOwed = DomFocusTarget.LastControl;
        }
        if (Context.SearchRequest != _focusedSearchRequest)
        {
            _focusedSearchRequest = Context.SearchRequest;
            _domFocusOwed = DomFocusTarget.SearchField;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var current = Context.Current;
        _operator = FilterPanelChoices.InitialOperator(Context.Type, current, tooMany: false);
        SetOperand(_first, FilterPanelChoices.InitialOperand(current));
        var (secondOperator, secondOperand, combinator) = FilterPanelChoices.InitialSecond(current);
        _secondOperator = secondOperator;
        SetOperand(_second, secondOperand);
        _combinator = combinator;
        if (Context.Mode == FilterUiMode.Condition)
            return;

        _awaiting = true;
        var answer = await Context.RequestDistinctValues();
        _domain = answer;
        _awaiting = false;
        if (answer.IsTooMany)
            _operator = FilterPanelChoices.InitialOperator(Context.Type, current, tooMany: true);
        else
            _chosen = FilterPanelChoices.InitiallyChosen(current, answer);
    }

    private static void SetOperand(OperandState state, object? operand)
    {
        switch (operand)
        {
            case decimal number:
                state.Number = number;
                break;
            case DateTime date:
                state.Date = date;
                break;
            case bool flag:
                state.Flag = flag;
                break;
            case string text:
                state.Text = text;
                break;
        }
    }

    private void OnOperatorChanged(FilterOperator op) => _operator = op;

    /// <summary>A key on the value list: Excel's letters are the core's (ADR-0044), and
    /// every other key is the checkbox's own.</summary>
    private void OnValueListKey(KeyboardEventArgs e) => Context.ValueListKey?.Invoke(e);

    /// <summary>A select's list or the date's calendar opened or closed: an Inner Popup,
    /// reported so that Escape closes it before the panel (ADR-0039).</summary>
    private void ReportPopup(bool open) => Context.InnerPopupChanged?.Invoke(open);

    private void Choose(object? value, bool chosen)
    {
        if (chosen)
            _chosen!.Add(value);
        else
            _chosen!.Remove(value);
    }

    private void Apply()
    {
        if (!CanApply)
            return;
        Context.Apply(_chosen is not null && _domain is { IsTooMany: false } domain
            ? FilterPanelChoices.FromValueList(domain, _chosen, TextOf, _searchText ?? "", _addToCurrent, Context.Current)
            : FilterPanelChoices.FromConditions(
                _operator, Operand, _combinator, _secondOperator,
                _secondOperator is { } second && FilterPanelChoices.TakesOperand(second) ? OperandOf(_second) : null));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // A requested control takes DOM focus once the contents have settled — not while
        // the value list is on its way, when the control about to be shown is not there
        // yet (ADR-0039, KB-29).
        if (_domFocusOwed == DomFocusTarget.None || _awaiting)
            return;
        var target = _domFocusOwed;
        _domFocusOwed = DomFocusTarget.None;
        if (target == DomFocusTarget.FirstControl)
            await FocusFirstAsync();
        else if (target == DomFocusTarget.SearchField)
            await FocusSearchAsync();
        else
            await FocusLastAsync();
    }

    private async Task FocusFirstAsync()
    {
        try
        {
            if (_search is not null && _chosen is not null)
                await _search.FocusAsync();
            else if (_operatorField is not null)
                await _operatorField.FocusAsync();
        }
        catch (Exception ex) when (ex is Microsoft.JSInterop.JSException or Microsoft.JSInterop.JSDisconnectedException or ObjectDisposedException or OperationCanceledException)
        {
        }
    }

    /// <summary>Where a search is typed (ADR-0044): the search box over a value list, the
    /// first condition's value in the condition form — or its operator, while that operator
    /// takes no value.</summary>
    private async Task FocusSearchAsync()
    {
        if (_chosen is not null || !FilterPanelChoices.TakesOperand(_operator))
        {
            await FocusFirstAsync();
            return;
        }
        try
        {
            var focusing = _first.TextField?.FocusAsync() ?? _first.NumberField?.FocusAsync()
                ?? _first.DateField?.FocusAsync() ?? _first.FlagField?.FocusAsync();
            if (focusing is { } pending)
                await pending;
        }
        catch (Exception ex) when (ex is Microsoft.JSInterop.JSException or Microsoft.JSInterop.JSDisconnectedException or ObjectDisposedException or OperationCanceledException)
        {
        }
    }

    private async Task FocusLastAsync()
    {
        if (_cancel is null)
            return;
        try
        {
            await _cancel.FocusAsync();
        }
        catch (Exception ex) when (ex is Microsoft.JSInterop.JSException or Microsoft.JSInterop.JSDisconnectedException or ObjectDisposedException or OperationCanceledException)
        {
        }
    }
}
