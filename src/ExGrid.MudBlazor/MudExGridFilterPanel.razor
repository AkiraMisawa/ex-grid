@* Written in each file, not in an _Imports.razor, whose class Razor makes public (ADR-0201); and
   with global::, as this project's root namespace nests inside ExGrid (the CS0426 trap in AGENTS.md). *@
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using global::ExGrid
@using global::ExGrid.Chrome
@using global::ExGrid.Components
@using global::MudBlazor
@using System.Globalization
@using FilterOperator = global::ExGrid.FilterOperator
@using FilterCombinator = global::ExGrid.FilterCombinator
@* Not the contract (ADR-0201): MudGridChrome draws this part, and no Consumer places it. It is
   public only because Razor makes every component public, is hidden from a Consumer's editor, and
   may change in any version. *@
@attribute [System.ComponentModel.EditorBrowsable(System.ComponentModel.EditorBrowsableState.Never)]
@* The filter panel under MudBlazor (ADR-0009/0030/0039): MudBlazor's own controls under the
   column's commands in the core's one popover (ADR-0044). A value list with a search and a
   Blank entry where the column declares one and the answer arrives; the condition form where
   it declares that, or where the answer is TooMany. It keeps a working state and asks FilterPanelChoices what that
   state means — the rules the built-in panel applies by — so the same choices make the
   same FilterSpec under either Chrome (WR-1).

   Its selects and its date picker open popups of their own, which MudBlazor draws outside
   the grid's root: Inner Popups (ADR-0039). Each is reported through the context's
   InnerPopupChanged as it opens and closes, so that Escape closes it first. MudBlazor keeps
   DOM focus on the control while its popup is open, and without the report the grid would
   take that Escape and close the panel with it. The next Escape reaches the grid and
   closes the panel.

   Enter in a value field is the browser's implicit submission, so Enter submits wherever
   a text field has focus — and the browser does not submit on the Enter that confirms an
   IME's candidate. The default button it clicks is a hidden one that is never disabled,
   and Apply refuses the submit while it is unavailable (WR-2). Gating Enter on Apply's
   disabled button instead dropped it on a Server circuit: the button is enabled a round
   trip after the value is typed, and an Enter typed with the value found it still
   disabled and submitted nothing. The submit reaches the circuit behind the value, so the
   check there sees what was typed.

   The popover opens with the keyboard on the commands above, and this panel takes it only
   when asked: its first control for each change of the context's FocusRequest — Tab from the
   commands — Cancel, its last, for each change of FocusLastRequest, and for SearchRequest —
   E — the field a search is typed into: the search box, or the first condition's value. Tab off
   either end is the core's, whose sentinels around the panel wrap to the commands (KB-31).
   Excel's letters on the value list are handed to the core through ValueListKey; clearing
   the filter is the command above, so the actions are Apply and Cancel (ADR-0044). Each closes the
   panel and carries ex-popover-closes, by which the grid's key listener holds the keys typed while
   the panel goes, a round trip on a circuit, and hands them on where the keyboard lands (ADR-0010,
   ADR-0044's note of 2026-10-12). *@
<form class="mud-ex-grid-filter" @onsubmit="Apply" @onsubmit:preventDefault>
    @* The form's default button: the first submit button, which implicit submission clicks. *@
    <button type="submit" class="mud-ex-grid-filter-default" hidden tabindex="-1" aria-hidden="true"></button>
    @if (_awaiting)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mud-ex-grid-filter-loading" />
    }
    else if (_domain is { IsTooMany: false } domain && _chosen is { } chosen)
    {
        var search = _searchText ?? "";
        var shown = domain.Values.Where(v => FilterPanelChoices.Matches(search, TextOf(v))).ToArray();
        <div style="display: contents" @ref="_searchBox">
            <MudTextField @ref="_search" T="string" @bind-Value="_searchText" Immediate="true"
                          Label="@Own(MudExGridWords.Search)" Variant="Variant.Outlined" Margin="Margin.Dense"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          Class="mud-ex-grid-filter-search" />
        </div>
        @if (FilterPanelChoices.OffersAddToFilter(Context.Current, search))
        {
            <MudCheckBox T="bool" @bind-Value="_addToCurrent" Label="@Own(MudExGridWords.AddToFilter)"
                         Dense="true" Size="Size.Small" Class="mud-ex-grid-filter-add" />
        }
        <div class="mud-ex-grid-filter-values ex-value-list" @onkeydown="OnValueListKeyAsync">
            @* "(Select All)" over the values shown, with Excel's mixed state (ADR-0009). *@
            <MudCheckBox T="bool?" TriState="true" Value="@SelectAllValue(shown, chosen)"
                         ValueChanged="@(_ => FilterPanelChoices.ToggleAll(shown, chosen))"
                         Label="@Own(search.Length > 0 ? MudExGridWords.SelectAllSearchResults : MudExGridWords.SelectAll)"
                         Dense="true" Size="Size.Small" Class="mud-ex-grid-filter-all" />
            @foreach (var value in shown)
            {
                var item = value;
                <MudCheckBox T="bool" Value="@chosen.Contains(item)" ValueChanged="@(on => Choose(item, on))"
                             Label="@TextOf(item)" Dense="true" Size="Size.Small" Class="mud-ex-grid-filter-value" />
            }
        </div>
    }
    else
    {
        <div style="display: contents" @ref="_operatorBox">
            <MudSelect @ref="_operatorField" T="FilterOperator" Value="_operator" ValueChanged="OnOperatorChanged"
                       Label="@Mud("MudDataGrid_Operator")" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                       OpenChanged="ReportPopup" Class="mud-ex-grid-filter-operator">
                @foreach (var op in Context.Allowed)
                {
                    <MudSelectItem T="FilterOperator" Value="op">@OperatorWord(op)</MudSelectItem>
                }
            </MudSelect>
        </div>
        @if (FilterPanelChoices.TakesOperand(_operator))
        {
            <div style="display: contents" @ref="_firstOperandBox">
                @OperandField(_first)
            </div>
        }
        @* A second condition, joined by And or Or, as Excel's Custom AutoFilter (ADR-0009). *@
        <MudRadioGroup T="FilterCombinator" @bind-Value="_combinator" Class="mud-ex-grid-filter-join">
            <MudRadio T="FilterCombinator" Value="FilterCombinator.And" Dense="true" Size="Size.Small">@Own(MudExGridWords.JoinAnd)</MudRadio>
            <MudRadio T="FilterCombinator" Value="FilterCombinator.Or" Dense="true" Size="Size.Small">@Own(MudExGridWords.JoinOr)</MudRadio>
        </MudRadioGroup>
        <MudSelect T="FilterOperator?" @bind-Value="_secondOperator"
                   Label="@Own(MudExGridWords.SecondCondition)" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                   OpenChanged="ReportPopup" Class="mud-ex-grid-filter-second">
            <MudSelectItem T="FilterOperator?" Value="@((FilterOperator?)null)">@Own(MudExGridWords.NoSecondCondition)</MudSelectItem>
            @foreach (var op in Context.Allowed)
            {
                <MudSelectItem T="FilterOperator?" Value="@((FilterOperator?)op)">@OperatorWord(op)</MudSelectItem>
            }
        </MudSelect>
        @if (_secondOperator is { } second && FilterPanelChoices.TakesOperand(second))
        {
            @OperandField(_second)
        }
    }
    <div class="mud-ex-grid-filter-actions">
        <MudButton ButtonType="ButtonType.Submit" Disabled="@(!CanApply)" Color="Color.Primary" Size="Size.Small"
                   Class="mud-ex-grid-filter-apply ex-popover-closes">@Mud("MudDataGrid_Apply")</MudButton>
        <div style="display: contents" @ref="_cancelBox">
            <MudButton @ref="_cancel" OnClick="Context.Close" Size="Size.Small" Class="mud-ex-grid-filter-cancel ex-popover-closes">@Mud("MudDataGrid_Cancel")</MudButton>
        </div>
    </div>
</form>

@code {
    /// <summary>One condition's operand, typed as the column's values are (ADR-0023). The
    /// first condition and the second each hold one, and the same field renders either.</summary>
    private sealed class OperandState
    {
        public string? Text;
        // A number is typed as text and read by FilterPanelChoices, as the built-in panel reads
        // it, in the culture the field shows it in (ticket 96).
        public string? NumberText;
        public DateTime? Date;
        public bool? Flag;

        // The field that edits it, whichever the column's type draws: what E focuses where
        // no value list stands (ADR-0044).
        public MudTextField<string>? TextField;
        public MudTextField<string>? NumberField;
        public MudDatePicker? DateField;
        public MudTextField<string>? MomentField;

        // A date typed into the picker is read by FilterPanelChoices, as the built-in panel reads
        // it (ticket 97): the text last typed, and the converter the picker reads it through,
        // made once so that a render hands the picker the same instance. A DateTimeOffset
        // column's text field edits the same text (ticket 98).
        public string? DateText;
        public OperandDateConverter? DateConverter;
        public MudSelect<bool?>? FlagField;
    }

    private DistinctValues? _domain;
    private HashSet<object?>? _chosen;
    private bool _awaiting;
    private string? _searchText;
    private bool _addToCurrent;
    private FilterOperator _operator;
    private readonly OperandState _first = new();
    private readonly OperandState _second = new();
    private FilterOperator? _secondOperator;
    private FilterCombinator _combinator;
    private MudTextField<string>? _search;
    private MudSelect<FilterOperator>? _operatorField;
    private MudButton? _cancel;
    // The boxes of the controls the panel hands the keyboard to, for the core's focus function: a
    // MudSelect, a date picker and a MudButton expose no element of their own, and the core gives
    // DOM focus to the first control inside a box (ADR-0204). Laid out as if they were not there.
    private ElementReference _searchBox;
    private ElementReference _operatorBox;
    private ElementReference _firstOperandBox;
    private ElementReference _cancelBox;
    private DomFocusTarget _domFocusOwed;
    // Zero at each opening: the core's popover is keyed by the opening, so each is a new
    // instance of this component, and zero is a request not made (ADR-0044).
    private int _focusedRequest;
    private int _focusedLastRequest;
    private int _focusedSearchRequest;

    private enum DomFocusTarget
    {
        None,
        FirstControl,
        LastControl,
        SearchField,
    }

    [Inject] private ILocalizationInterceptor Localizer { get; set; } = default!;

    /// <summary>The core's contract for the panel (ADR-0009). The core keys its popover
    /// by the opening, so each opening is a new instance of this component.</summary>
    [Parameter, EditorRequired] public FilterPanelContext Context { get; set; } = default!;

    /// <summary>Where the wording comes from.</summary>
    [Parameter, EditorRequired] public MudGridChrome Chrome { get; set; } = default!;

    private string Mud(string key) => MudExGridWords.Mud(Localizer, key);

    private string Own(string id) => MudExGridWords.Own(Chrome, id);

    private string OperatorWord(FilterOperator op)
        => MudExGridWords.MudKeyForOperator(op, Context.Type) is { } key
            ? Mud(key)
            : Own(MudExGridWords.OwnIdForOperator(op));

    /// <summary>A value as the column's cells show it — its Format, or a date's ISO form
    /// (ADR-0006) — and Blank in the Chrome's own words.</summary>
    private string TextOf(object? value)
        => value is null ? Own(MudExGridWords.BlankValue) : FilterPanelChoices.ValueText(value, Context.Format);

    /// <summary>A condition's operand, typed as the column's values are (ADR-0023);
    /// null while none is given.</summary>
    private object? OperandOf(OperandState state) => Context.Type switch
    {
        ColumnType.Number => NumberReading(state).Value,
        ColumnType.Date => Context.DateType switch
        {
            // Read from its text: a calendar has no offset to give (ADR-0023, section of 2026-10-02).
            DateType.DateTimeOffset => DateReading(state).Value,
            DateType.DateOnly => state.Date is { } day ? DateOnly.FromDateTime(day) : null,
            _ => state.Date,
        },
        ColumnType.Boolean => state.Flag,
        _ => string.IsNullOrEmpty(state.Text) ? null : state.Text,
    };

    private object? Operand => OperandOf(_first);

    private static bool? SelectAllValue(IEnumerable<object?> shown, IReadOnlySet<object?> chosen)
        => FilterPanelChoices.StateOfAll(shown, chosen) switch
        {
            SelectAllState.Checked => true,
            SelectAllState.Unchecked => false,
            _ => null,
        };

    /// <summary>A condition's value field, of the column's type, over the state it edits.</summary>
    private RenderFragment OperandField(OperandState state) => Context.Type switch
    {
        ColumnType.Number => @<MudTextField @ref="state.NumberField" T="string" Value="state.NumberText" ValueChanged="@(v => state.NumberText = v)" Immediate="true"
                                            Label="@Mud("MudDataGrid_Value")" Variant="Variant.Outlined" Margin="Margin.Dense"
                                            Error="@NumberReading(state).IsRefused" ErrorText="@NumberRefusal(state)"
                                            Class="mud-ex-grid-filter-operand" />,
        // A day picked from a calendar has no offset, which a DateTimeOffset column refuses, so
        // that column's operand is typed (ADR-0023, section of 2026-10-02).
        ColumnType.Date when Context.DateType == DateType.DateTimeOffset
            => @<MudTextField @ref="state.MomentField" T="string" Value="state.DateText" ValueChanged="@(v => state.DateText = v)" Immediate="true"
                              Label="@Mud("MudDataGrid_Value")" Variant="Variant.Outlined" Margin="Margin.Dense"
                              Error="@DateReading(state).IsRefused" ErrorText="@DateRefusal(state)"
                              Class="mud-ex-grid-filter-operand" />,
        ColumnType.Date => @<MudDatePicker @ref="state.DateField" @attributes="DateOf(state)" DateChanged="@(v => state.Date = v)" Editable="true"
                                           Converter="@(state.DateConverter ??= new OperandDateConverter(state, DateReading))" DateFormat="yyyy-MM-dd"
                                           Error="@DateReading(state).IsRefused" ErrorText="@DateRefusal(state)"
                                           PickerOpened="() => ReportPopup(true)" PickerClosed="() => ReportPopup(false)"
                                           Label="@Mud("MudDataGrid_Value")" Variant="Variant.Outlined" Margin="Margin.Dense"
                                           Class="mud-ex-grid-filter-operand" />,
        // Nothing chosen at first: a true or false the user did not pick would apply a
        // filter they never asked for (WR-2).
        ColumnType.Boolean => @<MudSelect @ref="state.FlagField" T="bool?" Value="state.Flag" ValueChanged="@(v => state.Flag = v)" Label="@Mud("MudDataGrid_Value")"
                                          Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                                          OpenChanged="ReportPopup" Class="mud-ex-grid-filter-operand">
                                   <MudSelectItem T="bool?" Value="true">@Mud("MudDataGrid_True")</MudSelectItem>
                                   <MudSelectItem T="bool?" Value="false">@Mud("MudDataGrid_False")</MudSelectItem>
                               </MudSelect>,
        _ => @<MudTextField @ref="state.TextField" T="string" Value="state.Text" ValueChanged="@(v => state.Text = v)" Immediate="true"
                            Label="@Mud("MudDataGrid_Value")" Variant="Variant.Outlined" Margin="Margin.Dense"
                            Class="mud-ex-grid-filter-operand" />,
    };

    /// <summary>
    /// The date field's text, read and written as the built-in panel's is (ADR-0023, ticket 97):
    /// a date shows in its ISO form, which reads back as itself, and typed text is read by
    /// <see cref="FilterPanelChoices.ReadOperand"/> in the current culture — ticket 94's ISO forms
    /// exactly, anything else in the culture alone. A refused text is no date, and the field shows
    /// why. MudBlazor's own reading was the invariant culture's, under which <c>05/01/2026</c> is
    /// 1 May whatever the user's culture. The picker needs a <c>DateFormat</c> beside the
    /// converter: without one it writes a date in the culture's short form, never asking the
    /// converter. A date is read as the column's declared date type (ticket 98), and a
    /// <see cref="DateOnly"/> stands in the picker as its midnight.
    /// </summary>
    private sealed class OperandDateConverter(OperandState state, Func<OperandState, OperandReading> read) : IReversibleConverter<DateTime?, string>
    {
        // The day alone at midnight, the day and time otherwise: both ISO forms read back exactly.
        public string Convert(DateTime? value) => value switch
        {
            null => "",
            { TimeOfDay.Ticks: 0 } day => day.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
            { } date => FilterPanelChoices.OperandText(date, CultureInfo.CurrentCulture),
        };

        public DateTime? ConvertBack(string value)
        {
            state.DateText = value;
            return read(state).Value switch
            {
                DateTime date => date,
                DateOnly day => day.ToDateTime(TimeOnly.MinValue),
                _ => null,
            };
        }
    }

    /// <summary>
    /// The picker's date, given only while the condition has one. MudDatePicker's Date is a
    /// setter, run on every render of the panel. A date set again within 100 ms of the last is
    /// ignored, but a null one set later, after a refused text, clears the text and revalidates
    /// the field, which writes its Error back to false over the panel's own: the refusal
    /// vanished while Apply stayed unavailable (ADR-0023, principle 1). Not given, a parameter
    /// keeps its value, and the picker its text and its error.
    /// </summary>
    private static IReadOnlyDictionary<string, object> DateOf(OperandState state)
        => state.Date is { } date ? new Dictionary<string, object> { [nameof(MudDatePicker.Date)] = date } : NoDate;

    private static readonly IReadOnlyDictionary<string, object> NoDate = new Dictionary<string, object>();

    /// <summary>A condition's date as FilterPanelChoices reads the text last typed into the picker;
    /// nothing typed reads as no refusal.</summary>
    private OperandReading DateReading(OperandState state)
        => FilterPanelChoices.ReadOperand(ColumnType.Date, state.DateText ?? "", CultureInfo.CurrentCulture, Context.DateType);

    /// <summary>Why a condition's date is refused: the Chrome's word for it where it has one, and
    /// otherwise what was typed and why, in the core's English. Null where it reads.</summary>
    private string? DateRefusal(OperandState state)
    {
        var reading = DateReading(state);
        if (!reading.IsRefused)
            return null;
        var id = reading.Refusal switch
        {
            OperandRefusal.ReadsTwoWays => MudExGridWords.OperandReadsTwoWays,
            OperandRefusal.NotTheColumnsDateForm => MudExGridWords.OperandNotTheColumnsDateForm,
            _ => MudExGridWords.OperandNotReadable,
        };
        return Chrome.Label?.Invoke(id)
            ?? FilterPanelChoices.RefusalText(reading, state.DateText ?? "", CultureInfo.CurrentCulture);
    }

    /// <summary>A condition's number as FilterPanelChoices reads it, in the current culture —
    /// the reading the built-in panel takes (ADR-0023; ticket 96).</summary>
    private static OperandReading NumberReading(OperandState state)
        => FilterPanelChoices.ReadOperand(ColumnType.Number, state.NumberText ?? "", CultureInfo.CurrentCulture);

    /// <summary>Why a condition's number is refused: the Chrome's word for it where it has one,
    /// and otherwise what was typed and why, in the core's English. Null where it reads.</summary>
    private string? NumberRefusal(OperandState state)
    {
        var reading = NumberReading(state);
        if (!reading.IsRefused)
            return null;
        var id = reading.Refusal == OperandRefusal.ReadsTwoWays ? MudExGridWords.OperandReadsTwoWays : MudExGridWords.OperandNotReadable;
        return Chrome.Label?.Invoke(id)
            ?? FilterPanelChoices.RefusalText(reading, state.NumberText ?? "", CultureInfo.CurrentCulture);
    }

    /// <summary>Apply is unavailable until the operator's value is given (WR-2), and, over a
    /// value list, while its answer keeps nothing — nothing ticked among the values shown
    /// (FilterPanelChoices.CanApply, ticket 76).</summary>
    private bool CanApply
        => !_awaiting
           && (_chosen is not null && _domain is { IsTooMany: false } domain
               ? FilterPanelChoices.CanApply(ValueListAnswer(domain, _chosen))
               : !FilterPanelChoices.TakesOperand(_operator) || Operand is not null);

    /// <summary>The value list's answer, by FilterPanelChoices' rules: the checked values,
    /// among a search's matches while one stands.</summary>
    private FilterSpec? ValueListAnswer(DistinctValues domain, HashSet<object?> chosen)
        => FilterPanelChoices.FromValueList(domain, chosen, TextOf, _searchText ?? "", _addToCurrent, Context.Current);

    protected override void OnParametersSet()
    {
        // Each request asks once (ADR-0039/0044): the first control, or the last for
        // Shift+Tab's wrap from the commands.
        if (Context.FocusRequest != _focusedRequest)
        {
            _focusedRequest = Context.FocusRequest;
            _domFocusOwed = DomFocusTarget.FirstControl;
        }
        if (Context.FocusLastRequest != _focusedLastRequest)
        {
            _focusedLastRequest = Context.FocusLastRequest;
            _domFocusOwed = DomFocusTarget.LastControl;
        }
        if (Context.SearchRequest != _focusedSearchRequest)
        {
            _focusedSearchRequest = Context.SearchRequest;
            _domFocusOwed = DomFocusTarget.SearchField;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var current = Context.Current;
        _operator = FilterPanelChoices.InitialOperator(Context.Type, current, tooMany: false);
        SetOperand(_first, FilterPanelChoices.InitialOperand(current));
        var (secondOperator, secondOperand, combinator) = FilterPanelChoices.InitialSecond(current);
        _secondOperator = secondOperator;
        SetOperand(_second, secondOperand);
        _combinator = combinator;
        if (Context.Mode == FilterUiMode.Condition)
            return;

        _awaiting = true;
        var answer = await Context.RequestDistinctValues();
        _domain = answer;
        _awaiting = false;
        if (answer.IsTooMany)
            _operator = FilterPanelChoices.InitialOperator(Context.Type, current, tooMany: true);
        else
            _chosen = FilterPanelChoices.InitiallyChosen(current, answer);
    }

    private static void SetOperand(OperandState state, object? operand)
    {
        switch (operand)
        {
            case decimal or double or float or int or long:
                state.NumberText = FilterPanelChoices.OperandText(operand, CultureInfo.CurrentCulture);
                break;
            case DateTime date:
                state.Date = date;
                break;
            case DateOnly day:
                state.Date = day.ToDateTime(TimeOnly.MinValue);
                break;
            case DateTimeOffset moment:
                state.DateText = FilterPanelChoices.OperandText(moment, CultureInfo.CurrentCulture);
                break;
            case bool flag:
                state.Flag = flag;
                break;
            case string text:
                state.Text = text;
                break;
        }
    }

    private void OnOperatorChanged(FilterOperator op) => _operator = op;

    /// <summary>A key on the value list: Excel's letters are the core's (ADR-0044), and
    /// every other key is the checkbox's own.</summary>
    private Task OnValueListKeyAsync(KeyboardEventArgs e) => Context.ValueListKey?.Invoke(e) ?? Task.CompletedTask;

    /// <summary>A select's list or the date's calendar opened or closed: an Inner Popup,
    /// reported so that Escape closes it before the panel (ADR-0039).</summary>
    private void ReportPopup(bool open) => Context.InnerPopupChanged?.Invoke(open);

    private void Choose(object? value, bool chosen)
    {
        if (chosen)
            _chosen!.Add(value);
        else
            _chosen!.Remove(value);
    }

    private void Apply()
    {
        if (!CanApply)
            return;
        Context.Apply(_chosen is not null && _domain is { IsTooMany: false } domain
            ? ValueListAnswer(domain, _chosen)
            : FilterPanelChoices.FromConditions(
                _operator, Operand, _combinator, _secondOperator,
                _secondOperator is { } second && FilterPanelChoices.TakesOperand(second) ? OperandOf(_second) : null));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // A requested control takes DOM focus once the contents have settled — not while
        // the value list is on its way, when the control about to be shown is not there
        // yet (ADR-0039, KB-29).
        if (_domFocusOwed == DomFocusTarget.None || _awaiting)
            return;
        var target = _domFocusOwed;
        _domFocusOwed = DomFocusTarget.None;
        if (target == DomFocusTarget.FirstControl)
            await FocusFirstAsync();
        else if (target == DomFocusTarget.SearchField)
            await FocusSearchAsync();
        else
            await FocusLastAsync();
    }

    // Each through the core's focus function where the context carries one (ADR-0204): the core
    // grants it only while the keyboard is still this grid's, so a request landing a round trip late
    // takes nothing from another grid. Without one — a context the core did not make — the control's
    // own FocusAsync.
    private Task FocusFirstAsync()
        => _search is not null && _chosen is not null
            ? TakeAsync(_searchBox, _search.FocusAsync)
            : TakeAsync(_operatorBox, _operatorField is { } field ? field.FocusAsync : null);

    /// <summary>Where a search is typed (ADR-0044): the search box over a value list, the
    /// first condition's value in the condition form — or its operator, while that operator
    /// takes no value.</summary>
    private Task FocusSearchAsync()
        => _chosen is not null || !FilterPanelChoices.TakesOperand(_operator)
            ? FocusFirstAsync()
            : TakeAsync(_firstOperandBox, FirstOperandFocus());

    private Func<ValueTask>? FirstOperandFocus()
        => _first.TextField is { } text ? text.FocusAsync
            : _first.NumberField is { } number ? number.FocusAsync
            : _first.DateField is { } date ? date.FocusAsync
            : _first.MomentField is { } moment ? moment.FocusAsync
            : _first.FlagField is { } flag ? flag.FocusAsync
            : null;

    private Task FocusLastAsync() => TakeAsync(_cancelBox, _cancel is { } cancel ? cancel.FocusAsync : null);

    private Task TakeAsync(ElementReference box, Func<ValueTask>? own)
        => Context.TakeFocus is { } take && box.Id is not null
            ? take(box, false)
            : FocusQuietlyAsync(own?.Invoke());

    /// <summary>A focus the panel asked for, if there was a control to ask: a popover can
    /// close before the call lands, and a closed circuit focuses nothing; neither is worth
    /// an exception.</summary>
    private static async Task FocusQuietlyAsync(ValueTask? focusing)
    {
        if (focusing is not { } pending)
            return;
        try
        {
            await pending;
        }
        catch (Exception ex) when (ex is Microsoft.JSInterop.JSException or Microsoft.JSInterop.JSDisconnectedException or ObjectDisposedException or OperationCanceledException)
        {
        }
    }
}
