@* Written in each component, not in an _Imports.razor, whose class Razor makes public (ADR-0201).
   Every product using is written with global::: inside ExChart.Components a plain "ExChart.Engine"
   would be looked up against this component's class first (the CS0426 trap in AGENTS.md). *@
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using global::ExChart.Chrome
@using global::ExChart.Engine
@implements IAsyncDisposable

<div @ref="_root" class="ex-chart" style="@RootStyle" aria-busy="@(Busy ? "true" : null)">
    <div data-ex-notice="stylesheet" data-ex-stylesheet="@ShippedAssets.StylesheetName" data-ex-stamp="@ShippedAssets.StylesheetStamp" style="display: none">@StylesheetNotice</div>
    @if (Chrome?.Toolbar(ToolbarContext) is { } toolbar)
    {
        @toolbar
    }
    else
    {
        <div class="ex-chart-toolbar" role="toolbar" aria-label="@ToolbarName">
            <button type="button" class="ex-chart-button ex-chart-filters-toggle" aria-expanded="@(_filtersOpen ? "true" : "false")" @onclick="ToggleFilters">Chart Filters</button>
            <button type="button" class="ex-chart-button ex-chart-reset" disabled="@(_range is null)" @onclick="ResetRangeAsync">Reset range</button>
            <button type="button" class="ex-chart-button ex-chart-table-toggle" aria-expanded="@(_tableOpen ? "true" : "false")" @onclick="ToggleTable">View as table</button>
            <span class="ex-chart-downloads" role="group" aria-label="Download">
                <button type="button" class="ex-chart-button ex-chart-download-csv" disabled="@CsvUnavailable" title="@CsvTitle" @onclick="DownloadCsvAsync">CSV</button>
                <button type="button" class="ex-chart-button ex-chart-download-svg" disabled="@FilesUnavailable" @onclick="DownloadSvgAsync">SVG</button>
                <button type="button" class="ex-chart-button ex-chart-download-png" disabled="@FilesUnavailable" @onclick="DownloadPngAsync">PNG</button>
            </span>
        </div>
        @if (_filtersOpen)
        {
            <div class="ex-chart-filters" role="group" aria-label="Chart Filters">
                <label class="ex-chart-filter">
                    <span>From</span>
                    <input class="ex-chart-from" type="text" placeholder="@RangeHint" @bind="_fromText" />
                </label>
                <label class="ex-chart-filter">
                    <span>To</span>
                    <input class="ex-chart-to" type="text" placeholder="@RangeHint" @bind="_toText" />
                </label>
                <button type="button" class="ex-chart-button ex-chart-apply" @onclick="ApplyTypedRangeAsync">Apply</button>
                @if (ScaleSwitchable)
                {
                    <label class="ex-chart-filter">
                        <span>Axis</span>
                        <select class="ex-chart-scale" @bind:get="ScaleText" @bind:set="SetScaleAsync">
                            <option value="Proportional">Proportional</option>
                            <option value="Categories">Categories</option>
                        </select>
                    </label>
                }
                @if (_filterError is { } error)
                {
                    <span class="ex-chart-filter-error" role="alert">@error</span>
                }
            </div>
        }
    }
    @if (_refusal is { } refusal)
    {
        @* A spec its sources cannot answer, or an answer older than the data shown: said in the
           chart's place, never drawn as if it were the answer (ADR-0344, spine rule 1). *@
        <p class="ex-chart-source-refusal" role="alert">@refusal</p>
    }
    <div class="ex-chart-stage" style="@StageStyle" hidden="@(_refusal is not null)" @oncontextmenu="OpenMenu" @oncontextmenu:preventDefault>
        <svg class="ex-chart-svg" width="@Svg.N(Width)" height="@Svg.N(Height)" role="img" aria-labelledby="@_summaryId">
            <title id="@_summaryId">@_summary</title>
            @Drawing
        </svg>
        @for (var i = 0; i < _scene.Panels.Count; i++)
        {
            var plot = _scene.Panels[i].Plot;
            <div class="ex-chart-hit" data-ex-panel="@i" data-ex-x="@Svg.N(plot.X)" data-ex-y="@Svg.N(plot.Y)" style="@HitStyle(plot)" @ondblclick="ResetRangeAsync"></div>
        }
        @Tooltip
    </div>
    @if (_menu is not null)
    {
        @* The menu's frame is ExChart's under any Chrome (ADR-0281): it opens where it was asked
           for, and a click anywhere else, Escape or a chosen command closes it. *@
        <div class="ex-chart-menu-backdrop" @onclick="CloseMenu" @oncontextmenu="CloseMenu" @oncontextmenu:preventDefault></div>
        <div @ref="_menuFrame" class="ex-chart-menu" role="menu" aria-label="@MenuContext.Name" tabindex="-1" style="@MenuStyle" @onkeydown="OnMenuKey">
            @if (Chrome?.Menu(MenuContext) is { } menu)
            {
                @menu
            }
            else
            {
                @foreach (var command in MenuContext.Commands)
                {
                    <button type="button" role="menuitem" class="ex-chart-menu-item" data-ex-command="@command.Id" disabled="@(!command.Enabled)" @onclick="command.Invoke">@command.Label</button>
                }
            }
        </div>
    }
    @if (_scriptRefused)
    {
        <p class="ex-chart-script-notice" role="alert">@ScriptNotice</p>
    }
    @if (_scene.Notes.Count > 0)
    {
        <ul class="ex-chart-notes">
            @foreach (var note in _scene.Notes)
            {
                <li>@note</li>
            }
        </ul>
    }
    @if (_tableOpen && ThinnedAtSource)
    {
        <p class="ex-chart-table-notice" role="note">@ThinnedAtSourceWords</p>
    }
    else if (_tableOpen)
    {
        <div class="ex-chart-table-wrap">
            <table class="ex-chart-table">
                <caption>@(string.IsNullOrWhiteSpace(Title) ? "Chart data" : Title)</caption>
                <thead>
                    <tr>
                        @foreach (var h in _table!.Header)
                        {
                            <th scope="col">@h</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _table.Rows)
                    {
                        <tr>
                            <th scope="row">@row[0]</th>
                            @for (var c = 1; c < row.Count; c++)
                            {
                                <td>@row[c]</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
