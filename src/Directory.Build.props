<Project>
  <!-- The shipped packages (ADR-0042). The repository-wide properties still apply: MSBuild
       stops at the nearest Directory.Build.props, so this one imports the root's first. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <!-- A tag is the only place a version is written (ADR-0042): the release workflow passes
         it in, and anything packed by hand says plainly that it is not a release. -->
    <Version>0.0.0-dev</Version>
    <Authors>AkiraMisawa</Authors>
    <Copyright>Copyright (c) 2026 AkiraMisawa</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/AkiraMisawa/ex-grid</PackageProjectUrl>
    <RepositoryUrl>https://github.com/AkiraMisawa/ex-grid</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>blazor;grid;datagrid;excel;virtualization;razor-components</PackageTags>
    <!-- Every public member is documented, and the build says so when one is not: with the
         repository's TreatWarningsAsErrors, a missing comment (CS1591) fails it (ADR-0042). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Source Link comes with the SDK; the symbol package carries what it points at. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(GITHUB_ACTIONS)' == 'true' ">
    <!-- Paths in the PDB are normalised, so a package built in CI is reproducible. -->
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- The public surface's baseline (ADR-0201): every public member is declared in
       PublicAPI.Shipped.txt or PublicAPI.Unshipped.txt beside the project, and the build fails on
       one that is not (RS0016) or one declared and gone (RS0017), as it does on an undocumented
       one. The analyzer is a private asset, so no package depends on it. The cut before a tag
       moves Unshipped into Shipped (ADR-0190). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.3.0" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>
  <PropertyGroup>
    <WarningsAsErrors>$(WarningsAsErrors);RS0016;RS0017</WarningsAsErrors>
    <!-- The analyzer's other rules are not this baseline's. RS0026 and RS0027 ask that a member
         with optional parameters be reshaped, and 0.1.0 reviews types, not members (ADR-0201): the
         review before 1.0 reads them. RS0041 reports the BuildRenderTree that Razor generates
         with nullable annotations off, which no source here writes. -->
    <NoWarn>$(NoWarn);RS0026;RS0027;RS0041</NoWarn>
  </PropertyGroup>
</Project>
