@* Written in each file, not in an _Imports.razor, whose class Razor makes public (ADR-0201); and
   with global::, as this project's root namespace nests inside ExChart (the CS0426 trap in AGENTS.md). *@
@using System.Globalization
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using global::ExChart.Chrome
@using global::ExChart.Engine
@using global::MudBlazor
@* Not the contract (ADR-0201): MudChartChrome draws this part, and no Consumer places it. *@
@attribute [System.ComponentModel.EditorBrowsable(System.ComponentModel.EditorBrowsableState.Never)]
@* The chart's toolbar under MudBlazor (ADR-0281): ExChart's commands in its order, the three toggles
   and Reset range as text MudButtons, the downloads as one MudMenu; then, while Chart Filters is open,
   its range in MudBlazor's inputs and the axis switch. What is typed is held here until Apply, and
   ExChart reads it: a value it cannot read is said in an error MudAlert, the refusal Error stays for
   (ADR-0281), never guessed. *@
<div class="mud-ex-chart-toolbar" role="toolbar" aria-label="@Context.Name">
    @foreach (var command in Context.Commands.Where(c => !IsDownload(c.Id)))
    {
        <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Chrome.IconFor(command.Id)"
                   Color="@(command.Expanded == true ? Color.Primary : Color.Default)"
                   Disabled="@(!command.Enabled)" OnClick="command.Invoke"
                   Class="mud-ex-chart-toolbar-button" data-ex-command="@command.Id"
                   aria-expanded="@(command.Expanded is { } open ? (open ? "true" : "false") : null)">@command.Label</MudButton>
    }
    <MudMenu Label="Download" StartIcon="@Icons.Material.Filled.Download" EndIcon="@Icons.Material.Filled.ArrowDropDown"
             Variant="Variant.Text" Size="Size.Small" Dense="true" Class="mud-ex-chart-download-menu">
        @foreach (var command in Context.Commands.Where(c => IsDownload(c.Id)))
        {
            <MudMenuItem Icon="@Chrome.IconFor(command.Id)" Disabled="@(!command.Enabled)" OnClick="command.Invoke" data-ex-command="@command.Id">@command.Label</MudMenuItem>
        }
    </MudMenu>
</div>
@if (Context.Filters is { } filters)
{
    <div class="mud-ex-chart-filters" role="group" aria-label="Chart Filters">
        @switch (filters.Values)
        {
            case AxisValues.Dates:
                <MudDatePicker Label="From" Date="@AsDate(_from)" DateChanged="@(d => _from = AsText(d))" DateFormat="yyyy-MM-dd" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" Class="mud-ex-chart-from" />
                <MudDatePicker Label="To" Date="@AsDate(_to)" DateChanged="@(d => _to = AsText(d))" DateFormat="yyyy-MM-dd" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" Class="mud-ex-chart-to" />
                break;
            case AxisValues.Labels:
                <MudSelect T="string" Label="From" @bind-Value="_from" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" Class="mud-ex-chart-from">
                    @foreach (var label in filters.Labels)
                    {
                        <MudSelectItem Value="@label">@label</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="string" Label="To" @bind-Value="_to" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" Class="mud-ex-chart-to">
                    @foreach (var label in filters.Labels)
                    {
                        <MudSelectItem Value="@label">@label</MudSelectItem>
                    }
                </MudSelect>
                break;
            default:
                <MudTextField T="string" Label="From" @bind-Value="_from" Placeholder="@filters.Hint" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" Class="mud-ex-chart-from" />
                <MudTextField T="string" Label="To" @bind-Value="_to" Placeholder="@filters.Hint" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" Class="mud-ex-chart-to" />
                break;
        }
        <MudButton Variant="Variant.Filled" Color="Color.Primary" DropShadow="false" Class="mud-ex-chart-apply" OnClick="() => filters.Apply(_from, _to)">Apply</MudButton>
        @if (filters.Scale is { } scale)
        {
            <MudSelect T="AxisScale" Label="Axis" Value="scale" ValueChanged="filters.SetScale" Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" Class="mud-ex-chart-scale">
                <MudSelectItem Value="AxisScale.Proportional">Proportional</MudSelectItem>
                <MudSelectItem Value="AxisScale.Categories">Categories</MudSelectItem>
            </MudSelect>
        }
    </div>
    @if (filters.Error is { } error)
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="mud-ex-chart-filter-error">@error</MudAlert>
    }
}

@code {
    private ChartToolbarContext? _last;
    private bool _skip;
    private (string? From, string? To)? _taken;
    private string? _from;
    private string? _to;

    /// <summary>What ExChart hands the toolbar.</summary>
    [Parameter, EditorRequired] public ChartToolbarContext Context { get; set; } = null!;

    /// <summary>The Chrome, for its icons.</summary>
    [Parameter, EditorRequired] public MudChartChrome Chrome { get; set; } = null!;

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        _skip = Equals(_last, Context);
        _last = Context;
        // The range as ExChart holds it replaces what was typed whenever it changes: Chart Filters
        // opened, a drag narrowed the range, Reset range returned it.
        var held = Context.Filters is { } f ? (f.From, f.To) : ((string?, string?)?)null;
        if (held != _taken)
        {
            _taken = held;
            (_from, _to) = held ?? (null, null);
        }
    }

    // A context equal to the last draws the same toolbar: the chart renders on every pointer move,
    // and this part is not to render with it (ADR-0252). What the user does here still renders it.
    /// <inheritdoc />
    protected override bool ShouldRender()
    {
        var skip = _skip;
        _skip = false;
        return !skip;
    }

    private static bool IsDownload(string id) =>
        id is ChartCommandIds.DownloadCsv or ChartCommandIds.DownloadSvg or ChartCommandIds.DownloadPng;

    private static DateTime? AsDate(string? text) =>
        DateOnly.TryParseExact(text, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var d) ? d.ToDateTime(TimeOnly.MinValue) : null;

    private static string? AsText(DateTime? date) => date?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
}
