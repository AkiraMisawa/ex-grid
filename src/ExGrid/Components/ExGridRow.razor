@typeparam TRow where TRow : class
@* Written in each component, not in an _Imports.razor, whose class Razor makes public (ADR-0201).
   The Web namespace is required for @@onscroll and friends to compile as event handlers rather
   than as plain HTML attributes: without it the markup builds and renders while quietly listening
   to nothing. *@
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@* Not the contract (ADR-0201): the grid places this component, and no Consumer does. It is
   public only because Razor makes every component public, is hidden from a Consumer's editor, and
   may change in any version. *@
@attribute [System.ComponentModel.EditorBrowsable(System.ComponentModel.EditorBrowsableState.Never)]
@using global::ExGrid.Cells
@using global::ExGrid.Rows
@using global::ExGrid.Columns
@using global::ExGrid.Selection
@using Microsoft.AspNetCore.Components.Rendering
@implements IDisposable

@*
    The memoisation boundary sits at the row; cells are plain markup (ADR-0003).
    ShouldRender is hand-written because Blazor's automatic parameter change detection
    treats a mutable reference-typed parameter as "may have changed" even when the
    reference is identical (measured; ADR-0003).

    A row paints the Pinned Columns, then one spacer standing in for everything
    virtualised away to the left, then the scrollable columns on screen (ADR-0004). The
    pinned cells come first because they are `position: sticky` and therefore still
    occupy their place in the flow — the spacer's width is measured from where they end.

    Public because the row boundary is a documented architectural seam and the bUnit
    layer counts its renders; it is not meant to be used by a Consumer directly.
    Selection is never painted here — rows know nothing about it (ADR-0008). The one
    piece of keyboard state a row does paint is the chosen action of an Interactive cell,
    because nothing else can draw a button's box (ADR-0037) — and only the Focus row is
    ever handed it.
*@
@* role and the absolute index (ADR-0033): the DOM holds a Window, so the position
   among siblings is wrong in exactly the way virtualisation makes it — aria-rowindex
   states the 1-based absolute one, counted after the header's rows (2026-10-12): the
   number a reader counted from the painted rows near the top (NVDA, the seventeenth
   Windows run), written alike far down. What is checked is the accessibility tree
   (ADR-0033, 2026-10-13); what a reader says of it is learned from users' reports.
   aria-busy while a Placeholder: values that have not arrived must not be read out as
   though they had (ADR-0004). *@
@{ _paintingHighlightEnd = null; BeginMarks(); }
<div class="@RowClasses.For(RowKind?.Invoke(Row) ?? default, Placeholder, Stripe)"
     role="row" aria-rowindex="@((long)HeaderRowCount + RowIndex + 1)" aria-busy="@(Placeholder ? "true" : null)">
    @if (HeadingStyle is not null)
    {
        @* The Row Heading (ADR-0050): first in the flow and held at the left edge, so every
           column after it starts where the geometry's lead band ends. Paint only: the
           Viewport's delegated press reads the offsets, as it does for every cell. *@
        <div class="ex-row-heading" style="@HeadingStyle" aria-hidden="true">@Heading</div>
    }
    @for (var i = 0; i < Styles.Geometry.PinnedCount; i++)
    {
        var column = Columns[i];
        @if (!column.PaintsValue)
        {
            @* An Action or Template cell stops the mouse here (ADR-0020). The event
               reaches this element by bubbling from whatever inside it turned pointer
               events back on — an ancestor's own `pointer-events: none` does not stop a
               bubbled event — and left to carry on it would reach the Viewport handler
               with offsets measured from a button, which would move the selection to
               whichever cell that arithmetic happened to name.

               dblclick stops here too (ADR-0063): its offsets are the control's as well, and
               carried on they would name another cell for OnCellDoubleClick — or open the
               editor of an Editable cell nobody double-clicked.

               mouseup is deliberately NOT stopped: it carries no position into the
               Viewport's handler, which only ends the drag. Swallowed here, a drag
               released over a button would leave the grid still dragging, and the next
               move with a button held would extend the old selection to the pointer.

               Blazor composes each directive's internal attribute name on every render —
               a string per directive per cell. Left so on purpose: the pre-composed name is
               the host's Blazor's to interpret, and a rename in a runtime newer than the
               one this package builds on would let the press through here, in silence (ADR-0027,
               P5's scope). *@
            <div class="@CellClasses.For(OverflowRules.HashesWhenOverflowing(column.Type), pinned: true, StateOf(column), column.Align, mark: MarkOf(i))" style="@Styles.PinnedCell(i)"
                 role="gridcell" id="@CellId(i)" aria-colindex="@CellIds.ColumnIndex(i)"
                 @onmousedown:stopPropagation @onmousemove:stopPropagation @ondblclick:stopPropagation>@CellContent(column, i)</div>
        }
        else
        {
            var type = column.TypeAt(Row, CellType);
            var numeric = OverflowRules.HashesWhenOverflowing(type);
            var value = column.Value(Row);
            var text = column.Info.TextFor(value);
            var decision = Paint(column, i, type, text);
            var cellClass = CellClasses.For(numeric, pinned: true, StateOf(column), column.AlignAt(Row, CellAlign), ToneOf(column, value), Changed(column), MarkOf(i));
            @* aria-label only when what is painted is not the value's text: the accessible
               name of a #### cell, or of a cell whose painted text the Consumer supplied, is
               the real value (ADR-0016/0033/0050), and on every other cell the text names
               itself. *@
            <div class="@(Appearance?.ClassOf(i, cellClass) ?? cellClass)" style="@Styles.PinnedCell(i)"
                 role="gridcell" id="@CellId(i)" aria-colindex="@CellIds.ColumnIndex(i)"
                 aria-label="@AccessibleName(decision, text)">@if (decision.IsHashed) {<span class="ex-hashes">@decision.DisplayText</span>} else {@decision.DisplayText}</div>
        }
    }
    @if (!Placeholder && Scrollable is { } scrollable)
    {
        @if (Styles.HasGap(scrollable.Start))
        {
            <div class="ex-gap" style="@Styles.Gap(scrollable.Start)" aria-hidden="true"></div>
        }
        @for (var i = scrollable.Start; i < scrollable.Start + scrollable.Count; i++)
        {
            var column = Columns[i];
            @if (!column.PaintsValue)
            {
                <div class="@CellClasses.For(OverflowRules.HashesWhenOverflowing(column.Type), pinned: false, StateOf(column), column.Align, mark: MarkOf(i))" style="@Styles.Cell(i)"
                     role="gridcell" id="@CellId(i)" aria-colindex="@CellIds.ColumnIndex(i)"
                     @onmousedown:stopPropagation @onmousemove:stopPropagation @ondblclick:stopPropagation>@CellContent(column, i)</div>
            }
            else
            {
                var type = column.TypeAt(Row, CellType);
                var numeric = OverflowRules.HashesWhenOverflowing(type);
                var value = column.Value(Row);
                var text = column.Info.TextFor(value);
                var decision = Paint(column, i, type, text);
                var cellClass = CellClasses.For(numeric, pinned: false, StateOf(column), column.AlignAt(Row, CellAlign), ToneOf(column, value), Changed(column), MarkOf(i));
                <div class="@(Appearance?.ClassOf(i, cellClass) ?? cellClass)" style="@Styles.Cell(i)"
                     role="gridcell" id="@CellId(i)" aria-colindex="@CellIds.ColumnIndex(i)"
                     aria-label="@AccessibleName(decision, text)">@if (decision.IsHashed) {<span class="ex-hashes">@decision.DisplayText</span>} else {@decision.DisplayText}</div>
            }
        }
    }
</div>
@{ RecordHighlights(); RecordMarks(); }

@code {
    /// <summary>The row to paint. Its identity is the change signal: a new instance
    /// repaints, a row rewritten in place does not (ADR-0003).</summary>
    [Parameter, EditorRequired] public TRow Row { get; set; } = default!;

    /// <summary>The grid's visible Columns in display order — the list instance the grid
    /// holds, compared by reference (ADR-0003).</summary>
    [Parameter, EditorRequired] public IReadOnlyList<GridColumn<TRow>> Columns { get; set; } = [];

    /// <summary>The resolved column widths and the strings they reach CSS as, index-aligned
    /// with Columns. The parent replaces the instance only when a width actually moved
    /// (ADR-0016), which is what keeps this a reference comparison.</summary>
    [Parameter, EditorRequired] public ColumnStyles Styles { get; set; } = default!;

    /// <summary>Which scrollable columns are on screen, or null when the Pinned Columns
    /// cover the whole Viewport (ADR-0004).</summary>
    [Parameter] public ColumnRange? Scrollable { get; set; }

    /// <summary>
    /// Paint the row as a Placeholder: Pinned Columns only, and a bar in place of the
    /// rest (ADR-0004). The pinned cells stay because a Pinned Column is the landmark
    /// that survives panning sideways — having it blink out and back on every fling is
    /// the thing pinning exists to prevent. The 21 rows × 2 pinned cells that costs is
    /// noise beside the scrollable cells being skipped.
    /// </summary>
    [Parameter] public bool Placeholder { get; set; }

    /// <summary>The Cell Metrics a value's text is measured with, to decide whether it
    /// fits its column or becomes <c>####</c> (ADR-0016). A value, compared by
    /// content.</summary>
    [Parameter] public CellTextMetrics Metrics { get; set; }

    /// <summary>The row's absolute, 0-based position in the whole result — what
    /// <c>aria-rowindex</c> (1-based, after <see cref="HeaderRowCount"/>) and the cell ids
    /// are written from (ADR-0033).
    /// Constant for a given row within a Window, so memoisation is untouched by it.</summary>
    [Parameter] public int RowIndex { get; set; }

    /// <summary>How many header rows ARIA counts before the first data row: the leaf row
    /// and each tier of Header Groups, or none while the header is hidden. The row's
    /// <c>aria-rowindex</c> is <see cref="RowIndex"/> plus this plus one (ADR-0033,
    /// 2026-10-12); the cell ids are not moved by it. Constant while the header's tiers are.</summary>
    [Parameter] public int HeaderRowCount { get; set; }

    /// <summary>Whether this row wears a Row Stripe (ADR-0038): decided by the grid from
    /// the row's absolute position, so it changes only when <see cref="RowIndex"/> does —
    /// or when stripes are turned on or off.</summary>
    [Parameter] public bool Stripe { get; set; }

    /// <summary>The instance's id prefix (ADR-0018/0033): two grids on one page must
    /// not share a cell id, or <c>aria-activedescendant</c> resolves into the wrong
    /// grid. Constant for the component's life.</summary>
    [Parameter] public string IdPrefix { get; set; } = "";

    /// <summary>
    /// Asks the Consumer what state a cell is in (ADR-0006). Null means every cell is
    /// Normal and costs nothing. <b>The delegate's identity is the change signal</b>: a
    /// lookup handed over unchanged is taken to mean the metadata behind it is unchanged,
    /// exactly as an unchanged row instance means unchanged values (ADR-0003).
    /// </summary>
    [Parameter] public CellStateOf<TRow>? CellState { get; set; }

    /// <summary>
    /// The per-cell kind (ADR-0050, item 6), or null for the column's. Asked once per
    /// painted value cell; its identity is the change signal, exactly as it is for
    /// <see cref="CellState"/> (ADR-0003/0006).
    /// </summary>
    [Parameter] public Func<TRow, GridColumn<TRow>, ColumnType>? CellType { get; set; }

    /// <summary>
    /// The per-cell alignment (ADR-0050, item 7), or null for the column's. Asked once per
    /// painted value cell; its identity is the change signal, exactly as it is for
    /// <see cref="CellType"/> (ADR-0003/0006).
    /// </summary>
    [Parameter] public Func<TRow, GridColumn<TRow>, CellAlign>? CellAlign { get; set; }

    /// <summary>
    /// The Consumer's painted text (ADR-0050, item 11), or null for the value's own. Asked
    /// once per painted value cell with the column's content width; its identity is the
    /// change signal, exactly as it is for <see cref="CellType"/> (ADR-0003/0006).
    /// </summary>
    [Parameter] public PaintedTextOf<TRow>? PaintedText { get; set; }

    /// <summary>
    /// When a cell's shown value last changed, for the Change Highlight (ADR-0068), or null
    /// for none. Asked once per painted value cell; its identity is the change signal,
    /// exactly as it is for <see cref="CellState"/> (ADR-0003/0006).
    /// </summary>
    [Parameter] public CellChangeOf<TRow>? CellChangedAt { get; set; }

    /// <summary>How long a Change Highlight lasts after the change time
    /// (ADR-0068). A value, compared by content while the declaration is made.</summary>
    [Parameter] public TimeSpan ChangeHighlightDuration { get; set; }

    /// <summary>
    /// The grid's time for this render, read once by the grid for every row, and
    /// <c>default</c> while nothing is declared (ADR-0068). It is not itself a reason to
    /// render: a row renders for it only once its earliest mark has ended by it, so a row
    /// whose marks still stand — or that has none — skips.
    /// </summary>
    [Parameter] public DateTimeOffset ChangeHighlightNow { get; set; }

    /// <summary>Where this row reports the earliest end among the marks it painted, and null
    /// once it paints none or leaves (ADR-0068). Held by the grid for its whole life; a
    /// channel, not something the row paints from, so it is no reason to render.</summary>
    [Parameter] public Action<object, DateTimeOffset?>? ChangeHighlightPainted { get; set; }

    /// <summary>
    /// What role each row plays (ADR-0024). Passed down as the delegate and invoked here,
    /// not invoked by the parent and passed as a value: the delegate's identity is the
    /// change signal, exactly as it is for <see cref="CellState"/>, and a role that could
    /// also change because the parent happened to re-render would arrive on the next
    /// scroll — quietly, and at a moment nobody chose.
    /// </summary>
    [Parameter] public Func<TRow, RowKind>? RowKind { get; set; }

    /// <summary>Where a pressed action is reported (ADR-0020). A plain delegate rather
    /// than an EventCallback because it is compared by reference in
    /// <see cref="ShouldRender"/>; the parent holds it in a field for the same reason
    /// (ADR-0003).</summary>
    [Parameter] public Func<GridActionEventArgs<TRow>, Task>? OnAction { get; set; }

    /// <summary>
    /// The one cell of this row that Space has engaged, or <see cref="CellEngagement.None"/>
    /// — which every row but the Focus row is handed, so none of them re-renders for it
    /// (ADR-0037). A value, compared by content: the chosen action moving is exactly a
    /// change this row paints.
    /// </summary>
    [Parameter] public CellEngagement Engagement { get; set; } = CellEngagement.None;

    /// <summary>Whether this row carries a Row Mark (ADR-0043) — the Consumer's answer,
    /// asked by the grid for this row. A value, so only a row whose answer moved
    /// re-renders.</summary>
    [Parameter] public bool Marked { get; set; }

    /// <summary>Where a press on this row's Mark Column checkbox is reported: the row and
    /// the state it asks for. Held by the parent in a field, compared by reference, for
    /// the reason <see cref="OnAction"/> is (ADR-0003).</summary>
    [Parameter] public Func<TRow, bool, Task>? OnMark { get; set; }

    /// <summary>This row's Row Heading label (ADR-0050), or null. A value, compared by
    /// content, so only a row whose label moved re-renders.</summary>
    [Parameter] public string? Heading { get; set; }

    /// <summary>
    /// What this row paints of its cells' Font, Fill and Borders (ADR-0050, item 15), or null
    /// for none. Resolved by the grid outside this render, from this row and the rows either
    /// side of it, and replaced only when what it paints changed: compared by reference, as a
    /// row instance is (ADR-0003).
    /// </summary>
    [Parameter] public RowAppearance? Appearance { get; set; }

    /// <summary>
    /// What this row judges its painted cells by for the Match Mark (ADR-0332 §4), or null
    /// while no search is held or nobody can judge one. Compared by reference, as a row instance is
    /// (ADR-0003); but a new one is a reason to render only when it marks other cells of this row
    /// than the last render did, so a search typed over the painted rows re-renders only the rows
    /// whose marks moved.
    /// </summary>
    [Parameter] public MatchMarks<TRow>? MatchMarks { get; set; }

    /// <summary>The column of this row's current match — the Focus a found step moved to — or -1,
    /// which every other row is handed, so none of them re-renders for it (ADR-0332 §4). A value,
    /// compared by content. Marked as current only while the cell matches.</summary>
    [Parameter] public int CurrentMatch { get; set; } = -1;

    /// <summary>The Row Headings' inline width, or null while there is no band
    /// (ADR-0050/0028). One string for every row, rebuilt by the grid only when the width
    /// moves.</summary>
    [Parameter] public string? HeadingStyle { get; set; }

    private TRow? _renderedRow;
    private IReadOnlyList<GridColumn<TRow>>? _renderedColumns;
    private ColumnStyles? _renderedStyles;
    private ColumnRange? _renderedScrollable;
    private bool _renderedPlaceholder;
    private CellTextMetrics _renderedMetrics;
    private CellStateOf<TRow>? _renderedCellState;
    private Func<TRow, GridColumn<TRow>, ColumnType>? _renderedCellType;
    private Func<TRow, GridColumn<TRow>, CellAlign>? _renderedCellAlign;
    private PaintedTextOf<TRow>? _renderedPaintedText;
    private CellChangeOf<TRow>? _renderedCellChangedAt;
    private TimeSpan _renderedChangeHighlightDuration;
    private Func<TRow, RowKind>? _renderedRowKind;
    private Func<GridActionEventArgs<TRow>, Task>? _renderedOnAction;
    private int _renderedRowIndex;
    private int _renderedHeaderRowCount;
    private bool _renderedStripe;
    private CellEngagement _renderedEngagement = CellEngagement.None;
    private bool _renderedMarked;
    private Func<TRow, bool, Task>? _renderedOnMark;
    private string? _renderedHeading;
    private string? _renderedHeadingStyle;
    private RowAppearance? _renderedAppearance;
    private MatchMarks<TRow>? _renderedMatchMarks;
    private int _renderedCurrentMatch = -1;

    protected override void OnInitialized()
    {
        // The first render happens unconditionally — Blazor does not consult
        // ShouldRender for it — so record what it will paint here. Left unrecorded,
        // every row pays one extra full render on the second parameter push, which the
        // render-count tests exist to catch (ADR-0003).
        Record();
    }

    protected override bool ShouldRender()
    {
        // Identity, not mutation, is the change signal (ADR-0003): a Consumer that
        // rewrites a row in place gets no repaint — it hands over a new instance. The
        // two additions here are values, so they compare by content: scrolling sideways
        // genuinely changes what a row paints, and no memoisation should hide that.
        // Time passing is a reason only for a row whose earliest Change Highlight has
        // ended by the grid's time for this render (ADR-0068); every other row skips it.
        if (ReferenceEquals(_renderedRow, Row)
            && ReferenceEquals(_renderedColumns, Columns)
            && ReferenceEquals(_renderedStyles, Styles)
            && _renderedScrollable == Scrollable
            && _renderedPlaceholder == Placeholder
            && _renderedMetrics == Metrics
            && ReferenceEquals(_renderedCellState, CellState)
            && ReferenceEquals(_renderedCellType, CellType)
            && ReferenceEquals(_renderedCellAlign, CellAlign)
            && ReferenceEquals(_renderedPaintedText, PaintedText)
            && ReferenceEquals(_renderedCellChangedAt, CellChangedAt)
            && (CellChangedAt is null || _renderedChangeHighlightDuration == ChangeHighlightDuration)
            && !HighlightEnded()
            && ReferenceEquals(_renderedRowKind, RowKind)
            && ReferenceEquals(_renderedOnAction, OnAction)
            && _renderedRowIndex == RowIndex
            && _renderedHeaderRowCount == HeaderRowCount
            && _renderedStripe == Stripe
            && _renderedEngagement == Engagement
            && _renderedMarked == Marked
            && ReferenceEquals(_renderedOnMark, OnMark)
            && string.Equals(_renderedHeading, Heading, StringComparison.Ordinal)
            && ReferenceEquals(_renderedHeadingStyle, HeadingStyle)
            && ReferenceEquals(_renderedAppearance, Appearance)
            && _renderedCurrentMatch == CurrentMatch)
        {
            // A new search is a reason to render only where it moves a mark (ADR-0332 §4): the
            // painted cells are judged again, and a row whose marks stand keeps what it painted.
            if (ReferenceEquals(_renderedMatchMarks, MatchMarks))
                return false;
            if (MarksStand())
            {
                _renderedMatchMarks = MatchMarks;
                return false;
            }
        }

        Record();
        return true;
    }

    private void Record()
    {
        _renderedRow = Row;
        _renderedColumns = Columns;
        _renderedStyles = Styles;
        _renderedScrollable = Scrollable;
        _renderedPlaceholder = Placeholder;
        _renderedMetrics = Metrics;
        _renderedCellState = CellState;
        _renderedCellType = CellType;
        _renderedCellAlign = CellAlign;
        _renderedPaintedText = PaintedText;
        _renderedCellChangedAt = CellChangedAt;
        _renderedChangeHighlightDuration = ChangeHighlightDuration;
        _renderedRowKind = RowKind;
        _renderedOnAction = OnAction;
        _renderedRowIndex = RowIndex;
        _renderedHeaderRowCount = HeaderRowCount;
        _renderedStripe = Stripe;
        _renderedEngagement = Engagement;
        _renderedMarked = Marked;
        _renderedOnMark = OnMark;
        _renderedHeading = Heading;
        _renderedHeadingStyle = HeadingStyle;
        _renderedAppearance = Appearance;
        _renderedMatchMarks = MatchMarks;
        _renderedCurrentMatch = CurrentMatch;
    }

    // Each cell's id, composed the first time the cell is painted in this row and kept
    // until what composes it — the prefix or the row's index — changes. An id is unique to
    // its cell, so unlike a class it cannot be interned; the next best thing ADR-0027 P5
    // allows is caching it alongside what produced it. Composed per render instead, every
    // sideways scroll and every row re-render wrote one string per painted cell (PF-3).
    // The cost left is one string per cell per row's life, paid when the cell first
    // enters — which it cannot do without being painted anyway.
    private string?[] _cellIds = [];
    private int _cellIdsRow = -1;
    private string _cellIdsPrefix = "";

    /// <summary>One cell's id: instance prefix, absolute row, column (ADR-0033). What
    /// the root's <c>aria-activedescendant</c> resolves to.</summary>
    private string CellId(int column)
    {
        if (_cellIdsRow != RowIndex || !ReferenceEquals(_cellIdsPrefix, IdPrefix))
        {
            Array.Clear(_cellIds);
            _cellIdsRow = RowIndex;
            _cellIdsPrefix = IdPrefix;
        }
        if (column >= _cellIds.Length)
            Array.Resize(ref _cellIds, Math.Max(column + 1, Columns.Count));
        return _cellIds[column] ??= CellIds.Cell(IdPrefix, RowIndex, column);
    }

    // Per column, what an Action or Template cell paints from, kept until Columns itself is
    // replaced — the identity ADR-0003 already treats as the change signal. Built per
    // render instead, each was a new delegate per cell (PF-3), and a new click handler is a
    // changed attribute: the diff re-registered every action button's event on every
    // render of its row and sent each one to the browser. Held, a button keeps its event
    // for as long as it keeps its place; a sideways scroll that shifts the painted columns
    // moves a scrollable one to where another column's stood, and the diff, comparing by
    // position, registers that one afresh.
    private IReadOnlyList<GridColumn<TRow>>? _contentsBuiltFor;
    private RenderFragment?[] _cellContents = [];
    private ActionPaint[]?[] _actionPaints = [];

    /// <summary>What one action's button carries that does not change while the columns
    /// do not: its class attribute and its click handler.</summary>
    private sealed record ActionPaint(string Class, Func<Task> Fire);

    private void ForgetContentsBuiltForOtherColumns()
    {
        if (ReferenceEquals(_contentsBuiltFor, Columns))
            return;
        _contentsBuiltFor = Columns;
        _cellContents = new RenderFragment?[Columns.Count];
        _actionPaints = new ActionPaint[]?[Columns.Count];
    }

    /// <summary>
    /// What an Action or Template cell paints. A Template Column's fragment is rendered
    /// <em>inside</em> this row rather than in a component of its own: it then rides the
    /// row's memoisation boundary instead of adding one per cell, which is what
    /// ADR-0003 measured as expensive. An Action Column's buttons are plain markup for
    /// the same reason — a boundary is the cost, not the content (ADR-0020).
    /// </summary>
    private RenderFragment CellContent(GridColumn<TRow> column, int index)
    {
        ForgetContentsBuiltForOtherColumns();
        return _cellContents[index] ??= CellContentFragment(column, index);
    }

    // Its own method so that only a miss captures anything: a lambda capturing a method's
    // parameters allocates its closure on entry to that method, cache hit or not.
    private RenderFragment CellContentFragment(GridColumn<TRow> column, int index)
        => builder => PaintCellContent(builder, column, index);

    private ActionPaint[] ActionPaintsOf(GridColumn<TRow> column)
    {
        var paints = new ActionPaint[column.Actions.Count];
        for (var a = 0; a < paints.Length; a++)
        {
            var action = column.Actions[a];
            paints[a] = new ActionPaint(ActionClass(action), () => FireAsync(column, action));
        }

        return paints;
    }

    private void PaintCellContent(RenderTreeBuilder builder, GridColumn<TRow> column, int index)
    {
        if (column.IsMarkColumn)
        {
            PaintMark(builder);
            return;
        }
        if (column.Template is { } template)
        {
            // The focus request reaches this cell's content on the one render that hands
            // it over, and zero reaches every other (ADR-0037): the content focuses its
            // own control, because the core holds no reference to one it did not render.
            var request = Engagement.Column == index ? Engagement.FocusRequest : 0;
            builder.AddContent(0, template(new TemplateCellContext<TRow>(Row, request)));
            return;
        }

        var paints = _actionPaints[index] ??= ActionPaintsOf(column);
        var sequence = 1;
        for (var a = 0; a < column.Actions.Count; a++)
        {
            var action = column.Actions[a];
            // The chosen action of an Interactive cell (ADR-0037): the keyboard stays on
            // the root, so nothing matches :focus-visible — this button is painted instead,
            // and carries the id the root's aria-activedescendant names. Only this one has
            // an id; the root never names any other button.
            var chosen = Engagement.Column == index && Engagement.Action == a;
            builder.OpenElement(sequence++, "button");
            builder.AddAttribute(sequence++, "type", "button");
            builder.AddAttribute(sequence++, "data-ex-claims", "click");
            builder.AddAttribute(sequence++, "class", chosen ? ChosenActionClass(action) : paints[a].Class);
            builder.AddAttribute(sequence++, "id", chosen ? CellIds.Action(IdPrefix, RowIndex, index, a) : null);
            // Never holding the keyboard (ADR-0033/0037). Out of the page's tab sequence,
            // because the root is the grid's one tab stop; and not focused by the pointer
            // either, because a press dragged off a button — the platform's way to cancel
            // a click — would otherwise leave it focused, and Enter would then fire it
            // natively: the key ADR-0020 says never fires. The click itself still lands.
            builder.AddAttribute(sequence++, "tabindex", "-1");
            // The directive's API, not its pre-composed internal name, for the reason the
            // cell's own stopPropagation keeps it (ADR-0027, P5's scope).
            builder.AddEventPreventDefaultAttribute(sequence++, "onmousedown", true);
            builder.AddAttribute(sequence++, "title", action.Label);
            // An icon-only button has no text to name it. `title` alone is the
            // last-resort source in the accessible-name computation — ignored under
            // several screen-reader configurations and unavailable to touch — so the
            // guarantee GridAction's mandatory label claims is delivered by aria-label,
            // with title left as the tooltip.
            if (action.CssClass is not null)
                builder.AddAttribute(sequence++, "aria-label", action.Label);
            // The held handler, with this row named as its receiver. The receiver is how the
            // renderer finds the error boundary for a handler that throws — a Consumer's
            // OnAction failing — so a bare delegate would leave that failure unhandled. Naming
            // it boxes one small callback per render, which is not a string (ADR-0027 P5);
            // and because the delegate inside is the held one, the callback compares equal
            // to the last, and the diff keeps the event it already registered.
            builder.AddAttribute(sequence++, "onclick", EventCallback.Factory.Create<MouseEventArgs>(this, paints[a].Fire));
            builder.AddContent(sequence++, action.CssClass is null ? action.Label : null);
            builder.CloseElement();
        }
    }

    // Held for the row's life, so the checkbox keeps its registered event across renders
    // (PF-3); it reads Marked when pressed, not when built.
    private Func<Task>? _toggleMark;

    /// <summary>
    /// The Mark Column's checkbox (ADR-0043): on Detail rows only — a Group or Total row
    /// has no defined target for an action. A button carrying the checkbox role rather
    /// than a native checkbox: a native one flips its own state on the press, before the
    /// Consumer has answered, and would show a mark nobody holds.
    /// </summary>
    private void PaintMark(RenderTreeBuilder builder)
    {
        if ((RowKind?.Invoke(Row) ?? global::ExGrid.Rows.RowKind.Detail) != global::ExGrid.Rows.RowKind.Detail)
            return;
        builder.OpenElement(0, "button");
        builder.AddAttribute(1, "type", "button");
        builder.AddAttribute(2, "class", "ex-mark");
        builder.AddAttribute(3, "role", "checkbox");
        builder.AddAttribute(4, "aria-checked", Marked ? "true" : "false");
        builder.AddAttribute(5, "aria-label", "Mark row");
        // Never holding the keyboard, as an action's button does not (ADR-0033/0037).
        builder.AddAttribute(6, "tabindex", "-1");
        builder.AddEventPreventDefaultAttribute(7, "onmousedown", true);
        builder.AddAttribute(8, "onclick", EventCallback.Factory.Create<MouseEventArgs>(this, _toggleMark ??= ToggleMarkAsync));
        builder.AddAttribute(9, "data-ex-claims", "click");
        builder.CloseElement();
    }

    // The grid reports; the Consumer holds the mark (ADR-0043).
    private Task ToggleMarkAsync() => OnMark?.Invoke(Row, !Marked) ?? Task.CompletedTask;

    private static string ActionClass(GridAction action)
        => action.CssClass is null ? "ex-action" : "ex-action " + action.CssClass;

    /// <summary>Composed only for the one chosen button, on the render that paints it
    /// (ADR-0029/0037).</summary>
    private static string ChosenActionClass(GridAction action)
        => action.CssClass is null ? "ex-action ex-action-chosen" : "ex-action ex-action-chosen " + action.CssClass;

    // The grid reports; it does not act (ADR-0020). What the action opens happens
    // outside the grid, and the Consumer holds the state.
    private Task FireAsync(GridColumn<TRow> column, GridAction action)
        => OnAction?.Invoke(new GridActionEventArgs<TRow>(Row, column.Name, action.Name)) ?? Task.CompletedTask;

    /// <summary>One lookup per painted cell, including the Pinned Columns of a
    /// Placeholder row — those paint their real values, so blinking their state away
    /// mid-fling would be the landmark lying about itself (ADR-0004).</summary>
    private Cells.CellState StateOf(GridColumn<TRow> column) => CellState?.Invoke(Row, column) ?? default;

    // The Change Highlight (ADR-0068): the earliest end among the marks this row painted in
    // its last render, or null while it painted none, and the same end being gathered while a
    // render is under way. Kept so that ShouldRender can tell a mark that has ended without
    // asking the Consumer again, and told to the grid, whose one timer waits for the earliest
    // end of every row.
    private DateTimeOffset? _highlightEnd;
    private DateTimeOffset? _paintingHighlightEnd;

    /// <summary>Whether a mark this row painted has ended by the grid's time for this render:
    /// the one reason the passing of time gives a row to render (ADR-0068).</summary>
    private bool HighlightEnded() => _highlightEnd is { } end && ChangeHighlightNow >= end;

    /// <summary>
    /// Whether a value cell wears the Change Highlight now: one question to the Consumer per
    /// painted value cell, including the Pinned Columns of a Placeholder row, which paint their
    /// real values, and none without the declaration (ADR-0068, DC-1). A mark this cell shows
    /// joins the row's earliest end. Keyed by the row and the column this render paints, never
    /// by the element: a recycled element asks again for the row it now paints (DC-65).
    /// </summary>
    private bool Changed(GridColumn<TRow> column)
    {
        if (CellChangedAt is not { } changedAt
            || ChangeHighlightRules.ShowingUntil(changedAt(Row, column), ChangeHighlightDuration, ChangeHighlightNow) is not { } end)
        {
            return false;
        }
        if (_paintingHighlightEnd is not { } earliest || end < earliest)
            _paintingHighlightEnd = end;
        return true;
    }

    /// <summary>Keeps the earliest end this render painted, and tells the grid when it moved
    /// — a render that painted what the last one did tells it nothing.</summary>
    private void RecordHighlights()
    {
        var end = _paintingHighlightEnd;
        _paintingHighlightEnd = null;
        if (end == _highlightEnd)
            return;
        _highlightEnd = end;
        ChangeHighlightPainted?.Invoke(this, end);
    }

    // The Match Mark (ADR-0332 §4): the columns this row's last render marked, in paint order, and
    // the columns judged for the render under way — judged once, by ShouldRender when a new search
    // is what asks for the render, and otherwise as the render begins — read through a cursor as the
    // cells are painted in the same order. Kept so that ShouldRender can tell a new search that
    // leaves this row's marks where they were, and so no cell is judged twice for one render.
    private int[] _marks = [];
    private int _markCount;
    private int[] _judged = [];
    private int _judgedCount;
    private bool _judgedForRender;
    private int _judgedCursor;

    /// <summary>The painted cells <see cref="MatchMarks"/> marks, into <see cref="_judged"/>: the
    /// Pinned Columns, and the scrollable ones on screen unless this is a Placeholder, in the order
    /// they are painted. Nothing per cell leaves the server (ADR-0027).</summary>
    private void Judge()
    {
        _judgedCount = 0;
        if (MatchMarks is not { } marks)
            return;
        for (var i = 0; i < Styles.Geometry.PinnedCount; i++)
            JudgeCell(marks, i);
        if (!Placeholder && Scrollable is { } scrollable)
        {
            for (var i = scrollable.Start; i < scrollable.Start + scrollable.Count; i++)
                JudgeCell(marks, i);
        }
    }

    private void JudgeCell(MatchMarks<TRow> marks, int index)
    {
        if (!marks.Matches(Row, Columns[index]))
            return;
        if (_judgedCount == _judged.Length)
            Array.Resize(ref _judged, Math.Max(4, _judged.Length * 2));
        _judged[_judgedCount++] = index;
    }

    /// <summary>Judges the painted cells as the render begins, unless ShouldRender already has for
    /// this render.</summary>
    private void BeginMarks()
    {
        if (!_judgedForRender)
            Judge();
        _judgedForRender = false;
        _judgedCursor = 0;
    }

    /// <summary>Whether a painted cell wears the Match Mark, and whether as the current match: read
    /// from what was judged for this render, never judged again. Asked of every painted cell in paint
    /// order; a cell Find cannot land on was never judged a match, and reads None.</summary>
    private MatchMark MarkOf(int index)
    {
        if (_judgedCursor >= _judgedCount || _judged[_judgedCursor] != index)
            return MatchMark.None;
        _judgedCursor++;
        return index == CurrentMatch ? MatchMark.Current : MatchMark.Match;
    }

    /// <summary>Keeps the marks this render painted, for the next ShouldRender to compare with.</summary>
    private void RecordMarks()
    {
        (_marks, _judged) = (_judged, _marks);
        _markCount = _judgedCount;
        _judgedCount = 0;
    }

    /// <summary>
    /// Whether <see cref="MatchMarks"/> marks exactly the cells the last render marked. What it
    /// judged is kept for the render that follows when they differ, so a keystroke judges each
    /// painted cell once.
    /// </summary>
    private bool MarksStand()
    {
        Judge();
        if (_judgedCount == _markCount && _judged.AsSpan(0, _judgedCount).SequenceEqual(_marks.AsSpan(0, _markCount)))
            return true;
        _judgedForRender = true;
        return false;
    }

    /// <summary>A row leaving the DOM takes its marks with it, so the grid's timer no longer
    /// waits for them (ADR-0068).</summary>
    public void Dispose()
    {
        if (_highlightEnd is null)
            return;
        _highlightEnd = null;
        ChangeHighlightPainted?.Invoke(this, null);
    }

    /// <summary>The one string a cell paints, measures and decides overflow on — count
    /// and render must see the same text — and the one copy, the value list and the
    /// editor show for the value (ADR-0005/0006): the column's Format where it declares
    /// one, and where it does not a date's or a time's ISO form by type, or the value's own
    /// ToString (ADR-0006, note of 2026-10-01). Null is a Blank and paints empty
    /// (ADR-0023).</summary>
    internal static string CellText(GridColumn<TRow> column, TRow row)
        => column.Info.TextOf(row);

    /// <summary>
    /// What one value cell paints: the Consumer's painted text where it supplies one
    /// (ADR-0050, item 11), the value's text where it does not — and in either case the
    /// <c>####</c> rule decides on what would be painted, so a Number or Date that does
    /// not fit is never shown cut (ADR-0016). A bold cell is judged by the bold widths,
    /// and its painted text is fitted with them (ADR-0050, item 15).
    /// </summary>
    private OverflowDecision Paint(GridColumn<TRow> column, int index, ColumnType type, string text)
    {
        // The declared width, not the one painted on Device Pixels (ADR-0090): an Auto column is
        // exactly as wide as its widest estimate, and rounding it by under a Device Pixel must not
        // turn the value it grew for into ####. The estimate need not leave that pixel to spare —
        // in DejaVu Sans a bold one does not — because a cell that shows a number may use one
        // Device Pixel of its right padding (ADR-0090, 2026-10-11; VZ-19; ex-grid.css), so its
        // content box is never narrower than the declared content.
        var widthPx = Styles.Geometry.DeclaredWidthPxOf(index);
        var metrics = Appearance?.IsBold(index) == true ? Metrics.Bold : Metrics;
        var painted = PaintedText?.Invoke(Row, column, metrics.ContentWidthPx(widthPx), metrics) ?? text;
        return OverflowRules.Decide(type, painted, widthPx, metrics);
    }

    /// <summary>The cell's aria-label: the value's own text wherever the cell paints
    /// something else — <c>####</c>, or a painted text that differs from it
    /// (ADR-0016/0033/0050) — and nothing where the text names itself.</summary>
    private static string? AccessibleName(OverflowDecision decision, string text)
        => decision.IsHashed || !string.Equals(decision.DisplayText, text, StringComparison.Ordinal)
            ? text
            : null;

    /// <summary>The column's tone for a value (ADR-0006): None without a rule, None for a
    /// null — a Blank has no sign and the rule is never asked about it.</summary>
    internal static CellTone ToneOf(GridColumn<TRow> column, object? value)
        => value is not null && column.Tone is { } tone ? tone(value) : CellTone.None;
}
