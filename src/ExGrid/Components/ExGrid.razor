@typeparam TRow where TRow : class
@using System.Runtime.CompilerServices
@using global::ExGrid.Cells
@using global::ExGrid.Keys
@using global::ExGrid.Rows
@using global::ExGrid.Columns
@using global::ExGrid.Selection
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IServiceProvider Services

@*
    The push entry point (ADR-0001): the grid paints the Window it is given and holds
    no data of its own. When the Viewport moves past what the Window covers it raises a
    Range Request and keeps painting Placeholders — it never fetches and never waits.
    Only the parameters this layer renders are declared; the rest of the push contract
    (Sorts, Filter, PageSize, ...) arrives with the layers that give it behaviour.

    Re-rendering the root is cheap because the row boundaries below it skip (ADR-0003),
    so ShouldRender exists here for one case only: a mouse move that stays inside the
    cell it started in changes nothing, and arrives once a frame while a drag lasts.
*@
@* tabindex, so the browser's focus answers which grid a key belongs to (ADR-0018).
   The capture-phase listener is attached to this element and to nothing wider. *@
<div class="@RootClass" style="--ex-row-height: @Px(RowHeight)" tabindex="0" @ref="_root">
    @* One scroll container for both axes, with the header and the Pinned Columns held in
       place by `position: sticky` inside it. Two containers cannot do this: giving the
       inner one a non-visible overflow on one axis turns the other into `auto` (CSS
       Overflow 3), so the body would pan on its own scrollbar while the header stayed
       put — every column read under its neighbour's label — and a sticky offset measured
       against the inner scrollport would not hold the pinned cells at all. *@
    <div class="ex-scroller" style="width: @Px(ViewportWidth); height: @Px(ViewportHeight)"
         @ref="_scroller" @onscroll="OnScrollAsync">
        <div class="ex-spacer" style="width: @Px(_columnStyles.Geometry.TotalWidthPx); height: @Px(RowHeight + _geometry.ScrollHeightPx)">
            @* The header occupies the content's first row height and covers the
               Viewport's first row height, so the two cancel and the row arithmetic
               below is unchanged by its presence (ADR-0013). *@
            <div class="ex-header">
                @for (var i = 0; i < _columnStyles.Geometry.PinnedCount; i++)
                {
                    <div class="ex-header-cell ex-pinned" style="@_columnStyles.PinnedCell(i)">@Columns[i].Header</div>
                }
                @if (_scrollable is { } headerColumns)
                {
                    @if (_columnStyles.HasGap(headerColumns.Start))
                    {
                        <div class="ex-gap" style="@_columnStyles.Gap(headerColumns.Start)"></div>
                    }
                    @for (var i = headerColumns.Start; i < headerColumns.Start + headerColumns.Count; i++)
                    {
                        <div class="ex-header-cell" style="@_columnStyles.Cell(i)">@Columns[i].Header</div>
                    }
                }
            </div>
            @* Every cell under here is `pointer-events: none`, so this element is the
               target of every mouse event in the rows and the offsets on the event are
               already measured from its own left and top edge. One handler for the whole
               body: a handler per cell would be ~220 of them re-registered on every
               frame of a scroll, which is the cost ADR-0004 caps. *@
            <div class="ex-viewport" style="transform: translateY(@Px(_geometry.OffsetPxOf(_visible?.Start ?? 0)))"
                 @attributes="_dragHandler" @onmousedown="OnMouseDown" @onmouseup="OnMouseUp">
                @if (_visible is { } visible)
                {
                    @if (!_selection.Selection.IsEmpty)
                    {
                        @* One element per range, so what selection costs to paint depends
                           on how many rectangles there are and never on how many cells
                           they cover (ADR-0008). The two layers are the horizontal axis
                           being asymmetric again: the pinned part of a range has to
                           travel with the Pinned Columns, and the rest has to pass
                           underneath them. Both carry a key because their siblings do —
                           an unkeyed element beside keyed ones degrades the diff to
                           positional matching and would recreate the rows (ADR-0003). *@
                        <div class="ex-selection-pinned" @key="PinnedSelectionLayerKey">
                            @foreach (var range in _selection.Selection.Ranges)
                            {
                                @if (SelectionStyles.Pinned(range, _columnStyles.Geometry, RowHeight, visible.Start) is { } fill)
                                {
                                    <div class="ex-range" style="@fill"></div>
                                }
                            }
                            @if (SelectionStyles.Pinned(FocusRange, _columnStyles.Geometry, RowHeight, visible.Start) is { } pinnedFocus)
                            {
                                <div class="ex-focus" style="@pinnedFocus"></div>
                            }
                        </div>
                        <div class="ex-selection" @key="SelectionLayerKey">
                            @foreach (var range in _selection.Selection.Ranges)
                            {
                                @if (SelectionStyles.Scrollable(range, _columnStyles.Geometry, RowHeight, visible.Start) is { } fill)
                                {
                                    <div class="ex-range" style="@fill"></div>
                                }
                            }
                            @if (SelectionStyles.Scrollable(FocusRange, _columnStyles.Geometry, RowHeight, visible.Start) is { } focus)
                            {
                                <div class="ex-focus" style="@focus"></div>
                            }
                        </div>
                    }
                    @* One loop over absolute row positions, and every sibling carries a
                       key: a keyed component beside an unkeyed element degrades the diff
                       to positional matching, which would recreate the very row
                       components memoisation exists to keep (ADR-0003). Row keys are
                       identity objects and Placeholder keys are boxed indices, so the
                       two can never collide — and a position turning from Placeholder
                       into a row correctly reads as a fresh mount. *@
                    @for (var row = visible.Start; row < visible.Start + visible.Count; row++)
                    {
                        var slice = row - _windowStart;
                        if (slice >= 0 && slice < _window.Count)
                        {
                            var data = _window[slice];
                            @* A Placeholder is handed no slice at all, so a fling that keeps
                               moving sideways does not churn the rows through renders whose
                               output is the same pinned cells every time. *@
                            <ExGridRow @key="RowKey(data)" Row="data" Columns="Columns" Styles="_columnStyles"
                                       Scrollable="@(_placeholderMode ? null : _scrollable)"
                                       Placeholder="_placeholderMode" Metrics="CellMetrics"
                                       CellState="CellState" RowKind="RowKind"
                                       OnAction="@(_onAction ??= RaiseActionAsync)" />
                        }
                        else
                        {
                            @* No row behind this position at all, so not even a Pinned
                               Column has anything to paint. *@
                            <div class="ex-row ex-placeholder" @key="row"></div>
                        }
                    }
                }
            </div>
        </div>
    </div>
</div>

@code {
    /// <summary>
    /// One action button's own box, beside its text: the 6px padding either side, the
    /// 1px border either side and the 4px gap to the next button that <c>.ex-action</c>
    /// declares in <c>ex-grid.css</c>. Paired with the stylesheet the way
    /// <see cref="DefaultCellMetrics"/>'s padding is — the two must move together
    /// (ADR-0016).
    /// </summary>
    private const double ActionButtonChromePx = (6 * 2) + (1 * 2) + 4;

    private const double DefaultRowHeightPx = 28;
    private const double DefaultViewportHeightPx = 600;
    private const double DefaultViewportWidthPx = 800;

    /// <summary>
    /// How long scrolling must stand still before Placeholders are filled in with real
    /// cells (ADR-0004). Too short and contents blank out during ordinary scrolling;
    /// too long and the grid feels empty. Internal until a measurement earns it a
    /// parameter — the ADR says decide this by measuring, not by reasoning.
    /// </summary>
    private static readonly TimeSpan SettleDelay = TimeSpan.FromMilliseconds(150);

    private const string ModulePath = "./_content/ExGrid/ex-grid.js";

    /// <summary>
    /// The metrics behind width observation and the overflow decision until a theme
    /// layer supplies real ones. The digit width is contractually at least as wide as
    /// any glyph the formats emit (ADR-0016) — overshooting errs toward an early
    /// <c>####</c>, the safe direction. Both values pair with ex-grid.css and must move
    /// with it: 9px covers a tabular digit of the common system fonts at the
    /// stylesheet's pinned 14px (SF Pro measures 8.55px there), and the padding is its
    /// 8px. A theme that changes the font supplies its own <see cref="CellMetrics"/>.
    /// </summary>
    public static readonly CellTextMetrics DefaultCellMetrics = new(digitWidthPx: 9, cellHorizontalPaddingPx: 8);

    // One key object per row instance, so @key is reference identity even when TRow
    // overrides Equals (a record row model): value-equal rows are still different rows
    // (ADR-0003), and Blazor's duplicate-@key refusal must not fire on them. Entries
    // die with their rows; the table is per closed generic type.
    private static readonly ConditionalWeakTable<TRow, object> RowIdentityKeys = new();

    /// <summary>The contiguous block of rows the Consumer pushes in, starting at
    /// <see cref="WindowStart"/> (ADR-0001).</summary>
    [Parameter] public IReadOnlyList<TRow> Window { get; set; } = [];

    /// <summary>
    /// The bundled pull entry point (ADR-0001): a Grid Source holds the Window and
    /// answers Range Requests, and the grid drives the push form from it internally —
    /// the two are not peers, and there is one behavioural path.
    ///
    /// <para>Passing a Source alongside any of the push parameters it replaces is
    /// refused by name: one of the two would silently win, and which one is not
    /// something a Consumer should have to know.</para>
    /// </summary>
    [Parameter] public IGridSource<TRow>? Source { get; set; }

    /// <summary>Where the Window begins in the current order. The grid paints rows at
    /// their positions in the whole result, so it must know which positions the Window
    /// holds — without it a Window of rows 500-560 would paint at the top.</summary>
    [Parameter] public int WindowStart { get; set; }

    /// <summary>
    /// How many rows the whole result has, which is what the scrollbar is long enough
    /// for. Null means the Window is the whole result — the shape
    /// <c>GridSource.From</c> produces, where everything is in hand (ADR-0001).
    /// </summary>
    [Parameter] public int? TotalCount { get; set; }

    [Parameter, EditorRequired] public IReadOnlyList<GridColumn<TRow>> Columns { get; set; } = [];

    /// <summary>Emitted as --ex-row-height on the instance root, inline so a stylesheet
    /// cannot override it — the truth lives in this parameter, not in CSS (ADR-0013).</summary>
    [Parameter] public double RowHeight { get; set; } = DefaultRowHeightPx;

    /// <summary>
    /// How tall the scrolling area is, header included. A C# parameter for the same
    /// reason the row height is one (ADR-0013): the virtualisation arithmetic reads it,
    /// and measuring the element instead would mean a layout round-trip through
    /// JavaScript, which is deliberately not on the allowlist (ADR-0021). The header
    /// takes the first <see cref="RowHeight"/> of it, so the rows get what is left.
    ///
    /// This is the element's <em>outer</em> size, and a classic (non-overlay) scrollbar
    /// is drawn inside it. The allowance is not the Consumer's to make: the same
    /// application ships to macOS, where a scrollbar takes nothing, and to Windows, where
    /// it takes about 15px, so any constant written here is wrong for half its users.
    /// The browser reports what its scrollbars actually take and the grid subtracts it
    /// (<see cref="ViewportBox"/>, ADR-0013/0021); this parameter keeps meaning the size
    /// of the element, which is also what the CSS is written from.
    /// </summary>
    [Parameter] public double ViewportHeight { get; set; } = DefaultViewportHeightPx;

    /// <summary>How wide the scrolling area is — the other half of the geometry, a C#
    /// parameter for exactly the reason <see cref="ViewportHeight"/> is, and the outer
    /// size in the same way.</summary>
    [Parameter] public double ViewportWidth { get; set; } = DefaultViewportWidthPx;

    /// <summary>
    /// How many leading columns are pinned: always painted, outside virtualisation,
    /// held against the Viewport's left edge. The same shape as Excel's frozen panes,
    /// and combined with the column order the Consumer already owns it expresses which
    /// columns are pinned without the grid holding View State of its own (ADR-0001).
    ///
    /// Pinning is not free and is not capped: pinned cells are painted at every scroll
    /// offset, so pinning 50 of 100 columns puts the resident cell count back where
    /// virtualisation found it (ADR-0004 says this outright). Pinning a handful is the
    /// case this serves.
    /// </summary>
    [Parameter] public int PinnedColumnCount { get; set; }

    /// <summary>
    /// Whether columns outside the Viewport are left out of the DOM (ADR-0004). Off, the
    /// grid paints every column and travels the same rendering path — the spacer is
    /// simply zero wide and the slice is every scrollable column — so turning it off
    /// cannot change what a cell means, only how many of them exist.
    /// </summary>
    [Parameter] public bool VirtualiseColumns { get; set; } = true;

    /// <summary>Overridden by a theme that measured its real font; defaults to
    /// <see cref="DefaultCellMetrics"/>.</summary>
    [Parameter] public CellTextMetrics CellMetrics { get; set; } = DefaultCellMetrics;

    /// <summary>
    /// A number naming the <em>order</em> of the rows, bumped by the Consumer whenever
    /// the visible sequence changes and left alone when only values did (ADR-0011).
    /// Selection is positions rather than identities, so when this changes the selection
    /// is dropped rather than re-mapped: the same positions would name a different set of
    /// rows, and the operation that follows a selection is a bulk paste. The grid cannot
    /// detect it on its own — holding only the Window, it sees neither an insertion nor
    /// a shift.
    /// </summary>
    [Parameter] public int RowSequenceVersion { get; set; }

    /// <summary>
    /// Raised whenever the selection changes, including when it is dropped. The
    /// selected-cell count a status line shows is <see cref="GridSelection.CellCount"/>,
    /// which is the sum of the rectangles' areas and therefore needs no data at all
    /// (ADR-0014).
    /// </summary>
    [Parameter] public EventCallback<GridSelection> SelectionChanged { get; set; }

    /// <summary>
    /// Raised when the rows on screen are not all in the Window: "I need these rows".
    /// The grid does not wait and does not fetch — it keeps painting Placeholders until
    /// a Window that covers them arrives (ADR-0001). Read-ahead, throttling and
    /// discarding stale answers belong to the Consumer.
    /// </summary>
    [Parameter] public EventCallback<RowRange> OnRangeNeeded { get; set; }

    /// <summary>Whether an answer is in flight. Forgetting to pass it means a stale
    /// Window is shown as if it were current (ADR-0001).</summary>
    [Parameter] public bool IsLoading { get; set; }

    /// <summary>
    /// Cell Metadata, asked for by (row, column) and answered as one of the five states
    /// the grid understands (ADR-0006). The grid does not interpret the answer beyond
    /// painting a class for it — the Consumer's own vocabulary is mapped onto these five
    /// on the way in, and any accompanying data stays with the Consumer.
    ///
    /// <para><b>Hold it in a field and hand over a new one when the metadata changes.</b>
    /// The delegate's identity is the change signal, the way a row instance's is
    /// (ADR-0003): rewriting the dictionary behind a lookup that stays the same leaves
    /// the states already on screen where they are.</para>
    /// </summary>
    [Parameter] public CellStateOf<TRow>? CellState { get; set; }

    /// <summary>
    /// What role each row plays — detail, group or total (ADR-0024). Null means every
    /// row is a detail row. Asked once per painted row, so it is as cheap as
    /// <see cref="CellState"/> has to be, and its identity is the change signal in the
    /// same way: hold it in a field and hand over a new one when the roles change.
    /// Changing what an unchanged delegate would answer does not repaint.
    /// </summary>
    [Parameter] public Func<TRow, RowKind>? RowKind { get; set; }

    /// <summary>
    /// Raised when an action in an Action Column is pressed: which row, which column,
    /// which action (ADR-0020). The grid does not perform it and holds no state about
    /// it — what a detail action opens happens outside the grid, and expanding inside a
    /// row is not possible anyway (ADR-0013).
    /// </summary>
    [Parameter] public EventCallback<GridActionEventArgs<TRow>> OnAction { get; set; }

    // What the grid actually paints, resolved from the Source when there is one and
    // from the push parameters when there is not. Every reader below goes through these,
    // so binding a Source adds no branch to the pipeline — only one more way to fill it.
    private IReadOnlyList<TRow> _window = [];
    private int _windowStart;
    private int? _total;
    private bool _loading;
    private int _sequenceVersion;

    private IGridSource<TRow>? _boundSource;
    private IReadOnlyList<GridColumn<TRow>>? _boundColumns;
    private bool _applying;
    private bool _bound;

    private ElementReference _root;
    private ElementReference _scroller;
    private DotNetObjectReference<ExGrid<TRow>>? _self;

    // Whether the Meta key is this platform's primary modifier — Command on an Apple
    // keyboard, and the OS's own key everywhere else (ADR-0012). Only the browser can
    // answer it; until it has, Control alone is primary, which is right on every platform
    // and merely incomplete on one.
    private bool _metaIsPrimary;
    private bool _revealFocus;

    // Whether that reveal should also put the Viewport's left edge back at the start of
    // the row. Only ever set alongside _revealFocus, and cleared with it — see
    // RevealFocusIfNeededAsync for what it is for.
    private bool _revealRowStart;
    private IJSObjectReference? _module;
    private IJSObjectReference? _scrollHandle;
    private bool _disposed;
    private bool _readingScroll;
    private bool _scrollPending;

    private TimeProvider? _time;
    private ITimer? _settleTimer;
    private bool _placeholderMode;

    private double _scrollTopPx;
    private double _scrollLeftPx;
    private ViewportGeometry _geometry = new(DefaultRowHeightPx, DefaultViewportHeightPx - DefaultRowHeightPx, 0);
    private ColumnStyles _columnStyles = new(new ColumnGeometry([], 0, DefaultViewportWidthPx));

    // What the scrollbars take out of the declared Viewport, as the browser reports it
    // (ADR-0021). Zero until it says otherwise, which is both the right assumption —
    // `overflow: auto` shows no bar until the content overflows — and what an overlay
    // scrollbar platform reports forever.
    private double _gutterWidthPx;
    private double _gutterHeightPx;
    private ViewportBox _box = ViewportBox.Declared(DefaultViewportWidthPx, DefaultViewportHeightPx);
    private RowRange? _visible;
    private ColumnRange? _scrollable;

    // The selection and the row order it was made under, together, because that pairing
    // is where ADR-0011's "drop it, never re-map it" rule lives (HeldSelection).
    private HeldSelection _selection = HeldSelection.Empty(0);
    private string[] _columnNames = [];
    private bool _dragging;
    private bool _suppressRender;
    private bool _selectionChanged;

    // The move handler, splatted onto the row Viewport only while a drag is running. Left
    // attached permanently it would send an event per frame for a pointer merely crossing
    // the grid — on a Blazor Server Consumer a wire round trip each time, which is the
    // cost the scroll read goes out of its way to pay only once. @onmousemove cannot be
    // written conditionally, hence the splat; the delegate is cached in a field because a
    // method group is a new instance on every render (ADR-0003).
    private readonly Dictionary<string, object> _dragHandler = new();
    private Action<MouseEventArgs>? _onMouseMove;

    // Held in a field so every row is handed the same instance: a method group is a new
    // delegate on every render and would defeat the rows' ShouldRender comparison
    // (ADR-0003). Stable for the component's whole life, whether or not the Consumer
    // handles OnAction — swapping it about would be the same trap.
    private Func<GridActionEventArgs<TRow>, Task>? _onAction;

    // Distinct objects, so the two overlay layers can carry keys that cannot collide
    // with a row's identity key or a Placeholder's boxed index.
    private static readonly object SelectionLayerKey = new();
    private static readonly object PinnedSelectionLayerKey = new();

    private RowRange? _lastRaised;
    private int _lastRaisedWindowStart;
    private int _lastRaisedWindowCount;

    private IReadOnlyList<TRow>? _observedWindow;
    private IReadOnlyList<GridColumn<TRow>>? _observedColumns;
    private CellTextMetrics _observedMetrics;
    private AutoWidth[] _autoWidths = [];

    // What the widths were last measured from. Re-measuring on every render would read
    // the rows' current contents, so an in-place rewrite would grow a column and repaint
    // through the width path — the repaint ADR-0003 promises will not happen.
    private IReadOnlyList<TRow>? _measuredWindow;
    private int _measuredWindowStart;
    private RowRange? _measuredVisible;
    private bool _measured;

    private string RootClass => _loading ? "ex-grid ex-loading" : "ex-grid";

    /// <summary>The bounds every selection transition is checked against: rows after
    /// filtering, and visible columns (ADR-0011).</summary>
    private GridExtent Extent => new(_total ?? _window.Count, Columns.Count);

    /// <summary>The Focus as a one-cell rectangle, so the outline and a block travel the
    /// same arithmetic. Only read where the selection is known not to be empty — an empty
    /// one has no Focus to draw.</summary>
    private SelectionRange FocusRange => SelectionStyles.CellRange(_selection.Selection.Focus);

    private TimeProvider Time
        => _time ??= Services.GetService(typeof(TimeProvider)) as TimeProvider ?? TimeProvider.System;

    /// <summary>
    /// The push parameters a Source replaces. Checked here rather than in
    /// <see cref="OnParametersSet"/> because a value type cannot tell "passed 0" from
    /// "left at its default": only the ParameterView knows what was actually supplied.
    /// </summary>
    private static readonly string[] SourceReplaces =
        [nameof(Window), nameof(WindowStart), nameof(TotalCount), nameof(IsLoading),
         nameof(RowSequenceVersion), nameof(OnRangeNeeded)];

    public override Task SetParametersAsync(ParameterView parameters)
    {
        // Supplied, not non-null: a Consumer whose Source is built in OnInitializedAsync
        // passes Source="@_source" with _source still null on the first render, and that
        // is a pull grid waiting for its source — not a Consumer who passed nothing.
        var sourceSupplied = parameters.TryGetValue<IGridSource<TRow>?>(nameof(Source), out _);
        var supplied = new List<string>();
        foreach (var name in SourceReplaces)
        {
            if (parameters.TryGetValue<object>(name, out _))
                supplied.Add(name);
        }

        if (sourceSupplied && supplied.Count > 0)
        {
            throw new InvalidOperationException(
                $"Source was passed together with {string.Join(", ", supplied)}. A Source holds those itself " +
                "and drives the push form internally, so one of the two would have to silently win. Pass a " +
                "Source, or pass the push parameters — not both (ADR-0001).");
        }
        // Neither is a Consumer that forgot: an empty grid is written as Window="[]",
        // never as nothing at all. Left unchecked it paints an empty result that looks
        // exactly like a loaded one.
        if (!sourceSupplied && supplied.Count == 0 && !_bound)
        {
            throw new InvalidOperationException(
                "Neither Window nor Source was passed. Pass the Window to paint (push), or a Grid Source to " +
                "hold it for you (pull) — an empty result is Window=\"[]\" (ADR-0001).");
        }

        _bound = true;
        return base.SetParametersAsync(parameters);
    }

    protected override void OnParametersSet()
    {
        // The Source's own change notification lands in the same pipeline (ApplyState),
        // so a re-entrant one raised by the column push below would run it twice.
        _applying = true;
        try
        {
            BindSource();
            ApplyState();
        }
        finally
        {
            _applying = false;
        }
    }

    /// <summary>
    /// Subscribes to the Source and keeps its columns current. The subscription is
    /// swapped when the instance changes and released on disposal: left attached, a
    /// replaced Source would go on repainting a grid that no longer shows it.
    /// </summary>
    private void BindSource()
    {
        if (!ReferenceEquals(_boundSource, Source))
        {
            if (_boundSource is not null)
                _boundSource.StateChanged -= OnSourceStateChanged;
            _boundSource = Source;
            _boundColumns = null;
            if (_boundSource is not null)
                _boundSource.StateChanged += OnSourceStateChanged;
        }

        if (_boundSource is null || ReferenceEquals(_boundColumns, Columns))
            return;

        // The markup declaration stays the single source of truth (ADR-0023); the source
        // gets the filtering-and-sorting slice of it. Pushing the same columns again is a
        // no-op inside the source, so a Consumer rebuilding its array costs a comparison,
        // not a requery.
        _boundColumns = Columns;
        var infos = new ColumnInfo<TRow>[Columns.Count];
        for (var i = 0; i < Columns.Count; i++)
            infos[i] = Columns[i].Info;
        _boundSource.OnColumnsChanged(infos);
    }

    private void OnSourceStateChanged()
    {
        if (_disposed || _applying)
            return;
        // Marshalled: a Source that fetches raises this from whatever thread its answer
        // arrived on. ApplyState has to run with it — OnParametersSet does not run for a
        // change that came from outside the parameters, and rendering alone would paint
        // the new Window through the old geometry and the old Auto widths.
        _ = InvokeAsync(() =>
        {
            if (_disposed)
                return;
            try
            {
                ApplyState();
                StateHasChanged();
            }
            catch (Exception ex)
            {
                // ApplyState validates what it was handed (ADR-0001), and a Source
                // landing an answer is exactly the case that arrives off the renderer's
                // thread. Discarded with the task, the refusal would vanish and the grid
                // would go on painting the previous state — which is the failure the
                // validation exists to prevent, arrived at by another route.
                _ = DispatchExceptionAsync(ex);
            }
        });
    }

    private void ApplyState()
    {
        _window = Source?.Window ?? Window;
        if (_window is null)
        {
            throw new InvalidOperationException(
                Source is null
                    ? "Window is null. Pass the rows to paint — an empty result is Window=\"[]\" — or a Grid " +
                      "Source to hold them for you (ADR-0001)."
                    : "The Source's Window is null. A Grid Source paints what it holds, and holding nothing is " +
                      "an empty Window, never a missing one (ADR-0001).");
        }
        _windowStart = Source?.WindowStart ?? WindowStart;
        _total = Source is null ? TotalCount : Source.TotalCount;
        _loading = Source?.IsLoading ?? IsLoading;
        _sequenceVersion = Source?.RowSequenceVersion ?? RowSequenceVersion;

        if (!double.IsFinite(RowHeight) || RowHeight <= 0)
        {
            throw new ArgumentOutOfRangeException(nameof(RowHeight), RowHeight,
                "RowHeight is a finite, positive number of pixels (ADR-0013).");
        }
        if (!double.IsFinite(ViewportHeight) || ViewportHeight <= 0)
        {
            throw new ArgumentOutOfRangeException(nameof(ViewportHeight), ViewportHeight,
                "ViewportHeight is a finite, positive number of pixels (ADR-0013).");
        }
        if (ViewportHeight <= RowHeight)
        {
            throw new ArgumentOutOfRangeException(nameof(ViewportHeight), ViewportHeight,
                $"ViewportHeight must exceed RowHeight ({RowHeight}px): the header takes the first row height of it, " +
                "and what is left is where the rows go (ADR-0013).");
        }
        if (!double.IsFinite(ViewportWidth) || ViewportWidth <= 0)
        {
            throw new ArgumentOutOfRangeException(nameof(ViewportWidth), ViewportWidth,
                "ViewportWidth is a finite, positive number of pixels (ADR-0013).");
        }
        if (PinnedColumnCount < 0 || PinnedColumnCount > Columns.Count)
        {
            throw new ArgumentOutOfRangeException(nameof(PinnedColumnCount), PinnedColumnCount,
                $"PinnedColumnCount is the first N of {Columns.Count} columns; there are not that many (ADR-0004).");
        }
        // The header band stands in the content as well as over it, so it spends one row
        // of the browser's scroll budget that ViewportGeometry — which knows only about
        // rows — cannot see. Checked here, where the spacer's real height is known:
        // a result one row inside the pure guard would still have its last row clamped
        // away, and being quietly unable to reach the end is the failure ADR-0013's
        // ceiling exists to refuse.
        if (RowHeight + ((_total ?? _window.Count) * RowHeight) > ViewportGeometry.MaxScrollHeightPx)
        {
            throw new InvalidOperationException(
                $"{_total ?? _window.Count} rows at {RowHeight}px, plus the header's own row height, need " +
                $"{RowHeight + ((_total ?? _window.Count) * RowHeight)}px of scrollable area — past the " +
                $"{ViewportGeometry.MaxScrollHeightPx}px a browser can scroll, so the last rows could never be " +
                "reached. Use a shorter row height, or page the result (ADR-0013/0015).");
        }
        if (CellMetrics.DigitWidthPx <= 0)
        {
            throw new ArgumentOutOfRangeException(nameof(CellMetrics), CellMetrics,
                "default(CellTextMetrics) is not valid; construct it with real metrics.");
        }
        ValidateWindowPlacement();

        var columnsChanged = !ReferenceEquals(_observedColumns, Columns);
        var metricsChanged = _observedMetrics != CellMetrics;

        if (!ReferenceEquals(_observedWindow, _window))
        {
            RequireDistinctRows(_window);
            _observedWindow = _window;
        }

        if (columnsChanged || metricsChanged)
        {
            // A changed column declaration means a fresh tracker re-measured from what
            // is painted next (ADR-0016); the metrics feed the estimates, so they reset
            // with it. The header label is content the column paints too — unobserved,
            // every short Auto column would stand with a chopped header.
            _autoWidths = new AutoWidth[Columns.Count];
            for (var i = 0; i < Columns.Count; i++)
            {
                var spec = Columns[i].Width;
                var auto = new AutoWidth(spec);
                if (spec.Width.IsAuto)
                {
                    auto = auto.Observe(CellMetrics.EstimatePx(Columns[i].Header.Length));
                    // An Action Column paints no value, so the rows can never grow it
                    // and its header is usually empty (ADR-0020) — left at that it would
                    // stand at MinWidth with its buttons clipped. What it does declare
                    // is its labels, so those are what it is measured from, once. A
                    // theme painting icons instead declares a Fixed width; text is the
                    // only thing this grid can estimate (ADR-0021 keeps measurement out
                    // of JavaScript).
                    if (Columns[i].Actions.Count > 0)
                    {
                        // The cell's own padding once, then each button's text plus its
                        // own box. Summed, not maximised: the buttons stand side by side.
                        // Both terms are needed — the cell consumes its padding before
                        // any button is reached, and a button is wider than its text —
                        // and leaving either out resolves a short label like "Open" to a
                        // column narrower than the single button it holds, which
                        // `overflow: hidden` then clips: the very outcome this estimate
                        // exists to prevent.
                        var required = CellMetrics.EstimatePx(0);
                        foreach (var action in Columns[i].Actions)
                            required += (action.Label.Length * CellMetrics.DigitWidthPx) + ActionButtonChromePx;
                        auto = auto.Observe(required);
                    }
                }
                _autoWidths[i] = auto;
            }
            _observedColumns = Columns;
            _observedMetrics = CellMetrics;
            _measured = false;
        }

        ReconcileSelection();
        PrepareRender();
    }


    /// <summary>
    /// Drops the selection when the coordinates it is written in stop meaning what they
    /// meant (ADR-0011). One trigger per axis: the Consumer's Row Sequence Version for
    /// the rows, and the visible-column set for the columns — the grid applies View
    /// State, so it can see the second one itself and needs no version for it.
    ///
    /// The columns are compared by name, in order, and never by the array's identity. A
    /// Consumer that builds its column list inline hands over a fresh array on every
    /// render; dropping on that would clear the selection continuously and make selecting
    /// anything impossible. (The Range Request dedupe fell into exactly this hole, which
    /// is why it deduplicates on where the Window sits rather than on which list it is.)
    /// </summary>
    private void ReconcileSelection()
    {
        var reconciled = _selection.Under(_sequenceVersion);
        if (!ColumnsAreAsBefore())
            reconciled = HeldSelection.Empty(_sequenceVersion);

        if (!reconciled.Selection.Equals(_selection.Selection))
            _selectionChanged = true;
        _selection = reconciled;
    }

    private bool ColumnsAreAsBefore()
    {
        if (_columnNames.Length == Columns.Count)
        {
            var same = true;
            for (var i = 0; same && i < Columns.Count; i++)
                same = _columnNames[i] == Columns[i].Name;
            if (same)
                return true;
        }

        _columnNames = new string[Columns.Count];
        for (var i = 0; i < Columns.Count; i++)
            _columnNames[i] = Columns[i].Name;
        return false;
    }

    /// <summary>
    /// A Window has to say truthfully which positions it holds, because every offset on
    /// screen is derived from that. Refused up front rather than painted at the wrong
    /// place — the three values arrive together in one parameter set, so a contradiction
    /// between them is a Consumer bug, not a race.
    /// </summary>
    private void ValidateWindowPlacement()
    {
        ArgumentOutOfRangeException.ThrowIfNegative(_windowStart, nameof(WindowStart));
        if (_total is null)
        {
            if (_windowStart != 0)
            {
                throw new InvalidOperationException(
                    $"WindowStart is {_windowStart} but TotalCount is null, which claims the Window is the whole result. " +
                    "Pass TotalCount whenever the Window is a slice of something larger (ADR-0001).");
            }
            return;
        }

        ArgumentOutOfRangeException.ThrowIfNegative(_total.Value, nameof(TotalCount));
        if (_windowStart + _window.Count > _total.Value)
        {
            throw new InvalidOperationException(
                $"The Window claims rows {_windowStart}-{_windowStart + _window.Count - 1}, past a TotalCount of {_total.Value}.");
        }
    }

    // Refused up front rather than failing strangely mid-render: a duplicate instance
    // makes Row Identity ambiguous (ADR-0003 — which row did the Consumer mean?), and
    // a null is not a row (an absent row is a Placeholder, ADR-0004).
    //
    // Walking the whole Window is fine while a Window is tens or hundreds of rows. The
    // pull layer that hands over an entire result at once (GridSource.From, Task 9)
    // would make this a hash insert per row on every push, and is where to revisit it.
    private static void RequireDistinctRows(IReadOnlyList<TRow> window)
    {
        var seen = new HashSet<object>(window.Count, ReferenceEqualityComparer.Instance);
        for (var i = 0; i < window.Count; i++)
        {
            var row = window[i];
            if (row is null)
            {
                throw new InvalidOperationException(
                    $"Window[{i}] is null; a Window holds rows, not gaps.");
            }
            if (!seen.Add(row))
            {
                throw new InvalidOperationException(
                    $"Window[{i}] is the same row instance as an earlier position; Row Identity cannot tell them apart (ADR-0003).");
            }
        }
    }

    /// <summary>Recomputes what is on screen and re-observes the widths it needs. Called
    /// wherever the geometry or the painted slice can have moved — parameters, scrolling,
    /// settling — so the two can never disagree.</summary>
    private void PrepareRender()
    {
        // What the Consumer declared, minus what the browser says its scrollbars take out
        // of it (ADR-0013). Both gutters are 0 until the browser reports otherwise, so on
        // a machine with overlay scrollbars this is the declared size exactly and nothing
        // below it changed.
        _box = new ViewportBox(ViewportWidth, ViewportHeight, _gutterWidthPx, _gutterHeightPx);
        if (_box.VisibleHeightPx <= RowHeight)
        {
            // The declared height was checked against RowHeight when it arrived; this is
            // the same rule after the scrollbar has taken its strip, and it can only fail
            // on a platform that draws one. Rather than hand ViewportGeometry a negative
            // band and have it complain about a number the Consumer never wrote.
            throw new InvalidOperationException(
                $"A horizontal scrollbar takes {_gutterHeightPx}px out of the {ViewportHeight}px Viewport, " +
                $"leaving {_box.VisibleHeightPx}px — not enough for the header's own {RowHeight}px, let alone a " +
                "row. Declare a Viewport tall enough to hold its own scrollbar; on a platform with overlay " +
                "scrollbars this same grid would have painted (ADR-0013).");
        }

        // The header stands on the first row height of the Viewport, so the rows get the
        // rest. Everything downstream — how many rows fit, where a scroll offset lands —
        // is arithmetic over that remainder (ADR-0013).
        _geometry = new ViewportGeometry(RowHeight, _box.VisibleHeightPx - RowHeight, _total ?? _window.Count);
        _visible = _geometry.SliceAt(_scrollTopPx);
        ObserveAutoWidths();
        ResolveColumnGeometry();
        _scrollable = _columnStyles.Geometry.ScrollableSliceAt(_scrollLeftPx, VirtualiseColumns);
    }

    /// <summary>
    /// Auto widths grow from what has actually been painted, not from the whole Window:
    /// a Window can hold a hundred thousand rows, and measuring them all on every push
    /// would cost more than the virtualisation saves. Observation is a monotone maximum,
    /// so seeing fewer rows can never narrow a column — a wide value simply grows it as
    /// it scrolls into the Viewport, which is the direction ADR-0016 chose to avoid
    /// judder.
    ///
    /// Every column is observed, including the ones horizontal virtualisation is leaving
    /// out of the DOM, and that is what keeps the horizontal axis stable. Observing only
    /// the painted columns would make a column's width depend on where the Viewport sits:
    /// an Auto column entering from the right would grow, the total width would change,
    /// the scrollbar would change length, and the same scrollLeft would point somewhere
    /// else — a loop feeding itself. Observing all of them takes the position out of the
    /// input and the loop cannot form.
    ///
    /// Paying for that every frame is what the incremental step avoids: observation is a
    /// monotone maximum, so re-observing a row it has already seen cannot change the
    /// answer, and only the rows that newly entered the Viewport are read.
    /// </summary>
    private void ObserveAutoWidths()
    {
        // Nothing is painted during a fling, so there is nothing to measure from —
        // measuring what is not on screen contradicts ADR-0016's "measured from what has
        // been painted", besides being pure waste in the frames that can least afford it.
        //
        // Unless the trackers were just reset. A Consumer swapping the columns mid-fling
        // leaves every Auto column holding nothing but its header estimate, and skipping
        // here would paint that collapsed layout for the whole settle delay and then snap
        // back. One observation costs a normal frame; watching the grid jump does not.
        if (_placeholderMode && _measured)
            return;

        // Measured from the same signals rendering itself follows: a different Window
        // instance, a different slice on screen, different columns or metrics. Reading
        // the rows again when none of those moved is how a rewritten-in-place value
        // would sneak onto the screen (ADR-0003), besides being wasted work.
        var sameWindow = _measured
            && ReferenceEquals(_measuredWindow, _window)
            && _measuredWindowStart == _windowStart;
        if (sameWindow && _measuredVisible == _visible)
            return;

        // Rows the previous observation already folded in. Disjoint from the new slice
        // after a fling, which correctly means every visible row is read again.
        var seen = sameWindow ? _measuredVisible : null;

        _measured = true;
        _measuredWindow = _window;
        _measuredWindowStart = _windowStart;
        _measuredVisible = _visible;

        if (_visible is not { } visible)
            return;

        for (var row = visible.Start; row < visible.Start + visible.Count; row++)
        {
            if (seen is { } already && row >= already.Start && row < already.Start + already.Count)
                continue;
            var slice = row - _windowStart;
            if (slice < 0 || slice >= _window.Count)
                continue;

            var data = _window[slice];
            for (var c = 0; c < Columns.Count; c++)
            {
                var column = Columns[c];
                // A Template or Action column has no text in its cells to measure —
                // observing it would fold in the empty string and hold the column at
                // MinWidth, which is worse than the label estimate it already carries
                // (ADR-0016 / ADR-0020).
                if (!column.Width.Width.IsAuto || !column.PaintsValue)
                    continue;
                _autoWidths[c] = _autoWidths[c].Observe(
                    CellMetrics.EstimatePx(ExGridRow<TRow>.CellText(column, data).Length));
            }
        }
    }

    /// <summary>
    /// Rebuilds the column geometry only when something it is made of actually moved, so
    /// an unchanged layout keeps its instance and the rows keep skipping (ADR-0003). The
    /// comparison runs against the live geometry rather than a parallel copy: one place
    /// holds the widths, so the two cannot fall out of step.
    /// </summary>
    private void ResolveColumnGeometry()
    {
        var geometry = _columnStyles.Geometry;
        if (geometry.Count == Columns.Count
            && geometry.PinnedCount == PinnedColumnCount
            && geometry.ViewportWidthPx == _box.VisibleWidthPx)
        {
            var moved = false;
            for (var c = 0; !moved && c < Columns.Count; c++)
                moved = geometry.WidthPxOf(c) != Columns[c].Width.ResolveWidthPx(_autoWidths[c]);
            if (!moved)
                return;
        }

        var widths = new double[Columns.Count];
        for (var c = 0; c < Columns.Count; c++)
            widths[c] = Columns[c].Width.ResolveWidthPx(_autoWidths[c]);
        _columnStyles = new ColumnStyles(new ColumnGeometry(widths, PinnedColumnCount, _box.VisibleWidthPx));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await AttachScrollAsync();

        // The one place a Range Request is raised. Raising it from OnParametersSet would
        // run the Consumer's handler inside the current render stack, and a Consumer
        // answering synchronously would re-enter the same batch. From here the cycle is
        // structurally finite: raise, the Consumer pushes, an ordinary render follows,
        // and this check finds the range covered and stays quiet.
        await RevealFocusIfNeededAsync();
        await RaiseRangeIfUncoveredAsync();
        await RaiseSelectionIfChangedAsync();
    }

    private async Task AttachScrollAsync()
    {
        // Nothing here may escape: a missing or misconfigured module file would
        // otherwise take the Range Request down with it, and the grid would sit on
        // Placeholders forever without ever asking the Consumer for rows.
        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", ModulePath);
            if (_module is null || _disposed)
                return;

            _self ??= DotNetObjectReference.Create(this);
            var handle = await _module.InvokeAsync<IJSObjectReference>(
                "attach", _root, _scroller, _self, GridKeys.Taken);
            if (_disposed)
            {
                // Disposal overtook the attach; nobody else holds this handle now. Its own
                // dispose still has to run — releasing the .NET reference does not remove
                // the listener it attached (ADR-0018).
                await handle.InvokeVoidAsync("dispose");
                await handle.DisposeAsync();
                return;
            }

            _scrollHandle = handle;
            _metaIsPrimary = await handle.InvokeAsync<bool>("metaIsPrimary");

            // The scroller can already be somewhere: a reload restores the offsets
            // without raising a scroll event, and events arriving before the module
            // landed were skipped by design. Read the position once so the first paint
            // matches what the browser is actually showing.
            ApplyScrollOffset(await handle.InvokeAsync<ScrollOffset>("getScrollOffset"));
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or ObjectDisposedException)
        {
        }
    }

    private async Task OnScrollAsync()
    {
        // Before the module lands there is no offset to read, and substituting zero
        // would jump the grid back to the top. Skipping costs nothing: the next scroll
        // event carries the position that matters.
        if (_scrollHandle is null || _disposed)
            return;

        if (_readingScroll)
        {
            _scrollPending = true;
            return;
        }

        _readingScroll = true;
        try
        {
            do
            {
                _scrollPending = false;
                var offset = await _scrollHandle.InvokeAsync<ScrollOffset>("getScrollOffset");
                // Disposal can have overtaken the read, and a released handle answers
                // zero — applying that would jump the model back to the top and touch a
                // component and a timer that are already gone.
                if (_disposed)
                    return;
                ApplyScrollOffset(offset);
            }
            // Reads are awaited, so a burst would otherwise apply stale offsets out of
            // order; looping on the flag lands the last position and drops the rest.
            while (_scrollPending && !_disposed);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or ObjectDisposedException)
        {
        }
        finally
        {
            _readingScroll = false;
        }
    }

    private void ApplyScrollOffset(ScrollOffset offset)
    {
        if (!double.IsFinite(offset.Top) || !double.IsFinite(offset.Left))
            return;

        var paintedFirstRow = _visible?.Start ?? 0;
        var paintedColumns = _scrollable;
        var previousLeftPx = _scrollLeftPx;
        _scrollTopPx = offset.Top;
        _scrollLeftPx = offset.Left;
        PrepareRender();
        var firstRow = _visible?.Start ?? 0;

        var moved = firstRow != paintedFirstRow || _scrollable != paintedColumns;
        // Either axis on its own is enough. A diagonal fling that crosses screens
        // sideways while barely moving down is still a frame where every cell changes,
        // and testing only the rows would miss it entirely.
        // The horizontal half only counts when the columns are virtualised. Off, the slice
        // is every scrollable column at every offset, so panning sideways changes nothing
        // and costs nothing — blanking the rows would be the only work in the frame, and
        // then paying to rebuild every cell 150ms later. A fling is a way of not painting
        // what would have to be painted; there is nothing to skip here.
        var flung = (firstRow != paintedFirstRow && _geometry.IsFling(paintedFirstRow, firstRow))
            || (VirtualiseColumns && _columnStyles.Geometry.IsFling(previousLeftPx, _scrollLeftPx));
        if (flung)
        {
            // Waiting for data and skipping paint during a fling are one mechanism, so
            // they paint the same thing (ADR-0004).
            _placeholderMode = true;
        }
        if (_placeholderMode)
        {
            // Any scrolling at all keeps it unsettled; the delay measures stillness.
            RestartSettleTimer();
        }
        if (moved || _placeholderMode)
        {
            StateHasChanged();
        }
    }

    /// <summary>
    /// Which cell the pointer is over, read from the offsets the browser already put on
    /// the event. No element is measured: a layout read would be a JavaScript round trip,
    /// and it is deliberately not on the allowlist (ADR-0021) — the grid knows where
    /// every row and column is, so it can answer this itself.
    ///
    /// The offsets are relative to the row Viewport, which is the target of every mouse
    /// event down here because everything inside it is <c>pointer-events: none</c>. Its
    /// top edge is the first painted row, so the slice's offset goes back on; its left
    /// edge is the content's, so the x needs nothing added — but the pinned band has to
    /// be resolved against the scroll offset, which <see cref="ColumnGeometry.ColumnAt"/>
    /// does.
    /// </summary>
    private CellPosition? CellUnder(MouseEventArgs e)
    {
        if (_visible is not { } visible)
            return null;
        var row = _geometry.RowAt(e.OffsetY + _geometry.OffsetPxOf(visible.Start));
        var column = _columnStyles.Geometry.ColumnAt(e.OffsetX, _scrollLeftPx);
        return row is int r && column is int c ? new CellPosition(r, c) : null;
    }

    /// <summary>
    /// Mouse down is one of the three gestures ADR-0012 names, chosen by the modifiers.
    /// The transitions themselves are the pure model's; nothing about what a click means
    /// is decided here.
    /// </summary>
    private void OnMouseDown(MouseEventArgs e)
    {
        // Primary button only. What a secondary click does to a selection is Excel
        // behaviour that has not been specified here, and inventing it would be worse
        // than leaving the selection alone.
        if (e.Button != 0 || CellUnder(e) is not { } cell)
        {
            _suppressRender = true;
            return;
        }

        var extent = Extent;
        var current = _selection.Selection;
        // Shift outranks Ctrl, which is also what Ctrl+Shift+click should do: extend the
        // range being built and leave the other ranges standing, which is ExtendTo. Meta
        // counts as Ctrl so the gesture is the one a Mac user actually makes — both are
        // Chromium (ADR-0017).
        // The same primary modifier the keyboard uses: Ctrl+click everywhere, and
        // Cmd+click where Cmd is what a user reaches for. Folding Meta unconditionally
        // would make Win+click and Super+click add ranges on platforms where that chord
        // belongs to the window manager (ADR-0012).
        var toggling = !e.ShiftKey && (e.CtrlKey || (e.MetaKey && _metaIsPrimary));
        var next = e.ShiftKey ? current.ExtendTo(cell, extent)
            : toggling ? current.ToggleRange(cell, extent)
            : current.Click(cell, extent);

        Apply(next);
        // A toggle-off leaves Anchor and Focus detached on the deselected cell, and
        // dragging on from there would append a range the user never asked for
        // (ADR-0012). Every other gesture has left a range that a drag can grow.
        //
        // Last, because attaching the move handler is itself a change to the markup: a
        // click on the one cell already selected changes no selection at all, and
        // suppressing that render would leave the drag with nothing listening.
        SetDragging(!(toggling && current.Contains(cell)));
    }

    /// <summary>
    /// Dragging is not a transition of its own: mouse down is a Click and the moves are
    /// ExtendTo, which is what <see cref="GridSelection"/> says to do rather than
    /// inventing a third path here.
    /// </summary>
    private void OnMouseMove(MouseEventArgs e)
    {
        // The handler is only attached while dragging, but an event can still be in
        // flight from the frame it was taken off.
        if (!_dragging)
        {
            _suppressRender = true;
            return;
        }

        // Buttons is what is held down now, not what started the gesture. Released
        // outside the grid, no mouseup is ever delivered here — and this is what ends the
        // drag instead. Pointer capture would mean JavaScript, and a document-level
        // listener would make every grid on the page react to every drag (ADR-0018).
        if ((e.Buttons & 1) == 0)
        {
            _suppressRender = true;
            SetDragging(false);
            return;
        }
        if (CellUnder(e) is not { } cell)
        {
            _suppressRender = true;
            return;
        }
        Apply(_selection.Selection.ExtendTo(cell, Extent));
    }

    private void OnMouseUp()
    {
        _suppressRender = true;
        SetDragging(false);
    }

    private void SetDragging(bool dragging)
    {
        if (_dragging == dragging)
            return;
        _dragging = dragging;
        if (dragging)
            _dragHandler["onmousemove"] = _onMouseMove ??= OnMouseMove;
        else
            _dragHandler.Remove("onmousemove");
        // The handler is markup, so adding or removing it has to reach the DOM whatever
        // the selection did — which is why every caller sets the suppression first and
        // lets this override it.
        _suppressRender = false;
    }

    private bool Apply(GridSelection next)
    {
        // Dragging within one cell raises an event per frame and changes nothing, so it
        // renders nothing. This is the only case the root skips a render for — the rows
        // below it do their own skipping (ADR-0003) — and the very next ShouldRender
        // consumes it.
        if (next.Equals(_selection.Selection))
        {
            _suppressRender = true;
            return false;
        }
        _selection = _selection.With(next);
        _selectionChanged = true;
        return true;
    }

    protected override bool ShouldRender()
    {
        var suppressed = _suppressRender;
        _suppressRender = false;
        return !suppressed;
    }

    private async Task RaiseActionAsync(GridActionEventArgs<TRow> args)
    {
        if (_disposed)
            return;
        if (OnAction.HasDelegate)
            await OnAction.InvokeAsync(args);
        await ReclaimFocusAsync();
    }

    /// <summary>
    /// What the browser says its scrollbars take out of the declared Viewport, reported
    /// whenever it changes (ADR-0021). Both numbers are 0 on a platform with overlay
    /// scrollbars, and 0 anywhere until the content overflows.
    ///
    /// The frame between the bar appearing and this landing is painted from the old
    /// visible size: one frame of a slice that is one row too generous, on a grid that
    /// has just gained a scrollbar. That is accepted rather than pre-empted — the
    /// alternative is a layout read of our own before every paint, which is the round
    /// trip the whole geometry exists to avoid (ADR-0013).
    /// </summary>
    [JSInvokable]
    public async Task OnScrollbarGutterChangedAsync(double widthPx, double heightPx)
    {
        // Nothing here is trusted: it crosses the JS boundary, and a NaN would travel
        // silently into every offset the grid computes.
        if (_disposed
            || !double.IsFinite(widthPx) || !double.IsFinite(heightPx)
            || widthPx < 0 || heightPx < 0
            || (widthPx == _gutterWidthPx && heightPx == _gutterHeightPx))
        {
            return;
        }

        // A bar that appeared can have covered the Focus where it stands. Revealing is a
        // no-op when it is already whole on screen, so this costs nothing in the ordinary
        // case and keeps ADR-0012 true in the one that is not.
        // Only when nothing is already armed: a key's reveal may be waiting to run, and
        // it carries an intent this one does not have.
        var shrank = (widthPx > _gutterWidthPx || heightPx > _gutterHeightPx) && !_revealFocus;
        _gutterWidthPx = widthPx;
        _gutterHeightPx = heightPx;
        try
        {
            PrepareRender();
            _revealFocus = _revealFocus || shrank;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            // Not a UI event, so nothing else would surface this: an unusable Viewport
            // would be swallowed into the browser console and the grid would sit there
            // painting the old geometry.
            await DispatchExceptionAsync(ex);
        }
    }

    /// <summary>
    /// A key the core claimed (ADR-0010). Called from the instance's own capture-phase
    /// listener, so a grid without focus never gets here, and two grids on one page never
    /// hear each other's keys (ADR-0018). The listener has already prevented the default:
    /// what is left is to say what the key meant.
    /// </summary>
    [JSInvokable]
    public async Task OnKeyAsync(string key, bool ctrl, bool shift, bool alt, bool meta, bool metaIsPrimary)
    {
        if (_disposed)
            return;
        var action = GridKeys.Resolve(key, ctrl, shift, alt, meta, metaIsPrimary);
        switch (action.Kind)
        {
            case GridKeyKind.None:
                return;
            case GridKeyKind.Leave:
                // The way out of Enter/Tab cycling, which never leaves the selection by
                // design (ADR-0012) and would otherwise trap the keyboard in the grid.
                await LeaveAsync();
                return;
            case GridKeyKind.Engage:
                await EngageAsync();
                return;
        }

        var extent = Extent;
        if (extent.RowCount <= 0 || extent.ColumnCount <= 0)
            return;

        var current = _selection.Selection;
        var fromEmpty = current.IsEmpty;
        if (fromEmpty)
        {
            // GridSelection has no Focus to move from, deliberately. Where a keyboard
            // user starts is a question about the view, not about the selection model,
            // so it is answered here: the first cell on screen, without moving the
            // Viewport. Reached by tabbing in, by clicking the header — and above all
            // after a sort, which drops the selection (ADR-0011) and would otherwise
            // leave every key dead until the user picked up the mouse again.
            if (FirstVisibleCell() is not { } start)
                return;
            current = current.Click(start, extent);
        }

        // A key that moves the Focus, pressed when there is no Focus, only places one —
        // it does not also take its step. This is what every list does: the first Down
        // selects the first item rather than the second, and the selection appears where
        // the user is looking. A key that names a whole region (Ctrl+A, the Space pair,
        // Ctrl+Home) needs no starting point and still does what it says.
        var movesTheFocus = action.Kind
            is GridKeyKind.Move or GridKeyKind.Extend
            or GridKeyKind.MoveToEdge or GridKeyKind.ExtendToEdge or GridKeyKind.Cycle;
        var next = fromEmpty && movesTheFocus ? current : action.Kind switch
        {
            GridKeyKind.Move => current.Move(action.Direction, extent),
            GridKeyKind.Extend => current.Extend(action.Direction, extent),
            GridKeyKind.MoveToEdge => current.MoveToEdge(action.Direction, extent),
            GridKeyKind.ExtendToEdge => current.ExtendToEdge(action.Direction, extent),
            GridKeyKind.Cycle => current.CycleFocus(action.Order, action.Backward, extent),
            GridKeyKind.SelectAll => current.SelectAll(extent),
            GridKeyKind.SelectWholeColumns => current.SelectWholeColumns(extent),
            GridKeyKind.SelectWholeRows => current.SelectWholeRows(extent),
            GridKeyKind.MoveToCorner => current.Click(
                action.Backward
                    ? new CellPosition(0, 0)
                    : new CellPosition(extent.RowCount - 1, extent.ColumnCount - 1),
                extent),
            _ => current,
        };

        // Only when something moved. A transition that changed nothing — ArrowUp at the
        // first row, Home at the first column — suppresses the render, and a reveal armed
        // for a render that never happens fires on whatever renders next: a wheel scroll
        // five hundred rows away would be yanked back to the Focus mid-gesture.
        if (!Apply(next))
        {
            // Apply arms the suppression for the render Blazor runs automatically after a
            // UI event. This is a [JSInvokable]: no such render follows, so an armed flag
            // would sit here and swallow whatever renders NEXT — the following keystroke,
            // a Source's answer landing, the settle timer putting real cells back. The
            // grid would look frozen for one beat, with nothing queued to unfreeze it.
            _suppressRender = false;
            return;
        }
        // The Focus has to end up on screen (ADR-0012), measured after the render against
        // the geometry that was actually painted.
        _revealRowStart = NamesTheStartOfTheRow(action);
        _revealFocus = true;
        StateHasChanged();
    }

    /// <summary>
    /// Whether a key means "go to the beginning" rather than "move one step" — Home and
    /// Ctrl+Left for the row, Ctrl+Home for the whole result, with their Shift forms.
    /// The horizontal direction is what is asked: Ctrl+Up and Ctrl+Down are the same
    /// transition on the other axis and name no column at all.
    /// </summary>
    private static bool NamesTheStartOfTheRow(GridKeyAction action) => action.Kind switch
    {
        GridKeyKind.MoveToEdge or GridKeyKind.ExtendToEdge => action.Direction == GridDirection.Left,
        GridKeyKind.MoveToCorner => action.Backward,
        _ => false,
    };

    /// <summary>Space on a single-action cell fires it; N ≥ 2 and editable cells wait for
    /// the Interactive and Overwrite modes (ADR-0020).</summary>
    private async Task EngageAsync()
    {
        if (_selection.Selection.IsEmpty)
            return;
        var focus = _selection.Selection.Focus;
        if (focus.Column < 0 || focus.Column >= Columns.Count)
            return;
        var column = Columns[focus.Column];
        if (column.Actions.Count != 1)
            return;

        // The row has to be in hand: a Focus over a Placeholder has no row to act on, and
        // ADR-0012 already says editing waits for the data to arrive.
        var slice = focus.Row - _windowStart;
        if (slice < 0 || slice >= _window.Count)
            return;
        await RaiseActionAsync(new GridActionEventArgs<TRow>(_window[slice], column.Name, column.Actions[0].Name));
    }

    /// <summary>
    /// Called after one of the grid's own action buttons fires. Clicking a button gives it
    /// DOM focus, and the keys then belong to it rather than to the grid — which is right
    /// while it is focused and wrong the moment it has finished. Handing the keyboard back
    /// keeps "click a button, then carry on with the arrows" working. A Consumer's own
    /// control in a Template Column is left alone: it may well want to keep the focus.
    /// </summary>
    private async Task ReclaimFocusAsync()
    {
        if (_disposed)
            return;
        try
        {
            await _root.FocusAsync(preventScroll: true);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or ObjectDisposedException)
        {
        }
    }

    private async Task LeaveAsync()
    {
        if (_scrollHandle is null || _disposed)
            return;
        try
        {
            await _scrollHandle.InvokeVoidAsync("blur");
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or ObjectDisposedException)
        {
        }
    }

    /// <summary>The top-left cell currently painted — the leading Pinned Column when there
    /// is one, otherwise the leftmost scrollable column on screen.</summary>
    private CellPosition? FirstVisibleCell()
    {
        if (_visible is not { } visible)
            return null;
        var column = _columnStyles.Geometry.PinnedCount > 0 ? 0 : _scrollable?.Start ?? 0;
        return new CellPosition(visible.Start, column);
    }

    private async Task RevealFocusIfNeededAsync()
    {
        if (!_revealFocus)
            return;
        var toRowStart = _revealRowStart;
        _revealFocus = false;
        _revealRowStart = false;
        if (_disposed || _scrollHandle is null || _selection.Selection.IsEmpty)
            return;

        var focus = _selection.Selection.Focus;
        if (focus.Row >= _geometry.TotalRowCount || focus.Column >= _columnStyles.Geometry.Count)
            return;
        var top = _geometry.ScrollTopToReveal(focus.Row, _scrollTopPx);
        // "Go to the beginning" is not the same request as "make this cell visible", and
        // Pinned Columns are where the two come apart. ScrollLeftToReveal answers the
        // second one and answers it correctly: a pinned column covers the Viewport's left
        // edge, so it is already whole on screen and nothing has to move. But Home and
        // Ctrl+Home mean the first one — and with the first column pinned they would leave
        // the Viewport parked wherever it was, halfway along a hundred columns, which is
        // not where the row starts.
        //
        // What settles it is that pinning would otherwise CHANGE what the key does:
        // unpinned, column 0 is scrollable and revealing it already lands the Viewport at
        // 0. This makes the two agree rather than inventing a behaviour for the pinned
        // case. (A press that moves nothing at all — the Focus is already at the first
        // column — renders nothing and so reveals nothing, pinned or not. That is the
        // "only when something moved" guard above, and it is the same on both paths.)
        var left = toRowStart
            ? 0
            : _columnStyles.Geometry.ScrollLeftToReveal(focus.Column, _scrollLeftPx);
        if (top == _scrollTopPx && left == _scrollLeftPx)
            return;

        try
        {
            // The browser answers with a scroll event, which is what updates the offsets
            // and, if the Focus went past the Window, raises the Range Request (ADR-0012).
            await _scrollHandle.InvokeVoidAsync("setScrollOffset", top, left);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or ObjectDisposedException)
        {
        }
    }

    private async Task RaiseSelectionIfChangedAsync()
    {
        // Raised from after the render for the reason the Range Request is: a Consumer
        // that handles it synchronously would otherwise re-enter the batch it was raised
        // from.
        if (!_selectionChanged)
            return;
        _selectionChanged = false;
        if (_disposed || !SelectionChanged.HasDelegate)
            return;
        await SelectionChanged.InvokeAsync(_selection.Selection);
    }

    private void RestartSettleTimer()
    {
        if (_disposed)
            return;
        _settleTimer ??= Time.CreateTimer(OnSettled, null, Timeout.InfiniteTimeSpan, Timeout.InfiniteTimeSpan);
        _settleTimer.Change(SettleDelay, Timeout.InfiniteTimeSpan);
    }

    private void OnSettled(object? state)
    {
        // The timer fires off the renderer's synchronisation context; everything it
        // touches has to go back onto it.
        _ = InvokeAsync(() =>
        {
            if (_disposed || !_placeholderMode)
                return;
            try
            {
                _placeholderMode = false;
                PrepareRender();
                StateHasChanged();
            }
            catch (Exception ex)
            {
                _ = DispatchExceptionAsync(ex);
            }
        });
    }

    private bool IsCovered(RowRange range)
        => range.Start >= _windowStart && range.Start + range.Count <= _windowStart + _window.Count;

    private async Task RaiseRangeIfUncoveredAsync()
    {
        // Mid-fling the visible range is passing through; asking for every range it
        // crosses is what ADR-0004's one mechanism exists to avoid. Settling raises the
        // range that was actually landed on.
        if (_disposed || _placeholderMode || (Source is null && !OnRangeNeeded.HasDelegate))
            return;
        if (_visible is not { } range || IsCovered(range))
        {
            _lastRaised = null;
            return;
        }

        // Asked once, and not again until the Window actually moved. What counts is
        // where the Window sits, never which instance it is: a Consumer that builds its
        // Window inline hands over a fresh list on every render, and re-asking for that
        // would spin — as would a Consumer that answers, honestly but unhelpfully, with
        // rows that still do not cover the Viewport.
        if (_lastRaised == range
            && _lastRaisedWindowStart == _windowStart
            && _lastRaisedWindowCount == _window.Count)
        {
            return;
        }

        _lastRaised = range;
        _lastRaisedWindowStart = _windowStart;
        _lastRaisedWindowCount = _window.Count;
        // Awaited, so a Source that fetches surfaces its failure here rather than in an
        // unobserved task, and the loading state it raised is already on screen.
        if (Source is not null)
            await Source.OnRangeNeededAsync(range);
        else
            await OnRangeNeeded.InvokeAsync(range);
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _settleTimer?.Dispose();
        if (_boundSource is not null)
        {
            _boundSource.StateChanged -= OnSourceStateChanged;
            _boundSource = null;
        }
        try
        {
            if (_scrollHandle is not null)
            {
                // Releasing the .NET reference does not run the handle's own dispose;
                // a grid gives back what it took (ADR-0018).
                await _scrollHandle.InvokeVoidAsync("dispose");
                await _scrollHandle.DisposeAsync();
            }
            if (_module is not null)
                await _module.DisposeAsync();
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or ObjectDisposedException)
        {
        }
        finally
        {
            // After the handle's own dispose has removed the listener, never before: a
            // key arriving in between would invoke a reference that has already been
            // released, and the module would report it as a fault when it is only a race
            // with teardown.
            _self?.Dispose();
            _self = null;
        }
    }

    private static object RowKey(TRow row) => RowIdentityKeys.GetValue(row, static _ => new object());

    private static string Px(double value) => FormattableString.Invariant($"{value}px");
}
