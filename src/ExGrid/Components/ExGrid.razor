    /// behaviour, its colour is appearance (<c>--ex-focus-row-fill</c>, ADR-0027's
    /// split). One more overlay rectangle — no row learns anything.
    /// </summary>
    [Parameter] public bool HighlightFocusRow { get; set; }

    /// <summary>
