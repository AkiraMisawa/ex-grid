@typeparam TRow where TRow : class
@using System.Globalization
@using System.Runtime.CompilerServices
@using global::ExGrid.Columns
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IServiceProvider Services

@*
    The push entry point (ADR-0001): the grid paints the Window it is given and holds
    no data of its own. When the Viewport moves past what the Window covers it raises a
    Range Request and keeps painting Placeholders — it never fetches and never waits.
    Only the parameters this layer renders are declared; the rest of the push contract
    (Sorts, Filter, PageSize, ...) arrives with the layers that give it behaviour.

    The root deliberately has no ShouldRender: re-rendering it is cheap because the
    row boundaries below it skip (ADR-0003).
*@
<div class="@RootClass" style="--ex-row-height: @Px(RowHeight)">
    @* The header and the scroller are both as wide as the columns, so the one
       horizontal scrollbar — the root's — pans them together. Left to itself the
       scroller would scroll horizontally on its own (a non-visible overflow on one
       axis makes the other axis auto), and the body would slide out from under the
       header: every column read under its neighbour's label. *@
    <div class="ex-header" style="width: @Px(_totalWidthPx)">
        @for (var i = 0; i < Columns.Count; i++)
        {
            <div class="ex-header-cell" style="@WidthStyle(_resolvedWidths[i])">@Columns[i].Header</div>
        }
    </div>
    <div class="ex-scroller" style="height: @Px(ViewportHeight); width: @Px(_totalWidthPx)" @ref="_scroller" @onscroll="OnScrollAsync">
        <div class="ex-spacer" style="height: @Px(_geometry.ScrollHeightPx)">
            <div class="ex-viewport" style="transform: translateY(@Px(_geometry.OffsetPxOf(_visible?.Start ?? 0)))">
                @if (_visible is { } visible)
                {
                    @* One loop over absolute row positions, and every sibling carries a
                       key: a keyed component beside an unkeyed element degrades the diff
                       to positional matching, which would recreate the very row
                       components memoisation exists to keep (ADR-0003). Row keys are
                       identity objects and Placeholder keys are boxed indices, so the
                       two can never collide — and a position turning from Placeholder
                       into a row correctly reads as a fresh mount. *@
                    @for (var row = visible.Start; row < visible.Start + visible.Count; row++)
                    {
                        var slice = row - WindowStart;
                        if (!_placeholderMode && slice >= 0 && slice < Window.Count)
                        {
                            var data = Window[slice];
                            <ExGridRow @key="RowKey(data)" Row="data" Columns="Columns" Widths="_resolvedWidths" Metrics="CellMetrics" />
                        }
                        else
                        {
                            <div class="ex-row ex-placeholder" @key="row"></div>
                        }
                    }
                }
            </div>
        </div>
    </div>
</div>

@code {
    private const double DefaultRowHeightPx = 28;
    private const double DefaultViewportHeightPx = 600;

    /// <summary>
    /// How long scrolling must stand still before Placeholders are filled in with real
    /// cells (ADR-0004). Too short and contents blank out during ordinary scrolling;
    /// too long and the grid feels empty. Internal until a measurement earns it a
    /// parameter — the ADR says decide this by measuring, not by reasoning.
    /// </summary>
    private static readonly TimeSpan SettleDelay = TimeSpan.FromMilliseconds(150);

    private const string ModulePath = "./_content/ExGrid/ex-grid.js";

    /// <summary>
    /// The metrics behind width observation and the overflow decision until a theme
    /// layer supplies real ones. The digit width is contractually at least as wide as
    /// any glyph the formats emit (ADR-0016) — overshooting errs toward an early
    /// <c>####</c>, the safe direction. Both values pair with ex-grid.css and must move
    /// with it: 9px covers a tabular digit of the common system fonts at the
    /// stylesheet's pinned 14px (SF Pro measures 8.55px there), and the padding is its
    /// 8px. A theme that changes the font supplies its own <see cref="CellMetrics"/>.
    /// </summary>
    public static readonly CellTextMetrics DefaultCellMetrics = new(digitWidthPx: 9, cellHorizontalPaddingPx: 8);

    // One key object per row instance, so @key is reference identity even when TRow
    // overrides Equals (a record row model): value-equal rows are still different rows
    // (ADR-0003), and Blazor's duplicate-@key refusal must not fire on them. Entries
    // die with their rows; the table is per closed generic type.
    private static readonly ConditionalWeakTable<TRow, object> RowIdentityKeys = new();

    /// <summary>The contiguous block of rows the Consumer pushes in, starting at
    /// <see cref="WindowStart"/> (ADR-0001).</summary>
    [Parameter, EditorRequired] public IReadOnlyList<TRow> Window { get; set; } = [];

    /// <summary>Where the Window begins in the current order. The grid paints rows at
    /// their positions in the whole result, so it must know which positions the Window
    /// holds — without it a Window of rows 500-560 would paint at the top.</summary>
    [Parameter] public int WindowStart { get; set; }

    /// <summary>
    /// How many rows the whole result has, which is what the scrollbar is long enough
    /// for. Null means the Window is the whole result — the shape
    /// <c>GridSource.From</c> produces, where everything is in hand (ADR-0001).
    /// </summary>
    [Parameter] public int? TotalCount { get; set; }

    [Parameter, EditorRequired] public IReadOnlyList<GridColumn<TRow>> Columns { get; set; } = [];

    /// <summary>Emitted as --ex-row-height on the instance root, inline so a stylesheet
    /// cannot override it — the truth lives in this parameter, not in CSS (ADR-0013).</summary>
    [Parameter] public double RowHeight { get; set; } = DefaultRowHeightPx;

    /// <summary>
    /// How tall the scrolling area is. A C# parameter for the same reason the row
    /// height is one (ADR-0013): the virtualisation arithmetic reads it, and measuring
    /// the element instead would mean a layout round-trip through JavaScript, which is
    /// deliberately not on the allowlist (ADR-0021).
    /// </summary>
    [Parameter] public double ViewportHeight { get; set; } = DefaultViewportHeightPx;

    /// <summary>Overridden by a theme that measured its real font; defaults to
    /// <see cref="DefaultCellMetrics"/>.</summary>
    [Parameter] public CellTextMetrics CellMetrics { get; set; } = DefaultCellMetrics;

    /// <summary>
    /// Raised when the rows on screen are not all in the Window: "I need these rows".
    /// The grid does not wait and does not fetch — it keeps painting Placeholders until
    /// a Window that covers them arrives (ADR-0001). Read-ahead, throttling and
    /// discarding stale answers belong to the Consumer.
    /// </summary>
    [Parameter] public EventCallback<RowRange> OnRangeNeeded { get; set; }

    /// <summary>Whether an answer is in flight. Forgetting to pass it means a stale
    /// Window is shown as if it were current (ADR-0001).</summary>
    [Parameter] public bool IsLoading { get; set; }

    private ElementReference _scroller;
    private IJSObjectReference? _module;
    private IJSObjectReference? _scrollHandle;
    private bool _disposed;
    private bool _readingScroll;
    private bool _scrollPending;

    private TimeProvider? _time;
    private ITimer? _settleTimer;
    private bool _placeholderMode;

    private double _scrollTopPx;
    private ViewportGeometry _geometry = new(DefaultRowHeightPx, DefaultViewportHeightPx, 0);
    private RowRange? _visible;

    private RowRange? _lastRaised;
    private int _lastRaisedWindowStart;
    private int _lastRaisedWindowCount;

    private IReadOnlyList<TRow>? _observedWindow;
    private IReadOnlyList<GridColumn<TRow>>? _observedColumns;
    private CellTextMetrics _observedMetrics;
    private AutoWidth[] _autoWidths = [];
    private double[] _resolvedWidths = [];
    private double _totalWidthPx;

    // What the widths were last measured from. Re-measuring on every render would read
    // the rows' current contents, so an in-place rewrite would grow a column and repaint
    // through the width path — the repaint ADR-0003 promises will not happen.
    private IReadOnlyList<TRow>? _measuredWindow;
    private int _measuredWindowStart;
    private RowRange? _measuredVisible;
    private bool _measured;

    private string RootClass => IsLoading ? "ex-grid ex-loading" : "ex-grid";

    private TimeProvider Time
        => _time ??= Services.GetService(typeof(TimeProvider)) as TimeProvider ?? TimeProvider.System;

    protected override void OnParametersSet()
    {
        if (!double.IsFinite(RowHeight) || RowHeight <= 0)
        {
            throw new ArgumentOutOfRangeException(nameof(RowHeight), RowHeight,
                "RowHeight is a finite, positive number of pixels (ADR-0013).");
        }
        if (!double.IsFinite(ViewportHeight) || ViewportHeight <= 0)
        {
            throw new ArgumentOutOfRangeException(nameof(ViewportHeight), ViewportHeight,
                "ViewportHeight is a finite, positive number of pixels (ADR-0013).");
        }
        if (CellMetrics.DigitWidthPx <= 0)
        {
            throw new ArgumentOutOfRangeException(nameof(CellMetrics), CellMetrics,
                "default(CellTextMetrics) is not valid; construct it with real metrics.");
        }
        ValidateWindowPlacement();

        var columnsChanged = !ReferenceEquals(_observedColumns, Columns);
        var metricsChanged = _observedMetrics != CellMetrics;

        if (!ReferenceEquals(_observedWindow, Window))
        {
            RequireDistinctRows(Window);
            _observedWindow = Window;
        }

        if (columnsChanged || metricsChanged)
        {
            // A changed column declaration means a fresh tracker re-measured from what
            // is painted next (ADR-0016); the metrics feed the estimates, so they reset
            // with it. The header label is content the column paints too — unobserved,
            // every short Auto column would stand with a chopped header.
            _autoWidths = new AutoWidth[Columns.Count];
            for (var i = 0; i < Columns.Count; i++)
            {
                var spec = Columns[i].Width;
                var auto = new AutoWidth(spec);
                if (spec.Width.IsAuto)
                    auto = auto.Observe(CellMetrics.EstimatePx(Columns[i].Header.Length));
                _autoWidths[i] = auto;
            }
            _observedColumns = Columns;
            _observedMetrics = CellMetrics;
            _measured = false;
        }

        PrepareRender();
    }

    /// <summary>
    /// A Window has to say truthfully which positions it holds, because every offset on
    /// screen is derived from that. Refused up front rather than painted at the wrong
    /// place — the three values arrive together in one parameter set, so a contradiction
    /// between them is a Consumer bug, not a race.
    /// </summary>
    private void ValidateWindowPlacement()
    {
        ArgumentOutOfRangeException.ThrowIfNegative(WindowStart);
        if (TotalCount is null)
        {
            if (WindowStart != 0)
            {
                throw new InvalidOperationException(
                    $"WindowStart is {WindowStart} but TotalCount is null, which claims the Window is the whole result. " +
                    "Pass TotalCount whenever the Window is a slice of something larger (ADR-0001).");
            }
            return;
        }

        ArgumentOutOfRangeException.ThrowIfNegative(TotalCount.Value, nameof(TotalCount));
        if (WindowStart + Window.Count > TotalCount.Value)
        {
            throw new InvalidOperationException(
                $"The Window claims rows {WindowStart}-{WindowStart + Window.Count - 1}, past a TotalCount of {TotalCount.Value}.");
        }
    }

    // Refused up front rather than failing strangely mid-render: a duplicate instance
    // makes Row Identity ambiguous (ADR-0003 — which row did the Consumer mean?), and
    // a null is not a row (an absent row is a Placeholder, ADR-0004).
    private static void RequireDistinctRows(IReadOnlyList<TRow> window)
    {
        var seen = new HashSet<object>(window.Count, ReferenceEqualityComparer.Instance);
        for (var i = 0; i < window.Count; i++)
        {
            var row = window[i];
            if (row is null)
            {
                throw new InvalidOperationException(
                    $"Window[{i}] is null; a Window holds rows, not gaps.");
            }
            if (!seen.Add(row))
            {
                throw new InvalidOperationException(
                    $"Window[{i}] is the same row instance as an earlier position; Row Identity cannot tell them apart (ADR-0003).");
            }
        }
    }

    /// <summary>Recomputes what is on screen and re-observes the widths it needs. Called
    /// wherever the geometry or the painted slice can have moved — parameters, scrolling,
    /// settling — so the two can never disagree.</summary>
    private void PrepareRender()
    {
        _geometry = new ViewportGeometry(RowHeight, ViewportHeight, TotalCount ?? Window.Count);
        _visible = _geometry.SliceAt(_scrollTopPx);
        ObserveAutoWidths();
    }

    /// <summary>
    /// Auto widths grow from what has actually been painted, not from the whole Window:
    /// a Window can hold a hundred thousand rows, and measuring them all on every push
    /// would cost more than the virtualisation saves. Observation is a monotone maximum,
    /// so seeing fewer rows can never narrow a column — a wide value simply grows it as
    /// it scrolls into the Viewport, which is the direction ADR-0016 chose to avoid
    /// judder. The resolved array is replaced only when a width actually moved, so an
    /// unchanged layout keeps its reference and the rows keep skipping (ADR-0003).
    /// </summary>
    private void ObserveAutoWidths()
    {
        // Measured from the same signals rendering itself follows: a different Window
        // instance, a different slice on screen, different columns or metrics. Reading
        // the rows again when none of those moved is how a rewritten-in-place value
        // would sneak onto the screen (ADR-0003), besides being wasted work.
        if (_measured
            && ReferenceEquals(_measuredWindow, Window)
            && _measuredWindowStart == WindowStart
            && _measuredVisible == _visible)
        {
            return;
        }

        _measured = true;
        _measuredWindow = Window;
        _measuredWindowStart = WindowStart;
        _measuredVisible = _visible;

        for (var c = 0; c < Columns.Count; c++)
        {
            var column = Columns[c];
            if (!column.Width.Width.IsAuto)
                continue;

            var auto = _autoWidths[c];
            if (_visible is { } visible)
            {
                for (var row = visible.Start; row < visible.Start + visible.Count; row++)
                {
                    var slice = row - WindowStart;
                    if (slice < 0 || slice >= Window.Count)
                        continue;
                    auto = auto.Observe(CellMetrics.EstimatePx(ExGridRow<TRow>.CellText(column, Window[slice]).Length));
                }
            }
            _autoWidths[c] = auto;
        }

        var widths = new double[Columns.Count];
        var total = 0d;
        for (var c = 0; c < Columns.Count; c++)
        {
            widths[c] = Columns[c].Width.ResolveWidthPx(_autoWidths[c]);
            total += widths[c];
        }

        var changed = widths.Length != _resolvedWidths.Length;
        for (var c = 0; !changed && c < widths.Length; c++)
            changed = widths[c] != _resolvedWidths[c];
        if (changed)
        {
            _resolvedWidths = widths;
            _totalWidthPx = total;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await AttachScrollAsync();

        // The one place a Range Request is raised. Raising it from OnParametersSet would
        // run the Consumer's handler inside the current render stack, and a Consumer
        // answering synchronously would re-enter the same batch. From here the cycle is
        // structurally finite: raise, the Consumer pushes, an ordinary render follows,
        // and this check finds the range covered and stays quiet.
        await RaiseRangeIfUncoveredAsync();
    }

    private async Task AttachScrollAsync()
    {
        // Nothing here may escape: a missing or misconfigured module file would
        // otherwise take the Range Request down with it, and the grid would sit on
        // Placeholders forever without ever asking the Consumer for rows.
        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", ModulePath);
            if (_module is null || _disposed)
                return;

            var handle = await _module.InvokeAsync<IJSObjectReference>("attach", _scroller);
            if (_disposed)
            {
                // Disposal overtook the attach; nobody else holds this handle now.
                await handle.DisposeAsync();
                return;
            }

            _scrollHandle = handle;

            // The scroller can already be somewhere: a reload restores scrollTop without
            // raising a scroll event, and events arriving before the module landed were
            // skipped by design. Read the position once so the first paint matches what
            // the browser is actually showing.
            ApplyScrollTop(await handle.InvokeAsync<double>("getScrollTop"));
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or ObjectDisposedException)
        {
        }
    }

    private async Task OnScrollAsync()
    {
        // Before the module lands there is no offset to read, and substituting zero
        // would jump the grid back to the top. Skipping costs nothing: the next scroll
        // event carries the position that matters.
        if (_scrollHandle is null || _disposed)
            return;

        if (_readingScroll)
        {
            _scrollPending = true;
            return;
        }

        _readingScroll = true;
        try
        {
            do
            {
                _scrollPending = false;
                var top = await _scrollHandle.InvokeAsync<double>("getScrollTop");
                // Disposal can have overtaken the read, and a released handle answers
                // zero — applying that would jump the model back to the top and touch a
                // component and a timer that are already gone.
                if (_disposed)
                    return;
                ApplyScrollTop(top);
            }
            // Reads are awaited, so a burst would otherwise apply stale offsets out of
            // order; looping on the flag lands the last position and drops the rest.
            while (_scrollPending && !_disposed);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or ObjectDisposedException)
        {
        }
        finally
        {
            _readingScroll = false;
        }
    }

    private void ApplyScrollTop(double scrollTopPx)
    {
        if (!double.IsFinite(scrollTopPx))
            return;

        var paintedFirstRow = _visible?.Start ?? 0;
        _scrollTopPx = scrollTopPx;
        PrepareRender();
        var firstRow = _visible?.Start ?? 0;

        var moved = firstRow != paintedFirstRow;
        if (moved && _geometry.IsFling(paintedFirstRow, firstRow))
        {
            // Waiting for data and skipping paint during a fling are one mechanism, so
            // they paint the same thing (ADR-0004).
            _placeholderMode = true;
        }
        if (_placeholderMode)
        {
            // Any scrolling at all keeps it unsettled; the delay measures stillness.
            RestartSettleTimer();
        }
        if (moved || _placeholderMode)
        {
            StateHasChanged();
        }
    }

    private void RestartSettleTimer()
    {
        if (_disposed)
            return;
        _settleTimer ??= Time.CreateTimer(OnSettled, null, Timeout.InfiniteTimeSpan, Timeout.InfiniteTimeSpan);
        _settleTimer.Change(SettleDelay, Timeout.InfiniteTimeSpan);
    }

    private void OnSettled(object? state)
    {
        // The timer fires off the renderer's synchronisation context; everything it
        // touches has to go back onto it.
        _ = InvokeAsync(() =>
        {
            if (_disposed || !_placeholderMode)
                return;
            _placeholderMode = false;
            PrepareRender();
            StateHasChanged();
        });
    }

    private bool IsCovered(RowRange range)
        => range.Start >= WindowStart && range.Start + range.Count <= WindowStart + Window.Count;

    private async Task RaiseRangeIfUncoveredAsync()
    {
        // Mid-fling the visible range is passing through; asking for every range it
        // crosses is what ADR-0004's one mechanism exists to avoid. Settling raises the
        // range that was actually landed on.
        if (_disposed || _placeholderMode || !OnRangeNeeded.HasDelegate)
            return;
        if (_visible is not { } range || IsCovered(range))
        {
            _lastRaised = null;
            return;
        }

        // Asked once, and not again until the Window actually moved. What counts is
        // where the Window sits, never which instance it is: a Consumer that builds its
        // Window inline hands over a fresh list on every render, and re-asking for that
        // would spin — as would a Consumer that answers, honestly but unhelpfully, with
        // rows that still do not cover the Viewport.
        if (_lastRaised == range
            && _lastRaisedWindowStart == WindowStart
            && _lastRaisedWindowCount == Window.Count)
        {
            return;
        }

        _lastRaised = range;
        _lastRaisedWindowStart = WindowStart;
        _lastRaisedWindowCount = Window.Count;
        await OnRangeNeeded.InvokeAsync(range);
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _settleTimer?.Dispose();
        try
        {
            if (_scrollHandle is not null)
            {
                // Releasing the .NET reference does not run the handle's own dispose;
                // a grid gives back what it took (ADR-0018).
                await _scrollHandle.InvokeVoidAsync("dispose");
                await _scrollHandle.DisposeAsync();
            }
            if (_module is not null)
                await _module.DisposeAsync();
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or ObjectDisposedException)
        {
        }
    }

    private static object RowKey(TRow row) => RowIdentityKeys.GetValue(row, static _ => new object());

    private static string WidthStyle(double px) => FormattableString.Invariant($"width: {px}px");

    private static string Px(double value) => FormattableString.Invariant($"{value}px");
}
