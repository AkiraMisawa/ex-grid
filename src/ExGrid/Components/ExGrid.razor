        _cellMetricsSupplied |= parameters.TryGetValue<CellTextMetrics>(nameof(CellMetrics), out _);
        _densitySupplied |= parameters.TryGetValue<GridDensity>(nameof(Density), out _);
        _hoverSupplied |= parameters.TryGetValue<bool>(nameof(HighlightHoverRow), out _);
        _stripesSupplied |= parameters.TryGetValue<bool>(nameof(StripeRows), out _);

        var sourceSupplied = parameters.TryGetValue<IGridSource<TRow>?>(nameof(Source), out _);
        var supplied = new List<string>();
        foreach (var name in SourceReplaces)
        {
            if (parameters.TryGetValue<object>(name, out _))
                supplied.Add(name);
        }

        if (sourceSupplied && supplied.Count > 0)
        {
            throw new InvalidOperationException(
                $"Source was passed together with {string.Join(", ", supplied)}. A Source holds those itself " +
                "and drives the push form internally, so one of the two would have to silently win. Pass a " +
                "Source, or pass the push parameters — not both (ADR-0001).");
        }
        // Neither is a Consumer that forgot: an empty grid is written as Window="[]",
        // never as nothing at all. Left unchecked it paints an empty result that looks
        // exactly like a loaded one. Asked of the Window itself, not of any push parameter:
        // a callback such as OnFind or OnSortChanged passed alone is still no data.
        if (!sourceSupplied && !parameters.TryGetValue<object>(nameof(Window), out _) && !_bound)
        {
            throw new InvalidOperationException(
                "Neither Window nor Source was passed. Pass the Window to paint (push), or a Grid Source to " +
                "hold it for you (pull) — an empty result is Window=\"[]\" (ADR-0001).");
        }

        _bound = true;
        return base.SetParametersAsync(parameters);
    }

    protected override void OnParametersSet()
    {
        ValidatePointDeclaration();
        // The Source's own change notification lands in the same pipeline (ApplyState),
        // so a re-entrant one raised by the column push below would run it twice.
        _applying = true;
        try
        {
            BindSource();
            BindMarks();
            ApplyState();
        }
        finally
        {
            _applying = false;
        }
    }

    /// <summary>
    /// Subscribes to the Source and keeps its columns current. The subscription is
    /// swapped when the instance changes and released on disposal: left attached, a
    /// replaced Source would go on repainting a grid that no longer shows it.
    /// </summary>
    private void BindSource()
    {
        if (!ReferenceEquals(_boundSource, Source))
        {
            // A bundled source belongs to one circuit (ADR-0018 §5): attached before the
            // swap, so a refusal leaves the grid bound to what it had.
            if (Source is IBindsToOneCircuit bindsTo)
                bindsTo.Binding.Attach(this, SynchronizationContext.Current);
            if (_boundSource is not null)
            {
                _boundSource.StateChanged -= OnSourceStateChanged;
                (_boundSource as IBindsToOneCircuit)?.Binding.Detach(this);
            }
            _boundSource = Source;
            _boundColumns = null;
            if (_boundSource is not null)
                _boundSource.StateChanged += OnSourceStateChanged;
        }

        if (_boundSource is null || ReferenceEquals(_boundColumns, Columns))
            return;

        // The markup declaration stays the single source of truth (ADR-0023); the source
        // gets the filtering-and-sorting slice of it. Pushing the same columns again is a
        // no-op inside the source, so a Consumer rebuilding its array costs a comparison,
        // not a requery.
        _boundColumns = Columns;
        var infos = new ColumnInfo<TRow>[Columns.Count];
        for (var i = 0; i < Columns.Count; i++)
            infos[i] = Columns[i].Info;
        _boundSource.OnColumnsChanged(infos);
    }

    private void OnSourceStateChanged()
    {
        if (_disposed || _applying)
            return;
        // Marshalled: a Source that fetches raises this from whatever thread its answer
        // arrived on. ApplyState has to run with it — OnParametersSet does not run for a
        // change that came from outside the parameters, and rendering alone would paint
        // the new Window through the old geometry and the old Auto widths.
        _ = InvokeAsync(() =>
        {
            if (_disposed)
                return;
            try
            {
                ApplyState();
                StateHasChanged();
            }
            catch (Exception ex)
            {
                // ApplyState validates what it was handed (ADR-0001), and a Source
                // landing an answer is exactly the case that arrives off the renderer's
                // thread. Discarded with the task, the refusal would vanish and the grid
                // would go on painting the previous state — which is the failure the
                // validation exists to prevent, arrived at by another route.
                _ = DispatchExceptionAsync(ex);
            }
        });
    }

    private void ApplyState()
    {
        _window = Source?.Window ?? Window;
        if (_window is null)
        {
            throw new InvalidOperationException(
                Source is null
                    ? "Window is null. Pass the rows to paint — an empty result is Window=\"[]\" — or a Grid " +
                      "Source to hold them for you (ADR-0001)."
                    : "The Source's Window is null. A Grid Source paints what it holds, and holding nothing is " +
                      "an empty Window, never a missing one (ADR-0001).");
        }
        _windowStart = Source?.WindowStart ?? WindowStart;
        _total = Source is null ? TotalCount : Source.TotalCount;
        _loading = Source?.IsLoading ?? IsLoading;
        _sequenceVersion = Source?.RowSequenceVersion ?? RowSequenceVersion;
        _sorts = Source is not null ? Source.Sorts : Sorts ?? [];
        _filter = Source is not null ? Source.Filter : Filters;

        if (_cellMetricsSupplied && CellMetrics.DigitWidthPx <= 0)
        {
            throw new ArgumentOutOfRangeException(nameof(CellMetrics), CellMetrics,
                "default(CellTextMetrics) is not valid; construct it with real metrics.");
        }

        // Resolved once, per precedence: explicit parameter > Density preset > default
        // (ADR-0028). Everything below — the arithmetic and the inline tokens — reads
        // this and nothing else.
        // A Wrapper's cascaded defaults sit one rung below the explicit parameters
        // (ADR-0030): its Density stands where none was written, and its glyph widths
        // where no CellMetrics were.
        var previousMetrics = _metrics;
        _metrics = GridMetrics.Resolve(
            _densitySupplied ? Density : Presentation?.Density ?? Density,
            _rowHeightSupplied ? RowHeight : null,
            HeaderHeight,
            _cellMetricsSupplied ? CellMetrics : null,
            Presentation);
        if (!ReferenceEquals(previousMetrics, _metrics) && previousMetrics != _metrics)
        {
            _rootStyle = "";
            // The scroll anchor is the first visible row, not the pixel offset
            // (ADR-0028): at a million rows, keeping scrollTop across a row-height
            // change would silently teleport the user a third of the dataset away.
            if (previousMetrics.RowHeightPx != _metrics.RowHeightPx && _visible is { } anchored)
            {
                // Page-local: _visible is absolute, the scroll offset is not — under a
                // pager, anchoring on the absolute index would land past the page's own
                // scroll range and clamp the view to its end.
                // A content offset: the geometry it is read through is built below
                // (ADR-0053), and is the identity unless the height is compressed.
                _anchorContentPx = (anchored.Start - _pageStartRow) * _metrics.RowHeightPx;
            }
        }

        if (!ViewportHeight.IsStretch)
        {
            if (!double.IsFinite(ViewportHeight.Px) || ViewportHeight.Px <= 0)
            {
                throw new ArgumentOutOfRangeException(nameof(ViewportHeight), ViewportHeight,
                    "ViewportHeight is a finite, positive number of pixels (ADR-0013).");
            }
            if (ShowFormulaBar && ViewportHeight.Px <= FormulaBarPx + (HideHeader ? 0 : _metrics.HeaderHeightPx))
            {
                throw new ArgumentOutOfRangeException(nameof(ViewportHeight), ViewportHeight,
                    $"ViewportHeight must exceed the Formula Bar's {FormulaBarPx}px" +
                    (HideHeader ? "" : $" and the header's {_metrics.HeaderHeightPx}px") +
                    ": both take their band of it, and what is left is where the rows go (ADR-0051/0028).");
            }
            if (!HideHeader && ViewportHeight.Px <= _metrics.HeaderHeightPx)
            {
                throw new ArgumentOutOfRangeException(nameof(ViewportHeight), ViewportHeight,
                    $"ViewportHeight must exceed the header's {_metrics.HeaderHeightPx}px: the header takes the " +
                    "first band of it, and what is left is where the rows go (ADR-0013/0028).");
            }
        }
        if (!ViewportWidth.IsStretch && (!double.IsFinite(ViewportWidth.Px) || ViewportWidth.Px <= 0))
        {
            throw new ArgumentOutOfRangeException(nameof(ViewportWidth), ViewportWidth,
                "ViewportWidth is a finite, positive number of pixels (ADR-0013).");
        }
        if (PinnedColumnCount < 0 || PinnedColumnCount > Columns.Count)
        {
            throw new ArgumentOutOfRangeException(nameof(PinnedColumnCount), PinnedColumnCount,
                $"PinnedColumnCount is the first N of {Columns.Count} columns; there are not that many (ADR-0004).");
        }

        // Members resolve to indices once per push, off the render path (ADR-0032).
        if (!ReferenceEquals(_observedHeaderGroups, HeaderGroups)
            || !ReferenceEquals(_layoutColumns, Columns)
            || _layoutPinned != PinnedColumnCount)
        {
            _observedHeaderGroups = HeaderGroups;
            _layoutColumns = Columns;
            _layoutPinned = PinnedColumnCount;
            if (HeaderGroups is { Count: > 0 })
            {
                var names = new string[Columns.Count];
                for (var i = 0; i < Columns.Count; i++)
                    names[i] = Columns[i].Name;
                _headerLayout = HeaderGroupLayout.Resolve(HeaderGroups, names, PinnedColumnCount);
            }
            else
            {
                _headerLayout = HeaderGroupLayout.Empty;
            }
        }
        // The band comes off the scroll budget, and the refusal names the band
        // (ADR-0032): a Viewport that cannot hold the band plus one row shows headers
        // and no data, which reads as an empty result.
        if (_headerLayout.TierCount > 0 && !HideHeader && !ViewportHeight.IsStretch
            && ViewportHeight.Px <= BandHeightPx + _metrics.RowHeightPx)
        {
            throw new InvalidOperationException(
                $"ViewportHeight ({ViewportHeight.Px}px) must exceed the header band — " +
                $"{1 + _headerLayout.TierCount} tiers × {_metrics.HeaderHeightPx}px = {BandHeightPx}px — plus one " +
                $"row of {_metrics.RowHeightPx}px (ADR-0032).");
        }
        // The header band stands in the content as well as over it, so it spends its
        // own height of the browser's scroll budget that ViewportGeometry — which knows
        // only about rows — cannot see. Checked here, where the spacer's real height is
        // known: a result one row inside the pure guard would still have its last row
        // clamped away, and being quietly unable to reach the end is the failure
        // ADR-0013's ceiling exists to refuse.
        // Under a pager only one page ever scrolls, so one page is what the ceiling is
        // checked against — a paged two-million-row result is exactly what ADR-0015
        // prescribes, and refusing it for the whole result's height would refuse the
        // Consumer for having done the prescribed thing.
        var scrolledRows = PageSize is int pagedBy
            ? Math.Min(_total ?? _window.Count, pagedBy)
            : _total ?? _window.Count;
        if (BandHeightPx + (scrolledRows * _metrics.RowHeightPx) > ViewportGeometry.MaxScrollHeightPx)
        {
            throw new InvalidOperationException(
                $"{scrolledRows} rows at {_metrics.RowHeightPx}px, plus the header band's own " +
                $"{BandHeightPx}px, need " +
                $"{BandHeightPx + (scrolledRows * _metrics.RowHeightPx)}px of scrollable " +
                $"area — past the {ViewportGeometry.MaxScrollHeightPx}px a browser can scroll, so the last rows " +
                "could never be reached. Use a shorter row height, or page the result (ADR-0013/0015).");
        }
        if (PasteByteCap < 1)
        {
            throw new ArgumentOutOfRangeException(nameof(PasteByteCap), PasteByteCap,
                "The paste ceiling is at least one byte; the Consumer may raise it, not disable pasting with it (ADR-0005).");
        }
        if (CopyCellCap < 1)
        {
            throw new ArgumentOutOfRangeException(nameof(CopyCellCap), CopyCellCap,
                "The copy cap is at least one cell; the Consumer may raise it, not disable copying with it (ADR-0005).");
        }
        if (PageSize is < 1)
        {
            throw new ArgumentOutOfRangeException(nameof(PageSize), PageSize,
                "A page holds at least one row; continuous scrolling is PageSize left unset (ADR-0015).");
        }
        ValidateWindowPlacement();
        ResolveRowHeadingWidth();

        var columnsChanged = !ReferenceEquals(_observedColumns, Columns);
        var metricsChanged = _observedMetrics != _metrics.CellMetrics;

        if (!ReferenceEquals(_observedWindow, _window))
        {
            RequireDistinctRows(_window);
            _observedWindow = _window;
        }

        if (columnsChanged || metricsChanged)
        {
            // A changed column declaration means a fresh tracker re-measured from what
            // is painted next (ADR-0016); the metrics feed the estimates, so they reset
            // with it. The header label is content the column paints too — unobserved,
            // every short Auto column would stand with a chopped header.
            _autoWidths = new AutoWidth[Columns.Count];
            for (var i = 0; i < Columns.Count; i++)
            {
                var spec = Columns[i].Width;
                var auto = new AutoWidth(spec);
                if (spec.Width.IsAuto)
                {
                    // The menu button stands inside the header cell, over the text's
                    // room, and a sorted header grows an indicator — an estimate that
                    // ignores either resolves a short header to a width whose label ends
                    // under the ▾ or the ▲ (ADR-0016/0028). One rule, shared with Size
                    // to fit, so the two agree on what a header needs.
                    auto = auto.Observe(HeaderRequiredPx(i));
                    // An Action Column paints no value, so the rows can never grow it
                    // and its header is usually empty (ADR-0020) — left at that it would
                    // stand at MinWidth with its buttons clipped. What it does declare
                    // is its labels, so those are what it is measured from, once. A
                    // theme painting icons instead declares a Fixed width; text is the
                    // only thing this grid can estimate (ADR-0021 keeps measurement out
                    // of JavaScript).
                    if (Columns[i].Actions.Count > 0)
                    {
                        // The cell's own padding once, then each button's text plus its
                        // own box. Summed, not maximised: the buttons stand side by side.
                        // Both terms are needed — the cell consumes its padding before
                        // any button is reached, and a button is wider than its text —
                        // and leaving either out resolves a short label like "Open" to a
                        // column narrower than the single button it holds, which
                        // `overflow: hidden` then clips: the very outcome this estimate
                        // exists to prevent.
                        var required = _metrics.CellMetrics.EstimatePx(0);
                        foreach (var action in Columns[i].Actions)
                            required += _metrics.CellMetrics.TextWidthPx(action.Label) + _metrics.ActionButtonChromePx;
                        auto = auto.Observe(required);
                    }
                }
                _autoWidths[i] = auto;
            }
            _observedColumns = Columns;
            _observedMetrics = _metrics.CellMetrics;
            _measured = false;
        }

        ReconcileSelection();
        // A dropped selection mid-edit means the cell the editor floats over no longer
        // names the same thing (ADR-0011): the uncommitted text is discarded rather
        // than committed onto a stranger. The gate learns after this render.
        if (_editMode != EditMode.None && _selection.Selection.IsEmpty)
        {
            CloseCompletion();
            EndPointing();
            _editMode = EditMode.None;
            _editSurface = EditSurface.Cell;
            _editText = "";
            _reportedText = null;
            ForgetCaretPlacement();
            _editError = null;
            _editorNeedsFocus = false;
            _editorFocusAsked = false;
            _jsEditingDirty = true;
            // Announced, not silent: the user typed and something they did not do took
            // it away. Raised from OnAfterRenderAsync for the reason the Range Request
            // is — a Consumer handler run inside this render stack would re-enter the
            // same batch.
            _pendingDiscard = _selectionEmptiedBy ?? EditDiscardReason.OrderChanged;
        }
        PrepareRender();
    }


    /// <summary>
    /// Drops the selection when the coordinates it is written in stop meaning what they
    /// meant (ADR-0011). One trigger per axis: the Consumer's Row Sequence Version for
    /// the rows, and the visible-column set for the columns — the grid applies View
    /// State, so it can see the second one itself and needs no version for it.
    ///
    /// The columns are compared by name, in order, and never by the array's identity. A
    /// Consumer that builds its column list inline hands over a fresh array on every
    /// render; dropping on that would clear the selection continuously and make selecting
    /// anything impossible. (The Range Request dedupe fell into exactly this hole, which
    /// is why it deduplicates on where the Window sits rather than on which list it is.)
    /// </summary>
    private void ReconcileSelection()
    {
        // Which of the two causes emptied it, for the discard reason (ADR-0011). They are
        // different sentences to a user, and the wrong one is worse than none.
        _selectionEmptiedBy = null;
        var held = _selection.Selection;
        var reconciled = _selection.Under(_sequenceVersion);
        if (!held.IsEmpty && reconciled.Selection.IsEmpty)
            _selectionEmptiedBy = EditDiscardReason.OrderChanged;
        if (!ColumnsAreAsBefore())
        {
            if (!held.IsEmpty)
                _selectionEmptiedBy ??= EditDiscardReason.ColumnsChanged;
            reconciled = HeldSelection.Empty(_sequenceVersion);
        }

        if (!reconciled.Selection.Equals(_selection.Selection))
            _selectionChanged = true;
        _selection = reconciled;
    }

    private bool ColumnsAreAsBefore()
    {
        if (_columnNames.Length == Columns.Count)
        {
            var same = true;
            for (var i = 0; same && i < Columns.Count; i++)
                same = _columnNames[i] == Columns[i].Name;
            if (same)
                return true;
        }

        _columnNames = new string[Columns.Count];
        for (var i = 0; i < Columns.Count; i++)
            _columnNames[i] = Columns[i].Name;
        return false;
    }

    /// <summary>
    /// A Window has to say truthfully which positions it holds, because every offset on
    /// screen is derived from that. Refused up front rather than painted at the wrong
    /// place — the three values arrive together in one parameter set, so a contradiction
    /// between them is a Consumer bug, not a race.
    /// </summary>
    private void ValidateWindowPlacement()
    {
        ArgumentOutOfRangeException.ThrowIfNegative(_windowStart, nameof(WindowStart));
        if (_total is null)
        {
            if (_windowStart != 0)
            {
                throw new InvalidOperationException(
                    $"WindowStart is {_windowStart} but TotalCount is null, which claims the Window is the whole result. " +
                    "Pass TotalCount whenever the Window is a slice of something larger (ADR-0001).");
            }
            return;
        }

        ArgumentOutOfRangeException.ThrowIfNegative(_total.Value, nameof(TotalCount));
        if (_windowStart + _window.Count > _total.Value)
        {
            throw new InvalidOperationException(
                $"The Window claims rows {_windowStart}-{_windowStart + _window.Count - 1}, past a TotalCount of {_total.Value}.");
        }
    }

    // Refused up front rather than failing strangely mid-render: a duplicate instance
    // makes Row Identity ambiguous (ADR-0003 — which row did the Consumer mean?), and
    // a null is not a row (an absent row is a Placeholder, ADR-0004).
    //
    // Walking the whole Window is fine while a Window is tens or hundreds of rows. The
    // pull layer that hands over an entire result at once (GridSource.From, Task 9)
    // would make this a hash insert per row on every push, and is where to revisit it.
    private static void RequireDistinctRows(IReadOnlyList<TRow> window)
    {
        var seen = new HashSet<object>(window.Count, ReferenceEqualityComparer.Instance);
        for (var i = 0; i < window.Count; i++)
        {
            var row = window[i];
            if (row is null)
            {
                throw new InvalidOperationException(
                    $"Window[{i}] is null; a Window holds rows, not gaps.");
            }
            if (!seen.Add(row))
            {
                throw new InvalidOperationException(
                    $"Window[{i}] is the same row instance as an earlier position; Row Identity cannot tell them apart (ADR-0003).");
            }
        }
    }

    /// <summary>Recomputes what is on screen and re-observes the widths it needs. Called
    /// wherever the geometry or the painted slice can have moved — parameters, scrolling,
    /// settling — so the two can never disagree.</summary>
    private void PrepareRender()
    {
        // What the Consumer declared, minus what the browser says its scrollbars take
        // out of it (ADR-0013) — or, under Stretch, what the browser reported the content
        // box to be, which already has the scrollbars taken out (ADR-0028). Both
        // gutters are 0 until the browser reports otherwise, so on a machine with
        // overlay scrollbars a declared axis is the declared size exactly.
        var previousHeightPx = _visibleHeightPx;
        _visibleWidthPx = ViewportWidth.IsStretch
            ? Math.Max(0, _reportedWidthPx)
            : ViewportBox.VisibleWidthOf(ViewportWidth.Px, _gutterWidthPx);
        _visibleHeightPx = ViewportHeight.IsStretch
            ? Math.Max(0, _reportedHeightPx)
            : ViewportBox.VisibleHeightOf(ViewportHeight.Px - FormulaBarPx, _gutterHeightPx);
        CloseAPopoverTheBoxNoLongerHolds(previousHeightPx);

        if (_visibleHeightPx <= BandHeightPx || _visibleWidthPx <= 0)
        {
            // The refusal keys on declared-vs-reported (ADR-0028): a declared height
            // this small was a bug when the Consumer wrote it and stays one after the
            // scrollbar's strip; a reported zero is a hidden tab — paint nothing,
            // throw nothing, and the next report brings the grid back.
            if (_visibleHeightPx <= BandHeightPx && !ViewportHeight.IsStretch)
            {
                throw new InvalidOperationException(
                    $"A horizontal scrollbar takes {_gutterHeightPx}px out of the {ViewportHeight.Px}px Viewport, " +
                    $"leaving {_visibleHeightPx}px — not enough for the header band's own {BandHeightPx}px, " +
                    "let alone a row. Declare a Viewport tall enough to hold its own scrollbar; on a platform " +
                    "with overlay scrollbars this same grid would have painted (ADR-0013).");
            }
            _visible = null;
            _scrollable = null;
            return;
        }

        // The header stands on the first band of the Viewport, so the rows get the
        // rest. Everything downstream — how many rows fit, where a scroll offset lands —
        // is arithmetic over that remainder (ADR-0013/0028/0032). Under a PageSize the
        // geometry runs over the page alone: the scrollbar spans the page, and the
        // page boundary is where a drag stops (ADR-0015).
        var geometryRows = TotalRows;
        _pageStartRow = 0;
        if (PageSize is { } pageSize)
        {
            _pageIndex = Math.Clamp(_pageIndex, 0, PageCount - 1);
            _pageStartRow = _pageIndex * pageSize;
            geometryRows = Math.Clamp(TotalRows - _pageStartRow, 0, pageSize);
        }
        // The rows share the scroll content with the header band, so the room the Layout
        // Ceiling leaves them is the ceiling less the band (ADR-0053).
        _geometry = new ViewportGeometry(
            _metrics.RowHeightPx, _visibleHeightPx - BandHeightPx, geometryRows,
            Math.Max(1, _layoutCeilingPx - BandHeightPx));
        if (_anchorContentPx is { } anchorContentPx)
        {
            _anchorContentPx = null;
            // Where the browser was when the anchor was taken, as far as this instance
            // knows, and clamped as the new spacer will clamp it: the write is made only
            // over that (AnchorScrollTopAsync).
            _anchorFromScrollTopPx = Math.Clamp(_expectedScrollTopPx, 0, _geometry.MaxScrollTopPx);
            _scrollTopPx = _geometry.ScrollTopAt(anchorContentPx);
            _anchorScrollTopPx = _scrollTopPx;
        }
        var local = _geometry.SliceAt(_scrollTopPx);
        _visible = local is { } slice ? new RowRange(_pageStartRow + slice.Start, slice.Count) : null;
        ObserveAutoWidths();
        ResolveColumnGeometry();
        _scrollable = _columnStyles.Geometry.ScrollableSliceAt(_scrollLeftPx, VirtualiseColumns);
    }

    /// <summary>
    /// Auto widths grow from what has actually been painted, not from the whole Window:
    /// a Window can hold a hundred thousand rows, and measuring them all on every push
    /// would cost more than the virtualisation saves. Observation is a monotone maximum,
    /// so seeing fewer rows can never narrow a column — a wide value simply grows it as
    /// it scrolls into the Viewport, which is the direction ADR-0016 chose to avoid
    /// judder.
    ///
    /// Every column is observed, including the ones horizontal virtualisation is leaving
    /// out of the DOM, and that is what keeps the horizontal axis stable. Observing only
    /// the painted columns would make a column's width depend on where the Viewport sits:
    /// an Auto column entering from the right would grow, the total width would change,
    /// the scrollbar would change length, and the same scrollLeft would point somewhere
    /// else — a loop feeding itself. Observing all of them takes the position out of the
    /// input and the loop cannot form.
    ///
    /// Paying for that every frame is what the incremental step avoids: observation is a
    /// monotone maximum, so re-observing a row it has already seen cannot change the
    /// answer, and only the rows that newly entered the Viewport are read.
    /// </summary>
    private void ObserveAutoWidths()
    {
        // Nothing is painted during a fling, so there is nothing to measure from —
        // measuring what is not on screen contradicts ADR-0016's "measured from what has
        // been painted", besides being pure waste in the frames that can least afford it.
        //
        // Unless the trackers were just reset. A Consumer swapping the columns mid-fling
        // leaves every Auto column holding nothing but its header estimate, and skipping
        // here would paint that collapsed layout for the whole settle delay and then snap
        // back. One observation costs a normal frame; watching the grid jump does not.
        if (_placeholderMode && _measured)
            return;

        // Measured from the same signals rendering itself follows: a different Window
        // instance, a different slice on screen, different columns or metrics. Reading
        // the rows again when none of those moved is how a rewritten-in-place value
        // would sneak onto the screen (ADR-0003), besides being wasted work.
        var sameWindow = _measured
            && ReferenceEquals(_measuredWindow, _window)
            && _measuredWindowStart == _windowStart;
        if (sameWindow && _measuredVisible == _visible)
            return;

        // Rows the previous observation already folded in. Disjoint from the new slice
        // after a fling, which correctly means every visible row is read again.
        var seen = sameWindow ? _measuredVisible : null;

        _measured = true;
        _measuredWindow = _window;
        _measuredWindowStart = _windowStart;
        _measuredVisible = _visible;

        if (_visible is not { } visible)
            return;

        for (var row = visible.Start; row < visible.Start + visible.Count; row++)
        {
            if (seen is { } already && row >= already.Start && row < already.Start + already.Count)
                continue;
            var slice = row - _windowStart;
            if (slice < 0 || slice >= _window.Count)
                continue;

            var data = _window[slice];
            for (var c = 0; c < Columns.Count; c++)
            {
                var column = Columns[c];
                // A Template or Action column has no text in its cells to measure —
                // observing it would fold in the empty string and hold the column at
                // MinWidth, which is worse than the label estimate it already carries
                // (ADR-0016 / ADR-0020).
                if (!column.Width.Width.IsAuto || !column.PaintsValue)
                    continue;
                _autoWidths[c] = _autoWidths[c].Observe(
                    _metrics.CellMetrics.EstimatePx(ExGridRow<TRow>.CellText(column, data)));
            }
        }
    }

    /// <summary>
    /// Rebuilds the column geometry only when something it is made of actually moved, so
    /// an unchanged layout keeps its instance and the rows keep skipping (ADR-0003). The
    /// comparison runs against the live geometry rather than a parallel copy: one place
    /// holds the widths, so the two cannot fall out of step.
    /// </summary>
    private void ResolveColumnGeometry()
    {
        var geometry = _columnStyles.Geometry;
        if (geometry.Count == Columns.Count
            && geometry.RequestedPinnedCount == PinnedColumnCount
            && geometry.ViewportWidthPx == _visibleWidthPx
            && geometry.LeadWidthPx == _rowHeadingWidthPx)
        {
            var moved = false;
            for (var c = 0; !moved && c < Columns.Count; c++)
                moved = geometry.WidthPxOf(c) != Columns[c].Width.ResolveWidthPx(_autoWidths[c]);
            if (!moved)
                return;
        }

        var widths = new double[Columns.Count];
        for (var c = 0; c < Columns.Count; c++)
            widths[c] = Columns[c].Width.ResolveWidthPx(_autoWidths[c]);
        _columnStyles = new ColumnStyles(new ColumnGeometry(widths, PinnedColumnCount, _visibleWidthPx, _rowHeadingWidthPx));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // A Template cell's focus request lives for exactly the render that handed it
        // over (ADR-0037) — cleared first, before anything below can render again — and
        // one the Focus walked away from is dropped undelivered.
        if (_focusRequestHandedOver)
        {
            _focusRequestHandedOver = false;
            _focusRequest = null;
        }
        else if (_focusRequest is { } undelivered
            && (_selection.Selection.IsEmpty || _selection.Selection.Focus != undelivered.Cell))
        {
            _focusRequest = null;
        }

        // A prerender's OnAfterRender does not run at all; this guard is for a renderer
        // that renders statically and still calls it.
        if (firstRender && RendererInfo.IsInteractive)
            await AttachScrollAsync();

        if (_announcePending is { } pending)
        {
            _announcePending = null;
            _announcement = pending;
            StateHasChanged();
        }
        if (_jsEditingDirty)
            await PushEditingModeAsync();
        await PushPointerReportingAsync();
        // A display-only grid must not take printable keys away from the page
        // (ADR-0010/0020), nor a grid nobody listens to take Ctrl+Z (ADR-0007) — the
        // gate is told which keys this grid takes, and re-told when a parameter change
        // changes the answer.
        var claims = KeyClaims();
        if (_scrollHandle is not null && !_disposed && claims != _jsClaims)
        {
            _jsClaims = claims;
            try
            {
                await _scrollHandle.InvokeVoidAsync(
                    "setClaims", GridKeys.TakenFor(claims), claims.CanEdit, claims.CanFind);
            }
            catch (Exception ex) when (ex is JSException or JSDisconnectedException or ObjectDisposedException or OperationCanceledException)
            {
            }
        }
        // Focused only once the input is painted. On Blazor Server this callback runs
        // when the browser acknowledges a batch, a round trip after it was rendered, and
        // a key arriving in that gap can open the editor after the batch this call is
        // for: the input is not in it, and its reference is still unset. Focusing that
        // threw, and the unhandled throw ended the circuit. The request waits instead for
        // the render that paints the input, which is already on its way.
        // The Formula Bar is the editor's second surface (ADR-0051): a request made while
        // the user works there goes back to the bar, never across to the cell.
        if (_editorNeedsFocus && _editSurface == EditSurface.Bar)
        {
            // A Chrome's control focuses itself on its context's request number.
            if (_formulaBarIsChrome)
                _editorNeedsFocus = false;
            else if (_formulaBarElement.Context is not null)
            {
                _editorNeedsFocus = false;
                try
                {
                    await _formulaBarElement.FocusAsync();
                }
                catch (Exception ex) when (ex is JSException or JSDisconnectedException or ObjectDisposedException or OperationCanceledException)
                {
                }
            }
        }
        else if (_editorNeedsFocus && (_editorIsChrome || _editorElement.Context is not null))
        {
            _editorNeedsFocus = false;
            try
            {
                // A Chrome's editor focuses its own control (ADR-0010/0030): the core's
                // reference is the built-in input's, and there is none to focus then.
                if (!_editorIsChrome)
                    await _editorElement.FocusAsync();
            }
            catch (Exception ex) when (ex is JSException or JSDisconnectedException or ObjectDisposedException or OperationCanceledException)
            {
            }
        }
        // After the render that carries the text the core wrote or opened the edit on, and once
        // the surface holding it has DOM focus (ADR-0051): an editor not painted yet waits for
        // the render that paints it, as its focus does.
        if (_caretToPlace is not null && !_editorNeedsFocus)
            await PushCaretAsync();
        await SettlePopoverFocusAsync();
        await SyncInnerPopupAsync();

        // A geometry change re-anchors on the first visible row (ADR-0028): the model
        // has already moved; this is the browser being told, through the allowlisted
        // scroll write. Not a reveal — a density change is not a navigation, and a
        // Focus that was off screen stays off screen.
        if (_anchorScrollTopPx is { } anchorTopPx)
        {
            _anchorScrollTopPx = null;
            await AnchorScrollTopAsync(anchorTopPx, _anchorFromScrollTopPx);
        }

        // The one place a Range Request is raised. Raising it from OnParametersSet would
        // run the Consumer's handler inside the current render stack, and a Consumer
        // answering synchronously would re-enter the same batch. From here the cycle is
        // structurally finite: raise, the Consumer pushes, an ordinary render follows,
        // and this check finds the range covered and stays quiet.
        // A reveal has already moved the scroller, in the render this pass follows
        // (StageReveal): what it painted is what the Range Request below is judged on.
        await RaiseRangeIfUncoveredAsync();
        await RaiseSelectionIfChangedAsync();
        if (_pendingDiscard is { } discarded)
        {
            _pendingDiscard = null;
            if (OnEditDiscarded.HasDelegate)
                await OnEditDiscarded.InvokeAsync(discarded);
        }
    }

    private async Task AttachScrollAsync()
    {
        // Nothing here may escape: a missing or misconfigured module file would
        // otherwise take the Range Request down with it, and the grid would sit on
        // Placeholders forever without ever asking the Consumer for rows.
        try
        {
            var module = await JS.InvokeAsync<IJSObjectReference>("import", ModulePath);
            if (module is null)
                return;
            if (_disposed)
            {
                // Disposal overtook the import, and found no module to give back — this is
                // the only place left that can (MEM-3).
                await module.DisposeAsync();
                return;
            }
            _module = module;

            _self ??= DotNetObjectReference.Create(this);
            var claims = KeyClaims();
            _jsClaims = claims;
            var handle = await _module.InvokeAsync<IJSObjectReference>(
                "attach", _root, _scroller, _self, GridKeys.TakenFor(claims), claims.CanEdit,
                PopoverDelay.TotalMilliseconds, claims.CanFind);
            if (_disposed)
            {
                // Disposal overtook the attach; nobody else holds this handle now. Its own
                // dispose still has to run — releasing the .NET reference does not remove
                // the listener it attached (ADR-0018).
                await handle.InvokeVoidAsync("dispose");
                await handle.DisposeAsync();
                return;
            }

            _scrollHandle = handle;
            _metaIsPrimary = await handle.InvokeAsync<bool>("metaIsPrimary");

            // The scroller can already be somewhere: a reload restores the offsets
            // without raising a scroll event, and events arriving before the module
            // landed were skipped by design. Read the position once so the first paint
            // matches what the browser is actually showing.
            ApplyScrollOffset(await handle.InvokeAsync<ScrollOffset>("getScrollOffset"));

            // The listener is attached: the grid can hear keys now, and says so — a tab
            // stop, and no longer busy (ADR-0033).
            _listening = true;
            StateHasChanged();
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or ObjectDisposedException or OperationCanceledException)
        {
        }
    }

    private async Task OnScrollAsync()
    {
        // Before the module lands there is no offset to read, and substituting zero
        // would jump the grid back to the top. Skipping costs nothing: the next scroll
        // event carries the position that matters.
        if (_scrollHandle is null || _disposed)
            return;

        if (_readingScroll)
        {
            _scrollPending = true;
            return;
        }

        _readingScroll = true;
        try
        {
            do
            {
                _scrollPending = false;
                var writes = _scrollWrites;
                var offset = await _scrollHandle.InvokeAsync<ScrollOffset>("getScrollOffset");
                // Disposal can have overtaken the read, and a released handle answers
                // zero — applying that would jump the model back to the top and touch a
                // component and a timer that are already gone.
                if (_disposed)
                    return;
                // A write went out while this read was on the wire, so the answer may
                // say where the scroller was before that write landed. Taken as where
                // it is going, it made the next reveal a no-op and left the Focus off
                // screen (Ctrl+End, Ctrl+Home faster than a Server round trip); taken
                // as the model an edge auto-scroll compounds on, it pulled the drag
                // back. It is set aside and asked again: the new read reaches the
                // browser behind the write, so its answer includes it (ADR-0012).
                if (_scrollWrites != writes)
                {
                    _scrollPending = true;
                    continue;
                }
                ApplyScrollOffset(offset);
            }
            // Reads are awaited, so a burst would otherwise apply stale offsets out of
            // order; looping on the flag lands the last position and drops the rest.
            while (_scrollPending && !_disposed);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or ObjectDisposedException or OperationCanceledException)
        {
        }
        finally
        {
            _readingScroll = false;
        }
    }

    private void ApplyScrollOffset(ScrollOffset offset)
    {
        if (!double.IsFinite(offset.Top) || !double.IsFinite(offset.Left))
            return;

        var paintedFirstRow = _visible?.Start ?? 0;
        var paintedColumns = _scrollable;
        var previousLeftPx = _scrollLeftPx;
        var previousTopPx = _scrollTopPx;
        _scrollTopPx = offset.Top;
        _scrollLeftPx = offset.Left;
        _expectedScrollTopPx = offset.Top;
        _expectedScrollLeftPx = offset.Left;
        PrepareRender();
        var firstRow = _visible?.Start ?? 0;

        var moved = firstRow != paintedFirstRow || _scrollable != paintedColumns;
        // Either axis on its own is enough. A diagonal fling that crosses screens
        // sideways while barely moving down is still a frame where every cell changes,
        // and testing only the rows would miss it entirely.
        // The horizontal half only counts when the columns are virtualised. Off, the slice
        // is every scrollable column at every offset, so panning sideways changes nothing
        // and costs nothing — blanking the rows would be the only work in the frame, and
        // then paying to rebuild every cell 150ms later. A fling is a way of not painting
        // what would have to be painted; there is nothing to skip here.
        var flung = (firstRow != paintedFirstRow && _geometry.IsFling(paintedFirstRow, firstRow))
            || (VirtualiseColumns && _columnStyles.Geometry.IsFling(previousLeftPx, _scrollLeftPx));
        if (flung)
        {
            // Waiting for data and skipping paint during a fling are one mechanism, so
            // they paint the same thing (ADR-0004).
            _placeholderMode = true;
        }
        if (_placeholderMode)
        {
            // Any scrolling at all keeps it unsettled; the delay measures stillness.
            RestartSettleTimer();
        }
        // The rows moved under a still pointer: the band would stand on a row the
        // pointer is no longer over. It goes, and the browser is told to forget its
        // last report with it, so the next movement brings the band back even when it
        // lands on the same row as before the scroll.
        if (moved && _hoverRow >= 0)
        {
            _hoverRow = -1;
            _ = ForgetPointerAsync();
        }
        // Compressed, the rows are placed from the offset itself and not only from the
        // slice, so every vertical scroll re-places them — the Viewport's transform and
        // the overlay, no row (ADR-0053). Uncompressed this is never true, and the cost
        // is today's.
        var replaced = _geometry.IsCompressed && _scrollTopPx != previousTopPx;
        if (moved || _placeholderMode || replaced)
        {
            StateHasChanged();
        }
    }

    private async Task ForgetPointerAsync()
    {
        if (_scrollHandle is null || _disposed)
            return;
        try
        {
            await _scrollHandle.InvokeVoidAsync("forgetPointer");
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or ObjectDisposedException or OperationCanceledException)
        {
        }
    }

    /// <summary>
    /// The pointer moved onto another row (ADR-0021's fifth entry): JavaScript noticed
    /// the row change from the geometry C# wrote inline, and reports the event's own
    /// offsets — which cell that is, is resolved here, by the same <see cref="CellUnder"/>
    /// every press goes through, clamped as a press is. A report resolving to the row
    /// already held renders nothing; one that moves the band re-renders the overlay and
    /// no row.
    ///
    /// <para>Called by the grid's own script module and not for Consumers: it is public
    /// only because JavaScript interop requires it.</para>
    /// </summary>
    [JSInvokable]
    public Task OnPointerRowAsync(double x, double y)
    {
        if (_disposed || !double.IsFinite(x) || !double.IsFinite(y))
            return Task.CompletedTask;
        var row = CellUnder(new MouseEventArgs { OffsetX = x, OffsetY = y })?.Row ?? -1;
        if (row == _hoverRow)
            return Task.CompletedTask;
        _hoverRow = row;
        if (HoverEnabled)
            StateHasChanged();
        return Task.CompletedTask;
    }

    /// <summary>The hover band's rectangle, or null while there is none to paint.</summary>
    private SelectionRange? HoverRowRange
        => HoverEnabled && _hoverRow >= 0 && Columns.Count > 0
            ? new SelectionRange(_hoverRow, 0, 1, Columns.Count)
            : null;

    /// <summary>
    /// Keeps the browser-side pointer reports in step with who consumes them: row
    /// changes while the hover band is on, rests while a Consumer can be asked for a
    /// message. Re-told only when either answer moves; off, the listener computes
    /// nothing for that report (ADR-0021's fifth entry).
    /// </summary>
    private async Task PushPointerReportingAsync()
    {
        if (_scrollHandle is null || _disposed)
            return;
        var rows = HoverEnabled;
        var rest = CellMessageOf is not null;
        if (rows == _jsPointerRows && rest == _jsPointerRest)
            return;
        _jsPointerRows = rows;
        _jsPointerRest = rest;
        if (!rows && _hoverRow >= 0)
            _hoverRow = -1;
        // A message a rest opened has no consumer to close it once rests stop being
        // reported; it goes with the switch.
        if (!rest && _messageCell is not null)
        {
            CloseMessage();
            StateHasChanged();
        }
        try
        {
            await _scrollHandle.InvokeVoidAsync("setPointerReporting", rows, rest);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or ObjectDisposedException or OperationCanceledException)
        {
        }
    }

    /// <summary>
    /// Which cell the pointer is over, read from the offsets the browser already put on
    /// the event. No element is measured: a layout read would be a JavaScript round trip,
    /// and it is deliberately not on the allowlist (ADR-0021) — the grid knows where
    /// every row and column is, so it can answer this itself.
    ///
    /// The offsets are relative to the row Viewport, which is the target of every mouse
    /// event down here because everything inside it is <c>pointer-events: none</c>. Its
    /// top edge is the first painted row, so the slice's offset goes back on; its left
    /// edge is the content's, so the x needs nothing added — but the pinned band has to
    /// be resolved against the scroll offset, which <see cref="ColumnGeometry.ColumnAt"/>
    /// does.
    /// </summary>
    private CellPosition? CellUnder(MouseEventArgs e)
    {
        if (_visible is not { } visible)
            return null;
        var row = _geometry.RowAt(e.OffsetY + _geometry.OffsetPxOf(visible.Start - _pageStartRow));
        var column = _columnStyles.Geometry.ColumnAt(e.OffsetX, _scrollLeftPx);
        // The geometry answers in page-local rows; positions are the result's (ADR-0015).
        return row is int r && column is int c ? new CellPosition(_pageStartRow + r, c) : null;
    }

    /// <summary>
    /// Mouse down is one of the three gestures ADR-0012 names, chosen by the modifiers.
    /// The transitions themselves are the pure model's; nothing about what a click means
    /// is decided here.
    /// </summary>
    private async Task AnswerPressAsync(MouseEventArgs e)
    {
        // Read before anything below changes what is painted: the handle is grabbed where
        // the user saw it (ADR-0050, item 5).
        var onFillHandle = e.Button == 0 && !e.ShiftKey && !e.CtrlKey && !e.MetaKey && IsOnFillHandle(e);
        // A press anywhere in the body dismisses an open popover — clicking past a
        // menu is how people close menus everywhere else on the platform. The
        // dismissal is markup, so the render must run even when the press itself
        // changes nothing.
        var dismissed = AnyPopoverOpen;
        if (dismissed)
        {
            CloseMenus();
            // The press puts DOM focus on the root, as it lands in the grid — but on a
            // circuit the popover's own request to focus its first item can land after it,
            // on an item the close is removing. The core hands the keyboard back after that
            // render, and so has the last word (ADR-0039).
            _reclaimFocusPending = true;
        }
        // A press anywhere in the body leaves an Interactive cell (ADR-0037) and keeps its
        // own meaning. Like the dismissal, the chosen button's paint has to go even when
        // the press itself moves nothing.
        var leftInteractive = EndInteractive();

        // Where the Consumer says a Reference can go, a press on a cell points instead of
        // committing (ADR-0051).
        if (OnPointPress(e))
            return;

        // Excel's click-away semantics (ADR-0010): a press that is not on the editor
        // — the editor's own elements never let a press through — commits the
        // uncommitted text first, and the press then keeps its own meaning.
        var committed = _editMode != EditMode.None;
        if (committed && !await CommitEditAsync(byPress: true))
        {
            // A Reject holds the editor, and the press that would have dismissed it keeps
            // no meaning of its own: the selection must not walk away from an editor that
            // is still standing — the stale-editor failure ADR-0010's rule exists to
            // prevent (ADR-0034 amends it).
            StateHasChanged();
            return;
        }

        // A press on the fill handle starts a fill drag, not a selection: the Selection
        // stays as it is, and the moves reach out from it along one axis (ADR-0050, item 5).
        if (onFillHandle && FillRules.HandleRange(_selection.Selection) is { } fillSource)
        {
            _fillSource = fillSource;
            _fillPointer = null;
            _fillVersion = _sequenceVersion;
            SetDragging(true);
            return;
        }

        // Primary button only here. The secondary button's meaning is ADR-0036's and is
        // taken on the contextmenu event, which fires after this one — this press has
        // already closed any open popover and committed an open editor, which is what a
        // press that lands elsewhere is supposed to do.
        // A press on a Row Heading (ADR-0050): the whole row, or with Shift whole rows from
        // the Focus's. The band stands outside the column index space, so the Focus lands
        // in the first column on screen — where the Viewport already is — and no drag
        // begins: a drag's moves extend by cell, and would collapse the whole rows.
        if (e.Button == 0 && ShowsRowHeadings
            && _columnStyles.Geometry.IsInLead(e.OffsetX, _scrollLeftPx) && CellUnder(e) is { } headed)
        {
            var rowExtent = Extent;
            var focusColumn = FirstVisibleCell()?.Column ?? 0;
            var selected = _selection.Selection;
            var changed = Apply(e.ShiftKey
                ? selected.ExtendToRow(headed.Row, rowExtent, focusColumn)
                : selected.SelectRow(headed.Row, rowExtent, focusColumn));
            if (!changed && (dismissed || committed || leftInteractive))
                _suppressRender = false;
            return;
        }

        if (e.Button != 0 || CellUnder(e) is not { } cell)
        {
            _suppressRender = !dismissed && !committed && !leftInteractive;
            return;
        }

        var extent = Extent;
        var current = _selection.Selection;
        // Shift outranks Ctrl, which is also what Ctrl+Shift+click should do: extend the
        // range being built and leave the other ranges standing, which is ExtendTo. Meta
        // counts as Ctrl so the gesture is the one a Mac user actually makes — both are
        // Chromium (ADR-0017).
        // The same primary modifier the keyboard uses: Ctrl+click everywhere, and
        // Cmd+click where Cmd is what a user reaches for. Folding Meta unconditionally
        // would make Win+click and Super+click add ranges on platforms where that chord
        // belongs to the window manager (ADR-0012).
        var toggling = !e.ShiftKey && (e.CtrlKey || (e.MetaKey && _metaIsPrimary));
        var next = e.ShiftKey ? current.ExtendTo(cell, extent)
            : toggling ? current.ToggleRange(cell, extent)
            : current.Click(cell, extent);

        Apply(next);
        // A toggle-off takes a cell out and leaves the Focus on what remains (ADR-0052), and
        // dragging on from there would redraw a range from a cell the press never pointed
        // at (ADR-0012). Every other gesture has left a range that a drag can grow.
        //
        // Last, because attaching the move handler is itself a change to the markup: a
        // click on the one cell already selected changes no selection at all, and
        // suppressing that render would leave the drag with nothing listening.
        SetDragging(!(toggling && current.Contains(cell)));
        // A click on the Interactive cell itself changes no selection, and Apply has
        // suppressed the render — which would leave the chosen button painted.
        if (leftInteractive)
            _suppressRender = false;
    }

    /// <summary>
    /// Dragging is not a transition of its own: mouse down is a Click and the moves are
    /// ExtendTo, which is what <see cref="GridSelection"/> says to do rather than
    /// inventing a third path here.
    /// </summary>
    private void OnMouseMove(MouseEventArgs e)
    {
        // An event can still be in flight from the frame the drag ended on.
        if (!_dragging)
        {
            _suppressRender = true;
            return;
        }

        // Buttons is what is held down now, not what started the gesture. Released
        // outside the grid, no mouseup is ever delivered here — and this is what ends the
        // drag instead. Pointer capture would mean JavaScript, and a document-level
        // listener would make every grid on the page react to every drag (ADR-0018).
        if ((e.Buttons & 1) == 0)
        {
            _suppressRender = true;
            SetDragging(false);
            return;
        }
        if (CellUnder(e) is not { } cell)
        {
            _suppressRender = true;
            return;
        }
        if (_pointDragging)
        {
            OnPointDrag(cell);
            return;
        }
        if (_fillSource is not null)
        {
            if (!MoveFillPointer(cell))
                _suppressRender = true;
        }
        else
            Apply(_selection.Selection.ExtendTo(cell, Extent));
        UpdateEdgeBand(e);
    }

    /// <summary>
    /// Whether the press lands on the fill handle (ADR-0050, item 5) — arithmetic, as every
    /// other press in the body is (ADR-0008): the same corner the handle was painted at,
    /// with a grab box twice its side. A corner that has scrolled under the Pinned Columns
    /// cannot be grabbed, as it cannot be seen.
    /// </summary>
    private bool IsOnFillHandle(MouseEventArgs e)
    {
        if (FillHandleRange is not { } range || _visible is not { } visible)
            return false;
        var geometry = _columnStyles.Geometry;
        var (cornerX, cornerY) = SelectionStyles.HandleCornerPx(range, geometry, _metrics.RowHeightPx, visible.Start);
        var scrollLeft = Math.Clamp(_scrollLeftPx, 0, geometry.MaxScrollLeftPx);
        if (range.RightColumn < geometry.PinnedCount)
            cornerX += scrollLeft;
        else if (cornerX - scrollLeft < geometry.PinnedWidthPx)
            return false;
        var size = _metrics.FillHandleSizePx;
        return Math.Abs(e.OffsetX - cornerX) <= size && Math.Abs(e.OffsetY - cornerY) <= size;
    }

    /// <summary>The fill drag's pointer moved onto <paramref name="cell"/>. Whether what is
    /// painted changes — the outline moves only when the extension does.</summary>
    private bool MoveFillPointer(CellPosition cell)
    {
        if (_fillSource is not { } source || cell == _fillPointer)
            return false;
        var before = _fillPointer is { } previous ? FillRules.ExtensionFor(source, previous) : null;
        _fillPointer = cell;
        return FillRules.ExtensionFor(source, cell) != before;
    }

    /// <summary>
    /// The fill drag's release (ADR-0050, item 5): exactly one Fill Intent, or one refusal,
    /// or nothing when the pointer came back inside the source. Editable is judged on the
    /// target before anything is raised (ADR-0035). Positions taken under an order that has
    /// since moved name different rows, so such a drag raises nothing (ADR-0011).
    /// </summary>
    private async Task FinishFillAsync(CellPosition? releasedOn)
    {
        var source = _fillSource;
        var pointer = releasedOn ?? _fillPointer;
        var version = _fillVersion;
        SetDragging(false);
        if (_disposed || source is not { } from || pointer is not { } to || version != _sequenceVersion)
            return;
        if (FillRules.PlanFill(from, to, ColumnIsEditable) is not { } decision)
            return;
        if (decision.IsRefused)
        {
            if (OnPasteRefused.HasDelegate)
                await OnPasteRefused.InvokeAsync(decision.Reason);
            return;
        }
        // Nobody taking the intent is nobody accepting it: the Selection stays on the source.
        if (!OnFill.HasDelegate)
            return;
        var intent = new GridFillIntent(from, decision.Extension, version);
        await OnFill.InvokeAsync(intent);
        if (!intent.IsRefused)
            SelectFilledRange(from, intent.Target, version);
    }

    /// <summary>
    /// After a fill the Consumer accepted, the Selection is the source and the target
    /// together, as in Excel (ADR-0050, item 5 refined). The Focus stays on the cell it was
    /// on — inside the source, so the cell the Formula Bar shows does not change and nothing
    /// scrolls: the source's first cell, where the source was selected from (ADR-0052).
    /// Positions mean something only under the order they were written in, and the
    /// Selection is the user's: if the order moved while the Consumer handled the intent,
    /// or the Selection is no longer the source, nothing is placed (ADR-0011).
    /// </summary>
    private void SelectFilledRange(SelectionRange source, SelectionRange target, int version)
    {
        if (_disposed || version != _sequenceVersion)
            return;
        var current = _selection.Selection;
        if (current.IsEmpty || current.Ranges.Count != 1 || current.Ranges[0] != source || !source.Contains(current.Focus))
            return;
        var extent = Extent;
        var filled = SelectionRange.FromCorners(
            new CellPosition(Math.Min(source.TopRow, target.TopRow), Math.Min(source.LeftColumn, target.LeftColumn)),
            new CellPosition(Math.Max(source.BottomRow, target.BottomRow), Math.Max(source.RightColumn, target.RightColumn)));
        if (filled.BottomRow >= extent.RowCount || filled.RightColumn >= extent.ColumnCount)
            return;
        if (Apply(current.Place(filled, current.Focus, extent)))
        {
            _suppressRender = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Reads the pointer's position against the two edge bands (ADR-0008) and arms or
    /// disarms the auto-scroll accordingly. Positions are viewport-relative — where the
    /// pointer sits in the visible box — because that is what stays put while the
    /// content scrolls beneath it.
    /// </summary>
    private void UpdateEdgeBand(MouseEventArgs e)
    {
        if (_visible is not { } visible)
            return;
        // Read through the mapping: the painted rows stand at c(s), not at s (ADR-0053).
        _edgePointerViewportYPx = e.OffsetY + _geometry.OffsetPxOf(visible.Start - _pageStartRow)
            - _geometry.ContentOffsetAt(_scrollTopPx);
        _edgePointerViewportXPx = e.OffsetX - _scrollLeftPx;
        _edgeStepRows = EdgeBand.RowsPerTick(
            _edgePointerViewportYPx, _geometry.ViewportHeightPx, _geometry.RowsPerViewport);
        // Sideways the unit is a row height per rate step — the band has no natural
        // column unit, columns being of unequal width, and the vertical ceiling's
        // reasoning (stay under the fling) holds trivially at eight row heights.
        _edgeStepXPx = EdgeBand.RowsPerTick(
            _edgePointerViewportXPx, _visibleWidthPx, int.MaxValue) * _metrics.RowHeightPx;
        if (_edgeStepRows != 0 || _edgeStepXPx != 0)
            StartEdgeTimer();
        else
            StopEdgeTimer();
    }

    private void StartEdgeTimer()
    {
        if (_disposed || _edgeTimerRunning)
            return;
        _edgeTimer ??= Time.CreateTimer(OnEdgeTick, null, Timeout.InfiniteTimeSpan, Timeout.InfiniteTimeSpan);
        _edgeTimer.Change(EdgeScrollTick, EdgeScrollTick);
        _edgeTimerRunning = true;
    }

    private void StopEdgeTimer()
    {
        if (_edgeTimerRunning)
        {
            _edgeTimer?.Change(Timeout.InfiniteTimeSpan, Timeout.InfiniteTimeSpan);
            _edgeTimerRunning = false;
        }
        _edgeStepRows = 0;
        _edgeStepXPx = 0;
    }

    /// <summary>The pointer left the grid: stop the auto-scroll — outside the element
    /// there are no events to contradict a running timer (ADR-0008). The drag stands;
    /// the e.Buttons check on the next move ends it if the button came up away.</summary>
    private void OnRootMouseLeave()
    {
        _suppressRender = true;
        StopEdgeTimer();
    }

    private void OnEdgeTick(object? state)
    {
        _ = InvokeAsync(() =>
        {
            if (_disposed || !_dragging || (_edgeStepRows == 0 && _edgeStepXPx == 0))
                return;
            try
            {
                // The step is in rows, so it moves the content by rows through the
                // mapping, whatever the compression (ADR-0053).
                var top = _geometry.ScrollTopStepped(_scrollTopPx, _edgeStepRows * _metrics.RowHeightPx);
                var left = Math.Clamp(_scrollLeftPx + _edgeStepXPx, 0, _columnStyles.Geometry.MaxScrollLeftPx);
                var moved = top != _scrollTopPx || left != _scrollLeftPx;
                if (moved)
                {
                    // The model moves first, so the ticks compound deterministically;
                    // the browser is told below and its echo lands on the same numbers.
                    // The rate is capped below the fling threshold (ADR-0008), so this
                    // can never enter Placeholder mode mid-selection.
                    _scrollTopPx = top;
                    _scrollLeftPx = left;
                    PrepareRender();
                }

                // The pointer has not moved; the cell under it has. The selection's far
                // edge tracks it (ADR-0008).
                var changed = false;
                var row = _geometry.RowAt(_geometry.ContentOffsetAt(top) + _edgePointerViewportYPx);
                var column = _columnStyles.Geometry.ColumnAt(_edgePointerViewportXPx + left, left);
                // RowAt clamps inside the page, which is exactly ADR-0015's rule: a
                // drag never turns the page.
                if (row is int r && column is int c)
                {
                    var under = new CellPosition(_pageStartRow + r, c);
                    changed = _fillSource is not null
                        ? MoveFillPointer(under)
                        : Apply(_selection.Selection.ExtendTo(under, Extent));
                }

                // Not a UI event: an armed suppression would swallow whatever renders
                // next (the OnKeyAsync lesson).
                _suppressRender = false;
                if (!moved && !changed)
                    return;
                StateHasChanged();
                if (moved)
                    _ = PushScrollOffsetAsync(top, left);
            }
            catch (Exception ex)
            {
                _ = DispatchExceptionAsync(ex);
            }
        });
    }

    /// <summary>
    /// Re-anchors the vertical offset after a geometry change (ADR-0028/0053) — but only
    /// while the browser still stands at <paramref name="fromTop"/>, where this instance
    /// last knew it. The anchor was computed from that position; a scroll the grid has not
    /// heard yet has moved the browser since, and writing over it would undo the user's
    /// scroll: on a Server circuit, a Layout Ceiling told while a scroll to the end was on
    /// the wire put the grid back at row 0 (BIG-5 at 150%, verification/2026-09-28-windows-3).
    /// A refused anchor gives way to the browser, whose offset is read and painted as any
    /// scroll is. The horizontal offset is not the anchor's, and is left alone.
    /// </summary>
    private async Task AnchorScrollTopAsync(double top, double fromTop)
    {
        if (_scrollHandle is null || _disposed)
            return;
        _expectedScrollTopPx = top;
        _scrollWrites++;
        bool written;
        try
        {
            written = await _scrollHandle.InvokeAsync<bool>("anchorScrollTop", top, fromTop);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or ObjectDisposedException or OperationCanceledException)
        {
            return;
        }
        if (!written && !_disposed)
            await OnScrollAsync();
    }

    private async Task PushScrollOffsetAsync(double top, double left, long? revealToken = null)
    {
        if (_scrollHandle is null || _disposed)
            return;
        _expectedScrollTopPx = top;
        _expectedScrollLeftPx = left;
        _scrollWrites++;
        try
        {
            if (revealToken is { } token)
                await _scrollHandle.InvokeVoidAsync("setScrollOffset", top, left, token);
            else
                await _scrollHandle.InvokeVoidAsync("setScrollOffset", top, left);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or ObjectDisposedException or OperationCanceledException)
        {
        }
    }

    private async Task AnswerReleaseAsync(MouseEventArgs e)
    {
        if (_fillSource is not null)
        {
            await FinishFillAsync(CellUnder(e));
            return;
        }
        _suppressRender = true;
        SetDragging(false);
    }

    // A click on a grip is never the header's: stopped in the browser, because on a circuit
    // the mouse-up that would mark it as a gesture's tail can arrive before the handler
    // that hears it is attached, and the header would then sort by the column under the
    // grip's own offsets — the first one (ADR-0016, found on the Server host).
    /// <summary>A resize drag begins on a grip (ADR-0016): the guide line follows the
    /// pointer and the width is applied on release — never live, which would rebuild
    /// every painted row's markup on every move.</summary>
    private void OnResizeGripDown(int column, MouseEventArgs e)
    {
        if (e.Button != 0)
            return;
        _resizeColumn = column;
        _resizeStartClientX = e.ClientX;
        _resizeStartWidthPx = _columnStyles.Geometry.WidthPxOf(column);
        _resizeGuideLeftPx = GuideLeftPx(column, _resizeStartWidthPx);
        AttachRootGesture();
    }

    /// <summary>A pinned column's edge stands at the Viewport's left plus its offset,
    /// a scrollable one at its content offset; the guide is drawn in content space.</summary>
    private double GuideLeftPx(int column, double widthPx)
        => (column < _columnStyles.Geometry.PinnedCount ? _scrollLeftPx : 0)
            + _columnStyles.Geometry.OffsetPxOf(column) + widthPx;

    /// <summary>A reorder candidate begins on a header cell or a group rectangle; the
    /// drag itself begins past a small threshold, so a plain click stays a sort
    /// (ADR-0011/0032).</summary>
    private async Task OnHeaderMouseDown(MouseEventArgs e)
    {
        // A new press is a new story. The flag a gesture arms is consumed by that
        // gesture's own click — but a release outside the header raises no header
        // click at all, and a flag left standing would eat the NEXT genuine sort.
        _gestureConsumedClick = false;
        // The same dismissal rule as the body: pressing the header past an open
        // popover closes it, and whatever the press also meant still happens.
        if (AnyPopoverOpen)
            CloseMenus();
        // A press anywhere leaves an Interactive cell (ADR-0037); this handler always
        // renders, so the chosen button's paint goes with it.
        EndInteractive();
        // And the same click-away commit (ADR-0010): a header press mid-edit commits
        // before it sorts or grabs a column — unless the verdict Rejects, and then the
        // press keeps no meaning of its own (ADR-0034, ED-15). A sort here would bump the
        // Row Sequence Version, drop the selection and take with it the very text the
        // Reject was holding on to.
        if (_editMode != EditMode.None && !await CommitEditAsync(byPress: true))
        {
            StateHasChanged();
            return;
        }
        if (e.Button != 0 || !OnColumnOrderChanged.HasDelegate
            || _columnStyles.Geometry.IsInLead(e.OffsetX, _scrollLeftPx)
            || e.OffsetX < 0 || e.OffsetX >= _columnStyles.Geometry.TotalWidthPx
            || _columnStyles.Geometry.ColumnAt(e.OffsetX, _scrollLeftPx) is not { } column)
        {
            return;
        }

        // What you grab is the unit that moves (ADR-0032): the tier under the pointer
        // decides whether that is the leaf or a rectangle standing over it.
        var unitFirst = column;
        var unitCount = 1;
        if (_headerLayout.TierCount > 0)
        {
            var leafTopPx = BandHeightPx - (_headerLayout.LeafTierSpanOf(column) * _metrics.HeaderHeightPx);
            if (e.OffsetY < leafTopPx)
            {
                var tier = _headerLayout.TierCount - (int)Math.Floor(e.OffsetY / _metrics.HeaderHeightPx);
                ResolvedHeaderGroup? grabbed = null;
                foreach (var group in _headerLayout.Groups)
                {
                    if (column >= group.FirstColumn && column < group.FirstColumn + group.MemberCount
                        && tier >= group.BottomTier && tier <= group.TopTier)
                    {
                        grabbed = group;
                        break;
                    }
                }
                if (grabbed is null)
                    return; // an empty tier above a leaf that does not stretch there
                unitFirst = grabbed.FirstColumn;
                unitCount = grabbed.MemberCount;
            }
        }

        _dragUnitFirst = unitFirst;
        _dragUnitCount = unitCount;
        _dragStartClientX = e.ClientX;
        _dragStartContentX = e.OffsetX;
        _reordering = false;
        AttachRootGesture();
    }

    private void AttachRootGesture()
    {
        _rootGestureHandler["onmousemove"] = _onRootGestureMove ??= OnRootGestureMove;
        _rootGestureHandler["onmouseup"] = _onRootGestureUp ??= OnRootGestureUp;
    }

    private void DetachRootGesture()
    {
        _rootGestureHandler.Remove("onmousemove");
        _rootGestureHandler.Remove("onmouseup");
        _resizeColumn = -1;
        _dragUnitFirst = -1;
        _reordering = false;
        _dropBoundary = -1;
    }

    private void OnRootGestureMove(MouseEventArgs e)
    {
        if ((e.Buttons & 1) == 0)
        {
            // Released outside the grid: nothing is applied — a resize applies on
            // release over the grid, and a vanished drag must not drop anywhere.
            DetachRootGesture();
            return;
        }

        if (_resizeColumn >= 0)
        {
            var column = _resizeColumn;
            var widthPx = Math.Max(
                Columns[column].Width.MinWidthPx,
                _resizeStartWidthPx + (e.ClientX - _resizeStartClientX));
            _resizeGuideLeftPx = GuideLeftPx(column, widthPx);
            return;
        }
        if (_dragUnitFirst >= 0)
        {
            if (!_reordering && Math.Abs(e.ClientX - _dragStartClientX) <= DragThresholdPx)
            {
                _suppressRender = true;
                return;
            }
            _reordering = true;
            var contentX = _dragStartContentX + (e.ClientX - _dragStartClientX);
            // The boundary a drag may not cross is the View State's, suspended or not: a
            // drop across it would change what is pinned once the box widens (ADR-0011/0045).
            var boundaries = HeaderReorder.AllowedBoundaries(
                _headerLayout, Columns.Count, _columnStyles.Geometry.RequestedPinnedCount, _dragUnitFirst, _dragUnitCount);
            var best = boundaries[0];
            var bestDistance = double.MaxValue;
            foreach (var boundary in boundaries)
            {
                var edge = BoundaryLeftPx(boundary);
                var distance = Math.Abs(edge - contentX);
                if (distance < bestDistance)
                {
                    bestDistance = distance;
                    best = boundary;
                }
            }
            _dropBoundary = best;
            _dropIndicatorLeftPx = BoundaryLeftPx(best);
            return;
        }
        _suppressRender = true;
    }

    private double BoundaryLeftPx(int boundary)
        => (boundary <= _columnStyles.Geometry.PinnedCount && _columnStyles.Geometry.PinnedCount > 0
                && _dragUnitFirst < _columnStyles.Geometry.PinnedCount ? _scrollLeftPx : 0)
            + (boundary >= Columns.Count
                ? _columnStyles.Geometry.TotalWidthPx
                : _columnStyles.Geometry.OffsetPxOf(boundary));

    private void OnRootGestureUp(MouseEventArgs e)
    {
        if (_resizeColumn >= 0)
        {
            var column = _resizeColumn;
            var deltaPx = e.ClientX - _resizeStartClientX;
            DetachRootGesture();
            _gestureConsumedClick = true;
            // A press that barely moved is a click, or half of a double-click: it reports
            // nothing, or it would turn an Auto column Fixed and write it into the saved
            // view behind the user's back. The reorder gesture's threshold (ADR-0016/0011).
            if (Math.Abs(deltaPx) <= DragThresholdPx || !OnColumnWidthChanged.HasDelegate)
                return;
            var widthPx = Math.Max(Columns[column].Width.MinWidthPx, _resizeStartWidthPx + deltaPx);
            // Every whole column takes the grabbed one's new width, as in Excel, each
            // bounded below by its own MinWidth (FN-12c).
            var changes = ColumnsResizedWith(column)
                .Select(target => new ColumnWidthChange(
                    Columns[target].Name, Math.Max(Columns[target].Width.MinWidthPx, widthPx)))
                .ToArray();
            _ = InvokeAsync(() => ReportWidthsAsync(changes));
            return;
        }
        if (_dragUnitFirst >= 0 && _reordering)
        {
            var boundary = _dropBoundary;
            var unitFirst = _dragUnitFirst;
            var unitCount = _dragUnitCount;
            DetachRootGesture();
            _gestureConsumedClick = true;
            if (boundary >= 0 && (boundary < unitFirst || boundary > unitFirst + unitCount))
            {
                var names = new string[Columns.Count];
                for (var i = 0; i < Columns.Count; i++)
                    names[i] = Columns[i].Name;
                var order = HeaderReorder.Reorder(names, unitFirst, unitCount, boundary);
                _ = InvokeAsync(() => OnColumnOrderChanged.InvokeAsync(order));
            }
            return;
        }
        // A candidate that never crossed the threshold: the detach is markup, so the
        // render must run — and the click that follows stays a sort.
        DetachRootGesture();
    }

    /// <summary>
    /// Clicking a column header sorts, and never selects the column; Shift+click selects
    /// whole columns and never sorts (ADR-0012). The
    /// cycle is the pure model's (<see cref="SortCycle"/>); what happens to the result
    /// is not this grid's — a Source requeries itself, and a push Consumer answers with
    /// a new Window and a moved Row Sequence Version (ADR-0001/0011).
    /// </summary>
    private async Task OnHeaderClickAsync(MouseEventArgs e)
    {
        // A resize or reorder just released here: the click is the gesture's tail, not
        // a sort (ADR-0016/0011).
        if (_gestureConsumedClick)
        {
            _gestureConsumedClick = false;
            return;
        }
        // An editor still standing means the mouse-down's commit was Rejected, and this
        // click is the same gesture: it keeps no meaning of its own (ADR-0034, ED-15).
        // The mouse-down's early return cannot stop this handler — the sort happens here,
        // and a sort would bump the Row Sequence Version, drop the selection and take the
        // text the Reject was holding on to.
        if (_editMode != EditMode.None)
            return;
        // The corner where the two Headings meet selects all (ADR-0050), as Ctrl+A does —
        // under a pager, the page (ADR-0015) — and, unlike Ctrl+A, puts the Focus on the
        // top-left cell on screen, as a Heading click puts it on the first row or column on
        // screen (ADR-0052). Read before the column: ColumnAt clamps a pixel in the band to
        // the first column.
        if (e.Button == 0 && ShowsRowHeadings && _columnStyles.Geometry.IsInLead(e.OffsetX, _scrollLeftPx))
        {
            var allExtent = Extent;
            if (allExtent.RowCount > 0 && allExtent.ColumnCount > 0)
            {
                var all = SelectAllInContext(_selection.Selection, allExtent);
                if (!all.IsEmpty && FirstVisibleCell() is { } topLeft && all.Ranges[0].Contains(topLeft))
                    all = all.Place(all.Ranges[0], topLeft, allExtent);
                Apply(all);
            }
            return;
        }
        // Past the last column the header is dead space, not the last column again:
        // ColumnAt clamps because a drag past the edge should keep extending, and that
        // is the wrong answer for a click that landed on nothing.
        if (e.Button != 0
            || e.OffsetX < 0 || e.OffsetX >= _columnStyles.Geometry.TotalWidthPx
            || _columnStyles.Geometry.ColumnAt(e.OffsetX, _scrollLeftPx) is not { } column)
        {
            return;
        }
        // A click on a Header Group's rectangle is not a click on the leaf under it
        // (ADR-0032): only the column's own header sorts or selects — its leaf tier, and
        // whatever uncovered tiers that leaf stretches through.
        if (_headerLayout.TierCount > 0
            && e.OffsetY < BandHeightPx - (_headerLayout.LeafTierSpanOf(column) * _metrics.HeaderHeightPx))
        {
            return;
        }
        // Shift+click selects whole columns from the Focus's to this one, and does not
        // sort: Excel's gesture, and the mouse route to several whole columns. Selection
        // is positional, so an unsortable column is selected like any other (ADR-0012).
        if (e.ShiftKey)
        {
            // From nothing selected, the Focus on the first visible row, as the first key is
            // (KB-9): the Viewport does not move for a click on the header.
            Apply(_selection.Selection.ExtendToColumn(column, Extent, _visible?.Start ?? 0));
            return;
        }
        // Declared, the plain click is Excel's too (ADR-0050, item 1): the whole column,
        // the Focus on the first visible row so the Viewport does not move — and no sort.
        if (HeaderClickSelects)
        {
            Apply(_selection.Selection.SelectColumn(column, Extent, _visible?.Start ?? 0));
            return;
        }
        if (!Columns[column].IsQueryable)
            return;

        await ApplySortsAsync(SortCycle.Next(_sorts, Columns[column].Name));
    }

    private async Task ApplySortsAsync(IReadOnlyList<SortSpec> next)
    {
        if (Source is not null)
        {
            // The source's own StateChanged lands the reordered Window; an unchanged
            // sequence raises nothing, which is what keeps a no-op cheap (ADR-0023).
            Source.OnSortChanged(next);
            return;
        }
        await OnSortChanged.InvokeAsync(next);
    }

    /// <summary>
    /// The column menu's contract (ADR-0010): the core decides the items, all of them
    /// moving View State, so every Invoke ultimately notifies the Consumer. A command
    /// whose sink nobody wired is disabled rather than absent — Chrome lays out a
    /// stable list. The filter is not a command: it stands open below them (ADR-0044), and
    /// clearing it is, as Excel's "Clear Filter From".
    /// </summary>
    private ColumnMenuContext BuildMenuContext(int column)
    {
        var declared = Columns[column];
        var sortable = declared.IsQueryable && (Source is not null || OnSortChanged.HasDelegate);
        var commands = new List<GridCommand>
        {
            new(GridCommandIds.SortAscending, sortable,
                () => ApplySortsAsync([new SortSpec(declared.Name, SortDirection.Ascending)])),
            new(GridCommandIds.SortDescending, sortable,
                () => ApplySortsAsync([new SortSpec(declared.Name, SortDirection.Descending)])),
            new(GridCommandIds.ClearFilter, IsFilterable(column) && CurrentSpecOf(declared.Name) is not null,
                () => ApplyFilterSpecAsync(declared.Name, null)),
            new(GridCommandIds.Hide, OnColumnHidden.HasDelegate,
                () => OnColumnHidden.InvokeAsync(declared.Name)),
            // Never a pin the grid would refuse: a boundary through a Header Group
            // cannot be drawn honestly (ADR-0032), so the command is disabled there.
            new(GridCommandIds.Pin,
                OnPinnedCountChanged.HasDelegate && _columnStyles.Geometry.RequestedPinnedCount != column + 1
                    && _headerLayout.AllowsPinnedCount(column + 1),
                () => OnPinnedCountChanged.InvokeAsync(column + 1)),
            new(GridCommandIds.Unpin,
                OnPinnedCountChanged.HasDelegate && _columnStyles.Geometry.RequestedPinnedCount > 0,
                () => OnPinnedCountChanged.InvokeAsync(0)),
            new(GridCommandIds.SizeToFit, OnColumnWidthChanged.HasDelegate && declared.PaintsValue,
                () => SizeToFitAsync(column)),
        };
        var closing = Closing(commands);
        return new ColumnMenuContext(declared.Name, declared.Type, closing, CloseFromChrome,
            _menuFocusRequest, InnerPopupChangedFromChrome, ColumnMenuKeysOver(closing, IsFilterable(column)));
    }

    /// <summary>Whether a column's filter stands under its commands (ADR-0044): a queryable
    /// column on a grid where a filter change has somewhere to go.</summary>
    private bool IsFilterable(int column)
        => Columns[column].IsQueryable && (Source is not null || OnFilterChanged.HasDelegate);

    /// <summary>
    /// The secondary click (ADR-0036). Outside the selection it collapses onto the cell
    /// it lands on, so that what a command will act on is what the user can see; inside
    /// it, the selection stands. The browser's own menu is suppressed declaratively on
    /// the element, which is why no listener is installed and the JavaScript allowlist
    /// gains nothing for it (ADR-0021).
    /// </summary>
    private void OnContextMenu(MouseEventArgs e)
    {
        // The pointer lands on a cell wherever it is inside the Viewport — the geometry
        // clamps, which is why a primary click below the last row selects the last row.
        // So this is not a dead zone but the guard for having nothing painted at all, and
        // then there is no target to aim a menu at.
        // The mouse-down that preceded this has already committed or been refused
        // (ADR-0010/0034). An editor still standing here means a Reject held it, and this
        // press keeps no meaning of its own either — moving the selection would leave the
        // editor floating over a cell nobody is on, the stale-editor state the commit-first
        // rule exists to prevent.
        if (_editMode != EditMode.None)
            return;

        if (CellUnder(e) is not { } cell)
        {
            CloseMenus();
            return;
        }

        if (!_selection.Selection.Contains(cell))
            Apply(_selection.Selection.Click(cell, Extent));

        // The click that aimed the menu also armed the Focus's message timer; a message
        // opening over the menu 300 ms later would cover the items being read.
        ScheduleMessage(null);

        _menuColumn = -1;
        _findOpen = false;
        _contextCell = cell;
        BeginPopoverFocus();
        // The offsets are relative to the Viewport, whose left edge is the content's and
        // whose top edge is the first painted row — the convention CellUnder works in.
        // The popovers are laid out in viewport space, so both axes convert here,
        // exactly as CellCorner and the edge band do.
        _contextLeftPx = e.OffsetX - _scrollLeftPx;
        _contextTopPx = e.OffsetY + _geometry.OffsetPxOf((_visible?.Start ?? _pageStartRow) - _pageStartRow)
            - _geometry.ContentOffsetAt(_scrollTopPx);
    }

    /// <summary>
    /// The context menu from the keyboard (ADR-0036): on the Focus cell, which is inside
    /// the selection by construction, so nothing about the selection changes — the
    /// pointer's rule about collapsing onto what was clicked has nothing to decide here.
    /// It opens at the Focus cell's own corner rather than at a fixed place, so the menu
    /// arrives where the user's attention already is.
    /// </summary>
    private void OpenContextMenuAtFocus()
    {
        if (_visible is null || _selection.Selection.IsEmpty)
            return;
        var focus = _selection.Selection.Focus;
        if (focus.Column >= Columns.Count)
            return;

        (_contextLeftPx, _contextTopPx) = CellCorner(focus);
        _menuColumn = -1;
        _findOpen = false;
        _contextCell = focus;
        BeginPopoverFocus();
    }

    /// <summary>
    /// Which message is showing, if any (ADR-0034). The editor's Reject outranks a
    /// flagged cell's: while an editor holds, the sentence the user needs is the one
    /// about the value they are still typing.
    /// </summary>
    private (CellPosition Cell, string? Text, bool IsEditorError) MessageOnShow()
    {
        if (_editError is { } error && _editMode != EditMode.None && _editingCell.Column < Columns.Count)
            return (_editingCell, error, true);
        // Only while its cell is painted. A wheel scroll moves the Viewport without moving
        // the Focus (ADR-0033's dangling-reference problem, in another shape), and a
        // popover anchored above the Window would draw over the header band.
        if (_messageCell is { } cell && _messageText is { } text
            && cell.Column < Columns.Count && IsPainted(cell))
        {
            return (cell, text, false);
        }
        return (default, null, false);
    }

    private bool IsPainted(CellPosition cell)
        => _visible is { } visible && cell.Row >= visible.Start && cell.Row < visible.Start + visible.Count;

    /// <summary>"true" while a Reject stands, and absent otherwise (ADR-0034). A string
    /// rather than a bool: Blazor renders a false bool as an omitted attribute and a true
    /// one as an empty value, and an assistive technology reading aria-invalid wants the
    /// word.</summary>
    private string? EditorInvalid => _editError is null ? null : "true";

    /// <summary>The message popover's id, instance-prefixed like every other (ADR-0018),
    /// so the editor can be described by it.</summary>
    private string MessageId => _idPrefix + "message";

    private void CloseMessage()
    {
        _messageCell = null;
        _messageText = null;
    }

    /// <summary>The message popover at its cell's own corner, clamped to the Viewport
    /// and below the header band the popovers all sit under (ADR-0027 — the widest the
    /// box may be rides the instance inline, so the clamp and the laid-out box are one
    /// number, and a message at the rightmost column is wholly on screen).</summary>
    private string CellCornerStyle(CellPosition cell)
    {
        var (left, top) = CellCorner(cell);
        var width = Math.Min(MessageMaxWidthPx, _visibleWidthPx);
        left = Math.Clamp(left, 0, Math.Max(0, _visibleWidthPx - width));
        // Below the cell, not over it: a box that covers the value it is complaining
        // about, or the editor the user is being asked to correct, is worse than none.
        return FormattableString.Invariant(
            $"left: {left}px; top: {FormulaBarPx + BandHeightPx + top + _metrics.RowHeightPx}px; max-width: {width}px");
    }

    /// <summary>The widest a message popover lays out — emitted inline, never a
    /// stylesheet literal beside this number (ADR-0027).</summary>
    private const double MessageMaxWidthPx = 320;

    /// <summary>A cell's top-left inside the Viewport, in the coordinates the popovers
    /// are laid out in.</summary>
    private (double Left, double Top) CellCorner(CellPosition cell)
    {
        var geometry = _columnStyles.Geometry;
        var left = cell.Column < geometry.PinnedCount
            ? geometry.OffsetPxOf(cell.Column)
            : geometry.OffsetPxOf(cell.Column) - _scrollLeftPx;
        // Relative to the top of the Viewport, not to the first painted row: SliceAt floors
        // the offset, so with a smooth scroll that row starts up to a row height above the
        // visible top and a popover placed from it would sit a row too low.
        var top = _visible is { } visible
            ? _geometry.ViewportTopPxOf(cell.Row - _pageStartRow, _scrollTopPx)
            : 0d;
        return (left, top);
    }

    /// <summary>
    /// The pointer has come to rest over the Viewport (ADR-0021's fifth entry). JS heard
    /// the moves and reports only the stillness, so this runs once per pause rather than
    /// once per frame. What it was told is a pair of offsets; which cell that is, and
    /// whether there is anything to say about it, are both decided here.
    ///
    /// <para>Called by the grid's own script module and not for Consumers: it is public
    /// only because JavaScript interop requires it.</para>
    /// </summary>
    [JSInvokable]
    public Task OnPointerRestAsync(double x, double y)
    {
        // A pause in the middle of a drag-select is not a hover: the pointer is holding a
        // gesture, and a popover under it would take the mouse-up that ends the drag.
        if (_disposed || CellMessageOf is null || _editMode != EditMode.None || _dragging)
            return Task.CompletedTask;
        // Over a Row Heading there is no cell (ADR-0050), though CellUnder clamps to one.
        if (_columnStyles.Geometry.IsInLead(x, _scrollLeftPx))
            return Task.CompletedTask;
        if (CellUnder(new MouseEventArgs { OffsetX = x, OffsetY = y }) is not { } cell)
            return Task.CompletedTask;
        if (_messageCell == cell)
            return Task.CompletedTask;

        // Whatever was open belonged to the cell the pointer left, so it goes whether or
        // not this one has anything to say — the Focus path closes first for the same
        // reason. The stillness is already established, so the message is asked for now,
        // once, rather than waiting again.
        var closed = _messageCell is not null;
        if (closed)
            CloseMessage();
        _messageTarget = cell;
        ShowMessageAt(cell);
        if (closed && _messageCell is null)
            StateHasChanged();
        return Task.CompletedTask;
    }

    /// <summary>The pointer is not over a row any more. Onto the header or a popover,
    /// only the band goes (<paramref name="bandOnly"/>): the message a rest opened is
    /// still being read. Out of the instance altogether, the message closes too.
    ///
    /// <para>Called by the grid's own script module and not for Consumers: it is public
    /// only because JavaScript interop requires it.</para>
    /// </summary>
    [JSInvokable]
    public Task OnPointerAwayAsync(bool bandOnly)
    {
        if (_disposed)
            return Task.CompletedTask;
        var changed = false;
        if (_hoverRow >= 0)
        {
            _hoverRow = -1;
            changed = HoverEnabled;
        }
        if (!bandOnly && _messageCell is not null)
        {
            CloseMessage();
            changed = true;
        }
        if (changed)
            StateHasChanged();
        return Task.CompletedTask;
    }

    /// <summary>
    /// The Context Menu stands at the pointer, on whichever side of it the grid has more
    /// room, and is bounded by that room (ADR-0040): above, it hangs from the pointer by
    /// its own height — a translate of its own box, nothing measured. Across, it is clamped
    /// by the widest it may grow, as every popover is.
    /// </summary>
    private string ContextPopoverStyle()
    {
        var (left, width) = PopoverAcross(_contextLeftPx);
        var (at, below) = ContextPopoverPlacement();
        return below >= at
            ? FormattableString.Invariant(
                $"left: {left}px; top: {FormulaBarPx + at}px; {width}; max-height: {below}px")
            : FormattableString.Invariant(
                $"left: {left}px; top: {FormulaBarPx + at}px; transform: translateY(-100%); {width}; max-height: {at}px");
    }

    /// <summary>Where the Context Menu stands and how much room lies below it: the pointer's
    /// height inside the Viewport, clamped to it (ADR-0040). Its style and the no-room
    /// close read these numbers.</summary>
    private (double At, double Below) ContextPopoverPlacement()
    {
        var at = Math.Clamp(BandHeightPx + _contextTopPx, 0, _visibleHeightPx);
        return (at, _visibleHeightPx - at);
    }

    /// <summary>
    /// A popover's place and width across the grid (ADR-0027/0040): no narrower than
    /// <see cref="PopoverMinWidthPx"/>, no wider than <see cref="PopoverMaxWidthPx"/> or
    /// the Viewport, and its left edge clamped by that widest — so however wide its
    /// contents make it, its right edge stays inside the grid's box. The numbers the clamp
    /// uses are the numbers written inline, never a C# constant beside a stylesheet one.
    /// </summary>
    private (double Left, string Width) PopoverAcross(double wantedLeft)
    {
        var widest = Math.Min(PopoverMaxWidthPx, Math.Max(0, _visibleWidthPx));
        var narrowest = Math.Min(PopoverMinWidthPx, widest);
        var left = Math.Clamp(wantedLeft, 0, Math.Max(0, _visibleWidthPx - widest));
        return (left, FormattableString.Invariant($"min-width: {narrowest}px; max-width: {widest}px"));
    }

    /// <summary>
    /// The context menu's items (ADR-0036): the clipboard's, because only the grid can
    /// build that payload — the cap, the misalignment refusal, the Window-coverage check
    /// and the rule that <c>####</c> never reaches the clipboard are ADR-0005's and are
    /// not reimplementable from outside — and then the Consumer's own.
    /// </summary>
    private ContextMenuContext<TRow> BuildContextMenuContext(CellPosition cell, int slice)
    {
        var declared = Columns[cell.Column];
        var canCopy = !_selection.Selection.IsEmpty;
        var core = new List<GridCommand>
        {
            new(GridCommandIds.Copy, canCopy, () => MenuCopyAsync(withHeaders: false)),
        };
        // ADR-0050 item 13: a Consumer may leave copy with headers out.
        if (!HideCopyWithHeaders)
            core.Add(new(GridCommandIds.CopyWithHeaders, canCopy, () => MenuCopyAsync(withHeaders: true)));
        var context = new ContextMenuContext<TRow>(
            _window[slice], declared.Name, declared.Type,
            _selection.Selection.Ranges, _sequenceVersion, core, CloseFromChrome, _popoverFocusRequest,
            InnerPopupChangedFromChrome);
        var commands = new List<GridCommand>(core);
        if (ContextCommands?.Invoke(context) is { } extra)
            commands.AddRange(extra);
        var closing = Closing(commands);
        return context with { Commands = closing, ResolveKey = MenuKeysOver(closing) };
    }

    /// <summary>
    /// The commands as a menu hands them out (ADR-0010/0039/0044): invoking one runs it and
    /// then closes the popover it stands in, and hands the keyboard back to the root,
    /// whichever Chrome invoked it and however: a click, Enter or Space.
    /// What closes a popover is the core's to decide, so a substituted Chrome only calls
    /// <see cref="GridCommand.Invoke"/>, and the grid renders itself, since the event that
    /// invoked it may have been the Chrome's rather than the grid's.
    /// </summary>
    private List<GridCommand> Closing(List<GridCommand> commands)
    {
        for (var i = 0; i < commands.Count; i++)
        {
            var command = commands[i];
            commands[i] = command with
            {
                Invoke = () => InvokeAsync(async () =>
                {
                    await RunCommandAsync(command);
                    StateHasChanged();
                }),
            };
        }
        return commands;
    }

    /// <summary>A copy invoked from a menu takes the asynchronous route whatever the
    /// selection's size, because a menu item's click fires no <c>copy</c> event
    /// (ADR-0005/0036). Still the allowlisted clipboard use, not a new one.</summary>
    private async Task MenuCopyAsync(bool withHeaders)
    {
        if (_scrollHandle is null || _disposed)
            return;
        try
        {
            await _scrollHandle.InvokeVoidAsync("writeCopy", withHeaders);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or ObjectDisposedException or OperationCanceledException)
        {
            // The circuit or the module is gone; the clipboard stays as it was, which is
            // the refusing grid's contract (ADR-0005).
        }
    }

    /// <summary>What the built-in menu calls a command (ADR-0036): the Consumer's wording
    /// where it has one, the default Chrome's table otherwise.</summary>
    private string LabelOf(GridCommand command) => Label(command.Id);

    /// <summary>"Size to fit" fixes the width at the content of this moment (ADR-0016):
    /// the header's full need and every value in the Window — not only the painted rows,
    /// or a column fitted a moment ago shows <c>####</c> a few rows down — bounded by the
    /// declaration. It runs once, when asked, so a pass over the Window costs nothing
    /// that matters. From the column menu it fits the one column; from a grip it fits
    /// every whole column the grip's column is among (FN-12c).</summary>
    private Task SizeToFitAsync(int column) => SizeToFitAsync([column]);

    private async Task SizeToFitAsync(IReadOnlyList<int> columns)
    {
        var changes = new List<ColumnWidthChange>(columns.Count);
        foreach (var column in columns)
        {
            var declared = Columns[column];
            if (!declared.PaintsValue)
                continue;
            var required = HeaderRequiredPx(column);
            foreach (var row in _window)
            {
                required = Math.Max(
                    required,
                    _metrics.CellMetrics.EstimatePx(ExGridRow<TRow>.CellText(declared, row)));
            }
            changes.Add(new ColumnWidthChange(declared.Name, declared.Width.SizeToFit(required).FixedPx));
        }
        await ReportWidthsAsync(changes);
    }

    /// <summary>Reports widths decided beforehand, one notification per column (ADR-0016):
    /// a Consumer answering the first by pushing new Columns or a new Window must not change
    /// what the rest were measured against.</summary>
    private async Task ReportWidthsAsync(IReadOnlyList<ColumnWidthChange> changes)
    {
        foreach (var change in changes)
            await OnColumnWidthChanged.InvokeAsync(change);
    }

    /// <summary>What a column's header needs (ADR-0016): its label, an em of slack, the
    /// menu band when the header carries the button, and the sort indicator's room when
    /// the column can be sorted.</summary>
    private double HeaderRequiredPx(int column)
        => _metrics.HeaderRequiredPx(Columns[column].Header, ShowMenuButtons, Columns[column].IsQueryable);

    /// <summary>The columns a gesture on <paramref name="grabbed"/>'s grip acts on: every
    /// column a whole-column range covers when the grabbed one is among them, and the
    /// grabbed one alone otherwise (ADR-0016, FN-12c). A range short of any row selects
    /// cells, not columns.</summary>
    private IReadOnlyList<int> ColumnsResizedWith(int grabbed)
    {
        var whole = _selection.Selection.WholeColumns(Extent);
        foreach (var column in whole)
        {
            if (column == grabbed)
                return whole;
        }
        return [grabbed];
    }

    private async Task RunCommandAsync(GridCommand command)
    {
        var opening = _popoverFocusRequest;
        await command.Invoke();
        // Only the popover the command ran from closes, and the keyboard goes back to the
        // root (ADR-0039/0044): a command that took its time may find another popover
        // opened meanwhile, which is not its to close.
        if (_popoverFocusRequest == opening)
            ClosePopoverAndReturnFocus();
    }

    // A header button's handler depends on nothing but its column's index, so one is made
    // per index the first time it is painted and handed over from then on: the same
    // delegate every render, which the diff recognises and leaves registered while the
    // button keeps its place (PF-3). A sideways scroll that shifts the painted columns
    // moves a scrollable header's button to where another column's stood, and the diff,
    // comparing by position, registers that one afresh.
    private Func<Task>?[] _menuOpeners = [];
    private Action<MouseEventArgs>?[] _gripDowns = [];
    private Func<Task>?[] _gripFitters = [];

    /// <summary>How far a header press must travel before it is a drag — a resize or a
    /// reorder — rather than a click (ADR-0011/0016).</summary>
    private const double DragThresholdPx = 4;

    private Func<Task> MenuOpener(int column)
    {
        if (column >= _menuOpeners.Length)
            Array.Resize(ref _menuOpeners, Math.Max(column + 1, Columns.Count));
        return _menuOpeners[column] ??= MenuOpenerFor(column);
    }

    private Action<MouseEventArgs> GripDown(int column)
    {
        if (column >= _gripDowns.Length)
            Array.Resize(ref _gripDowns, Math.Max(column + 1, Columns.Count));
        return _gripDowns[column] ??= GripDownFor(column);
    }

    private Func<Task> GripFitter(int column)
    {
        if (column >= _gripFitters.Length)
            Array.Resize(ref _gripFitters, Math.Max(column + 1, Columns.Count));
        return _gripFitters[column] ??= GripFitterFor(column);
    }

    // Their own methods so that only a miss captures anything: a lambda capturing a
    // parameter allocates its closure on entry to the method, cache hit or not.
    private Func<Task> MenuOpenerFor(int column) => () => OpenMenuAsync(column);

    private Action<MouseEventArgs> GripDownFor(int column) => e => OnResizeGripDown(column, e);

    /// <summary>A double-click on a grip is Size to fit, the column menu's command
    /// (ADR-0016, FN-12a).</summary>
    private Func<Task> GripFitterFor(int column) => () => OnColumnWidthChanged.HasDelegate
        ? SizeToFitAsync(ColumnsResizedWith(column))
        : Task.CompletedTask;

    /// <summary>The menu button is a toggle: the second press on the same column's
    /// button closes what the first opened — a popover the user cannot dismiss is a
    /// popover in the way.</summary>
    private async Task OpenMenuAsync(int column)
    {
        // The button stops the press from reaching the header, so the click-away commit
        // never ran for it — it has to run here, and a Reject holds the editor and keeps
        // this press meaningless like every other (ADR-0010/0034). Without it "Sort
        // ascending" from the menu is a silent way to lose the held text.
        if (_editMode != EditMode.None && !await CommitEditAsync(byPress: true))
        {
            StateHasChanged();
            return;
        }
        if (_menuColumn == column)
        {
            ClosePopoverAndReturnFocus();
            return;
        }
        _menuColumn = column;
        _contextCell = null;
        _findOpen = false;
        BeginPopoverFocus();
        if (IsFilterable(column))
            await BeginFilterAsync(column);
    }

    /// <summary>Alt+↓ (ADR-0039): the Focus's column menu, opened — never toggled shut,
    /// since a menu standing open holds DOM focus and this key cannot reach the root then.
    /// With no Focus, or on a grid whose headers carry no menu, it does nothing.</summary>
    private async Task OpenColumnMenuFromKeyAsync()
    {
        if (_selection.Selection.IsEmpty || !ShowMenuButtons)
            return;
        var column = _selection.Selection.Focus.Column;
        if (column >= Columns.Count || _menuColumn == column)
            return;
        await OpenMenuAsync(column);
    }

    /// <summary>Whether any popover stands: a column's, the Context Menu or the find panel.</summary>
    private bool AnyPopoverOpen => _menuColumn >= 0 || _contextCell is not null || _findOpen;

    private void CloseMenus()
    {
        _findOpen = false;
        _findCancellation?.Cancel();
        _findCancellation = null;
        // A popup inside the popover goes with it (ADR-0039).
        _innerPopupOpen = false;
        _contextCell = null;
        _menuColumn = -1;
        _shownMenuCommands = null;
        _panelValues = null;
        _panelChecked = null;
        _panelAwaitingValues = false;
        _popoverFocusPending = PopoverFocus.None;
    }

    /// <summary>
    /// Every opening asks the popover's commands to take DOM focus (ADR-0039/0044): the
    /// counts the contexts carry move on, and the built-in contents are focused after the
    /// render that paints them. The filter below a column's commands is asked nothing yet —
    /// its count starts again from zero. The references are cleared first, so a substituted
    /// Chrome — which binds none — leaves them empty and the core, holding nothing it did
    /// not render, focuses nothing.
    /// </summary>
    private void BeginPopoverFocus()
    {
        _popoverFocusRequest++;
        _menuFocusRequest++;
        _panelFocusRequest = 0;
        _panelFocusLastRequest = 0;
        _panelSearchRequest = 0;
        _popoverFocusPending = PopoverFocus.FirstCommand;
        _menuCursor = -1;
        _panelFirst = default;
        _panelLast = default;
        _panelValueField = default;
        _findField = default;
        _menuItems.Clear();
        _reclaimFocusPending = false;
        // A new opening starts clean, however the last one ended: a panel still waiting
        // for its list, or contents that never reported their popup closed, must not keep
        // this popover from taking the keyboard or from answering Escape (ADR-0039).
        _panelAwaitingValues = false;
        _innerPopupOpen = false;
        _innerPopupChanged = null;
    }

    /// <summary>
    /// A popover's max-height follows the box (ADR-0040). A box that shrinks until the open
    /// popover has less than one row of room would leave it showing no item, invisible and
    /// still holding the keyboard (ADR-0039), so it closes as a Cancel and the keyboard
    /// returns to the root. Only a shrink does this: a popover opened in a small box is
    /// the Consumer's box, not a change.
    /// </summary>
    private void CloseAPopoverTheBoxNoLongerHolds(double previousHeightPx)
    {
        if (_visibleHeightPx < previousHeightPx
            && PopoverRoomPx() is { } room && room < _metrics.RowHeightPx)
        {
            ClosePopoverAndReturnFocus();
        }
    }

    /// <summary>How tall the open popover may be, or null when none is open: the same
    /// room its style is written with. The Context Menu opens on the side with more room,
    /// so that side is its room (ADR-0040).</summary>
    private double? PopoverRoomPx()
    {
        if (_menuColumn >= 0 || _findOpen)
            return HeaderPopoverRoomPx;
        if (_contextCell is not null)
        {
            var (at, below) = ContextPopoverPlacement();
            return Math.Max(below, at);
        }
        return null;
    }

    /// <summary>
    /// Closes whatever popover stands and hands the keyboard back to the root after the
    /// render that removes it (ADR-0039) — however it closed: a command run, Apply, Cancel,
    /// Clear, the ▾ pressed again, or the Chrome's own affordance. DOM focus may be inside
    /// the popover or inside an Inner Popup its design system drew outside the root, and
    /// either way it would otherwise be left on an element that is about to disappear.
    /// A pointer-down that dismisses does not come through here: it keeps its own meaning,
    /// and where it lands decides focus (ADR-0010).
    ///
    /// The root is also asked for focus now, before the render that removes the popover,
    /// and the call reaches the browser ahead of that render. After it alone, a Server
    /// circuit leaves a round trip in which the element that held focus is gone, DOM focus
    /// is on <c>body</c>, and the capture-phase listener on the root hears nothing: a key
    /// typed straight after Escape was lost. The request after the render stays, so that
    /// the core still has the last word (ADR-0039).
    /// </summary>
    private void ClosePopoverAndReturnFocus()
    {
        var wasOpen = AnyPopoverOpen;
        if (wasOpen)
            _ = ReclaimFocusAsync();
        CloseMenus();
        if (wasOpen)
            _reclaimFocusPending = true;
    }

    /// <summary>The contexts' <c>Close</c>: what a Chrome's own × or backdrop invokes. It
    /// arrives from the Chrome's event, not the grid's, so the grid renders itself.</summary>
    private Action CloseFromChrome => _closeFromChrome ??= () => _ = InvokeAsync(() =>
    {
        ClosePopoverAndReturnFocus();
        StateHasChanged();
    });

    /// <summary>The contexts' <c>InnerPopupChanged</c>: the contents report a popup of their
    /// own opening or closing (ADR-0039), and the key gate is told at once — the next
    /// Escape may already be on its way.</summary>
    private Action<bool> InnerPopupChangedFromChrome => _innerPopupChanged ??= ReportFor(_popoverFocusRequest);

    // One reporter per opening: a report from contents that have since closed, or been
    // replaced by another popover's, carries an opening that is no longer the current one
    // and changes nothing.
    private Action<bool> ReportFor(int opening) => open => _ = InvokeAsync(async () =>
    {
        if (opening != _popoverFocusRequest || !AnyPopoverOpen)
            return;
        _innerPopupOpen = open;
        await SyncInnerPopupAsync();
    });

    /// <summary>Tells the key gate whether a popover's contents have a popup open, when
    /// that has changed since it was last told.</summary>
    private async Task SyncInnerPopupAsync()
    {
        if (_scrollHandle is null || _disposed || _innerPopupTold == _innerPopupOpen)
            return;
        _innerPopupTold = _innerPopupOpen;
        try
        {
            await _scrollHandle.InvokeVoidAsync("setInnerPopup", _innerPopupOpen);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or ObjectDisposedException or OperationCanceledException)
        {
        }
    }

    /// <summary>The built-in panel's Cancel: a discard, and the keyboard back (ADR-0009/0039).</summary>
    private void CancelPanel() => ClosePopoverAndReturnFocus();

    private async Task SettlePopoverFocusAsync()
    {
        if (_disposed)
            return;
        if (_reclaimFocusPending)
        {
            _reclaimFocusPending = false;
            await ReclaimFocusAsync();
            return;
        }
        var target = _popoverFocusPending;
        // The built-in filter paints its condition form while a value list is on its way,
        // and swaps it for the list when the answer lands: focusing one of its controls
        // before then would put DOM focus on an element about to be removed.
        if (target == PopoverFocus.None
            || (_panelAwaitingValues && target is PopoverFocus.PanelFirst or PopoverFocus.PanelLast or PopoverFocus.PanelSearch))
            return;
        _popoverFocusPending = PopoverFocus.None;
        // Only enabled items are captured, so the lowest position is the first enabled
        // item (MenuKeys.First) — and a substituted Chrome captured nothing at all.
        var element = target switch
        {
            PopoverFocus.PanelFirst => _panelFirst,
            PopoverFocus.FindField => _findField,
            PopoverFocus.PanelLast => _panelLast,
            // The search box is the value list's first control; the condition's value is
            // where a search is typed when no list stands — or its operator, while that
            // operator takes no value.
            PopoverFocus.PanelSearch => _panelValues is { IsTooMany: false } || !FilterPanelChoices.TakesOperand(_panelOperator)
                ? _panelFirst
                : _panelValueField,
            _ => _menuItems.Count > 0 ? _menuItems[_menuItems.Keys.Min()] : default,
        };
        // Without scrolling: on a Server circuit this lands a round trip after the popover
        // is shown, and a menu taller than its grid (ADR-0040) may already have been
        // scrolled by the user, whose view it would pull back to the top.
        await FocusQuietlyAsync(element, preventScroll: true);
    }

    /// <summary>Focuses an element the core rendered, if it is still there to focus. A
    /// popover can close between the render that painted it and this call, and a closed
    /// circuit cannot focus anything; neither is worth an exception.</summary>
    private static async Task FocusQuietlyAsync(ElementReference element, bool preventScroll = false)
    {
        if (element.Id is null)
            return;
        try
        {
            await element.FocusAsync(preventScroll);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or ObjectDisposedException or OperationCanceledException)
        {
        }
    }

    /// <summary>
    /// A key on one of the built-in menu's items (ADR-0039): what it means is
    /// <see cref="MenuKeys"/>' to say, through the same resolver a substituted Chrome is
    /// handed — the column menu's, with Excel's letters and Tab into the filter, or the
    /// Context Menu's.
    /// </summary>
    private async Task OnMenuItemKeyAsync(KeyboardEventArgs e, IReadOnlyList<GridCommand> commands, MenuKeyResolver resolve)
    {
        var meaning = resolve(e.Key, e.ShiftKey, IsChord(e));
        switch (meaning.Kind)
        {
            case MenuKeyKind.Move when _menuItems.TryGetValue(meaning.Item, out var target):
                await FocusQuietlyAsync(target);
                break;
            case MenuKeyKind.Run:
                await commands[meaning.Item].Invoke();
                break;
            case MenuKeyKind.Close:
                ClosePopoverAndReturnFocus();
                break;
        }
    }

    /// <summary>
    /// The open menu's place (ADR-0039): where the keys have moved it, which is not
    /// necessarily the item holding DOM focus — on a circuit that follows a round trip
    /// behind, and a key resolved against it would run the item the user moved away from.
    /// -1 until the first key, which starts from the first enabled item, as focus does.
    /// </summary>
    private int _menuCursor = -1;

    private MenuKey ResolveMenuKey(IReadOnlyList<GridCommand> commands, string key, bool shift, bool chord)
        => MovedCursor(MenuKeys.Resolve(key, shift, chord, commands, PlaceMenuCursor(commands)));

    /// <summary>Settles the menu's place over <paramref name="commands"/> and answers it: the
    /// first enabled item until a key has moved it.</summary>
    private int PlaceMenuCursor(IReadOnlyList<GridCommand> commands)
    {
        if (_menuCursor < 0 || _menuCursor >= commands.Count)
            _menuCursor = MenuKeys.First(commands);
        return _menuCursor;
    }

    /// <summary>A <see cref="MenuKeyKind.Move"/> moves the menu's place; the answer is
    /// passed on as it is.</summary>
    private MenuKey MovedCursor(MenuKey meaning)
    {
        if (meaning.Kind == MenuKeyKind.Move)
            _menuCursor = meaning.Item;
        return meaning;
    }

    private static bool IsChord(KeyboardEventArgs e) => e.CtrlKey || e.AltKey || e.MetaKey;

    /// <summary>
    /// A key on the column menu (ADR-0044), answered and — for the filter — carried out: its
    /// table has Excel's letters, and Tab, E and Shift+Tab move the keyboard into the filter
    /// below, which the core does here; the contents only focus, run and close. The keys
    /// typed while the keyboard is on its way are held by the key listener (ADR-0010).
    /// </summary>
    private MenuKey ResolveColumnMenuKey(
        IReadOnlyList<GridCommand> commands, bool filterBelow, string key, bool shift, bool chord)
    {
        var meaning = MenuKeys.ResolveInColumnMenu(key, shift, chord, commands, PlaceMenuCursor(commands), filterBelow);
        if (meaning.Kind is MenuKeyKind.FilterFirst or MenuKeyKind.FilterLast or MenuKeyKind.FilterSearch)
            MoveKeyboardToFilter(meaning.Kind);
        return MovedCursor(meaning);
    }

    /// <summary>The Context Menu's <c>ResolveKey</c> over the commands it hands out.</summary>
    private MenuKeyResolver MenuKeysOver(IReadOnlyList<GridCommand> commands)
        => (key, shift, chord) => ResolveMenuKey(commands, key, shift, chord);

    /// <summary>The column menu's <c>ResolveKey</c> over the commands it hands out.</summary>
    private MenuKeyResolver ColumnMenuKeysOver(IReadOnlyList<GridCommand> commands, bool filterBelow)
        => (key, shift, chord) => ResolveColumnMenuKey(commands, filterBelow, key, shift, chord);

    /// <summary>
    /// Sends the keyboard from the commands to the filter below them (ADR-0044): its first
    /// control for Tab, its last for Shift+Tab's wrap, and for E the field a search is typed
    /// into — the value list's search box, or the condition's value. The built-in filter is
    /// focused after the render; a substituted one is asked through its context's count. The
    /// key reached the core through a Chrome's handler as often as through its own, so the
    /// grid renders itself.
    /// </summary>
    private void MoveKeyboardToFilter(MenuKeyKind where)
    {
        switch (where)
        {
            case MenuKeyKind.FilterLast:
                _panelFocusLastRequest++;
                _popoverFocusPending = PopoverFocus.PanelLast;
                break;
            case MenuKeyKind.FilterSearch:
                _panelSearchRequest++;
                _popoverFocusPending = PopoverFocus.PanelSearch;
                break;
            default:
                _panelFocusRequest++;
                _popoverFocusPending = PopoverFocus.PanelFirst;
                break;
        }
        _ = InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Tab off either end of the filter lands on a sentinel, which hands the keyboard back
    /// to the first command (ADR-0044): the built-in one directly, a substituted menu through
    /// its context's count — this handler is the grid's own, so the render that carries the
    /// count follows.
    /// </summary>
    private async Task ReturnKeyboardToCommandsAsync()
    {
        _menuCursor = -1;
        _menuFocusRequest++;
        if (_menuItems.Count > 0)
            await FocusQuietlyAsync(_menuItems[_menuItems.Keys.Min()]);
    }

    /// <summary>
    /// A key on the filter's value list (ADR-0044): Excel's letters act here as on the
    /// commands — S, O and C run their command, E goes back to the search box — and every other
    /// key is the list's own. The built-in list and a substituted panel's hand it here alike,
    /// the latter through its context, so the grid renders itself.
    /// </summary>
    private async Task<bool> OnValueListKeyAsync(KeyboardEventArgs e)
    {
        // Only a single character can be a letter: an arrow, Tab or Space on a checkbox
        // is not one.
        if (_menuColumn < 0 || _menuColumn >= Columns.Count || e.Key is not { Length: 1 } || IsChord(e))
            return false;
        var commands = _shownMenuCommands ?? BuildMenuContext(_menuColumn).Commands;
        var meaning = MenuKeys.Letter(e.Key, controlAltOrMeta: false, commands, filterBelow: true);
        if (meaning.Kind == MenuKeyKind.None)
            return false;
        if (meaning.Kind == MenuKeyKind.Run)
            await commands[meaning.Item].Invoke();
        else
            MoveKeyboardToFilter(meaning.Kind);
        return true;
    }

    /// <summary>The filter context's <c>ValueListKey</c>: one delegate, whatever renders.</summary>
    private Func<KeyboardEventArgs, Task> ValueListKeyFromChrome => _valueListKey ??= e => OnValueListKeyAsync(e);

    private Func<KeyboardEventArgs, Task>? _valueListKey;

    // The commands the open column popover shows, as its last render built them: what a
    // letter on the value list runs, without building them again per key.
    private IReadOnlyList<GridCommand>? _shownMenuCommands;

    /// <summary>The built-in list's keys: a key that means nothing to the grid — an arrow,
    /// Space on a checkbox — changes nothing on screen, and does not render it.</summary>
    private async Task OnBuiltInValueListKeyAsync(KeyboardEventArgs e)
    {
        if (!await OnValueListKeyAsync(e))
            _suppressRender = true;
    }

    /// <summary>The letters that run one of <paramref name="commands"/> while it is enabled,
    /// for the key listener (ADR-0044).</summary>
    private static string EnabledLetters(IReadOnlyList<GridCommand> commands)
    {
        var letters = "";
        foreach (var command in commands)
        {
            if (command.Enabled && MenuKeys.LetterOf(command.Id) is { } letter)
                letters += letter;
        }
        return letters;
    }

    /// <summary>
    /// Starts the filter below a column's commands (ADR-0009/0044): the value list is
    /// fetched once per opening and not again while it stands — a list that shifted with
    /// every checkbox would be unusable — and everything in it is uncommitted until OK.
    /// </summary>
    private async Task BeginFilterAsync(int column)
    {
        _panelValues = null;
        _panelChecked = null;
        _panelSearch = "";
        _panelValueText = "";
        _panelAddToCurrent = false;
        var declared = Columns[column];
        var opening = _popoverFocusRequest;
        _panelAwaitingValues = declared.FilterUi != FilterUiMode.Condition;

        // What the filter starts with is FilterPanelChoices' to say — the same rules a
        // substituted panel starts from (ADR-0009/0010).
        var current = CurrentSpecOf(declared.Name);
        _panelOperator = FilterPanelChoices.InitialOperator(declared.Type, current, tooMany: false);
        _panelValueText = FilterPanelChoices.InitialOperand(current)?.ToString() ?? "";
        var (secondOperator, secondOperand, combinator) = FilterPanelChoices.InitialSecond(current);
        _panelSecondOperator = secondOperator;
        _panelSecondValueText = secondOperand?.ToString() ?? "";
        _panelCombinator = combinator;
        var startedOn = _panelOperator;

        // The list is fetched here for the built-in filter alone: a substituted one pulls it
        // through its context when it wants it, and a second query per opening would be the
        // Consumer's cost for nothing.
        if (declared.FilterUi == FilterUiMode.Condition || Chrome?.FilterPanel(BuildPanelContext(column)) is not null)
        {
            _panelAwaitingValues = false;
            return;
        }
        // The popover is shown, and its commands take the keyboard, while the list is on
        // its way.
        StateHasChanged();
        var answer = await RequestDistinctValuesAsync(declared.Name);
        if (_disposed || _menuColumn != column || _popoverFocusRequest != opening)
            return;
        _panelValues = answer;
        _panelAwaitingValues = false;
        // The condition form stood while the list was on its way, and whatever the user
        // chose there meanwhile stays: only an untouched form starts over on TooMany's
        // operator.
        if (answer.IsTooMany)
        {
            if (_panelOperator == startedOn && _panelValueText.Length == 0)
                _panelOperator = FilterPanelChoices.InitialOperator(declared.Type, current, tooMany: true);
        }
        else
            _panelChecked = FilterPanelChoices.InitiallyChosen(current, answer);
        StateHasChanged();
    }

    private static bool TryReadOperand(ColumnType type, FilterOperator op, string text, out object? operand)
    {
        operand = null;
        if (!FilterPanelChoices.TakesOperand(op) || string.IsNullOrEmpty(text))
            return true;
        operand = FilterPanelChoices.ParseOperand(type, text);
        return operand is not null;
    }

    /// <summary>A value as the built-in panel lists it, and as its search matches it: the
    /// column's own format, and Blank in the built-in Chrome's words.</summary>
    private string PanelText(object? value, int column)
        => value is null
            ? "(Blanks)"
            : Columns[column].Format is { } format ? format(value) : value.ToString() ?? "";

    private static string AriaCheckedOf(SelectAllState state) => state switch
    {
        SelectAllState.Checked => "true",
        SelectAllState.Unchecked => "false",
        _ => "mixed",
    };

    private FilterSpec? CurrentSpecOf(string column)
        => _filter is not null && _filter.Columns.TryGetValue(column, out var spec) ? spec : null;

    private Task<DistinctValues> RequestDistinctValuesAsync(string column)
    {
        if (Source is not null)
            return Source.GetDistinctValuesAsync(column, CancellationToken.None);
        if (OnDistinctValuesNeeded is not null)
            return OnDistinctValuesNeeded(column, CancellationToken.None);
        return Task.FromResult(DistinctValues.TooMany);
    }

    /// <summary>Everything a substitute needs (ADR-0009); the built-in panel uses the
    /// same context, so the two cannot diverge.</summary>
    private FilterPanelContext BuildPanelContext(int column)
    {
        var declared = Columns[column];
        return new FilterPanelContext(
            declared.Name,
            declared.Type,
            CurrentSpecOf(declared.Name),
            FilterOperators.AllowedFor(declared.Type),
            declared.FilterUi,
            () => RequestDistinctValuesAsync(declared.Name),
            spec => _ = InvokeAsync(() => ApplyFilterSpecAsync(declared.Name, spec)),
            () => _ = InvokeAsync(() => ApplyFilterSpecAsync(declared.Name, null)),
            CloseFromChrome,
            _panelFocusRequest,
            declared.Format,
            InnerPopupChangedFromChrome,
            _panelFocusLastRequest,
            ValueListKeyFromChrome,
            _panelSearchRequest);
    }

    /// <summary>The one write path a filter change takes (ADR-0009): the column's spec
    /// replaced or removed in the whole Filter, columns combined with AND, and the
    /// Consumer notified — the grid never evaluates any of it.</summary>
    private async Task ApplyFilterSpecAsync(string column, FilterSpec? spec)
    {
        var columns = _filter is null
            ? new Dictionary<string, FilterSpec>(StringComparer.Ordinal)
            : new Dictionary<string, FilterSpec>(_filter.Columns, StringComparer.Ordinal);
        if (spec is null)
            columns.Remove(column);
        else
            columns[column] = spec;
        GridFilter? next = columns.Count == 0 && _filter?.Opaque is null
            ? null
            : new GridFilter(columns, _filter?.Opaque);

        ClosePopoverAndReturnFocus();
        if (Source is not null)
            Source.OnFilterChanged(next);
        else if (OnFilterChanged.HasDelegate)
            await OnFilterChanged.InvokeAsync(next);
        StateHasChanged();
    }

    /// <summary>The built-in panel's OK (ADR-0009): the working state becomes one
    /// FilterSpec — the checked values as an In clause, or the condition's one clause —
    /// and applies whole, by <see cref="FilterPanelChoices"/>' rules, which a substituted
    /// panel applies by too. Cancel discards.</summary>
    private Task ApplyPanelAsync(int column)
    {
        var declared = Columns[column];
        if (_panelValues is { IsTooMany: false } values && _panelChecked is { } chosen)
        {
            return ApplyFilterSpecAsync(declared.Name, FilterPanelChoices.FromValueList(
                values, chosen, v => PanelText(v, column), _panelSearch, _panelAddToCurrent, CurrentSpecOf(declared.Name)));
        }

        // Each condition's operand read as the column's type. Empty is an unfinished
        // condition, left out; text that does not read applies nothing, and the panel stands.
        if (!TryReadOperand(declared.Type, _panelOperator, _panelValueText, out var first))
            return Task.CompletedTask;
        object? second = null;
        if (_panelSecondOperator is { } secondOperator && !TryReadOperand(declared.Type, secondOperator, _panelSecondValueText, out second))
            return Task.CompletedTask;
        return ApplyFilterSpecAsync(declared.Name, FilterPanelChoices.FromConditions(
            _panelOperator, first, _panelCombinator, _panelSecondOperator, second));
    }

    /// <summary>Where a popover stands (ADR-0018/0040): under the header band, at the
    /// column's visible left edge, clamped inside the Viewport and bounded by its bottom —
    /// outside the scroll container, inside the grid's box, so nothing clips it and no
    /// instance shares it.</summary>
    private string PopoverStyle(int column)
    {
        var geometry = _columnStyles.Geometry;
        var (left, width) = PopoverAcross(column < geometry.PinnedCount
            ? geometry.OffsetPxOf(column)
            : geometry.OffsetPxOf(column) - _scrollLeftPx);
        // max-height keeps it inside the grid's box downwards, as PopoverAcross does across,
        // so no ancestor that shows the grid can cut it; taller contents scroll (ADR-0040).
        return FormattableString.Invariant(
            $"left: {left}px; top: {FormulaBarPx + BandHeightPx}px; {width}; max-height: {HeaderPopoverRoomPx}px");
    }

    /// <summary>A header popover's room: from under the header band to the Viewport's
    /// bottom (ADR-0040). Its style and the no-room close read this one number.</summary>
    private double HeaderPopoverRoomPx => Math.Max(0, _visibleHeightPx - BandHeightPx);

    /// <summary>The narrowest usable popover, and the widest any may grow — what the
    /// clamp keeps inside the grid and what the browser is told to lay out, from these
    /// numbers alone (ADR-0027/0040).</summary>
    private const double PopoverMinWidthPx = 200;

    private const double PopoverMaxWidthPx = 320;

    /// <summary>Whether the header cells carry a menu button: only where some command
    /// could reach a Consumer at all (ADR-0010), and never where the Consumer declared
    /// grips without the menu (ADR-0050, item 12).</summary>
    private bool ShowMenuButtons
        => !HideColumnMenu && (Source is not null || OnSortChanged.HasDelegate || OnFilterChanged.HasDelegate
            || OnColumnHidden.HasDelegate || OnPinnedCountChanged.HasDelegate
            || OnColumnWidthChanged.HasDelegate);

    private int CountPlaceholders()
    {
        if (_visible is not { } visible)
            return 0;
        if (_placeholderMode)
            return visible.Count;
        var count = 0;
        for (var row = visible.Start; row < visible.Start + visible.Count; row++)
        {
            var slice = row - _windowStart;
            if (slice < 0 || slice >= _window.Count)
                count++;
        }
        return count;
    }

    /// <summary>
    /// <c>aria-sort</c> for one header (ADR-0033): the applied direction on the sorted
    /// column, <c>none</c> on every other sortable one, and no attribute at all where a
    /// sort is refused (an Action Column). The visual indicator is painted from this
    /// same attribute in the stylesheet, so the two cannot disagree.
    /// </summary>
    private string? AriaSort(int column)
    {
        if (!Columns[column].IsQueryable)
            return null;
        // By index, not foreach: through the interface, foreach over a sort that is applied
        // allocates an enumerator, and this runs for every header cell on every render of
        // the root (PF-3).
        for (var s = 0; s < _sorts.Count; s++)
        {
            if (_sorts[s].Column == Columns[column].Name)
                return _sorts[s].Direction == SortDirection.Ascending ? "ascending" : "descending";
        }
        return "none";
    }

    private void SetDragging(bool dragging)
    {
        if (_dragging == dragging)
            return;
        _dragging = dragging;
        if (dragging)
            _dragHandler["onmousemove"] = _onMouseMove ??= OnMouseMove;
        else
        {
            _dragHandler.Remove("onmousemove");
            StopEdgeTimer();
            _pointDragging = false;
            // A fill drag ends with the drag, however it ends; a release outside the grid
            // is not seen, so it raises nothing rather than fill to a guessed cell.
            _fillSource = null;
            _fillPointer = null;
            // A message the Focus's timer would have opened mid-drag was refused
            // (ShowMessageAt); the button is up now, so the stillness starts again from
            // here — a press held longer than the delay still gets its message.
            if (_messageTarget is { } target && _messageCell is null)
                ScheduleMessage(target);
        }
        // The handler is markup, so adding or removing it has to reach the DOM whatever
        // the selection did — which is why every caller sets the suppression first and
        // lets this override it.
        _suppressRender = false;
    }

    private bool Apply(GridSelection next)
    {
        // Dragging within one cell raises an event per frame and changes nothing, so it
        // renders nothing. This is the only case the root skips a render for — the rows
        // below it do their own skipping (ADR-0003) — and the very next ShouldRender
        // consumes it.
        if (next.Equals(_selection.Selection))
        {
            _suppressRender = true;
            return false;
        }
        // An empty selection has no Focus to ask for (ADR-0012), and a selection being
        // dropped closes anything open anyway.
        var movedFocus = next.IsEmpty
            || _selection.Selection.IsEmpty
            || next.Focus != _selection.Selection.Focus;
        _selection = _selection.With(next);
        _selectionChanged = true;
        if (movedFocus)
            ScheduleMessage(next.IsEmpty ? null : next.Focus);
        return true;
    }

    /// <summary>
    /// The error popover follows the Focus after 300 ms of stillness (ADR-0034). Held
    /// arrows repeat far faster than that, so a run across a column of flagged cells
    /// opens nothing — the delay is what distinguishes looking at a cell from passing
    /// over it. Anything open closes at once, because it belongs to the cell that was
    /// left, not to the one being reached.
    /// </summary>
    /// <returns>Whether anything visible changed — a popover that was open is now shut.</returns>
    private bool ScheduleMessage(CellPosition? target)
    {
        var closed = _messageCell is not null;
        if (closed)
            CloseMessage();
        _messageTarget = target;
        if (CellMessageOf is null || target is null)
            return closed;
        _messageTimer ??= Time.CreateTimer(OnMessageSettled, null, Timeout.InfiniteTimeSpan, Timeout.InfiniteTimeSpan);
        _messageTimer.Change(PopoverDelay, Timeout.InfiniteTimeSpan);
        return closed;
    }

    private void OnMessageSettled(object? state)
    {
        _ = InvokeAsync(() =>
        {
            if (_disposed || _messageTarget is not { } target)
                return;
            ShowMessageAt(target);
        });
    }

    /// <summary>Ask for the message and open, or leave everything shut. The one call to
    /// <c>CellMessageOf</c>, here and nowhere else: never on the painting path (ED-17),
    /// and only once the cell has been settled on — whether by the Focus standing still
    /// or by the pointer coming to rest.</summary>
    private void ShowMessageAt(CellPosition target)
    {
        // Whichever path settled on the cell: under an editor the editor's own message
        // outranks it, and mid-drag a popover would take the mouse-up that ends the
        // drag — the rest path refuses both, and so does the Focus's timer.
        if (CellMessageOf is null || _editMode != EditMode.None || _dragging)
            return;
        var slice = target.Row - _windowStart;
        if (slice < 0 || slice >= _window.Count || target.Column >= Columns.Count)
            return;
        var message = CellMessageOf(_window[slice], Columns[target.Column]);
        if (string.IsNullOrEmpty(message))
            return;
        _messageCell = target;
        _messageText = message;
        StateHasChanged();
    }

    protected override bool ShouldRender()
    {
        var suppressed = _suppressRender;
        _suppressRender = false;
        return !suppressed;
    }

    private async Task RaiseActionAsync(GridActionEventArgs<TRow> args)
    {
        if (_disposed)
            return;
        // A press on any action ends Interactive (ADR-0037), by pointer as by Space — and
        // the pointer's press arrives through the row's handler, which renders the row but
        // not this root.
        if (EndInteractive())
        {
            _suppressRender = false;
            StateHasChanged();
        }
        // And nothing else: no focus is moved (ADR-0037, amended). A press never focused the
        // button, so the keyboard is still where it was — or in whatever the handler opened,
        // which taking it back to the root would rob.
        if (OnAction.HasDelegate)
            await OnAction.InvokeAsync(args);
    }

    /// <summary>
    /// What the browser says about the scroller's box, reported whenever it changes
    /// (ADR-0021): the Scrollbar Gutter — 0 on a platform with overlay scrollbars, and
    /// 0 anywhere until the content overflows — and the content box's own size, which
    /// under <see cref="ViewportSize.Stretch"/> is the size (ADR-0028). One notification
    /// carries both; the observer gained no new reason to exist and no new moment to
    /// fire.
    ///
    /// The frame between a change and this landing is painted from the old visible
    /// size: one frame of a slice that is one row too generous. That is accepted rather
    /// than pre-empted — the alternative is a layout read of our own before every
    /// paint, which is the round trip the whole geometry exists to avoid (ADR-0013).
    ///
    /// <para>Called by the grid's own script module and not for Consumers: it is public
    /// only because JavaScript interop requires it.</para>
    /// </summary>
    [JSInvokable]
    public async Task OnViewportReportAsync(
        double gutterWidthPx, double gutterHeightPx, double widthPx, double heightPx)
    {
        // Nothing here is trusted: it crosses the JS boundary, and a NaN would travel
        // silently into every offset the grid computes.
        if (_disposed
            || !double.IsFinite(gutterWidthPx) || !double.IsFinite(gutterHeightPx)
            || !double.IsFinite(widthPx) || !double.IsFinite(heightPx)
            || gutterWidthPx < 0 || gutterHeightPx < 0)
        {
            return;
        }
        // A report carrying no news renders nothing. The content box moves on every
        // frame of a window drag, but only a Stretch axis reads it — under a declared
        // size that half of the report is noise by design.
        var guttersChanged = gutterWidthPx != _gutterWidthPx || gutterHeightPx != _gutterHeightPx;
        var sizeChanged = (ViewportWidth.IsStretch && widthPx != _reportedWidthPx)
            || (ViewportHeight.IsStretch && heightPx != _reportedHeightPx);
        _reportedWidthPx = widthPx;
        _reportedHeightPx = heightPx;
        NameAParentWithNoHeight(heightPx);
        if (!guttersChanged && !sizeChanged)
            return;

        // A bar that appeared can have covered the Focus where it stands. Revealing is a
        // no-op when it is already whole on screen, so this costs nothing in the ordinary
        // case and keeps ADR-0012 true in the one that is not.
        // Only when nothing is already armed: a key's reveal may be waiting to run, and
        // it carries an intent this one does not have.
        var shrank = (gutterWidthPx > _gutterWidthPx || gutterHeightPx > _gutterHeightPx) && !_revealFocus;
        _gutterWidthPx = gutterWidthPx;
        _gutterHeightPx = gutterHeightPx;
        try
        {
            PrepareRender();
            _revealFocus = _revealFocus || shrank;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            // Not a UI event, so nothing else would surface this: an unusable Viewport
            // would be swallowed into the browser console and the grid would sit there
            // painting the old geometry.
            await DispatchExceptionAsync(ex);
        }
    }

    /// <summary>
    /// A Stretch-height grid whose parent has no definite height is as tall as its content,
    /// which before any row is painted is the header band alone — the exact signature
    /// (ADR-0028, "A parent with no height is named"). Named once, through the host's
    /// logger, until a real height arrives: a layout can pass through this state, so it is
    /// never thrown. A hidden tab reports 0 and is not this.
    /// </summary>
    private void NameAParentWithNoHeight(double heightPx)
    {
        if (!ViewportHeight.IsStretch)
            return;
        if (heightPx > BandHeightPx + 0.5)
        {
            _namedParentWithNoHeight = false;
            return;
        }
        if (_namedParentWithNoHeight || heightPx < BandHeightPx - 0.5)
            return;
        _namedParentWithNoHeight = true;
        var logger = (Services.GetService(typeof(ILoggerFactory)) as ILoggerFactory)?.CreateLogger("ExGrid.Components.ExGrid");
        logger?.LogWarning(
            "ExGrid: ViewportHeight is Stretch, but the grid's parent gives it no height, so it is only as tall as its header " +
            "and no row can be painted. Give the parent a definite height: pixels, a percentage of something definite, " +
            "a grid track, or a flex item with min-height: 0 (ADR-0028).");
    }

    private bool _namedParentWithNoHeight;

    /// <summary>
    /// The <c>copy</c> event's synchronous question (ADR-0005): refused, in hand, or
    /// beyond the Window. Refusals are decided by the pure rules and raised through
    /// <see cref="OnCopyRefused"/>; the payload is assembled from the Window when every
    /// selected row is in it, which is the overwhelming majority of copies.
    ///
    /// <para>Called by the grid's own script module and not for Consumers: it is public
    /// only because JavaScript interop requires it.</para>
    /// </summary>
    [JSInvokable]
    public ClipboardPayload BuildCopyPayload()
    {
        if (_disposed)
            return ClipboardPayload.None;

        var decision = ClipboardRules.PlanCopy(_selection.Selection, CopyCellCap);
        if (decision.IsRefused)
        {
            NotifyCopyRefused(decision.Reason);
            return ClipboardPayload.None;
        }
        if (CopyAnswer is not null)
            return AskCopyAnswer(decision.Plan, withHeaders: false) ?? ClipboardPayload.None;
        if (!WindowCovers(decision.Plan))
        {
            // The async route needs somebody to ask. Without one, refuse by name
            // rather than copy the fraction in hand (ADR-0005).
            if (Source is null && OnCopyRowsNeeded is null)
            {
                NotifyCopyRefused(CopyRefusalReason.RowsUnavailable);
                return ClipboardPayload.None;
            }
            return ClipboardPayload.Async;
        }

        var (text, html) = ClipboardData.Assemble(
            decision.Plan,
            (row, column) => ExGridRow<TRow>.CellText(Columns[column], _window[row - _windowStart]),
            (row, column) => RawText(Columns[column], _window[row - _windowStart]));
        return ClipboardPayload.Data(text, html);
    }

    /// <summary>
    /// The asynchronous copy route (ADR-0005): the selection runs beyond the Window, so
    /// the rows are gathered — from the Source, or from the push Consumer's provider —
    /// assembled, handed to the clipboard, and stored nowhere. Null aborts the write
    /// and the clipboard stays as it was.
    ///
    /// Also the only route a menu copy has, whatever the selection's size: clicking a
    /// menu item fires no <c>copy</c> event (ADR-0036).
    ///
    /// <para>Called by the grid's own script module and not for Consumers: it is public
    /// only because JavaScript interop requires it.</para>
    /// </summary>
    /// <param name="withHeaders">Emit the declared headers as one row above the block,
    /// counted against the cap (ADR-0005).</param>
    [JSInvokable]
    public async Task<ClipboardPayload?> BuildCopyPayloadAsync(bool withHeaders = false)
    {
        if (_disposed)
            return null;
        // ADR-0050 item 13: a grid that does not offer copy with headers refuses one asked
        // for, rather than quietly writing the block without them.
        if (withHeaders && HideCopyWithHeaders)
            return null;

        // Decided again rather than remembered from the synchronous half: the answer
        // must be about the selection as it stands now, not as it stood one event ago.
        var decision = ClipboardRules.PlanCopy(_selection.Selection, CopyCellCap, withHeaders);
        if (decision.IsRefused)
        {
            NotifyCopyRefused(decision.Reason);
            return null;
        }
        if (CopyAnswer is not null)
            return AskCopyAnswer(decision.Plan, withHeaders);

        var rows = await GatherRowsAsync(decision.Plan);
        if (_disposed)
            return null;
        if (rows is null)
        {
            NotifyCopyRefused(CopyRefusalReason.RowsUnavailable);
            return null;
        }

        var (text, html) = ClipboardData.Assemble(
            decision.Plan,
            (row, column) => ExGridRow<TRow>.CellText(Columns[column], rows[row]),
            (row, column) => RawText(Columns[column], rows[row]),
            withHeaders ? column => Columns[column].Header : null);
        return ClipboardPayload.Data(text, html);
    }

    /// <summary>
    /// The <c>paste</c> event's two flavours, as streams (ADR-0005): a paste handed over
    /// as strings is one interop message, and on Blazor Server a message past the hub's
    /// receive limit (32 KB by default) ends the circuit. Past <see cref="PasteByteCap"/>
    /// the paste is refused whole and neither stream is opened. The references are the
    /// JS side's to release, and are released here either way.
    ///
    /// <para>Called by the grid's own script module and not for Consumers: it is public
    /// only because JavaScript interop requires it.</para>
    /// </summary>
    [JSInvokable]
    public async Task OnPasteStreamsAsync(IJSStreamReference? text, IJSStreamReference? html)
    {
        await using var textReference = text;
        await using var htmlReference = html;
        if (_disposed)
            return;

        if ((text?.Length ?? 0) + (html?.Length ?? 0) > PasteByteCap)
        {
            if (OnPasteRefused.HasDelegate)
                await OnPasteRefused.InvokeAsync(PasteRefusalReason.TooLarge);
            return;
        }
        await OnPasteAsync(await ReadAsync(text), await ReadAsync(html));

        static async Task<string?> ReadAsync(IJSStreamReference? reference)
        {
            if (reference is null)
                return null;
            await using var stream = await reference.OpenReadStreamAsync(maxAllowedSize: reference.Length);
            using var reader = new StreamReader(stream, System.Text.Encoding.UTF8);
            return await reader.ReadToEndAsync();
        }
    }

    /// <summary>
    /// The <c>paste</c> event's block, both flavours in hand (ADR-0005/0014). Nothing
    /// tabular consults no rule; a refusal says which rule it hit; an approval is one Edit
    /// Intent carrying every cell (ADR-0007). The browser reaches it through
    /// <see cref="OnPasteStreamsAsync"/>, never directly.
    ///
    /// <para>Not for Consumers: it is public because it was the interop entry point before
    /// the paste crossed as streams, and the component tests drive it directly.</para>
    /// </summary>
    public async Task OnPasteAsync(string? text, string? html)
    {
        if (_disposed)
            return;

        var parsed = ClipboardParse.ParseBlock(html, text);
        if (parsed is null)
            return;
        var block = parsed.Values;

        var target = _selection.Selection;
        var extent = Extent;
        var decision = ClipboardRules.PlanPaste(
            target, new PasteShape(block.Count, block[0].Count), ColumnIsEditable,
            PasteMaySpill ? extent : null, plainTextOnly: !parsed.IsFromTable);
        if (decision.IsRefused)
        {
            if (OnPasteRefused.HasDelegate)
                await OnPasteRefused.InvokeAsync(decision.Reason);
            return;
        }
        var version = _sequenceVersion;
        var intent = new GridPasteIntent(decision.Plan, block, version, parsed.Origins);
        if (OnPaste.HasDelegate)
            await OnPaste.InvokeAsync(intent);
        // A refused paste wrote nothing: the Selection stays where it was (ADR-0050, item 3).
        if (intent.IsRefused)
            return;
        if (decision.Plan.CollapsesSelection)
            SelectPastedCell(decision.Plan, version);
        else if (PasteMaySpill)
            SelectSpilledBlock(target, decision.Plan, version);
    }

    /// <summary>
    /// After one value of plain text went into one cell of a larger Selection, and the Consumer
    /// did not refuse it, the Selection collapses to that cell, with the Focus on it (ADR-0014,
    /// amended 2026-09-29). Reported as every other Selection change is. As for a spill, a
    /// position means something only under the order it was written in: if the Consumer's
    /// handling moved the Row Sequence Version, or took the cell away, nothing is placed
    /// (ADR-0011).
    /// </summary>
    private void SelectPastedCell(PastePlan plan, int version)
    {
        if (_disposed || version != _sequenceVersion)
            return;
        var cell = plan.Targets[0];
        var extent = Extent;
        if (cell.BottomRow >= extent.RowCount || cell.RightColumn >= extent.ColumnCount)
            return;
        if (Apply(_selection.Selection.Place(cell, new CellPosition(cell.TopRow, cell.LeftColumn), extent)))
        {
            _suppressRender = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// After a spilled paste the Consumer did not refuse, the block is the Selection, with the
    /// Focus at its top-left, and nothing scrolls to show it (ADR-0050, item 3; ADR-0052). Only for a spill — a paste into a selected range
    /// already has the target selected. Positions mean something only under the order they
    /// were written in: if the Consumer's handling of the intent moved the Row Sequence
    /// Version, or took the block's cells away, nothing is placed (ADR-0011).
    /// </summary>
    private void SelectSpilledBlock(GridSelection target, PastePlan plan, int version)
    {
        if (_disposed || plan.Targets.Count != 1 || target.Ranges.Count != 1)
            return;
        var block = plan.Targets[0];
        if (block == target.Ranges[0] || version != _sequenceVersion)
            return;
        var extent = Extent;
        if (block.BottomRow >= extent.RowCount || block.RightColumn >= extent.ColumnCount)
            return;
        if (Apply(_selection.Selection.Place(block, new CellPosition(block.TopRow, block.LeftColumn), extent)))
        {
            _suppressRender = false;
            StateHasChanged();
        }
    }

    /// <summary>Whether every row the plan touches is in the Window — the test that
    /// chooses between the two clipboard routes (ADR-0005).</summary>
    private bool WindowCovers(CopyPlan plan)
    {
        foreach (var segment in plan.Segments)
        {
            if (segment.TopRow < _windowStart || segment.BottomRow >= _windowStart + _window.Count)
                return false;
        }
        return true;
    }

    /// <summary>
    /// The rows the plan needs, keyed by absolute position: from the Window where the
    /// Window has them, otherwise asked for (ADR-0005). Null when nobody can answer or
    /// an answer came back short — a partial block is never emitted.
    /// </summary>
    private async Task<Dictionary<int, TRow>?> GatherRowsAsync(CopyPlan plan)
    {
        var rows = new Dictionary<int, TRow>();
        foreach (var segment in plan.Segments)
        {
            var range = new RowRange(segment.TopRow, segment.RowCount);
            var answered = await GatherRangeAsync(range);
            if (answered is null)
                return null;
            for (var i = 0; i < range.Count; i++)
                rows[range.Start + i] = answered[i];
        }
        return rows;
    }

    /// <summary>One run of rows, in order: from the Window where it has them all,
    /// otherwise asked for (ADR-0005). Null when nobody can answer, the grid went away, or
    /// an answer came back short.</summary>
    private async Task<IReadOnlyList<TRow>?> GatherRangeAsync(RowRange range)
    {
        if (range.Start >= _windowStart && range.Start + range.Count <= _windowStart + _window.Count)
        {
            var rows = new TRow[range.Count];
            for (var i = 0; i < range.Count; i++)
                rows[i] = _window[range.Start - _windowStart + i];
            return rows;
        }

        IReadOnlyList<TRow> answered;
        if (Source is not null)
            answered = await Source.GetRowsAsync(range, CancellationToken.None);
        else if (OnCopyRowsNeeded is not null)
            answered = await OnCopyRowsNeeded(range, CancellationToken.None);
        else
            return null;
        if (_disposed || answered is null || answered.Count < range.Count)
            return null;
        return answered;
    }

    /// <summary>The raw, locale-free form for <c>text/html</c> (ADR-0005): full
    /// precision for a number, ISO for a date, TRUE/FALSE for a boolean — never the
    /// displayed format, whose separators are a locale trap.</summary>
    private static string RawText(GridColumn<TRow> column, TRow row)
    {
        var value = column.Value(row);
        return value switch
        {
            null => "",
            bool b => b ? "TRUE" : "FALSE",
            DateTime d => d.ToString("s", CultureInfo.InvariantCulture),
            DateTimeOffset d => d.ToString("yyyy-MM-dd'T'HH:mm:sszzz", CultureInfo.InvariantCulture),
            DateOnly d => d.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
            TimeOnly t => t.ToString("HH:mm:ss", CultureInfo.InvariantCulture),
            IFormattable f => f.ToString(null, CultureInfo.InvariantCulture),
            _ => value.ToString() ?? "",
        };
    }

    /// <summary>
    /// The declared copy answer, asked with the approved plan (ADR-0050, item 9): the two
    /// flavours it returns, exactly as given, or null when it refused — the clipboard stays
    /// untouched, the Consumer's sentence is announced, and the refusal is raised by name.
    /// </summary>
    private ClipboardPayload? AskCopyAnswer(CopyPlan plan, bool withHeaders)
    {
        var answer = CopyAnswer!(new GridCopyRequest(plan, withHeaders, _sequenceVersion));
        if (answer is null)
            throw new InvalidOperationException(
                "CopyAnswer returned null. Answer GridCopyAnswer.Write with both flavours, or GridCopyAnswer.Refuse " +
                "with a sentence; a copy that is neither would leave the user guessing what landed (ADR-0005).");
        if (!answer.IsRefused)
            return ClipboardPayload.Data(answer.Text!, answer.Html!);
        NotifyCopyRefused(CopyRefusalReason.RefusedByConsumer, answer.Sentence);
        return null;
    }

    /// <summary>Raised off the synchronous copy path: the event handler cannot await,
    /// and the refusal must still reach the Consumer (ADR-0005: say which one).</summary>
    private void NotifyCopyRefused(CopyRefusalReason reason, string? sentence = null)
    {
        if (_disposed)
            return;
        if (sentence is not null)
        {
            // The Consumer's own sentence, relayed as a verdict's is (ADR-0034/0036): a
            // copy that landed nothing and said nothing is the silence ADR-0005 refuses.
            _ = InvokeAsync(() =>
            {
                if (_disposed)
                    return;
                Announce(sentence);
                _suppressRender = false;
                StateHasChanged();
            });
        }
        if (!OnCopyRefused.HasDelegate)
            return;
        _ = InvokeAsync(() => OnCopyRefused.InvokeAsync(reason));
    }

    /// <summary>
    /// The synchronous-channel probe: called once at attach, synchronously. Where the
    /// call cannot be made that way (a server circuit), the copy path knows to take the
    /// async route from the start — so a later synchronous failure is a failure to be
    /// reported, never mistaken for a missing channel (ADR-0005/0017).
    ///
    /// <para>Called by the grid's own script module and not for Consumers: it is public
    /// only because JavaScript interop requires it.</para>
    /// </summary>
    [JSInvokable]
    public bool Ping() => true;

    /// <summary>
    /// The browser rejected the asynchronous clipboard write (ADR-0005): nothing landed.
    /// Called by the instance's own clipboard wiring, which knows it only once the write
    /// has failed — so it is a Refusal raised after the fact, with its own reason.
    /// </summary>
    [JSInvokable]
    public Task OnCopyWriteRejectedAsync()
    {
        NotifyCopyRefused(CopyRefusalReason.ClipboardUnavailable);
        return Task.CompletedTask;
    }

    /// <summary>
    /// A key the core claimed (ADR-0010). Called from the instance's own capture-phase
    /// listener, so a grid without focus never gets here, and two grids on one page never
    /// hear each other's keys (ADR-0018). The listener has already prevented the default:
    /// what is left is to say what the key meant.
    ///
    /// <para>Called by the grid's own script module and not for Consumers: it is public
    /// only because JavaScript interop requires it.</para>
    /// </summary>
    [JSInvokable]
    public async Task OnKeyAsync(
        string key, bool ctrl, bool shift, bool alt, bool meta, bool metaIsPrimary,
        bool fromDescendant = false, string? editorText = null, int editorCaret = -1)
    {
        if (_disposed)
            return;
        // While editing, the keys the gate forwarded are the editor's contract
        // (ADR-0010): always Esc / Enter / Tab / F2, plus the arrows in Overwrite. The key
        // carries the editor's text and caret as the browser had them (ADR-0051), and what
        // it means is decided from those.
        if (_editMode != EditMode.None)
        {
            AdoptKeyText(editorText, editorCaret);
            await OnEditingKeyAsync(GridKeys.Canonical(key, ctrl, shift, alt, meta, metaIsPrimary));
            return;
        }

        var action = GridKeys.Resolve(key, ctrl, shift, alt, meta, metaIsPrimary);

        // Inside a cell with several actions (ADR-0037) the keyboard never left the root,
        // so every key arrives here as it always does. The arrows, Home and End choose
        // within the cell; Space and Escape are answered below; every other key leaves the
        // cell first and then keeps the meaning it has everywhere else — Enter and Tab
        // included, which is why nothing ever fires on them (ADR-0020).
        if (InteractiveChoice() is { } choice)
        {
            if (ChoiceAfter(choice, action) is { } chosen)
            {
                // Clamped: a key that would step past either end chooses nothing new and
                // renders nothing, rather than leaving the cell by overshoot.
                if (chosen != choice.Action)
                {
                    _interactive = (choice.Cell, chosen);
                    _suppressRender = false;
                    StateHasChanged();
                }
                return;
            }
            if (action.Kind is not (GridKeyKind.Engage or GridKeyKind.Leave) && EndInteractive())
            {
                // A key arrives through interop, so nothing renders unless this says so —
                // and the key's own handling may move nothing at all (ArrowUp at the top),
                // which would leave the chosen button painted for a mode that has ended.
                _suppressRender = false;
                StateHasChanged();
            }
        }

        switch (action.Kind)
        {
            case GridKeyKind.None:
                // F2 and a printable character open the Cell Editor (ADR-0010) — the
                // gate forwarded them; whether this cell edits is decided here.
                await TryStartEditingAsync(key, ctrl, alt, meta, metaIsPrimary);
                return;
            case GridKeyKind.OpenContextMenu:
                OpenContextMenuAtFocus();
                // A key arrives through interop, so nothing renders unless this says so —
                // the pointer's path is a Blazor DOM event and renders on its own.
                StateHasChanged();
                return;
            case GridKeyKind.OpenColumnMenu:
                await OpenColumnMenuFromKeyAsync();
                StateHasChanged();
                return;
            case GridKeyKind.Undo:
                // Forwarded and nothing else (ADR-0007): taken only while the Consumer listens,
                // and only while no edit is open — an edit is answered above. The history and
                // what the screen shows afterwards are the Consumer's, and arrive as new row
                // instances.
                if (OnUndo.HasDelegate)
                    await OnUndo.InvokeAsync();
                return;
            case GridKeyKind.Redo:
                if (OnRedo.HasDelegate)
                    await OnRedo.InvokeAsync();
                return;
            case GridKeyKind.Find:
                await OpenFindAsync();
                StateHasChanged();
                return;
            case GridKeyKind.ClearAndEdit:
                // Backspace: an editor entry like a printable key, minus the character
                // (ADR-0035) — judged where every entry is, on the Focus.
                await TryStartEditingAsync(EditMode.Overwrite, "");
                return;
            case GridKeyKind.Clear:
            case GridKeyKind.FillDown:
            case GridKeyKind.FillRight:
                // With no Focus these name nothing yet: the key only places one, the
                // first-key rule (ADR-0012), on the general path below.
                if (_selection.Selection.IsEmpty)
                    break;
                if (action.Kind == GridKeyKind.Clear)
                    await RaiseClearIntentAsync();
                else
                    await FillFromKeyAsync(action.Kind == GridKeyKind.FillDown ? GridDirection.Down : GridDirection.Right);
                return;
            case GridKeyKind.Leave:
                // Escape peels the outermost layer first: an open popover closes and
                // the grid keeps the keyboard — one press, one dismissal. Only with
                // nothing left to dismiss is it the way out of Enter/Tab cycling
                // (ADR-0012), releasing the grid's DOM focus.
                if (AnyPopoverOpen)
                {
                    // The keyboard comes back after the render that removes the popover,
                    // never before it: a control inside it can still answer this Escape
                    // for itself while the grid waits — a MudSelect puts DOM focus back
                    // on itself — and removing the popover then would leave focus on the
                    // page's body (KB-32, ADR-0039).
                    if (fromDescendant)
                        ClosePopoverAndReturnFocus();
                    else
                        CloseMenus();
                    StateHasChanged();
                    return;
                }
                if (fromDescendant)
                {
                    // From a focusable descendant — a Consumer's Template Column
                    // control, an action button — Escape is the way out of the cell,
                    // not of the grid (ADR-0020): the keyboard returns to the grid
                    // and navigation resumes. Returning from a control is leaving a
                    // cell, so an Interactive one the pointer walked away from ends too.
                    EndInteractive();
                    // Escape in the Name Box abandons what was typed there (ADR-0051), and
                    // leaves it: the hand-back takes the keyboard from the field (ADR-0021).
                    _nameBoxText = null;
                    await ReclaimFocusAsync(fromField: true);
                    StateHasChanged();
                    return;
                }
                // The Interactive layer, between the popover and the grid (ADR-0037,
                // ADR-0012's layering): Escape leaves the cell, the Focus stays where it
                // is, and the grid keeps the keyboard. Only with nothing engaged is it
                // the way out.
                if (EndInteractive())
                {
                    _suppressRender = false;
                    StateHasChanged();
                    return;
                }
                await LeaveAsync();
                return;
            case GridKeyKind.Engage:
                // With no Focus, Space is a first key like any other: it only places the
                // Focus (ADR-0012), and never fires or enters a cell the user has not
                // seen focused (ADR-0037). The general path below does the placing.
                if (_selection.Selection.IsEmpty)
                    break;
                await EngageAsync();
                return;
        }

        var extent = Extent;
        if (extent.RowCount <= 0 || extent.ColumnCount <= 0)
            return;

        var current = _selection.Selection;
        var fromEmpty = current.IsEmpty;
        if (fromEmpty)
        {
            // GridSelection has no Focus to move from, deliberately. Where a keyboard
            // user starts is a question about the view, not about the selection model,
            // so it is answered here: the first cell on screen, without moving the
            // Viewport. Reached by tabbing in, by clicking the header — and above all
            // after a sort, which drops the selection (ADR-0011) and would otherwise
            // leave every key dead until the user picked up the mouse again.
            if (FirstVisibleCell() is not { } start)
                return;
            current = current.Click(start, extent);
        }

        // Ctrl+Backspace scrolls the Focus into view and changes nothing else (ADR-0052). From
        // no Focus it places one, as any first key does, and reveals that.
        if (action.Kind == GridKeyKind.RevealFocus)
        {
            if (fromEmpty)
                Apply(current);
            if (PageSize is { } focusPageSize && current.Focus.Row / focusPageSize != _pageIndex)
            {
                _pageIndex = current.Focus.Row / focusPageSize;
                PrepareRender();
            }
            _revealRowStart = false;
            _revealStepRows = 0;
            _revealFocus = true;
            _suppressRender = false;
            StateHasChanged();
            return;
        }

        // A key that moves the Focus, pressed when there is no Focus, only places one —
        // it does not also take its step. This is what every list does: the first Down
        // selects the first item rather than the second, and the selection appears where
        // the user is looking. A key that names a whole region (Ctrl+A, the Space pair,
        // Ctrl+Home) needs no starting point and still does what it says.
        var movesTheFocus = action.Kind
            is GridKeyKind.Move or GridKeyKind.Extend
            or GridKeyKind.MoveToEdge or GridKeyKind.ExtendToEdge or GridKeyKind.Cycle
            or GridKeyKind.MoveByViewport or GridKeyKind.ExtendByViewport;
        var next = fromEmpty && movesTheFocus ? current : action.Kind switch
        {
            GridKeyKind.Move => current.Move(action.Direction, extent),
            GridKeyKind.Extend => current.Extend(action.Direction, extent),
            // The Consumer's edge answer is asked on the arrows only (ADR-0050, item 2):
            // Home and End resolve to the same transitions and keep ADR-0012's meaning.
            GridKeyKind.MoveToEdge => current.MoveToEdge(action.Direction, extent, EdgeAnswerFor(key)),
            GridKeyKind.ExtendToEdge => current.ExtendToEdge(action.Direction, extent, EdgeAnswerFor(key)),
            GridKeyKind.Cycle => current.CycleFocus(action.Order, action.Backward, extent),
            GridKeyKind.SelectAll => SelectAllInContext(current, extent),
            GridKeyKind.SelectWholeColumns => current.SelectWholeColumns(extent),
            GridKeyKind.SelectWholeRows => current.SelectWholeRows(extent),
            GridKeyKind.MoveToCorner => current.Click(
                action.Backward
                    ? new CellPosition(0, 0)
                    : new CellPosition(extent.RowCount - 1, extent.ColumnCount - 1),
                extent),
            GridKeyKind.MoveByViewport => current.MoveByViewport(SignedViewportRows(action.Direction), extent),
            GridKeyKind.ExtendByViewport => current.ExtendByViewport(SignedViewportRows(action.Direction), extent),
            GridKeyKind.MoveFocusToNextCorner => current.MoveFocusToNextCorner(extent),
            GridKeyKind.CollapseToFocus => current.CollapseToFocus(extent),
            _ => current,
        };

        // Only when something moved. A transition that changed nothing — ArrowUp at the
        // first row, Home at the first column — suppresses the render, and a reveal armed
        // for a render that never happens fires on whatever renders next: a wheel scroll
        // five hundred rows away would be yanked back to the Focus mid-gesture.
        if (!Apply(next))
        {
            // Apply arms the suppression for the render Blazor runs automatically after a
            // UI event. This is a [JSInvokable]: no such render follows, so an armed flag
            // would sit here and swallow whatever renders NEXT — the following keystroke,
            // a Source's answer landing, the settle timer putting real cells back. The
            // grid would look frozen for one beat, with nothing queued to unfreeze it.
            _suppressRender = false;
            return;
        }
        // While extending, the grid keeps the Extent in view, not the Focus, which stays
        // where the extension started and may be left off screen (ADR-0052). Every other key
        // moves the Focus, and the Focus is what has to end up on screen (ADR-0012).
        var revealed = Extends(action) ? next.Extent : next.Focus;
        _revealTarget = Extends(action) ? revealed : null;
        // The keyboard crosses pages; dragging does not (ADR-0015): a cell the keystroke
        // carried past the page boundary turns the page, and the reveal then positions it
        // inside the new one.
        if (PageSize is { } pageSize && revealed.Row / pageSize != _pageIndex)
        {
            _pageIndex = revealed.Row / pageSize;
            PrepareRender();
        }

        // Measured after the render against the geometry that was actually painted.
        _revealRowStart = NamesTheStartOfTheRow(action);
        // PageUp / PageDown move the Viewport by the same rows the Focus moved, so the
        // Focus keeps its position on screen (ADR-0012). Everywhere else the scroll is a
        // reveal, so the step stays zero — and so does the press that only placed the
        // Focus, which moves nothing by design.
        _revealStepRows = !fromEmpty
            && action.Kind is GridKeyKind.MoveByViewport or GridKeyKind.ExtendByViewport
            ? SignedViewportRows(action.Direction)
            : 0;
        _revealFocus = true;
        StateHasChanged();
    }

    /// <summary>Whether a key extends a range — moves its Extent while the Focus stays
    /// (ADR-0052).</summary>
    private static bool Extends(GridKeyAction action)
        => action.Kind is GridKeyKind.Extend or GridKeyKind.ExtendToEdge or GridKeyKind.ExtendByViewport;

    /// <summary>The Consumer's edge answer for this key, or null: only an arrow asks it
    /// (ADR-0050, item 2).</summary>
    private Func<CellPosition, GridDirection, CellPosition>? EdgeAnswerFor(string key)
        => DataEdge is not null && key.StartsWith("Arrow", StringComparison.Ordinal) ? DataEdge : null;

    /// <summary>
    /// How far PageUp / PageDown move, as a signed row count: the rows fully visible in
    /// what the header band and the Scrollbar Gutter leave (ADR-0012) — the geometry's
    /// height is already both of those subtractions. At least one, so a Viewport shorter
    /// than a row still moves.
    /// </summary>
    private int SignedViewportRows(GridDirection direction)
    {
        var rows = Math.Max(1, (int)Math.Floor(_geometry.ViewportHeightPx / _metrics.RowHeightPx));
        return direction == GridDirection.Up ? -rows : rows;
    }

    /// <summary>
    /// Whether a key means "go to the beginning" rather than "move one step" — Home and
    /// Ctrl+Left for the row, Ctrl+Home for the whole result, with their Shift forms.
    /// The horizontal direction is what is asked: Ctrl+Up and Ctrl+Down are the same
    /// transition on the other axis and name no column at all.
    /// </summary>
    private static bool NamesTheStartOfTheRow(GridKeyAction action) => action.Kind switch
    {
        GridKeyKind.MoveToEdge or GridKeyKind.ExtendToEdge => action.Direction == GridDirection.Left,
        GridKeyKind.MoveToCorner => action.Backward,
        _ => false,
    };

    /// <summary>
    /// The Consumer asks the grid to place the Selection and the Focus (ADR-0050, item 4):
    /// <paramref name="range"/> becomes the one range, with the Focus on
    /// <paramref name="focus"/> inside it. The grid then does what it does after a click: an
    /// open edit commits first, the Focus is scrolled into view, and the new extent is
    /// announced once it settles (ADR-0033). The Selection stays the grid's — the Consumer
    /// asks and the grid places — and positions only mean something under the order they
    /// were written in: a request made under a <paramref name="rowSequenceVersion"/> other
    /// than the grid's is dropped, and changes nothing (ADR-0011).
    /// </summary>
    /// <returns>Whether the placement was made: false when it was dropped as stale, or when
    /// a Reject held an open edit (ADR-0034).</returns>
    /// <exception cref="ArgumentOutOfRangeException">The range reaches outside the grid, or
    /// the Focus lies outside the range.</exception>
    public async Task<bool> PlaceSelectionAsync(SelectionRange range, CellPosition focus, int rowSequenceVersion)
    {
        // On the renderer's own context: a Consumer resolving a Name Box entry is on it
        // already, and one answering from elsewhere must not race a render.
        var placed = false;
        await InvokeAsync(async () => placed = await PlaceOnRendererAsync(range, focus, rowSequenceVersion));
        return placed;
    }

    private async Task<bool> PlaceOnRendererAsync(SelectionRange range, CellPosition focus, int rowSequenceVersion)
    {
        if (_disposed || rowSequenceVersion != _sequenceVersion)
            return false;
        // Validated before anything changes: a refused request commits nothing.
        _ = _selection.Selection.Place(range, focus, Extent);
        if (_editMode != EditMode.None && !await CommitEditAsync())
        {
            _suppressRender = false;
            StateHasChanged();
            return false;
        }
        if (_menuColumn >= 0 || _contextCell is not null)
            CloseMenus();
        EndInteractive();
        // The version can have moved while the commit's intent was handled.
        if (rowSequenceVersion != _sequenceVersion)
        {
            _suppressRender = false;
            StateHasChanged();
            return false;
        }
        if (PageSize is { } pageSize && focus.Row / pageSize != _pageIndex)
        {
            _pageIndex = focus.Row / pageSize;
            PrepareRender();
        }
        if (Apply(_selection.Selection.Place(range, focus, Extent)))
            RequestFocusReveal();
        _suppressRender = false;
        StateHasChanged();
        return true;
    }

    /// <summary>
    /// The focused cell's full value — the formula-bar role behind <c>####</c>
    /// (ADR-0016): the raw value, never the hashes, and null when there is no Focus or
    /// its row is not in hand. Producing the value is the core's; painting it is
    /// Chrome's (ADR-0010).
    /// </summary>
    public object? GetFocusedValue()
    {
        if (_selection.Selection.IsEmpty)
            return null;
        var focus = _selection.Selection.Focus;
        if (focus.Column < 0 || focus.Column >= Columns.Count)
            return null;
        var slice = focus.Row - _windowStart;
        if (slice < 0 || slice >= _window.Count)
            return null;
        return Columns[focus.Column].Value(_window[slice]);
    }

    /// <summary>What decides this grid's conditional key claims (ADR-0007/0010/0054/0055).</summary>
    private GridKeyClaims KeyClaims()
        => new(AnyColumnEdits(), OnUndo.HasDelegate, OnRedo.HasDelegate, CanFind());

    /// <summary>Whether anything can answer a Find (ADR-0055): the push-mode delegate, or a
    /// bound Source that says it can — never both, which is refused by name.</summary>
    private bool CanFind() => OnFind is not null || (Source?.CanFind ?? false);

    /// <summary>
    /// Ctrl+F (ADR-0055): the find panel, taking the keyboard as every popover does
    /// (ADR-0039) — or, where nothing can search, a refusal and nothing opened, because the
    /// browser's own find would look complete and see only the painted rows.
    /// </summary>
    private async Task OpenFindAsync()
    {
        if (!CanFind())
        {
            if (OnFindRefused.HasDelegate)
                await OnFindRefused.InvokeAsync(FindRefusalReason.Unavailable);
            return;
        }
        CloseMenus();
        _findOpen = true;
        _findOutcome = FindOutcome.None;
        BeginPopoverFocus();
        _findFocusRequest++;
        _popoverFocusPending = PopoverFocus.FindField;
    }

    /// <summary>
    /// One Find step (ADR-0055): asked of the Source or the push-mode delegate, with the
    /// Focus to start from, the selection as the scope when it is more than one cell, the
    /// visible columns in their current order and the version they were read in. An answer
    /// under another version moves nothing; a found cell becomes the Focus and is revealed.
    /// </summary>
    private async Task FindStepAsync(bool backward)
    {
        if (!_findOpen || _findText.Length == 0 || !CanFind())
            return;
        _findCancellation?.Cancel();
        var cancellation = _findCancellation = new CancellationTokenSource();

        var selection = _selection.Selection;
        var names = new string[Columns.Count];
        for (var i = 0; i < Columns.Count; i++)
            names[i] = Columns[i].Name;
        var request = new GridFindRequest
        {
            Text = _findText,
            MatchCase = _findMatchCase,
            WholeCell = _findWholeCell,
            Backward = backward,
            From = selection.IsEmpty ? null : selection.Focus,
            Scope = !selection.IsEmpty && selection.CellCount > 1 ? selection.Ranges : null,
            Columns = names,
            RowSequenceVersion = _sequenceVersion,
        };

        GridFindResult answer;
        try
        {
            answer = OnFind is { } find
                ? await find(request, cancellation.Token)
                : await Source!.FindAsync(request, cancellation.Token);
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested)
        {
            return;
        }
        // Superseded by a later step, or the panel closed while the question was out: the
        // answer is somebody else's now, and is discarded (ADR-0025's rule).
        if (_disposed || cancellation.IsCancellationRequested || !ReferenceEquals(cancellation, _findCancellation))
            return;
        _findCancellation = null;

        // The order moved while the question was out: the answer, found or not, is about
        // positions that no longer stand (ADR-0011).
        if (request.RowSequenceVersion != _sequenceVersion)
        {
            await RefuseFindAsync(FindRefusalReason.OrderChanged);
            return;
        }
        if (!answer.IsFound)
        {
            await RefuseFindAsync(FindRefusalReason.NotFound);
            return;
        }
        // An answer outside the question is the Consumer's defect, named rather than reworded
        // as a reorder (ADR-0055, 2026-09-27): a column it was not asked about, or a row the
        // result does not have.
        var extent = Extent;
        if (answer.Column is not { } answered || !request.Columns.Contains(answered)
            || answer.Row >= extent.RowCount)
        {
            throw new InvalidOperationException(FormattableString.Invariant(
                $"ExGrid: the Find answer (row {answer.Row}, column '{answer.Column}') is outside the request: it asked about the columns [{string.Join(", ", request.Columns)}] of a result of {extent.RowCount} rows (ADR-0055)."));
        }
        // A column the request named that has since left the grid: the visible columns moved
        // while the step was out, which is OrderChanged's other half.
        var column = -1;
        for (var i = 0; i < Columns.Count; i++)
        {
            if (Columns[i].Name == answered)
            {
                column = i;
                break;
            }
        }
        if (column < 0)
        {
            await RefuseFindAsync(FindRefusalReason.OrderChanged);
            return;
        }

        _findOutcome = FindOutcome.Found;
        var found = new CellPosition(answer.Row, column);
        // With a scope the selection stands and only the Focus moves inside it, so the next
        // step searches the same ranges; without one it collapses onto the match.
        var next = request.Scope is not null && selection.Contains(found)
            ? selection.FocusOn(found)
            : selection.Click(found, extent);
        if (PageSize is { } pageSize && found.Row / pageSize != _pageIndex)
        {
            _pageIndex = found.Row / pageSize;
            PrepareRender();
        }
        Apply(next);
        _revealFocus = true;
        _suppressRender = false;
        StateHasChanged();
    }

    /// <summary>A step that moved nothing (ADR-0055): the panel shows why, and the Consumer is
    /// told — Chrome words both, as the grid holds no sentence.</summary>
    private async Task RefuseFindAsync(FindRefusalReason reason)
    {
        _findOutcome = reason switch
        {
            FindRefusalReason.NotFound => FindOutcome.NotFound,
            FindRefusalReason.OrderChanged => FindOutcome.OrderChanged,
            _ => FindOutcome.None,
        };
        _suppressRender = false;
        StateHasChanged();
        if (OnFindRefused.HasDelegate)
            await OnFindRefused.InvokeAsync(reason);
    }

    /// <summary>The find panel's context (ADR-0055), for a substituted Chrome.</summary>
    private FindContext BuildFindContext() => new(
        _findText,
        _findMatchCase,
        _findWholeCell,
        _findOutcome,
        text => _findText = text,
        value => _findMatchCase = value,
        value => _findWholeCell = value,
        () => InvokeAsync(() => FindStepAsync(backward: false)),
        () => InvokeAsync(() => FindStepAsync(backward: true)),
        CloseFromChrome,
        _findFocusRequest,
        InnerPopupChangedFromChrome);

    /// <summary>Enter in the built-in field is the form's implicit submission — which an IME
    /// confirming a candidate does not trigger — and Shift says which way it runs.</summary>
    private void OnFindFieldKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            _findBackwardOnSubmit = e.ShiftKey;
    }

    private Task SubmitFindAsync()
    {
        var backward = _findBackwardOnSubmit;
        _findBackwardOnSubmit = false;
        return FindStepAsync(backward);
    }

    /// <summary>Tab off either end of the find panel comes back to its first control
    /// (ADR-0039): the built-in field, or the substituted panel's through its request.</summary>
    private async Task ReturnKeyboardToFindAsync()
    {
        _findFocusRequest++;
        if (_findField.Context is not null)
            await FocusQuietlyAsync(_findField);
        else
            StateHasChanged();
    }

    /// <summary>The find panel's place (ADR-0040): the grid's top right, under the header,
    /// inside the grid's box across and downwards.</summary>
    private string FindPopoverStyle()
    {
        // Anchored by its right edge at the Viewport's, with the same width bounds every
        // popover is clamped with, so it can never reach past the grid's left edge either.
        var (_, width) = PopoverAcross(0);
        return FormattableString.Invariant(
            $"left: {Math.Max(0, _visibleWidthPx)}px; top: {BandHeightPx}px; transform: translateX(-100%); {width}; max-height: {HeaderPopoverRoomPx}px");
    }

    /// <summary>A word of the built-in menus and panels, through the Consumer's labels first.</summary>
    private string Label(string id) => CommandLabel?.Invoke(id) ?? BuiltInCommandLabels.For(id);

    /// <summary>Whether the Cell Editor opens here: an editable column, and a row that
    /// is in hand — the Focus over a Placeholder waits for the data (ADR-0012/ED-8).</summary>
    private bool AnyColumnEdits()
    {
        for (var i = 0; i < Columns.Count; i++)
        {
            if (Columns[i].Editable)
                return true;
        }
        return false;
    }

    /// <summary>
    /// The Editable declaration, by position in the current order (ADR-0035) — what a
    /// paste and a fill are judged against. Deliberately not <see cref="IsEditableCell"/>:
    /// that one also asks whether the row is in the Window, and a paste target
    /// legitimately covers rows that are off screen or not yet fetched (ADR-0014).
    /// A column outside the declared set is not editable — a selection should never name
    /// one, and refusing is the honest answer if it ever does.
    /// </summary>
    private bool ColumnIsEditable(int column) =>
        column >= 0 && column < Columns.Count && Columns[column].Editable;

    private bool IsEditableCell(CellPosition cell)
    {
        if (cell.Column < 0 || cell.Column >= Columns.Count || !Columns[cell.Column].Editable)
            return false;
        var slice = cell.Row - _windowStart;
        return slice >= 0 && slice < _window.Count && !_placeholderMode;
    }

    private async Task TryStartEditingAsync(string key, bool ctrl, bool alt, bool meta, bool metaIsPrimary)
    {
        // A chorded key is not typing — except AltGr, which Windows reports as Control
        // and Alt held together and is how the German, French and Nordic layouts type
        // @ { [ €. Either modifier alone is a shortcut and stays out; both together is
        // a character. A Meta held where it is not primary was never forwarded, but
        // the guard costs nothing to keep honest.
        if (meta || ctrl != alt)
            return;
        var caret = key == "F2" && !ctrl;
        if (!caret && key.Length != 1)
            return;
        // The character that started Overwrite mode is not lost (ADR-0010): it was
        // pressed before the editor existed, so the core holds it and the editor opens
        // containing it. Caret keeps the current value, with the caret inside it.
        await TryStartEditingAsync(caret ? EditMode.Caret : EditMode.Overwrite, caret ? null : key);
    }

    /// <param name="mode">Overwrite or Caret (ADR-0010).</param>
    /// <param name="initialText">What the editor opens holding; null for the Focus cell's
    /// own text, which is what Caret keeps.</param>
    private async Task TryStartEditingAsync(EditMode mode, string? initialText)
    {
        var extent = Extent;
        if (extent.RowCount <= 0 || extent.ColumnCount <= 0)
            return;
        var current = _selection.Selection;
        if (current.IsEmpty)
        {
            // The same placement rule as any first key (ADR-0012): the Focus lands on
            // the first visible cell, and the editing starts there.
            if (FirstVisibleCell() is not { } start)
                return;
            current = current.Click(start, extent);
        }
        if (!IsEditableCell(current.Focus))
        {
            _suppressRender = false;
            return;
        }

        if (!Apply(current))
            _suppressRender = false;
        await StartEditingAsync(current.Focus, mode, initialText ?? OpeningTextOf(current.Focus));
    }

    /// <summary>
    /// Delete (ADR-0054): one Clear Intent over the whole selection, judged by the paste
    /// gate — a 1×1 shape, so only the empty selection and the Editable declaration can
    /// refuse it, in ADR-0035's order. No verdict runs: there is no value to judge.
    /// </summary>
    private async Task RaiseClearIntentAsync()
    {
        var decision = ClipboardRules.PlanPaste(_selection.Selection, new PasteShape(1, 1), ColumnIsEditable);
        if (decision.IsRefused)
        {
            if (OnPasteRefused.HasDelegate)
                await OnPasteRefused.InvokeAsync(decision.Reason);
            return;
        }
        if (OnClear.HasDelegate)
            await OnClear.InvokeAsync(new GridClearIntent(decision.Plan.Targets, _sequenceVersion));
    }

    /// <summary>
    /// Ctrl+D / Ctrl+R (ADR-0035): the source row or column read in its raw, locale-free
    /// form — never the displayed text, which may be rounded or <c>####</c> — and raised as
    /// one paste intent. The rows come from the Window where it has them and are asked for
    /// through the copy route where it does not; anything short of the whole source refuses
    /// the fill rather than filling from a guess.
    /// </summary>
    private async Task FillFromKeyAsync(GridDirection direction)
    {
        var decision = ClipboardRules.PlanFill(_selection.Selection, direction, ColumnIsEditable, CopyCellCap);
        if (decision.IsRefused)
        {
            if (OnPasteRefused.HasDelegate)
                await OnPasteRefused.InvokeAsync(decision.Reason);
            return;
        }

        var plan = decision.Plan;
        var version = _sequenceVersion;
        var rows = await GatherRangeAsync(plan.Source.RowSpan);
        if (_disposed)
            return;
        // An order that moved while the rows were asked for makes both the rows and the
        // positions they were asked by someone else's (ADR-0011).
        if (rows is null || version != _sequenceVersion)
        {
            if (OnPasteRefused.HasDelegate)
                await OnPasteRefused.InvokeAsync(PasteRefusalReason.SourceUnavailable);
            return;
        }

        var source = plan.Source;
        var block = new List<IReadOnlyList<string>>(source.RowCount);
        for (var row = 0; row < source.RowCount; row++)
        {
            var values = new string[source.ColumnCount];
            for (var column = 0; column < source.ColumnCount; column++)
                values[column] = RawText(Columns[source.LeftColumn + column], rows[row]);
            block.Add(values);
        }
        if (OnPaste.HasDelegate)
            await OnPaste.InvokeAsync(new GridPasteIntent(plan.Paste, block, version, fillSource: source));
    }

    private string CellTextOf(CellPosition cell)
    {
        var slice = cell.Row - _windowStart;
        return slice >= 0 && slice < _window.Count
            ? ExGridRow<TRow>.CellText(Columns[cell.Column], _window[slice])
            : "";
    }

    /// <summary>The text an edit opens on (ADR-0051): the Consumer's, where it supplies one
    /// for this cell — the Entry on a Sheet — and the cell's text otherwise, as before.</summary>
    private string OpeningTextOf(CellPosition cell)
    {
        var slice = cell.Row - _windowStart;
        if (EditorTextOf is { } opening && slice >= 0 && slice < _window.Count
            && opening(_window[slice], Columns[cell.Column]) is { } supplied)
        {
            return supplied;
        }
        return CellTextOf(cell);
    }

    /// <summary>The Name Box's text: the Consumer's label for the Focus, or nothing
    /// (ADR-0051). While a pointing outline stands over an open edit it names the outline's
    /// Focus instead, as Excel's does in Point — the Focus itself has not moved — and it
    /// names the edited cell again the moment the outline goes. While a selecting drag holds
    /// the button over more than one cell, the Consumer's label for the range's size, as
    /// Excel's shows <c>4R x 3C</c> (ADR-0052).</summary>
    private string NameBoxText()
    {
        if (_editMode != EditMode.None && _pointer is { IsEmpty: false } pointer)
            return NameBoxLabel?.Invoke(pointer.Focus) ?? "";
        if (_selection.Selection.IsEmpty)
            return "";
        if (_dragging && _fillSource is null && !_pointDragging && NameBoxSizeLabel is { } sizeLabel
            && _selection.Selection.FocusRange is { CellCount: > 1 } dragged
            && sizeLabel(dragged) is { } size)
        {
            return size;
        }
        return NameBoxLabel?.Invoke(_selection.Selection.Focus) ?? "";
    }

    /// <summary>
    /// What the Formula Bar shows for the Focus cell (ADR-0051/0016): the uncommitted text
    /// while it is being edited — the bar is the editor's second surface — and otherwise the
    /// Consumer's opening text where it supplies one, or the full value: never the
    /// <c>####</c> and never a rounding format, in the current culture's own spelling.
    /// Empty with no Focus, or over a row not in hand.
    /// </summary>
    private string FormulaBarText()
    {
        if (_selection.Selection.IsEmpty)
            return "";
        var focus = _selection.Selection.Focus;
        if (_editMode != EditMode.None && focus == _editingCell)
            return _editText;
        var slice = focus.Row - _windowStart;
        if (focus.Column < 0 || focus.Column >= Columns.Count || slice < 0 || slice >= _window.Count)
            return "";
        var row = _window[slice];
        var column = Columns[focus.Column];
        if (EditorTextOf?.Invoke(row, column) is { } supplied)
            return supplied;
        if (!column.PaintsValue)
            return "";
        return column.Value(row) switch
        {
            null => "",
            IFormattable formattable => formattable.ToString(null, CultureInfo.CurrentCulture),
            var value => value.ToString() ?? "",
        };
    }

    private async Task StartEditingAsync(CellPosition cell, EditMode mode, string initialText)
    {
        _editSurface = EditSurface.Cell;
        _editMode = mode;
        _editingCell = cell;
        _editText = initialText;
        _editCaret = initialText.Length;
        // Placed explicitly at the end of the opening text, never assumed to be where the
        // browser left it (ADR-0051's second round).
        OpenCaret();
        // A character typed onto the cell is typing, and is reported; an edit opened on the
        // cell's text is not, until the user types in it (ADR-0051).
        if (mode == EditMode.Overwrite)
            RequestCompletion();
        else
            CloseCompletion();
        RequestEditorFocus();
        await PushEditingModeAsync();
        StateHasChanged();
    }

    /// <summary>Tells the key gate which set it runs under (ADR-0010): a mode change
    /// is a different set of claimed keys.</summary>
    private async Task PushEditingModeAsync()
    {
        _jsEditingDirty = false;
        if (_scrollHandle is null || _disposed)
            return;
        try
        {
            _gateTold = GateMode();
            await _scrollHandle.InvokeVoidAsync("setEditing", _gateTold, ReportsCaret);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or ObjectDisposedException or OperationCanceledException)
        {
        }
    }

    /// <param name="canonical">The key in <see cref="GridKeys.Canonical"/>'s form, as it is
    /// read outside editing: Command folds into Control only where it is Command
    /// (ADR-0012), so Cmd+Enter fills on a Mac and Win+Enter is nobody's here. A form not
    /// named below is not the editor's and does nothing. <b>The cases mirror
    /// <c>editingKeys</c> / <c>overwriteKeys</c> in <c>ex-grid.js</c></b> — the two must
    /// move together.</param>
    private async Task OnEditingKeyAsync(string canonical)
    {
        // An open completion list has the first word on its own keys (ADR-0051).
        if (OnCompletionKey(canonical))
            return;
        // In Caret the arrows are the editor's, and reach the core only when the gate was
        // told something else a moment ago — a list that has just closed. They move no Focus
        // (ADR-0010). Only where formula entry is declared can that happen at all.
        if (_editMode == EditMode.Caret && (CompleteEditorText is not null || PointAt is not null)
            && canonical is "ArrowUp" or "ArrowDown" or "ArrowLeft" or "ArrowRight" or "Home" or "End")
        {
            _suppressRender = false;
            return;
        }
        // Where the Consumer says a Reference can go, the arrows point (ADR-0051).
        if (OnPointKey(canonical))
            return;
        var backward = canonical.StartsWith("Shift+", StringComparison.Ordinal);
        switch (canonical)
        {
            case "Escape":
                // Cancel discards: the uncommitted text was the grid's and dies with
                // the editor (ADR-0007). Esc never blurs the grid from here.
                await EndEditingAsync();
                StateHasChanged();
                return;
            case "F2":
                // F2 moves between the two states (ADR-0010) — and, where pointing is
                // declared, between Caret and Point: from Caret it points where the Consumer
                // says a Reference can go at the caret, and from Point it moves the caret
                // again, the outline gone and its Reference left written (ADR-0051).
                _editMode = _editMode switch
                {
                    EditMode.Point => EditMode.Caret,
                    EditMode.Caret when PointAt is { } pointAt && ReferenceText is not null
                        && _editCaret >= 0 && pointAt(_editText, _editCaret) => EditMode.Point,
                    EditMode.Caret => EditMode.Overwrite,
                    _ => EditMode.Caret,
                };
                EndPointing();
                await PushEditingModeAsync();
                RequestEditorFocus();
                StateHasChanged();
                return;
            case "Control+Enter":
                // Ctrl+Enter fills the whole selection with the committed value — one
                // Edit Intent carrying all cells, the paste machinery's shape (ADR-0007/0014).
                await CommitFillAsync();
                return;
            case "Enter":
            case "Shift+Enter":
                await CommitAndMoveAsync(next => next.CycleFocus(CycleOrder.ColumnMajor, backward, Extent));
                return;
            case "Tab":
            case "Shift+Tab":
                await CommitAndMoveAsync(next => next.CycleFocus(CycleOrder.RowMajor, backward, Extent));
                return;
            case "ArrowUp":
                await CommitAndMoveAsync(next => next.Move(GridDirection.Up, Extent));
                return;
            case "ArrowDown":
                await CommitAndMoveAsync(next => next.Move(GridDirection.Down, Extent));
                return;
            case "ArrowLeft":
                await CommitAndMoveAsync(next => next.Move(GridDirection.Left, Extent));
                return;
            case "ArrowRight":
                await CommitAndMoveAsync(next => next.Move(GridDirection.Right, Extent));
                return;
            case "Home":
                await CommitAndMoveAsync(next => next.MoveToEdge(GridDirection.Left, Extent));
                return;
            case "End":
                await CommitAndMoveAsync(next => next.MoveToEdge(GridDirection.Right, Extent));
                return;
        }
    }

    /// <summary>A commit leaves the grid as an intent and nothing else (ADR-0007): the
    /// painted value does not change until the Consumer returns a new row instance.</summary>
    /// <returns><c>false</c> when a Reject held the editor: nothing was raised, the
    /// editor is still standing, and the gesture that asked for the commit keeps no
    /// meaning of its own (ADR-0034).</returns>
    /// <param name="reclaimFocus">Whether the keyboard comes back to the root once the edit
    /// ends. A press into a field of the grid's own (the Name Box) keeps its meaning after
    /// the commit (ADR-0010), so the keyboard stays where the press put it.</param>
    /// <param name="byPress">Whether a press past the editor asked for the commit, rather than
    /// a key typed in it: see <see cref="EndEditingAsync"/>.</param>
    private async Task<bool> CommitEditAsync(bool reclaimFocus = true, bool byPress = false)
    {
        var cell = _editingCell;
        var text = _editText;
        var slice = cell.Row - _windowStart;
        // The row left the Window mid-edit: there is no identity to commit onto, and a
        // positional guess would land the value on a different row (ADR-0011). The text
        // is gone either way, so the grid says which rule took it — this one is on a
        // gesture, so it is raised here rather than deferred.
        if (slice < 0 || slice >= _window.Count)
        {
            await EndEditingAsync(reclaimFocus, byPress);
            if (OnEditDiscarded.HasDelegate)
                await OnEditDiscarded.InvokeAsync(EditDiscardReason.RowLeftTheWindow);
            return true;
        }
        // Asked again, not assumed from when the editor opened: a Consumer may revoke the
        // declaration mid-edit, and `Editable` means a write may land here (ADR-0035). This
        // is the last write path the gate did not cover.
        if (!ColumnIsEditable(cell.Column))
        {
            await EndEditingAsync(reclaimFocus, byPress);
            if (OnEditDiscarded.HasDelegate)
                await OnEditDiscarded.InvokeAsync(EditDiscardReason.ColumnNoLongerEditable);
            return true;
        }

        // The Consumer's judgement, at the one moment a veto is still possible (ADR-0034).
        // No function means Accept, so a column that declares nothing behaves as before.
        var verdict = Columns[cell.Column].Validate?.Invoke(_window[slice], text) ?? EditVerdict.Accept;
        if (verdict.Kind == EditVerdictKind.Reject)
        {
            // The editor holds with the focus in it and the error shown; Escape stays the
            // only way out without applying. Announced too, because a rejected commit is
            // otherwise a key that did nothing and said nothing (A11Y-15).
            _editError = verdict.Message;
            RequestEditorFocus();
            Announce(verdict.Message);
            return false;
        }
        // A Flag raises the intent unchanged: the mark does not travel in it, and comes
        // back through the display channels when the Consumer answers them (ADR-0034).
        _editError = null;
        await EndEditingAsync(reclaimFocus, byPress);
        if (OnEdit.HasDelegate)
            await OnEdit.InvokeAsync(new GridEditIntent<TRow>(_window[slice], Columns[cell.Column].Name, text));
        return true;
    }

    private async Task CommitAndMoveAsync(Func<GridSelection, GridSelection> move)
    {
        // Enter, Tab and the Overwrite arrows are commit gestures, so a Reject stops all
        // of them: the Focus does not move away from an editor that is still standing
        // (ADR-0034, ED-15).
        if (!await CommitEditAsync())
        {
            StateHasChanged();
            return;
        }
        var extent = Extent;
        if (extent.RowCount <= 0 || extent.ColumnCount <= 0 || _selection.Selection.IsEmpty)
        {
            StateHasChanged();
            return;
        }
        if (Apply(move(_selection.Selection)))
            _revealFocus = true;
        else
            _suppressRender = false;
        StateHasChanged();
    }

    private async Task CommitFillAsync()
    {
        // The same gate as a paste, over the whole selection — not the one cell the
        // editor was opened on (ADR-0035). A refusal is announced rather than silent:
        // an attempted write against a non-editable column is always reported.
        var decision = ClipboardRules.PlanPaste(_selection.Selection, new PasteShape(1, 1), ColumnIsEditable);
        if (decision.IsRefused)
        {
            // Before the editor is torn down (ADR-0035, ED-19). A Refusal judges the
            // operation and never the text, so the editor stays open with the typing in
            // it, and Enter — a gesture the refusal did not name — still commits the one
            // cell the editor was opened on, which is editable by construction.
            if (OnPasteRefused.HasDelegate)
                await OnPasteRefused.InvokeAsync(decision.Reason);
            return;
        }
        // The Refusal judged the operation; the verdict judges the value, and only now
        // that there is still an operation to perform (ADR-0034's fill carve-out, ED-20).
        // It runs once, against the row the editor was opened on: a fill's target
        // legitimately covers rows outside the Window, so there is no row instance to
        // pass for most of them.
        var slice = _editingCell.Row - _windowStart;
        var verdict = slice >= 0 && slice < _window.Count
            ? Columns[_editingCell.Column].Validate?.Invoke(_window[slice], _editText) ?? EditVerdict.Accept
            : EditVerdict.Accept;
        if (verdict.Kind == EditVerdictKind.Reject)
        {
            _editError = verdict.Message;
            RequestEditorFocus();
            Announce(verdict.Message);
            StateHasChanged();
            return;
        }

        // Copied before the editor is torn down: the intent names the cell the text was
        // entered in, which a clipboard paste of the same field does not (ADR-0050 item 5).
        var text = _editText;
        var enteredAt = _editingCell;
        await EndEditingAsync();
        StateHasChanged();
        if (OnPaste.HasDelegate)
        {
            await OnPaste.InvokeAsync(new GridPasteIntent(
                decision.Plan, [[text]], _sequenceVersion, enteredAt: enteredAt));
        }
    }

    /// <summary>Ends the edit, and hands the keyboard back to the root unless
    /// <paramref name="reclaimFocus"/> says the gesture keeps it where it put it.</summary>
    /// <param name="reclaimFocus">Whether the keyboard comes back to the root.</param>
    /// <param name="byPress">Whether a press past the editor ended it. An edit ended by a key
    /// typed in the Formula Bar — Enter, Tab, Escape — takes the keyboard out of the bar. One
    /// ended by a press does not: a press on the rows moves DOM focus itself, and a Formula Bar
    /// or Name Box that holds it has been pressed since, which its hand-back, a round trip
    /// late, must leave alone (ADR-0021). A press held behind keys, whose default was
    /// suppressed, is the listener's to know about, and it takes a field that press left
    /// standing.</param>
    private async Task EndEditingAsync(bool reclaimFocus = true, bool byPress = false)
    {
        var fromBar = _editSurface == EditSurface.Bar && !byPress;
        // The list and the hint answer the edit, and go with it, as the outline does (ADR-0051).
        CloseCompletion();
        EndPointing();
        _editSurface = EditSurface.Cell;
        _editMode = EditMode.None;
        _editText = "";
        _reportedText = null;
        ForgetCaretPlacement();
        _editError = null;
        _editorNeedsFocus = false;
        _editorFocusAsked = false;
        // The input goes with the mode: a reference kept past it would name an element
        // the next editor is not, and the focus above would land nowhere.
        _editorElement = default;
        await PushEditingModeAsync();
        if (reclaimFocus)
            await ReclaimFocusAsync(fromField: fromBar);
    }

    /// <summary>
    /// Typing in the Cell Editor. The editor surfaces, the Formula Bar's field and the Name Box
    /// are bound with <c>@bind:get</c>/<c>@bind:set</c> on <c>oninput</c>, not <c>value</c> and
    /// <c>@oninput</c>: only a bound handler tells the renderer that the value the browser
    /// reports is what the field already shows. Without that, on a Server circuit each render
    /// answering an input a round trip old wrote that input's text back over the characters
    /// typed since, moved the caret to the end and emptied the field's undo history (SRV-5,
    /// ED-22, DC-28, ADR-0007). A render now writes a field only when the core changed its
    /// text.
    /// </summary>
    private void OnEditorInput(string? text)
    {
        _editSurface = EditSurface.Cell;
        TextTyped(text ?? "");
    }

    /// <summary>
    /// A press into the Formula Bar (ADR-0051): the bar becomes the surface the user is
    /// typing in. With no edit open it opens one on the Focus cell, in Caret, on the
    /// opening text — the keyboard stays in the bar, which is the Cell Editor's second
    /// surface, so the listener gates its keys as the editor's (ADR-0018). A cell that does
    /// not edit leaves the bar read-only and opens nothing.
    ///
    /// <para>The caret stays where the press put it, as Excel's does (ADR-0051's third
    /// round): the bar already showed the opening text, so nothing is placed, and the caret is
    /// not known until the listener reports it. Only where the opening text differs from what
    /// the bar showed — rewriting the field moves the browser's caret anyway — is it placed at
    /// the end, as an edit opened by typing or F2 is.</para>
    /// </summary>
    private async Task OnFormulaBarFocusAsync()
    {
        if (_editMode != EditMode.None)
        {
            _editSurface = EditSurface.Bar;
            // A Chrome's Cell Editor asked for the keyboard when the edit opened focuses itself
            // once it is painted — on a circuit that can be after this press, and it would take
            // the keyboard from the bar the user has just pressed. The request is withdrawn; a
            // later one, back on the cell, is a new number (ADR-0010/0030/0051).
            if (_editorFocusAsked)
                _editorFocusAsked = false;
            else
                _suppressRender = true;
            return;
        }
        if (_selection.Selection.IsEmpty || !IsEditableCell(_selection.Selection.Focus))
        {
            _suppressRender = true;
            return;
        }
        if (_menuColumn >= 0 || _contextCell is not null)
            CloseMenus();
        EndInteractive();
        var focus = _selection.Selection.Focus;
        var shown = FormulaBarText();
        _editSurface = EditSurface.Bar;
        _editMode = EditMode.Caret;
        _editingCell = focus;
        _editText = OpeningTextOf(focus);
        if (ReportsCaret && string.Equals(_editText, shown, StringComparison.Ordinal))
        {
            _editCaret = -1;
            ForgetCaretPlacement();
        }
        else
        {
            _editCaret = _editText.Length;
            OpenCaret();
        }
        CloseCompletion();
        await PushEditingModeAsync();
    }

    /// <summary>Typing in the Formula Bar (ADR-0051): the one uncommitted text, so the
    /// Cell Editor shows it on the render this input causes.</summary>
    private void OnFormulaBarInput(string? text)
    {
        if (_editMode == EditMode.None)
        {
            _suppressRender = true;
            return;
        }
        _editSurface = EditSurface.Bar;
        TextTyped(text ?? "");
    }

    /// <summary>Whether the Formula Bar takes typing: while an edit is open, or when the
    /// Focus cell edits and one can open there (ADR-0051/0035).</summary>
    private bool FormulaBarEditable
        => _editMode != EditMode.None
            || (!_selection.Selection.IsEmpty && IsEditableCell(_selection.Selection.Focus));

    /// <summary>
    /// A press into the Name Box (ADR-0051): an open edit commits first, as a press anywhere
    /// past the editor does, and the press then keeps its own meaning (ADR-0010) — the
    /// keyboard stays in the Name Box. The Name Box is not an editor surface: taking the
    /// keyboard back to the root there would land the address typed next on the grid, where
    /// it opens Overwrite on the Focus cell and is committed into it instead of navigating. A
    /// Reject holds the editor and takes the keyboard back to it — the Name Box does not get
    /// to walk away from it (ADR-0034).
    /// </summary>
    private async Task OnNameBoxFocusAsync()
    {
        if (_editMode == EditMode.None)
        {
            _suppressRender = true;
            return;
        }
        if (!await CommitEditAsync(reclaimFocus: false))
            RequestEditorFocus();
    }

    private void OnNameBoxInput(string? text) => _nameBoxText = text ?? "";

    private void OnNameBoxBlur() => _nameBoxText = null;

    /// <summary>
    /// Enter in the Name Box (ADR-0051): the typed text goes to the Consumer, who resolves it
    /// to a position and asks the grid to place the Selection and the Focus there
    /// (<see cref="PlaceSelectionAsync"/>, ADR-0050 item 4). The grid reads no address. The
    /// keyboard comes back to the grid, where the placement lands.
    /// </summary>
    private async Task SubmitNameBoxAsync()
    {
        var text = _nameBoxText;
        _nameBoxText = null;
        await ReclaimFocusAsync(fromField: true);
        if (text is not null && OnNameBoxEntered.HasDelegate)
            await OnNameBoxEntered.InvokeAsync(text);
    }

    /// <summary>The core wants the editor's control to hold DOM focus: the built-in
    /// input is focused after the render; a Chrome's control is told through the
    /// context's <see cref="CellEditorContext.FocusRequest"/>, which this bumps.</summary>
    private void RequestEditorFocus()
    {
        _editorNeedsFocus = true;
        // A Chrome's editor focuses itself on a new request number; while the user works
        // in the Formula Bar, it must not take the keyboard from there (ADR-0051).
        if (_editSurface == EditSurface.Cell)
        {
            _editorFocusRequest++;
            _editorFocusAsked = true;
        }
        else
            _formulaBarFocusRequest++;
    }

    /// <summary>The Name Box seam's contract (ADR-0051/0030): what it shows, and the core's
    /// own handlers as the Chrome's control calls them.</summary>
    private NameBoxContext BuildNameBoxContext()
        => new(
            _nameBoxText ?? NameBoxText(),
            _chromeNameBoxTextChanged ??= text => FromChrome(() => _nameBoxText = text),
            _chromeNameBoxFocused ??= () => FromChromeAsync(OnNameBoxFocusAsync),
            _chromeNameBoxBlurred ??= () => FromChrome(OnNameBoxBlur));

    /// <summary>The Formula Bar text field seam's contract (ADR-0051/0030): the Focus cell's
    /// text, whether it takes typing, the core's handlers, and the focus requests.</summary>
    private FormulaBarTextContext BuildFormulaBarTextContext()
        => new(
            FormulaBarText(),
            !FormulaBarEditable,
            _chromeFormulaBarFocused ??= () => _pressAnswer = FromChromeAsync(OnFormulaBarFocusAsync),
            _chromeFormulaBarTextChanged ??= text => FromChrome(() => OnFormulaBarInput(text)),
            _formulaBarFocusRequest);

    /// <summary>A handler reached from a Chrome's control rather than from an event on the
    /// root: run on the renderer's context, then rendered as the root's own event would be —
    /// <see cref="ShouldRender"/> still consumes a suppression the handler armed.</summary>
    private Task FromChromeAsync(Func<Task> handler)
        => InvokeAsync(async () =>
        {
            if (_disposed)
                return;
            await handler();
            StateHasChanged();
        });

    private void FromChrome(Action handler)
        => _ = FromChromeAsync(() =>
        {
            handler();
            return Task.CompletedTask;
        });

    /// <summary>The editor seam's contract (ADR-0010): the core owns the box, the keys
    /// and the text's lifecycle; a substitute renders the control and reports its text
    /// as it changes — Enter and its siblings never reach it.</summary>
    private CellEditorContext BuildEditorContext()
    {
        var declared = Columns[_editingCell.Column];
        return new CellEditorContext(
            declared.Name,
            declared.Type,
            _editText,
            _editMode switch
            {
                EditMode.Caret => CellEditMode.Caret,
                EditMode.Point => CellEditMode.Point,
                _ => CellEditMode.Overwrite,
            },
            _editError,
            text =>
            {
                _editSurface = EditSurface.Cell;
                TextTyped(text);
                // The bar shows the same uncommitted text, and the completion box answers it
                // (ADR-0051): a Chrome's control reports into its own component, so the root
                // is told to paint them.
                if (ShowFormulaBar || CompleteEditorText is not null)
                    StateHasChanged();
            },
            () => _ = InvokeAsync(() => CommitAndMoveAsync(next => next)),
            () => _ = InvokeAsync(async () =>
            {
                await EndEditingAsync();
                StateHasChanged();
            }),
            _editError is null ? null : MessageId,
            _editorFocusAsked ? _editorFocusRequest : 0);
    }

    /// <summary>F2's other door (ADR-0010): a double click enters Caret on an editable
    /// cell — the original value stays, with the caret inside it.</summary>
    private async Task OnViewportDoubleClickAsync(MouseEventArgs e)
    {
        if (_editMode != EditMode.None || CellUnder(e) is not { } cell || !IsEditableCell(cell))
        {
            _suppressRender = true;
            return;
        }
        var extent = Extent;
        if (!Apply(_selection.Selection.Click(cell, extent)))
            _suppressRender = false;
        await StartEditingAsync(cell, EditMode.Caret, OpeningTextOf(cell));
    }

    /// <summary>
    /// Ctrl+A selects the context that is visible (ADR-0015): under a pager the page —
    /// which reads as the world — and going beyond it is requested explicitly, through
    /// the offer beside the count. Scrolling has no such boundary, so there it stays
    /// every row after filtering across every visible column (ADR-0011).
    /// </summary>
    private GridSelection SelectAllInContext(GridSelection current, GridExtent extent)
    {
        if (PageSize is not { } size)
            return current.SelectAll(extent);
        var start = Math.Min(_pageStartRow, extent.RowCount - 1);
        var count = Math.Min(extent.RowCount - start, size);
        if (start < 0 || count <= 0)
            return current;
        // The page-context overload, not Click+ExtendTo: naming the whole region must
        // keep the Focus where it stands, exactly as SelectAll does (ADR-0052).
        return current.SelectAll(extent, start, count);
    }

    /// <summary>The explicit way past the page's context (ADR-0015): the offer beside
    /// the count, doing what Ctrl+A does without a pager.</summary>
    private async Task SelectWholeResultAsync()
    {
        var extent = Extent;
        if (extent.RowCount <= 0 || extent.ColumnCount <= 0)
            return;
        if (!Apply(_selection.Selection.SelectAll(extent)))
            _suppressRender = false;
        await ReclaimFocusAsync();
    }

    private async Task TurnPageAsync(int delta)
    {
        if (PageSize is null)
            return;
        var target = Math.Clamp(_pageIndex + delta, 0, PageCount - 1);
        if (target != _pageIndex)
        {
            // The same machinery as a scroll (ADR-0015): the new page recomputes the
            // slice, and the after-render pass raises the Range Request if the Window
            // does not cover it.
            _pageIndex = target;
            _scrollTopPx = 0;
            PrepareRender();
            await PushScrollOffsetAsync(0, _scrollLeftPx);
        }
        await ReclaimFocusAsync();
    }

    /// <summary>The way back to an off-screen selection (ADR-0015): to its page when
    /// there is one, and the ordinary reveal from there.</summary>
    private async Task GoToSelectionAsync()
    {
        if (_selection.Selection.IsEmpty)
            return;
        if (PageSize is { } size)
            _pageIndex = _selection.Selection.Focus.Row / size;
        PrepareRender();
        _revealFocus = true;
        await ReclaimFocusAsync();
    }

    /// <summary>Whether any selection rectangle intersects what is on screen — the
    /// off-screen indicator's test, needing no data (ADR-0014/0015).</summary>
    private bool SelectionIntersectsView()
    {
        if (_visible is not { } visible)
            return false;
        foreach (var range in _selection.Selection.Ranges)
        {
            if (range.TopRow >= visible.Start + visible.Count || range.BottomRow < visible.Start)
                continue;
            if (range.LeftColumn < _columnStyles.Geometry.PinnedCount)
                return true;
            if (_scrollable is { } columns
                && range.LeftColumn < columns.Start + columns.Count && range.RightColumn >= columns.Start)
            {
                return true;
            }
        }
        return false;
    }

    /// <summary>
    /// Space engages with the Focus cell's content (ADR-0020, completed by ADR-0037): it
    /// fires a single action; enters a cell with several, the first one chosen; asks a
    /// Template cell's content to take DOM focus; and opens Overwrite on an editable cell
    /// with the space already in it, as if it had been typed. Inside an Interactive cell
    /// it fires the chosen action — and leaves.
    /// </summary>
    private async Task EngageAsync()
    {
        var focus = _selection.Selection.Focus;
        if (focus.Column < 0 || focus.Column >= Columns.Count)
            return;
        var column = Columns[focus.Column];

        // The Mark Column acts on the selection's rows, not on the one under the Focus,
        // and needs none of them in hand: they are named by position (ADR-0043).
        if (column.IsMarkColumn)
        {
            await MarkSelectedRowsAsync();
            return;
        }

        // The row has to be in hand: a Focus over a Placeholder has no row to act on, and
        // ADR-0012 already says editing waits for the data to arrive.
        var slice = focus.Row - _windowStart;
        var row = slice >= 0 && slice < _window.Count ? _window[slice] : null;

        if (InteractiveChoice() is { } choice)
        {
            // Firing leaves (ADR-0037): an action changes the row under it — it opens a
            // view, or deletes the row — and staying inside would leave the chosen action
            // over whatever row slid into its place, one Space from firing on that.
            EndInteractive();
            _suppressRender = false;
            StateHasChanged();
            if (row is not null)
                await RaiseActionAsync(new GridActionEventArgs<TRow>(row, column.Name, column.Actions[choice.Action].Name));
            return;
        }

        if (row is null)
            return;
        if (column.Actions.Count == 1)
        {
            await RaiseActionAsync(new GridActionEventArgs<TRow>(row, column.Name, column.Actions[0].Name));
            return;
        }
        if (column.Actions.Count > 1)
        {
            // The keyboard stays on the root (ADR-0037): what changes is which action the
            // row paints as chosen and what aria-activedescendant names.
            _interactive = (focus, 0);
            RequestFocusReveal();
            _suppressRender = false;
            StateHasChanged();
            return;
        }
        if (column.Template is not null)
        {
            // Asked, never reached into: the fragment's context carries the request on the
            // render that paints the cell, and the Consumer's control focuses itself
            // (ADR-0037, the rule ADR-0030 applies to a Chrome's editor).
            _focusRequest = (focus, ++_focusRequestCounter);
            RequestFocusReveal();
            _suppressRender = false;
            StateHasChanged();
            return;
        }
        if (IsEditableCell(focus))
            await StartEditingAsync(focus, EditMode.Overwrite, " ");
    }

    /// <summary>The chosen action of the Interactive cell, or null when there is none —
    /// including when the field is stale: Interactive belongs to the Focus, so a Focus that
    /// moved or was dropped (a click, a sort, a new column set) has ended it, whatever the
    /// field still says (ADR-0037).</summary>
    private (CellPosition Cell, int Action)? InteractiveChoice()
    {
        if (_interactive is not { } interactive || _selection.Selection.IsEmpty
            || _selection.Selection.Focus != interactive.Cell)
        {
            return null;
        }
        var column = interactive.Cell.Column;
        if (column < 0 || column >= Columns.Count || Columns[column].Actions.Count < 2
            || interactive.Action >= Columns[column].Actions.Count)
        {
            return null;
        }
        return interactive;
    }

    /// <summary>Ends Interactive (ADR-0037). True when a chosen action was showing, so the
    /// caller knows a render is owed to take it away — the button's class and the root's
    /// aria-activedescendant both go with the mode.</summary>
    private bool EndInteractive()
    {
        var showing = InteractiveChoice() is not null;
        _interactive = null;
        return showing;
    }

    /// <summary>The action a key chooses inside an Interactive cell, or null for a key that
    /// does not choose (ADR-0037): ← and → step, Home and End — and the Control+arrow forms,
    /// which resolve to the same edge move — go to either end. Clamped at both, never
    /// wrapping.</summary>
    private int? ChoiceAfter((CellPosition Cell, int Action) choice, GridKeyAction action)
    {
        var last = Columns[choice.Cell.Column].Actions.Count - 1;
        return action.Kind switch
        {
            GridKeyKind.Move when action.Direction == GridDirection.Left => Math.Max(0, choice.Action - 1),
            GridKeyKind.Move when action.Direction == GridDirection.Right => Math.Min(last, choice.Action + 1),
            GridKeyKind.MoveToEdge when action.Direction == GridDirection.Left => 0,
            GridKeyKind.MoveToEdge when action.Direction == GridDirection.Right => last,
            _ => null,
        };
    }

    /// <summary>Arms the post-render reveal for a Focus that did not move (ADR-0012):
    /// entering a cell needs it painted — a request cannot be handed to content that is not
    /// in the DOM, and a chosen button nobody can see is no choice (ADR-0037). A Focus
    /// already on screen scrolls nothing.</summary>
    private void RequestFocusReveal()
    {
        _revealFocus = true;
        _revealRowStart = false;
        _revealStepRows = 0;
    }

    /// <summary>
    /// What the row at this position is told about an engaged cell (ADR-0037): the chosen
    /// action while its Focus cell is Interactive, a Template cell's focus request on the
    /// render that can deliver it, and <see cref="CellEngagement.None"/> for every other
    /// row — so no other row re-renders for any of it (ADR-0003). Recorded at render,
    /// because only the render knows whether the cell was painted to be handed anything.
    /// </summary>
    private CellEngagement EngagementFor(int row)
    {
        if (_selection.Selection.IsEmpty || _selection.Selection.Focus.Row != row)
            return CellEngagement.None;
        if (InteractiveChoice() is { } choice)
            return CellEngagement.Chosen(choice.Cell.Column, choice.Action);
        if (_focusRequest is { } request && request.Cell == _selection.Selection.Focus && FocusCellIsPainted())
        {
            _focusRequestHandedOver = true;
            return CellEngagement.Request(request.Cell.Column, request.Number);
        }
        return CellEngagement.None;
    }

    /// <summary>The hand-back that leaves the Formula Bar and the Name Box alone — every
    /// one but those made from inside them (<see cref="ReclaimFocusAsync(bool)"/>).</summary>
    private Task ReclaimFocusAsync() => ReclaimFocusAsync(fromField: false);

    /// <summary>
    /// Hands the keyboard back to the root when something of the grid's own that held it
    /// goes — a popover, the editor, a status-line command — and when Escape leaves a
    /// control inside a cell (ADR-0020/0039). Never after an action fires: the keyboard is
    /// then where the user or the handler put it (ADR-0037, amended 2026-09-26).
    ///
    /// <para>Only while DOM focus is still inside this root, or on nothing (<c>body</c>): on a
    /// circuit this lands a round trip after the gesture that asked for it, and a second grid
    /// the user has pressed in the meantime keeps its keyboard (ADR-0018). The condition is
    /// the handle's to read, since only the browser knows where focus is now — the one
    /// decision about focus made in JavaScript (ADR-0021). Before the handle is attached there
    /// is no listener on the root to hand keys to, and nothing is asked.</para>
    ///
    /// <para>Nor, unless <paramref name="fromField"/> says so, while it is on a field beside the
    /// rows with focus of its own — the Formula Bar or the Name Box, built in or a Chrome's,
    /// inside the band the core renders them into (ADR-0021, widened 2026-09-28). A row
    /// press's hand-back lands a round trip late, and took the keyboard from a field pressed
    /// after it. <paramref name="fromField"/> is for the gestures made in that field, whose
    /// point is to leave it: Enter in the Name Box, Escape in either, an edit in the bar
    /// ending.</para>
    /// </summary>
    /// <param name="fromField">Whether the keyboard is taken from the Formula Bar or the Name
    /// Box too.</param>
    private async Task ReclaimFocusAsync(bool fromField)
    {
        if (_disposed || _scrollHandle is null)
            return;
        try
        {
            await _scrollHandle.InvokeVoidAsync("reclaimFocus", fromField);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or ObjectDisposedException or OperationCanceledException)
        {
        }
    }

    private async Task LeaveAsync()
    {
        if (_scrollHandle is null || _disposed)
            return;
        try
        {
            await _scrollHandle.InvokeVoidAsync("blur");
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or ObjectDisposedException or OperationCanceledException)
        {
        }
    }

    /// <summary>The top-left cell currently painted — the leading Pinned Column when there
    /// is one, otherwise the leftmost scrollable column on screen.</summary>
    private CellPosition? FirstVisibleCell()
    {
        if (_visible is not { } visible)
            return null;
        var column = _columnStyles.Geometry.PinnedCount > 0 ? 0 : _scrollable?.Start ?? 0;
        return new CellPosition(visible.Start, column);
    }

    /// <summary>
    /// Moves the scroller to where an armed reveal is going, in the render that paints it
    /// there (ADR-0012, 2026-09-29). Called at the top of the render: the model takes the
    /// target offsets first, the slice is recomputed at them — the rows the Consumer has,
    /// Placeholders for the rest, the Range Request raised after the render as always —
    /// and the browser is told the same offsets before the batch that paints them leaves.
    /// Its scroll event then confirms what is already painted and renders nothing. Before,
    /// the write went out after the render and the slice followed the scroll event, so a
    /// far jump on a circuit showed a Viewport with no rows for a round trip.
    /// </summary>
    private void StageReveal()
    {
        if (!_revealFocus)
            return;
        var toRowStart = _revealRowStart;
        var stepRows = _revealStepRows;
        _revealFocus = false;
        _revealRowStart = false;
        _revealStepRows = 0;
        // The Extent while extending (ADR-0052), or the pointing outline's moving end
        // (ADR-0051), where one asked; the Focus otherwise.
        var target = _revealTarget;
        _revealTarget = null;
        if (_disposed || _scrollHandle is null || _selection.Selection.IsEmpty)
            return;

        var focus = target ?? _selection.Selection.Focus;
        if (focus.Row >= TotalRows || focus.Column >= _columnStyles.Geometry.Count)
            return;
        // Under a PageSize the reveal works in page-local rows; a Focus that left the
        // page has already turned it at the keystroke (ADR-0015).
        var localRow = focus.Row - _pageStartRow;
        if (localRow < 0 || localRow >= _geometry.TotalRowCount)
            return;
        // PageUp / PageDown scroll by the same rows the Focus moved — the one scroll
        // that is not a reveal (ADR-0012). The reveal still runs over the stepped
        // offset: at the top and bottom the scroll clamps, the relative position cannot
        // be held, and the transition degrades to exactly a reveal there — the Focus is
        // still visible, which is the invariant that actually matters.
        // Stepped through the mapping, so a compressed grid moves by rows and not by
        // scrollbar pixels (ADR-0053); uncompressed, only the clamp the reveal applies
        // anyway is taken early.
        var steppedTop = stepRows == 0
            ? _scrollTopPx
            : _geometry.ScrollTopStepped(_scrollTopPx, stepRows * _metrics.RowHeightPx);
        var top = _geometry.ScrollTopToReveal(localRow, steppedTop);
        // "Go to the beginning" is not the same request as "make this cell visible", and
        // Pinned Columns are where the two come apart. ScrollLeftToReveal answers the
        // second one and answers it correctly: a pinned column covers the Viewport's left
        // edge, so it is already whole on screen and nothing has to move. But Home and
        // Ctrl+Home mean the first one — and with the first column pinned they would leave
        // the Viewport parked wherever it was, halfway along a hundred columns, which is
        // not where the row starts.
        //
        // What settles it is that pinning would otherwise CHANGE what the key does:
        // unpinned, column 0 is scrollable and revealing it already lands the Viewport at
        // 0. This makes the two agree rather than inventing a behaviour for the pinned
        // case. (A press that moves nothing at all — the Focus is already at the first
        // column — renders nothing and so reveals nothing, pinned or not. That is the
        // "only when something moved" guard above, and it is the same on both paths.)
        var left = toRowStart
            ? 0
            : _columnStyles.Geometry.ScrollLeftToReveal(focus.Column, _scrollLeftPx);
        // The no-op check compares against where the scroller is GOING TO BE — the last
        // scroll event or the last write, whichever is newer — never against the event
        // mirror alone. A previous reveal's write can still be in flight; judged against
        // the mirror, this reveal would be dropped as "already there" and the in-flight
        // write would land after it, leaving the Focus off screen with nothing armed to
        // recover (hit for real: Ctrl+Home then Ctrl+End faster than the scroll event
        // round-trips, under the zoom suite). A move that truly needs no scroll still
        // writes nothing.
        if (top == _expectedScrollTopPx && left == _expectedScrollLeftPx)
            return;

        // The model moves first, as an edge auto-scroll tick's does (ADR-0008), so this
        // render paints the slice at the target and everything that asks "is the Focus in
        // view" — the status line among them — reads where the scroller is going. The
        // write leaves now, from inside the render, so it reaches the browser with the
        // batch that paints it: on WebAssembly in the same task, on a circuit as the
        // message just ahead of the batch. After the render, on a circuit, would be a round
        // trip later, when the batch is acknowledged. The write is counted as it leaves, so a
        // read already on the wire is set aside, as any crossed read is.
        var paintedFirstRow = _visible?.Start;
        var paintedColumns = _scrollable;
        _scrollTopPx = top;
        _scrollLeftPx = left;
        PrepareRender();
        // The reveal's offset is computed from the anchored one and supersedes it: an
        // anchor written after it would put the view back where the reveal left.
        _anchorScrollTopPx = null;
        // Numbered, and the number rendered on the root by this same render: the script
        // holds the write until the frame whose DOM carries it, so the offset and the
        // slice are painted together whichever message lands first.
        _ = PushScrollOffsetAsync(top, left, ++_revealToken);
        // The rows moved under a still pointer, as they do under a scroll: the band goes
        // (ApplyScrollOffset), because the echo will find nothing moved and keep it.
        if ((_visible?.Start != paintedFirstRow || _scrollable != paintedColumns) && _hoverRow >= 0)
        {
            _hoverRow = -1;
            _ = ForgetPointerAsync();
        }
    }

    private async Task RaiseSelectionIfChangedAsync()
    {
        // Raised from after the render for the reason the Range Request is: a Consumer
        // that handles it synchronously would otherwise re-enter the batch it was raised
        // from.
        if (!_selectionChanged)
            return;
        _selectionChanged = false;
        ScheduleAnnouncement();
        if (_disposed || !SelectionChanged.HasDelegate)
            return;
        await SelectionChanged.InvokeAsync(_selection.Selection);
    }

    /// <summary>
    /// Arms the live region for the settled selection (ADR-0033). Only when the
    /// <em>ranges</em> moved: a Focus move announces nothing — aria-activedescendant
    /// moved with it and the assistive technology reads the new cell itself — and a
    /// single collapsed cell is that same case arrived at by arrow key.
    /// </summary>
    private void ScheduleAnnouncement()
    {
        if (_disposed)
            return;
        var ranges = _selection.Selection.Ranges;
        if (RangesEqual(ranges, _announcedRanges))
            return;
        // A 1×1 selection is the Focus by another name; the region neither announces
        // it nor clears — "live region unchanged" is the criterion.
        if (ranges.Count == 1 && ranges[0].CellCount == 1)
        {
            _announcedRanges = ranges;
            return;
        }
        if (ranges.Count == 0)
        {
            _announcedRanges = ranges;
            return;
        }
        _announceTimer ??= Time.CreateTimer(OnAnnounceSettled, null, Timeout.InfiniteTimeSpan, Timeout.InfiniteTimeSpan);
        _announceTimer.Change(SettleDelay, Timeout.InfiniteTimeSpan);
    }

    /// <summary>Says something through the root's one live region (ADR-0033). A repeat
    /// is made audible by emptying the region for one render and putting the text back
    /// on the next — a mutation, where identical text would be none.</summary>
    private void Announce(string? sentence)
    {
        var text = sentence ?? "";
        if (text.Length > 0 && text == _announcement)
        {
            // Identical text is no mutation, and the second refusal is the one the user
            // needs. Empty it now; the next render puts it back, and that is a change.
            _announcement = "";
            _announcePending = text;
            return;
        }
        _announcement = text;
        _announcePending = null;
    }

    private void OnAnnounceSettled(object? state)
    {
        _ = InvokeAsync(() =>
        {
            if (_disposed)
                return;
            var ranges = _selection.Selection.Ranges;
            if (RangesEqual(ranges, _announcedRanges))
                return;
            _announcedRanges = ranges;
            Announce(DescribeSelection(_selection.Selection));
            StateHasChanged();
        });
    }

    private static bool RangesEqual(IReadOnlyList<SelectionRange> a, IReadOnlyList<SelectionRange> b)
    {
        if (a.Count != b.Count)
            return false;
        for (var i = 0; i < a.Count; i++)
        {
            if (a[i] != b[i])
                return false;
        }
        return true;
    }

    /// <summary>
    /// The extent in one sentence, naming the corners (ADR-0033). The wording is
    /// provisional — ADR-0033 leaves header-versus-index to a real screen reader in
    /// layer 3 — but the shape is not: one sentence, the extent, at any moment.
    /// </summary>
    private string DescribeSelection(GridSelection selection)
    {
        if (selection.IsEmpty)
            return "";
        if (selection.Ranges.Count > 1)
        {
            return FormattableString.Invariant(
                $"{selection.CellCount} cells in {selection.Ranges.Count} ranges selected");
        }
        var range = selection.Ranges[0];
        var left = range.LeftColumn < Columns.Count ? Columns[range.LeftColumn].Header : "";
        var right = range.RightColumn < Columns.Count ? Columns[range.RightColumn].Header : "";
        return FormattableString.Invariant(
            $"{range.RowCount} rows by {range.ColumnCount} columns selected, {left} {range.TopRow + 1} to {right} {range.BottomRow + 1}");
    }

    /// <summary>
    /// The Focus cell's id for <c>aria-activedescendant</c>, or null while the Focus is
    /// not painted (ADR-0033): a wheel scroll can carry the Focus cell out of the DOM,
    /// and the attribute must never name a missing id — nor force a scroll back.
    /// </summary>
    private string? ActiveDescendant()
    {
        if (!FocusCellIsPainted())
            return null;
        var focus = _selection.Selection.Focus;
        // Interactive over several actions (ADR-0037): the keyboard stays on this root and
        // the attribute names the chosen button, which an assistive technology then reads
        // as it would under real focus — by the label every action is required to carry.
        if (InteractiveChoice() is { } choice)
            return CellIds.Action(_idPrefix, focus.Row, focus.Column, choice.Action);
        return CellIds.Cell(_idPrefix, focus.Row, focus.Column);
    }

    /// <summary>Whether the Focus cell is in the DOM right now: its row in the Window and
    /// on screen, and its column pinned or inside the horizontal slice — never mid-fling,
    /// when the scrollable cells are skipped (ADR-0004). What aria-activedescendant may
    /// name (ADR-0033), and what a Template cell's focus request waits for (ADR-0037).</summary>
    private bool FocusCellIsPainted()
    {
        if (_selection.Selection.IsEmpty || _visible is not { } visible)
            return false;
        var focus = _selection.Selection.Focus;
        if (focus.Row < visible.Start || focus.Row >= visible.Start + visible.Count)
            return false;
        var slice = focus.Row - _windowStart;
        if (slice < 0 || slice >= _window.Count)
            return false;
        if (focus.Column >= _columnStyles.Geometry.PinnedCount)
        {
            // Not pinned, so it is in the DOM only while the horizontal slice paints it
            // — and not at all mid-fling, when the scrollable cells are skipped.
            if (_placeholderMode || _scrollable is not { } columns
                || focus.Column < columns.Start || focus.Column >= columns.Start + columns.Count)
            {
                return false;
            }
        }
        return true;
    }

    private void RestartSettleTimer()
    {
        if (_disposed)
            return;
        _settleTimer ??= Time.CreateTimer(OnSettled, null, Timeout.InfiniteTimeSpan, Timeout.InfiniteTimeSpan);
        _settleTimer.Change(SettleDelay, Timeout.InfiniteTimeSpan);
    }

    private void OnSettled(object? state)
    {
        // The timer fires off the renderer's synchronisation context; everything it
        // touches has to go back onto it.
        _ = InvokeAsync(() =>
        {
            if (_disposed || !_placeholderMode)
                return;
            try
            {
                _placeholderMode = false;
                PrepareRender();
                StateHasChanged();
            }
            catch (Exception ex)
            {
                _ = DispatchExceptionAsync(ex);
            }
        });
    }

    private bool IsCovered(RowRange range)
        => range.Start >= _windowStart && range.Start + range.Count <= _windowStart + _window.Count;

    private async Task RaiseRangeIfUncoveredAsync()
    {
        // Mid-fling the visible range is passing through; asking for every range it
        // crosses is what ADR-0004's one mechanism exists to avoid. Settling raises the
        // range that was actually landed on.
        if (_disposed || _placeholderMode || (Source is null && !OnRangeNeeded.HasDelegate))
            return;
        if (_visible is not { } range || IsCovered(range))
        {
            _lastRaised = null;
            return;
        }

        // Asked once, and not again until the Window actually moved. What counts is
        // where the Window sits, never which instance it is: a Consumer that builds its
        // Window inline hands over a fresh list on every render, and re-asking for that
        // would spin — as would a Consumer that answers, honestly but unhelpfully, with
        // rows that still do not cover the Viewport.
        if (_lastRaised == range
            && _lastRaisedWindowStart == _windowStart
            && _lastRaisedWindowCount == _window.Count)
        {
            return;
        }

        _lastRaised = range;
        _lastRaisedWindowStart = _windowStart;
        _lastRaisedWindowCount = _window.Count;
        // Awaited, so a Source that fetches surfaces its failure here rather than in an
        // unobserved task, and the loading state it raised is already on screen.
        if (Source is not null)
            await Source.OnRangeNeededAsync(range);
        else
            await OnRangeNeeded.InvokeAsync(range);
    }

    // ---- Row Marks (ADR-0043) -------------------------------------------------------

    // The Mark Column's index, or -1; and who holds the marks — the Marks parameter on
    // the push form, the Source's own on the pull form. Resolved per push, off the render
    // path.
    private int _markColumn = -1;
    private IRowMarks<TRow>? _marks;
    private IRowMarks<TRow>? _boundMarks;
    private Func<TRow, RowKind>? _toldRowKind;
    private bool _rowKindTold;

    // Held in fields so every row and every render hands over the same instance: a method
    // group is a new delegate each time, and a row compares OnMark by reference (ADR-0003);
    // a header or status button handed a new one would re-register its event (PF-3).
    private Func<TRow, bool, Task>? _onMark;
    private Func<Task>? _onHeaderMarkField;
    private Func<Task>? _onMarkWholeResultField;
    private RenderFragment? _headerMark;

    private Func<Task> _onHeaderMark => _onHeaderMarkField ??= PressHeaderMarkAsync;
    private Func<Task> _onMarkWholeResult => _onMarkWholeResultField ??= MarkWholeResultAsync;

    /// <summary>
    /// Finds the Mark Column and who holds its marks, refusing by name what cannot be
    /// painted honestly: two Mark Columns ("all" would not say which marks), a Mark Column
    /// nobody holds marks for, and marks from both the parameter and the Source.
    /// </summary>
    private void BindMarks()
    {
        _markColumn = -1;
        for (var i = 0; i < Columns.Count; i++)
        {
            if (!Columns[i].IsMarkColumn)
                continue;
            if (_markColumn >= 0)
            {
                throw new InvalidOperationException(
                    $"Columns '{Columns[_markColumn].Name}' and '{Columns[i].Name}' are both Mark Columns. A grid has " +
                    "at most one: the header's \"all\", its state and the count would not say which marks they " +
                    "meant (ADR-0043).");
            }
            _markColumn = i;
        }

        var sourceMarks = Source?.Marks;
        if (Marks is not null && sourceMarks is not null)
        {
            throw new InvalidOperationException(
                $"{nameof(Marks)} was passed together with a Source that keeps its own Row Marks. One of the two " +
                "would have to silently win; pass the Source alone, or a Source without marks (ADR-0043).");
        }
        var marks = Marks ?? sourceMarks;
        if (_markColumn >= 0 && marks is null)
        {
            throw new InvalidOperationException(
                $"Column '{Columns[_markColumn].Name}' is a Mark Column, but nobody holds the marks. Pass " +
                $"{nameof(Marks)}, or a Source that keeps them — GridSource.From does; GridSource.Fetch does when " +
                "it is given a mark adapter (ADR-0043).");
        }
        _marks = _markColumn >= 0 ? marks : null;

        if (!ReferenceEquals(_boundMarks, _marks))
        {
            if (_boundMarks is not null)
                _boundMarks.Changed -= OnMarksChanged;
            _boundMarks = _marks;
            _rowKindTold = false;
            if (_boundMarks is not null)
                _boundMarks.Changed += OnMarksChanged;
        }
        // The roles are pushed, as the columns are to a Source: the declaration stays the
        // grid's, and the marks leave Group and Total rows out of "all" and the counts.
        if (_marks is not null && (!_rowKindTold || !ReferenceEquals(_toldRowKind, RowKind)))
        {
            _toldRowKind = RowKind;
            _rowKindTold = true;
            _marks.OnRowKindChanged(RowKind);
        }
    }

    private void OnMarksChanged()
    {
        if (_disposed)
            return;
        // Marshalled, as a Source's change is: marks kept by a fetching Source answer
        // their counts from whatever thread the server's answer arrived on.
        _ = InvokeAsync(() =>
        {
            if (!_disposed)
                StateHasChanged();
        });
    }

    /// <summary>Whether the row at this data is marked — asked only while a Mark Column
    /// exists, so a grid without one asks nothing.</summary>
    private bool MarkedAt(TRow row) => _marks is not null && _marks.IsMarked(row);

    private Task RaiseRowMarkAsync(TRow row, bool marked)
        => _marks?.OnMarkIntentAsync(new RowMarkIntent<TRow>.OneRow(row, marked)) ?? Task.CompletedTask;

    /// <summary>The Detail rows "Mark all N rows" offers: the Consumer's count where it
    /// has answered, the result's row count until then.</summary>
    private int MarkableRows => _marks?.Counts?.RowsInResult ?? TotalRows;

    private bool ShowsMarkStatus => _markColumn >= 0 && (PageSize is not null || MarkCountText() is not null);

    /// <summary>"N marked", with the clause that names the marks outside the current
    /// filter whenever there are any (ADR-0043) — or null while nothing is marked, or
    /// while the counts are not known.</summary>
    private string? MarkCountText()
    {
        if (_markColumn < 0 || _marks?.Counts is not { } counts || counts.Marked == 0)
            return null;
        return counts.MarkedOutsideResult == 0
            ? string.Create(CultureInfo.InvariantCulture, $"{counts.Marked} marked")
            : string.Create(CultureInfo.InvariantCulture,
                $"{counts.Marked} marked ({counts.MarkedOutsideResult} outside the current filter)");
    }

    /// <summary>The rows of the current page, as positions in the whole result.</summary>
    private RowRange? PageRows()
    {
        if (PageSize is not { } size)
            return null;
        var count = Math.Min(size, TotalRows - _pageStartRow);
        return count > 0 ? new RowRange(_pageStartRow, count) : null;
    }

    /// <summary>
    /// What the header checkbox shows (ADR-0043). Under a pager, the page — which is
    /// wholly in hand, so its rows are asked one by one and nothing is guessed. Otherwise
    /// the Consumer's counts, never the Window: a fully marked Window inside a larger
    /// result is "some". Counts not yet known claim neither none nor all.
    /// </summary>
    private string HeaderMarkChecked()
    {
        if (PageSize is not null)
        {
            if (PageRows() is not { } page)
                return "false";
            var marked = 0;
            var rows = 0;
            for (var r = page.Start; r < page.Start + page.Count; r++)
            {
                var slice = r - _windowStart;
                if (slice < 0 || slice >= _window.Count)
                    return "mixed";
                var data = _window[slice];
                if ((RowKind?.Invoke(data) ?? global::ExGrid.Rows.RowKind.Detail) != global::ExGrid.Rows.RowKind.Detail)
                    continue;
                rows++;
                if (MarkedAt(data))
                    marked++;
            }
            return marked == 0 ? "false" : marked == rows ? "true" : "mixed";
        }
        if (_marks?.Counts is not { } counts)
            return "mixed";
        return RowMarkRules.HeaderState(counts) switch
        {
            RowMarkHeaderState.None => "false",
            RowMarkHeaderState.All => "true",
            _ => "mixed",
        };
    }

    /// <summary>The header's checkbox: painted inside the Mark Column's header cell,
    /// stopping its press there so the header's own click — a sort — never sees it.</summary>
    private RenderFragment HeaderMark => _headerMark ??= builder =>
    {
        builder.OpenElement(0, "button");
        builder.AddAttribute(1, "type", "button");
        builder.AddAttribute(2, "class", "ex-mark ex-mark-all");
        builder.AddAttribute(3, "role", "checkbox");
        builder.AddAttribute(4, "aria-checked", HeaderMarkChecked());
        builder.AddAttribute(5, "aria-label", "Mark all rows");
        builder.AddAttribute(6, "tabindex", "-1");
        builder.AddEventPreventDefaultAttribute(7, "onmousedown", true);
        builder.AddEventStopPropagationAttribute(8, "onmousedown", true);
        builder.AddEventStopPropagationAttribute(9, "onclick", true);
        builder.AddAttribute(10, "onclick", EventCallback.Factory.Create<MouseEventArgs>(this, _onHeaderMark));
        builder.CloseElement();
    };

    /// <summary>
    /// The header press (ADR-0043). Under a pager it lines up the page's rows — a single
    /// gesture does not vault past the page (ADR-0015) — and the whole result is offered
    /// beside the count. Otherwise it marks every row of the current result, as it stands
    /// now, unless all are marked already.
    /// </summary>
    private Task PressHeaderMarkAsync()
    {
        if (_marks is null)
            return Task.CompletedTask;
        if (PageSize is not null)
        {
            return PageRows() is { } page
                ? _marks.OnMarkIntentAsync(new RowMarkIntent<TRow>.Positions([page], _sequenceVersion))
                : Task.CompletedTask;
        }
        var state = _marks.Counts is { } counts ? RowMarkRules.HeaderState(counts) : RowMarkHeaderState.Some;
        return _marks.OnMarkIntentAsync(new RowMarkIntent<TRow>.AllRows(RowMarkRules.HeaderPress(state), _sequenceVersion));
    }

    /// <summary>"Mark all N rows", under a pager: the explicit step past the page.</summary>
    private Task MarkWholeResultAsync()
        => _marks?.OnMarkIntentAsync(new RowMarkIntent<TRow>.AllRows(true, _sequenceVersion)) ?? Task.CompletedTask;

    /// <summary>
    /// Space with the Focus in the Mark Column (ADR-0043): every row with a selected cell
    /// in that column, once each, as positions under the order they were taken in — past
    /// the Window the grid has no identity to name them by. The Consumer lines them up.
    /// </summary>
    private Task MarkSelectedRowsAsync()
    {
        if (_marks is null)
            return Task.CompletedTask;
        var spans = new List<(int Start, int End)>();
        foreach (var range in _selection.Selection.Ranges)
        {
            if (range.LeftColumn <= _markColumn && _markColumn < range.LeftColumn + range.ColumnCount)
                spans.Add((range.TopRow, range.TopRow + range.RowCount));
        }
        if (spans.Count == 0)
            return Task.CompletedTask;
        spans.Sort();
        var merged = new List<RowRange>();
        var (start, end) = spans[0];
        foreach (var (s, e) in spans.Skip(1))
        {
            if (s <= end)
            {
                end = Math.Max(end, e);
                continue;
            }
            merged.Add(new RowRange(start, end - start));
            (start, end) = (s, e);
        }
        merged.Add(new RowRange(start, end - start));
        return _marks.OnMarkIntentAsync(new RowMarkIntent<TRow>.Positions(merged, _sequenceVersion));
    }

    /// <summary>
    /// Stops the grid's timers, unsubscribes from the Source — which the Consumer built,
    /// and so disposes itself (ADR-0025) — and releases this instance's handle in the
    /// script module, whose listeners go with it (ADR-0018).
    /// </summary>
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        // A Find step still out is nobody's any more: the Consumer's search is told to stop
        // (ADR-0055, the fetching Source's rule).
        _findCancellation?.Cancel();
        _findCancellation = null;
        _settleTimer?.Dispose();
        _edgeTimer?.Dispose();
        _announceTimer?.Dispose();
        _messageTimer?.Dispose();
        if (_boundSource is not null)
        {
            _boundSource.StateChanged -= OnSourceStateChanged;
            (_boundSource as IBindsToOneCircuit)?.Binding.Detach(this);
            _boundSource = null;
        }
        if (_boundMarks is not null)
        {
            _boundMarks.Changed -= OnMarksChanged;
            _boundMarks = null;
        }
        try
        {
            try
            {
                if (_scrollHandle is not null)
                {
                    // Releasing the .NET reference does not run the handle's own dispose;
                    // a grid gives back what it took (ADR-0018).
                    await _scrollHandle.InvokeVoidAsync("dispose");
                    await _scrollHandle.DisposeAsync();
                }
            }
            // OperationCanceledException: a Blazor Server circuit going away cancels
            // every JS call still pending, these among them — as benign as a disconnect,
            // and left unhandled it ended the circuit with an error in the host log
            // (CON-6). Caught per resource, so one failing does not skip the next.
            catch (Exception ex) when (ex is JSException or JSDisconnectedException or ObjectDisposedException or OperationCanceledException)
            {
            }
            try
            {
                if (_module is not null)
                    await _module.DisposeAsync();
            }
            catch (Exception ex) when (ex is JSException or JSDisconnectedException or ObjectDisposedException or OperationCanceledException)
            {
            }
        }
        finally
        {
            // After the handle's own dispose has removed the listener, never before: a
            // key arriving in between would invoke a reference that has already been
            // released, and the module would report it as a fault when it is only a race
            // with teardown.
            _self?.Dispose();
            _self = null;
        }
    }

    private static object RowKey(TRow row) => RowIdentityKeys.GetValue(row, static _ => new object());

    /// <summary>
    /// The Geometry Tokens, inline on the instance root and emitted from the same
    /// resolved metrics the arithmetic reads (ADR-0027/0028) — inline so no stylesheet
    /// can override one, cached so an unchanged geometry costs no string per render.
    /// </summary>
    private string RootStyle()
    {
        var stretch = (ViewportWidth.IsStretch, ViewportHeight.IsStretch);
        if (_rootStyle.Length == 0 || stretch != _rootStyleStretch || FormulaBarPx != _rootStyleBarPx)
        {
            _rootStyleStretch = stretch;
            _rootStyleBarPx = FormulaBarPx;
            _rootStyle = string.Create(
                CultureInfo.InvariantCulture,
                $"--ex-row-height: {_metrics.RowHeightPx}px; --ex-header-height: {_metrics.HeaderHeightPx}px; --ex-font-size: {_metrics.FontSizePx}px; --ex-cell-padding-x: {_metrics.CellPaddingXPx}px; --ex-action-padding-x: {_metrics.ActionPaddingXPx}px; --ex-action-border-width: {_metrics.ActionBorderPx}px; --ex-action-gap: {_metrics.ActionGapPx}px; --ex-menu-button-width: {_metrics.MenuButtonWidthPx}px; --ex-menu-button-inset: {_metrics.MenuButtonInsetPx}px; --ex-sort-mark-width: {_metrics.SortMarkWidthPx}px{StretchRootStyle(stretch.Item1, stretch.Item2)}{FormulaBarRootStyle()}");
        }
        return _rootStyle;
    }

    /// <summary>
    /// The room at the root's top the Formula Bar stands in (ADR-0051/0028): the root's
    /// padding, so the scroller and everything after it start below the band, and under a
    /// Stretch height the scroller's flex share is what the band leaves. Nothing while the bar
    /// is off.
    /// </summary>
    private string FormulaBarRootStyle()
        => ShowFormulaBar
            ? FormattableString.Invariant($"; padding-top: {FormulaBarPx}px; box-sizing: border-box")
            : "";

    private double _rootStyleBarPx;

    /// <summary>The Formula Bar's height, or zero while it is off (ADR-0051).</summary>
    private double FormulaBarPx => ShowFormulaBar ? _metrics.FormulaBarHeightPx : 0;

    /// <summary>The band's box: its resolved height, and the scroller's width where that is
    /// declared (ADR-0028). Under a Stretch width the stylesheet's right edge stands.</summary>
    private string FormulaBarStyle()
        => ViewportWidth.IsStretch
            ? FormattableString.Invariant($"height: {FormulaBarPx}px; right: 0")
            : FormattableString.Invariant($"height: {FormulaBarPx}px; width: {ViewportWidth.Px}px");

    private string NameBoxStyle()
        => FormattableString.Invariant($"width: {_metrics.NameBoxWidthPx}px");

    /// <summary>
    /// Under Stretch the core gives its own elements the parent's size (ADR-0028, "Which
    /// element takes the box"). A Stretch height makes the root a column as tall as its parent,
    /// in which the scroller takes what the pager and the status line leave; the flex
    /// values let it take what a toolbar leaves in a flex parent, and do nothing in a block
    /// one. A Stretch width only has to be allowed to shrink in a flex row, since a block
    /// already takes its parent's width.
    /// </summary>
    private static string StretchRootStyle(bool stretchWidth, bool stretchHeight) => (stretchWidth, stretchHeight) switch
    {
        (true, true) => "; display: flex; flex-direction: column; height: 100%; flex: 1 1 auto; min-height: 0; min-width: 0",
        (false, true) => "; display: flex; flex-direction: column; height: 100%; flex: 1 1 auto; min-height: 0",
        (true, false) => "; min-width: 0",
        _ => "",
    };

    /// <summary>What the Layout Ceiling's probe is declared: 2^25 px, more than any
    /// browser lays out, so the size it is laid out at is the ceiling (ADR-0053). Inline,
    /// from here, because it is geometry (ADR-0027).</summary>
    private static readonly string CeilingProbeStyle = "width: 1px; height: 33554432px";

    /// <summary>
    /// The browser told the Layout Ceiling (ADR-0053, ADR-0021's sixth entry): at attach,
    /// and again only when the display scale or the page zoom moves it.
    ///
    /// <para>The first report is the initial measurement, not a change: nothing is
    /// re-anchored. The browser's offset at that moment is read and painted through the new
    /// geometry, so a scroll to the end made before the grid knew its ceiling — which the
    /// uncompressed geometry read as a row far short of the end — stays at the end.</para>
    ///
    /// <para>A later report keeps the first visible row where it is — a zoom is not a
    /// navigation — by anchoring on its content offset, as a row-height change does
    /// (ADR-0028), and the browser is told the scroll offset that shows it under the new
    /// mapping, unless a scroll the grid has not heard yet has moved it since.</para>
    ///
    /// <para>Called by the grid's own script module and not for Consumers: it is public
    /// only because JavaScript interop requires it.</para>
    /// </summary>
    [JSInvokable]
    public async Task OnLayoutCeilingAsync(double ceilingPx)
    {
        // It crosses the JS boundary, so nothing here is trusted: a NaN would travel into
        // every offset, and a zero would refuse a grid for a hidden probe.
        if (_disposed || !double.IsFinite(ceilingPx) || ceilingPx <= 0)
            return;
        var first = !_layoutCeilingTold;
        _layoutCeilingTold = true;
        if (ceilingPx == _layoutCeilingPx)
            return;
        var anchor = _visible is not null ? _geometry.ContentOffsetAt(_scrollTopPx) : (double?)null;
        _layoutCeilingPx = ceilingPx;
        // Neither before nor after compressed — every grid at 100%, and every grid whose
        // rows fit at any scale: the offsets mean what they meant, and nothing is rendered
        // or told. The next PrepareRender reads the new ceiling all the same.
        if (!_geometry.IsCompressed && _geometry.ContentHeightPx <= ceilingPx - BandHeightPx)
            return;
        try
        {
            // The first report is the measurement, not a change: nothing is anchored, and the
            // offset last known is painted through the geometry this ceiling gives.
            _anchorContentPx = first ? null : anchor;
            PrepareRender();
            StateHasChanged();
            // Then where the browser stands now is read, as any scroll is: a scroll the grid
            // has not heard yet is painted rather than waited for. Before the module lands
            // there is nothing to read, and attach reads the offset itself.
            if (first)
                await OnScrollAsync();
        }
        catch (Exception ex)
        {
            // Not a UI event, so nothing else would surface this.
            await DispatchExceptionAsync(ex);
        }
    }

    /// <summary>The rows' own layer: its offset transform, and — while tiers exist —
    /// the band it starts under, which the stylesheet's one-tier default cannot know
    /// (ADR-0032). Geometry travels inline (ADR-0027).</summary>
    private string ViewportStyle()
    {
        // Placed from the offset the slice is painted at — the browser's, or the one a
        // reveal is writing in this same render (ADR-0012): compressed, where the rows stand
        // depends on it and not only on the slice (ADR-0053); otherwise this is the first
        // painted row's own offset, as it always was.
        var transform = FormattableString.Invariant(
            $"transform: translateY({_geometry.PaintedTopPxOf((_visible?.Start ?? _pageStartRow) - _pageStartRow, _scrollTopPx)}px)");
        // The stylesheet's default is one header tier; tiers and a hidden header
        // (ADR-0050) both move where the rows begin, so the band's height travels inline.
        return _headerLayout.TierCount == 0 && !HideHeader
            ? transform
            : FormattableString.Invariant($"top: {BandHeightPx}px; {transform}");
    }

    /// <summary>The band's own height while tiers exist; the leaf line-height stays one
    /// tier's (ADR-0032). Null leaves the stylesheet's one-tier default in charge.</summary>
    private string? HeaderBandStyle()
        => _headerLayout.TierCount == 0
            ? null
            : FormattableString.Invariant(
                $"height: {BandHeightPx}px; line-height: {_metrics.HeaderHeightPx}px");

    // Interned per combination, the CellClasses economy: a header cell's class is
    // never composed in the render loop (ADR-0027 P5).
    private static readonly string[] HeaderClasses =
    [
        "ex-header-cell", "ex-header-cell ex-pinned",
        "ex-header-cell ex-align-left", "ex-header-cell ex-pinned ex-align-left",
        "ex-header-cell ex-align-center", "ex-header-cell ex-pinned ex-align-center",
        "ex-header-cell ex-align-right", "ex-header-cell ex-pinned ex-align-right",
    ];

    private string HeaderClass(int column, bool pinned)
        => HeaderClasses[((int)Columns[column].HeaderAlign * 2) + (pinned ? 1 : 0)];

    /// <summary>
    /// One leaf header's style: the cached width and offset, and — while tiers exist —
    /// its own height, anchored to the band's bottom edge. A column no tier covers
    /// stretches the full band with nothing declared (ADR-0032).
    /// </summary>
    private string HeaderCellStyle(int column, bool pinned)
    {
        var cached = pinned ? _columnStyles.PinnedCell(column) : _columnStyles.Cell(column);
        if (_headerLayout.TierCount == 0)
            return cached;
        ForgetTieredStylesIfStale();
        return _leafHeaderStyles[column] ??= ComposeLeafHeaderStyle(column, cached);
    }

    private string ComposeLeafHeaderStyle(int column, string cached)
    {
        var heightPx = _headerLayout.LeafTierSpanOf(column) * _metrics.HeaderHeightPx;
        return FormattableString.Invariant(
            $"{cached}; align-self: flex-end; height: {heightPx}px; line-height: {heightPx}px");
    }

    // A tiered header's styles — each leaf's height and each rectangle's box — cached
    // alongside the three things that produce them: the column geometry, the resolved
    // layout and the tier height (ADR-0027 P5). The root renders on every scroll frame,
    // and composed there, they were a string per leaf and per rectangle per frame (PF-3).
    // A pinned leaf and a scrollable one never share an index, so one slot per column is
    // enough.
    private ColumnStyles? _tieredStylesGeometry;
    private HeaderGroupLayout? _tieredStylesLayout;
    private double _tieredStylesTierPx = double.NaN;
    private string?[] _leafHeaderStyles = [];
    private string?[] _groupStyles = [];

    private void ForgetTieredStylesIfStale()
    {
        if (ReferenceEquals(_tieredStylesGeometry, _columnStyles)
            && ReferenceEquals(_tieredStylesLayout, _headerLayout)
            && _tieredStylesTierPx == _metrics.HeaderHeightPx)
        {
            return;
        }
        _tieredStylesGeometry = _columnStyles;
        _tieredStylesLayout = _headerLayout;
        _tieredStylesTierPx = _metrics.HeaderHeightPx;
        _leafHeaderStyles = new string?[_columnStyles.Geometry.Count];
        _groupStyles = new string?[_headerLayout.Groups.Count];
    }

    /// <summary>A group inside the pinned block is held at the left edge, unless pinning is
    /// suspended and every column scrolls (ADR-0032/0045).</summary>
    private bool IsGroupHeld(ResolvedHeaderGroup group)
        => group.Pinned && !_columnStyles.Geometry.IsPinningSuspended;

    /// <summary>One rectangle's box, from the numbers layout already has (ADR-0032):
    /// <c>left = OffsetPxOf(first member)</c>, width to past-last, height in tiers —
    /// standing correctly whether or not its leaves are in the DOM.</summary>
    private string GroupStyle(int index)
    {
        ForgetTieredStylesIfStale();
        return _groupStyles[index] ??= ComposeGroupStyle(_headerLayout.Groups[index]);
    }

    private string ComposeGroupStyle(ResolvedHeaderGroup group)
    {
        var geometry = _columnStyles.Geometry;
        var leftPx = geometry.OffsetPxOf(group.FirstColumn);
        var widthPx = geometry.OffsetPxOf(group.FirstColumn + group.MemberCount - 1)
            + geometry.WidthPxOf(group.FirstColumn + group.MemberCount - 1) - leftPx;
        var topPx = (_headerLayout.TierCount - group.TopTier) * _metrics.HeaderHeightPx;
        var heightPx = group.TierSpan * _metrics.HeaderHeightPx;
        return FormattableString.Invariant(
            $"left: {leftPx}px; top: {topPx}px; width: {widthPx}px; height: {heightPx}px; line-height: {heightPx}px");
    }

    /// <summary>A declared axis is written inline; a Stretch axis is left to the
    /// Consumer's CSS, whose answer comes back through the report (ADR-0028).</summary>
    private string ScrollerStyle()
    {
        // Under a Stretch height the scroller takes what is left of the root's column
        // (ADR-0028): never its content's height, which is where the empty loop settled.
        if (ViewportWidth.IsStretch && ViewportHeight.IsStretch)
            return "flex: 1 1 auto; min-height: 0";
        // The Formula Bar comes out of a declared height (ADR-0051/0028): the scroller is
        // what the band leaves.
        if (ViewportWidth.IsStretch)
            return FormattableString.Invariant($"height: {ViewportHeight.Px - FormulaBarPx}px");
        if (ViewportHeight.IsStretch)
            return FormattableString.Invariant($"width: {ViewportWidth.Px}px; flex: 1 1 auto; min-height: 0");
        return FormattableString.Invariant($"width: {ViewportWidth.Px}px; height: {ViewportHeight.Px - FormulaBarPx}px");
    }

    private static string Px(double value) => FormattableString.Invariant($"{value}px");
}

@code {
    /// <summary>
    /// The built-in menus' items — the column menu's and the Context Menu's alike
    /// (ADR-0010/0036). The keys are the items' own once they hold DOM focus (ADR-0039),
    /// and what each one means is <see cref="MenuKeys"/>' — the table every Chrome answers
    /// to. Every key's default is prevented: an arrow, Home or End would otherwise scroll
    /// the page under the menu, and Enter and Space run the item here rather than through
    /// the button's own click. An enabled item is captured so the arrows can move to it; a
    /// disabled one cannot hold focus at all.
    /// </summary>
    private void BuiltInMenuItems(
        RenderTreeBuilder __builder, IReadOnlyList<GridCommand> commands, MenuKeyResolver resolve, bool lettered)
    {
        for (var i = 0; i < commands.Count; i++)
        {
            var item = i;
            var command = commands[i];
            if (command.Enabled)
            {
                <button type="button" role="menuitem" @ref="_menuItems[item]"
                        @onclick="command.Invoke"
                        @onkeydown="e => OnMenuItemKeyAsync(e, commands, resolve)" @onkeydown:preventDefault>@LabelWithLetter(command, lettered)</button>
            }
            else
            {
                <button type="button" role="menuitem" disabled>@LabelWithLetter(command, lettered)</button>
            }
        }
    }

    /// <summary>
    /// A command's label, with the letter it answers to the way Excel shows it (ADR-0044):
    /// underlined where the label has it, appended as "(S)" where it does not. Only the
    /// column menu's sort and clear-filter commands have one — the Context Menu answers no
    /// letter, so it marks none; the underline is the markup's own, so a theme that
    /// restyles <c>u</c> restyles it.
    /// </summary>
    private RenderFragment LabelWithLetter(GridCommand command, bool lettered) => __builder =>
    {
        var label = LabelOf(command);
        if (lettered && MenuKeys.LetterOf(command.Id) is { } letter)
        {
            var (before, key, after) = MenuKeys.SplitAtLetter(label, letter);
            @before<u>@key</u>@after
        }
        else
        {
            @label
        }
    };
}
