<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- Single-target net10.0; newer runtimes load it as-is (ADR-0022). -->
    <TargetFramework>net10.0</TargetFramework>
    <Description>An Excel-like grid for Blazor: virtualised on both axes, with pinned columns, rectangular selection, the keyboard and the clipboard as a spreadsheet user expects them. The Consumer owns the data, sorting and filtering; the grid displays and notifies.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- The lowest 10.0.x: the consumer's application resolves it upward, and a higher
         version here would silently raise the real floor (ADR-0022). -->
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.0" />
    <!-- The family's data package, for the Aggregations' one definition, which the Selection
         Summary shares with ExPivot (ADR-0130). Not the Snapshot: ExGrid has not adopted it
         (ADR-0064). No other dependency (ADR-0019). -->
    <ProjectReference Include="..\ExGrid.Data\ExGrid.Data.csproj" />
  </ItemGroup>

  <!-- Test projects only, never a package (ADR-0201): a sibling or a Wrapper that needed an
       internal would be doing what a third party's Wrapper could not (ADR-0030, FL-1). -->
  <ItemGroup>
    <!-- Layer 1 pins the core's machinery: the key table, the clipboard, fill and overflow
         rules, the geometry, the selection's transitions. -->
    <InternalsVisibleTo Include="ExGrid.Tests" />
    <!-- Layer 2 stubs the scroll offsets the script answers, and drives a paste by its text. -->
    <InternalsVisibleTo Include="ExGrid.Components" />
    <!-- Each product's layer 2 does the same through the grid it draws, and every bUnit project
         compiles tests/ShippedScript.cs, which asks for the script's address as the grid does. -->
    <InternalsVisibleTo Include="ExGrid.MudBlazor.Tests" />
    <InternalsVisibleTo Include="ExSheet.Components.Tests" />
    <InternalsVisibleTo Include="ExSheet.MudBlazor.Tests" />
    <InternalsVisibleTo Include="ExPivot.Components.Tests" />
    <InternalsVisibleTo Include="ExPivot.MudBlazor.Tests" />
    <InternalsVisibleTo Include="ExChart.Components.Tests" />
    <InternalsVisibleTo Include="ExBoard.Tests" />
    <!-- The keyboard reference is checked against the key table the core answers by. -->
    <InternalsVisibleTo Include="ExGrid.Docs.Generator.Tests" />
  </ItemGroup>

  <!-- The Script Core's module for ExGrid.Script.ExGrid (ADR-0350 section 7): the bridge, bundled from its sources
       in src/npm as this project builds, never committed, so a change to the core is in the next build of every
       Blazor host with nothing to regenerate by hand; and the Shared Script beside it, @ex-grid/core and the data it
       reads, which the bridge and every other product's Blazor module import by one address (ADR-0411). Both go to
       wwwroot, where the package serves them; the bridge's version and stamp (ADR-0123) are compiled in as
       ScriptCoreAsset. The build needs Node, and src/npm's dependencies, which it installs once. -->
  <PropertyGroup>
    <ScriptCoreWorkspace>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', 'npm'))</ScriptCoreWorkspace>
    <ScriptCoreModule>$(MSBuildThisFileDirectory)wwwroot/ex-grid-core.min.js</ScriptCoreModule>
    <ScriptCoreConstants>$(MSBuildThisFileDirectory)$(BaseIntermediateOutputPath)ScriptCore/ScriptCoreAsset.g.cs</ScriptCoreConstants>
  </PropertyGroup>

  <ItemGroup>
    <ScriptCoreSource Include="$(ScriptCoreWorkspace)core/src/**/*.ts;$(ScriptCoreWorkspace)data/src/**/*.ts;$(ScriptCoreWorkspace)blazor/src/**/*.ts" />
    <ScriptCoreSource Include="$(ScriptCoreWorkspace)scripts/build-blazor.mjs;$(ScriptCoreWorkspace)package-lock.json" />
    <Content Remove="wwwroot/ex-grid-core.min.js;wwwroot/ex-grid-core.min.js.map;wwwroot/ex-grid-script.min.js;wwwroot/ex-grid-script.min.js.map" />
  </ItemGroup>

  <!-- npm ci again whenever the lock file is newer than what it installed: a pull that moves a dependency
       is bundled with that dependency, never the one installed before. -->
  <Target Name="InstallScriptCore"
          Inputs="$(ScriptCoreWorkspace)package-lock.json" Outputs="$(ScriptCoreWorkspace)node_modules/.package-lock.json">
    <Exec Command="npm ci --no-audit --no-fund" WorkingDirectory="$(ScriptCoreWorkspace)" />
  </Target>

  <Target Name="BuildScriptCore" DependsOnTargets="InstallScriptCore"
          Inputs="@(ScriptCoreSource)" Outputs="$(ScriptCoreModule);$(MSBuildThisFileDirectory)wwwroot/ex-grid-script.min.js;$(ScriptCoreConstants)">
    <Exec Command="node ../scripts/build-blazor.mjs --out &quot;$(MSBuildThisFileDirectory)wwwroot&quot; --stamp &quot;$(MSBuildThisFileDirectory)$(BaseIntermediateOutputPath)ScriptCore/ex-grid-core.stamp.json&quot; --cs &quot;$(ScriptCoreConstants)&quot; --ships-shared"
          WorkingDirectory="$(ScriptCoreWorkspace)blazor" />
  </Target>

  <!-- Apart from the build, which is skipped while its outputs are newer than every source: the items are
       added on every build, so the static web assets and the compile always hold the module. -->
  <Target Name="IncludeScriptCore" DependsOnTargets="BuildScriptCore"
          BeforeTargets="BeforeBuild;CoreCompile;ResolveProjectStaticWebAssets;ResolveStaticWebAssetsConfiguration">
    <ItemGroup>
      <Content Remove="wwwroot/ex-grid-core.min.js;wwwroot/ex-grid-core.min.js.map;wwwroot/ex-grid-script.min.js;wwwroot/ex-grid-script.min.js.map" />
      <Content Include="wwwroot/ex-grid-core.min.js;wwwroot/ex-grid-core.min.js.map;wwwroot/ex-grid-script.min.js;wwwroot/ex-grid-script.min.js.map" />
      <Compile Remove="$(ScriptCoreConstants)" />
      <Compile Include="$(ScriptCoreConstants)" />
    </ItemGroup>
  </Target>

  <!-- Exactly the ExGrid.Data this core was built with, as the engine takes it (DA-1). -->
  <Target Name="DependOnExactlyThisData" AfterTargets="_GetProjectReferenceVersions">
    <ItemGroup>
      <_ProjectReferencesWithVersions Update="@(_ProjectReferencesWithVersions)" ProjectVersion="[%(ProjectVersion)]" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <!-- The browser's calls in their order, a call too large for a circuit's message among them: compiled into each
         Script adapter, beside the Shared Script's half (src/npm/blazor/src/held-messages.ts). -->
    <Compile Include="..\Shared\Script\HeldCalls.cs" Link="Script\HeldCalls.cs" />
    <Compile Include="..\Shared\Script\CrossedText.cs" Link="Script\CrossedText.cs" />
    <Compile Include="..\Shared\Script\RazorSlotHolders.cs" Link="Script\RazorSlotHolders.cs" />
    <Compile Include="..\Shared\Script\ScriptMetricsJson.cs" Link="Script\ScriptMetricsJson.cs" />
  </ItemGroup>

</Project>
