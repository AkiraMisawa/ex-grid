  },
  "devDependencies": {
    "@microsoft/api-extractor": "7.59.4",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "temporal-polyfill": "1.0.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.12"
  }
}
