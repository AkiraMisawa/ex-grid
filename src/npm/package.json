{
  "name": "ex-grid-npm",
  "private": true,
  "version": "0.0.0",
  "description": "The npm workspace of ExGrid's Script Core and its Framework Adapters (ADR-0350, section 13).",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "data",
    "data-xlsx",
    "core",
    "chart",
    "pivot-engine",
    "pivot",
    "board",
    "react",
    "chart-react",
    "mantine",
    "chart-mantine",
    "mui",
    "chart-mui",
    "blazor",
    "pivot-react",
    "pivot-mantine",
    "pivot-mui",
    "pivot-blazor",
    "chart-blazor",
    "board-react",
    "board-blazor",
    "sheet-engine",
    "sheet-xlsx",
    "sheet",
    "sheet-react",
    "sheet-blazor",
    "sheet-mantine",
    "sheet-mui"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "api": "npm run api --workspaces",
    "lint": "node lint/check.mjs",
    "test": "npm run test --workspaces",
    "typecheck": "npm run typecheck --workspaces"
  },
  "devDependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mantine/core": "9.7.4",
    "@mantine/hooks": "9.7.4",
    "@microsoft/api-extractor": "7.59.4",
    "@mui/material": "9.5.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.28.2",
    "happy-dom": "21.0.4",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "temporal-polyfill": "1.0.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.23.4 <23 || >=24.22.1 <25 || >=26.12.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
