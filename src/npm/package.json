{
  "name": "ex-grid-npm",
  "private": true,
  "version": "0.0.0",
  "description": "The npm workspace of ExGrid's Script Core and its Framework Adapters (ADR-0350, section 13).",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "data",
    "core",
    "chart",
    "chart-react",
    "pivot-engine",
    "pivot",
    "board",
    "react",
    "blazor",
    "pivot-react",
    "board-react",
    "sheet-engine",
    "sheet",
    "sheet-react"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "api": "npm run api --workspaces",
    "lint": "node lint/check.mjs",
    "test": "npm run test --workspaces",
    "typecheck": "npm run typecheck --workspaces"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "7.59.4",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.28.2",
    "happy-dom": "21.0.4",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "temporal-polyfill": "1.0.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.12"
  }
}
