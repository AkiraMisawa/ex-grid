{
  // The shipped sources alone, whose declarations API Extractor rolls up (scripts/build.mjs). The core and
  // the engine are read as they are published, from their builds.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "temp/types"
  },
  "include": ["src"]
}
