{
  // The sources and the tests, for the editor and for `npm run typecheck`. The engine and the file layer are read from
  // their sources, so a change to either is checked here before it is built.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "resolveJsonModule": true,
    "paths": {
      "@ex-grid/data-xlsx": ["../data-xlsx/src/index.ts"],
      "@ex-grid/sheet-engine": ["../sheet-engine/src/index.ts"]
    }
  },
  "include": ["src", "test", "*.config.ts"]
}
