{
  // The sources and the tests, for the editor and for `npm run typecheck`. The chart, the core, the data and the
  // grid's adapter are read from their sources, so a change to any is checked here before it is built.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "paths": {
      "@ex-grid/chart": ["../chart/src/index.ts"],
      "@ex-grid/core": ["../core/src/index.ts"],
      "@ex-grid/data": ["../data/src/index.ts"],
      "@ex-grid/react": ["../react/src/index.ts"]
    }
  },
  "include": ["src", "test"]
}
