{
  // The sources and the tests, for the editor and for `npm run typecheck`. The chart, its React adapter, the grid's
  // Mantine Wrapper and what they stand on are read from their sources, so a change to any is checked here before it
  // is built.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "paths": {
      "@ex-grid/chart": ["../chart/src/index.ts"],
      "@ex-grid/chart-react": ["../chart-react/src/index.ts"],
      "@ex-grid/core": ["../core/src/index.ts"],
      "@ex-grid/data": ["../data/src/index.ts"],
      "@ex-grid/mantine": ["../mantine/src/index.ts"],
      "@ex-grid/react": ["../react/src/index.ts"]
    }
  },
  "include": ["src", "test"]
}
