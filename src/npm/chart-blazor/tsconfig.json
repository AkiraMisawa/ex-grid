{
  // The sources and the tests, for the editor and for `npm run typecheck`. The chart, the grid core it reads its
  // metrics from and the data they read are read from their sources, as the bundle reads them.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "paths": {
      "@ex-grid/blazor-shared": ["../blazor/src/shared.ts"],
      "@ex-grid/core": ["../core/src/index.ts"],
      "@ex-grid/data": ["../data/src/index.ts"],
      "@ex-grid/chart": ["../chart/src/index.ts"]
    }
  },
  "include": ["src", "test"]
}
