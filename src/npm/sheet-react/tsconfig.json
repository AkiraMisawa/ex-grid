{
  // The sources and the tests, for the editor and for `npm run typecheck`. The Sheet, the core, the data and the
  // engine are read from their sources, so a change to any is checked here before it is built.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "paths": {
      "@ex-grid/core": ["../core/src/index.ts"],
      "@ex-grid/data": ["../data/src/index.ts"],
      "@ex-grid/sheet": ["../sheet/src/index.ts"],
      "@ex-grid/sheet-engine": ["../sheet-engine/src/index.ts"]
    }
  },
  "include": ["src", "test"]
}
