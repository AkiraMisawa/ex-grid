{
  "name": "@ex-grid/pivot-mui",
  "version": "0.0.0-dev",
  "description": "ExPivot for MUI: the design-system Wrapper that draws ExPivot for React's Chrome — the Field List, the Pivot Toolbar, its menus and panels, the report filters, the Stale Report's notice and Show Details' tabs and dialog — with MUI's components, and maps the pivot's Visual Tokens onto a MUI theme made with CSS variables.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AkiraMisawa/ex-grid.git",
    "directory": "src/npm/pivot-mui"
  },
  "homepage": "https://akiramisawa.github.io/ex-grid/",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist/index.js",
    "dist/index.js.map",
    "dist/index.d.ts",
    "styles.css"
  ],
  "scripts": {
    "build": "node ../scripts/build.mjs",
    "api": "node ../scripts/build.mjs --local",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ex-grid/mui": "0.0.0-dev",
    "@ex-grid/pivot": "0.0.0-dev",
    "@ex-grid/pivot-react": "0.0.0-dev"
  },
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/material": "^9.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
