{
  // The sources, the tests and the differential runs, for the editor and for `npm run typecheck`. @ex-grid/data is read from
  // its sources, so a change to it is checked here before it is built.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "resolveJsonModule": true,
    "paths": { "@ex-grid/data": ["../data/src/index.ts"] }
  },
  "include": ["src", "test", "differential", "*.config.ts"]
}
