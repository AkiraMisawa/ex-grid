{
  "name": "@ex-grid/sheet-mantine",
  "version": "0.0.0-dev",
  "description": "ExSheet for Mantine: the design-system Wrapper that draws ExSheet for React's Chrome, the Sheet Toolbar, Format Cells and the Sheet Tabs among it, with Mantine's components and maps its Visual Tokens onto a Mantine theme.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AkiraMisawa/ex-grid.git",
    "directory": "src/npm/sheet-mantine"
  },
  "homepage": "https://akiramisawa.github.io/ex-grid/",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist/index.js",
    "dist/index.js.map",
    "dist/index.d.ts",
    "styles.css"
  ],
  "scripts": {
    "build": "node ../scripts/build.mjs",
    "api": "node ../scripts/build.mjs --local",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ex-grid/mantine": "0.0.0-dev",
    "@ex-grid/sheet": "0.0.0-dev",
    "@ex-grid/sheet-engine": "0.0.0-dev",
    "@ex-grid/sheet-react": "0.0.0-dev"
  },
  "peerDependencies": {
    "@mantine/core": "^9.7.0",
    "@mantine/hooks": "^9.7.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
