@* Written in each component, not in an _Imports.razor, whose class Razor makes public (ADR-0201).
   This project's root namespace is ExPivot.MudBlazor, where a bare "MudBlazor" resolves to this
   namespace and MudBlazor's Color and Typo vanish: every product using is written with global::. *@
@using Microsoft.AspNetCore.Components
@using global::ExPivot
@using global::ExPivot.Chrome
@using global::MudBlazor
@* Not the contract (ADR-0201): MudPivotChrome draws this part, and no Consumer places it. It is
   public only because Razor makes every component public, is hidden from a Consumer's editor, and
   may change in any version. *@
@attribute [System.ComponentModel.EditorBrowsable(System.ComponentModel.EditorBrowsableState.Never)]
@* The Pivot Toolbar when the Script Core draws the pivot (ADR-0410): MudPivotToolbar's look, the
   report filter band's anchor on the left and, on the right, Layout ▾ in its positioned wrapper,
   Refresh where the source can be refreshed, and the Field List's toggle, as text MudButtons. Each
   button is marked with what a press does and its name, and each anchor with its name, drawn
   empty, so the pivot places the band and the Layout menu's frame in it alone; the presses, the
   keyboard and the frames are wired by the adapter's script in the browser. *@
<div class="mud-ex-pivot-toolbar">
    @* The band's anchor while the band stands, as PivotToolbarView says; the box keeps the toolbar's two ends apart either way. *@
    <div class="mud-ex-pivot-toolbar-start" @attributes="@(View.ReportFilters ? PivotSlotMarkup.Marked(PivotScriptSlotAttributes.Anchor, "report-filters") : NoMarks)"></div>
    <div class="mud-ex-pivot-toolbar-end">
        <span class="mud-ex-pivot-toolbar-anchor">
            <MudButton Variant="Variant.Text" Size="Size.Small" Class="mud-ex-pivot-toolbar-button mud-ex-pivot-layout-button"
                       StartIcon="@Chrome.IconFor(PivotCommandIds.LayoutMenu)" EndIcon="@Icons.Material.Filled.ArrowDropDown"
                       UserAttributes="@(PivotSlotMarkup.Marked(PivotScriptSlotAttributes.Press, "layout", PivotScriptSlotAttributes.Control, "layout")
                           .With("aria-haspopup", "menu").With("aria-expanded", View.LayoutMenuOpen ? "true" : "false"))">@View.LayoutLabel</MudButton>
            <span @attributes="@PivotSlotMarkup.Marked(PivotScriptSlotAttributes.Anchor, "layout")"></span>
        </span>
        @if (View.RefreshLabel is { } refresh)
        {
            <MudButton Variant="Variant.Text" Size="Size.Small" Class="mud-ex-pivot-toolbar-button mud-ex-pivot-refresh-button"
                       StartIcon="@Chrome.IconFor(PivotCommandIds.Refresh)"
                       UserAttributes="@PivotSlotMarkup.Marked(PivotScriptSlotAttributes.Press, "refresh", PivotScriptSlotAttributes.Control, "refresh")">@refresh</MudButton>
        }
        <MudButton Variant="Variant.Text" Size="Size.Small" Color="@(View.FieldListShown ? Color.Primary : Color.Default)"
                   Class="@(View.FieldListShown ? "mud-ex-pivot-toolbar-button mud-ex-pivot-field-list-toggle mud-ex-pivot-pressed" : "mud-ex-pivot-toolbar-button mud-ex-pivot-field-list-toggle")"
                   StartIcon="@Chrome.IconFor(PivotCommandIds.FieldListToggle)"
                   UserAttributes="@(PivotSlotMarkup.Marked(PivotScriptSlotAttributes.Press, "field-list", PivotScriptSlotAttributes.Control, "field-list")
                       .With("aria-pressed", View.FieldListShown ? "true" : "false"))">@View.FieldListLabel</MudButton>
    </div>
</div>
@if (View.Refusal is { } refusal)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mud-ex-pivot-refusal-notice" role="alert">@refusal</MudAlert>
}

@code {
    /// <summary>The Pivot Toolbar's view, as the Script Core hands it (ADR-0410).</summary>
    [Parameter, EditorRequired] public PivotToolbarView View { get; set; } = default!;

    /// <summary>Where the icons come from.</summary>
    [Parameter, EditorRequired] public MudPivotChrome Chrome { get; set; } = default!;

    private static readonly IReadOnlyDictionary<string, object?> NoMarks = new Dictionary<string, object?>();
}
