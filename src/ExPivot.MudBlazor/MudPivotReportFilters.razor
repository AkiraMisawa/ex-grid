@* Written in each component, not in an _Imports.razor, whose class Razor makes public (ADR-0201).
   This project's root namespace is ExPivot.MudBlazor, where a bare "MudBlazor" resolves to this
   namespace and MudBlazor's Color and Typo vanish (the collision AGENTS.md records for the grid's
   Wrapper): every product using is written with global::. *@
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using global::ExPivot
@using global::ExPivot.Chrome
@using global::ExPivot.Engine
@using global::MudBlazor
@* Not the contract (ADR-0201): MudPivotChrome draws this part, and no Consumer places it. It is
   public only because Razor makes every component public, is hidden from a Consumer's editor, and
   may change in any version. *@
@attribute [System.ComponentModel.EditorBrowsable(System.ComponentModel.EditorBrowsableState.Never)]
@* The report filter band under MudBlazor (ADR-0061/0062): each field in Filters with an outlined
   MudButton saying what it shows — (All), the one Item shown, or (Multiple Items) — in the primary
   colour while it hides Items. The button's wrapper is positioned, so ExPivot's Filter… frame
   opens under it, over the report. *@
<div class="mud-ex-pivot-filters" role="group" aria-label="@Context.Title">
    @foreach (var filter in Context.Filters)
    {
        <div @key="filter.Field" class="mud-ex-pivot-filter">
            <MudText Typo="Typo.body2" Class="mud-ex-pivot-filter-caption">@filter.Caption</MudText>
            <span class="mud-ex-pivot-filter-anchor">
                <MudPivotButton Variant="Variant.Outlined" Size="Size.Small"
                                Color="@(filter.IsFiltered ? Color.Primary : Color.Default)"
                                EndIcon="@Icons.Material.Filled.ArrowDropDown" Class="mud-ex-pivot-filter-button"
                                OnClick="filter.Open" FocusRequest="filter.FocusRequest"
                                aria-haspopup="dialog" aria-expanded="@(filter.IsOpen ? "true" : "false")"
                                aria-label="@PivotWords.Fill(Context.Word("filter-of"), filter.Caption)">
                    <span class="mud-ex-pivot-filter-summary">@filter.Summary</span>
                </MudPivotButton>
                @filter.Popup
            </span>
        </div>
    }
</div>

@code {
    /// <summary>The report filters and whom to call back (ADR-0061).</summary>
    [Parameter, EditorRequired] public PivotReportFiltersContext Context { get; set; } = default!;

    /// <summary>The Chrome this band belongs to.</summary>
    [Parameter, EditorRequired] public MudPivotChrome Chrome { get; set; } = default!;
}
