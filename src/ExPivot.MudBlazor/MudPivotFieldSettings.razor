@* Written in each component, not in an _Imports.razor, whose class Razor makes public (ADR-0201).
   This project's root namespace is ExPivot.MudBlazor, where a bare "MudBlazor" resolves to this
   namespace and MudBlazor's Color and Typo vanish (the collision AGENTS.md records for the grid's
   Wrapper): every product using is written with global::. *@
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using global::ExPivot
@using global::ExPivot.Chrome
@using global::ExPivot.Engine
@using global::ExGrid.Chrome
@using global::MudBlazor
@* Not the contract (ADR-0201): MudPivotChrome draws this part, and no Consumer places it. It is
   public only because Razor makes every component public, is hidden from a Consumer's editor, and
   may change in any version. *@
@attribute [System.ComponentModel.EditorBrowsable(System.ComponentModel.EditorBrowsableState.Never)]
@* Field Settings… under MudBlazor (ADR-0061/0062): a row or column field's order as a MudSelect and
   its subtotals as a MudRadioGroup, as ExPivot's draft until OK. The select's list is an Inner
   Popup (ADR-0039), reported through the context so that Escape closes the list before the panel.
   The select comes first, and takes DOM focus for each request, through the context's TakeKeyboard
   handed the box around it — the report's grid gives the keyboard to the first control inside, or,
   while no report stands, the grid's script does (ADR-0350) — at the end of the opening's turn. The select and the radios are the draft, claiming nothing
   (data-ex-claims=""); OK and Cancel are pressed in the pivot's Input Order, through the context's
   InOrder (ADR-0240 sections 1 and 6). *@
<div class="mud-ex-pivot-panel mud-ex-pivot-field-settings">
    <MudText Typo="Typo.subtitle2" Class="mud-ex-pivot-panel-title">@Context.FieldCaption</MudText>
    <div style="display: contents" @ref="_sortBox">
    <MudSelect T="int" Value="Context.Sort" ValueChanged="Context.SortChanged" ToStringFunc="SortLabel"
               Label="@Context.Word("sort-order")" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
               OpenChanged="Context.InnerPopupChanged" Class="mud-ex-pivot-sort" data-ex-claims="">
        @for (var i = 0; i < Context.Sorts.Count; i++)
        {
            var index = i;
            <MudSelectItem T="int" Value="index">@Context.Sorts[index].Label</MudSelectItem>
        }
    </MudSelect>
    </div>
    <MudText Typo="Typo.caption" Class="mud-ex-pivot-legend">@Context.Word("subtotals")</MudText>
    <MudRadioGroup T="bool" Value="Context.Subtotals" ValueChanged="Context.SubtotalsChanged" Class="mud-ex-pivot-subtotals">
        <MudRadio T="bool" Value="true" Dense="true" Size="Size.Small" Color="Color.Primary" data-ex-claims="">@Context.Word("subtotals-automatic")</MudRadio>
        <MudRadio T="bool" Value="false" Dense="true" Size="Size.Small" Color="Color.Primary" data-ex-claims="">@Context.Word("subtotals-none")</MudRadio>
    </MudRadioGroup>
    <div class="mud-ex-pivot-panel-actions">
        <MudPivotButton Variant="Variant.Text" Size="Size.Small" OnClick="Context.Cancel" InOrder="Context.InOrder"
                        Class="mud-ex-pivot-cancel">@Context.Word("cancel")</MudPivotButton>
        <MudPivotButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="Context.Apply"
                        InOrder="Context.InOrder" Class="mud-ex-pivot-ok">@Context.Word("ok")</MudPivotButton>
    </div>
</div>

@code {
    private ElementReference _sortBox;
    private int _acted;

    /// <summary>The draft and the exits (ADR-0061).</summary>
    [Parameter, EditorRequired] public PivotFieldSettingsContext Context { get; set; } = default!;

    /// <summary>The Chrome this panel belongs to.</summary>
    [Parameter, EditorRequired] public MudPivotChrome Chrome { get; set; } = default!;

    private string SortLabel(int index) => index >= 0 && index < Context.Sorts.Count ? Context.Sorts[index].Label : "";

    /// <inheritdoc />
    protected override Task OnAfterRenderAsync(bool firstRender)
        => MudPivotFocus.TakeAsync(Context.FocusRequest, ref _acted,
            _sortBox.Id is null ? null : () => new ValueTask(Context.TakeKeyboard(_sortBox)));
}
