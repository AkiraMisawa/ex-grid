@* Field Settings… under MudBlazor (ADR-0060/0061): a row or column field's order as a MudSelect and
   its subtotals as a MudRadioGroup, as ExPivot's draft until OK. The select's list is an Inner
   Popup (ADR-0039), reported through the context so that Escape closes the list before the panel.
   The select comes first, and takes DOM focus for each request: a MudRadio has no FocusAsync. *@
<div class="mud-ex-pivot-panel mud-ex-pivot-field-settings">
    <MudText Typo="Typo.subtitle2" Class="mud-ex-pivot-panel-title">@Context.FieldCaption</MudText>
    <MudSelect @ref="_sort" T="int" Value="Context.Sort" ValueChanged="Context.SortChanged" ToStringFunc="SortLabel"
               Label="@Context.Word("sort-order")" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
               OpenChanged="Context.InnerPopupChanged" Class="mud-ex-pivot-sort">
        @for (var i = 0; i < Context.Sorts.Count; i++)
        {
            var index = i;
            <MudSelectItem T="int" Value="index">@Context.Sorts[index].Label</MudSelectItem>
        }
    </MudSelect>
    <MudText Typo="Typo.caption" Class="mud-ex-pivot-legend">@Context.Word("subtotals")</MudText>
    <MudRadioGroup T="bool" Value="Context.Subtotals" ValueChanged="Context.SubtotalsChanged" Class="mud-ex-pivot-subtotals">
        <MudRadio T="bool" Value="true" Dense="true" Size="Size.Small" Color="Color.Primary">@Context.Word("subtotals-automatic")</MudRadio>
        <MudRadio T="bool" Value="false" Dense="true" Size="Size.Small" Color="Color.Primary">@Context.Word("subtotals-none")</MudRadio>
    </MudRadioGroup>
    <div class="mud-ex-pivot-panel-actions">
        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="Context.Cancel" Class="mud-ex-pivot-cancel">@Context.Word("cancel")</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="Context.Apply" Class="mud-ex-pivot-ok">@Context.Word("ok")</MudButton>
    </div>
</div>

@code {
    private MudSelect<int>? _sort;
    private int _acted;

    /// <summary>The draft and the exits (ADR-0060).</summary>
    [Parameter, EditorRequired] public PivotFieldSettingsContext Context { get; set; } = default!;

    /// <summary>The Chrome this panel belongs to.</summary>
    [Parameter, EditorRequired] public MudPivotChrome Chrome { get; set; } = default!;

    private string SortLabel(int index) => index >= 0 && index < Context.Sorts.Count ? Context.Sorts[index].Label : "";

    /// <inheritdoc />
    protected override Task OnAfterRenderAsync(bool firstRender)
        => MudPivotFocus.TakeAsync(Context.FocusRequest, ref _acted, _sort is { } sort ? () => sort.FocusAsync() : null);
}
