@using System.Globalization
@* Filter… under MudBlazor (ADR-0061/0062): a MudTextField that narrows the list, (Select All) as a
   tri-state MudCheckBox with Excel's mixed state, a MudCheckBox per Item, and Cancel / OK. The ticks
   are ExPivot's draft: this draws them and calls back, and OK stays disabled, with ExPivot's reason
   beside it, while every Item is unticked. The search takes DOM focus for each request. A first
   listing on its way is a MudProgressLinear; while a new Source Version's Items are on their way,
   the earlier version's stay listed, the list marked busy and no progress drawn — a live report
   brings a new version several times a second (ADR-0066 refined). *@
<div class="mud-ex-pivot-panel mud-ex-pivot-item-filter">
    <MudTextField @ref="_search" T="string" Value="Context.Search" ValueChanged="Context.SearchChanged" Immediate="true"
                  Label="@Context.Word("search-items")" Variant="Variant.Outlined" Margin="Margin.Dense"
                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                  Class="mud-ex-pivot-search" />
    <div class="mud-ex-pivot-item-list" role="group" aria-label="@Context.FieldCaption" aria-busy="@(Context.IsLoading || Context.IsUpdating ? "true" : null)">
        @if (Context.Unavailable is { } unavailable)
        {
            @* The source can no longer list the Items under the report's Source Version (ADR-0066). *@
            <MudText Typo="Typo.body2" Color="Color.Error" Class="mud-ex-pivot-unavailable" role="alert">@unavailable</MudText>
        }
        else if (Context.IsLoading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mud-ex-pivot-loading" />
        }
        else
        {
            @if (Context.Items.Count > 0)
            {
                @* Pressed while some or none are ticked, it ticks every Item the search leaves; pressed
                   while all are, it unticks them — whatever state MudBlazor's own cycle would go to. *@
                <MudCheckBox T="bool?" TriState="true" Value="Context.AllTicked" ValueChanged="@(_ => Context.SetAll(Context.AllTicked != true))"
                             Label="@Context.Word("select-all")" Dense="true" Size="Size.Small" Color="Color.Primary"
                             Class="mud-ex-pivot-select-all" />
            }
            @foreach (var item in Context.Items)
            {
                <MudCheckBox @key="item.Key" T="bool" Value="item.Ticked" ValueChanged="@(on => Context.SetTicked(item.Key, on))"
                             Label="@item.Label" Dense="true" Size="Size.Small" Color="Color.Primary" Class="mud-ex-pivot-item" />
            }
            @if (Context.MatchCount > Context.Items.Count)
            {
                <MudText Typo="Typo.caption" Class="mud-ex-pivot-note">@PivotWords.Fill(Context.Word("too-many-items"), Context.ListCap.ToString("N0", CultureInfo.CurrentCulture))</MudText>
            }
            @if (Context.Items.Count == 0)
            {
                <MudText Typo="Typo.caption" Class="mud-ex-pivot-note">@Context.Word("no-items-match")</MudText>
            }
        }
    </div>
    @if (Context.Refusal is { } refusal)
    {
        <MudText Typo="Typo.body2" Color="Color.Error" Class="mud-ex-pivot-refusal" role="alert">@refusal</MudText>
    }
    <div class="mud-ex-pivot-panel-actions">
        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="Context.Cancel" Class="mud-ex-pivot-cancel">@Context.Word("cancel")</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Disabled="!Context.CanApply"
                   OnClick="Context.Apply" Class="mud-ex-pivot-ok">@Context.Word("ok")</MudButton>
    </div>
</div>

@code {
    private MudTextField<string>? _search;
    private int _acted;

    /// <summary>The Items, the draft and the exits (ADR-0061).</summary>
    [Parameter, EditorRequired] public PivotItemFilterContext Context { get; set; } = default!;

    /// <summary>The Chrome this panel belongs to.</summary>
    [Parameter, EditorRequired] public MudPivotChrome Chrome { get; set; } = default!;

    /// <inheritdoc />
    protected override Task OnAfterRenderAsync(bool firstRender)
        => MudPivotFocus.TakeAsync(Context.FocusRequest, ref _acted, _search is { } search ? () => search.FocusAsync() : null);
}
