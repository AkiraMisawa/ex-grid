<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- Single-target net10.0, like every shipped package (ADR-0022). -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ExPivot.MudBlazor</RootNamespace>
    <Description>MudBlazor for ExPivot: a Chrome that draws the PivotTable Fields pane, its menus and panels, the Pivot Toolbar with its report filter band, Show Details' tabs and dialog, and the Stale Report's notice with MudBlazor's own controls, and a stylesheet mapping ExPivot's tokens onto the MudBlazor palette. The report's grid is dressed by ExGrid.MudBlazor. Ships at the same version as ExPivot and depends on exactly that version.</Description>
    <PackageTags>$(PackageTags);pivot;pivottable;mudblazor;material</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- 9.x from its floor, 9.6.0, as ExGrid.MudBlazor takes it (ADR-0022, ADR-0205). Below
         9.4.0 this package's own selects have no role and no name where the keyboard is, and
         below 9.2.0 Field Settings can open with the keyboard nowhere; the grid's Wrapper,
         which it brings in, needs 9.6.0. -->
    <PackageReference Include="MudBlazor" Version="[9.6.0,10.0.0)" />
  </ItemGroup>

  <ItemGroup>
    <!-- The one direction there is (ADR-0062): the Wrapper references ExPivot and the grid's
         Wrapper; nothing in either knows this package exists. -->
    <ProjectReference Include="..\ExPivot\ExPivot.csproj" />
    <ProjectReference Include="..\ExGrid.MudBlazor\ExGrid.MudBlazor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Wrapper's layer 2 reads the icons it falls back to, which a Consumer never calls
         (ADR-0201). Granted to the test project only, never to a package. -->
    <InternalsVisibleTo Include="ExPivot.MudBlazor.Tests" />
  </ItemGroup>

  <!-- Exactly the ExPivot and ExGrid.MudBlazor it was built with (ADR-0042), as the grid's
       Wrapper depends on exactly its core. -->
  <Target Name="DependOnExactlyTheseVersions" AfterTargets="_GetProjectReferenceVersions">
    <ItemGroup>
      <_ProjectReferencesWithVersions Update="@(_ProjectReferencesWithVersions)" ProjectVersion="[%(ProjectVersion)]" />
    </ItemGroup>
  </Target>

</Project>
