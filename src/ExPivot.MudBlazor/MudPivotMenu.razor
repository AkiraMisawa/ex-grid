@* Written in each component, not in an _Imports.razor, whose class Razor makes public (ADR-0201).
   This project's root namespace is ExPivot.MudBlazor, where a bare "MudBlazor" resolves to this
   namespace and MudBlazor's Color and Typo vanish (the collision AGENTS.md records for the grid's
   Wrapper): every product using is written with global::. *@
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using global::ExPivot
@using global::ExPivot.Chrome
@using global::ExPivot.Engine
@using global::MudBlazor
@* Not the contract (ADR-0201): MudPivotChrome draws this part, and no Consumer places it. It is
   public only because Razor makes every component public, is hidden from a Consumer's editor, and
   may change in any version. *@
@attribute [System.ComponentModel.EditorBrowsable(System.ComponentModel.EditorBrowsableState.Never)]
@* A menu under MudBlazor (ADR-0061/0062): a placed field's, or the Pivot Toolbar's Layout menu —
   exactly ExPivot's commands, in its order, each with its Enabled state, as text MudButtons with
   role="menuitem" and a Material icon. A choice among others is a menuitemradio, the current one
   marked as a checked radio button, and a group of them stands under its heading. The frame around them is
   ExPivot's, and so are what closes it and what each command does. The first enabled command takes
   DOM focus when the menu opens, scrolled into view: a menu opened at the foot of the pane is shown,
   at the end of the opening's turn, through the context's TakeKeyboard; each command is pressed in
   the pivot's Input Order, through the context's InOrder (ADR-0240 section 6). *@
<div class="mud-ex-pivot-menu" role="none">
    @for (var i = 0; i < Context.Commands.Count; i++)
    {
        var command = Context.Commands[i];
        @if (command.GroupHeading is { } heading)
        {
            <MudText Typo="Typo.caption" Class="mud-ex-pivot-menu-heading" aria-hidden="true">@heading</MudText>
        }
        <MudPivotButton @key="command.Id" role="@(command.Checked is null ? "menuitem" : "menuitemradio")"
                        aria-checked="@(command.Checked is { } chosen ? (chosen ? "true" : "false") : null)"
                        Variant="Variant.Text" Size="Size.Small" FullWidth="true"
                        Disabled="!command.Enabled" StartIcon="@IconOf(command)" OnClick="command.Invoke"
                        FocusRequest="@(command.Id == FocusedId ? Context.FocusRequest : 0)"
                        InOrder="Context.InOrder" TakeKeyboard="Context.TakeKeyboard"
                        Class="mud-ex-pivot-menu-item">@command.Label</MudPivotButton>
    }
</div>

@code {
    /// <summary>The commands and the request to take the keyboard (ADR-0061).</summary>
    [Parameter, EditorRequired] public PivotMenuContext Context { get; set; } = default!;

    /// <summary>Where the icons come from.</summary>
    [Parameter, EditorRequired] public MudPivotChrome Chrome { get; set; } = default!;

    // A choice is a radio button, checked where it is the current one, so the labels of a group
    // stand aligned and the mark reads as one choice among several.
    private string? IconOf(PivotCommand command) => command.Checked switch
    {
        true => Icons.Material.Filled.RadioButtonChecked,
        false => Icons.Material.Filled.RadioButtonUnchecked,
        null => Chrome.IconFor(command.Id),
    };

    private int _request;
    private string? _focusedId;

    // The command the request to take the keyboard was given to: the first enabled one when the
    // request was made, and the same one after. A press can disable the command it pressed, as
    // choosing a radio does; were the request to move on to the next enabled command, that one,
    // never asked, would take the keyboard after the turn had handed it back to the opener.
    private string? FocusedId
    {
        get
        {
            if (Context.FocusRequest != _request)
            {
                _request = Context.FocusRequest;
                _focusedId = null;
                foreach (var command in Context.Commands)
                {
                    if (command.Enabled)
                    {
                        _focusedId = command.Id;
                        break;
                    }
                }
            }
            return _focusedId;
        }
    }
}
