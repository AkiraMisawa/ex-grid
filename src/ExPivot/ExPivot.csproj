<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- Single-target net10.0, like every shipped package (ADR-0022). -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ExPivot</RootNamespace>
    <Description>ExPivot: Excel's PivotTable for Blazor, drawn by ExGrid as that grid's Consumer. The user builds a report from the application's own records in the PivotTable Fields pane — Filters, Columns, Rows, Values, drag and drop — and reads it with ExGrid's selection, keyboard and clipboard; the application persists the layout.</Description>
    <PackageTags>$(PackageTags);pivot;pivottable;report</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- The one direction there is (ADR-0059): ExPivot references its engine and ExGrid, and
         nothing references ExPivot but its Wrapper, the demo pages and its tests. -->
    <ProjectReference Include="..\ExPivot.Engine\ExPivot.Engine.csproj" />
    <ProjectReference Include="..\ExGrid\ExGrid.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ExPivot.Components.Tests" />
  </ItemGroup>

  <!-- ExPivot's Script Core's module for ExPivot.Script.ExPivot (ADR-0370 section 1): the bridge, @ex-grid/pivot
       and its engine, bundled from their sources in src/npm as this project builds, never committed, as ExGrid's is
       (ADR-0350 section 7). The grid it draws through, and the data it reads, it imports from the Shared Script
       ExGrid ships, built against the same sources (ADR-0411). The module goes to wwwroot, where the package serves it; its version and
       stamp (ADR-0123) are compiled in as ScriptCoreAsset. src/npm's dependencies are ExGrid's build's to install:
       the bundle is built once the project references are, so the two never run npm in the workspace at once. -->
  <PropertyGroup>
    <ScriptCoreWorkspace>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', 'npm'))</ScriptCoreWorkspace>
    <ScriptCoreModule>$(MSBuildThisFileDirectory)wwwroot/ex-pivot.min.js</ScriptCoreModule>
    <ScriptCoreConstants>$(MSBuildThisFileDirectory)$(BaseIntermediateOutputPath)ScriptCore/ScriptCoreAsset.g.cs</ScriptCoreConstants>
  </PropertyGroup>

  <ItemGroup>
    <ScriptCoreSource Include="$(ScriptCoreWorkspace)core/src/**/*.ts;$(ScriptCoreWorkspace)data/src/**/*.ts;$(ScriptCoreWorkspace)pivot-engine/src/**/*.ts;$(ScriptCoreWorkspace)pivot/src/**/*.ts;$(ScriptCoreWorkspace)pivot-blazor/src/**/*.ts;$(ScriptCoreWorkspace)blazor/src/shared.ts;$(ScriptCoreWorkspace)blazor/src/snapshots.ts;$(ScriptCoreWorkspace)blazor/src/held-messages.ts;$(ScriptCoreWorkspace)blazor/src/razor-slot-host.ts;$(ScriptCoreWorkspace)blazor/src/grid-razor-slot-kinds.ts;$(ScriptCoreWorkspace)blazor/src/pointing-scopes.ts;$(ScriptCoreWorkspace)blazor/src/wire-metrics.ts" />
    <ScriptCoreSource Include="$(ScriptCoreWorkspace)scripts/build-blazor.mjs;$(ScriptCoreWorkspace)package-lock.json" />
    <!-- The Shared Script it imports, whose stamp it carries: built from more of blazor/src than this module reads, so a
         change there that reaches the Shared Script alone builds this module again. -->
    <ScriptCoreSource Include="$(MSBuildThisFileDirectory)../ExGrid/wwwroot/ex-grid-script.min.js" />
    <Content Remove="wwwroot/ex-pivot.min.js;wwwroot/ex-pivot.min.js.map" />
  </ItemGroup>

  <Target Name="BuildScriptCore" DependsOnTargets="ResolveProjectReferences"
          Inputs="@(ScriptCoreSource)" Outputs="$(ScriptCoreModule);$(ScriptCoreConstants)">
    <Exec Command="node ../scripts/build-blazor.mjs --name ex-pivot --namespace ExPivot.Script --out &quot;$(MSBuildThisFileDirectory)wwwroot&quot; --stamp &quot;$(MSBuildThisFileDirectory)$(BaseIntermediateOutputPath)ScriptCore/ex-pivot.stamp.json&quot; --cs &quot;$(ScriptCoreConstants)&quot;"
          WorkingDirectory="$(ScriptCoreWorkspace)pivot-blazor" />
  </Target>

  <!-- Apart from the build, which is skipped while its outputs are newer than every source: the items are
       added on every build, so the static web assets and the compile always hold the module. -->
  <Target Name="IncludeScriptCore" DependsOnTargets="BuildScriptCore"
          BeforeTargets="BeforeBuild;CoreCompile;ResolveProjectStaticWebAssets;ResolveStaticWebAssetsConfiguration">
    <ItemGroup>
      <Content Remove="wwwroot/ex-pivot.min.js;wwwroot/ex-pivot.min.js.map" />
      <Content Include="wwwroot/ex-pivot.min.js;wwwroot/ex-pivot.min.js.map" />
      <Compile Remove="$(ScriptCoreConstants)" />
      <Compile Include="$(ScriptCoreConstants)" />
    </ItemGroup>
  </Target>

  <!-- ExPivot depends on exactly the core and engine versions it was built with, as ExSheet
       does (ADR-0042): the declarations it makes are the core's of that version. -->
  <Target Name="DependOnExactlyTheseVersions" AfterTargets="_GetProjectReferenceVersions">
    <ItemGroup>
      <_ProjectReferencesWithVersions Update="@(_ProjectReferencesWithVersions)" ProjectVersion="[%(ProjectVersion)]" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <!-- The browser's calls in their order, a call too large for a circuit's message among them: compiled into each
         Script adapter, beside the Shared Script's half (src/npm/blazor/src/held-messages.ts). -->
    <Compile Include="..\Shared\Script\HeldCalls.cs" Link="Script\HeldCalls.cs" />
    <Compile Include="..\Shared\Script\CrossedText.cs" Link="Script\CrossedText.cs" />
    <!-- A C# Pivot Source asked by the browser's pivot, as ExBoard's adapter asks one too. -->
    <Compile Include="..\Shared\Script\PivotSourceCrossing.cs" Link="Script\PivotSourceCrossing.cs" />
    <Compile Include="..\Shared\Script\PivotRefreshes.cs" Link="Script\PivotRefreshes.cs" />
    <!-- Chrome slots filled with Razor (ADR-0410): the holders every adapter renders, and the report grid's slots,
         read and drawn as ExGrid's own adapter reads and draws them. -->
    <Compile Include="..\Shared\Script\RazorSlotHolders.cs" Link="Script\RazorSlotHolders.cs" />
    <Compile Include="..\Shared\Script\ScriptMetricsJson.cs" Link="Script\ScriptMetricsJson.cs" />
    <Compile Include="..\ExGrid\Script\RazorSlot.cs" Link="Script\RazorSlot.cs" />
    <Compile Include="..\ExGrid\Script\ScriptJson.cs" Link="Script\ScriptJson.cs" />
  </ItemGroup>

</Project>
