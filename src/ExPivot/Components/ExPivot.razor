@using System.Globalization
@using System.Runtime.CompilerServices
@implements IDisposable
@inject IServiceProvider Services

@*
    ExPivot holds the Pivot Layout and asks its Pivot Source; ExGrid paints, selects, navigates,
    copies and reports (ADR-0059/0066). This component renders the Pivot Toolbar above the report —
    the report filter band, Layout ▾, Refresh and the Field List's toggle (ADR-0061) — the Stale
    Report's notice under it (ADR-0067), exactly one ExGrid over the Pivot Report — its rows the
    Window, its label columns pinned Template Columns, its value columns under Header Groups, the
    cells the data changed marked (ADR-0068) — Show Details' tabs at its foot, and the Field List
    beside it.

    What is deliberately not wired on the grid: sorting, filtering, editing, paste and fill. Item
    order and Hidden Items are the Pivot Layout's, and a report is computed, so no column is
    Editable and every write is refused by the grid's own gate (ADR-0035). The header click
    selects, and the column menu is left out; the grips stay.
*@
@{
    var fieldMenu = _open is { Kind: Surface.Menu } menu ? menu : null;
    var paneLayout = PaneLayout;
    var reportShown = _selectedSheet is null && _dialog is null;
}
<div class="ex-pivot" style="@RootStyle"
     @onmousedown="() => DismissFieldMenu(fieldMenu)" @onmousedown:stopPropagation
     @onfocusin="() => DismissFieldMenu(fieldMenu)" @onfocusin:stopPropagation>
    @* While Show Details' dialog stands, what it covers takes neither the keyboard nor the pointer:
       the dialog is modal (ADR-0059). *@
    <div class="ex-pivot-report" inert="@(_dialog is not null)">
        @Toolbar()
        @* The Stale Report's notice, under the Pivot Toolbar (ADR-0061/0067): a polite live region
           that is always present, so a notice that appears in it is announced, without interrupting
           the reader as the Pivot Toolbar's refusal of their own change does. Empty, it takes
           no room. *@
        <div class="ex-pivot-stale" role="status">@StaleNotice()</div>
        @* While a details tab is selected its records cover the report, which stays laid out, with
           its state, and is not painted: its own header would otherwise paint over the records'
           (ExGrid's layers are its own), and a report nobody sees takes no keyboard and is not
           read out (ADR-0059). *@
        <div class="@(_selectedSheet is null ? "ex-pivot-sheet" : "ex-pivot-sheet ex-pivot-sheet-covered")" style="@SheetStyle"
             @ondragover:preventDefault @ondrop="() => DropOnReportAsync(paneLayout, reportShown)" @ondrop:preventDefault @ondrop:stopPropagation>
            @if (_report is null || _report.IsEmpty)
            {
                <div class="ex-pivot-empty" style="@EmptyStyle" role="status">@EmptyText</div>
            }
            else
            {
                @Grid()
            }
            @if (ReportAcceptsDrop)
            {
                <div class="ex-pivot-report-drop-remove" aria-hidden="true">
                    <span>@Word(PivotCommandIds.RemoveField)</span>
                </div>
            }
            @if (_selectedSheet is { } sheet)
            {
                <div class="ex-pivot-details-panel" role="tabpanel" id="@(sheet.Id + "-panel")" aria-labelledby="@sheet.Id">
                    @Records(sheet)
                </div>
            }
        </div>
        @if (_sheets.Count > 0)
        {
            @DetailsTabs()
        }
    </div>
    @if (_fieldListShown)
    {
        <div class="ex-pivot-field-list" role="region" aria-label="@Word("field-list")" inert="@(_dialog is not null)">
            <div class="ex-pivot-field-list-scroll">@FieldList()</div>
        </div>
    }
    @if (_open is { OnToolbar: true })
    {
        <div class="ex-pivot-backdrop" @onclick="CloseOpen" aria-hidden="true"></div>
    }
    @if (_dialog is { } dialog)
    {
        <div class="ex-pivot-dialog-backdrop" @onclick="CloseDialog" aria-hidden="true"></div>
        <PivotDialogFrame Label="@dialog.Details.Title" OnEscape="_closeDialog">@DialogContent(dialog)</PivotDialogFrame>
    }
    @* The report's grid takes the keyboard back once the dialog, or the last details tab, has gone
       (ADR-0070): asked after the render that removes it, when the report can take focus again. *@
    @KeyboardReturn()
</div>

@code {
    private static readonly object Emitted = new();
    private readonly ConditionalWeakTable<PivotLayout, object> _emitted = new();
    private PivotLayout? _layoutParameter;
    private CultureInfo _culture = CultureInfo.InvariantCulture;
    private Func<string, string?>? _label;
    private PivotOptions _options = PivotOptions.Default;
    private PivotCaps _caps = PivotCaps.Default;
    private bool _showFieldListParameter = true;
    private bool _fieldListShown = true;
    private bool _initialised;
    private bool _disposed;

    /// <summary>
    /// The Pivot Source the report is computed from (ADR-0066/0151): <c>PivotSource.From</c> over
    /// the Consumer's records or a Snapshot — a CSV read in the browser among them — or
    /// <c>PivotSource.Fetch</c> over a server's Leaf Aggregates. Its fields are what the Field List
    /// offers. ExPivot computes the report over it with the engine a server runs
    /// (<c>PivotReportSource.From</c>), one computation for this ExPivot, which it disposes; the
    /// source itself is the Consumer's, and a new instance is a refresh. Hand this or
    /// <see cref="ReportSource"/>, not both.
    /// </summary>
    [Parameter] public PivotSource? Source { get; set; }

    /// <summary>
    /// A report source, in place of <see cref="Source"/> (ADR-0151): <c>PivotReportSource.Fetch</c>
    /// over the Consumer's transport to a server that computes the report and sends the Window asked
    /// for and its Window Changes, so the leaves and the rows outside the Window stay on that server,
    /// or a <c>PivotReportSource.From</c> the Consumer keeps itself. It owns the computation; ExPivot
    /// receives the report's metadata and the Windows it asks for. Its lifetime is the Consumer's.
    /// Hand this or <see cref="Source"/>, not both.
    /// </summary>
    [Parameter] public PivotReportSource? ReportSource { get; set; }

    /// <summary>Server-registered Order Key identifiers by field name (ADR-0152): a report computed
    /// on a server orders a field's Items by the function the server registered under that name
    /// (<c>PivotReportSource.From(data, orderKeys)</c>); only the name crosses the wire. Local fields
    /// keep their declared delegates. An unknown identifier, and a function that throws, are refused
    /// by name, never replaced by label order.</summary>
    [Parameter] public IReadOnlyDictionary<string, string>? OrderKeyPolicies { get; set; }

    /// <summary>
    /// How often, at most, the report is redrawn for changes of data (ADR-0067): 250 ms by default.
    /// The source's <c>Changed</c> notices are gathered, and the report is asked again, from the
    /// newest version, no sooner than this after the last change reached the screen — a value that
    /// changes forty times a second cannot be read; one that changes four times a second still
    /// feels live. Zero asks on every change. A question already out is answered first, and the
    /// changes that arrive meanwhile are asked for after it. A negative interval is refused.
    /// </summary>
    [Parameter] public TimeSpan RedrawInterval { get; set; } = DefaultRedrawInterval;

    /// <summary>The interval <see cref="RedrawInterval"/> takes unless the Consumer sets one: 250 ms
    /// (ADR-0067).</summary>
    public static TimeSpan DefaultRedrawInterval { get; } = TimeSpan.FromMilliseconds(250);

    /// <summary>
    /// How long a Change Highlight lasts on a value cell whose painted text changed with the data
    /// (ADR-0067/0068): one second by default. Only data marks a cell — a change the source
    /// announced, Refresh, Retry, a new source — and every cell of a row that appears; a new layout,
    /// a sort, a collapse, a form or Show Values As marks nothing, and neither does a change the
    /// number format hides. Zero marks nothing; a negative duration is refused. The mark's colour is
    /// ExGrid's Visual Token <c>--ex-change-highlight-background</c>.
    /// </summary>
    [Parameter] public TimeSpan ChangeHighlightDuration { get; set; } = ChangeHighlightRules.DefaultDuration;

    /// <summary>
    /// The clock ExPivot reads the time from — when a change of data may be redrawn, when an answer
    /// arrived, how long a Change Highlight lasts — and which it hands the report grid; a test hands
    /// in its own. Null, the default, is the <see cref="TimeProvider"/> the host registered as a
    /// service, or <see cref="TimeProvider.System"/> where it registered none, as the grid resolves
    /// its own. Its <see cref="TimeProvider.LocalTimeZone"/> is the zone a Stale Report's time is
    /// written in: under Blazor Server the system's is the server's, so a host that knows the
    /// user's zone hands in a clock that answers it.
    /// </summary>
    [Parameter] public TimeProvider? Clock { get; set; }

    /// <summary>
    /// The Pivot Layout — which fields stand where, with their settings (ADR-0059). It is View
    /// State: the Consumer persists it and may bind it with <c>@bind-Layout</c>. A layout handed
    /// in replaces the one on screen; one this ExPivot raised through <see cref="LayoutChanged"/>
    /// and handed back is the one already on screen. Null starts from nothing and keeps the
    /// user's changes inside the component. A layout naming a field the source does not offer is
    /// refused by name (<see cref="PivotLayout.KeepingOnly"/> drops them knowingly).
    /// </summary>
    [Parameter] public PivotLayout? Layout { get; set; }

    /// <summary>Raised with the layout the report shows, after every change the user makes: at once
    /// when the answer held already lays it out, and once the source has answered otherwise
    /// (ADR-0061/0066). Never for a pending layout, for one a further change superseded, or for one
    /// a cap refused.</summary>
    [Parameter] public EventCallback<PivotLayout> LayoutChanged { get; set; }

    /// <summary>The culture labels and values are written in and text Items ordered by; the
    /// current culture when left out. It changes no word: <see cref="Label"/> does.</summary>
    [Parameter] public CultureInfo? Culture { get; set; }

    /// <summary>The Consumer's word for an id of <see cref="PivotWords"/>, <see cref="PivotCommandIds"/>
    /// or the report grid's Context Menu, or null to keep the English. <see cref="PivotWords.Japanese"/>
    /// gives Excel's Japanese edition's words in one line (ADR-0060). Hold it in a field: it is read
    /// on every render.</summary>
    [Parameter] public Func<string, string?>? Label { get; set; }

    /// <summary>What draws the Field List, the Pivot Toolbar, the menus, the panels and Show
    /// Details' tabs and dialog (ADR-0061); null for ExPivot's built-in markup. It may also supply
    /// the report grid's Chrome.</summary>
    [Parameter] public IPivotChrome? PivotChrome { get; set; }

    /// <summary>The report grid's Chrome, and the details grids' (ADR-0010); beats
    /// <see cref="IPivotChrome.GridChrome"/>.</summary>
    [Parameter] public IGridChrome? Chrome { get; set; }

    /// <summary>Whether the Field List stands beside the report. Bind it with
    /// <c>@bind-ShowFieldList</c> to remember the user's choice: the Pivot Toolbar's toggle and the
    /// Context Menu's Show and Hide Field List change it and raise <see cref="ShowFieldListChanged"/>.</summary>
    [Parameter] public bool ShowFieldList { get; set; } = true;

    /// <summary>Raised when the user shows or hides the Field List (ADR-0061).</summary>
    [Parameter] public EventCallback<bool> ShowFieldListChanged { get; set; }

    /// <summary>The Field List's width in pixels, emitted inline (ADR-0027).</summary>
    [Parameter] public double FieldListWidth { get; set; } = 300;

    /// <summary>The report grid's height, header included (ADR-0013/0028). A Stretch height takes
    /// the parent's, which must be definite.</summary>
    [Parameter] public ViewportSize ViewportHeight { get; set; } = 400;

    /// <summary>The report grid's width. Stretch, the default, takes what the Field List leaves.</summary>
    [Parameter] public ViewportSize ViewportWidth { get; set; } = ViewportSize.Stretch;

    /// <summary>The report's row height, or null for the Density's (ADR-0013/0028).</summary>
    [Parameter] public double? RowHeight { get; set; }

    /// <summary>The report's Density, or null for a Wrapper's, or Compact (ADR-0028).</summary>
    [Parameter] public GridDensity? Density { get; set; }

    /// <summary>The report's Cell Metrics, or null for a Wrapper's, or the Density's (ADR-0016/0030).</summary>
    [Parameter] public CellTextMetrics? CellMetrics { get; set; }

    /// <summary>The caps a layout is held to (ADR-0066): the leaves a question allows, and the
    /// report's rows and columns. A layout that breaks one is refused by name, and the report stays
    /// on the layout before.</summary>
    [Parameter] public PivotCaps Caps { get; set; } = PivotCaps.Default;

    /// <summary>Where Show Details puts the records behind a cell when nobody listens to
    /// <see cref="OnShowDetails"/>: a tab at the report's foot (the default) or a dialog (ADR-0059).</summary>
    [Parameter] public PivotDetailsView DetailsView { get; set; } = PivotDetailsView.Tab;

    /// <summary>Show Details — a double click on a value, or the Context Menu (ADR-0063) — handed to
    /// the Consumer, who shows the records where its application shows records. While it listens,
    /// neither the tab nor the dialog opens (ADR-0059).</summary>
    [Parameter] public EventCallback<PivotDetails> OnShowDetails { get; set; }

    /// <summary>The report grid's Selection, as ExGrid raises it (ADR-0011).</summary>
    [Parameter] public EventCallback<GridSelection> SelectionChanged { get; set; }

    /// <summary>What a Wrapper cascades (ADR-0030): read to size the label columns with the same
    /// metrics the grid resolves, and handed on to the grid by the cascade itself.</summary>
    [CascadingParameter] public GridPresentationDefaults? Presentation { get; set; }

    /// <summary>The layout the report on screen was laid out under — the one last raised through
    /// <see cref="LayoutChanged"/>, or handed in.</summary>
    public PivotLayout CurrentLayout => _shown;

    /// <summary>The report on screen, or null before the source first answered.</summary>
    public PivotReportState? Report => _state;

    // The report source asked — the ReportSource handed in, or the one made over Source — for a
    // test that follows what it keeps alive (ADR-0160, LV-22).
    internal PivotReportSource? AskedSource => _source;

    /// <summary>Whether a question the report waits on is out to the source — a layout's, Refresh's,
    /// Retry's or a new source's — or its answer's report is being made, in slices, as is a layout
    /// of the answer held that grows long: the report stays as it was meanwhile, under the grid's
    /// loading indication (ADR-0066, PV-40). A question asked because the source said its data
    /// moved on is asked quietly, under no indication: the report on screen is the newest there is
    /// until the answer lands, and a live report dimmed four times a second would flicker
    /// (ADR-0067).</summary>
    public bool IsLoading => _loading;

    /// <summary>The source's last failure, kept until it next answers (ADR-0025's "a failure is
    /// never silent"); the Pivot Toolbar, or the Stale Report's notice, says it where the user
    /// sees it.</summary>
    public Exception? LastError => _lastError;

    /// <summary>Whether the report is a Stale Report (ADR-0067): the newest data could not be
    /// shown — it broke a cap, the source refused or failed, or a Refresh failed — so the report
    /// stays on the last version it could compute, and the notice under the Pivot Toolbar says what
    /// happened and as of when, with Retry.</summary>
    public bool IsStale => _stale is not null;

    // The Consumer's word, the engine's English, then the English of the words the engine does not
    // hold yet; an id none of them knows is painted as itself — a missing word seen, never a blank.
    private string Word(string id) => Label?.Invoke(id) ?? PivotWords.EnglishFor(id) ?? id;

    /// <inheritdoc />
    protected override async Task OnParametersSetAsync()
    {
        AdoptSummaryFigures();
        if (FieldListWidth is not (> 0 and < 10_000) || !double.IsFinite(FieldListWidth))
            throw new ArgumentOutOfRangeException(nameof(FieldListWidth), FieldListWidth, "A width in pixels, above zero.");
        if (Source is null && ReportSource is null)
            throw new InvalidOperationException("ExPivot needs a Pivot Source (Source) or a report source (ReportSource) to compute its report from (ADR-0151).");
        if (Source is not null && ReportSource is not null)
            throw new InvalidOperationException("ExPivot takes a Pivot Source (Source) or a report source (ReportSource), not both: the report is computed from one of them (ADR-0151).");
        ArgumentNullException.ThrowIfNull(Caps);
        if (!Enum.IsDefined(DetailsView))
            throw new ArgumentOutOfRangeException(nameof(DetailsView), DetailsView, "Unknown PivotDetailsView.");
        if (RedrawInterval < TimeSpan.Zero)
            throw new ArgumentOutOfRangeException(nameof(RedrawInterval), RedrawInterval, "A redraw cannot come before the change it shows (ADR-0067).");
        if (ChangeHighlightDuration < TimeSpan.Zero)
        {
            throw new ArgumentOutOfRangeException(nameof(ChangeHighlightDuration), ChangeHighlightDuration,
                "A Change Highlight cannot last a negative time: it would end before the change it marks (ADR-0068).");
        }
        UseClock(Clock ?? Services.GetService(typeof(TimeProvider)) as TimeProvider ?? TimeProvider.System);

        var offeredSource = await ResolveReportSourceAsync();
        var pursue = !_initialised;
        var force = false;
        var refresh = false;
        // The Consumer's own new layout, when this render brings one: not one this instance raised
        // and the Consumer bound back, and not the one on screen.
        var consumerLayout = !ReferenceEquals(Layout, _layoutParameter) && Layout is not null
            && !_emitted.TryGetValue(Layout, out _) && !ReferenceEquals(Layout, _layout)
            ? Layout
            : null;
        if (!ReferenceEquals(offeredSource, _source))
        {
            // A new source is a refresh: nothing it says can come from the answer held, and the
            // one before it is no longer listened to (ADR-0066/0067). It is held to the layout it
            // will be asked under: the one it came with, when data of another shape and its layout
            // arrive together, and otherwise the one on screen.
            CheckFields(offeredSource, consumerLayout ?? _layout);
            refresh = _source is not null;
            _source = offeredSource;
            _client = new PivotReportClient(offeredSource, _state);
            Listen(offeredSource);
            pursue = true;
            force = true;
        }
        var layoutMoved = false;
        if (!ReferenceEquals(Layout, _layoutParameter))
        {
            _layoutParameter = Layout;
            // A layout this instance raised and the Consumer bound back is the one on screen.
            if (consumerLayout is not null)
            {
                CheckFields(offeredSource, consumerLayout);
                _layout = consumerLayout;
                // The Consumer's layout replaces the user's: it is never raised back.
                _raisePending = false;
                if (_pending is not null)
                    _pending = Layout;
                CloseOpenQuietly();
                pursue = true;
                layoutMoved = true;
            }
        }
        var capsMoved = false;
        if (!Equals(Caps, _caps))
        {
            _caps = Caps;
            pursue = true;
            force = true;
            capsMoved = true;
        }
        var culture = Culture ?? CultureInfo.CurrentCulture;
        var wordsMoved = !Equals(culture, _culture) || !ReferenceEquals(Label, _label);
        if (wordsMoved)
        {
            _culture = culture;
            _label = Label;
            _options = new PivotOptions { Culture = culture, Label = Label };
        }
        if (ShowFieldList != _showFieldListParameter || !_initialised)
        {
            _showFieldListParameter = ShowFieldList;
            _fieldListShown = ShowFieldList;
            if (!ShowFieldList)
                EndDrag();
        }
        _initialised = true;
        // Whatever the Consumer passed may reach the grid: its geometry, its Chrome, its callbacks.
        _gridVersion++;
        var geometryMoved = ResolveGeometry();
        if (pursue)
        {
            // A new source alone is a refresh of the data, which its answer marks and a refusal of
            // leaves the report stale (ADR-0067); with a new layout or new caps, it is the layout's.
            // A user's layout still on its way is raised once shown, whoever asked for it last.
            var kind = refresh && !layoutMoved && !capsMoved ? Question.Data : Question.Layout;
            await PursueAsync(raise: !layoutMoved && _raisePending, force: force, kind);
        }
        else
        {
            if (wordsMoved)
                LayOutAgain();
            else if (geometryMoved)
                BuildColumns();
            // A new interval, or a new clock, re-times the changes still gathered.
            await ScheduleRedrawAsync();
        }
    }

    /// <summary>Stops listening to the source, cancels the question in flight and the redraw
    /// waiting, and releases every details grid's source.</summary>
    public void Dispose()
    {
        if (_disposed)
            return;
        _disposed = true;
        StopListening();
        _redrawTimer?.Dispose();
        _redrawTimer = null;
        _generation++;
        _asking?.Cancel();
        _asking = null;
        if (_ownedSource is { } owned)
            _ = owned.DisposeAsync();
        _ownedSource = null;
        foreach (var sheet in _sheets)
            sheet.Dispose();
        _sheets.Clear();
        _dialog?.Dispose();
        _dialog = null;
    }
}
