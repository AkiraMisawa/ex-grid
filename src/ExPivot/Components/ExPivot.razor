@using System.Globalization
@using System.Runtime.CompilerServices
@implements IDisposable

@*
    ExPivot holds the Pivot Layout and asks its Pivot Source; ExGrid paints, selects, navigates,
    copies and reports (ADR-0058/0065). This component renders the toolbar above the report — the
    report filter band, Layout ▾, Refresh and the Field List's toggle (ADR-0060) — exactly one
    ExGrid over the Pivot Report — its rows the Window, its label columns pinned Template Columns,
    its value columns under Header Groups — Show Details' tabs at its foot, and the Field List
    beside it.

    What is deliberately not wired on the grid: sorting, filtering, editing, paste and fill. Item
    order and Hidden Items are the Pivot Layout's, and a report is computed, so no column is
    Editable and every write is refused by the grid's own gate (ADR-0035). The header click
    selects, and the column menu is left out; the grips stay.
*@
<div class="ex-pivot" style="@RootStyle">
    <div class="ex-pivot-report">
        @Toolbar()
        <div class="ex-pivot-sheet" style="@SheetStyle">
            @if (_report is null || _report.IsEmpty)
            {
                <div class="ex-pivot-empty" style="@EmptyStyle" role="status">@EmptyText</div>
            }
            else
            {
                @Grid()
            }
            @if (_selectedSheet is { } sheet)
            {
                <div class="ex-pivot-details-panel" role="tabpanel" id="@(sheet.Id + "-panel")" aria-labelledby="@sheet.Id">
                    @Records(sheet)
                </div>
            }
        </div>
        @if (_sheets.Count > 0)
        {
            @DetailsTabs()
        }
    </div>
    @if (_fieldListShown)
    {
        <div class="ex-pivot-field-list" role="region" aria-label="@Word("field-list")">
            <div class="ex-pivot-field-list-scroll">@FieldList()</div>
        </div>
    }
    @if (_open is { OnToolbar: true })
    {
        <div class="ex-pivot-backdrop" @onclick="CloseOpen" aria-hidden="true"></div>
    }
    @if (_dialog is { } dialog)
    {
        <div class="ex-pivot-dialog-backdrop" @onclick="CloseDialog" aria-hidden="true"></div>
        <PivotDialogFrame Label="@dialog.Details.Title" OnEscape="_closeDialog">@DialogContent(dialog)</PivotDialogFrame>
    }
</div>

@code {
    private static readonly object Emitted = new();
    private readonly ConditionalWeakTable<PivotLayout, object> _emitted = new();
    private PivotLayout? _layoutParameter;
    private CultureInfo _culture = CultureInfo.InvariantCulture;
    private Func<string, string?>? _label;
    private PivotOptions _options = PivotOptions.Default;
    private PivotCaps _caps = PivotCaps.Default;
    private bool _showFieldListParameter = true;
    private bool _fieldListShown = true;
    private bool _initialised;
    private bool _disposed;

    /// <summary>
    /// What the report is computed from (ADR-0065): <c>PivotSource.From</c> over the Consumer's
    /// records — the reference, answered in the process — or a server's, through
    /// <c>PivotSource.Fetch</c>. Its fields are what the Field List offers. ExPivot asks it without
    /// ever blocking: a slow answer leaves the report as it was under a loading indication, and a
    /// newer question cancels the old one. A new instance is a refresh.
    /// </summary>
    [Parameter, EditorRequired] public PivotSource Source { get; set; } = default!;

    /// <summary>
    /// The Pivot Layout — which fields stand where, with their settings (ADR-0058). It is View
    /// State: the Consumer persists it and may bind it with <c>@bind-Layout</c>. A layout handed
    /// in replaces the one on screen; one this ExPivot raised through <see cref="LayoutChanged"/>
    /// and handed back is the one already on screen. Null starts from nothing and keeps the
    /// user's changes inside the component. A layout naming a field the source does not offer is
    /// refused by name (<see cref="PivotLayout.KeepingOnly"/> drops them knowingly).
    /// </summary>
    [Parameter] public PivotLayout? Layout { get; set; }

    /// <summary>Raised with the layout the report shows, after every change the user makes: at once
    /// when the answer held already lays it out, and once the source has answered otherwise
    /// (ADR-0060/0065). Never for a pending layout, for one a further change superseded, or for one
    /// a cap refused.</summary>
    [Parameter] public EventCallback<PivotLayout> LayoutChanged { get; set; }

    /// <summary>The culture labels and values are written in and text Items ordered by; the
    /// current culture when left out. It changes no word: <see cref="Label"/> does.</summary>
    [Parameter] public CultureInfo? Culture { get; set; }

    /// <summary>The Consumer's word for an id of <see cref="PivotWords"/>, <see cref="PivotCommandIds"/>
    /// or the report grid's Context Menu, or null to keep the English. <see cref="PivotWords.Japanese"/>
    /// gives Excel's Japanese edition's words in one line (ADR-0059). Hold it in a field: it is read
    /// on every render.</summary>
    [Parameter] public Func<string, string?>? Label { get; set; }

    /// <summary>What draws the Field List, the toolbar, the menus, the panels and Show Details'
    /// tabs and dialog (ADR-0060); null for ExPivot's built-in markup. It may also supply the
    /// report grid's Chrome.</summary>
    [Parameter] public IPivotChrome? PivotChrome { get; set; }

    /// <summary>The report grid's Chrome, and the details grids' (ADR-0010); beats
    /// <see cref="IPivotChrome.GridChrome"/>.</summary>
    [Parameter] public IGridChrome? Chrome { get; set; }

    /// <summary>Whether the Field List stands beside the report. Bind it with
    /// <c>@bind-ShowFieldList</c> to remember the user's choice: the toolbar's toggle and the
    /// Context Menu's Show and Hide Field List change it and raise <see cref="ShowFieldListChanged"/>.</summary>
    [Parameter] public bool ShowFieldList { get; set; } = true;

    /// <summary>Raised when the user shows or hides the Field List (ADR-0060).</summary>
    [Parameter] public EventCallback<bool> ShowFieldListChanged { get; set; }

    /// <summary>The Field List's width in pixels, emitted inline (ADR-0027).</summary>
    [Parameter] public double FieldListWidth { get; set; } = 300;

    /// <summary>The report grid's height, header included (ADR-0013/0028). A Stretch height takes
    /// the parent's, which must be definite.</summary>
    [Parameter] public ViewportSize ViewportHeight { get; set; } = 400;

    /// <summary>The report grid's width. Stretch, the default, takes what the Field List leaves.</summary>
    [Parameter] public ViewportSize ViewportWidth { get; set; } = ViewportSize.Stretch;

    /// <summary>The report's row height, or null for the Density's (ADR-0013/0028).</summary>
    [Parameter] public double? RowHeight { get; set; }

    /// <summary>The report's Density, or null for a Wrapper's, or Compact (ADR-0028).</summary>
    [Parameter] public GridDensity? Density { get; set; }

    /// <summary>The report's Cell Metrics, or null for a Wrapper's, or the Density's (ADR-0016/0030).</summary>
    [Parameter] public CellTextMetrics? CellMetrics { get; set; }

    /// <summary>The caps a layout is held to (ADR-0065): the leaves a question allows, and the
    /// report's rows and columns. A layout that breaks one is refused by name, and the report stays
    /// on the layout before.</summary>
    [Parameter] public PivotCaps Caps { get; set; } = PivotCaps.Default;

    /// <summary>Where Show Details puts the records behind a cell when nobody listens to
    /// <see cref="OnShowDetails"/>: a tab at the report's foot (the default) or a dialog (ADR-0058).</summary>
    [Parameter] public PivotDetailsView DetailsView { get; set; } = PivotDetailsView.Tab;

    /// <summary>Show Details — a double click on a value, or the Context Menu (ADR-0062) — handed to
    /// the Consumer, who shows the records where its application shows records. While it listens,
    /// neither the tab nor the dialog opens (ADR-0058).</summary>
    [Parameter] public EventCallback<PivotDetails> OnShowDetails { get; set; }

    /// <summary>The report grid's Selection, as ExGrid raises it (ADR-0011).</summary>
    [Parameter] public EventCallback<GridSelection> SelectionChanged { get; set; }

    /// <summary>What a Wrapper cascades (ADR-0030): read to size the label columns with the same
    /// metrics the grid resolves, and handed on to the grid by the cascade itself.</summary>
    [CascadingParameter] public GridPresentationDefaults? Presentation { get; set; }

    /// <summary>The layout the report on screen was laid out under — the one last raised through
    /// <see cref="LayoutChanged"/>, or handed in.</summary>
    public PivotLayout CurrentLayout => _shown;

    /// <summary>The report on screen, or null before the source first answered.</summary>
    public PivotReport? Report => _report;

    /// <summary>Whether a question is out to the source: the report stays as it was meanwhile,
    /// under the grid's loading indication (ADR-0065).</summary>
    public bool IsLoading => _loading;

    /// <summary>The source's last failure, kept until it next answers (ADR-0025's "a failure is
    /// never silent"); the toolbar says it where the user sees it.</summary>
    public Exception? LastError => _lastError;

    private string Word(string id) => PivotWords.Resolve(id, Label);

    /// <inheritdoc />
    protected override async Task OnParametersSetAsync()
    {
        if (FieldListWidth is not (> 0 and < 10_000) || !double.IsFinite(FieldListWidth))
            throw new ArgumentOutOfRangeException(nameof(FieldListWidth), FieldListWidth, "A width in pixels, above zero.");
        if (Source is null)
            throw new InvalidOperationException("ExPivot needs a Source: PivotSource.From over the records, or a server's through PivotSource.Fetch (ADR-0065).");
        ArgumentNullException.ThrowIfNull(Caps);
        if (!Enum.IsDefined(DetailsView))
            throw new ArgumentOutOfRangeException(nameof(DetailsView), DetailsView, "Unknown PivotDetailsView.");

        var pursue = !_initialised;
        var force = false;
        if (!ReferenceEquals(Source, _source))
        {
            // A new source is a refresh: nothing it says can come from the answer held.
            CheckFields(Source, _layout);
            _source = Source;
            pursue = true;
            force = true;
        }
        if (!ReferenceEquals(Layout, _layoutParameter))
        {
            _layoutParameter = Layout;
            // A layout this instance raised and the Consumer bound back is the one on screen.
            if (Layout is not null && !_emitted.TryGetValue(Layout, out _) && !ReferenceEquals(Layout, _layout))
            {
                CheckFields(Source, Layout);
                _layout = Layout;
                if (_pending is not null)
                    _pending = Layout;
                CloseOpenQuietly();
                pursue = true;
            }
        }
        if (!Equals(Caps, _caps))
        {
            _caps = Caps;
            pursue = true;
            force = true;
        }
        var culture = Culture ?? CultureInfo.CurrentCulture;
        var wordsMoved = !Equals(culture, _culture) || !ReferenceEquals(Label, _label);
        if (wordsMoved)
        {
            _culture = culture;
            _label = Label;
            _options = new PivotOptions { Culture = culture, Label = Label };
        }
        if (ShowFieldList != _showFieldListParameter || !_initialised)
        {
            _showFieldListParameter = ShowFieldList;
            _fieldListShown = ShowFieldList;
        }
        _initialised = true;
        // Whatever the Consumer passed may reach the grid: its geometry, its Chrome, its callbacks.
        _gridVersion++;
        var geometryMoved = ResolveGeometry();
        if (pursue)
            await PursueAsync(raise: false, force: force);
        else if (wordsMoved)
            LayOutAgain();
        else if (geometryMoved)
            BuildColumns();
    }

    /// <summary>Cancels the question in flight and releases every details grid's source.</summary>
    public void Dispose()
    {
        if (_disposed)
            return;
        _disposed = true;
        _generation++;
        _asking?.Cancel();
        _asking = null;
        foreach (var sheet in _sheets)
            sheet.Dispose();
        _sheets.Clear();
        _dialog?.Dispose();
        _dialog = null;
    }
}
