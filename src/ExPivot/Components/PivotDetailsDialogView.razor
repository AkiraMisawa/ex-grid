@* The built-in content of Show Details' dialog (ADR-0059), inside ExPivot's frame: the cell's
   title, its records, and Close, which takes the keyboard when the dialog opens. *@
<div class="ex-pivot-dialog-content">
    <div class="ex-pivot-dialog-title">@Context.Title</div>
    <div class="ex-pivot-dialog-records">@Context.Records</div>
    <div class="ex-pivot-panel-actions">
        <PivotFocusButton Class="ex-pivot-close" OnClick="Context.Close" FocusRequest="Context.FocusRequest" TakeKeyboard="Context.TakeKeyboard">@Context.Word("close")</PivotFocusButton>
    </div>
</div>

@code {
    /// <summary>The title, the records and the way out (ADR-0059).</summary>
    [Parameter, EditorRequired] public PivotDetailsDialogContext Context { get; set; } = default!;
}
