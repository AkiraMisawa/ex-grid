@* Written in each component, not in an _Imports.razor, whose class Razor makes public (ADR-0201).
   Every product using is written with global::. The component lives in ExPivot.Components, where a
   plain "ExPivot.Engine" could be looked up against the ExPivot component class first, and a plain
   "ExGrid.X" against sibling types (the CS0426 trap in AGENTS.md). The Web namespace makes @on...
   handlers compile as event handlers rather than as plain HTML attributes. *@
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using global::ExGrid
@using global::ExGrid.Cells
@using global::ExGrid.Chrome
@using global::ExGrid.Columns
@using global::ExGrid.Components
@using global::ExGrid.Rows
@using global::ExGrid.Selection
@using global::ExPivot.Chrome
@using global::ExPivot.Engine
@* Not the contract (ADR-0201): ExPivot renders this as a field's menu or the Layout menu when the
   Pivot Chrome draws none, and no Consumer places it. It is public only because Razor makes every
   component public, is hidden from a Consumer's editor, and may change in any version. *@
@attribute [System.ComponentModel.EditorBrowsable(System.ComponentModel.EditorBrowsableState.Never)]
@* The built-in menu (ADR-0061): a placed field's commands, or the Layout menu's choices, in
   ExPivot's order, each with its Enabled state. A choice among others is a menuitemradio, its mark
   shown, and a group of them stands under its heading. The first enabled command takes DOM focus
   when the menu opens. *@
<div class="ex-pivot-menu" role="none">
    @foreach (var group in Groups())
    {
        @if (group.Heading is { } heading)
        {
            <div class="ex-pivot-menu-group" role="group" aria-label="@heading">
                <div class="ex-pivot-menu-heading" aria-hidden="true">@heading</div>
                @Items(group)
            </div>
        }
        else
        {
            @Items(group)
        }
    }
</div>

@code {
    /// <summary>The commands and the request to take the keyboard (ADR-0061).</summary>
    [Parameter, EditorRequired] public PivotMenuContext Context { get; set; } = default!;

    private sealed record Group(string? Heading, int From, int To);

    private IEnumerable<Group> Groups()
    {
        var start = 0;
        string? heading = null;
        for (var i = 0; i < Context.Commands.Count; i++)
        {
            if (Context.Commands[i].GroupHeading is { } next)
            {
                if (i > start)
                    yield return new Group(heading, start, i);
                start = i;
                heading = next;
            }
        }
        if (Context.Commands.Count > start)
            yield return new Group(heading, start, Context.Commands.Count);
    }

    private RenderFragment Items(Group group) => @<text>
        @for (var i = group.From; i < group.To; i++)
        {
            var command = Context.Commands[i];
            <PivotFocusButton @key="command.Id" Class="@(command.Checked is null ? "ex-pivot-menu-item" : "ex-pivot-menu-item ex-pivot-menu-choice")"
                              role="@(command.Checked is null ? "menuitem" : "menuitemradio")"
                              aria-checked="@(command.Checked is { } chosen ? (chosen ? "true" : "false") : null)"
                              Disabled="!command.Enabled" OnClick="command.Invoke"
                              FocusRequest="@(command.Id == FocusedId ? Context.FocusRequest : 0)">
                @if (command.Checked is { } mark)
                {
                    <span class="ex-pivot-menu-mark" aria-hidden="true">@(mark ? "✓" : "")</span>
                }
                @command.Label
            </PivotFocusButton>
        }
    </text>;

    private int _request;
    private string? _focusedId;

    // The command the request to take the keyboard was given to: the first enabled one when the
    // request was made, and the same one after. A press can disable the command it pressed, as
    // choosing a radio does; were the request to move on to the next enabled command, that one,
    // never asked, would take the keyboard after the turn had handed it back to the opener.
    private string? FocusedId
    {
        get
        {
            if (Context.FocusRequest != _request)
            {
                _request = Context.FocusRequest;
                _focusedId = null;
                foreach (var command in Context.Commands)
                {
                    if (command.Enabled)
                    {
                        _focusedId = command.Id;
                        break;
                    }
                }
            }
            return _focusedId;
        }
    }
}
