@* Written in each component, not in an _Imports.razor, whose class Razor makes public (ADR-0201).
   Every product using is written with global::. The component lives in ExPivot.Components, where a
   plain "ExPivot.Engine" could be looked up against the ExPivot component class first, and a plain
   "ExGrid.X" against sibling types (the CS0426 trap in AGENTS.md). The Web namespace makes @on...
   handlers compile as event handlers rather than as plain HTML attributes. *@
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using global::ExGrid
@using global::ExGrid.Cells
@using global::ExGrid.Chrome
@using global::ExGrid.Columns
@using global::ExGrid.Components
@using global::ExGrid.Rows
@using global::ExGrid.Selection
@using global::ExPivot.Chrome
@using global::ExPivot.Engine
@* Not the contract (ADR-0201): ExPivot's built-in parts place this button in their own markup, and
   no Consumer places it. It is public only because Razor makes every component public, is hidden
   from a Consumer's editor, and may change in any version. *@
@attribute [System.ComponentModel.EditorBrowsable(System.ComponentModel.EditorBrowsableState.Never)]
@* A button that takes DOM focus when ExPivot asks (ADR-0061): once for each request number it
   has not acted on, as a template's control does (ADR-0037), in the turn of the input that asked and
   through the report grid's guard (ADR-0240 section 6; ADR-0070's note of 2026-10-02). The built-in
   views put the keyboard back on an entry this way when its menu or panel closes.

   It takes its place in the pivot's Input Order: it claims its click and its keys (data-ex-claims), so
   the report grid numbers each, holds the keys typed behind one still being answered, and hands them on
   where its answer left the keyboard. Enter, and Space but for its repeats, press it at the keydown, in
   that key's turn, so a key the grid hands on — a keydown dispatched from script, which activates no
   button — presses it too; the click the browser then makes of the same key (detail 0) is that key's,
   and is claimed with nothing done. Any other key is the frame's around it, if any — Escape closes a
   menu — in the same turn. *@
<button @ref="_button" type="button" class="@Class" disabled="@Disabled" data-ex-claims="click keydown"
        @onclick="OnClickAsync" @onkeydown="OnKeyDownAsync" @onkeydown:stopPropagation @attributes="Attributes">@ChildContent</button>

@code {
    private ElementReference _button;
    private int _acted;
    // The clicks the browser owes for the keys that pressed this button at their keydown.
    private int _keyClicks;

    /// <summary>The button's classes.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Whether the button is disabled.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Pressed.</summary>
    [Parameter] public EventCallback OnClick { get; set; }

    /// <summary>The request to take DOM focus; zero asks nothing.</summary>
    [Parameter] public int FocusRequest { get; set; }

    /// <summary>How the button takes DOM focus when asked: called with its element. Null, the pivot's own
    /// way: through the report grid's guard, in the turn of the input that asked.</summary>
    [Parameter] public Func<ElementReference, Task>? TakeKeyboard { get; set; }

    /// <summary>What the button shows.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Any other attribute, on the button.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    [CascadingParameter] internal PivotInput? Input { get; set; }

    [CascadingParameter(Name = PivotPopupFrame.KeysName)] internal Func<KeyboardEventArgs, Task>? FrameKeys { get; set; }

    private Task InOrderAsync(GridInputKind kind, Func<Task> handling)
        => Input is { } input ? input.InOrderAsync(kind, handling) : handling();

    private Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        var press = e is { Key: "Enter" or " ", CtrlKey: false, AltKey: false, MetaKey: false, ShiftKey: false } && !(e.Key == " " && e.Repeat);
        if (press)
        {
            // The key owes one click, made at its keydown (Enter) or its keyup (Space); a key typed
            // between them, a Shift while Space is held, leaves it owed. A press held and replayed
            // makes none, and the click it leaves owed is taken by the next click a key or nothing
            // pointed makes on this button (ADR-0240's trade-offs).
            _keyClicks = 1;
            return InOrderAsync(GridInputKind.KeyDown, () => Disabled ? Task.CompletedTask : OnClick.InvokeAsync());
        }
        var frame = FrameKeys;
        return InOrderAsync(GridInputKind.KeyDown, () => frame is null ? Task.CompletedTask : frame(e));
    }

    private Task OnClickAsync(MouseEventArgs e)
    {
        if (e.Detail == 0 && _keyClicks > 0)
        {
            _keyClicks--;
            return InOrderAsync(GridInputKind.Click, () => Task.CompletedTask);
        }
        _keyClicks = 0;
        return InOrderAsync(GridInputKind.Click, () => OnClick.InvokeAsync());
    }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (FocusRequest != 0 && FocusRequest != _acted)
        {
            _acted = FocusRequest;
            await (TakeKeyboard?.Invoke(_button) ?? Input?.TakeKeyboardAsync(_button) ?? _button.FocusAsync().AsTask());
        }
    }
}
