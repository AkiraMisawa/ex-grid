@* Written in each component, not in an _Imports.razor, whose class Razor makes public (ADR-0201).
   Every product using is written with global::. The component lives in ExPivot.Components, where a
   plain "ExPivot.Engine" could be looked up against the ExPivot component class first, and a plain
   "ExGrid.X" against sibling types (the CS0426 trap in AGENTS.md). The Web namespace makes @on...
   handlers compile as event handlers rather than as plain HTML attributes. *@
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using global::ExGrid
@using global::ExGrid.Cells
@using global::ExGrid.Chrome
@using global::ExGrid.Columns
@using global::ExGrid.Components
@using global::ExGrid.Rows
@using global::ExGrid.Selection
@using global::ExPivot.Chrome
@using global::ExPivot.Engine
@* Not the contract (ADR-0201): ExPivot renders this as Field Settings… when the Pivot Chrome draws
   none, and no Consumer places it. It is public only because Razor makes every component public,
   is hidden from a Consumer's editor, and may change in any version. *@
@attribute [System.ComponentModel.EditorBrowsable(System.ComponentModel.EditorBrowsableState.Never)]
@* The built-in Field Settings… (ADR-0061): a row or column field's subtotals and order, as
   ExPivot's draft until OK. *@
<div class="ex-pivot-panel ex-pivot-field-settings">
    <div class="ex-pivot-panel-title">@Context.FieldCaption</div>
    <fieldset class="ex-pivot-fieldset">
        <legend>@Context.Word("subtotals")</legend>
        <label class="ex-pivot-choice">
            <input @ref="_first" type="radio" name="@_group" checked="@Context.Subtotals" @onchange="() => Context.SubtotalsChanged(true)" />
            <span>@Context.Word("subtotals-automatic")</span>
        </label>
        <label class="ex-pivot-choice">
            <input type="radio" name="@_group" checked="@(!Context.Subtotals)" @onchange="() => Context.SubtotalsChanged(false)" />
            <span>@Context.Word("subtotals-none")</span>
        </label>
    </fieldset>
    <label class="ex-pivot-row">
        <span>@Context.Word("sort-order")</span>
        <select class="ex-pivot-select" value="@Context.Sort" @onchange="e => Context.SortChanged(int.Parse((string)e.Value!, System.Globalization.CultureInfo.InvariantCulture))">
            @for (var i = 0; i < Context.Sorts.Count; i++)
            {
                <option value="@i">@Context.Sorts[i].Label</option>
            }
        </select>
    </label>
    <div class="ex-pivot-panel-actions">
        <button type="button" class="ex-pivot-ok" @onclick="Context.Apply">@Context.Word("ok")</button>
        <button type="button" class="ex-pivot-cancel" @onclick="Context.Cancel">@Context.Word("cancel")</button>
    </div>
</div>

@code {
    private readonly string _group = "ex-pivot-subtotals-" + Guid.NewGuid().ToString("N");
    private ElementReference _first;
    private int _acted;

    /// <summary>The draft and the exits (ADR-0061).</summary>
    [Parameter, EditorRequired] public PivotFieldSettingsContext Context { get; set; } = default!;

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Context.FocusRequest != 0 && Context.FocusRequest != _acted)
        {
            _acted = Context.FocusRequest;
            await _first.FocusAsync();
        }
    }
}
