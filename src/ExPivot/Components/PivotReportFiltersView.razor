@* Written in each component, not in an _Imports.razor, whose class Razor makes public (ADR-0201).
   Every product using is written with global::. The component lives in ExPivot.Components, where a
   plain "ExPivot.Engine" could be looked up against the ExPivot component class first, and a plain
   "ExGrid.X" against sibling types (the CS0426 trap in AGENTS.md). The Web namespace makes @on...
   handlers compile as event handlers rather than as plain HTML attributes. *@
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using global::ExGrid
@using global::ExGrid.Cells
@using global::ExGrid.Chrome
@using global::ExGrid.Columns
@using global::ExGrid.Components
@using global::ExGrid.Rows
@using global::ExGrid.Selection
@using global::ExPivot.Chrome
@using global::ExPivot.Engine
@* Not the contract (ADR-0201): ExPivot renders this as the report filter band when the Pivot
   Chrome draws none, and no Consumer places it. It is public only because Razor makes every
   component public, is hidden from a Consumer's editor, and may change in any version. *@
@attribute [System.ComponentModel.EditorBrowsable(System.ComponentModel.EditorBrowsableState.Never)]
@* The built-in report filter band (ADR-0061): each field in Filters with what it shows — (All),
   the one Item shown, or (Multiple Items) — as Excel shows its page fields above the report. The
   button's wrapper is positioned, so Filter… opens under it, over the report. *@
<div class="ex-pivot-filters" role="group" aria-label="@Context.Title">
    @foreach (var filter in Context.Filters)
    {
        <div @key="filter.Field" class="ex-pivot-filter">
            <span class="ex-pivot-filter-caption">@filter.Caption</span>
            <span class="ex-pivot-filter-anchor">
                <PivotFocusButton Class="@(filter.IsFiltered ? "ex-pivot-filter-button ex-pivot-filter-active" : "ex-pivot-filter-button")"
                                  OnClick="filter.Open" FocusRequest="filter.FocusRequest"
                                  aria-haspopup="dialog" aria-expanded="@(filter.IsOpen ? "true" : "false")"
                                  aria-label="@PivotWords.Fill(Context.Word("filter-of"), filter.Caption)">
                    <span class="ex-pivot-filter-summary">@filter.Summary</span>
                    <span class="ex-pivot-entry-arrow" aria-hidden="true">▾</span>
                </PivotFocusButton>
                @filter.Popup
            </span>
        </div>
    }
</div>

@code {
    /// <summary>The report filters and whom to call back (ADR-0061).</summary>
    [Parameter, EditorRequired] public PivotReportFiltersContext Context { get; set; } = default!;
}
