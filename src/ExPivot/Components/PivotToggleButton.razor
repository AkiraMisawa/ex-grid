@* Written in each component, not in an _Imports.razor, whose class Razor makes public (ADR-0201).
   Every product using is written with global::. The component lives in ExPivot.Components, where a
   plain "ExPivot.Engine" could be looked up against the ExPivot component class first, and a plain
   "ExGrid.X" against sibling types (the CS0426 trap in AGENTS.md). The Web namespace makes @on...
   handlers compile as event handlers rather than as plain HTML attributes. *@
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using global::ExGrid
@using global::ExGrid.Cells
@using global::ExGrid.Chrome
@using global::ExGrid.Columns
@using global::ExGrid.Components
@using global::ExGrid.Rows
@using global::ExGrid.Selection
@using global::ExPivot.Chrome
@using global::ExPivot.Engine
@* Not the contract (ADR-0201): ExPivot places this button in the label cell Space entered, and no
   Consumer places it. It is public only because Razor makes every component public, is hidden from
   a Consumer's editor, and may change in any version. *@
@attribute [System.ComponentModel.EditorBrowsable(System.ComponentModel.EditorBrowsableState.Never)]
@* The expand / collapse button of an outer Item, in the one label cell Space asked to enter
   (ADR-0037/0059): the same markup ExPivot paints in every other such cell, and it takes DOM
   focus itself, once per request — the core never reaches into markup it did not render — through
   the grid's guard. Its click is claimed (data-ex-claims) and taken in its place in the pivot's Input
   Order (ADR-0240 section 6). *@
<button @ref="_button" type="button" class="@ClassFor(Collapsed)" tabindex="-1" data-ex-claims="click"
        aria-expanded="@(Collapsed ? "false" : "true")" aria-label="@Name"
        @onclick="OnToggle" @ondblclick:stopPropagation>@GlyphFor(Collapsed)</button>

@code {
    private ElementReference _button;
    private int _focused;

    /// <summary>Whether the Item is collapsed: the button then expands it.</summary>
    [Parameter] public bool Collapsed { get; set; }

    /// <summary>The button's accessible name: "Expand East", "Collapse East".</summary>
    [Parameter] public string Name { get; set; } = "";

    /// <summary>Pressed.</summary>
    [Parameter] public EventCallback<MouseEventArgs> OnToggle { get; set; }

    /// <summary>The template's focus request (ADR-0037): the button takes DOM focus once for each
    /// number it has not acted on.</summary>
    [Parameter] public int FocusRequest { get; set; }

    [CascadingParameter] internal PivotInput? Input { get; set; }

    /// <summary>The classes the button carries: <c>ex-interactive</c> lets it take the pointer
    /// inside a Template cell (ADR-0020).</summary>
    internal static string ClassFor(bool collapsed)
        => collapsed ? "ex-pivot-toggle ex-interactive ex-pivot-toggle-collapsed" : "ex-pivot-toggle ex-interactive";

    /// <summary>The button's glyph: a plus to expand, a minus to collapse.</summary>
    internal static string GlyphFor(bool collapsed) => collapsed ? "+" : "−";

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (FocusRequest != 0 && FocusRequest != _focused)
        {
            _focused = FocusRequest;
            await (Input?.HandKeyboardToAsync(_button) ?? _button.FocusAsync().AsTask());
        }
    }
}
