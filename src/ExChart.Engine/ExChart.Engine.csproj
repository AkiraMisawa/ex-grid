<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Single-target net10.0; newer runtimes load it as-is (ADR-0022). -->
    <TargetFramework>net10.0</TargetFramework>
    <Description>The chart engine of ExChart: series in the data's own terms, each with its Series Kind, drawn as what it is — levels joined only to their neighbours, rates and amounts as steps with open and filled ends — on proportional or category axes, thinned past the plot's pixels, laid out as an immutable scene, and written as CSV. No UI and no dependency.</Description>
    <PackageTags>chart;svg;finance;steps;csv</PackageTags>
  </PropertyGroup>

  <!-- No reference at all (ADR-0250): the engine knows no grid, so a chart can be built and tested
       without a renderer, and a Consumer that wants a chart and no grid is not handed one. -->

  <ItemGroup>
    <InternalsVisibleTo Include="ExChart.Engine.Tests" />
  </ItemGroup>

</Project>
